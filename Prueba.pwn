                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 40000) return ErrorMsg(playerid, "Dinero insuficiente.");
                                        strcat(StrHab, "{FFFF00}=====================================\n");
                                        strcat(StrHab, "{FFFF00}  EXAMEN DE PILOTAJE - AVIONES LIGEROS\n");
                                        strcat(StrHab, "{FFFF00}=====================================\n\n");
                                        strcat(StrHab, "{FFFFFF}Al pulsar {00FF00}Hacer Prueba{FFFFFF} se descontaran {FFFF00}$40.000{FFFFFF} de\n");
                                        strcat(StrHab, "tu bolsillo y comenzara el examen de inmediato.\n\n");
                                        strcat(StrHab, "{FFFF00}Instrucciones:\n");
                                        strcat(StrHab, "{FFFFFF}  {00FF00}>{FFFFFF} Siga los checkpoints aereos en orden.\n");
                                        strcat(StrHab, "{FFFFFF}  {FF4444}>{FFFFFF} No dane la aeronave (se reprueba al dano).\n");
                                        strcat(StrHab, "{FFFFFF}  {FF4444}>{FFFFFF} No abandone la aeronave durante la prueba.\n");
                                        SetPVarInt(playerid, "TipoLicAerea", 1);
                                        ShowPlayerDialog(playerid, DIALOG_CONFIRMA_ESCOLA4, DIALOG_STYLE_MSGBOX, "Examen - Licencia Aerea (Avion Ligero)", StrHab, "Hacer Prueba", "Cancelar");
                                }
