                                        SetTimerEx("FinCargaCamion", 30000, false, "iffff", playerid, 1039.057983, 2132.961425, 10.547390, 10.0);
                                }
                        }
                }
                case DIALOG_CONVITE:
                {
                        new String[258];
                        // FIX SPRINT3 H-A5-07: usar PVar InviterPlayerID en vez de convite como playerid.
                        // Antes: InfoMsg(PlayerInfo[playerid][convite], ...) pasaba orgid (1-14) como
                        // playerid, enviando el mensaje a un jugador aleatorio en vez del inviter.
                        new inviterID = GetPVarInt(playerid, "InviterPlayerID");
                        if(response)
                        {
                                if(!TieneCarnetTrabajo(playerid))
                                {
                                        ErrorMsg(playerid, "No puedes unirte a una organizacion sin Carnet de Trabajo. Obtenlo en el Ayuntamiento.");
                                        PlayerInfo[playerid][convite] = 0;
                                        DeletePVar(playerid, "InviterPlayerID");
                                        return 1;
                                }
                                PlayerInfo[playerid][Org] = PlayerInfo[playerid][convite];
                                PlayerInfo[playerid][Cargo] = 1;
                                format(String,sizeof(String),"Acaba de entrar a la organizacion{FFFF00} (%s)",NomeOrg(playerid));
                                InfoMsg(playerid, String);
                                format(String,sizeof(String),"%04d acaba de entrar a tu organizacion (%s)",PlayerInfo[playerid][IDF],NomeOrg(playerid));
                                if(inviterID >= 0 && inviterID < MAX_PLAYERS && IsPlayerConnected(inviterID))
                                        InfoMsg(inviterID, String);
                                PlayerInfo[playerid][convite] = 0;
                                DeletePVar(playerid, "InviterPlayerID");
                                convidarmembro(playerid, PlayerInfo[playerid][Org]);
                        }
                        if(!response)
                        {
                                // P1-AUD-3: traducido del portugues al espaÃ¯Â¿Â½ol
                                format(String,sizeof(String),"%04d rechazo la invitacion a tu organizacion (%s)",PlayerInfo[playerid][IDF],NomeOrg(playerid));
                                if(inviterID >= 0 && inviterID < MAX_PLAYERS && IsPlayerConnected(inviterID))
                                        InfoMsg(inviterID, String);
                                format(String,sizeof(String),"Rechazo la invitacion a tu organizacion (%s)",NomeOrg(playerid));
                                InfoMsg(playerid, String);
                                PlayerInfo[playerid][convite] = 0;
                                DeletePVar(playerid, "InviterPlayerID");
                        }
                }
                case DIALOG_LTAGS:
                {
                        if(PlayerInfo[playerid][pAdmin] < 6) return 1; // FIX AUDIT3 DS-06
                        new string[128], StringContas[500];
                        format(StringContas, sizeof(StringContas), PASTA_CONTAS,inputtext);
                        // FIX AUDIT3 DS-06: sanitizar path traversal
                        if(strfind(inputtext, "..", true) != -1 || strfind(inputtext, "/", true) != -1 || strfind(inputtext, "\\", true) != -1)
                            return ErrorMsg(playerid, "Nombre de cuenta invalido.");
                        if(response == 1)
                        {
                                if(DOF2_FileExists(StringContas))
                                {
                                        format(string,sizeof(string),"El cargo del miembro %s fue eliminado!..", inputtext);
                                        InfoMsg(playerid, string);
                                        DOF2_SetInt(StringContas, "pOrg", 0);
                                        DOF2_SaveFile();
                                }
                                else
                                {
                                        format(string,sizeof(string),"Cuenta: %s no encontrada!", inputtext);
                                        InfoMsg(playerid, string);
                                }
                        }
                }
                case DIALOG_ROPACOP:
                {
                        if(response)
                        {
                                new orgD = PlayerInfo[playerid][Org];
                                new cargoD = PlayerInfo[playerid][Cargo];
                                // Armar array de skins segun org/cargo y seleccionar por listitem
                                new skins[10];
                                new totalSkins = 0;
                                // P1-3: PN femenino tiene su propio array de skins por rango.
                                // Antes: todas las mujeres policiales tenian solo 2 skins (148, 192) sin importar cargo.
                                // Ahora: PN femenino tiene 5 skins formales distintos, uno por cargo.
                                if(PlayerInfo[playerid][pSexo] == 2 && orgD == 1) // PN Femenino
                                {
                                        if(cargoD>=1){skins[totalSkins]=93;totalSkins++;}
                                        if(cargoD>=2){skins[totalSkins]=192;totalSkins++;}
                                        if(cargoD>=3){skins[totalSkins]=211;totalSkins++;}
                                        if(cargoD>=4){skins[totalSkins]=150;totalSkins++;}
                                        if(cargoD>=5){skins[totalSkins]=233;totalSkins++;}
                                }
                                else if(PlayerInfo[playerid][pSexo] == 2) // Otras orgs femenino: 2 skins genericos
                                { skins[0]=148; skins[1]=192; totalSkins=2; }
                                else if(orgD == 2) // Transito (skins propios: 71/265/284)
                                {
                                        if(cargoD>=1){skins[totalSkins]=71;totalSkins++;}  // Cadete
                                        if(cargoD>=2){skins[totalSkins]=265;totalSkins++;} // Oficial
                                        if(cargoD>=3){skins[totalSkins]=284;totalSkins++;} // Jefe de Transito
                                }
                                else if(orgD == 1) // Policia Nacional
                                {
                                        if(cargoD>=1){skins[totalSkins]=266;totalSkins++;}
                                        if(cargoD>=2){skins[totalSkins]=267;totalSkins++;}
                                        if(cargoD>=3){skins[totalSkins]=280;totalSkins++;}
                                        if(cargoD>=4){skins[totalSkins]=281;totalSkins++;}
                                        if(cargoD>=5){skins[totalSkins]=283;totalSkins++;}
                                }
                                else if(orgD == 3) // FBI
                                {
                                        new fbisk[] = {2,19,32,44,62,78,94,143};
                                        if(cargoD>=1){skins[totalSkins]=208;totalSkins++;}
                                        if(cargoD>=2){skins[totalSkins]=fbisk[random(8)];totalSkins++;}
                                        if(cargoD>=3){skins[totalSkins]=165;totalSkins++;}
                                        if(cargoD>=4){skins[totalSkins]=165;totalSkins++;}
                                        if(cargoD>=5){skins[totalSkins]=164;totalSkins++;}
                                        if(cargoD>=6){skins[totalSkins]=286;totalSkins++;}
                                }
                                else if(orgD == 4) // SWAT (skins tacticos militares)
                                {
                                        if(cargoD>=1){skins[totalSkins]=285;totalSkins++;} // Operador
                                        if(cargoD>=2){skins[totalSkins]=282;totalSkins++;} // Tirador Selecto
                                        if(cargoD>=3){skins[totalSkins]=288;totalSkins++;} // Comandante Tactico
                                }
                                else if(orgD == 14) // Ejercito
                                {
                                        if(cargoD>=1){skins[totalSkins]=287;totalSkins++;}
                                        if(cargoD>=2){skins[totalSkins]=287;totalSkins++;}
                                        if(cargoD>=3){skins[totalSkins]=287;totalSkins++;}
                                        if(cargoD>=4){skins[totalSkins]=287;totalSkins++;}
                                        if(cargoD>=5){skins[totalSkins]=282;totalSkins++;}
                                        if(cargoD>=6){skins[totalSkins]=288;totalSkins++;}
                                }
                                // Ultimo item = retirar uniforme
                                if(listitem == totalSkins)
                                {
                                        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                                        InfoMsg(playerid, "Uniforme retirado.");
                                }
                                else if(listitem < totalSkins)
                                {
                                        SetPlayerSkin(playerid, skins[listitem]);
                                }
                        }
                }
                case DIALOG_TIENDAILEGAL:
                {
                        if(response)
