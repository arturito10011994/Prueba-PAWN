        // =====================================================================

        // CheckHosp: CP del Hospital Central para abrir el menu de compras D_HOSP.
        // Antes era declarado pero nunca asignado, por lo que D_HOSP era inalcanzable.
        CheckHosp = CreateDynamicCP(1168.180419, -1326.566406, -44.283576, 1.5, 0, 5, -1, 3.0); // Fix: restringido a interior 5 / mundo 0 (antes -1,-1 = todos los interiores/mundos)
