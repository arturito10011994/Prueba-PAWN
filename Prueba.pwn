                                                case 400:
                                                {
                                                        AddVehicleComponent(wVeiculo,1010);
                                                        OnVehicleMod(playerid, wVeiculo, 1010);
                                                        AddVehicleComponent(wVeiculo,1087);
                                                        OnVehicleMod(playerid, wVeiculo, 1087);
                                                        AddVehicleComponent(wVeiculo,1018);
