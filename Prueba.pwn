public OnPlayerLeaveRaceCheckpoint(playerid)
{
        return 1;
}

public OnRconCommand(cmd[])
{
        // FIX AUDIT4 RCON-01/PERS-CRIT-01: antes solo hacia Kick(i) sin guardar datos
        // del servidor (vehiculos, cofres, plantaciones, GZ). Ademas retornaba 1
        // incondicionalmente, lo que en algunos forks bloquea el gmx built-in.
        // Fix: (1) Guardar TODO antes de kickear. (2) Retornar 0 para que SA-MP
        // procese el gmx built-in (reload gamemode).
        if(strcmp(cmd, "gmx", true) == 0)
        {
                // Loguear comando RCON para audit trail
                printf("[RCON] cmd='gmx' - iniciando shutdown seguro");
                // Guardar datos de TODOS los jugadores antes del kick
                foreach(new i: Player)
                {
                        if(IsPlayerConnected(i) && pLogado[i] == true)
                        {
                                SalvarDados(i);
                                SalvarInventario(i);
                                SalvarEvaluacion(i);
                                SalvarVIP(i);
                                if(!Patrulha[i]) SalvarArmas(i);
                                // FIX AUDIT INV I3-4: marcar que ya se guardo para evitar
                                // doble SalvarInventario/SalvarDados en OnPlayerDisconnect.
                                // Antes: Kick(i) disparaba OnPlayerDisconnect que en L23342
                                // volvia a llamar SalvarInventario. Con 200 jugadores eso
                                // duplicaba 200 DOF2_SaveFile + 200 DOF2_CopyFile = 400
                                // flushes a disco innecesarios en shutdown.
                                // SetPVarInt("SavedByGMX", 1) lo marca. OnPlayerDisconnect
                                // lo verifica antes de volver a guardar.
                                SetPVarInt(i, "SavedByGMX", 1);
                                Kick(i);
                        }
                }
                // Guardar datos del servidor
                SalvarPlantacao();
                SalvarDinRoubos();
                SalvarGZ();
                for(new o = 1; o < MAX_ORGS; o++) SalvarCofre(o);
                StatsBandas_Guardar(); // FIX AUDIT9 BUG2: persistir estadisticas de bandas en shutdown
                Terr_Guardar(); // FIX AUDIT9 BUG2: persistir territorios en shutdown
                GuardarVehOrg(5); GuardarVehOrg(6); GuardarVehOrg(7); GuardarVehOrg(8);
                GuardarVehOrg(12); GuardarVehOrg(13);
                for(new v = 1; v < MAX_DVEHICLES; v++)
                        if(VehicleCreated[v] == VEHICLE_PLAYER) SaveVehicle(v);
                DOF2_SaveFile();
                printf("[RCON] gmx - shutdown seguro completado, delegando a SA-MP built-in");
                return 0; // Dejar que SA-MP procese gmx built-in (reload)
        }
        // Loguear todos los demas comandos RCON para audit trail
        printf("[RCON] cmd='%s'", cmd);
        return 0; // Dejar que SA-MP procese comandos built-in
}

public OnPlayerRequestSpawn(playerid)
{
        // FIX AUDIT SPAWN S2-9: gate OnPlayerRequestSpawn con pLogado.
        // Antes: este callback estaba vacio (return 1) sin validacion. Un jugador
        // podia forzar un spawn sin login pulsando SHIFT en la pantalla de clase.
        // Ahora: si no esta logueado, bloquear el spawn (return 0).
        // Nota: el flujo normal de login usa SpawnPlayer directamente (no
        // OnPlayerRequestSpawn), asi que esto no afecta a jugadores legÃ¯Â¿Â½timos.
        if(!pLogado[playerid]) return 0;
        return 1;
}

