                                        new msgCombo[160];
                                        format(msgCombo, sizeof(msgCombo), "Compraste el Combo de Herramientas: Ganzua, Taladro y Explosivo (ahorro $6,000).");
                                        SuccesMsg(playerid, msgCombo);
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -23000);
                                        GanharItem(playerid, ITEM_GANZUA, 1);
                                        GanharItem(playerid, ITEM_TALADRO, 1);
                                        GanharItem(playerid, ITEM_EXPLOSIVO, 1);
                                        CofreNiobio += 23000;
                                        // FIX AUDIT 6A [C2]: solo setear durabilidad si NO existe ya (evita resetear durabilidad existente)
                                        if(GetPVarInt(playerid, "GanzuaUsos") <= 0)
                                            SetPVarInt(playerid, "GanzuaUsos", randomEx(2, 3));
                                        if(GetPVarInt(playerid, "TaladroUsos") <= 0)
                                            SetPVarInt(playerid, "TaladroUsos", randomEx(4, 5));
                                        SalvarInventario(playerid);
