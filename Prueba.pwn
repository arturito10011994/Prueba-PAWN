CallBack::CANIM(playerid){
        // FIX AUDIT SPAWN S2-5: validar IsPlayerConnected en CANIM callback.
        // Antes: CANIM no verificaba si el jugador sigue conectado. Si el jugador
        // se desconectaba a mitad de la animacion, el callback disparaba sobre
        // un slot vacio o reusado, causando glitches visuales.
        if(!IsPlayerConnected(playerid)) return 1;
        ClearAnimations(playerid);
        return 1;
}

CallBack::Attplayer(playerid)
{
        static str[300];
        if(pJogando[playerid] == false && Falou[playerid] == false && Susurrou[playerid] == false && Gritou[playerid] == false)
        {
                format(str,sizeof(str),"%s\n{FFFFFF}(%04d)",AdminCargo(playerid), PlayerInfo[playerid][IDF]);
        }
        else if(Falou[playerid] == true)
        {
                format(str,sizeof(str),"{FFF000}(%04d)",PlayerInfo[playerid][IDF]);
        }
        else if(Susurrou[playerid] == true)
        {
                format(str,sizeof(str),"{FFF000}(%04d)",PlayerInfo[playerid][IDF]);
        }
        else if(Gritou[playerid] == true)
        {
                format(str,sizeof(str),"{FFF000}(%04d)",PlayerInfo[playerid][IDF]);
        }
        /*else if(PlayerMorto[playerid][pEstaMorto] == 1)
        {
                format(str,sizeof(str),"{61050b}(Herido)\n{FFFFFF}(%04d)",PlayerInfo[playerid][IDF]);
        }*/
        else
        {
                format(str,sizeof(str),"{FFFFFF}(%04d)",PlayerInfo[playerid][IDF]);
        }
        SetPlayerChatBubble(playerid, str, 0x5b6ed9FF, 30.0, 20000);
        // FIX AUDIT2 AGENT4 S-10: decaer Erro[playerid] si han pasado >60s sin flood
        // de chat. Sin esto, un jugador que spameo 5 veces a las 14:00, 3 a las 15:00
        // y 3 a las 16:00 acumulaba 11 strikes y era kickeado injustamente.
        // Erro[playerid] tambien se usa para tracking de passwords incorrectas en
        // DIALOG_LOGIN (3 intentos = kick). Pero Attplayer solo corre tras spawn
        // (login OK), por lo que no interfiere con el contador de password.
        if(Erro[playerid] > 0 && (gettime() - UltimaFala[playerid]) > SPAM_DECAY_SEC) // FIX AUDIT SPAM-MEJORA3
        {
                Erro[playerid]--;
        }
        // FIX AUDIT2 AGENT4 S-01: decaer g_CmdStrikes si han pasado >300s (5min) sin
        // flood de comandos. Sin esto, un jugador con 9 strikes que juega normalmente
        // 1 hora mantiene los 9 strikes (cualquier nuevo flood = kick injusto).
        // FIX AUDIT FLOOD-H1+H2: persistir g_CmdLastTick Y actualizarlo tras decay.
        // Antes: g_CmdLastTick NO se persistia ni se actualizaba tras decay.
        // Resultado: tras reconectar, g_CmdLastTick=0, GetTickCount()-0 >> 300000
        // siempre TRUE, decay disparaba 1 strike/seg. 9 strikes limpiados en 9s.
        // Ahora: actualizar g_CmdLastTick tras cada decay para que el siguiente
        // decay tarde otros 300s (5min). Asi 9 strikes tardan 45min en limpiarse.
        if(g_CmdStrikes[playerid] > 0 && (GetTickCount() - g_CmdLastTick[playerid]) > CMD_DECAY_MS) // FIX AUDIT FLOOD-MEJORA1
        {
                g_CmdStrikes[playerid]--;
                g_CmdLastTick[playerid] = GetTickCount(); // FIX FLOOD-H2: reset timer tras decay
        }
        return 1;
}

CallBack::attloginname(playerid)
{
        new stringg[50];
        format(stringg, sizeof(stringg), "%s", Name(playerid));
        PlayerTextDrawSetString(playerid, TxtLoginCDA[playerid][11], stringg);
        PlayerTextDrawSetString(playerid, BancoTD[playerid][12], stringg);
}

GetVehicleModelEx(Model)
{
    switch(Model)
        {
        case 417, 425, 430, 432, 446, 447, 448, 452, 453, 454, 460,
                         461, 462, 463, 464, 465, 468, 469, 471, 472, 473, 476,
                         481, 484, 487, 488, 493, 497, 501, 509, 510, 511, 512,
                         513, 521, 522, 523, 548: return 0;
    }
    return true;
}

CallBack::mostrarTelaLogin(playerid)
{
        // La alerta ahora espera que el jugador haga click en ACEPTAR
        // No se oculta automaticamente por timer
        SelectTextDraw(playerid, 0xFFD700FF); // Activa el modo click con cursor dorado
        return 1;
}

CallBack::loginp(playerid)
{
        LimparChat(playerid, 10);
        new File[255];
        for(new i = 0; i < 38; ++i)
        {
                PlayerTextDrawShow(playerid, TxtLoginCDA[playerid][i]);
                if(i == 38)break;
        }
        SelectTextDraw(playerid, 1);
        format(File, sizeof(File), PASTA_BANIDOS, Name(playerid));
        if(DOF2_FileExists(File))
        {
                if(gettime() > DOF2_GetInt(File, "DDesban"))
                {
                        DOF2_RemoveFile(File);
                        // FIX AUDIT LOGIN F0-6: NO hacer return 0 aqui.
                        // Antes: el codigo hacia return 0 despues de quitar el
                        // ban expirado, lo que saltaba el check de ban por IP
                        // (PASTA_BANIDOSIP) en L7377. Un jugador con ban por
                        // cuenta expirado PERO ban por IP vigente podia entrar.
                        // Ahora: caemos al check ban IP antes de mostrar DIALOG.
                        // Verificacion de cuenta existe se hace mas abajo.
                }
                else
                {
                        LimparChat(playerid, 10);
                        new StrM[450];
                        strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANEADO{FFFFFF} -x-x-x-x-x-\n\nEsta cuenta esta baneada de este servidor !\n\n{FFA500}Cuenta:{E64022} ");
                        strcat(StrM, Name(playerid));
                        strcat(StrM, "\n{FFFF00}Administrador:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Administrador"));
                        strcat(StrM, "\n{FFFF00}Motivo:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Motivo"));
                        strcat(StrM, "\n{FFFF00}Dia del Ban:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Data"));
                        strcat(StrM, "\n{FFFF00}Dia de Desban:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Desban"));
                        strcat(StrM, "\n\n{FFFFFF}Si lo considera un error, entre a nuestro discord\n{FFFF00}\t\t*******{FFFFFF}");
                        strcat(StrM, SERVERFORUM);
                        strcat(StrM, "{FFFF00}*******");
                        ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                        Kick(playerid);
                        return 0;
                }
        }
        // FIX AUDIT LOGIN F0-6: verificacion de cuenta (antes dentro del bloque
        // "ban expirado") se hace aqui, DESPUES del check ban IP, para que el
        // flujo correcto sea: check ban cuenta -> check ban IP -> mostrar dialog.
        // Si llegamos aqui no estamos baneados ni por cuenta ni por IP.
        format(File, sizeof(File), PASTA_BANIDOSIP, GetPlayerIpEx(playerid));
        if(DOF2_FileExists(File))
        {
                new StrM[450];
                strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANIDO{FFFFFF} -x-x-x-x-x-\n\nEste IP esta banido no servidor. !\n\n{FFFF00}IP:{FFFFFF} ");
                strcat(StrM, GetPlayerIpEx(playerid));
                strcat(StrM, "\n{FFFF00}Administrador:{FFFFFF} ");
                strcat(StrM, DOF2_GetString(File, "Administrador"));
                strcat(StrM, "\n{FFFF00}Motivo:{FFFFFF} ");
                strcat(StrM, DOF2_GetString(File, "Motivo"));
                strcat(StrM, "\n{FFFF00}Dia de tu Ban:{FFFF00} ");
                strcat(StrM, DOF2_GetString(File, "Data"));
                strcat(StrM, "\n\nSe considera um erro, entre em nosso discord\n{FFFF00}\t\t*******{FFFFFF}");
                strcat(StrM, SERVERFORUM);
                strcat(StrM, "{FFFF00}*******");
                ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                Kick(playerid);
                return 0;
        }
        // FIX AUDIT LOGIN F0-6: si no esta baneado (ni cuenta ni IP), mostrar
        // el dialog correspondiente (LOGIN si cuenta existe, REGISTRO si no).
        // Antes este bloque estaba dentro del "ban expirado", pero al sacarlo
        // para arreglar el bypass ban IP, debemos ponerlo aqui al final.
        format(File, sizeof(File), PASTA_CONTAS, Name(playerid));
        if(DOF2_FileExists(File))
        {
                format(Str, sizeof(Str), "Sea bienvenido nuevamente, %s.\nPara Entrar al servidor coloque su contraseÃ¯Â¿Â½a abajo.", Name(playerid));
                ShowPlayerDialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_PASSWORD, "Bienvenido de nuevo", Str, "Entrar", "X");
        }
        else
        {
                format(Str, 256, "Sea bienvenido a nuestro servidor, %s!\nPara crear su cuenta, coloque una contraseca abajo.\n*Su contraseca debe tener entre 4 a 20 caracteres.", Name(playerid));
                ShowPlayerDialog(playerid, DIALOG_REGISTRO, DIALOG_STYLE_PASSWORD, "Usted es nuevo aqui", Str, "Confirmar", "X");
        }
        return 1;
}

CallBack::VelocimetroEx(playerid)
{
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                new str[60];
                new _vehid = GetPlayerVehicleID(playerid);
                new _isBike = IsBicycle(_vehid);
                new velo = VelocidadDoVeiculo(_vehid);
                if(Plataforma[playerid] == 1){
                        // FIX VELOCIMETRO v8: revertido a comportamiento de GM base (sin strcmp cache).
                        // El cache lastVeloSpeed causaba que el TextDraw no se actualizara correctamente.
                        // La GM base siempre llama PlayerTextDrawSetString sin check - es mas simple y funciona.
                        format(str,sizeof(str),"%02d", velo);
                        PlayerTextDrawSetString(playerid, Velomob_p[playerid][0], str);
                        if(_isBike)
                                format(str,sizeof(str),"~r~F:~w~ N/A");
                        else
                        {
                                // MEJORA 4 FUEL-MEJORAS-4-6: barra visual ASCII segun porcentaje de
                                // combustible en el velocimetro mobile. ~g~ verde (ok 80-100%),
                                // ~y~ amarillo (60-79%), ~o~ naranja (40-59%), ~r~ rojo (0-39%).
                                // No altera el TextDraw existente: solo cambia el string mostrado.
                                new Float:fuelPct = Fuel_GetPercent(_vehid);
                                if(fuelPct >= 80.0)
                                        format(str,sizeof(str),"~g~[########] %.0f%%", fuelPct);
                                else if(fuelPct >= 60.0)
                                        format(str,sizeof(str),"~y~[######--] %.0f%%", fuelPct);
                                else if(fuelPct >= 40.0)
                                        format(str,sizeof(str),"~o~[####----] %.0f%%", fuelPct);
                                else if(fuelPct >= 20.0)
                                        format(str,sizeof(str),"~r~[##------] %.0f%%", fuelPct);
                                else
                                        format(str,sizeof(str),"~r~[#-------] %.0f%%", fuelPct);
                        }
                        PlayerTextDrawSetString(playerid, Velomob_p[playerid][2], str);
                        if(velo >= 110){
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "5");
                        }else if(velo >= 80){
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "4");
                        }else if(velo >= 60){
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "3");
                        }else if(velo >= 30){
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "2");
                        }else if(velo > 0){
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "1");
                        }else{
                                PlayerTextDrawSetString(playerid, Velomob_p[playerid][1], "N");
                        }
                        PlayerTextDrawShow(playerid,Velomob_p[playerid][0]);
                        PlayerTextDrawShow(playerid,Velomob_p[playerid][1]);
                        PlayerTextDrawShow(playerid,Velomob_p[playerid][2]);
                        if(mostrandovelo[playerid] == 0){
                                for(new t=0;t<4;t++){
                                        TextDrawShowForPlayer(playerid,Velomob[t]);
                                        if(t == 4)break;
                                }
                                mostrandovelo[playerid] = 1;
                        }
                }else{
                        new engine, lights, alarm, doors, bonnet, boot, objective;
                        GetVehicleParamsEx(_vehid, engine, lights, alarm, doors, bonnet, boot, objective);

                        if(engine == 1){
                                PlayerTextDrawColor(playerid, VeloC[playerid][5], 16711935); //bolinha verde
                        }else{
                                PlayerTextDrawColor(playerid, VeloC[playerid][5], -16776961); //bolinha vermelha
                        }
                        if(TemCinto[playerid] == true){
                                PlayerTextDrawColor(playerid, VeloC[playerid][6], 16711935); //bolinha verde
                        }else{
                                PlayerTextDrawColor(playerid, VeloC[playerid][6], -16776961); //bolinha vermelha
                        }
                        if(doors != 0 && VehicleLock[_vehid] != 0){
                                PlayerTextDrawColor(playerid, VeloC[playerid][7], 16711935);
                        }else{
                                PlayerTextDrawColor(playerid, VeloC[playerid][7], -16776961);
                        }

                        // FUEL-ARCHITECTURE: display por porcentaje (universal para todos los tanques).
                        // 5 barras = 20% cada una. Bicicletas: gris tenue.
                        // Colores: verde (ok), amarillo (20% bajo), naranja (10% critico),
                        // rojo (5% reserva / 0% sin combustible).
                        if(_isBike)
                        {
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][0], 0x40404080);
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][1], 0x40404080);
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][2], 0x40404080);
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][3], 0x40404080);
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][4], 0x40404080);
                        }
                        else
                        {
                        new Float:fuelPct = Fuel_GetPercent(_vehid);
                        // Barra 0: 80-100% -> verde
                        if(fuelPct >= 80.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][0], 16711935);
                        else
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][0], -16776961);
                        // Barra 1: 60-79%
                        if(fuelPct >= 60.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][1], 16711935);
                        else
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][1], -16776961);
                        // Barra 2: 40-59%
                        if(fuelPct >= 40.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][2], 16711935);
                        else
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][2], -16776961);
                        // Barra 3: 20-39%
                        if(fuelPct >= 20.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][3], 16711935);
                        else
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][3], -16776961);
                        // Barra 4: 0-19% (con escalado de color critico)
                        if(fuelPct > 10.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][4], 1097458119); // amarillo (10-19%)
                        else if(fuelPct > 5.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][4], 0xFF8C00C0); // naranja (5-10%)
                        else if(fuelPct > 0.0)
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][4], 0xFF0000C0); // rojo (reserva 0-5%)
                        else
                                PlayerTextDrawBoxColor(playerid, VeloC[playerid][4], -16776961); // rojo solido (0%)
                        }
                        format(str, sizeof(str), "%03d", velo);
                        // FIX VELOCIMETRO v8: revertido a GM base (sin strcmp cache).
                        PlayerTextDrawSetString(playerid, VeloC[playerid][8], str);
                        if(velo >= 110){
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "5");
                        }else if(velo >= 80){
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "4");
                        }else if(velo >= 60){
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "3");
                        }else if(velo >= 30){
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "2");
                        }else if(velo > 0){
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "1");
                        }else{
                                PlayerTextDrawSetString(playerid, VeloC[playerid][9], "N");
                        }
                        // Mejora: actualizar texto % fuel en PC
                        new Float:_fuelPctPC = Fuel_GetPercent(_vehid);
                        new _fuelStrPC[16];
                        if(_fuelPctPC >= 80.0)
                            format(_fuelStrPC, sizeof(_fuelStrPC), "~g~F: %.0f%%", _fuelPctPC);
                        else if(_fuelPctPC >= 60.0)
                            format(_fuelStrPC, sizeof(_fuelStrPC), "~y~F: %.0f%%", _fuelPctPC);
                        else if(_fuelPctPC >= 40.0)
                            format(_fuelStrPC, sizeof(_fuelStrPC), "~o~F: %.0f%%", _fuelPctPC);
                        else
                            format(_fuelStrPC, sizeof(_fuelStrPC), "~r~F: %.0f%%", _fuelPctPC);
                        PlayerTextDrawSetString(playerid, VeloC[playerid][10], _fuelStrPC);
                        for(new t=0;t<11;t++){
                                PlayerTextDrawShow(playerid,VeloC[playerid][t]);
                                if(t == 10)break;
                        }
                        if(mostrandovelo[playerid] == 0){
                                for(new t=0;t<52;t++){
                                        TextDrawShowForPlayer(playerid,VeloC_G[t]);
                                        if(t == 52)break;
                                }
                                mostrandovelo[playerid] = 1;
                        }
                }
        }else{
                if(Plataforma[playerid] == 1){
                        if(mostrandovelo[playerid] != 0){
                                for(new t=0;t<3;t++){
                                        PlayerTextDrawHide(playerid,Velomob_p[playerid][t]);
                                        if(t == 3)break;
                                }
                                for(new t=0;t<4;t++){
                                        TextDrawHideForPlayer(playerid,Velomob[t]);
                                        if(t == 4)break;
                                }
                                if(TemCinto[playerid] == true)
                                {
                                        PlayAudioStreamForPlayer(playerid, "https://j.top4top.io/m_2911pmwja0.mp3");
                                }
                                mostrandovelo[playerid] = 0;
                                // FIX AUDIT6 HIGH-4: resetear cache al salir del vehiculo
                                lastVeloSpeed[playerid][0] = 0;
                                lastVeloFuel[playerid][0] = 0;
                                lastVeloGear[playerid][0] = 0;
                        }
                }else{
                        if(mostrandovelo[playerid] != 0){
                                for(new t=0;t<10;t++){
                                        PlayerTextDrawHide(playerid,VeloC[playerid][t]);
                                        if(t == 10)break;
                                }
                                for(new t=0;t<52;t++){
                                        TextDrawHideForPlayer(playerid,VeloC_G[t]);
                                        if(t == 52)break;
                                }
                                if(TemCinto[playerid] == true)
                                {
                                        PlayAudioStreamForPlayer(playerid, "https://j.top4top.io/m_2911pmwja0.mp3");
                                }
                                mostrandovelo[playerid] = 0;
                                // FIX AUDIT6 HIGH-4: resetear cache al salir del vehiculo
                                lastVeloSpeed[playerid][0] = 0;
                                lastVeloFuel[playerid][0] = 0;
                                lastVeloGear[playerid][0] = 0;
                        }
                }
                // FIX AUDIT VELOCIMETRO VEL-A1-05/A2-05/A3-02 (MEDIO): reset TimerVelo a 0 tras KillTimer.
                // Antes: solo hacia KillTimer(TimerVelo[playerid]) sin resetear la variable.
                // El guard `if(TimerVelo[playerid])` en otros sitios evaluaria el timer ya-muerto como truthy
                // (el ID sigue siendo != 0), causando KillTimer doble o comportamiento indefinido.
                KillTimer(TimerVelo[playerid]);
                TimerVelo[playerid] = 0;
        }
        return 1;
}

CallBack::ConectarNaFrequencia(playerid, freq)
{
        FrequenciaConectada[playerid] = freq;
        SvAttachListenerToStream(Frequencia[freq], playerid);
        return 1;
}

public SV_VOID:OnPlayerActivationKeyPress(SV_UINT:playerid, SV_UINT:keyid)
{
        if(keyid == 0x42 && Falando[playerid] == true)
        {
                SvAttachSpeakerToStream(lstream[playerid], playerid); //local falando
                Falou[playerid] = true;
                PlayerTextDrawColor(playerid, hudStyle[playerid][7], 16711935);
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], 16711935);
                PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
        }
        if(keyid == 0x42 && Susurrando[playerid] == true)
        {
                SvAttachSpeakerToStream(Susurrandos[playerid], playerid); //local susurrando
                Susurrou[playerid] = true;
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], 16711935);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
        }
        if(keyid == 0x42 && Gritando[playerid] == true)
        {
                SvAttachSpeakerToStream(Gritandos[playerid], playerid); //local gritando
                Gritou[playerid] = true;
                PlayerTextDrawColor(playerid, hudStyle[playerid][7], 16711935);
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], 16711935);
                PlayerTextDrawColor(playerid, hudStyle[playerid][8], 16711935);
                PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][8]);
        }
        if(keyid == 0x5A && gstream)
        {
            if(IsPlayerAdmin(playerid))
            {
                        SvAttachSpeakerToStream(gstream, playerid); //global
                        PlayerTextDrawColor(playerid, hudStyle[playerid][7], 16711935);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][6], 16711935);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][8], 16711935);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][8]);
                }
        }
        if(keyid == 0x42 && FrequenciaConectada[playerid] >= 1)
        {
                // FIX AUDIT CEL CEL-A3-04 (ALTO): guards de estado en radio.
                // ANTES: el radio no validaba estado. Algemado/preso/herido/spectating/WASTED
                // podian usar radio (bypass RP). Ahora bloqueamos.
                if(pLogado[playerid] && GetPlayerState(playerid) != PLAYER_STATE_SPECTATING
                   && !PlayerInfo[playerid][pCongelado]
                   && PlayerInfo[playerid][pjail] == 0
                   && MinutosMorte[playerid] == 0
                   && GetPlayerState(playerid) != PLAYER_STATE_WASTED)
                {
                        if(!IsPlayerInAnyVehicle(playerid))
                        {
                                ApplyAnimation(playerid, "ped", "phone_talk", 4.1, 0, 0, 0, 0, 0, 1);
                                // FIX AUDIT CEL MEJORA-2 (ALTO): trackear ownership del slot 9.
                                // ANTES: SetPlayerAttachedObject(9, 19942) pisaba la pala del minero
                                // si estaba en slot 9. Ahora: solo attacha si slot libre o ya es radio.
                                // Y trackeamos el flag g_RadioSlot9Attached para que el release sepa
                                // que el slot 9 lo puso el radio (no la pala).
                                if(!IsPlayerAttachedObjectSlotUsed(playerid, 9)
                                   || g_RadioSlot9Attached[playerid])
                                {
                                        SetPlayerAttachedObject(playerid, 9, 19942, 2, 0.0300, 0.1309, -0.1060, 118.8998, 19.0998, 164.2999);
                                        g_RadioSlot9Attached[playerid] = true;
                                }
                        }
                        SvAttachSpeakerToStream(Frequencia[FrequenciaConectada[playerid]], playerid);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][7], 16711935);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][6], 16711935);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
                }
        }
}

public SV_VOID:OnPlayerActivationKeyRelease(SV_UINT:playerid,SV_UINT:keyid)
{
        if(keyid == 0x42 && Falando[playerid] == true)
        {
                SvDetachSpeakerFromStream(lstream[playerid], playerid);
                Falou[playerid] = false;
                PlayerTextDrawColor(playerid, hudStyle[playerid][7], -16776961);
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], -16776961);
                PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
        }
        if(keyid == 0x42 && Susurrando[playerid] == true)
        {
                SvDetachSpeakerFromStream(lstream[playerid], playerid);
                Susurrou[playerid] = false;
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], -16776961);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
        }
        if(keyid == 0x42 && Gritando[playerid] == true)
        {
                SvDetachSpeakerFromStream(lstream[playerid], playerid);
                Gritou[playerid] = false;
                PlayerTextDrawColor(playerid, hudStyle[playerid][7], -16776961);
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], -16776961);
                PlayerTextDrawColor(playerid, hudStyle[playerid][8], -16776961);
                PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][8]);
        }
        if(keyid == 0x5A && gstream)
        {
            if(IsPlayerAdmin(playerid))
            {
                        SvDetachSpeakerFromStream(gstream, playerid);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][7], -16776961);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][6], -16776961);
                        PlayerTextDrawColor(playerid, hudStyle[playerid][8], -16776961);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
                        PlayerTextDrawShow(playerid, hudStyle[playerid][8]);
                }
        }
        if(keyid == 0x42 && FrequenciaConectada[playerid] >= 1)
        {
                SvDetachSpeakerFromStream(Frequencia[FrequenciaConectada[playerid]], playerid);
                ClearAnimations(playerid);
                // FIX AUDIT CEL MEJORA-2 (ALTO): solo remover slot 9 si fue el radio quien lo attacho.
                // ANTES: `if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9)`
                // removia cualquier objeto en slot 9, incluyendo la pala del minero (19626) o
                // otros objetos que NO fueron puestos por el radio. Ahora: solo remover si
                // g_RadioSlot9Attached[playerid] == true (el radio fue el dueÃ¯Â¿Â½o del slot 9).
                if(g_RadioSlot9Attached[playerid])
                {
                        if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);
                        g_RadioSlot9Attached[playerid] = false;
                }
                PlayerTextDrawColor(playerid, hudStyle[playerid][7], -16776961);
                PlayerTextDrawColor(playerid, hudStyle[playerid][6], -16776961);
                PlayerTextDrawShow(playerid, hudStyle[playerid][7]);
                PlayerTextDrawShow(playerid, hudStyle[playerid][6]);
        }
}

CallBack::SendMSG()
{
        for(new i = GetPlayerPoolSize(); i != -1; --i) //Loop through all players
        {
                if(pLogado[i] == true)
                {
                        LimparChat(i, 10);
                        InfoMsg(i, RandomMSG[random(sizeof(RandomMSG))]);
                }
        }
        // P0-ROBO-FASE4: el reset global de robos ya no se usa.
        // Cada negocio tiene cooldown individual en g_RoboCooldown[n].
        return 1;
}

CallBack::TimerHack(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        // Anti-moneyhack: sincronizar dinero nativo con variable real cada 1s
        // FIX AUDIT5 HIGH-04: solo ResetPlayerMoney + GivePlayerMoney si hay desincronia
        if(GetPlayerMoney(playerid) != PlayerInfo[playerid][pDinheiro])
        {
                ResetPlayerMoney(playerid);
                GivePlayerMoney(playerid, PlayerInfo[playerid][pDinheiro]);
        }
        TimerHacker[playerid] = SetTimerEx("TimerHack", segundos(1), false, "i", playerid); // FIX AUDIT9 BUG1: almacenar timer ID para que KillTimer en disconnect funcione

        // Anti-arma prohibida: kick si porta arma no permitida
        if(EstaSegurandoArmaProibida(playerid))
        {
                new curWeapon = GetPlayerWeapon(playerid);
                if(curWeapon == 38 && PlayerInfo[playerid][Org] == 14 && Patrulha[playerid] == true)
                {
                        // Ejercito en servicio puede tener minigun - permitido
                }
                else if(curWeapon == 18 && IsBandido(playerid))
                {
                        // FIX AUDIT AC: bandas pueden tener Molotov (cofre de banda)
                }
                else
                {
                        SendClientMessage(playerid, -1, "Estas portando un arma prohibida! Has sido expulsado!");
                        Kick(playerid);
                }
        }
        // NOTA: El guardado de datos fue movido al SaveTimer (cada 60s)
        // para reducir la carga de I/O en disco con muchos jugadores.
        return true;
}

ShowDialog(playerid, dialogid)
{
        switch(dialogid)
        {
                case DIALOG_VEHICLE:
                {
                        new vehicleid = GetPVarInt(playerid, "DialogValue1");
                        new caption[32], info[256];
                        format(caption, sizeof(caption), "Vehiculo {FFFF00}%d", vehicleid);
                        strcat(info, "{FFFF00}-{FFFFFF} Motor\n{FFFF00}- {FFFFFF}Luces\n{FFFF00}-{FFFFFF} Capo\n{FFFF00}-{FFFFFF} Maletero", sizeof(info));
                        strcat(info, "\n{FFFF00}-{FFFFFF} Tanque de Combustible", sizeof(info));
                        if(GetPlayerVehicleAccess(playerid, vehicleid) >= 2)
                        {
                                new value = VehicleValue[vehicleid]/2;
                                format(info, sizeof(info), "%s\n{FFFF00}-{FFFFFF} Vender vehiculo (${FFFF00}%d{FFFFFF})\n{FFFF00}-{FFFFFF} Estacionar vehiculo", info, value);
                        }
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_LIST, caption, info, "Seleccionar", "X");
                }
                case DIALOG_VEHICLE_BUY:
                {
                        new vehicleid = GetPVarInt(playerid, "DialogValue1");
                        new caption[32], info[256];
                        format(caption, sizeof(caption), "Vehiculo {FFFF00}%d", vehicleid);
                        format(info, sizeof(info), "Este vehiculo esta en venta por ($%d)\n-", VehicleValue[vehicleid]);
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, caption, info, "Comprar", "X");
                }
                case DIALOG_VEHICLE_SELL:
                {
                        new targetid = GetPVarInt(playerid, "DialogValue1");
                        new id = GetPVarInt(playerid, "DialogValue2");
                        new price = GetPVarInt(playerid, "DialogValue3");
                        new info[256];
                        format(info, sizeof(info), "%04d quiere vender {FFFF00}%s {FFFFFF}por {FFFF00}$%d.", PlayerInfo[targetid][IDF],
                                VehicleNames[VehicleModel[id]-400], price);
                        strcat(info, "\n\n Te gustaria comprar?", sizeof(info));
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_MSGBOX, "Comprar Vehiculo", info, "Comprar", "X");
                }
                case DIALOG_TRUNK:
                {
                        new vehicleid = GetPVarInt(playerid, "DialogValue1");
                        new name[32], info[256];
                        for(new i=0; i < sizeof(VehicleTrunk[]); i++)
                        {
                                if(VehicleTrunk[vehicleid][i][1] > 0)
                                {
                                        GetWeaponName(VehicleTrunk[vehicleid][i][0], name, sizeof(name));
                                        format(info, sizeof(info), "%s%d. %s (%d)\n", info, i+1, name, VehicleTrunk[vehicleid][i][1]);
                                }
                                else
                                {
                                        format(info, sizeof(info), "%s%d. Vacio\n", info, i+1);
                                }
                        }
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_LIST, "Maleter", info, "Seleccionar", "X");
                }
                case DIALOG_TRUNK_ACTION:
                {
                        new info[128];
                        strcat(info, "Colocar\nRetirar", sizeof(info));
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_LIST, "Porta Malas", info, "Seleccionar", "X");
                }
                case DIALOG_VEHICLE_PLATE:
                {
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_INPUT, "Editar Placa", "Introduza nueva placa:", "Alterar", "X");
                }
                case DIALOG_FUEL:
                {
                        new stationidDlg = GetPVarInt(playerid, "FuelStation");
                        new gasolinaP = GetFuelStationPrecio(stationidDlg, 0);
                        new dieselP = GetFuelStationPrecio(stationidDlg, 1);
                        // Bidon: precio basado en gasolina (mayor de los dos combustibles)
                        new bidonPrecio = (gasolinaP * GALAO_LITROS * GALAO_RECARGO) / 100;
                        new info[300];
                        format(info, sizeof(info),
                                "Gasolina: {FFFF00}$%d/L\nDiesel: {FFFF00}$%d/L\n\n\
                                Abastecer Vehiculo\n\
                                Comprar bidon de emergencia ({FFFF00}$%d{FFFFFF} - %dL portatil)",
                                gasolinaP, dieselP, bidonPrecio, GALAO_LITROS);
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_LIST, "Estacion de Gasolina", info, "OK", "X");
                }
                case DIALOG_EDITVEHICLE:
                {
                        new vehicleid = GetPVarInt(playerid, "DialogValue1");
                        new caption[32], info[256];
                        format(caption, sizeof(caption), "Vehiculo %d", vehicleid);
                        format(info, sizeof(info), "1. Valor: [$%s]\n2. Modelo: [%d (%s)]\n3. Colores: [%d] [%d]\n4. Placa[%s]",
                                ConvertMoney(VehicleValue[vehicleid]), VehicleModel[vehicleid], VehicleNames[VehicleModel[vehicleid]-400],
                                VehicleColor[vehicleid][0], VehicleColor[vehicleid][1], VehicleNumberPlate[vehicleid]);
                        strcat(info, "\n5. Eliminar vehiculo\n6. Estacionar vehiculo\n7. Ir al vehiculo", sizeof(info));
                        strcat(info, "\n\nEnter: [nr] [value1] [value2]", sizeof(info));
                        ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_INPUT, caption, info, "Confirmar", "X");
                }
        }
}

LoadVehicles()
{
        new string[64];
        new File:handle, count;
        new filename[64], line[256], s, key[64];
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                format(filename, sizeof(filename), VEHICLE_FILE_PATH "v%d.ini", i);
                if(!fexist(filename)) continue;
                handle = fopen(filename, io_read);
                while(fread(handle, line))
                {
                        StripNL(line);
                        s = strfind(line, "=");
                        if(!line[0] || s < 1) continue;
                        strmid(key, line, 0, s++);
                        if(strcmp(key, "Created") == 0) VehicleCreated[i] = strval(line[s]);
                        else if(strcmp(key, "Model") == 0) VehicleModel[i] = strval(line[s]);
                        else if(strcmp(key, "Pos") == 0) sscanf(line[s], "p<,>ffff", VehiclePos[i][0], VehiclePos[i][1],
                                VehiclePos[i][2], VehiclePos[i][3]);
                        else if(strcmp(key, "Colors") == 0) sscanf(line[s], "p<,>dd", VehicleColor[i][0], VehicleColor[i][1]);
                        else if(strcmp(key, "Interior") == 0) VehicleInterior[i] = strval(line[s]);
                        else if(strcmp(key, "VirtualWorld") == 0) VehicleWorld[i] = strval(line[s]);
                        else if(strcmp(key, "Owner") == 0) strmid(VehicleOwner[i], line, s, sizeof(line));
                        else if(strcmp(key, "NumberPlate") == 0) strmid(VehicleNumberPlate[i], line, s, sizeof(line));
                        else if(strcmp(key, "Value") == 0) VehicleValue[i] = strval(line[s]);
                        else if(strcmp(key, "Lock") == 0) VehicleLock[i] = strval(line[s]);
                        else if(strcmp(key, "Alarm") == 0) VehicleAlarm[i] = strval(line[s]);
                        else if(strcmp(key, "Paintjob") == 0) VehiclePaintjob[i] = strval(line[s]);
                        // FUEL-ARCHITECTURE: cargar combustible persistente
                        else if(strcmp(key, "Fuel") == 0) VehicleFuelPersist[i] = floatstr(line[s]);
                        else
                        {
                                for(new t=0; t < sizeof(VehicleTrunk[]); t++)
                                {
                                        format(string, sizeof(string), "Trunk%d", t+1);
                                        if(strcmp(key, string) == 0) sscanf(line[s], "p<,>dd", VehicleTrunk[i][t][0], VehicleTrunk[i][t][1]);
                                }
                                for(new m=0; m < sizeof(VehicleMods[]); m++)
                                {
                                        format(string, sizeof(string), "Mod%d", m);
                                        if(strcmp(key, string) == 0) VehicleMods[i][m] = strval(line[s]);
                                }
                        }
                }
                fclose(handle);
                // FIX CRIT-VEH-004 (CRITICO): validar modelo [400, 611] tras cargar.
                // ANTES: sin validacion. Si archivo tiene Model=0 o Model=999, CreateVehicle crashea.
                // FIX CRIT-VEH-005 (CRITICO): clamp VehicleValue [0, 10000000] tras cargar.
                // ANTES: sin clamp. Editar archivo con Value=999999999 daba dupe de dinero al vender.
                if(VehicleCreated[i])
                {
                        if(VehicleModel[i] < 400 || VehicleModel[i] > 611)
                        {
                                printf("[VEH ERROR] Vehiculo %d tiene modelo invalido %d, saltando.", i, VehicleModel[i]);
                                VehicleCreated[i] = 0;
                                continue;
                        }
                        // [DEAL-FASE1] FIX HIGH-1 (DEAL-AUD1-003): tighten lower bound de
                        // "if(< 0) = 0" a "if(< 1) = 1" para no permitir Valor=0 (regalo de
                        // vehÃƒÂ­culos). Consistente con clamp de CMD:addv (L51400) y
                        // DIALOG_EDITVEHICLE case 1. Antes: if(VehicleValue[i] < 0) VehicleValue[i] = 0;
                        if(VehicleValue[i] < 1) VehicleValue[i] = 1;
                        if(VehicleValue[i] > 10000000)
                        {
                                printf("[VEH TAMPER] Vehiculo %d tiene Value=%d, clampeado a 10000000.", i, VehicleValue[i]);
                                VehicleValue[i] = 10000000;
                        }
                        count++;
                }
        }
        printf("=> Veiculos Conce                       : %d Carregados", count);
}

SaveVehicle(vehicleid)
{
        new filename[64], line[256];
        format(filename, sizeof(filename), VEHICLE_FILE_PATH "v%d.ini", vehicleid);
        new File:handle = fopen(filename, io_write);
        // FIX SPRINT2 H-A5-01: null check tras fopen.
        // Antes: si fopen falla (disk full, permisos, path inexistente), los 36 fwrite
        // subsiguientes crashean el server (access violation sobre handle nulo). Llamado
        // 18+ veces (cada SaveVehicle desde OnVehicleMod/Paintjob/Respray/CompraVeh/etc).
        // Vector de crash trivial: llenar el disco del server.
        if(!handle)
        {
                printf("[SaveVehicle] ERROR: no se pudo abrir %s para escritura. Abortando save (vehicleid=%d).", filename, vehicleid);
                return 0;
        }
        format(line, sizeof(line), "Created=%d\r\n", VehicleCreated[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Model=%d\r\n", VehicleModel[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Pos=%.3f,%.3f,%.3f,%.3f\r\n", VehiclePos[vehicleid][0], VehiclePos[vehicleid][1],
                VehiclePos[vehicleid][2], VehiclePos[vehicleid][3]);
        fwrite(handle, line);
        format(line, sizeof(line), "Colors=%d,%d\r\n", VehicleColor[vehicleid][0], VehicleColor[vehicleid][1]); fwrite(handle, line);
        format(line, sizeof(line), "Interior=%d\r\n", VehicleInterior[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "VirtualWorld=%d\r\n", VehicleWorld[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Owner=%s\r\n", VehicleOwner[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "NumberPlate=%s\r\n", VehicleNumberPlate[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Value=%d\r\n", VehicleValue[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Lock=%d\r\n", VehicleLock[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Alarm=%d\r\n", VehicleAlarm[vehicleid]); fwrite(handle, line);
        format(line, sizeof(line), "Paintjob=%d\r\n", VehiclePaintjob[vehicleid]); fwrite(handle, line);
        // FUEL-ARCHITECTURE: guardar combustible persistente
        // Sincronizar desde g_VehFuel (si el vehiculo esta creado en SA-MP)
        if(VehicleID[vehicleid] >= 1 && VehicleID[vehicleid] < MAX_VEHICLES
           && g_VehFuel[VehicleID[vehicleid]][vf_initialized]
           && g_VehFuel[VehicleID[vehicleid]][vf_persistentID] == vehicleid)
        {
                VehicleFuelPersist[vehicleid] = g_VehFuel[VehicleID[vehicleid]][vf_actual];
        }
        format(line, sizeof(line), "Fuel=%.2f\r\n", VehicleFuelPersist[vehicleid]); fwrite(handle, line);
        for(new t=0; t < sizeof(VehicleTrunk[]); t++)
        {
                format(line, sizeof(line), "Trunk%d=%d,%d\r\n", t+1, VehicleTrunk[vehicleid][t][0], VehicleTrunk[vehicleid][t][1]);
                fwrite(handle, line);
        }
        for(new m=0; m < sizeof(VehicleMods[]); m++)
        {
                format(line, sizeof(line), "Mod%d=%d\r\n", m, VehicleMods[vehicleid][m]);
                fwrite(handle, line);
        }
        fclose(handle);
        return 1; // FIX: warning 209 - function should return a value
}

UpdateVehicle(vehicleid, removeold)
{
        if(VehicleCreated[vehicleid])
        {
                if(removeold)
                {
                        // FUEL-ARCHITECTURE: guardar combustible antes de destruir
                        Fuel_SavePersistent(VehicleID[vehicleid]);
                        Fuel_DestroyVehicle(VehicleID[vehicleid]);

                        new Float:health;
                        GetVehicleHealth(VehicleID[vehicleid], health);
                        new engine, lights, alarm, doors, bonnet, boot, objective;
                        GetVehicleParamsEx(VehicleID[vehicleid], engine, lights, alarm, doors, bonnet, boot, objective);
                        new panels, doorsd, lightsd, tires;
                        GetVehicleDamageStatus(VehicleID[vehicleid], panels, doorsd, lightsd, tires);
                        DestroyVehicle(VehicleID[vehicleid]);
                        // FIX VEH-FINAL-9: respawn_delay diferenciado por tipo de vehiculo.
                        // VEHICLE_PLAYER: 0x7FFFFFFF (nunca respawnea solo, solo mecanico/admin).
                        // VEHICLE_DEALERSHIP: 60000 (60s, respawnea en dealership para venta).
                        new _respawnDelay = (VehicleCreated[vehicleid] == VEHICLE_PLAYER) ? 5000 : 60000; // FIX VEH-FINAL-11: 5s para VEHICLE_PLAYER, SA-MP respawnea solo
                        VehicleID[vehicleid] = CreateVehicle(VehicleModel[vehicleid], VehiclePos[vehicleid][0], VehiclePos[vehicleid][1],
                                VehiclePos[vehicleid][2], VehiclePos[vehicleid][3], VehicleColor[vehicleid][0], VehicleColor[vehicleid][1], _respawnDelay);
                        SetVehicleHealth(VehicleID[vehicleid], health);
                        SetVehicleParamsEx(VehicleID[vehicleid], engine, lights, alarm, doors, bonnet, boot, objective);
                        UpdateVehicleDamageStatus(VehicleID[vehicleid], panels, doorsd, lightsd, tires);

                        // FUEL-ARCHITECTURE: reinicializar combustible del nuevo nativeID
                        Fuel_InitVehicle(VehicleID[vehicleid], VehicleModel[vehicleid], vehicleid, 0, -1);
                }
                else
                {
                        // FIX VEH-FINAL-9: respawn_delay diferenciado por tipo de vehiculo.
                        new _respawnDelay2 = (VehicleCreated[vehicleid] == VEHICLE_PLAYER) ? 5000 : 60000; // FIX VEH-FINAL-11: 5s para VEHICLE_PLAYER, SA-MP respawnea solo
                        VehicleID[vehicleid] = CreateVehicle(VehicleModel[vehicleid], VehiclePos[vehicleid][0], VehiclePos[vehicleid][1],
                                VehiclePos[vehicleid][2], VehiclePos[vehicleid][3], VehicleColor[vehicleid][0], VehicleColor[vehicleid][1], _respawnDelay2);

                        // FUEL-ARCHITECTURE: inicializar combustible (carga desde persistencia)
                        Fuel_InitVehicle(VehicleID[vehicleid], VehicleModel[vehicleid], vehicleid, 0, -1);
                }
                LinkVehicleToInterior(VehicleID[vehicleid], VehicleInterior[vehicleid]);
                SetVehicleVirtualWorld(VehicleID[vehicleid], VehicleWorld[vehicleid]);
                SetVehicleNumberPlate(VehicleID[vehicleid], VehicleNumberPlate[vehicleid]);
                for(new i=0; i < sizeof(VehicleMods[]); i++)
                {
                        AddVehicleComponent(VehicleID[vehicleid], VehicleMods[vehicleid][i]);
                }
                ChangeVehiclePaintjob(VehicleID[vehicleid], VehiclePaintjob[vehicleid]);
                if(VehicleLock[vehicleid]) ToggleDoors(VehicleID[vehicleid], VEHICLE_PARAMS_ON);
                if(VehicleAlarm[vehicleid]) VehicleSecurity[VehicleID[vehicleid]] = 1;
                UpdateVehicleLabel(vehicleid, removeold);
        }
}

UpdateVehicleLabel(vehicleid, removeold)
{
        if(VehicleCreated[vehicleid] == VEHICLE_DEALERSHIP)
        {
                if(removeold)
                {
                        Delete3DTextLabel(VehicleLabel[vehicleid]);
                }
                new labeltext[500];
                format(labeltext, sizeof(labeltext), "{FFFF00}%s\n{FFFFFF}ID: {FFFF00}%d\n{FFFFFF}Concessionaria ID: {FFFF00}%s\n{FFFFFF}Valor: {FFFF00}$%s", VehicleNames[VehicleModel[vehicleid]-400],
                        vehicleid, VehicleOwner[vehicleid], ConvertMoney(VehicleValue[vehicleid]));
                VehicleLabel[vehicleid] = Create3DTextLabel(labeltext, 0xBB7700DD, 0, 0, 0, 10.0, 0);
                Attach3DTextLabelToVehicle(VehicleLabel[vehicleid], VehicleID[vehicleid], 0, 0, 0);
        }
}

IsValidVehicle1(vehicleid)
{
        if(vehicleid < 1 || vehicleid >= MAX_DVEHICLES) return 0;
        if(VehicleCreated[vehicleid]) return 1;
        return 0;
}

// =====================================================================
// FIX SPRINT2 A-15: helpers para encapsular ChangeVehiclePaintjob/AddVehicleComponent/
// ChangeVehicleColor + invocaciÃ¯Â¿Â½n manual de los callbacks OnVehicle* (en SA-MP 0.3.7
// estos natives no invocan el callback automÃ¯Â¿Â½ticamente). Antes: 16 parejas
// (ChangeVehiclePaintjob + OnVehiclePaintjob), 14 parejas (ChangeVehicleColor +
// OnVehicleRespray), 147 parejas (AddVehicleComponent + OnVehicleMod) - total ~350
// llamadas duplicadas. Si se aÃ¯Â¿Â½adia un check nuevo al callback, habia que tocar
// 350 sitios. Ahora: un Ã¯Â¿Â½nico punto de cambio. Ademas: si el jugador pasa por
// Pay 'n' Spray y el callback se dispara automÃ¯Â¿Â½ticamente, SaveVehicle se llama 2x
// (idempotente, no rompe pero overhead). Estos helpers son el patrÃ¯Â¿Â½n correcto.
// =====================================================================
stock AplicarPaintjob(playerid, vehicleid, paintjobid)
{
        ChangeVehiclePaintjob(vehicleid, paintjobid);
        new id = GetVehicleID(vehicleid);
        if(IsValidVehicle1(id))
        {
                VehiclePaintjob[id] = paintjobid;
                SaveVehicle(id);
        }
}

stock AplicarComponent(playerid, vehicleid, componentid)
{
        AddVehicleComponent(vehicleid, componentid);
        new id = GetVehicleID(vehicleid);
        if(IsValidVehicle1(id))
        {
                // FIX CRIT-VEH-001: validar GetVehicleComponentType antes de indexar (mismo fix que OnVehicleMod).
                new _compType = GetVehicleComponentType(componentid);
                if(_compType >= 0 && _compType < sizeof(VehicleMods[]))
                {
                        VehicleMods[id][_compType] = componentid;
                        SaveVehicle(id);
                }
        }
}

stock AplicarColor(playerid, vehicleid, color1, color2)
{
        ChangeVehicleColor(vehicleid, color1, color2);
        new id = GetVehicleID(vehicleid);
        if(IsValidVehicle1(id))
        {
                VehicleColor[id][0] = color1;
                VehicleColor[id][1] = color2;
                SaveVehicle(id);
        }
}

GetFreeVehicleID()
{
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(!VehicleCreated[i]) return i;
        }
        return 0;
}

// =====================================================================
// P0-BEN-TUNE: Funciones helper para el HUD de tuneo.
// =====================================================================
stock MostrarTuningHUD(playerid)
{
        TuningRuedaName[playerid] = "Stock";
        TuningColorName[playerid] = "Stock";
        PlayerTextDrawSetString(playerid, TuningHUD[playerid][2], "~w~Ruedas: ~g~Stock");
        PlayerTextDrawSetString(playerid, TuningHUD[playerid][3], "~w~Color: ~g~Stock");
        for(new i = 0; i < 4; i++)
                PlayerTextDrawShow(playerid, TuningHUD[playerid][i]);
        TuningActivo[playerid] = true;
        return 1;
}

stock OcultarTuningHUD(playerid)
{
        for(new i = 0; i < 4; i++)
                PlayerTextDrawHide(playerid, TuningHUD[playerid][i]);
        TuningActivo[playerid] = false;
        return 1;
}

stock ActualizarTuningRueda(playerid, nombre[])
{
        new str[64];
        format(str, sizeof(str), "~w~Ruedas: ~g~%s", nombre);
        PlayerTextDrawSetString(playerid, TuningHUD[playerid][2], str);
        return 1;
}

stock ActualizarTuningColor(playerid, nombre[])
{
        new str[64];
        format(str, sizeof(str), "~w~Color: ~g~%s", nombre);
        PlayerTextDrawSetString(playerid, TuningHUD[playerid][3], str);
        return 1;
}

GetVehicleID(vehicleid)
{
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] && VehicleID[i] == vehicleid) return i;
        }
        return 0;
}

GetPlayerVehicles(playerid)
{
        new playername[24];
        GetPlayerName(playerid, playername, sizeof(playername));
        new count;
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] == VEHICLE_PLAYER && strcmp(VehicleOwner[i], playername) == 0)
                {
                        count++;
                }
        }
        return count;
}

GetPlayerVehicleAccess(playerid, vehicleid)
{
        if(IsValidVehicle1(vehicleid))
        {
                if(VehicleCreated[vehicleid] == VEHICLE_DEALERSHIP)
                {
                        if(pJogando[playerid] == false)
                        {
                                return 1;
                        }
                }
                else if(VehicleCreated[vehicleid] == VEHICLE_PLAYER)
                {
                        if(strcmp(VehicleOwner[vehicleid], Name(playerid)) == 0)
                        {
                                return 2;
                        }
                        else if(GetPVarInt(playerid, "CarKeys") == vehicleid)
                        {
                                return 1;
                        }
                }
        }
        else
        {
                return 1;
        }
        return 0;
}

LoadDealerships()
{
        new File:handle, count;
        new filename[64], line[256], s, key[64];
        for(new i=1; i < MAX_DEALERSHIPS; i++)
        {
                format(filename, sizeof(filename), DEALERSHIP_FILE_PATH "d%d.ini", i);
                if(!fexist(filename)) continue;
                handle = fopen(filename, io_read);
                // [DEAL-FASE2-3] FIX AUD2-002: null check tras fopen (io_read).
                // Patron replicado de LoadFuelStations (L8976-8980,
                // GASBIZ-FASE2-B C4). Antes: si fopen fallaba (archivo
                // corrupto, permisos, race condition con renombrado manual
                // aunque fexist diga true), `while(fread(handle, line))` con
                // handle=File:0 tenia comportamiento indefinido en SA-MP.
                // Mas severo que AUD2-001: el crash de SaveDealership requiere
                // que un admin use un comando; el crash de LoadDealerships
                // ocurre automaticamente al arrancar, sin interaccion humana,
                // y deja el server sin poder levantar (downtime persistente
                // hasta limpiar/reparar el .ini). Ahora: fail-fast con
                // `continue` al proximo i del loop + log a printf para que el
                // staff vea el problema en server.log. DealershipCreated[i]
                // queda en 0 (default), IsValidDealership retornara 0 y el
                // resto del GM la ignorara.
                if(!handle)
                {
                        printf("[DEAL-FASE2-3 AUD2-002] LoadDealerships: fopen fallo para '%s'. Saltando concesionaria (Created=0 en memoria).", filename);
                        continue;
                }
                while(fread(handle, line))
                {
                        StripNL(line);
                        s = strfind(line, "=");
                        if(!line[0] || s < 1) continue;
                        strmid(key, line, 0, s++);
                        if(strcmp(key, "Created") == 0) DealershipCreated[i] = strval(line[s]);
                        else if(strcmp(key, "Pos") == 0) sscanf(line[s], "p<,>fff", DealershipPos[i][0],
                                DealershipPos[i][1], DealershipPos[i][2]);
                }
                fclose(handle);
                if(DealershipCreated[i]) count++;
        }
        printf("=> Concessionarias                      : %d Carregados", count);
}

SaveDealership(dealerid)
{
        new filename[64], line[256];
        format(filename, sizeof(filename), DEALERSHIP_FILE_PATH "d%d.ini", dealerid);
        new File:handle = fopen(filename, io_write);
        // [DEAL-FASE2-3] FIX AUD2-001: null check tras fopen (io_write).
        // Patron replicado de SaveVehicle (L8607-8617) y SaveFuelStation
        // (L9074-9075, GASBIZ-CRIT-8). Antes: si fopen fallaba (disco lleno,
        // permisos, path inexistente), los fwrite posteriores escribian en
        // File:0 (handle invalido) Ã¢Â€Â” comportamiento indefinido en SA-MP,
        // tipicamente silencioso (archivo vacio o no creado) y el GM creia
        // que el estado estaba persistido. Vector de crash trivial: llenar
        // el disco del server y esperar a que un admin use /movedealership,
        // /adddealership o /deletedealership. Ahora: fail-fast con printf al
        // server.log y return 0 (silencioso para el admin Ã¢Â€Â” el comando
        // principal ya mostro SuccesMsg; este log es para diagnostico
        // post-mortem del staff).
        if(!handle)
        {
                printf("[DEAL-FASE2-3 AUD2-001] SaveDealership: fopen fallo para '%s' (dealerid=%d). Abortando save (estado en memoria NO persistido).", filename, dealerid);
                return 0;
        }
        format(line, sizeof(line), "Created=%d\r\n", DealershipCreated[dealerid]); fwrite(handle, line);
        format(line, sizeof(line), "Pos=%.3f,%.3f,%.3f\r\n", DealershipPos[dealerid][0],
                DealershipPos[dealerid][1], DealershipPos[dealerid][2]);
        fwrite(handle, line);
        fclose(handle);
        return 1;
}

UpdateDealership(dealerid, removeold)
{
        if(DealershipCreated[dealerid])
        {
                if(removeold)
                {
                        Delete3DTextLabel(DealershipLabel[dealerid]);
                }
                new labeltext[500];
                format(labeltext, sizeof(labeltext), "{FFFF00}Spawn Vehiculo\n{FFFFFF}ID: {FFFF00}%d", dealerid);
                DealershipLabel[dealerid] = Create3DTextLabel(labeltext, 0x00BB00DD, DealershipPos[dealerid][0],
                        DealershipPos[dealerid][1], DealershipPos[dealerid][2]+0.5, 20.0, 0);
        }
}

IsValidDealership(dealerid)
{
        if(dealerid < 1 || dealerid >= MAX_DEALERSHIPS) return 0;
        if(DealershipCreated[dealerid]) return 1;
        return 0;
}

LoadFuelStations()
{
        new File:handle, count;
        new filename[64], line[256], s, key[64];
        for(new i=1; i < MAX_FUEL_STATIONS; i++)
        {
                format(filename, sizeof(filename), FUEL_STATION_FILE_PATH "f%d.ini", i);
                if(!fexist(filename)) continue;
                // Defaults por si faltan campos
                FuelStationGasolinaCap[i] = FS_DEFAULT_GAS_CAP;
                FuelStationPetroleoCap[i] = FS_DEFAULT_PET_CAP;
                FuelStationGasolinaStock[i] = FS_DEFAULT_GAS_STOCK;
                FuelStationPetroleoStock[i] = FS_DEFAULT_PET_STOCK;
                FuelStationAbierta[i] = true;
                FuelStationValor[i] = FS_DEFAULT_VALOR;
                FuelStationCaja[i] = 0;
                FuelStationPrecioGasolina[i] = 3;
                FuelStationPrecioDiesel[i] = 4;
                format(FuelStationName[i], 32, "Gasolinera #%d", i);
                handle = fopen(filename, io_read);
                // GASBIZ-FASE2-B C4: validar fopen != null. Antes: si fopen
                // fallaba (ej. archivo corrupto, permisos, path invalido,
                // race condition con renombrado manual), `while(fread(handle,
                // line))` con handle=File:0 tenia comportamiento indefinido en
                // SA-MP (tipicamente no leia nada, pero podia leer basura o
                // crashear el server). SaveFuelStation ya valida esto (CRIT-4,
                // L8966: `if(!handle) return 0;`), pero LoadFuelStations no.
                // Patron replicado de CRIT-4 FUEL: fail-fast con `continue`
                // al proximo i del loop. Los defaults inicializados arriba
                // (lines 8861-8870) se mantienen, pero la estacion NO se
                // marca como creada (Created=0 default) Ã¢Â€Â” IsValidFuelStation
                // retornara 0 y el resto del GM la ignorara. Log a printf
                // para que el admin vea el problema en server.log.
                if(!handle)
                {
                        printf("[GASBIZ-FASE2-B C4] LoadFuelStations: fopen fallo para '%s'. Saltando estacion (defaults quedan en memoria, Created=0).", filename);
                        continue;
                }
                while(fread(handle, line))
                {
                        StripNL(line);
                        s = strfind(line, "=");
                        if(!line[0] || s < 1) continue;
                        strmid(key, line, 0, s++);
                        if(strcmp(key, "Created") == 0) FuelStationCreated[i] = strval(line[s]);
                        else if(strcmp(key, "Pos") == 0) sscanf(line[s], "p<,>fff", FuelStationPos[i][0], FuelStationPos[i][1], FuelStationPos[i][2]);
                        else if(strcmp(key, "PrecioGasolina") == 0) FuelStationPrecioGasolina[i] = strval(line[s]);
                        else if(strcmp(key, "PrecioNafta") == 0) FuelStationPrecioGasolina[i] = strval(line[s]);
                        else if(strcmp(key, "PrecioDiesel") == 0) FuelStationPrecioDiesel[i] = strval(line[s]);
                        else if(strcmp(key, "OwnerIDF") == 0) FuelStationOwnerIDF[i] = strval(line[s]);
                        else if(strcmp(key, "Name") == 0) strmid(FuelStationName[i], line, s, s+32);
                        else if(strcmp(key, "GasolinaStock") == 0) FuelStationGasolinaStock[i] = strval(line[s]);
                        else if(strcmp(key, "GasolinaCap") == 0) FuelStationGasolinaCap[i] = strval(line[s]);
                        else if(strcmp(key, "PetroleoStock") == 0) FuelStationPetroleoStock[i] = strval(line[s]);
                        else if(strcmp(key, "PetroleoCap") == 0) FuelStationPetroleoCap[i] = strval(line[s]);
                        else if(strcmp(key, "Abierta") == 0) FuelStationAbierta[i] = (strval(line[s]) == 1);
                        else if(strcmp(key, "Valor") == 0) FuelStationValor[i] = strval(line[s]);
                        else if(strcmp(key, "LastRestock") == 0) FuelStationLastRestock[i] = strval(line[s]);
                        else if(strcmp(key, "Caja") == 0) FuelStationCaja[i] = strval(line[s]);
                }
                fclose(handle);
                // GASBIZ-CRIT-10 (AUD4-CRIT-002/003): validar y clamp campos tras
                // carga para evitar estados corruptos por tampering de archivos
                // .ini de gasolineras. Solo aplica si la estacion esta marcada como
                // creada (Created=1); si no, los valores en memoria son ignorados
                // por el resto del GM (IsValidFuelStation retorna 0).
                if(FuelStationCreated[i])
                {
                        // 1) OwnerIDF: si > 0, validar que exista el marker file
                        //    IDs/%04d.ini (creado al registrar cuenta). Si no existe,
                        //    el IDF apunta a una cuenta que ya no existe (ej. cuenta
                        //    borrada manualmente o migracion incompleta). Resetear a
                        //    0 (servidor) para que la estacion vuelva a ser publica.
                        if(FuelStationOwnerIDF[i] > 0)
                        {
                                new markerFile[64];
                                format(markerFile, sizeof(markerFile), "IDs/%04d.ini", FuelStationOwnerIDF[i]);
                                if(!DOF2_FileExists(markerFile))
                                {
                                        printf("[GASBIZ-CRIT-10] Gasolinera %d: OwnerIDF=%d sin marker file IDs/%04d.ini. Reset a 0 (servidor).",
                                                i, FuelStationOwnerIDF[i], FuelStationOwnerIDF[i]);
                                        FuelStationOwnerIDF[i] = 0;
                                }
                        }
                        // 2) Caja: clamp upper bound 10000000 (10M). Sin clamp, un
                        //    admin malicioso podria editar Caja=999999999 en el .ini y
                        //    al reclamar via /gasreclamar recibir dinero creado. 10M
                        //    es un max razonable de acumulacion (50 ventas/dia * $5/L
                        //    * 100L = 25000/dia, ~ 1 ano para llegar a 10M).
                        if(FuelStationCaja[i] > 10000000)
                        {
                                printf("[GASBIZ-CRIT-10] Gasolinera %d: Caja=%d > 10M, clampeado a 10000000.",
                                        i, FuelStationCaja[i]);
                                FuelStationCaja[i] = 10000000;
                        }
                        // 3) Caps (GasolinaCap, PetroleoCap): clamp upper 100000.
                        //    Sin clamp, un admin malicioso podria editar
                        //    GasolinaCap=999999999 y luego /gasrestock 999999 litros
                        //    de gasolina, destruyendo el valor de la gasolina del
                        //    servidor. 100k es el max razonable (FS_DEFAULT_GAS_CAP=50k,
                        //    FS_DEFAULT_PET_CAP=30k, /gassetcap permite hasta 100k).
                        if(FuelStationGasolinaCap[i] > 100000)
                        {
                                printf("[GASBIZ-CRIT-10] Gasolinera %d: GasolinaCap=%d > 100000, clampeado a 100000.",
                                        i, FuelStationGasolinaCap[i]);
                                FuelStationGasolinaCap[i] = 100000;
                        }
                        if(FuelStationPetroleoCap[i] > 100000)
                        {
                                printf("[GASBIZ-CRIT-10] Gasolinera %d: PetroleoCap=%d > 100000, clampeado a 100000.",
                                        i, FuelStationPetroleoCap[i]);
                                FuelStationPetroleoCap[i] = 100000;
                        }
                }
                if(FuelStationCreated[i]) count++;
        }
        printf("=> Gasolineras cargadas: %d", count);
}

SaveFuelStation(stationid)
{
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): retornar 1/0 para que callers puedan
        // verificar fallo de persistencia. Antes la funcion no retornaba nada
        // (implicito 0 en Pawn), y TODOS los callers asumian exito. Si fopen
        // fallaba (ej. disco lleno, permisos, path invalido), los fwrite
        // posteriores escribian en File:0 (handle invalido) Ã¢Â€Â” comportamiento
        // indefinido en SA-MP, pero tipicamente silencioso: el archivo quedaba
        // vacio o no se creaba, y el GM creia que el estado estaba persistido.
        // Ahora fail-fast en fopen y retornamos 1 solo si fclose ok.
        new filename[64], line[256];
        format(filename, sizeof(filename), FUEL_STATION_FILE_PATH "f%d.ini", stationid);
        new File:handle = fopen(filename, io_write);
        if(!handle) return 0; // fail-fast: no se pudo abrir el archivo
        format(line, sizeof(line), "Created=%d\r\n", FuelStationCreated[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "Pos=%.3f,%.3f,%.3f\r\n", FuelStationPos[stationid][0], FuelStationPos[stationid][1], FuelStationPos[stationid][2]); fwrite(handle, line);
        format(line, sizeof(line), "Name=%s\r\n", FuelStationName[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "PrecioGasolina=%d\r\n", FuelStationPrecioGasolina[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "PrecioDiesel=%d\r\n", FuelStationPrecioDiesel[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "OwnerIDF=%d\r\n", FuelStationOwnerIDF[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "GasolinaStock=%d\r\n", FuelStationGasolinaStock[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "GasolinaCap=%d\r\n", FuelStationGasolinaCap[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "PetroleoStock=%d\r\n", FuelStationPetroleoStock[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "PetroleoCap=%d\r\n", FuelStationPetroleoCap[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "Abierta=%d\r\n", FuelStationAbierta[stationid] ? 1 : 0); fwrite(handle, line);
        format(line, sizeof(line), "Valor=%d\r\n", FuelStationValor[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "LastRestock=%d\r\n", FuelStationLastRestock[stationid]); fwrite(handle, line);
        format(line, sizeof(line), "Caja=%d\r\n", FuelStationCaja[stationid]); fwrite(handle, line);
        fclose(handle);
        return 1;
}

UpdateFuelStation(stationid, removeold)
{
        if(FuelStationCreated[stationid])
        {
                if(removeold) Delete3DTextLabel(FuelStationLabel[stationid]);
                new gasolinaP = GetFuelStationPrecio(stationid, 0);
                new dieselP = GetFuelStationPrecio(stationid, 1);
                // GASBIZ-CRIT-3: usar helper que resuelve IDF->Name via marker file
                // IDs/<IDFzero-padded>.ini (key "IDF de:") en vez de Contas/<IDF>.ini
                // (que no existe: SalvarDados escribe Contas/<Name>.ini). El helper
                // tambien hace fallback a dueno online. Antes el 3D label mostraba
                // "Desconocido" para todo dueno offline.
                new ownerName[24];
                Fuel_Station_ResolveOwnerName(FuelStationOwnerIDF[stationid], ownerName, sizeof(ownerName));
                new labeltext[512];
                new estadoStr[16];
                if(FuelStationAbierta[stationid]) estadoStr = "{00FF00}Abierta";
                else estadoStr = "{FF0000}Cerrada";
                format(labeltext, sizeof(labeltext),
                        "{FFFF00}%s\n{FFFFFF}ID: {FFFF00}%d\n{FFFFFF}Propietario: {FFFF00}%s\n\
                        {FFFFFF}Gasolina: {00FF00}%d/%d L\n{FFFFFF}Petroleo: {00FF00}%d/%d L\n\
                        {FFFFFF}Precio Gas: {FFFF00}$%d/L  Pet: {FFFF00}$%d/L\n\
                        {FFFFFF}Estado: %s\n{FFFFFF}/abastecer",
                        FuelStationName[stationid], stationid, ownerName,
                        FuelStationGasolinaStock[stationid], FuelStationGasolinaCap[stationid],
                        FuelStationPetroleoStock[stationid], FuelStationPetroleoCap[stationid],
                        gasolinaP, dieselP, estadoStr);
                FuelStationLabel[stationid] = Create3DTextLabel(labeltext, 0x00BBFFDD,
                        FuelStationPos[stationid][0], FuelStationPos[stationid][1],
                        FuelStationPos[stationid][2]+0.5, 20.0, 0);
        }
}

IsValidFuelStation(stationid)
{
        if(stationid < 1 || stationid >= MAX_FUEL_STATIONS) return 0;
        if(FuelStationCreated[stationid]) return 1;
        return 0;
}

// GASBIZ-CRIT-1-2-3: resolver el nombre del dueno de una gasolinera desde su IDF.
// El GM guarda Contas/<Name>.ini (por nombre), NO Contas/<IDF>.ini (por numero).
// Pero SI existe un marker file IDs/<IDFzero-padded>.ini con la key "IDF de:" que
// contiene el nombre (escrito en L32999-33003 al registrar cuenta). Usamos ese
// marker para resolver el nombre. DOF2_GetString(file, key) retorna string directo
// (firma de 2 args verificada en L8899/L18181 etc).
stock Fuel_Station_ResolveOwnerName(ownerIDF, name[], len)
{
        if(ownerIDF <= 0)
        {
                format(name, len, "Servidor");
                return 0;
        }
        new markerFile[64];
        format(markerFile, sizeof(markerFile), "IDs/%04d.ini", ownerIDF);
        if(DOF2_FileExists(markerFile))
        {
                new ownerName[24];
                format(ownerName, sizeof(ownerName), "%s", DOF2_GetString(markerFile, "IDF de:"));
                if(strlen(ownerName) > 0)
                {
                        format(name, len, "%s", ownerName);
                        return 1; // encontrado
                }
        }
        // Fallback: buscar dueno online
        foreach(new p : Player)
        {
                if(pLogado[p] && PlayerInfo[p][IDF] == ownerIDF)
                {
                        format(name, len, "%s", Name(p));
                        return 1;
                }
        }
        format(name, len, "Desconocido (offline)");
        return 0; // no encontrado
}

CallBack::MainTimer()
{
        new string[128];
        new Float:x, Float:y, Float:z;
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i))
                {
                        if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
                        {
                                new vehicleid = GetPlayerVehicleID(i);
                                // FUEL-ARCHITECTURE: Sistema de consumo por distancia (RP elite).
                                //   - Bicicletas: no consumen (excluidas)
                                //   - Motor OFF: 0 consumo
                                //   - Motor ON + detenido: ralenti FUEL_RALENTI_LPM (0.02 L/min)
                                //   - Motor ON + en movimiento: (distancia_km x consumoBase/100) x mult_vel
                                //
                                // Multiplicador por velocidad:
                                //   1-60 km/h    -> x1.00
                                //   61-100 km/h  -> x1.05
                                //   101-140 km/h -> x1.15
                                //   141-180 km/h -> x1.30
                                //   180+ km/h    -> x1.50
                                //
                                // Alertas por porcentaje del tanque (no por litros fijos):
                                //   20% -> amarillo (alerta baja)
                                //   10% -> naranja (critico)
                                //    5% -> rojo (reserva, no apaga todavia)
                                //    0% -> apaga motor
                                if(vehicleid >= 1 && vehicleid < MAX_VEHICLES
                                   && g_VehFuel[vehicleid][vf_initialized] && !IsBicycle(vehicleid))
                                {
                                        new engine, lights, alarm, doors, bonnet, boot, objective;
                                        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
                                        if(engine == 1 && g_VehFuel[vehicleid][vf_actual] > 0.0)
                                        {
                                                new speed = VelocidadDoVeiculo(vehicleid);
                                                new Float:consumoLitros;

                                                if(speed == 0)
                                                {
                                                        // Ralenti: consumo por tiempo (varia por categoria)
                                                        // MainTimer corre cada 1s = 1/60 min
                                                        new _cat = GetVehicleFuelCategory(GetVehicleModel(vehicleid));
                                                        consumoLitros = (FUEL_RALENTI_LPM * GetRalentiMultByCategory(_cat)) / 60.0;
                                                }
                                                else
                                                {
                                                        // Consumo por distancia (3D: incluye Z para colinas/tuneles)
                                                        new Float:cx, Float:cy, Float:cz;
                                                        GetVehiclePos(vehicleid, cx, cy, cz);
                                                        new Float:dx = cx - g_VehFuel[vehicleid][vf_lastX];
                                                        new Float:dy = cy - g_VehFuel[vehicleid][vf_lastY];
                                                        new Float:dz = cz - g_VehFuel[vehicleid][vf_lastZ];
                                                        new Float:distMetros = floatsqroot(dx*dx + dy*dy + dz*dz);
                                                        new Float:distKm = distMetros / 1000.0;

                                                        // Multiplicador por velocidad
                                                        new Float:mult;
                                                        if(speed <= 60) mult = 1.00;
                                                        else if(speed <= 100) mult = 1.05;
                                                        else if(speed <= 140) mult = 1.15;
                                                        else if(speed <= 180) mult = 1.30;
                                                        else mult = 1.50;

                                                        consumoLitros = (distKm * g_VehFuel[vehicleid][vf_consumoBase] / 100.0) * mult;

                                                        // Actualizar posicion para proximo tick
                                                        g_VehFuel[vehicleid][vf_lastX] = cx;
                                                        g_VehFuel[vehicleid][vf_lastY] = cy;
                                                        g_VehFuel[vehicleid][vf_lastZ] = cz;
                                                }

                                                // Mejora: multiplicador por dano vehicular.
                                                // Vehiculo con dano (salud < 400) consume mas combustible.
                                                new Float:vehHealth;
                                                GetVehicleHealth(vehicleid, vehHealth);
                                                if(vehHealth < 400.0)
                                                {
                                                    // Dano leve: +15% consumo. Dano severo: +30%.
                                                    if(vehHealth < 250.0)
                                                        consumoLitros *= 1.30;
                                                    else
                                                        consumoLitros *= 1.15;
                                                }

                                                // Aplicar consumo
                                                g_VehFuel[vehicleid][vf_actual] -= consumoLitros;
                                                // Sincronizar Fuel[] legacy
                                                Fuel[vehicleid] = g_VehFuel[vehicleid][vf_actual];

                                                // Alertas por porcentaje (con anti-spam por stage)
                                                new Float:pct = Fuel_GetPercent(vehicleid);
                                                new curStage;
                                                if(pct <= 0.0) curStage = 4;
                                                else if(pct <= FUEL_ALERTA_RESERVA) curStage = 3;
                                                else if(pct <= FUEL_ALERTA_CRITICO) curStage = 2;
                                                else if(pct <= FUEL_ALERTA_BAJO) curStage = 1;
                                                else curStage = 0;

                                                if(curStage > g_VehFuel[vehicleid][vf_alertStage])
                                                {
                                                        g_VehFuel[vehicleid][vf_alertStage] = curStage;
                                                        if(curStage == 1)
                                                        {
                                                                GameTextForPlayer(i, "~y~COMBUSTIBLE BAJO", 2000, 5);
                                                                PlayerPlaySound(i, 1085, 0.0, 0.0, 0.0);
                                                        }
                                                        else if(curStage == 2)
                                                        {
                                                                GameTextForPlayer(i, "~o~COMBUSTIBLE CRITICO", 2500, 5);
                                                                PlayerPlaySound(i, 1085, 0.0, 0.0, 0.0);
                                                        }
                                                        else if(curStage == 3)
                                                        {
                                                                GameTextForPlayer(i, "~r~RESERVA DE COMBUSTIBLE", 3000, 5);
                                                                PlayerPlaySound(i, 1085, 0.0, 0.0, 0.0);
                                                        }
                                                }
                                                else if(curStage < g_VehFuel[vehicleid][vf_alertStage])
                                                {
                                                        // Repostaron: resetear stage para que vuelva a alertar
                                                        g_VehFuel[vehicleid][vf_alertStage] = curStage;
                                                }

                                                // Apagar motor al llegar a 0
                                                if(g_VehFuel[vehicleid][vf_actual] <= 0.0)
                                                {
                                                        g_VehFuel[vehicleid][vf_actual] = 0.0;
                                                        Fuel[vehicleid] = 0.0;
                                                        ToggleEngine(vehicleid, VEHICLE_PARAMS_OFF);
                                                        g_VehFuel[vehicleid][vf_alertStage] = 4;
                                                        GameTextForPlayer(i, "~r~SIN COMBUSTIBLE", 3000, 5);
                                                        PlayerPlaySound(i, 1085, 0.0, 0.0, 0.0);
                                                        InfoMsg(i, "El vehiculo se detuvo por falta de combustible. Usa /abastecer o un bidon.");
                                                }
                                        }
                                        else if(g_VehFuel[vehicleid][vf_actual] <= 0.0 && engine == 1)
                                        {
                                                // Sin combustible pero motor encendido: apagar
                                                ToggleEngine(vehicleid, VEHICLE_PARAMS_OFF);
                                        }
                                }
                        }
                        if(RefuelTime[i] > 0 && GetPVarInt(i, "FuelStation"))
                        {
                                // FUEL-ARCHITECTURE: Repostaje con tiempo proporcional + display de costo.
                                //   - Cada tick (1s) agrega (1 / FUEL_TIEMPO_POR_LITRO) litros
                                //   - Display dinamico: "Cargando... X/Y L | Costo: $Z"
                                //   - Al finalizar: cobra costo total, limpia PVars
                                //   - Anti-exploit: clamp cost<0, validar conductor, validar posicion
                                if(GetPlayerState(i) != PLAYER_STATE_DRIVER)
                                {
                                        RefuelTime[i] = 0;
                                        DeletePVar(i, "FuelStation");
                                        DeletePVar(i, "Fuel");
                                }
                                else
                                {
                                        new vehicleid = GetPlayerVehicleID(i);
                                        if(vehicleid >= 1 && vehicleid < MAX_VEHICLES
                                           && g_VehFuel[vehicleid][vf_initialized])
                                        {
                                                // Litros por tick (inverso del tiempo por litro)
                                                new Float:litrosPorTick = 1.0 / FUEL_TIEMPO_POR_LITRO;
                                                new Float:espacio = g_VehFuel[vehicleid][vf_capacidad] - g_VehFuel[vehicleid][vf_actual];
                                                if(litrosPorTick > espacio) litrosPorTick = espacio;

                                                // GAS-STATION-BUSINESS: descontar del stock de la estacion
                                                new stationidRef = GetPVarInt(i, "FuelStation");
                                                new litrosInt = floatround(litrosPorTick, floatround_floor);
                                                if(litrosInt < 1) litrosInt = 1;
                                                if(stationidRef > 0 && stationidRef < MAX_FUEL_STATIONS && FuelStationCreated[stationidRef])
                                                {
                                                        // Verificar si la estacion esta abierta
                                                        if(!FuelStationAbierta[stationidRef])
                                                        {
                                                                // CRIT-2 fix: cobrar fuel ya cargado antes de cancelar
                                                                Fuel_CobrarYFinalizar(i, vehicleid, "La gasolinera esta cerrada. Repostaje cancelado.");
                                                                continue;
                                                        }
                                                        // Descontar del stock segun tipo de combustible
                                                        if(g_VehFuel[vehicleid][vf_tipoComb] == 1) // petroleo
                                                        {
                                                                if(FuelStationPetroleoStock[stationidRef] <= 0)
                                                                {
                                                                        // CRIT-2 fix: cobrar fuel ya cargado antes de cancelar
                                                                        Fuel_CobrarYFinalizar(i, vehicleid, "La gasolinera se quedo sin petroleo. Repostaje cancelado.");
                                                                        continue;
                                                                }
                                                                FuelStationPetroleoStock[stationidRef] -= litrosInt;
                                                                if(FuelStationPetroleoStock[stationidRef] < 0) FuelStationPetroleoStock[stationidRef] = 0;
                                                        }
                                                        else // gasolina
                                                        {
                                                                if(FuelStationGasolinaStock[stationidRef] <= 0)
                                                                {
                                                                        // CRIT-2 fix: cobrar fuel ya cargado antes de cancelar
                                                                        Fuel_CobrarYFinalizar(i, vehicleid, "La gasolinera se quedo sin gasolina. Repostaje cancelado.");
                                                                        continue;
                                                                }
                                                                FuelStationGasolinaStock[stationidRef] -= litrosInt;
                                                                if(FuelStationGasolinaStock[stationidRef] < 0) FuelStationGasolinaStock[stationidRef] = 0;
                                                        }
                                                }

                                                g_VehFuel[vehicleid][vf_actual] += litrosPorTick;
                                                Fuel[vehicleid] = g_VehFuel[vehicleid][vf_actual];

                                                // Reset alert stage (repostando)
                                                g_VehFuel[vehicleid][vf_alertStage] = 0;

                                                RefuelTime[i]--;

                                                // Display de progreso cada tick
                                                // FUEL-ARCHITECTURE: precio configurable por estacion
                                                new stationidForPrecio = GetPVarInt(i, "FuelStation");
                                                new precioPorLitro = GetFuelStationPrecio(stationidForPrecio, g_VehFuel[vehicleid][vf_tipoComb]);
                                                new Float:cargadoAhora = g_VehFuel[vehicleid][vf_actual] - GetPVarFloat(i, "Fuel");
                                                new costoActual = floatround(cargadoAhora * precioPorLitro);
                                                if(costoActual < 0) costoActual = 0;
                                                format(string, sizeof(string), "~w~Cargando... ~g~%.1f~w~/~g~%.1f L~n~~w~Costo: ~y~$%d",
                                                        g_VehFuel[vehicleid][vf_actual], g_VehFuel[vehicleid][vf_capacidad], costoActual);
                                                GameTextForPlayer(i, string, 1100, 3);

                                                if(RefuelTime[i] == 0 || g_VehFuel[vehicleid][vf_actual] >= g_VehFuel[vehicleid][vf_capacidad])
                                                {
                                                        // Finalizar repostaje
                                                        if(g_VehFuel[vehicleid][vf_actual] >= g_VehFuel[vehicleid][vf_capacidad])
                                                                g_VehFuel[vehicleid][vf_actual] = g_VehFuel[vehicleid][vf_capacidad];
                                                        Fuel[vehicleid] = g_VehFuel[vehicleid][vf_actual];

                                                        new stationid = GetPVarInt(i, "FuelStation");
                                                        // FUEL-ARCHITECTURE: re-validar posicion en estacion
                                                        // CRIT-2 fix: si se alejo, cobra fuel ya cargado via helper
                                                        if(stationid > 0 && IsValidFuelStation(stationid)
                                                           && !IsPlayerInRangeOfPoint(i, 15.0, FuelStationPos[stationid][0], FuelStationPos[stationid][1], FuelStationPos[stationid][2]))
                                                        {
                                                                Fuel_CobrarYFinalizar(i, vehicleid, "Te alejaste de la estacion. Repostaje cancelado.");
                                                        }
                                                        else
                                                        {
                                                                // CRIT-1 fix: helper cobra correctamente sin money-clamp
                                                                Fuel_CobrarYFinalizar(i, vehicleid, "");
                                                        }
                                                }
                                        }
                                }
                        }
                        if(TrackCar[i])
                        {
                                GetVehiclePos(TrackCar[i], x, y, z);
                                SetPlayerCheckpoint(i, x, y, z, 3);
                        }
                }
        }
        // GAS-STATION-BUSINESS: auto-restock para estaciones del servidor
        // GASBIZ-FASE2-C D6: throttle a 10 estaciones por tick para evitar
        // lag spikes cuando muchas estaciones del servidor necesitan restock
        // simultaneo (cada restock llama UpdateFuelStation + SaveFuelStation
        // = escritura a disco). Antes procesaba hasta MAX_FUEL_STATIONS-1
        // estaciones en un solo tick.
        new _restockCount = 0;
        for(new s = 1; s < MAX_FUEL_STATIONS && _restockCount < 10; s++)
        {
                if(!FuelStationCreated[s]) continue;
                if(FuelStationOwnerIDF[s] != 0) continue; // solo servidor
                if(FuelStationGasolinaStock[s] < FS_AUTO_RESTOCK_THRESHOLD)
                {
                        new fillGas = (FuelStationGasolinaCap[s] * FS_AUTO_RESTOCK_FILL) / 100;
                        FuelStationGasolinaStock[s] = fillGas;
                        FuelStationLastRestock[s] = gettime();
                        UpdateFuelStation(s, 1);
                        SaveFuelStation(s);
                }
                if(FuelStationPetroleoStock[s] < FS_AUTO_RESTOCK_THRESHOLD)
                {
                        new fillPet = (FuelStationPetroleoCap[s] * FS_AUTO_RESTOCK_FILL) / 100;
                        FuelStationPetroleoStock[s] = fillPet;
                        FuelStationLastRestock[s] = gettime();
                        UpdateFuelStation(s, 1);
                        SaveFuelStation(s);
                }
                _restockCount++;
        }
}

CallBack::SaveTimer()
{
        // Guardado rotativo de vehiculos (uno por tick, cada 2222ms)
        SaveVehicleIndex++;
        if(SaveVehicleIndex >= MAX_DVEHICLES) SaveVehicleIndex = 1;
        if(IsValidVehicle1(SaveVehicleIndex)) SaveVehicle(SaveVehicleIndex);

        // FIX AUDIT AGENT5 XS-13: guardado rotativo de jugadores (1 por tick).
        // Antes: foreach TODOS los jugadores cada 60s = 200*4=800 escrituras
        // simultaneas a disco = lag spike. Ahora: 1 jugador por tick, round-robin.
        // Cada jugador se guarda cada ~SavePlayerSaveInterval segundos.
        // MANTENEMOS el guardado completo cada 60s como backup adicional.
        //
        // FIX AUDIT4 PERS-CRIT-08: antes iteraba MAX_PLAYERS=500 slots (18.5 min por
        // save con 200 jugadores). Ahora usa foreach para solo iterar slots
        // conectados. Mantiene un indice (SavePlayerIndex) que avanza entre los
        // jugadores conectados (no entre los 500 slots brutos).
        new totalConnected = 0;
        foreach(new i : Player)
        {
                if(pLogado[i]) totalConnected++;
        }
        if(totalConnected == 0)
        {
                // Sin jugadores conectados: resetear indice para proxima sesion
                SavePlayerIndex = 0;
        }
        else
        {
                if(SavePlayerIndex >= totalConnected) SavePlayerIndex = 0;
                new connectedIdx = 0;
                new savedId = -1;
                foreach(new i : Player)
                {
                        if(!pLogado[i]) continue;
                        if(connectedIdx == SavePlayerIndex)
                        {
                                savedId = i;
                                break;
                        }
                        connectedIdx++;
                }
                if(savedId != -1)
                {
                        SalvarDados(savedId);
                        // FIX AUDIT5 PERF-CRIT-02: spread backup en vez de burst 900 writes cada 60s.
                        // Antes: foreach ALL x 3 saves (Inventario+VIP+Evaluacion) = 900 writes
                        // burst cada 60s = lag spike. Ahora: 1 jugador por tick (rotatorio),
                        // igual que SalvarDados. Cada jugador se guarda cada ~SavePlayerSaveInterval.
                        SalvarInventario(savedId);
                        SalvarEvaluacion(savedId);
                        SalvarVIP(savedId);
                }
                SavePlayerIndex++;
        }

        // FIX AUDIT5 PERF-CRIT-02: el guardado de Inventario/Evaluacion/VIP ahora
        // se hace 1 jugador por tick arriba (rotatorio). Se elimina el burst cada
        // 60s que hacia foreach ALL x 3 saves = 900 writes simultaneas.
        // SaveTimerCount ya no es necesario; se mantiene por si otras partes del
        // codigo lo referencian.
        SaveTimerCount++;
        if(SaveTimerCount >= 27) // 27 ticks * 2222ms = ~60 segundos
        {
                SaveTimerCount = 0;
                // Antes: foreach(new i : Player) { SalvarInventario/Evaluacion/VIP(i) }
                // Ahora: vacio - el guardado se hace rotatoriamente arriba.
        }
}

CallBack::StopAlarm(vehicleid)
{
        ToggleAlarm(vehicleid, VEHICLE_PARAMS_OFF);
}

CallBack::GetVehicleIDFromPlate(Plate[])
{
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] == VEHICLE_PLAYER && strcmp(VehicleNumberPlate[i], Plate) == 0)
                {
                        return i;
                }
        }
        return 0;
}

// FIX AUDIT AC-H1: AntiDeAMX() es un stub cosmetico sin proteccion real.
// Antes: se creia que esto protegia contra decompilacion, pero solo imprime
// un mensaje y declara un array unused. No tiene #emit ni ninguna tecnica
// anti-decompilacion real. La GM puede ser decompilada sin obstaculos.
// NO se elimina para no romper callers (OnGameModeInit lo llama), pero se
// documenta que NO aporta proteccion. Para proteccion real, considerar:
//   1. Plugin signature verification (sampcac)
//   2. Ofuscar strings sensibles (no hardcodear secrets)
//   3. Mover logica sensible a plugins nativos
AntiDeAMX()
{
        new antidamx[][] =
        {
                "Unarmed (Fist)",
                "Brass K",
                "Fire Ex"
        };
        printf("=> AntiAMX                      : Carregado (stub cosmetico - ver FIX AUDIT AC-H1)");
        #pragma unused antidamx
}

public OcultarBienvenida(playerid)
{
