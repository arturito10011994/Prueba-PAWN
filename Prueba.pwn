// FIX AUDIT AGENT4 AFK-10: strike counter AFK persistente. 3 strikes en 24h = ban 1h.
new g_AFKStrikes[MAX_PLAYERS];
new g_AFKLastKickTs[MAX_PLAYERS]; // timestamp del ultimo kick por AFK
// FIX AUDIT AFK H8: ban temporal automatico al llegar a 3 strikes AFK en 24h.
// Antes: el strike system SOLO logueaba en Logs/AfkReincidencia.log (no habia
// consecuencia real). Atacantes podian acumular strikes sin disuasion.
// Ahora: al llegar a 3 strikes, se setea AFKBanUntilTs = gettime() + 3600 (1h).
// Al reconectar, OnPlayerConnect verifica si AFKBanUntilTs > gettime() = ban activo.
#define AFK_BAN_DURATION_SEC  3600   // 1 hora
#define AFK_STRIKES_THRESHOLD 3      // 3 strikes = ban 1h
new g_AFKBanUntilTs[MAX_PLAYERS];   // 0 = no baneado; > gettime() = ban activo
// FIX AUDIT AFK H4: trackear timer ID de TestAway per-jugador.
// Antes: el ID retornado por SetTimerEx("TestAway", ...) se descartaba, asi que
// no habia forma de KillTimer en disconnect/death/spawn. Si un jugador se
// desconectaba mid-countdown, el timer seguia disparando sobre el slot reusado.
// Ahora: guardamos el ID en g_TestAwayTimer[playerid]. Si != 0, hay countdown
// activo y se puede KillTimer en cleanup.
new g_TestAwayTimer[MAX_PLAYERS];
// FIX AUDIT AFK H7: perodo de gracia post-spawn para AntiAway.
// Antes: AntiAway podia flaggear AFK a un jugador recien spawneado en 10s,
// antes de que terminara de cargar el mapa. Ahora: si gettime() - g_LastSpawnTs
// < AFK_GRACE_PERIOD_SEC, AntiAway skip el check para ese jugador.
#define AFK_GRACE_PERIOD_SEC 60
new g_LastSpawnTs[MAX_PLAYERS];
// FIX AUDIT AFK H9: auto-release de algemado tras 10 min.
// Previene bypass de AFK via collusion cop-jugador (cop amigo algema a jugador
// para eximirlo de AFK indefinidamente). AntiAway checkea si AlgemadoTs + 600
// < gettime() y libera automaticamente al jugador.
#define ALGEMADO_TIMEOUT_SEC 600
// FIX AUDIT AFK M6 (magic numbers): centralizar constantes del sistema AFK.
// Antes: 0.5, 10, 5, 3, 86400 estaban hardcoded en AntiAway, TestAway y otros.
// Ahora: #define con nombre descriptivo para mantenibilidad.
#define AFK_EPSILON_M         0.5     // tolerancia de movimiento (medio metro)
#define AFK_COUNTDOWN_SEC     10      // countdown visual antes del kick
#define AFK_INTERVAL_MIN      5       // intervalo del timer AntiAway (minutos)
#define AFK_STRIKES_WINDOW_H  24      // ventana movil para reset de strikes (horas)
#define AFK_STRIKES_WINDOW_SEC 86400  // 24 * 3600
// FIX AUDIT AFK B1: limite de tamano para rotacion de Logs/AfkReincidencia.log.
#define AFK_LOG_MAX_SIZE_BYTES 1048576  // 1 MB
// FIX AUDIT AFK H6: flag separado para /dormir y /descansar (no usar pCongelado).
// Antes (fix anterior): seteabamos pCongelado=true en /dormir/descansar para eximir
// de AntiAway. Pero OnPlayerSpawn L23861 checkea pCongelado para re-congelar al
// jugador (porque asume que es algemado). Si el jugador moria durante /dormir,
// respawneaba congelado. Ahora: usamos g_DormindoODescansando separado para que
// AntiAway lo exima sin afectar la logica de algemado/spawn.
new bool:g_DormindoODescansando[MAX_PLAYERS];
// FIX AUDIT AGENT4 AFK-12: AntiAFK_Ativado cambiado de flag global a per-jugador.
// Antes era un unico bool para todo el servidor - si un admin lo desactivaba, se
// desactivaba para TODOS. Ahora es per-jugador, inicializado en true en OnPlayerConnect.
new     bool:AntiAFK_Ativado[MAX_PLAYERS] = {true, ...},
        bool:Moved[MAX_PLAYERS] = false,
        // [DEAL-FASE2-3] FIX AUD2-009: DEAD CODE DOCUMENTADO (NO eliminar).
        // FoiCriado[] se declara e inicializa a false, pero NUNCA se setea
        // a true en ningun lugar del GM (verificado por busqueda exhaustiva
        // con grep `FoiCriado` Ã¢Â€Â” solo 2 hits: esta decl y el loop en
        // OnGameModeExit). El loop de cleanup en OnGameModeExit itera y hace
        // `if(FoiCriado[i] == true) DestroyVehicle(i);` Ã¢Â€Â” la condicion es
        // SIEMPRE FALSE, el DestroyVehicle nunca se ejecuta en ese loop.
        // SA-MP limpia automaticamente todos los vehiculos nativos al cerrar
        // el proceso, asi que no hay leak persistente. Es legacy tracking
        // (probablemente para mapear CreateVehicle->DestroyVehicle en
        // shutdown) que dejo de mantenerse. Se mantiene para no romper
        // otros posibles usos futuros o references; solo documentado aqui.
        bool:FoiCriado[MAX_VEHICLES] = false,
        bool:FirstLogin[MAX_PLAYERS] = true,
        bool:pJogando[MAX_PLAYERS] = true,
        bool:pLogado[MAX_PLAYERS] = false,
        bool:IsAssistindo[MAX_PLAYERS] = false,
        bool:ConteoIniciada = false,
        bool:ChatLigado = true;
