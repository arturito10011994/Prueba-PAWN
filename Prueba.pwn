public OnPlayerPickUpPickup(playerid, pickupid)
{
        // P0-CAMION-BLINDADO: recoger bolsa del camion al caminar sobre ella
        if(g_CamionEvento[ce_activo] && g_CamionEvento[ce_bolsasCaidas])
        {
                for(new i = 0; i < CAMION_BOLSAS_MAX; i++)
                {
                        if(g_CamionBolsas[i][cb_activa] && g_CamionBolsas[i][cb_enSuelo]
                           && g_CamionBolsas[i][cb_pickupID] == pickupid)
                        {
                                Camion_RecogerBolsa(playerid, i);
                                return 1;
                        }
                }
        }
        // P0-TERRITORIO: pickup de recursos del territorio
        for(new t = 0; t < MAX_TERRITORIOS; t++)
        {
                if(g_Terr[t][t_pickupID] == pickupid)
                {
                        // Verificar que el jugador sea de la banda dueÃ¯Â¿Â½a
                        new myOrg = PlayerInfo[playerid][Org];
                        if(myOrg != g_Terr[t][t_duenoOrg])
                        {
                                ErrorMsg(playerid, "Este territorio pertenece a otra banda. No puedes usar sus recursos.");
                                return 1;
                        }
                        // Verificar cooldown de 30 min
                        new nowTs = gettime();
                        if(g_TerrPickupLastUse[playerid][t] > 0 && (nowTs - g_TerrPickupLastUse[playerid][t]) < TERR_PICKUP_COOLDOWN)
                        {
                                new restante = TERR_PICKUP_COOLDOWN - (nowTs - g_TerrPickupLastUse[playerid][t]);
                                new mins = restante / 60;
                                new msg[100];
                                format(msg, sizeof(msg), "Debes esperar %d minutos para usar este recurso de nuevo.", mins);
                                return ErrorMsg(playerid, msg);
                        }
                        // Dar recursos: 2-5 piezas + $200-500
                        new piezas = randomEx(2, 5);
                        new dinero = randomEx(200, 500);
                        GanharItem(playerid, 19995, piezas);
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, dinero);
                        g_TerrPickupLastUse[playerid][t] = nowTs;
                        // RIESGO: 25% denuncia policial
                        new noti = randomEx(1, 100);
                        if(noti <= 25)
                        {
                                foreach(new p : Player)
                                {
                                        if(Patrulha[p] == true)
                                        {
                                                new msg[180];
                                                format(msg, sizeof(msg), "[TERRITORIO] Un ciudadano denuncia actividad sospechosa de banda en %s.", g_Terr[t][t_nombre]);
                                                WarningMsg(p, msg);
                                        }
                                }
                        }
                        new msgOk[160];
                        format(msgOk, sizeof(msgOk), "Recogiste %d Piezas de Fabricacion y $%d de tu territorio %s.", piezas, dinero, g_Terr[t][t_nombre]);
                        SuccesMsg(playerid, msgOk);
                        printf("[P0-TERRITORIO] Jugador %d recogio %d piezas + $%d en territorio %d", playerid, piezas, dinero, t);
                        return 1;
                }
        }

        // =====================================================================
        // CLINICA SOTORP - HANDLERS DESHABILITADOS (entrada/salida/uniforme)
        // =====================================================================
        // if(pickupid == PickEntradaClinicaSotoRP) { ... }
        // if(pickupid == PickSalidaClinicaSotoRP) { ... }
        // if(pickupid == PickUniformeMEDICO[0]) { ... }
        // =====================================================================
        if(!RoubandoCaja[playerid])
        {
                for(new i; i < MAX_CajaS; i++)
                {
                        if(!CajaInfo[i][Caja_Roubada])continue;
                        for(new p; p < MAX_PICKUPS_ROUBO; p++)
                        {
                                if(pickupid == Pickups_Roubo[i][p])
                                {
                                        new keys, ud, lr;
                                        GetPlayerKeys(playerid, keys, ud, lr);
                                                GranaRoubo(playerid, i);
                                                DestroyPickup(pickupid);
                                                Pickups_Roubo[i][p] = -1;
                                }
                        }
                }
        }
        return 1;
}

