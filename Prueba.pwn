// =====================================================================
// P0-TERRITORIO: HELPERS DEL SISTEMA DE TERRITORIOS
// =====================================================================

// Inicializa los 8 territorios con coordenadas fijas del mapa de Los Santos.
stock Terr_InitZonas()
{
    // Zona 0: Ganton
    g_Terr[0][t_activa] = true;
    strcpy(g_Terr[0][t_nombre], "Ganton", 32);
    g_Terr[0][t_minX] = 2220.0; g_Terr[0][t_minY] = -1850.0;
    g_Terr[0][t_maxX] = 2520.0; g_Terr[0][t_maxY] = -1600.0;
    g_Terr[0][t_pickupX] = 2370.0; g_Terr[0][t_pickupY] = -1725.0; g_Terr[0][t_pickupZ] = 13.5;

    // Zona 1: Groove Street
    g_Terr[1][t_activa] = true;
    strcpy(g_Terr[1][t_nombre], "Groove Street", 32);
    g_Terr[1][t_minX] = 2400.0; g_Terr[1][t_minY] = -1800.0;
    g_Terr[1][t_maxX] = 2650.0; g_Terr[1][t_maxY] = -1650.0;
    g_Terr[1][t_pickupX] = 2495.0; g_Terr[1][t_pickupY] = -1700.0; g_Terr[1][t_pickupZ] = 13.6;

    // Zona 2: Idlewood
    g_Terr[2][t_activa] = true;
    strcpy(g_Terr[2][t_nombre], "Idlewood", 32);
    g_Terr[2][t_minX] = 1800.0; g_Terr[2][t_minY] = -2000.0;
    g_Terr[2][t_maxX] = 2150.0; g_Terr[2][t_maxY] = -1750.0;
    g_Terr[2][t_pickupX] = 2000.0; g_Terr[2][t_pickupY] = -1900.0; g_Terr[2][t_pickupZ] = 13.5;

    // Zona 3: Jefferson
    g_Terr[3][t_activa] = true;
    strcpy(g_Terr[3][t_nombre], "Jefferson", 32);
    g_Terr[3][t_minX] = 2100.0; g_Terr[3][t_minY] = -1500.0;
    g_Terr[3][t_maxX] = 2350.0; g_Terr[3][t_maxY] = -1300.0;
    g_Terr[3][t_pickupX] = 2225.0; g_Terr[3][t_pickupY] = -1400.0; g_Terr[3][t_pickupZ] = 23.5;

    // Zona 4: Willowfield
    g_Terr[4][t_activa] = true;
    strcpy(g_Terr[4][t_nombre], "Willowfield", 32);
    g_Terr[4][t_minX] = 2000.0; g_Terr[4][t_minY] = -2100.0;
    g_Terr[4][t_maxX] = 2300.0; g_Terr[4][t_maxY] = -1950.0;
    g_Terr[4][t_pickupX] = 2150.0; g_Terr[4][t_pickupY] = -2025.0; g_Terr[4][t_pickupZ] = 13.5;

    // Zona 5: East Beach
    g_Terr[5][t_activa] = true;
    strcpy(g_Terr[5][t_nombre], "East Beach", 32);
    g_Terr[5][t_minX] = 2600.0; g_Terr[5][t_minY] = -1450.0;
    g_Terr[5][t_maxX] = 2900.0; g_Terr[5][t_maxY] = -1200.0;
    g_Terr[5][t_pickupX] = 2750.0; g_Terr[5][t_pickupY] = -1325.0; g_Terr[5][t_pickupZ] = 10.5;

    // Zona 6: El Corona
    g_Terr[6][t_activa] = true;
    strcpy(g_Terr[6][t_nombre], "El Corona", 32);
    g_Terr[6][t_minX] = 1700.0; g_Terr[6][t_minY] = -1950.0;
    g_Terr[6][t_maxX] = 1850.0; g_Terr[6][t_maxY] = -1800.0;
    g_Terr[6][t_pickupX] = 1775.0; g_Terr[6][t_pickupY] = -1875.0; g_Terr[6][t_pickupZ] = 13.5;

    // Zona 7: Verdant Bluffs
    g_Terr[7][t_activa] = true;
    strcpy(g_Terr[7][t_nombre], "Verdant Bluffs", 32);
    g_Terr[7][t_minX] = 1200.0; g_Terr[7][t_minY] = -1100.0;
    g_Terr[7][t_maxX] = 1450.0; g_Terr[7][t_maxY] = -900.0;
    g_Terr[7][t_pickupX] = 1325.0; g_Terr[7][t_pickupY] = -1000.0; g_Terr[7][t_pickupZ] = 25.5;

    // Inicializar resto de campos
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        g_Terr[i][t_duenoOrg] = 0; // neutral
        g_Terr[i][t_gangZone] = -1;
        g_Terr[i][t_pickupID] = -1;
        g_Terr[i][t_conquistaEnCurso] = false;
        g_Terr[i][t_conquistaOrg] = 0;
        g_Terr[i][t_conquistaTimer] = -1;
        g_Terr[i][t_conquistaSegundos] = 0;
        g_Terr[i][t_guerraEnCurso] = false;
        g_Terr[i][t_guerraAtacante] = 0;
        g_Terr[i][t_guerraDefensor] = 0;
        g_Terr[i][t_guerraTimer] = -1;
        g_Terr[i][t_guerraSegundos] = 0;
        g_Terr[i][t_bajasAtacante] = 0;
        g_Terr[i][t_bajasDefensor] = 0;
        g_Terr[i][t_capturasPolicia] = 0;
        g_Terr[i][t_decomisoTimer] = -1;
        g_Terr[i][t_cooldownReto] = 0;
    }
}

// Carga los duenos de territorios desde Territorios.ini
stock Terr_Cargar()
{
    Terr_InitZonas();
    if(!fexist(TERR_FILE)) return 1;
    new key[32], val;
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        format(key, sizeof(key), "Terr%d_Dueno", i);
        val = DOF2_GetInt(TERR_FILE, key);
        g_Terr[i][t_duenoOrg] = val;
        // FIX AUDIT 5P: cargar cooldownReto y capturasPolicia persistidos
        format(key, sizeof(key), "Terr%d_CooldownReto", i);
        g_Terr[i][t_cooldownReto] = DOF2_GetInt(TERR_FILE, key);
        format(key, sizeof(key), "Terr%d_CapturasPol", i);
        g_Terr[i][t_capturasPolicia] = DOF2_GetInt(TERR_FILE, key);
    }
    printf("[P0-TERRITORIO] Cargados %d territorios desde %s", MAX_TERRITORIOS, TERR_FILE);
    return 1;
}

// Guarda los duenos de territorios en Territorios.ini
stock Terr_Guardar()
{
    new key[32];
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        format(key, sizeof(key), "Terr%d_Dueno", i);
        DOF2_SetInt(TERR_FILE, key, g_Terr[i][t_duenoOrg]);
        // FIX AUDIT 5P: persistir cooldownReto para sobrevivir reboots
        format(key, sizeof(key), "Terr%d_CooldownReto", i);
        DOF2_SetInt(TERR_FILE, key, g_Terr[i][t_cooldownReto]);
        // Persistir capturasPolicia para no resetear contador tras reboot
        format(key, sizeof(key), "Terr%d_CapturasPol", i);
        DOF2_SetInt(TERR_FILE, key, g_Terr[i][t_capturasPolicia]);
    }
    DOF2_SaveFile();
    return 1;
}

// Crea las GangZones y pickups al iniciar el servidor
stock Terr_CrearGangZones()
{
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        if(!g_Terr[i][t_activa]) continue;
        // Crear GangZone (rectangulo)
        g_Terr[i][t_gangZone] = GangZoneCreate(g_Terr[i][t_minX], g_Terr[i][t_minY],
                                                g_Terr[i][t_maxX], g_Terr[i][t_maxY]);
        // Crear pickup de recursos (solo si tiene dueno)
        if(g_Terr[i][t_duenoOrg] > 0)
        {
            g_Terr[i][t_pickupID] = CreateDynamicPickup(1314, 23, g_Terr[i][t_pickupX],
                                                         g_Terr[i][t_pickupY], g_Terr[i][t_pickupZ]);
        }
        printf("[P0-TERRITORIO] Zona %d '%s' creada - dueno: org %d", i, g_Terr[i][t_nombre], g_Terr[i][t_duenoOrg]);
    }
}

// Muestra las GangZones a un jugador (al conectar)
stock Terr_MostrarAJugador(playerid)
{
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        if(!g_Terr[i][t_activa]) continue;
        if(g_Terr[i][t_gangZone] >= 0 && g_Terr[i][t_duenoOrg] > 0)
        {
            GangZoneShowForPlayer(playerid, g_Terr[i][t_gangZone], g_TerrColores[g_Terr[i][t_duenoOrg]]);
        }
    }
}

// Actualiza el color de una GangZone para todos los jugadores
stock Terr_ActualizarColorZona(zonaID)
{
    if(zonaID < 0 || zonaID >= MAX_TERRITORIOS) return 0;
    if(g_Terr[zonaID][t_gangZone] < 0) return 0;
    if(g_Terr[zonaID][t_duenoOrg] > 0)
    {
        GangZoneShowForAll(g_Terr[zonaID][t_gangZone], g_TerrColores[g_Terr[zonaID][t_duenoOrg]]);
        // Crear pickup si no existe
        if(g_Terr[zonaID][t_pickupID] == -1)
        {
            g_Terr[zonaID][t_pickupID] = CreateDynamicPickup(1314, 23, g_Terr[zonaID][t_pickupX],
                                                             g_Terr[zonaID][t_pickupY], g_Terr[zonaID][t_pickupZ]);
        }
    }
    else
    {
        // Neutral: ocultar zona y destruir pickup
        GangZoneHideForAll(g_Terr[zonaID][t_gangZone]);
        if(g_Terr[zonaID][t_pickupID] != -1)
        {
            // FIX AUDIT 5P: era DestroyDynamicObject (no destruye pickups streamer)
            DestroyDynamicPickup(g_Terr[zonaID][t_pickupID]);
            g_Terr[zonaID][t_pickupID] = -1;
        }
    }
    return 1;
}

// Verifica si un jugador esta dentro de un territorio
stock Terr_EstaEnZona(playerid, zonaID)
{
    if(zonaID < 0 || zonaID >= MAX_TERRITORIOS) return false;
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    if(px >= g_Terr[zonaID][t_minX] && px <= g_Terr[zonaID][t_maxX]
       && py >= g_Terr[zonaID][t_minY] && py <= g_Terr[zonaID][t_maxY])
        return true;
    return false;
}

// Verifica si un jugador esta en CUALQUIER territorio (devuelve el ID o -1)
stock Terr_ZonaDelJugador(playerid)
{
    for(new i = 0; i < MAX_TERRITORIOS; i++)
    {
        if(Terr_EstaEnZona(playerid, i)) return i;
    }
    return -1;
}

// Cuenta cuantos miembros de una org estan en una zona
stock Terr_ContarMiembrosEnZona(orgid, zonaID)
{
    new count = 0;
    foreach(new p : Player)
    {
        if(pLogado[p] && PlayerInfo[p][Org] == orgid && Terr_EstaEnZona(p, zonaID))
            count++;
    }
    return count;
}

// Verifica si el jugador tiene permiso para conquistar
// Jerarquia: lider (rango 3) > sublider (rango 2) > miembro (rango 1)
// Si hay lider conectado, solo el lider. Si no, el sublider de mayor rango. Etc.
stock Terr_TienePermisoConquista(playerid)
{
    new myOrg = PlayerInfo[playerid][Org];
    new myCargo = PlayerInfo[playerid][Cargo];
    // Recorrer todos los rangos desde el mas alto hasta el del jugador
    for(new rangoCheck = 3; rangoCheck >= 1; rangoCheck--)
    {
        // Verificar si hay alguien conectado de esta org con rango >= rangoCheck
        foreach(new p : Player)
        {
            if(pLogado[p] && PlayerInfo[p][Org] == myOrg && PlayerInfo[p][Cargo] >= rangoCheck)
            {
                // Hay alguien de rango >= rangoCheck conectado
                if(myCargo >= rangoCheck) return true; // el jugador tiene ese rango o mas
                return false; // alguien de mayor rango esta conectado, el jugador no puede
            }
        }
    }
    return false;
}

// P0-TERR-FASE2: Mejora 1 - Territorios conectados (+50% ingreso)
// Tabla de adyacencia: que territorios son vecinos.
// 0=Ganton, 1=Groove, 2=Idlewood, 3=Jefferson, 4=Willowfield,
// 5=East Beach, 6=El Corona, 7=Verdant Bluffs
stock Terr_SonAdyacentes(t1, t2)
{
        // Definir pares de territorios adyacentes
        if(t1 == 0 && t2 == 1) return true; // Ganton-Groove
        if(t1 == 1 && t2 == 0) return true;
        if(t1 == 0 && t2 == 2) return true; // Ganton-Idlewood
        if(t1 == 2 && t2 == 0) return true;
        if(t1 == 1 && t2 == 5) return true; // Groove-East Beach
        if(t1 == 5 && t2 == 1) return true;
        if(t1 == 2 && t2 == 3) return true; // Idlewood-Jefferson
        if(t1 == 3 && t2 == 2) return true;
        if(t1 == 2 && t2 == 4) return true; // Idlewood-Willowfield
        if(t1 == 4 && t2 == 2) return true;
        if(t1 == 2 && t2 == 6) return true; // Idlewood-El Corona
        if(t1 == 6 && t2 == 2) return true;
        if(t1 == 4 && t2 == 6) return true; // Willowfield-El Corona
        if(t1 == 6 && t2 == 4) return true;
        if(t1 == 3 && t2 == 7) return true; // Jefferson-Verdant Bluffs
        if(t1 == 7 && t2 == 3) return true;
        if(t1 == 0 && t2 == 5) return true; // Ganton-East Beach
        if(t1 == 5 && t2 == 0) return true;
        return false;
}

// Cuenta cuantos territorios de una org son adyacentes a un territorio dado
stock Terr_ContarConectados(orgid, zonaID)
{
        new count = 0;
        for(new i = 0; i < MAX_TERRITORIOS; i++)
        {
                if(i == zonaID) continue;
                if(g_Terr[i][t_duenoOrg] == orgid && Terr_SonAdyacentes(zonaID, i))
                        count++;
        }
        return count;
}

// Helper: spawn un vehiculo de la banda del jugador segun el listitem del menu.
// listitem NO es el slot directo, es la posicion en el menu (que omite slots vacios).
// Hay que mapear listitem -> slot real recorriendo los slots ocupados.
stock SpawnVehOrg(playerid, listitem)
{
        new org = GetPVarInt(playerid, "OvehiculoOrg");
        new idx = GetPVarInt(playerid, "OvehiculoIdx");
        DeletePVar(playerid, "OvehiculoOrg");
        DeletePVar(playerid, "OvehiculoIdx");
        if(idx < 0 || idx >= 6)
                return ErrorMsg(playerid, "Error: organizacion no valida.");

        // CRIT-5 (BANDAVEH-AUD1-005): validar membresÃƒÂ­a actual de la org.
        // Sin esto, un cliente modificado (dialog spoofing) o un jugador que fue
        // movido/expulsado mid-dialog podria spawnear un vehiculo de una banda
        // a la que ya no pertenece (robo de vehiculo de faccion ajena).
        if(!IsBandido(playerid))
                return ErrorMsg(playerid, "Ya no eres miembro de una banda.");
        if(OrgGangIndex(PlayerInfo[playerid][Org]) != idx)
                return ErrorMsg(playerid, "Ya no eres miembro de esa banda.");

        // Mapear listitem -> slot real (saltando slots vacios)
        new slotReal = -1, count = 0;
        for(new s = 0; s < MAX_VEH_ORG; s++)
        {
                if(g_VehOrgModelo[idx][s] > 0)
                {
                        if(count == listitem)
                        {
                                slotReal = s;
                                break;
                        }
                        count++;
                }
        }
        if(slotReal == -1)
                return ErrorMsg(playerid, "Seleccion invalida.");

        // MEJORA 3 (BANDAVEH): validar que el slot no este ya materializado.
        // Si g_VehOrgSlotLocked es true, otro jugador tiene ese slot spawned
        // en el mundo. Spawnearlo de nuevo dejaria una instancia orphan sin
        // trackear en VeiculoCivil (el segundo jugador sobreescribiria
        // VeiculoCivil[playerid] y el primero quedaria sin dueno). El otro
        // jugador debe hacer /dvehiculo primero para liberar el slot.
        if(g_VehOrgSlotLocked[idx][slotReal])
                return ErrorMsg(playerid, "Ese vehiculo ya esta desplegado por otro miembro. Pidele que lo devuelva con /dvehiculo.");

        new modelo = g_VehOrgModelo[idx][slotReal];
        new color1 = g_VehOrgColor1[idx][slotReal];
        new color2 = g_VehOrgColor2[idx][slotReal];

        // AUD2-012 (BANDAVEH-ALTO): no destruir van/truck de trabajo al spawnear.
        // ANTES: si el jugador tenia una van de Correos / truck de Camionero /
        // Empaquetador / Bobcat de Constructor activo y ejecutaba /ovehiculo,
        // SpawnVehOrg destruia ese vehiculo de trabajo sin validar. El jugador
        // perdia la ruta + el estado del trabajo (Cargase, EmServico, etc.)
        // quedaba stale hasta /salirtrabajo o reconnect.
        // AHORA: si VeiculoCivil existe y NO es vehiculo de banda (vf_orgSlot==0),
        // rehusar el spawn y pedirle al jugador que haga /dvehiculo primero.
        if(VehAlugado[playerid] == 1 && IsValidVehicle(VeiculoCivil[playerid]))
        {
                new _vehAnt = VeiculoCivil[playerid];
                new bool:_esDeBanda = false;
                if(_vehAnt >= 1 && _vehAnt < MAX_VEHICLES
                   && g_VehFuel[_vehAnt][vf_initialized]
                   && g_VehFuel[_vehAnt][vf_orgSlot] > 0)
                        _esDeBanda = true;
                if(!_esDeBanda)
                {
                        return ErrorMsg(playerid, "Tienes un vehiculo de trabajo o personal activo. Usa /dvehiculo para devolverlo primero.");
                }
                // Era de banda: destruirlo y guardar fuel (comportamiento original).
                // FUEL-ARCHITECTURE: guardar combustible antes de destruir.
                // Capturar oidx/oslot ANTES de Fuel_DestroyVehicle porque esta ultima
                // resetea vf_orgSlot=0 y vf_orgIdx=0 (necesario para liberar el lock
                // del slot anterior del jugador).
                new _oldOidx = -1, _oldOslot = 0;
                if(_vehAnt >= 1 && _vehAnt < MAX_VEHICLES
                   && g_VehFuel[_vehAnt][vf_initialized])
                {
                        _oldOidx = g_VehFuel[_vehAnt][vf_orgIdx];
                        _oldOslot = g_VehFuel[_vehAnt][vf_orgSlot];
                        Fuel_SavePersistent(_vehAnt);
                        Fuel_DestroyVehicle(_vehAnt);
                }
                if(_oldOslot > 0 && _oldOidx >= 0 && _oldOidx < 6)
                        g_VehOrgSlotLocked[_oldOidx][_oldOslot] = false;
                DestroyVehicle(_vehAnt);
        }

        // Spawn del nuevo vehiculo en la posicion del jugador
        new Float:X, Float:Y, Float:Z, Float:ROT;
        GetPlayerPos(playerid, X, Y, Z);
        GetPlayerFacingAngle(playerid, ROT);
        VehAlugado[playerid] = 1;
        VeiculoCivil[playerid] = CreateVehicle(modelo, X, Y, Z, ROT, color1, color2, false);
        // AUD4-002 (BANDAVEH-ALTO): validar retorno de CreateVehicle.
        // CreateVehicle retorna INVALID_VEHICLE_ID (0xFFFF) si falla (limite de
        // MAX_VEHICLES alcanzado, modelo invalido, etc.). Sin este check, las
        // llamadas posteriores (PutPlayerInVehicle, Fuel_InitVehicle) operarian
        // sobre un vehicleid invalido, causando comportamiento indefinido.
        if(VeiculoCivil[playerid] == INVALID_VEHICLE_ID)
        {
                VehAlugado[playerid] = 0;
                VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
                return ErrorMsg(playerid, "No se pudo crear el vehiculo (limite de vehiculos del servidor alcanzado). Intentalo mas tarde.");
        }
        PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);

        // FUEL-ARCHITECTURE: inicializar combustible del vehiculo de org.
        // Carga desde g_VehOrgFuelPersist[idx][slotReal] si existe, sino tanque lleno.
        Fuel_InitVehicle(VeiculoCivil[playerid], modelo, 0, slotReal, idx);

        // MEJORA 3 (BANDAVEH): marcar slot como locked para evitar doble spawn.
        // Se libera en cmd_dvehiculo / OnVehicleDeath / OnPlayerDeath (via
        // cmd_dvehiculo) / CargarVehOrg (server restart).
        g_VehOrgSlotLocked[idx][slotReal] = true;

        new nombreVeh[32], msg[128];
        GetVehicleNombre(modelo, nombreVeh, sizeof(nombreVeh));
        format(msg, sizeof(msg), "%s desplegado. Usa /dvehiculo para devolverlo.", nombreVeh);
        InfoMsg(playerid, msg);
        printf("[P0-BANDA-VEH] Jugador %d (org %d) solicito %s (slot %d, modelo %d)",
                playerid, org, nombreVeh, slotReal, modelo);
        return 1;
}

// Comando: /comprarvehorg - lider compra vehiculo para su banda.
// Debe estar en cualquier concesionario existente.
CMD:comprarvehorg(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        if(!IsBandido(playerid)) return ErrorMsg(playerid, "Solo las bandas ilegales pueden comprar vehiculos de faccion.");
        if(!IsOrgLeader(playerid)) return ErrorMsg(playerid, "Solo el lider puede comprar vehiculos para la banda."); // FIX AUDIT: privilege escalation
        if(!IsPlayerEnConcesionario(playerid)) return ErrorMsg(playerid, "Debes estar en un concesionario para comprar un vehiculo.");

        // Verificar que haya slot libre
        new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
        if(idx == -1) return ErrorMsg(playerid, "Error: org no reconocida.");
        new slotLibre = -1;
        for(new s = 1; s < MAX_VEH_ORG; s++)
        {
                if(g_VehOrgModelo[idx][s] == 0)
                {
                        slotLibre = s;
                        break;
                }
        }
        if(slotLibre == -1)
        {
                new msg[100];
                format(msg, sizeof(msg), "Tu banda ya tiene el maximo de %d vehiculos. Usa /vendervehorg para liberar espacio.", MAX_VEH_ORG - 1);
                return ErrorMsg(playerid, msg);
        }

        // Mostrar menu de modelos disponibles
        new menuStr[1024];
        ConstruirMenuComprarVehOrg(menuStr, sizeof(menuStr));
        SetPVarInt(playerid, "ComprarVehOrgSlot", slotLibre);
        SetPVarInt(playerid, "ComprarVehOrgIdx", idx); // CRIT-7 (BANDAVEH-AUD4-001): cachea idx de la org al abrir dialog
        ShowPlayerDialog(playerid, DIALOG_COMPRARVEHORG, DIALOG_STYLE_LIST, "Comprar vehiculo para la banda", menuStr, "Comprar", "X");
        return 1;
}

// Comando: /auditvehorg - admin 6+ escanea los .ini de vehiculos de banda y reporta
// slots invalidos (modelo fuera de rango, precio inconsistente, fuel corrupto).
CMD:auditvehorg(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "Sem permissao");

        new orgsToCheck[6] = {5, 6, 7, 8, 12, 13};
        new totalSlots = 0, totalIssues = 0;
        new report[2048];

        for(new oi = 0; oi < 6; oi++)
        {
                new orgid = orgsToCheck[oi];
                new idx = OrgGangIndex(orgid);
                if(idx == -1) continue;

                new filename[64];
                format(filename, sizeof(filename), "%s%d.ini", VEHORG_FILE_PATH, orgid);
                if(!fexist(filename))
                {
                        new line[128];
                        format(line, sizeof(line), "{FF0000}[Org %d] %s NO EXISTE\n", orgid, filename);
                        strcat(report, line, sizeof(report));
                        totalIssues++;
                        continue;
                }

                // Escanear slots en memoria
                for(new slot = 0; slot < MAX_VEH_ORG; slot++)
                {
                        if(g_VehOrgModelo[idx][slot] == 0) continue; // slot vacio
                        totalSlots++;
                        new issues = 0;
                        new issueStr[256];
                        format(issueStr, sizeof(issueStr), "{FFFF00}[Org %d Slot %d] Modelo %d", orgid, slot, g_VehOrgModelo[idx][slot]);

                        // Validar modelo
                        if(g_VehOrgModelo[idx][slot] < 400 || g_VehOrgModelo[idx][slot] > 611)
                        {
                                strcat(issueStr, " {FF0000}MODELO INVALIDO", sizeof(issueStr));
                                issues++;
                        }
                        // Validar colores
                        if(g_VehOrgColor1[idx][slot] < 0 || g_VehOrgColor1[idx][slot] > 255)
                        {
                                strcat(issueStr, " {FF0000}COLOR1 INVALIDO", sizeof(issueStr));
                                issues++;
                        }
                        if(g_VehOrgColor2[idx][slot] < 0 || g_VehOrgColor2[idx][slot] > 255)
                        {
                                strcat(issueStr, " {FF0000}COLOR2 INVALIDO", sizeof(issueStr));
                                issues++;
                        }
                        // Validar precio
                        if(g_VehOrgPrecio[idx][slot] < 0 || g_VehOrgPrecio[idx][slot] > 10000000)
                        {
                                strcat(issueStr, " {FF0000}PRECIO INVALIDO", sizeof(issueStr));
                                issues++;
                        }
                        // Validar fuel
                        new Float:cap = GetFuelCapacityByCategory(GetVehicleFuelCategory(g_VehOrgModelo[idx][slot]));
                        if(g_VehOrgFuelPersist[idx][slot] < -1.0 || g_VehOrgFuelPersist[idx][slot] > cap)
                        {
                                strcat(issueStr, " {FF0000}FUEL INVALIDO", sizeof(issueStr));
                                issues++;
                        }
                        // Validar lock
                        if(g_VehOrgSlotLocked[idx][slot])
                        {
                                strcat(issueStr, " {FF8C00}LOCKED (posible leak)", sizeof(issueStr));
                                issues++;
                        }

                        if(issues > 0)
                        {
                                strcat(issueStr, "\n", sizeof(issueStr));
                                strcat(report, issueStr, sizeof(report));
                                totalIssues += issues;
                        }
                }
        }

        new header[256];
        if(totalSlots == 0)
        {
                format(header, sizeof(header), "{FFFFFF}Auditoria de Vehiculos de Banda\n\n{FF8C00}No hay vehiculos de banda registrados.");
                ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Auditoria VehOrg", header, "Cerrar", "");
                return 1;
        }

        format(header, sizeof(header), "{FFFFFF}Auditoria de Vehiculos de Banda\n\n{FFFFFF}Slots ocupados: {00FF00}%d\n{FFFFFF}Problemas encontrados: %s%d\n\n", totalSlots, totalIssues > 0 ? "{FF0000}" : "{00FF00}", totalIssues);

        if(totalIssues == 0)
                strcat(report, "{00FF00}Todo correcto. No se encontraron problemas.", sizeof(report));

        new fullReport[2300];
        format(fullReport, sizeof(fullReport), "%s%s", header, report);
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Auditoria VehOrg", fullReport, "Cerrar", "");

        new logmsg[128];
        format(logmsg, sizeof(logmsg), "[AUDITVEHORG] %s (IDF %d, admin %d) ejecuto auditoria: %d slots, %d problemas",
                PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerInfo[playerid][pAdmin], totalSlots, totalIssues);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// Comando: /vendervehorg [slot] - lider vende un vehiculo de la banda (recupera 50%).
CMD:vendervehorg(playerid, params[])
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        if(!IsBandido(playerid)) return ErrorMsg(playerid, "Solo las bandas ilegales pueden vender vehiculos de faccion.");
        if(!IsOrgLeader(playerid)) return ErrorMsg(playerid, "Solo el lider puede vender vehiculos de la banda."); // FIX AUDIT: privilege escalation

        new slot;
        if(sscanf(params, "i", slot)) return ErrorMsg(playerid, "Uso: /vendervehorg [slot 1-9]. Usa /listarvehorg para ver los slots.");
        if(slot < 1 || slot >= MAX_VEH_ORG) return ErrorMsg(playerid, "Slot invalido. Debe ser entre 1 y 9 (el slot 0 es el vehiculo inicial y no se puede vender).");

        new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
        if(g_VehOrgModelo[idx][slot] == 0) return ErrorMsg(playerid, "Ese slot esta vacio.");

        // Reembolsar 50% del precio pagado
        new reembolso = g_VehOrgPrecio[idx][slot] / 2;
        // Capturar modelo ANTES de limpiar el slot (para el log de transaccion).
        new modeloVendido = g_VehOrgModelo[idx][slot];
        new msg[160], nombreVeh[32];
        GetVehicleNombre(modeloVendido, nombreVeh, sizeof(nombreVeh));

        // FIX AUDIT2 AGENT2 M-04: REORDENAR. Limpiar slot + GuardarVehOrg PRIMERO
        // para persistir la liberacion del slot. Antes AC_AddPlayerMoney +
        // SalvarDados se ejecutaban ANTES de GuardarVehOrg; si crash entre ambos,
        // el jugador tenia +money Y el vehiculo org en disco seguia a su nombre
        // (DUPE: cobro reembolso sin perder el vehiculo org). Ahora persistir
        // slot liberado primero; si crash entre GuardarVehOrg y AC_AddPlayerMoney,
        // el jugador pierde el vehiculo org sin cobrar (loss asimetrico, no dupe).

        // CRIT-6 (BANDAVEH-AUD1-006): destruir instancia spawned del slot vendido.
        // Sin esto, si el lider (u otro miembro que tenga cedido el vehiculo)
        // tiene el vehiculo del slot vendido actualmente spawned en el mundo,
        // /vendervehorg libera el slot en disco PERO no destruye la instancia
        // fisica (vehicle leak + duplicacion al reutilizar el slot).
        if(VehAlugado[playerid] == 1
           && VeiculoCivil[playerid] >= 1 && VeiculoCivil[playerid] < MAX_VEHICLES
           && g_VehFuel[VeiculoCivil[playerid]][vf_initialized]
           && g_VehFuel[VeiculoCivil[playerid]][vf_orgSlot] == slot
           && g_VehFuel[VeiculoCivil[playerid]][vf_orgIdx] == idx)
        {
                // Capturar oidx/oslot ANTES de Fuel_DestroyVehicle porque esta
                // ultima resetea vf_orgSlot=0 y vf_orgIdx=0 (necesario para
                // liberar el lock del slot que se esta vendiendo).
                new _venderOidx = g_VehFuel[VeiculoCivil[playerid]][vf_orgIdx];
                new _venderOslot = g_VehFuel[VeiculoCivil[playerid]][vf_orgSlot];
                Fuel_SavePersistent(VeiculoCivil[playerid]);
                Fuel_DestroyVehicle(VeiculoCivil[playerid]);
                DestroyVehicle(VeiculoCivil[playerid]);
                VehAlugado[playerid] = 0;
                VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
                // MEJORA 3 (BANDAVEH): liberar lock del slot vendido. Sin esto,
                // el slot quedaria locked para siempre (nadie podria spawnearlo
                // hasta reinicio), pero el slot ya esta vacio asi que el lock
                // no sirve de nada. Limpiar explicitamente.
                if(_venderOslot > 0 && _venderOidx >= 0 && _venderOidx < 6)
                        g_VehOrgSlotLocked[_venderOidx][_venderOslot] = false;
        }

        // Limpiar slot y guardar
        g_VehOrgModelo[idx][slot] = 0;
        g_VehOrgColor1[idx][slot] = 0;
        g_VehOrgColor2[idx][slot] = 0;
        g_VehOrgPrecio[idx][slot] = 0;
        g_VehOrgFuelPersist[idx][slot] = 0.0; // FUEL-ARCHITECTURE: limpiar fuel del slot vendido
        // AUD4-006 (BANDAVEH-ALTO): verificar retorno de GuardarVehOrg. Si falla,
        // el slot en memoria quedaria libre pero el .ini seguiria mostrandolo
        // ocupado; al reiniciar, el slot reapareceria con el vehiculo vendido
        // (perdida de reembolso para el jugador). Loguear para investigar.
        if(!GuardarVehOrg(PlayerInfo[playerid][Org]))
        {
                printf("[BANDAVEH-AUD4-006] ERROR: GuardarVehOrg fallo al vender vehiculo. Jugador %d, org %d, slot %d. El slot quedo libre en memoria pero NO persistido.",
                        playerid, PlayerInfo[playerid][Org], slot);
        }
        // MEJORA 6 (BANDAVEH): log de transaccion de venta.
        // Registra jugador, org, slot, modelo y reembolso para auditoria
        // economica (reembolsos inesperados, investigacion de dupe).
        new _logVentaV[256];
        format(_logVentaV, sizeof(_logVentaV),
                "VENTA jugador=%s (ID %d) org=%d slot=%d modelo=%d reembolso=%d",
                PlayerName(playerid), playerid, PlayerInfo[playerid][Org], slot,
                modeloVendido, reembolso);
        Log("Logs/BandaVeh.log", _logVentaV);

        // FIX AUDIT AGENT5 XS-17: antes escribia pDinheiro += reembolso sin sync
        // cliente ni SalvarDados. Resultado: (1) display del cliente se retrasaba 1s;
        // (2) si server crashea antes del SaveTimer, el reembolso se pierde.
        AC_AddPlayerMoney(playerid, reembolso);
        SalvarDados(playerid);

        format(msg, sizeof(msg), "Vendiste el %s (slot %d) de tu banda. Recibiste $%d (50%% del precio original).", nombreVeh, slot, reembolso);
        SuccesMsg(playerid, msg);

        return 1;
}

// Comando: /listarvehorg - muestra todos los vehiculos de la banda.
CMD:listarvehorg(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        if(!IsBandido(playerid)) return ErrorMsg(playerid, "Solo las bandas ilegales tienen vehiculos de faccion.");

        new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
        new str[800], line[100], nombreVeh[32];
        format(str, sizeof(str), "{FFFF00}Vehiculos de %s:\n\n", GangOrgNombre[idx]);
        for(new s = 0; s < MAX_VEH_ORG; s++)
        {
                if(g_VehOrgModelo[idx][s] > 0)
                {
                        GetVehicleNombre(g_VehOrgModelo[idx][s], nombreVeh, sizeof(nombreVeh));
                        new estado[24];
                        if(s == 0) estado = "{00FF00}(Inicial)";
                        else estado = "{FFFF00}(Comprado)";
                        format(line, sizeof(line), "{FFFFFF}Slot %d: %s (ID %d) %s\n", s, nombreVeh, g_VehOrgModelo[idx][s], estado);
                        strcat(str, line);
                }
        }
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Vehiculos de la banda", str, "Cerrar", "");
        return 1;
}

// =====================================================
// RENOMBRAR ORGANIZACION (solo Lider, cuesta $30.000)
// =====================================================
CMD:renombrarorg(playerid)
{
        if(!IsBandido(playerid)) return ErrorMsg(playerid, "No perteneces a ninguna banda.");
        if(!IsOrgLeader(playerid)) return ErrorMsg(playerid, "Solo el lider puede renombrar la organizacion."); // FIX AUDIT: privilege escalation
        if(PlayerInfo[playerid][pDinheiro] < 30000) return ErrorMsg(playerid, "Necesitas $30,000 para renombrar tu organizacion.");
        new str[128];
        format(str, sizeof(str), "Renombrar organizacion (cuesta $30,000). Nombre actual: %s", GangOrgNombre[OrgGangIndex(PlayerInfo[playerid][Org])]);
        ShowPlayerDialog(playerid, DIALOG_RENOMBRARORG, DIALOG_STYLE_INPUT, "Renombrar Organizacion", str, "Confirmar", "X");
        return 1;
}
// ==========================================
// COMANDO: /HORA
// ==========================================
CMD:hora(playerid, params[])
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Necesita iniciar login.");
    if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");

    new nueva_hora, nuevo_minuto;
    if(sscanf(params, "ii", nueva_hora, nuevo_minuto))
    {
        return SendClientMessage(playerid, -1, "USO: /hora [hora] [minutos] (Ejemplo: /hora 21 30)");
    }

    if(nueva_hora < 0 || nueva_hora > 23) return SendClientMessage(playerid, -1, "ERROR: La hora va de 0 a 23.");
    if(nuevo_minuto < 0 || nuevo_minuto > 59) return SendClientMessage(playerid, -1, "ERROR: Los minutos van de 0 a 59.");

    SetWorldTime(nueva_hora);
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            SetPlayerTime(i, nueva_hora, nuevo_minuto);
            TogglePlayerClock(i, 1);
        }
    }

    new str[128];
    format(str, sizeof(str), "[ADMIN] Has cambiado la hora del servidor a: %02d:%02d", nueva_hora, nuevo_minuto);
    SendClientMessage(playerid, -1, str);
    return 1;
}

// ==========================================
// COMANDO: /CLIMA
// ==========================================
CMD:clima(playerid, params[])
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Necesita iniciar login.");
    if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");

    new nueva_clima;
    if(sscanf(params, "i", nueva_clima))
    {
        return SendClientMessage(playerid, -1, "USO: /clima [ID del clima] (Usa /climas para ver la lista)");
    }

    if(nueva_clima < 0 || nueva_clima > 45) return SendClientMessage(playerid, -1, "ERROR: El ID del clima debe ser entre 0 y 45.");

    SetWeather(nueva_clima);
    ClimaActual = nueva_clima; // CAMBIO 2026-07-20: sincronizar variable global para sistema de enfermedades

    new str[128];
    format(str, sizeof(str), "[ADMIN] Has cambiado el clima del servidor al ID: %d", nueva_clima);
    SendClientMessage(playerid, -1, str);
    return 1;
}

// ==========================================
// COMANDO: /CLIMAS
// ==========================================
CMD:climas(playerid, params[])
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Necesita iniciar login.");
    if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");

    SendClientMessage(playerid, -1, "=== LISTA DE CLIMAS ===");
    SendClientMessage(playerid, -1, "0: Soleado | 2: Nublado | 3: Niebla | 4: Lluvia suave");
    SendClientMessage(playerid, -1, "7: Lluvia y niebla | 8: Tormenta electrica | 9: Niebla oscura");
    SendClientMessage(playerid, -1, "11: Nublado oscuro | 16: Atardecer | 20: Cielo muy oscuro");
    SendClientMessage(playerid, -1, "27: Atardecer rojo | 45: Lluvia torrencial");
    SendClientMessage(playerid, -1, "=========================");
    return 1;
}





