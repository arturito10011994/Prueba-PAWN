                else if(PlayerToPoint(3.0, playerid, -478.623901, -506.406524, 25.517845))
                {
                        // FIX AUDIT CAMIONERO CAM-A1-01/CAM-A4-01 (CRIT): setear CamionVehId al sacar truck.
                        // Antes: CamionVehId nunca se seteaba en el rental, solo en DIALOG_CARGA response.
                        // La validacion /cargar L40188 `veh != CamionVehId[playerid]` comparaba con -1
                        // y SIEMPRE fallaba. Trabajo Camionero 100% roto desde Sprint2 A-08.
                        // Ahora: CamionVehId se setea al sacar truck, desbloqueando todo el flujo.
                        // FIX AUDIT CAMIONERO CAM-A3-02 (ALTO): validar pLogado/pCongelado/pjail.
                        // FIX UX CAMIONERO v5: el truck es del TRABAJO (no alquiler). Como Camionero,
                        // tienes derecho a un truck de trabajo gratuito. No pagas alquiler.
                        if(PlayerInfo[playerid][pProfissao] != 4)               return ErrorMsg(playerid, "No tienes permisos. Este truck es solo para Camioneros.");
                        if(!pLogado[playerid]) return 1;
                        if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "Estas algemado.");
                        if(PlayerInfo[playerid][pjail] > 0) return ErrorMsg(playerid, "Estas en la carcel.");
                        if(VehAlugado[playerid] == 0)
                        {
                                VehAlugado[playerid] = 1;
                                VeiculoCivil[playerid] = CreateVehicle(456, -478.623901, -506.406524, 25.517845, 273.778228, -1, -1, false);
                                CamionVehId[playerid] = VeiculoCivil[playerid]; // FIX CAM-A1-01
                                PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                                // FIX UX CAMIONERO: motor encendido - el truck de trabajo viene listo.
                                ToggleEngine(VeiculoCivil[playerid], VEHICLE_PARAMS_ON);
                                MotorOn[playerid] = 1;
                                // FIX UX CAMIONERO: mensaje claro - truck de trabajo, no alquiler.
                                InfoMsg(playerid, "Truck de trabajo asignado. Ve al punto de carga (-520, -504) y usa /cargar para empezar una ruta.");
                        }
                        else
                        {
                                InfoMsg(playerid, "Ya tienes un truck asignado. Usa /dvehiculo para devolverlo.");
                        }
                }
