                                if(MinutosMorte[playerid] > 0) return ErrorMsg(playerid, "Estas herido. No puedes iniciar examen.");
                                if(GetPlayerState(playerid) == PLAYER_STATE_WASTED) return ErrorMsg(playerid, "Estas muerto. No puedes iniciar examen.");
