                                        SuccesMsg(playerid, "Compraste un Kit de Reparacion. Usa /usarkitrep para curar 30 HP.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -3000);
                                        GanharItem(playerid, ITEM_KITREP, 1);
                                        CofreNiobio += 3000;
