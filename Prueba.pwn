                                {
                                        format(Str, sizeof(Str),"Introduce el ID del jugador al que quieres transferir el dinero.",PlayerInfo[playerid][pBanco]);
                                        ShowPlayerDialog(playerid,DIALOG_BANCO4,1,"Transferir", Str, "Seleccionar","X");
                                }
                                if(listitem == 1)
                                {
                                        format(Str, sizeof(Str),"Ã¯Â¿Â½Que quieres anunciar? Tu anuncio debe contener\n74 caracteres o no se enviara.");
                                        ShowPlayerDialog(playerid,DIALOG_ANUNCIOOLX,1,"Transferir", Str, "Seleccionar","X");
                                }
                        }
                }
                // case DIALOG_REANIMAR ELIMINADO - cuerpo vacio, comando /reanimar deprecado.
                // El revive admin oficial ahora es /revivirstaff [IDF] (ver CMD:revivirstaff).
                case DIALOG_DEFIBRILADOR:
                {
                    // =====================================================
                    // DEFIBRILADOR PORTATIL CIVIL - Item 11738
                    // Reanimacion civil con limitaciones vs paramedico.
                    // =====================================================
                    if(!response) return 1; // Cancelo

                    new targetId = strval(inputtext);
                    if(targetId < 0 || targetId >= MAX_PLAYERS)
                        return ErrorMsg(playerid, "ID invalido.");

                    if(!IsPlayerConnected(targetId) || !pLogado[targetId])
                        return ErrorMsg(playerid, "Jugador no conectado.");

                    if(targetId == playerid)
                        return ErrorMsg(playerid, "No puedes reanimarte a ti mismo.");

                    // Validar que el target este herido
                    if(MinutosMorte[targetId] <= 0 && SegundosMorte[targetId] <= 0)
                        return ErrorMsg(playerid, "Ese jugador no esta herido. No necesita reanimacion.");

                    // Validar distancia (1m, mas estricto que paramedico)
                    new Float:tx, Float:ty, Float:tz;
                    GetPlayerPos(targetId, tx, ty, tz);
                    if(GetPlayerDistanceFromPoint(playerid, tx, ty, tz) > 1.0)
                        return ErrorMsg(playerid, "El jugador no esta lo suficientemente cerca (max 1m).");

                    // Validar que el item siga en el inventario (pudo haber cambiado)
                    new itemModel = GetPVarInt(playerid, "DefibItemModel");
                    new itemSlot = -1;
                    for(new s = 0; s < 33; s++)
                    {
                        // FIX AUDIT INV I0-5: usar [Slot] en vez de [DropItemID] (mismo bug que OnPlayerDeath).
                        if(PlayerInventario[playerid][s][Slot] == itemModel &&
                           PlayerInventario[playerid][s][Unidades] >= 1)
                        {
                            itemSlot = s;
                            break;
                        }
                    }
                    if(itemSlot == -1)
                        return ErrorMsg(playerid, "Ya no tienes defibriladores en el inventario.");

                    // Re-validar cooldown (pudo pasar tiempo desde que abrio el dialog)
                    new lastUse = GetPVarInt(playerid, "DefibCooldown");
                    new now = gettime();
                    if(now - lastUse < 60)
                    {
                        new cdMsg[100];
                        format(cdMsg, sizeof(cdMsg), "El defibrilador esta recargando. Espera %d segundos.", 60 - (now - lastUse));
                        return ErrorMsg(playerid, cdMsg);
                    }

                    // === EJECUTAR REANIMACION CIVIL ===

                    // Cleanup completo del estado de muerte del target
                    MinutosMorte[targetId] = 0;
                    SegundosMorte[targetId] = 0;
                    if(SangueObjeto[targetId] > -1)
                    {
                        DestroyObject(SangueObjeto[targetId]);
                        SangueObjeto[targetId] = -1;
                    }
                    for(new t = 0; t < 7; t++)
                        PlayerTextDrawHide(targetId, TelaMorteCDA[targetId][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[targetId] = false;                    // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (defibrilador).
                    for(new _t = 0; _t < 5; _t++)
                        TextDrawHideForPlayer(targetId, LogoBZ[_t]);

                    // Restaurar 50 HP (no al maximo - limitacion civil)
                    SetPlayerHealth(targetId, 50.0);
                    // No restaurar hambre/sed (limitacion civil)
                    TogglePlayerControllable(targetId, 1);
                    SetTimerEx("SpawnP", 500, false, "i", targetId);
                    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);

                    // Consumir 1 unidad del item
                    PlayerInventario[playerid][itemSlot][Unidades] -= 1;
                    AtualizarInventario(playerid, itemModel);

                    // Registrar cooldown
                    SetPVarInt(playerid, "DefibCooldown", now);
                    DeletePVar(playerid, "DefibItemModel");

                    // Notificaciones
                    new msg[180];
                    format(msg, sizeof(msg), "* Usaste un defibrilador portatil en %s. Reanimado con 50 HP.", PlayerName(targetId));
                    SendClientMessage(playerid, 0x3CB371FF, msg);
                    format(msg, sizeof(msg), "* %s te reanimo con un defibrilador portatil. Vida restaurada a 50%%.", PlayerName(playerid));
                    SendClientMessage(targetId, 0x3CB371FF, msg);
                    GameTextForPlayer(targetId, "~g~Reanimado", 2000, 3);

                    // Avisar a paramedicos online que alguien fue reanimado por un civil
                    // (transparencia RP, no es pago)
                    foreach(new i : Player)
                    {
                        if(pLogado[i] && PlayerInfo[i][Org] == 10)
                        {
                            format(msg, sizeof(msg), "| PARAMEDICO | El/La civil %s reanimo a %s con un defibrilador portatil.", PlayerName(playerid), PlayerName(targetId));
                            SendClientMessage(i, COR_PARAMEDICO, msg);
                        }
                    }

                    return 1;
                }
                case DIALOG_CARGA:
                {
                        if(response)
                        {
                                // FIX SPRINT2 A-11: revalidar que el jugador sigue en SU truck 456.
                                // Antes: /cargar validaba modelo 456 al abrir el dialogo, pero
