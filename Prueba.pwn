                        }
                        if(!hayHerido)
                            return ErrorMsg(playerid, "No hay ningun jugador herido cerca tuyo (radio 5m).");

                        cmd_inventario(playerid);
                        ShowPlayerDialog(playerid, DIALOG_DEFIBRILADOR, DIALOG_STYLE_INPUT,
                            "{FFFFFF}Defibrilador Portatil",
                            "{FFFFFF}Ingresa el ID del jugador que quieres reanimar.\n\n{FFFF00}Requisitos:\n{FFFFFF}- Debe estar herido\n- Debe estar a max 1m de ti\n- El defibrilador restaura 50 HP (no al maximo)\n- Cooldown de 60s tras cada uso",
                            "Reanimar", "Cancelar");
                        // Guardar el modelid del item para saber cual consumir tras el dialog
                        SetPVarInt(playerid, "DefibItemModel", slotIndex);
                        return 1;
                }
                case 1654:
                {
                        if(quantia != 1) return ErrorMsg(playerid, "Usted solo consigue utilizar 1 cantidad..");
                        new Caja_id;
                        if(!(Caja_id=GetPlayerCaja(playerid)))return ErrorMsg(playerid, "No estas cerca de una Caja.");
                        if(CajaInfo[Caja_id][Caja_Roubada])return ErrorMsg(playerid, "Esta Caja ya fue robada.");
                        if(TendoRoubo)return ErrorMsg(playerid, "Ya robaron hace poco tiempo.");
                        if(policiaon < 2) return ErrorMsg(playerid, "No hay policias en patrullaje en este momento.");
                        cmd_inventario(playerid);

                        new
                        Float:px, Float:py, Float:pz,
                        Float:rx, Float:ry, Float:rz
                        ;

                        GetDynamicObjectPos(CajaInfo[Caja_id][Caja_Object], px, py, pz);
                        GetDynamicObjectRot(CajaInfo[Caja_id][Caja_Object], rx, ry, rz);
                        GetXYInFrontOfCaja(CajaInfo[Caja_id][Caja_Object], px, py, 0.9);

                        UltimaCajaRoubada[0] = px;
                        UltimaCajaRoubada[1] = py;
                        UltimaCajaRoubada[2] = pz;

                        RoubandoCaja[playerid] = false;

                        // FIX AUDIT ANIM ANIM-A5-04 (ALTO): usar SPECIAL_ACTION_NONE constante.
                        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        SetPlayerPos(playerid, px, py, pz);
                        SetPlayerFacingAngle(playerid, rz);
                        TogglePlayerControllable(playerid, 0);
                        ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 1, 0, 0, 0, 1);

                        SetTimerEx("RoubarCaja", 20*1000, 0, "dd", playerid, GetPlayerCaja(playerid));
                        // FIX AUDIT ANIM ANIM-A5-01 (CRITICO): SetAnimRoubo callback FANTASMA eliminado.
                        // ANTES: SetTimerEx invocaba callback SetAnimRoubo que NO EXISTE en
                        // toda la GM. Generaba log spam perpetuo + BOM_Plant_Loop no se reaplicaba
                        // en loop. La animacion L12513 ya es un loop infinito (forceserver=1)
                        // que se mantiene solo hasta ClearAnimations/TogglePlayerControllable(1).
                        PlayerInventario[playerid][slotIndex][Unidades]--;
                        AtualizarInventario(playerid, slotIndex);
                        // FIX AUDIT INV I2-5: persistir inmediatamente tras decremento.
                        // Antes: NO llamaba SalvarInventario. Si el server crasheaba antes
                        // del SaveTimer, el disco tenia la cantidad original = la Dinamita se
                        // duplicaba al reconectar. El robo de la caja ya estaba en curso
                        // (timer activo) = DUPE.
                        SalvarInventario(playerid);

                        CajaInfo[Caja_id][Caja_Roubada] = true;

                        new location[MAX_ZONE_NAME];
                        GetPlayer2DZone2(playerid, location, MAX_ZONE_NAME);
                        new noti = randomEx(0, 2);
                        if(noti == 1)
                        {
                                foreach(new i : Player)
                                {
                                        if(Patrulha[i] == true)
                                        {
                                                format(Str, sizeof(Str), "Um cidadao acabou de denunciar um individuo tentando roubar um Caja em %s", location);
                                                WarningMsg(i, Str);
                                        }
                                }
                        }

                        InfoMsg(playerid, "Estas colocando un explosivo.");
                        return 1;
                }
                case 11736:
                {
                        if(quantia != 1) return ErrorMsg(playerid, "Usted solo consigue utilizar 1 cantidad..");
                        new Float:health;
                GetPlayerHealth(playerid,health);
                        if(health >= 90) return ErrorMsg(playerid, "No puedes usar vendas ahora.");

                        SetPlayerHealth(playerid, health+10);
                        PlayerInventario[playerid][slotIndex][Unidades]--;
                        AtualizarInventario(playerid, slotIndex);
                        // FIX AUDIT INV I2-5: persistir inmediatamente tras decremento.
                        // Antes: NO llamaba SalvarInventario (H-A1-47, trivialmente reproducible).
                        // Si el server crasheaba antes del SaveTimer, el disco tenia la cantidad
                        // original = la Bandagem se duplicaba al reconectar. La vida +10 ya
                        // estaba aplicada al jugador = DUPE.
                        SalvarInventario(playerid);
                        return 1;
                }
        }
        return 0;
}

