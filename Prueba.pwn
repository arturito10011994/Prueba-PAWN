                                SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
                        SetPlayerAttachedObject(playerid, 1, 1220, 5, 0.044377, 0.029049, 0.161334, 265.922912, 9.904896, 21.765972, 0.500000, 0.500000, 0.500000);
                        Desossando[playerid] = 6;
