                                else // Comercial
                                        vehicAereo = vehiculosComerciales[random(sizeof(vehiculosComerciales))];
                                AutoEscolaAerea[playerid] = CreateVehicle(vehicAereo, 2041.3486,-2593.3042,14.4689,89.1870, 6, 6, 2400000);
