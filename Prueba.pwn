                                ShowPlayerDialog(playerid, DIALOG_RECOLECTOR, DIALOG_STYLE_LIST, "Cobrar ruta de basura", "{FFFF00}1.{FFFFFF} Cobrar ruta completada ($400-600)", "Cobrar", "Cancelar");
                                return 1;
                        }
                        // Mostrar menu
                        new menuStr[256];
                        if(PlayerInfo[playerid][pProfissao] != 6)
                        {
                                format(menuStr, sizeof(menuStr), "{FFFF00}1.{FFFFFF} Obtener trabajo de Recolector\n{FFFF00}2.{FFFFFF} Recogedor Nivel 1 (a pie)\n{FFFF00}3.{FFFFFF} Recogedor Nivel 2 (camion)");
                        }
                        else
                        {
                                new horasTrabajo = PlayerInfo[playerid][pSegundosJogados] / 3600;
                                format(menuStr, sizeof(menuStr), "{FFFF00}1.{FFFFFF} Ayuda del trabajo\n{FFFF00}2.{FFFFFF} Recogedor Nivel 1 (a pie)\n{FFFF00}3.{FFFFFF} Recogedor Nivel 2 (camion) - Requiere 6h (tienes: %dh)", horasTrabajo);
                        }
                        ShowPlayerDialog(playerid, DIALOG_RECOLECTOR, DIALOG_STYLE_LIST, "Funeraria El Ultimo Adios - Recolector", menuStr, "Seleccionar", "Cancelar");
                        return 1;
                }
                if(PlayerToPoint(3.0, playerid, EMP_NPC_X, EMP_NPC_Y, EMP_NPC_Z))
                {
                        // SISTEMA EMPAQUETADOR REDISEÃ¯Â¿Â½ADO: menu con 4 niveles.
                        if(PlayerInfo[playerid][pRG] == 0)      return InfoMsg(playerid, "No tienes RG.");
                        if(!TieneCarnetTrabajo(playerid)) return InfoMsg(playerid, "Necesitas Carnet de Trabajo. Obtenlo en el Ayuntamiento.");
                        if(PlayerInfo[playerid][pProfissao] != 0 && PlayerInfo[playerid][pProfissao] != 7) return InfoMsg(playerid, "Ya tienes un trabajo /salirtrabajo.");
                        // Si tiene ruta en curso, permitir cobrar
                        if(g_EmpRutaActiva[playerid] && g_EmpEsperandoDescarga[playerid] == 2)
                        {
                                ShowPlayerDialog(playerid, DIALOG_EMPAQUETADOR, DIALOG_STYLE_LIST, "Cobrar ruta completada", "{FFFF00}1.{FFFFFF} Cobrar ruta completada", "Cobrar", "Cancelar");
                                return 1;
                        }
                        // Menu principal
                        new menuStr[512];
                        if(PlayerInfo[playerid][pProfissao] != 7)
                        {
                                format(menuStr, sizeof(menuStr), "{FFFF00}1.{FFFFFF} Obtener trabajo de Empaquetador\n{FFFF00}2.{FFFFFF} Ver niveles disponibles");
                        }
                        else
                        {
                            format(menuStr, sizeof(menuStr), "{FFFF00}1.{FFFFFF} Ayuda del trabajo\n");
                            format(menuStr, sizeof(menuStr), "%s{FFFF00}2.{FFFFFF} Nivel 1 - Montacargas (disponible)\n", menuStr);
                            if(g_EmpCajasCompletadas[playerid] >= 5)
                                format(menuStr, sizeof(menuStr), "%s{00FF00}3.{FFFFFF} Nivel 2 - Camion 499 (disponible - %d cajas)\n", menuStr, g_EmpCajasCompletadas[playerid]);
                            else
                                format(menuStr, sizeof(menuStr), "%s{FF0000}3.{FFFFFF} Nivel 2 - Bloqueado (%d/5 cajas)\n", menuStr, g_EmpCajasCompletadas[playerid]);
                            if(g_EmpRecorridosCompletados[playerid] >= 100)
                                format(menuStr, sizeof(menuStr), "%s{00FF00}4.{FFFFFF} Nivel 3 - Mule 414 (disponible - %d recorridos)\n", menuStr, g_EmpRecorridosCompletados[playerid]);
                            else
                                format(menuStr, sizeof(menuStr), "%s{FF0000}4.{FFFFFF} Nivel 3 - Bloqueado (%d/100 recorridos)\n", menuStr, g_EmpRecorridosCompletados[playerid]);
                            if(g_EmpRecorridosCompletados[playerid] >= 200)
                                format(menuStr, sizeof(menuStr), "%s{00FF00}5.{FFFFFF} Nivel 4 - Camion 573 (disponible - %d recorridos)\n", menuStr, g_EmpRecorridosCompletados[playerid]);
                            else
                                format(menuStr, sizeof(menuStr), "%s{FF0000}5.{FFFFFF} Nivel 4 - Bloqueado (%d/200 recorridos)\n", menuStr, g_EmpRecorridosCompletados[playerid]);
                        }
                        ShowPlayerDialog(playerid, DIALOG_EMPAQUETADOR, DIALOG_STYLE_LIST, "Almacen de Distribucion - Empaquetador", menuStr, "Seleccionar", "Cancelar");
                        return 1;
                }
                // =====================================================================
                // CLINICA SOTORP - BLOQUE DE DAR TRABAJO DE MEDICO DESHABILITADO
                // (El Hospital ahora funciona como Org 10, no como pProfissao 9)
                // =====================================================================
                /* if(PlayerToPoint(3.0, playerid, 1208.0334, -1719.3846, 13.5469)) {
                        if(PlayerInfo[playerid][Org] == 10)
                        { // Migrado a Org 10
                                if(VehAlugado[playerid] == 0)
                                {
                                        VehAlugado[playerid] = 1;
                                        if(random(2) == 0)
                                        {
                                                VeiculoCivil[playerid] = CreateVehicle(416, 1203.6045, -1729.9858, 13.2386, -90.0000, -1, -1, 100);
                                        }
                                        else
                                        {
                                                VeiculoCivil[playerid] = CreateVehicle(416, 1197.4801, -1734.2942, 13.2288, -180.0000, -1, -1, 100);
                                        }
                                        PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                                        InfoMsg(playerid, "Para devolver su vehiculo use /dvehiculo.");
                                }
                                else
                                {
                                        InfoMsg(playerid, "ya tienes un vehiculo use /dvehiculo.");
                                }
                                return 1;
                        }
                        if(PlayerInfo[playerid][pRG] == 0)      return InfoMsg(playerid, "No tienes RG.");
                        if(!TieneCarnetTrabajo(playerid)) return InfoMsg(playerid, "Necesitas Carnet de Trabajo. Obtenlo en el Ayuntamiento.");
                        if(PlayerInfo[playerid][pProfissao] != 0)               return InfoMsg(playerid, "Ya tienes un trabajo /salirtrabajo.");
                        else
                        {
                                if(PlayerInfo[playerid][LicencaConduzir] == 0) return ErrorMsg(playerid, "No tienes licencia");
                                PlayerInfo[playerid][pProfissao] = 9;
                                SuccesMsg(playerid, "Conseguiste un nuevo trabajo.");
                        }
                } */
        // =====================================================================
                if(PlayerToPoint(3.0, playerid, 939.6504,1733.2004,8.8516)) //correios
                {
                        if(PlayerInfo[playerid][pRG] == 0)      return InfoMsg(playerid, "No tienes RG.");
                        if(!TieneCarnetTrabajo(playerid)) return InfoMsg(playerid, "Necesitas Carnet de Trabajo. Obtenlo en el Ayuntamiento.");
                        if(PlayerInfo[playerid][pSegundosJogados] < 32400) return InfoMsg(playerid, "Usted debe tener 9hrs de juego.");
                        // FIX SPRINT4 9.2: usar helper TieneLicenciaCategoria.
                        // Correos usa Van (modelo 413) = licencia Auto (Cat. B).
                        if(!TieneLicenciaCategoria(playerid, LIC_ITEM_AUTO)) return InfoMsg(playerid, "No tienes licencia de auto (Cat. B).");
                        if(PlayerInfo[playerid][pProfissao] != 0)               return InfoMsg(playerid, "Ya tienes un trabajo /salirtrabajo.");
                        else
                        {
                                PlayerInfo[playerid][pProfissao] = 8;
                                SuccesMsg(playerid, "Conseguiste un nuevo trabajo.");
                        }
                }
        }
        return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
        new logmsg[160];
        new year, month, day, hour, minute, second;
        getdate(year, month, day);
        gettime(hour, minute, second);
        format(logmsg, sizeof(logmsg), "[%02d:%02d:%02d %02d-%02d-%04d] IP: %s | Resultado: %s",
                hour, minute, second, day, month, year, ip, (success) ? ("EXITO") : ("FALLO"));
        Log("Logs/RconAttempts.ini", logmsg);
        return 1;
}

// SISTEMA ANTI-CHEAT: helper para alertar a admins y loguear
stock AC_Alert(playerid, const reason[], severity)
{
        // severity: 1=warning (strike), 2=kick
        // FIX AUDIT2 AGENT3 T-03 + AGENT5 X-04: rate-limit para severity 1 (strikes).
        // Antes NO habia rate-limit. TP-06 y TP-14 corren a 30Hz en OnPlayerUpdate.
        // Un hacker (o jugador en azotea alta) podia disparar 30 strikes/seg =
        // 3 strikes en 100ms = kick falso en 600ms. Ademas, cada AC_Alert hace
        // DOF2_SaveFile() sincrono = 30 fwrite/seg = lag spike sostenido.
        // Fix: maximo 1 strike por segundo por jugador. Severity 2 (kick) siempre
        // dispara inmediatamente (no se rate-limita).
        // FIX AUDIT AC-H9: rate-limit TAMBIEN para severity 2 (kick directo).
        // Antes: severity 2 no tenia rate-limit. Durante los 500ms del KickPlayer
        // deferred (macro #define Kick), OnPlayerUpdate podia disparar 15 alertas
        // sev 2 redundantes x DOF2_SaveFile() sincrono = lag spike + spam a admins.
        // Ahora: maximo 1 kick-alert cada 5s por jugador. El primer kick dispara
        // inmediatamente; los siguientes en 5s se skipan (el jugador ya va a ser
        // kickeado por el primero).
        if(severity == 1)
        {
                new lastStrike = GetPVarInt(playerid, "AC_LastStrikeAlert");
                new nowTick = GetTickCount();
                // GetTickCount puede hacer wrap tras ~49 dias; tratar diff negativo como 0
                new diff = nowTick - lastStrike;
                if(diff >= 0 && diff < 1000)
                        return 1; // rate-limited: skip esta alerta
                SetPVarInt(playerid, "AC_LastStrikeAlert", nowTick);
        }
        else if(severity == 2)
        {
                // FIX AUDIT AC-H9: rate-limit severity 2 (5s cooldown).
                // El primer kick dispara inmediatamente. Los siguientes en 5s se skipan
                // porque el jugador ya esta siendo kickeado (Kick deferred 500ms).
                new lastKickAlert = GetPVarInt(playerid, "AC_LastKickAlert");
                new nowTick2 = GetTickCount();
                new diff2 = nowTick2 - lastKickAlert;
                if(diff2 >= 0 && diff2 < 5000)
                        return 1; // rate-limited: skip kick redundante
                SetPVarInt(playerid, "AC_LastKickAlert", nowTick2);
        }
        new playerName[MAX_PLAYER_NAME], alertMsg[256], horaA, minA, segA;
        GetPlayerName(playerid, playerName, sizeof(playerName));
        gettime(horaA, minA, segA);
        // Alerta a todos los admins online
        format(alertMsg, sizeof(alertMsg), "{FF0000}[ANTI-CHEAT]{FFFFFF} %s (ID:%d) - %s [%02d:%02d:%02d]",
                playerName, playerid, reason, horaA, minA, segA);
        foreach(new p : Player)
        {
                if(pLogado[p] && PlayerInfo[p][pAdmin] >= 1)
                        SendClientMessage(p, 0xFF0000FF, alertMsg);
        }
        // Log a archivo
        new logFile[64], logKey[32], diaA, mesA, anoA;
        getdate(anoA, mesA, diaA);
        format(logFile, sizeof(logFile), "Logs/AntiCheat.ini");
        if(!DOF2_FileExists(logFile)) DOF2_CreateFile(logFile);
        new total = DOF2_GetInt(logFile, "Total");
        total++;
        format(logKey, sizeof(logKey), "AC_%d", total);
        new logMsg[256];
        format(logMsg, sizeof(logMsg), "[%02d/%02d %02d:%02d:%02d] %s (ID:%d, IDF:%04d, Org:%d) - %s (Sev:%d)",
                diaA, mesA, horaA, minA, segA, playerName, playerid, PlayerInfo[playerid][IDF],
                PlayerInfo[playerid][Org], reason, severity);
        DOF2_SetString(logFile, logKey, logMsg);
        DOF2_SetInt(logFile, "Total", total);
        // FIX AUDIT AC-H14: no hacer DOF2_SaveFile() en cada AC_Alert (performance).
        // Antes: cada AC_Alert hacia DOF2_SaveFile() sincrono = fsync bloqueante.
        // Con 300 jugadores y FPs de nitro (H13 corregido), aun podian haber
        // ~10 alerts/seg = 10 fsync/seg = lag spike sostenido.
        // Ahora: el SaveTimer global (cada 2.2s) hace DOF2_SaveFile rotativamente.
        // El DOF2_SetString/SetInt se hace en memoria (DOF2 bufferiza), y el
        // SaveTimer flushea a disco. Si el server crashea entre alerts, el log
        // puede perder las ultimas 2s de entries (aceptable para un log AC).
        // Si se necesita flush inmediato para alerts criticas (sev=2), agregar
        // DOF2_SaveFile() solo en el bloque de sev=2 (kick directo).
        // FIX AUDIT AC-H14 (complemento): flush inmediato solo para severity=2 (kick).
        if(severity == 2) DOF2_SaveFile();
        printf("[ANTI-CHEAT] %s", logMsg);
        // Accion segun severidad
        if(severity == 1)
        {
                g_AC_Strikes[playerid]++;
                if(g_AC_Strikes[playerid] >= 3)
                {
                        format(alertMsg, sizeof(alertMsg), "{FF0000}[ANTI-CHEAT]{FFFFFF} %s kickeado automaticamente (3 strikes).", playerName);
                        SendClientMessageToAll(0xFF0000FF, alertMsg);
                        Kick(playerid);
                }
        }
        else if(severity == 2)
        {
                Kick(playerid);
        }
        return 1; // FIX: warning 209 - function should return a value
}

// SISTEMA ANTI-CHEAT: verificar si un arma esta permitida para la org del jugador
stock AC_IsWeaponAllowed(playerid, weaponid)
{
        // FIX AUDIT AC-H2: subir inmunidad de admin 3+ a admin 6+ (igual que OnPlayerUpdate).
        // Antes: admin lvl 3+ era inmune al weapon hack check (podia tener cualquier arma).
        // Ahora: solo admin 6+ (managers) y admin en servicio staff (pJogando=false) son inmunes.
        // Admin 1-5 jugando recibe weapon hack check completo.
        if(PlayerInfo[playerid][pAdmin] >= 6) return 1;
        if(PlayerInfo[playerid][pAdmin] >= 1 && pJogando[playerid] == false) return 1;
        // Verificar lista de armas prohibidas
        for(new i = 0; i < sizeof(ArmaProibidaIDs); i++)
        {
                if(weaponid == ArmaProibidaIDs[i])
                {
                        // Excepcion: Ejercito (Org 14) en servicio puede tener minigun (38)
                        if(weaponid == 38 && PlayerInfo[playerid][Org] == 14 && Patrulha[playerid] == true)
                                return 1;
                        // Excepcion: Molotov (18) para bandas
                        if(weaponid == 18 && IsBandido(playerid))
                                return 1;
                        return 0;
                }
        }
        return 1;
}

// FIX AUDIT AC-MEJORA3: helper IsACExempt(playerid) para reducir codigo duplicado.
// Centraliza las exenciones de HP > 100 y Armour > 100 que se repiten en 6 sitios
// de OnPlayerUpdate. AntiAway y otros callers pueden usar este helper en una sola linea.
// Retorna: true si el jugador esta en estado legitimamente exento de AC HP/Armour.
stock IsACExempt(playerid)
{
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) return true; // herido
        if(PlayerInfo[playerid][pjail] > 0) return true;                           // preso
        if(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 1) return true; // admin duty
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return true;        // spectating
        // HQ Safe Zones (solo miembros con PVar InHQ seteado)
        if(GetPVarInt(playerid, "P0_5_InHQ") > 0 || GetPVarInt(playerid, "T0_2_InHQTransito") > 0 ||
           GetPVarInt(playerid, "P0_FBI1_InHQFBI") > 0 || GetPVarInt(playerid, "P0_SWAT1_InHQSWAT") > 0 ||
           GetPVarInt(playerid, "P0_EJ1_InHQEJ") > 0 || GetPVarInt(playerid, "P0_REP2_InHQREP") > 0 ||
           GetPVarInt(playerid, "P0_BEN_ZS_InHQ") > 0) return true;
        if(IsPlayerInDynamicArea(playerid, AreaHospital_SafeZone)) return true;    // hospital
        return false;
}

public OnPlayerUpdate(playerid)
{
        // SISTEMA ANTI-CHEAT (Opcion B)
        if(!pLogado[playerid]) return 1;
        // FIX AUDIT AC-H2: subir inmunidad AC de admin 3+ a admin 6+.
        // Antes: `if(PlayerInfo[playerid][pAdmin] >= 3) return 1;` daba inmunidad
        // TOTAL a admins nivel 3, 4, 5 (podian cheatear libremente: teleport,
        // health hack, armour hack, weapon hack, jetpack, speedhack, money hack).
        // Solo TimerHack (1s, slot equipado) los verificaba.
        // Ahora: solo admins nivel 6+ (managers) y 7 (dueÃ¯Â¿Â½o) son inmunes.
        // Admins 1-5 reciben anti-cheat completo (como jugadores normales).
        // Excepcion: admin en servicio staff (pJogando=false) SI es inmune para
        // poder usar comandos admin (jetpack, /ir, /traer, /setvida, etc.) sin
        // ser kickeado por anti-teleport/anti-health. Pero admin JUGANDO (pJogando=true)
        // recibe anti-cheat completo.
        if(PlayerInfo[playerid][pAdmin] >= 6) return 1;
        if(PlayerInfo[playerid][pAdmin] >= 1 && pJogando[playerid] == false) return 1;

        // FIX AUDIT5 PERF-CRIT-2-6: cache natives al inicio del callback.
        // Antes: GetPlayerState llamado 8x, IsPlayerInAnyVehicle 3x,
        // GetPlayerSpecialAction 2x, GetPlayerVelocity 2x SIN cache.
        // A 300p x 30Hz = 129,600 wasted native calls/sec.
        // Fix: cachear todos al inicio, reusar en todos los checks.
        new nowTick = GetTickCount();
        new Float:curX, Float:curY, Float:curZ;
        GetPlayerPos(playerid, curX, curY, curZ);
        new pState = GetPlayerState(playerid);
        new pInVeh = IsPlayerInAnyVehicle(playerid); // FIX: warning 213 - IsPlayerInAnyVehicle retorna int, no bool
        new pSpecialAction = GetPlayerSpecialAction(playerid);
        // FIX AUDIT6-FIX-PERF: ambas ramas del if/else (curZ > 100 y resto) llamaban
        // GetPlayerVelocity. Colapsado a una sola condicion: si esta a pie y sin vehiculo,
        // llamar GetPlayerVelocity una sola vez. El early-out por Z no ahorra nada porque
        // ambas ramas ejecutaban la misma native.
        new Float:pVelX = 0.0, Float:pVelY = 0.0, Float:pVelZ = 0.0;
        if(!pInVeh && pState == PLAYER_STATE_ONFOOT)
                GetPlayerVelocity(playerid, pVelX, pVelY, pVelZ);

        // === 1. ANTI-TELEPORT ===
        // Calcular distancia recorrida desde la ultima actualizacion
        // FIX AUDIT AGENT2 TP-05: cambiado de gettime() (segundos) a GetTickCount()
        // (ms) para resolucion sub-segundo. nowTs ya no se usa - los grace windows
        // (ACTPImmune, HospitalTPCooldown) usan gettime() directamente.
        // FIX AUDIT2 AGENT3 T-01: antes g_AC_LastUpdate se actualizaba CADA OnPlayerUpdate
        // (fuera del bloque if), haciendo que tickDiff siempre fuera ~33ms (un frame).
        // La condicion tickDiff > 250 NUNCA se cumplia para jugadores activos, dejando
        // el anti-teleport completamente INOPERATIVO. Fix: solo actualizar el snapshot
        // (g_AC_LastX/Y/Z y g_AC_LastUpdate) cuando el check corre (cada 250ms).
        // El primer update inicializa el snapshot sin checkear.
        if(g_AC_LastUpdate[playerid] == 0)
        {
                // Primer update del jugador: inicializar snapshot, no checkear
                g_AC_LastX[playerid] = curX;
                g_AC_LastY[playerid] = curY;
                g_AC_LastZ[playerid] = curZ;
                g_AC_LastUpdate[playerid] = nowTick;
        }
        else
        {
                new tickDiff = nowTick - g_AC_LastUpdate[playerid];
                // Skip si tickDiff es invalido (wrap de GetTickCount tras ~49 dias)
                if(tickDiff >= 250 && tickDiff < 1000000)
                {
                        // FIX AUDIT AGENT2 TP-04: anyadir Z a la formula. Antes solo usaba X/Y,
                        // lo que permitia teleports verticales (airbreak Z-only) indetectables.
                        // Tambien cambio floatpower(x, 2) por (x*x) por performance (10x mas rapido).
                        new Float:dx = curX - g_AC_LastX[playerid];
                        new Float:dy = curY - g_AC_LastY[playerid];
                        new Float:dz = curZ - g_AC_LastZ[playerid];
                        new Float:distMoved = floatsqroot(dx * dx + dy * dy + dz * dz);
                        // FIX AUDIT AGENT2 TP-13: umbrales bajados para mejor deteccion.
                        // Antes: 50m/s a pie (180 km/h, 7x mas rapido que sprint normal de 7m/s).
                        // Antes: 120m/s vehiculo (432 km/h, 1.7x mas rapido que Infernus max).
                        // Nuevos: 15m/s a pie (54 km/h, 2x sprint normal - deja margen para lag).
                        //         90m/s vehiculo (324 km/h - cubre Infernus, NRG, deja margen).
                        // FIX AUDIT AGENT2 TP-05: umbrales ajustados a resolucion 250ms.
                        // 15m/s * 0.25s = 3.75m por tick de 250ms (a pie).
                        // 90m/s * 0.25s = 22.5m por tick de 250ms (vehiculo).
                        // Aviones (Hydra, Rustler, Shamal) son excepcionados por no ser vehiculos
                        // terrestres comunes - si se requiere, ampliar el check por modelo.
                        // FIX AUDIT5-FIX-Y: usar pInVeh cacheado (L25409) en vez de IsPlayerInAnyVehicle.
                        new Float:maxDist = AC_TP_MAX_DIST_FOOT; // FIX AUDIT AC-MEJORA2
                        if(pInVeh) maxDist = AC_TP_MAX_DIST_VEH;
                        // FIX AUDIT AGENT2 TP-21: anyadir PLAYER_STATE_ENTER_VEHICLE_DRIVER,
                        // PLAYER_STATE_ENTER_VEHICLE_PASSENGER y PLAYER_STATE_EXIT_VEHICLE a
                        // exenciones. Durante estas transiciones, la posicion puede cambiar
                        // (el jugador "salta" al vehiculo) y podria causar falsos positivos
                        // raros. Nota: SA-MP 0.3.7 no define PLAYER_STATE_ENTER_VEHICLE
                        // (sin sufijo); son _DRIVER (5) y _PASSENGER (6).
                        // FIX AUDIT5-FIX-Y: usar pState cacheado (L25408) en vez de 5x GetPlayerState.
                        if(pState != PLAYER_STATE_SPECTATING
                           && pState != PLAYER_STATE_WASTED
                           && pState != PLAYER_STATE_ENTER_VEHICLE_DRIVER
                           && pState != PLAYER_STATE_ENTER_VEHICLE_PASSENGER
                           && pState != PLAYER_STATE_EXIT_VEHICLE)
                        {
                                // Ignorar si acaba de spawnear (PVar TPCooldown de hospitales)
                                // FIX AUDIT AC-H3: reducida inmunidad anti-TP de 10s a 3s.
                                // Antes: `> 10` exima anti-teleport por 10s tras cualquier
                                // teleport de hospital. Un jugador podia caminar por hospital
                                // cada 8s (cooldown) para mantener inmunidad 10s continua,
                                // bypass anti-teleport indefinidamente.
                                // Ahora: `> 3` solo exime por 3s tras teleport legitimo.
                                // El cooldown de hospital de 15s (fix abajo) asegura que
                                // no se puede mantener inmunidad continua.
                                if(gettime() - GetPVarInt(playerid, "HospitalTPCooldown") > 3 &&
                                   gettime() - GetPVarInt(playerid, "ACTPImmune") > 5)
                                {
                                        if(distMoved > maxDist)
                                        {
                                                new reason[128];
                                                format(reason, sizeof(reason), "Teleport detectado: %.1fm en %dms (max: %.1fm)", distMoved, tickDiff, maxDist);
                                                AC_Alert(playerid, reason, 2); // kick directo
                                                return 1;
                                        }
                                }
                        }
                        // FIX AUDIT2 AGENT3 T-01: actualizar snapshot SOLO cuando el check
                        // corre (cada 250ms). Si se actualiza cada frame, tickDiff siempre
                        // seria ~33ms y el check nunca dispararia para jugadores activos.
                        g_AC_LastX[playerid] = curX;
                        g_AC_LastY[playerid] = curY;
                        g_AC_LastZ[playerid] = curZ;
                        g_AC_LastUpdate[playerid] = nowTick;
                }
                // FIX AUDIT AC-H10: re-inicializar snapshot si tickDiff >= 1000000 (16+ min AFK).
                // Antes: si tickDiff >= 1000000 (wrap de GetTickCount tras ~49 dias, o jugador
                // AFK 16+ min), ni el check ni la actualizacion del snapshot corrian, dejando
                // g_AC_LastUpdate frozen. El siguiente OnPlayerUpdate tendria tickDiff aun mayor,
                // y el anti-teleport quedaba permanentemente desactivado para ese jugador.
                // Ahora: si tickDiff >= 1000000, re-inicializar el snapshot sin checkear
                // (no se puede detectar teleport con un snapshot de 16+ min de antiguedad).
                else if(tickDiff >= 1000000)
                {
                        g_AC_LastX[playerid] = curX;
                        g_AC_LastY[playerid] = curY;
                        g_AC_LastZ[playerid] = curZ;
                        g_AC_LastUpdate[playerid] = nowTick;
                }
        }

        // === 2. ANTI-HEALTH HACK ===
        new Float:hp;
        GetPlayerHealth(playerid, hp);
        // FIX AUDIT5-FIX-Y: usar pState cacheado (L25408).
        if(hp > AC_MAX_HP && pState != PLAYER_STATE_WASTED) // FIX AUDIT AC-MEJORA2
        {
                // FIX VERIFY-DANODMG-1/2/3/4/5 CRIT-2/3/4: excepciones para estados
                // legitimos donde el servidor setea HP > 100 intencionalmente.
                // Sin estas excepciones, el AC kickea:
                //   - Jugadores heridos (HP=1000000 en OnPlayerDeath/OnPlayerTakeDamage)
                //   - Presos (HP=9999 en Checkjail cada 2s)
                //   - Admins nivel 1-2 en /duty (HP=9999)
                //   - Jugadores en HQ Safe Zones (HP=100000 en OnPlayerEnterDynamicArea)
                //   - Admins nivel 1-2 spectating (HP puede desincronizarse)
                new bool:acHpExempt = false;
                if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) acHpExempt = true;
                if(PlayerInfo[playerid][pjail] > 0) acHpExempt = true;
                if(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 3) acHpExempt = true; // FIX AUDIT CHAL CHAL-A2-03 (CRITICO): subir de admin 1+ a admin 3+
                if(pState == PLAYER_STATE_SPECTATING) acHpExempt = true; // FIX AUDIT5-FIX-Y: cached pState
                // HQ Safe Zones: verificar PVars de zona segura (cualquier HQ)
                // FIX VERIFY-DANODMG-FIX-4/5: agregar P0_REP2_InHQREP (Reporteros) y
                // P0_BEN_ZS_InHQ (Bennys) que faltaban en el fix inicial.
                if(GetPVarInt(playerid, "P0_5_InHQ") > 0 || GetPVarInt(playerid, "T0_2_InHQTransito") > 0 ||
                   GetPVarInt(playerid, "P0_FBI1_InHQFBI") > 0 || GetPVarInt(playerid, "P0_SWAT1_InHQSWAT") > 0 ||
                   GetPVarInt(playerid, "P0_EJ1_InHQEJ") > 0 || GetPVarInt(playerid, "P0_REP2_InHQREP") > 0 ||
                   GetPVarInt(playerid, "P0_BEN_ZS_InHQ") > 0) acHpExempt = true;
                // Hospital safe zone (interior 5)
                if(IsPlayerInDynamicArea(playerid, AreaHospital_SafeZone)) acHpExempt = true;

                if(!acHpExempt)
                {
                        new reason[80];
                        format(reason, sizeof(reason), "Health hack: HP=%.1f (max: 100)", hp);
                        AC_Alert(playerid, reason, 2); // kick directo
                        return 1;
                }
        }

        // === 3. ANTI-ARMOUR HACK ===
        new Float:armour;
        GetPlayerArmour(playerid, armour);
        // Paramedicos (Org 10) y Reporteros (Org 11) con /chaleco pueden tener hasta 100
        // Civiles y demas no deberian tener armadura sin chaleco
        if(armour > AC_MAX_ARMOUR) // FIX AUDIT AC-MEJORA2
        {
                // FIX VERIFY-DANODMG-1/3/4/5 CRIT-3: excepciones para estados legitimos
                // donde el servidor setea armour > 100 intencionalmente.
                new bool:acArmorExempt = false;
                if(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 3) acArmorExempt = true; // FIX AUDIT CHAL CHAL-A2-03: subir de admin 1+ a admin 3+
                if(pState == PLAYER_STATE_SPECTATING) acArmorExempt = true; // FIX AUDIT5-FIX-Y: cached pState
                if(!acArmorExempt)
                {
                        new reason[80];
                        format(reason, sizeof(reason), "Armour hack: Chaleco=%.1f (max: 100)", armour);
                        AC_Alert(playerid, reason, 2); // kick directo
                        return 1;
                }
        }
        // Si tiene armadura pero NO tiene permiso de chaleco, es hack
        if(armour > 0.0 && !g_ChalecoPermitido[playerid] && !g_ChalecoActivo[playerid])
        {
                // Excepcion: si esta en zona segura HQ (puede tener armadura temporal)
                // Excepcion: si es policia en servicio (Patrulha)
                // FIX VERIFY-DANODMG-4 CRIT-AC-2: excepcion para admin en servicio staff
                // (comandos /chalecome, /chalecostaff, /revivirme, /revivirstaff setean
                // armour sin g_ChalecoPermitido - ver fix en esos comandos).
                // FIX VERIFY-DANODMG-FIX-4/5: excepcion para HQ Safe Zones y Hospital
                // Safe Zone (no-Patrulha en HQ/Hospital no debe ser strikeado).
                if(!Patrulha[playerid] && !(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 1) &&
                   !(GetPVarInt(playerid, "P0_5_InHQ") > 0 || GetPVarInt(playerid, "T0_2_InHQTransito") > 0 ||
                     GetPVarInt(playerid, "P0_FBI1_InHQFBI") > 0 || GetPVarInt(playerid, "P0_SWAT1_InHQSWAT") > 0 ||
                     GetPVarInt(playerid, "P0_EJ1_InHQEJ") > 0 || GetPVarInt(playerid, "P0_REP2_InHQREP") > 0 ||
                     GetPVarInt(playerid, "P0_BEN_ZS_InHQ") > 0) &&
                   !IsPlayerInDynamicArea(playerid, AreaHospital_SafeZone))
                {
                        new reason[80];
                        format(reason, sizeof(reason), "Armour sin permiso: Chaleco=%.1f (sin /chaleco)", armour);
                        AC_Alert(playerid, reason, 1); // strike (puede ser lag de sincronizacion)
                        SetPlayerArmour(playerid, 0.0); // resetear
                }
        }

        // === 4. ANTI-WEAPON HACK ===
        // FIX AUDIT AGENT1 WC-01: antes solo se checkeaba GetPlayerWeapon (arma EN MANO).
        // Un hacker podia tener una minigun en el slot 7 y usar una pistol en el slot 0,
        // y el AC nunca la detectaba. Fix: iterar TODOS los 13 slots y validar cada
        // weaponid contra AC_IsWeaponAllowed. Si se detecta arma prohibida en cualquier
        // slot, kick directo.
        new curWeapon = GetPlayerWeapon(playerid);
        if(curWeapon > 0 && !AC_IsWeaponAllowed(playerid, curWeapon))
        {
                new wname[32], reason[128];
                GetWeaponName(curWeapon, wname, sizeof(wname));
                format(reason, sizeof(reason), "Weapon hack: %s (ID:%d) no permitida", wname, curWeapon);
                AC_Alert(playerid, reason, 2); // kick directo
                return 1;
        }
        // Check adicional: iterar todos los 13 slots para detectar armas prohibidas
        // en slots no equipados (slot != currentWeaponSlot).
        // FIX AUDIT5-FIX-Y: UNIFICAR los 2 loops (blocklist + tracking strict) en 1 solo.
        // Antes: 2 loops * 13 slots * GetPlayerWeaponData = 26 natives/invocation.
        // Ahora: 1 loop * 13 slots = 13 natives/invocation. Ahorro 50% en este check
        // = 117,000 fewer natives/sec a 300p * 30Hz (OnPlayerUpdate rate).
        // Logica preservada: el check 1 (blocklist) corre primero y retorna si detecta
        // arma prohibida; solo si pasa el blocklist (AC_IsWeaponAllowed = true) se
        // ejecuta el check 2 (tracking strict). Equivalente a los 2 loops originales.
        // FIX AUDIT AGENT1 WC-01 FULL: validacion estricta slot-por-slot contra
        // tracking server-side.
        // FIX AUDIT2 AGENT1 R-1 (W-02): el strict check corre SIEMPRE (no condicionado
        // a g_PlayerWeaponsSynced). Si tracking esta vacio (synced=false) y el cliente
        // tiene un arma NO en blocklist -> kick (es cheat). SetSpawnInfo usa 0 weapons
        // en todos los paths, asi que falsos positivos son practicamente nulos.
        // Nota: NO remover la variable g_PlayerWeaponsSynced - solo el if que la
        // condicionaba (en el codigo pre-AUDIT5-FIX-Y). La variable sigue usandose en
        // GivePlayerWeaponTracking/ResetPlayerWeaponsTracking/CarregarArmas/OnPlayerDeath.
        // FIX AUDIT AC-MEJORA1: throttle del loop de 13 slots a 6Hz (cada 5 updates).
        // El check de arma EN MANO (GetPlayerWeapon, arriba) sigue a 30Hz para deteccion
        // inmediata de armas prohibidas equipadas. El loop de 13 slots solo corre cada
        // 5 updates porque detectar armas en slots no equipados no necesita ser instantaneo
        // (el hacker no puede usar un arma sin equiparla, y al equiparla el check de
        // GetPlayerWeapon a 30Hz lo detecta).
        g_AC_UpdateCount[playerid]++;
        if(g_AC_UpdateCount[playerid] >= AC_WEAPON_CHECK_INTERVAL)
        {
                g_AC_UpdateCount[playerid] = 0;
        {
                new slotWid, slotAmmo;
                for(new s = 0; s < 13; s++)
                {
                        GetPlayerWeaponData(playerid, s, slotWid, slotAmmo);
                        if(slotWid > 0 && slotAmmo > 0)
                        {
                                // Check 1: blocklist - si el arma NO esta permitida, kick directo.
                                if(!AC_IsWeaponAllowed(playerid, slotWid))
                                {
                                        new wname[32], reason[128];
                                        GetWeaponName(slotWid, wname, sizeof(wname));
                                        format(reason, sizeof(reason), "Weapon hack en slot %d: %s (ID:%d) no permitida", s, wname, slotWid);
                                        AC_Alert(playerid, reason, 2); // kick directo
                                        return 1;
                                }
                                // Check 2: tracking strict - solo corre si el blocklist paso
                                // (es decir, AC_IsWeaponAllowed devolvio true arriba). Si el
                                // tracking no tiene esta arma en este slot, es cheat spawnado
                                // (M4, AK-47, Sniper, Desert Eagle no estan en blocklist pero
                                // tampoco en tracking si el jugador las spawnÃ¯Â¿Â½).
                                // Verificar si esta en el blocklist (ya kickeado arriba, pero
                                // doble check por si acaso)
                                if(g_PlayerWeapons[playerid][s][0] != slotWid)
                                {
                                        if(AC_IsWeaponAllowed(playerid, slotWid))
                                        {
                                                // Arma NO prohibida pero NO en tracking = cheat spawnado
                                                // (ej. M4, AK-47, Sniper que no estan en blocklist)
                                                new wname[32], reason[128];
                                                GetWeaponName(slotWid, wname, sizeof(wname));
                                                format(reason, sizeof(reason), "Weapon hack: %s (ID:%d) spawnada sin autorizacion server-side", wname, slotWid);
                                                AC_Alert(playerid, reason, 2); // kick directo
                                                return 1;
                                        }
                                }
                                // Si el tracking tiene la misma arma pero menos ammo, podria ser
                                // que el jugador disparo (ammo bajo). Si tiene MAS ammo que el
                                // tracking, es hack de ammo. Tolerancia +2 por lag (FIX AC-H19).
                                else if(slotWid == g_PlayerWeapons[playerid][s][0]
                                        // FIX AUDIT AC-H19: tolerancia reducida de +5 a +2.
                                        // Antes: +5 balas de tolerancia permitian a un hacker
                                        // tener 5 balas extra por slot sin deteccion. El lag real
                                        // de sincronizacion de ammo es < 1 bala, asi que +2 es
                                        // suficiente margen. +3 o mas = ammo hack confirmado.
                                        && slotAmmo > g_PlayerWeapons[playerid][s][1] + 2)
                                {
                                        new wname[32], reason[128];
                                        GetWeaponName(slotWid, wname, sizeof(wname));
                                        format(reason, sizeof(reason), "Ammo hack: %s tiene %d balas (server autorizo %d)",
                                                wname, slotAmmo, g_PlayerWeapons[playerid][s][1]);
                                        AC_Alert(playerid, reason, 2); // kick directo
                                        return 1;
                                }
                        }
                }
        }
        } // FIX AUDIT AC-MEJORA1: cierre del throttle if (cada 5 updates)

        // === 5. ANTI-JETPACK HACK ===
        // FIX AUDIT5-FIX-Y: usar pSpecialAction cacheado (L25410) en vez de GetPlayerSpecialAction.
        if(pSpecialAction == SPECIAL_ACTION_USEJETPACK)
        {
                // FIX VERIFY-DANODMG-5 CRIT-4: admins nivel 1-2 en servicio staff
                // pueden usar /jetpack (ver CMD:jetpack). Antes el AC los kickeaba.
                if(!(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 1))
                {
                        AC_Alert(playerid, "Jetpack sin permiso", 2); // kick directo
                        return 1;
                }
        }

        // === 5b. ANTI-AIRBREAK (TP-06) ===
        // Verificar que un jugador a pie (sin vehiculo, sin jetpack)
        // no tenga Z sostenida en aire. Si Z > 50m sobre el suelo Y no esta cayendo
        // (Z velocity ~0 o positiva sostenida), es airbreak.
        // NOTA: SA-MP 0.3.7 NO define SPECIAL_ACTION_USEPARACHUTE. Para no detectar
        // falsos positivos en paracaidistas, ajustamos el threshold de vz a 0.05
        // (un paracaidista tiene vz ligeramente negativo, ~-0.01 a -0.05).
        // Un airbreak hover tiene vz ~0.000.
        // Skip si esta spectating/wasted/herido/preso/algemado (estados legitimos congelados).
        // FIX AUDIT5-FIX-Y: usar vars cacheadas (pInVeh, pState, pSpecialAction) en vez
        // de volver a llamar las natives. Ademas anadir `curZ > 100.0` early-out: con
        // el threshold Z > 100m (fix X-01), no hay forma de airbreak a <100m, asi que
        // saltamos TODO el bloque (no fetch velocity, no floatsqroot, no inner if).
        // pVelX/Y/Z ya estan cacheados al inicio (L25413-25417) bajo las mismas
        // condiciones del outer if (!pInVeh && pState == PLAYER_STATE_ONFOOT), asi que
        // son validos dentro del bloque.
        if(!pInVeh
           && pState == PLAYER_STATE_ONFOOT
           && pSpecialAction != SPECIAL_ACTION_USEJETPACK
           && curZ > 100.0
           && MinutosMorte[playerid] == 0 && SegundosMorte[playerid] == 0
           && PlayerInfo[playerid][pjail] == 0
           && !PlayerInfo[playerid][pCongelado]
           && !IsAssistindo[playerid]
           && !(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 1))
        {
                // FIX AUDIT2 AGENT3 T-13: reusar curX/curY/curZ (ya fetched al inicio
                // de OnPlayerUpdate L25091) en vez de llamar GetPlayerPos otra vez.
                // FIX AUDIT5-FIX-Y: usar pVelX/Y/Z cacheados (L25413-25417) en vez de
                // llamar GetPlayerVelocity otra vez. Cache poblado por el bloque L25414-25417.
                new Float:vhorizontal = floatsqroot(pVelX*pVelX + pVelY*pVelY);
                // Airbreak = hover: Z alta, sin movimiento horizontal, vz casi 0.
                // Paracaidista tiene vz ~-0.01 a -0.05 (cayendo lentamente).
                // Threshold |vz| < 0.005 captura solo hover puro (no paracaidas).
                // FIX AUDIT2 AGENT5 X-01: threshold Z subido de 50 a 100m. Edificios
                // nativos de LS (LS Tower) llegan a ~80m. Azoteas legÃ¯Â¿Â½timas a 51-80m
                // causaban falsos positivos. Con rate-limit en AC_Alert (T-03 fix),
                // 1 strike/seg = 3 strikes en 3s = kick. Subir a 100m evita edificios
                // nativos. Airbreakers reales vuelan tÃ¯Â¿Â½picamente a >100m.
                // (curZ > 100.0 ya garantizado por el outer if, se mantiene por defense-in-depth.)
                if(curZ > AC_AIRBREAK_MIN_Z && floatabs(pVelZ) < AC_AIRBREAK_MAX_VZ && vhorizontal < AC_AIRBREAK_MAX_VH // FIX AUDIT AC-MEJORA2
                   && gettime() - GetPVarInt(playerid, "ACTPImmune") > 5
                   && gettime() - GetPVarInt(playerid, "HospitalTPCooldown") > 3) // FIX AUDIT AC-H3: 10s -> 3s
                {
                        // Solo alertar (strike, no kick directo) - podria ser falso positivo
                        // en azoteas legitimas (edificios mapeados). El strike acumula.
                        new reason[128];
                        format(reason, sizeof(reason), "Posible airbreak: Z=%.1f vH=%.2f vZ=%.2f (hover en aire)", curZ, vhorizontal, pVelZ);
                        AC_Alert(playerid, reason, 1); // strike
                }
        }

        // === 5c. ANTI-ON-FOOT-SPEEDHACK (TP-14) ===
        // GetPlayerVelocity nunca se usaba. Speedhack on-foot indetectable hasta 50m/s.
        // Sprint normal = ~0.07 raw, speedhack = > 0.5.
        // Skip si esta en vehiculo (lo cubre el check 6 abajo) o estados congelados.
        // FIX AUDIT5-FIX-Y: usar vars cacheadas (pInVeh, pState, pVelX/Y/Z) en vez de
        // 3 natives inline (IsPlayerInAnyVehicle, GetPlayerState, GetPlayerVelocity).
        // pVelX/Y/Z ya estan cacheados (L25413-25417) bajo las mismas condiciones del
        // outer if (!pInVeh && pState == PLAYER_STATE_ONFOOT).
        if(!pInVeh
           && pState == PLAYER_STATE_ONFOOT
           && !(pJogando[playerid] == false && PlayerInfo[playerid][pAdmin] >= 1))
        {
                new Float:ospeed = floatsqroot(pVelX*pVelX + pVelY*pVelY + pVelZ*pVelZ);
                // Sprint normal max ~0.12 (con anim de corrida). Umbral 0.5 = ~4x sprint.
                // FIX AUDIT2 AGENT3 T-02 + AGENT5 X-02: condicion INVERTIDA. Antes era
                // `vz < 0.0` (cayendo) lo que disparaba en caidas legitimas (paracaidistas,
                // saltos desde altura, caer de moto). Kick falso en ~100ms. Fix: invertir
                // a `vz >= 0.0` (subiendo o estacionario = speedhack horizontal/vertical
                // sin motivo legitimo). Ademas anyadir rate-limit (ver AC_Alert fix X-04)
                // para evitar 3 strikes en 100ms = kick.
                if(ospeed > AC_SPEEDHACK_ONFOOT && pVelZ >= 0.0) // FIX AUDIT AC-MEJORA2
                {
                        new reason[128];
                        format(reason, sizeof(reason), "On-foot speedhack: velocidad=%.2f vZ=%.2f (max normal: 0.12)", ospeed, pVelZ);
                        AC_Alert(playerid, reason, 1); // strike (puede ser lag)
                }
        }

        // === 6. ANTI-SPEEDHACK (vehiculo) ===
        // FIX AUDIT2 AGENT3 T-05 + T-06 + T-12:
        // T-05: floatpower(x, 2) cambiado a (x*x) por performance (10x mas rapido),
        // consistente con TP-04 (anti-teleport ya migrado).
        // T-06: ahora cubre DRIVER Y PASSENGER (antes solo DRIVER, pasajeros
        // speedhackers indetectables).
        // T-12: aviones (Hydra=520, Rustler=476, Shamal=519, Nevada=513, AT-400=577,
        // Cropduster=512, Stuntplane=513, Dodo=593) exentos - velocidad max legitima
        // alta. Threshold subido a 2.0 para cubrir Infernus/NRG con nitro + aviones.
        // FIX AUDIT5-FIX-Y: usar vars cacheadas (pInVeh, pState) en vez de 3 natives.
        if(pInVeh
           && (pState == PLAYER_STATE_DRIVER || pState == PLAYER_STATE_PASSENGER))
        {
                new vehid = GetPlayerVehicleID(playerid);
                new Float:vx, Float:vy, Float:vz;
                GetVehicleVelocity(vehid, vx, vy, vz);
                new Float:speed = floatsqroot(vx*vx + vy*vy + vz*vz);
                new vehModel = GetVehicleModel(vehid);
                // Verificar si es avion/helicoptero (modelos 417-435, 460-469, 476, 487-488, 497, 511-513, 519, 520, 548, 553, 577, 592-593)
                new bool:isAircraft = false;
                if(vehModel >= 417 && vehModel <= 435) isAircraft = true;
                if(vehModel >= 460 && vehModel <= 469) isAircraft = true;
                if(vehModel == 476 || vehModel == 487 || vehModel == 488 || vehModel == 497) isAircraft = true;
                if(vehModel >= 511 && vehModel <= 520) isAircraft = true;
                if(vehModel == 548 || vehModel == 553 || vehModel == 577) isAircraft = true;
                if(vehModel >= 592 && vehModel <= 593) isAircraft = true;
                // Threshold: aviones 2.5 (cubre Hydra max ~2.0), vehiculos terrestres 1.5
                // FIX AUDIT AC-H13: subir threshold vehicular de 1.5 a 2.0.
                // Antes: 1.5 no cubria Infernus/NRG con nitro (~1.76-2.35 de |v|).
                // Falsos positivos: jugadores legÃ¯Â¿Â½timos con Infernus nitro kickeados.
                // Ahora: 2.0 cubre Infernus/NRG con nitro (deja margen para lag).
                // Aircraft sigue en 2.5 (no se modifica).
                new Float:maxSpeed = AC_SPEEDHACK_VEH; // FIX AUDIT AC-MEJORA2
                if(isAircraft) maxSpeed = AC_SPEEDHACK_AIRCRAFT;
                if(speed > maxSpeed)
                {
                        new reason[100];
                        format(reason, sizeof(reason), "Speedhack vehicular: velocidad=%.2f (max: %.1f, modelo %d%s)", speed, maxSpeed, vehModel, isAircraft ? " [aircraft]" : "");
                        AC_Alert(playerid, reason, 1); // strike
                        // Reducir velocidad (solo si es driver, no passenger)
                        // FIX AUDIT5-FIX-Y: usar pState cacheado en vez de GetPlayerState.
                        if(pState == PLAYER_STATE_DRIVER)
                                SetVehicleVelocity(vehid, vx * 0.5, vy * 0.5, vz * 0.5);
                }
        }

        // === 7. ANTI-MONEY HACK ===
        // El TimerHack ya sincroniza el dinero cada 1s, pero verificamos en OnPlayerUpdate tambien
        // FIX VERIFY-MONEYAC: threshold escalado + grace window + rate limit + reset autoritario.
        //   - Grace window de 2s (PVar "AC_MoneyChangeTime"): transacciones legitimas grandes
        //     (PayDay, compra de casa $500k, /dardinero admin) setean este PVar antes de
        //     modificar pDinheiro, para que OnPlayerUpdate no las detecte como hack.
        //   - Rate limit de 30s (PVar "AC_LastMoneyAlert"): evita spamear AC_Alert si el
        //     hacker setea dinero hackeado repetidamente.
        //   - Threshold escalado: delta > $100k = kick sev=2; delta > $10k = strike sev=1.
        //   - Reset autoritario: SIEMPRE re-sync el cliente con pDinheiro (server-side).
        new curMoney = GetPlayerMoney(playerid);
        if(curMoney != PlayerInfo[playerid][pDinheiro])
        {
                new diff = curMoney - PlayerInfo[playerid][pDinheiro];
                new now = gettime();
                new lastChange = GetPVarInt(playerid, "AC_MoneyChangeTime");
                new lastAlert = GetPVarInt(playerid, "AC_LastMoneyAlert");
                // Grace window: si hubo cambio legitimo en los ultimos 2s, no alertar
                new bool:inGraceWindow = (now - lastChange) <= 2;
                // Rate limit: si ya se alerto en los ultimos 30s, no volver a alertar
                new bool:alertCooldown = (now - lastAlert) < 30;

                // Siempre re-sync (reset autoritario) sin importar grace window
                ResetPlayerMoney(playerid);
                GivePlayerMoney(playerid, PlayerInfo[playerid][pDinheiro]);

                if(!inGraceWindow)
                {
                        // Delta positivo grande = hack obvio (cliente tiene mas dinero que server)
                        // FIX SPRINT3 M-32: bajar umbral de kick de $100k a $50k.
                        // Antes: diffs $5k-$100k pasaban desapercibidos. Un actor malicioso podia
                        // inflar $50k por transaccion sin ser kickeado, solo strikeado ($10k+).
                        // Ahora: $50k+ = kick, $5k+ = strike.
                        if(diff > AC_MONEY_KICK_THRESHOLD) // FIX AUDIT AC-MEJORA2
                        {
                                if(!alertCooldown)
                                {
                                        new reason[160];
                                        format(reason, sizeof(reason), "Money hack: dinero=%d (esperado=%d, diff=+%d)", curMoney, PlayerInfo[playerid][pDinheiro], diff);
                                        AC_Alert(playerid, reason, 2); // kick directo
                                        SetPVarInt(playerid, "AC_LastMoneyAlert", now);
                                        return 1;
                                }
                        }
                        else if(diff > AC_MONEY_STRIKE_THRESHOLD) // FIX AUDIT AC-MEJORA2
                        {
                                if(!alertCooldown)
                                {
                                        new reason[160];
                                        format(reason, sizeof(reason), "Money hack sospechoso: dinero=%d (esperado=%d, diff=+%d)", curMoney, PlayerInfo[playerid][pDinheiro], diff);
                                        AC_Alert(playerid, reason, 1); // strike
                                        SetPVarInt(playerid, "AC_LastMoneyAlert", now);
                                }
                        }
                        // FIX AUDIT AC-H18: strikear delta negativo > $100k (posible dupe inverso).
                        // Antes: solo logueaba (printf INFO), no strikeaba. Un hacker que
                        // encontraba la forma de decrementar dinero client-side podria estar
                        // intentando un dupe inverso (reducir dinero client para que el
                        // servidor lo "corrija" a un valor mas alto).
                        // Ahora: strike (severity=1) para delta negativo > $100k. El strike
                        // acumula y a 3 strikes = kick automatico.
                        else if(diff < -AC_MONEY_NEG_THRESHOLD) // FIX AUDIT AC-MEJORA2
                        {
                                if(!alertCooldown)
                                {
                                        new reason[160];
                                        format(reason, sizeof(reason), "Money hack (delta negativo): dinero=%d (esperado=%d, diff=%d)", curMoney, PlayerInfo[playerid][pDinheiro], diff);
                                        AC_Alert(playerid, reason, 1); // strike
                                        SetPVarInt(playerid, "AC_LastMoneyAlert", now);
                                }
                        }
                }
                else
                {
                        // FIX SPRINT3 B-18: incluso en grace window, kick si diff > $100k.
                        // FIX AUDIT AC-H17: umbral bajado de $1M a $100k.
                        // Antes: $1M+ siempre era hack obvio. Pero $999,999 en grace window
                        // NO era detectado (bypass: hacker con grace window podia inflar
                        // $999k sin ser kickeado). Ahora: $100k+ en grace window = kick.
                        // Las transacciones legitimas grandes (PayDay, compra casa) setean
                        // el PVar AC_MoneyChangeTime ANTES de modificar pDinheiro, asi que
                        // el diff en grace window sera 0 (cliente y server sincronizados).
                        // Solo un hacker que no setea el PVar tendra diff > 0 en grace.
                        if(diff > AC_MONEY_GRACE_KICK) // FIX AUDIT AC-MEJORA2
                        {
                                new reason[160];
                                format(reason, sizeof(reason), "Money hack severo en grace window: dinero=%d (esperado=%d, diff=+%d)", curMoney, PlayerInfo[playerid][pDinheiro], diff);
                                AC_Alert(playerid, reason, 2); // kick directo
                                SetPVarInt(playerid, "AC_LastMoneyAlert", now);
                                return 1;
                        }
                }
        }

        return 1;
}

