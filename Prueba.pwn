// =====================================================================
// P0-TERRITORIO: Sistema de Territorios Conquistables.
// 8 zonas del mapa que las bandas ilegales pueden conquistar y controlar.
// =====================================================================
#define MAX_TERRITORIOS 8
#define TERR_FILE "Territorios.ini"
#define TERR_CONQUISTA_TIEMPO 300     // 5 minutos (300 segundos) de presencia
#define TERR_GUERRA_TIEMPO 900        // 15 minutos (900 segundos) de guerra
#define TERR_PICKUP_COOLDOWN 1800     // 30 minutos (1800 segundos) entre usos del pickup
#define TERR_DECOMISO_CAPTURAS 3      // 3 capturas para decomisar territorio
