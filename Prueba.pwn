// FIX AUDIT PESCADOR P-A2-01: Trackear timers Pesca e IniciarPescaInv para poder matarlos.
// Antes: SetTimerEx fire-and-forget sin guardar el ID. Si el jugador desconectaba/moria/
// salia del trabajo en los 10s del timer, el callback dispara sobre el nuevo slot reusado.
// Ahora: variables per-player para matarlos en flush paths.
new g_PescaTmr[MAX_PLAYERS] = -1;
new g_IniciarPescaInvTmr[MAX_PLAYERS] = -1;

// FIX AUDIT MINERO M-A1-01 + M-A2-03: Trackear timers Minerar y Minando.
// Antes: fire-and-forget sin guardar ID. Si el jugador desconectaba/moria/salia
// del trabajo en los 10s del timer Minerar, el callback dispara sobre el nuevo
// slot reusado. Ademas, /fixme no los mata -> exploit dupe /minar + /fixme + /minar.
new g_MinerarTmr[MAX_PLAYERS] = -1;
new g_MinandoTmr[MAX_PLAYERS] = -1;
// FIX AUDIT CARNICERO C-A1-03: Trackear timer Desossar.
new g_DesossarTmr[MAX_PLAYERS] = -1;

// FIX: Sistema de racha, fatiga, eventos y sonido para Minero.
new g_RocaCounter[MAX_PLAYERS] = 0;        // Contador de rocas seguidas sin desconectarse
new g_FatigaMinero[MAX_PLAYERS] = 0;        // Contador de fatiga (despues de 10 rocas)
new g_SonidoMineroTmr[MAX_PLAYERS] = -1;    // Timer de sonido de picar
// FIX: Sistema de acumulacion de rocas (max 15 antes de vender).
new g_RocasAcumuladas[MAX_PLAYERS] = 0;     // Rocas acumuladas sin vender (max 15)
#define MINERO_MAX_ROCAS 15                  // Maximo de rocas acumulables antes de vender
#define MINERO_SONIDO_INTERVAL 2000         // Sonido cada 2s
#define MINERO_FATIGA_LIMITE 10             // Despues de 10 rocas, fatiga
#define MINERO_FATIGA_TIEMPO 50000          // 50s con fatiga (normal 40s)
#define MINERO_RACHA_LIMITE 10               // 10 rocas seguidas = bonus
#define MINERO_RACHA_BONUS 50                // +50% bonus en la roca 10

// FIX AUDIT PESCADOR P-A2-01: helper para matar ambos timers Pesca.
// Llamar en: FlushPlayerJobs, OnPlayerSpawn, OnPlayerDeath, /fixme, /salirtrabajo.
stock Pesca_KillTimers(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(g_PescaTmr[playerid] != -1) { KillTimer(g_PescaTmr[playerid]); g_PescaTmr[playerid] = -1; }
        if(g_IniciarPescaInvTmr[playerid] != -1) { KillTimer(g_IniciarPescaInvTmr[playerid]); g_IniciarPescaInvTmr[playerid] = -1; }
        // FIX AUDIT MINERO M-A1-01 + M-A2-03: matar timers Minero tambiÃ¯Â¿Â½n.
        if(g_MinerarTmr[playerid] != -1) { KillTimer(g_MinerarTmr[playerid]); g_MinerarTmr[playerid] = -1; }
        if(g_MinandoTmr[playerid] != -1) { KillTimer(g_MinandoTmr[playerid]); g_MinandoTmr[playerid] = -1; }
        // FIX AUDIT CARNICERO C-A1-03: matar timer Desossar.
        if(g_DesossarTmr[playerid] != -1) { KillTimer(g_DesossarTmr[playerid]); g_DesossarTmr[playerid] = -1; }
        // FIX: matar sonido de minero.
        Minero_KillSonido(playerid);
        return 1;
}

// MEJORA 2: Log de pesca para auditorÃ¯Â¿Â½a econÃ¯Â¿Â½mica.
// Registra cada pesca exitosa en logs/pesca_DD-MM-AAAA.txt para detectar farmers masivos.
// Formato: [HH:MM:SS] PlayerName(playerid) pesco N x itemID (IP: x.x.x.x)
stock Pesca_Log(playerid, pezModel, cantidad)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        new log[256], logPath[64], pIP[36];
        new year, month, day, hour, minute, second;
        getdate(year, month, day);
        gettime(hour, minute, second);
        GetPlayerIp(playerid, pIP, sizeof(pIP));
        format(logPath, sizeof(logPath), "logs/pesca_%d-%02d-%02d.txt", year, month, day);
        format(log, sizeof(log), "[%02d:%02d:%02d] %s(%d) pesco %d x item %d (IP: %s)\r\n",
                hour, minute, second, PlayerName(playerid), playerid, cantidad, pezModel, pIP);
        new File:f = fopen(logPath, io_append);
        if(f)
        {
                fwrite(f, log);
                fclose(f);
        }
        return 1;
}

// FIX P-A5-01: Helper unificado para venta de recursos (peces, minerales, etc.).
// Antes: las 4 cases de venta de peces (902, 19630, 1603, 1608) eran copias idÃ¯Â¿Â½nticas
// variando solo modelid, precioBase y nombre. ~80 lÃ¯Â¿Â½neas duplicadas. Si habia un bug,
// habia que tocar 4 sitios. Ahora: 1 helper + 4 llamadas de 1 lÃ¯Â¿Â½nea.
// Beneficio: fix futuro en 1 sitio, -80 lÃ¯Â¿Â½neas, reusable para Minero/Carnicero.
// Orden anti-dupe: SalvarInventario PRIMERO (decrementa item), SalvarDados DESPUES (acredita dinero).
stock VenderRecurso(playerid, modelid, quantia, precioBase, const nombrePlural[])
{
        // FIX AUDIT INV I5-1 (parcial): `modelid` aqui es en realidad un slot index (1..32),
        // no un itemid. El caller (FuncaoItens case 902/1603/1608/19630 L11691+) pasa el
        // slot index del inventario, no el itemid. NO se renombra aqui para minimizar
        // riesgo de romper callers externos, pero el contrato es: modelid = slot index.
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        // MEJORA 3: validar pProfissao == 1 (Pescador) para vender peces.
        if(PlayerInfo[playerid][pProfissao] != 1) return ErrorMsg(playerid, "Solo los Pescadores pueden vender peces.");
        if(PlayerInventario[playerid][modelid][Unidades] < quantia) return ErrorMsg(playerid, "Usted no posee la cantidad colocada.");
        // MEJORA 3: ErrorMsg si no estÃ¯Â¿Â½ en el mercado de pescados.
        if(!PlayerToPoint(3.0, playerid, 163.968444, -1941.403564, 3.773437)) return ErrorMsg(playerid, "No estas en el mercado de pescados.");
        // Decrementar item del inventario
        PlayerInventario[playerid][modelid][Unidades] -= quantia;
        // Calcular precio (VIP x2)
        new precio = (PlayerInfo[playerid][pVIP] >= 1) ? (precioBase*quantia*2) : (precioBase*quantia);
        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
        AC_AddPlayerMoney(playerid, precio);
        format(Str, sizeof(Str), "Vendiste %d %s y ganaste $%i.", quantia, nombrePlural, precio);
        SuccesMsg(playerid, Str);
        AtualizarInventario(playerid, modelid);
        // FIX VP-A4-01: orden anti-dupe. SalvarInventario PRIMERO, SalvarDados DESPUES.
        // Antes: SalvarDados PRIMERO acreditaba dinero, SalvarInventario DESPUES decrementaba item.
        // Si crash entre ambos: dinero persistido + item NO decrementado = DUPE.
        // Ahora: item decrementado PRIMERO, dinero acreditado DESPUES. Si crash: item perdido
        // (perdida para el jugador) pero NO dup (mas seguro para economia).
        SalvarInventario(playerid); SalvarDados(playerid);
        return 1;
}

// FIX M-A5-01: Helper para venta de minerales con precio aleatorio entre min y max.
stock VenderRecursoMinero(playerid, modelid, quantia, precioMin, precioMax, const nombre[])
{
        // FIX AUDIT INV I5-1 (parcial): `modelid` aqui es en realidad un slot index (1..32),
        // no un itemid. El caller (FuncaoItens case 19177/19181/19180/19179 L11670+) pasa
        // el slot index del inventario. NO se renombra aqui para minimizar riesgo de
        // romper callers externos, pero el contrato es: modelid = slot index.
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(PlayerInfo[playerid][pProfissao] != 2) return ErrorMsg(playerid, "Solo los Mineros pueden vender minerales.");
        if(PlayerInventario[playerid][modelid][Unidades] < quantia) return ErrorMsg(playerid, "No tienes la cantidad ingresada.");
        if(!PlayerToPoint(3.0, playerid, 820.981384, 858.453857, 12.046875)) return ErrorMsg(playerid, "No estas en el punto de venta de minerales.");
        PlayerInventario[playerid][modelid][Unidades] -= quantia;
        // FIX: precio aleatorio entre min y max por unidad.
        new precioUnit = precioMin + random(precioMax - precioMin + 1);
        new precio = (PlayerInfo[playerid][pVIP] >= 1) ? (precioUnit*quantia*2) : (precioUnit*quantia);
        AC_AddPlayerMoney(playerid, precio);
        format(Str, sizeof(Str), "Vendiste %d %s a $%i c/u. Total: $%i.", quantia, nombre, precioUnit, precio);
        SuccesMsg(playerid, Str);
        AtualizarInventario(playerid, modelid);
        SalvarInventario(playerid); SalvarDados(playerid);
        return 1;
}

