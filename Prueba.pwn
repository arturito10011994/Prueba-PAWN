stock todastextdraw(playerid)
{
        // FIX AUDIT LOGIN F3-7: nota de optimizacion (lazy load futuro).
        // Esta funcion crea ~250 PlayerTextDraws por jugador en una sola
        // llamada. Se ejecuta en OnPlayerConnect (L22335) para TODOS los
        // jugadores conectados. Con 50 jugadores conectando a la vez, son
        // 50 * 250 = 12500 CreatePlayerTextDraw en un solo tick = lag spike.
        // Optimizacion recomendada (F3-7 v2, fuera de alcance de esta fase):
        //   1. Separar todastextdraw en 5-7 funciones por categoria:
        //      - LoadLoginTDs(playerid): textdraws de login (50)
        //      - LoadHudTDs(playerid): HUD general (40)
        //      - LoadInventoryTDs(playerid): inventario (50)
        //      - LoadVehicleTDs(playerid): vehiculos (30)
        //      - LoadMedicalTDs(playerid): sistema medico (40)
        //      - LoadJobsTDs(playerid): trabajos (40)
        //   2. En OnPlayerConnect, solo llamar LoadLoginTDs (50 textdraws).
        //   3. Las demas se cargan on-demand cuando el jugador abre el
        //      inventario, sube a un vehiculo, etc.
        //   4. Si el jugador se desconecta sin haber abierto el inventario,
        //      se ahorran 50 CreatePlayerTextDraw.
        // Por ahora, mantenemos todastextdraw como esta (no romper nada).
        // Si se aplica F3-7 v2, recordar destruir las textdraws al cerrar
        // cada categoria (ej: al cerrar inventario, destruir las 50 TDs).
        //
        TelaMorteCDA[playerid][0] = CreatePlayerTextDraw(playerid, -7.500000, 0.416687, "box");
        PlayerTextDrawLetterSize(playerid, TelaMorteCDA[playerid][0], 0.000000, 49.625000);
        PlayerTextDrawTextSize(playerid, TelaMorteCDA[playerid][0], 672.000000, 0.000000);
        PlayerTextDrawAlignment(playerid, TelaMorteCDA[playerid][0], 1);
        PlayerTextDrawColor(playerid, TelaMorteCDA[playerid][0], -1);
        PlayerTextDrawUseBox(playerid, TelaMorteCDA[playerid][0], 1);
        PlayerTextDrawBoxColor(playerid, TelaMorteCDA[playerid][0], 1258324525);
        PlayerTextDrawSetShadow(playerid, TelaMorteCDA[playerid][0], 0);
        PlayerTextDrawSetOutline(playerid, TelaMorteCDA[playerid][0], 0);
        PlayerTextDrawBackgroundColor(playerid, TelaMorteCDA[playerid][0], 255);
        PlayerTextDrawFont(playerid, TelaMorteCDA[playerid][0], 1);
        PlayerTextDrawSetProportional(playerid, TelaMorteCDA[playerid][0], 1);
        PlayerTextDrawSetShadow(playerid, TelaMorteCDA[playerid][0], 0);

        TelaMorteCDA[playerid][1] = CreatePlayerTextDraw(playerid, 338.374938, 365.732666, "box");
        PlayerTextDrawLetterSize(playerid, TelaMorteCDA[playerid][1], 0.000000, 1.062500);
        PlayerTextDrawTextSize(playerid, TelaMorteCDA[playerid][1], 371.199890, 0.000000);
        PlayerTextDrawAlignment(playerid, TelaMorteCDA[playerid][1], 1);
        PlayerTextDrawColor(playerid, TelaMorteCDA[playerid][1], -1);
        PlayerTextDrawUseBox(playerid, TelaMorteCDA[playerid][1], 1);
        PlayerTextDrawBoxColor(playerid, TelaMorteCDA[playerid][1], -1811885057);
        PlayerTextDrawSetShadow(playerid, TelaMorteCDA[playerid][1], 0);
        PlayerTextDrawSetOutline(playerid, TelaMorteCDA[playerid][1], 0);
