                                        ShowPlayerDialog(playerid, DIALOG_MECANICANITRO, DIALOG_STYLE_LIST, "Central de Bennys", menustr5, "Confirmar", "X");
                                }
                                if(listitem == 4)
                                {
                                        AddVehicleComponent(wVeiculo,1087);
                                        SuccesMsg(playerid, "Suspencion Adicionada");
