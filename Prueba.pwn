}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
        // P0-MERCADO-NEGRO: handler de compra de herramientas
        if(dialogid == DIALOG_MERCADO_NEGRO)
        {
                if(!response) return 1;
                if(listitem == 0) // Ganzua - $4,000
                {
                        if(PlayerInfo[playerid][pDinheiro] < 4000) return ErrorMsg(playerid, "No tienes $4,000.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -4000);
                        GanharItem(playerid, ITEM_GANZUA, 1);
                        SuccesMsg(playerid, "Compraste una Ganzua por $4,000.");
                }
                else if(listitem == 1) // Taladro - $10,000
                {
                        if(PlayerInfo[playerid][pDinheiro] < 10000) return ErrorMsg(playerid, "No tienes $10,000.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -10000);
                        GanharItem(playerid, ITEM_TALADRO, 1);
                        SuccesMsg(playerid, "Compraste un Taladro por $10,000.");
                }
                else if(listitem == 2) // Explosivo - $15,000
                {
                        if(PlayerInfo[playerid][pDinheiro] < 15000) return ErrorMsg(playerid, "No tienes $15,000.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -15000);
                        GanharItem(playerid, ITEM_EXPLOSIVO, 1);
                        SuccesMsg(playerid, "Compraste un Explosivo por $15,000.");
                }
                else if(listitem == 3) // Combo - $23,000
                {
                        if(PlayerInfo[playerid][pDinheiro] < 23000) return ErrorMsg(playerid, "No tienes $23,000.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -23000);
                        GanharItem(playerid, ITEM_GANZUA, 1);
                        GanharItem(playerid, ITEM_TALADRO, 1);
                        GanharItem(playerid, ITEM_EXPLOSIVO, 1);
                        SuccesMsg(playerid, "Compraste el Combo de 3 herramientas por $23,000. Ahorraste $6,000.");
                }
                return 1;
        }
        // P0-TERR-FASE2: handler del dialog de venta de territorio
        if(dialogid == 9998)
        {
                Terr_ProcesarVenta(playerid, response);
                return 1;
        }
        new Account[255];
        new File[255];
        new wVeiculo = GetPlayerVehicleID(playerid);
        format(Account, sizeof(Account), PASTA_CONTAS, Name(playerid));
        switch(dialogid)
        {
                case DIALOG_ARRASTARP:
                {
                        if(response)
                        {
                                cmd_cargarrp(playerid, inputtext);
                        }
                        else
                        {
                                cmd_largarp(playerid, inputtext);
                        }
                }
                case DIALOG_ALGEMARP:
                {
                        if(response)
                        {
                                cmd_esposar2(playerid, inputtext);
                        }
                        else
                        {
                                cmd_qesposa2(playerid, inputtext);
                        }
                }
                case DIALOG_MECANICA:
                {
                        if(!response)
                        {
                                // P0-BEN-TUNE: boton "Terminar" abre confirmacion
                                ShowPlayerDialog(playerid, DIALOG_TUNING_END, DIALOG_STYLE_MSGBOX, "Fin de Tuneo", "{FFFFFF}Terminaste de hacer el tuning del vehiculo?\n\n{FFFF00}Aceptar{FFFFFF}: finalizar y guardar cambios\n{FF0000}Cancelar{FFFFFF}: volver al menu de tuneo", "Aceptar", "Cancelar");
                                return 1;
                        }
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        new menustr2[255];
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Shadow\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Mega\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Rimshine\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Wires\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Classic\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Twist\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Cutter\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Doller\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Atomic\n");
                                        strcat(menustr2, "{FFFF00}Ruedas {FFFFFF}Virtual\n");
                                        ShowPlayerDialog(playerid, DIALOG_MECANICARuedas, DIALOG_STYLE_LIST, "Central de Bennys", menustr2, "Confirmar", "X");
                                }
                                if(listitem == 1)
                                {
                                        new menustr3[400];
                                        strcat(menustr3, "{FFFF00}Colores {FFFFFF}Blanco\n");
                                        strcat(menustr3, "{FFFF00}Colores {FFFFFF}Azul\n");
                                        strcat(menustr3, "{FFFF00}Colores {FFFFFF}Amarillo\n");
                                        strcat(menustr3, "{FFFF00}Colores {FFFFFF}Morado\n");
                                        strcat(menustr3, "{FFFF00}Colores {FFFFFF}Verde\n");
