// =====================================================================
// FIX AUDIT ANIM ANIM-VERIFY-5 (MEJORA M-01): helpers centralizados.
// Reemplazan el patron duplicado en ~22 sitios. Uso:
//   SafeUnfreeze(playerid);                 -> TogglePlayerControllable si safe
//   UnfreezeIfNotCuffed(playerid)           -> retorna 1 si safe, 0 si no
//   ClearAnimationsIfNotCuffed(playerid)    -> ClearAnimations si safe
// =====================================================================
stock UnfreezeIfNotCuffed(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
                return 1;
        return 0;
}

stock SafeUnfreeze(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
                TogglePlayerControllable(playerid, 1);
        return 1;
}

stock ClearAnimationsIfNotCuffed(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
                ClearAnimations(playerid);
        return 1;
}

