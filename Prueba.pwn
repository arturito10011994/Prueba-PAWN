                                        strcat(StrHab, "{FFFF00}=====================================\n");
                                        strcat(StrHab, "{FFFF00} EXAMEN DE PILOTAJE - AVIONES COMERCIALES\n");
                                        strcat(StrHab, "{FFFF00}=====================================\n\n");
                                        strcat(StrHab, "{FFFFFF}Al pulsar {00FF00}Hacer Prueba{FFFFFF} se descontaran {FFFF00}$50.000{FFFFFF} de\n");
                                        strcat(StrHab, "tu bolsillo y comenzara el examen de inmediato.\n\n");
                                        strcat(StrHab, "{FFFF00}Instrucciones:\n");
                                        strcat(StrHab, "{FFFFFF}  {00FF00}>{FFFFFF} Siga los checkpoints aereos en orden.\n");
                                        strcat(StrHab, "{FFFFFF}  {FF4444}>{FFFFFF} No dane la aeronave (se reprueba al dano).\n");
                                        strcat(StrHab, "{FFFFFF}  {FF4444}>{FFFFFF} No abandone la aeronave durante la prueba.\n");
                                        SetPVarInt(playerid, "TipoLicAerea", 2);
                                        ShowPlayerDialog(playerid, DIALOG_CONFIRMA_ESCOLA4, DIALOG_STYLE_MSGBOX, "Examen - Licencia Aerea (Avion Comercial)", StrHab, "Hacer Prueba", "Cancelar");
                                }
                        }
                }
                case DIALOG_CONFIRMA_ESCOLA4:
                {
                        if(response)
                        {
                                // FIX AUDIT-AUDIT6-002b (CRITICO): re-validar TODO antes de tocar dinero/vehiculo.
                                // Precio depende de TipoLicAerea PVar (1=Ligero $40k, 2=Comercial $50k).
                                new _costoAereoPreCheck = (GetPVarInt(playerid, "TipoLicAerea") == 1) ? 40000 : 50000;
                                new _errMsg[128];
                                if(!AutoEscola_PuedeIniciarExamen(playerid, 1856, _costoAereoPreCheck, _errMsg, sizeof(_errMsg)))
                                        return ErrorMsg(playerid, _errMsg);
                                // FIX AUDIT-AUDIT6-006-fix (CRITICO): anti-leak vehiculo/timer previos.
                                new _examVehAer = AutoEscolaAerea[playerid]; AutoEscolaAerea[playerid] = 0; if(IsValidVehicle(_examVehAer)) DestroyVehicle(_examVehAer); // FIX REVERT-AUDIT6-007-defensive
                                if(TimerTesteAerea[playerid]) { KillTimer(TimerTesteAerea[playerid]); TimerTesteAerea[playerid] = 0; }
                                // FIX AUDIT LIC MEJORA-6: setear cooldown 60s.
