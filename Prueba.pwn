        strcat(MEGAString, "{FFFF00}Ayuda {FFFFFF}trabajos\n");
        strcat(MEGAString, "{FFFF00}Ayuda {FFFFFF}Comandos Lideres\n");
        strcat(MEGAString, "{FFFF00}Ayuda {FFFFFF}Comandos Organizaciones\n");
        strcat(MEGAString, "{FFFF00}Ayuda {FFFFFF}Comandos Vehiculo\n");
