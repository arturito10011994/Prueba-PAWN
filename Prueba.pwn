                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -2033.141479, -988.619567, 32.212158))
                {
                        if(PlayerInfo[playerid][Org] != 1)              return ErrorMsg(playerid, "No tienes permisos.");
                        if(Patrulha[playerid] == false)                         return InfoMsg(playerid, "No estas en servicio.");
                        new menuVeh1[400];
                        // P1-4: SwatVan (601) reemplazado por Police Ranger (599) en menu PN.
                        // La SwatVan es un vehiculo del SWAT (Org 4), no tenia sentido en menu PN.
                        // Police Ranger (599) es un vehiculo policial de utilidad para terreno,
                        // coherente con el rol de Patrulla Nacional.
                        strcat(menuVeh1, "{FF0000}- {FFFFFF}CopCarla\t{FF0000}597\n{FF0000}- {FFFFFF}Police Ranger\t{FF0000}599\n{FF0000}- {FFFFFF}CopBike\t{FF0000}523");
                        if(PlayerInfo[playerid][Cargo] >= 5) strcat(menuVeh1, "\n{FFD700}- {FFFFFF}Infernus Lider [LUCES]\t{FFD700}411");
                        // P1-PN-Vehiculos: Helicoptero Police Maverick (497) exclusivo para el Policia Elegido
                        // (mayor rango conectado, si empate el que mas horas tenga en Org 1)
                        if(GetPoliciaElegido() == playerid)
                                strcat(menuVeh1, "\n{00FF00}- {FFFFFF}Helicoptero Police Maverick\t{00FF00}497");
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP1, DIALOG_STYLE_LIST, "Selecionar un vehiculo.", menuVeh1, "Seleccionar", "X");
                }
                // Transito: spawn de vehiculos en posicion original
                else if(PlayerToPoint(3.0, playerid, 1662.606811, -285.948333, 39.627510))
                {
                        if(PlayerInfo[playerid][Org] != 2)              return ErrorMsg(playerid, "No tienes permisos.");
                        if(Patrulha[playerid] == false)                         return InfoMsg(playerid, "No estas en servicio.");
                        // T1-1: Vehiculos propios de Transito.
                        // Antes usaba CopCarla (597) igual que PN, sin identidad propia.
                        // Ahora usa Police Ranger (599) - pickup utilitario ideal para controles de trafic.
                        // Mantenemos la moto 523 (CopBike) que si es coherente para Transito.
                        new menuVehT[256];
                        strcat(menuVehT, "{FF8C00}- {FFFFFF}Moto Transito\t{FF8C00}523\n");
                        strcat(menuVehT, "{FF8C00}- {FFFFFF}Patrullero Transito (Ranger)\t{FF8C00}599");
                        if(PlayerInfo[playerid][Cargo] >= 3) strcat(menuVehT, "\n{FFD700}- {FFFFFF}Premier Jefe [LUCES]\t{FFD700}426");
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP2, DIALOG_STYLE_LIST, "Selecionar un vehiculo.", menuVehT, "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -2441.137939, 522.140869, 29.486917))
                {
                        if(PlayerInfo[playerid][Org] != 4)              return ErrorMsg(playerid, "No tienes permisos.");
                        if(Patrulha[playerid] == false)                         return InfoMsg(playerid, "No estas en servicio.");
                        // P1-SWAT-3: Vehiculos propios del SWAT (antes usaba CopCarla de PN y FBI Rancher).
                        // Ahora usa vehiculos tacticos coherentes con una unidad de elite:
                        //   Enforcer (427): furgon tactico antidisturbios (estandar para todos)
                        //   S.W.A.T. (601): tanquito blindado (rango 2+)
                        //   Police Ranger (599): pickup para terreno (rango 3 / Comandante)
                        //   Infernus (411): vehiculo ejecutivo del Comandante con luces
                        // P1-SWAT-4: Helicoptero Police Maverick (497) exclusivo del Comandante (rango 3)
                        new menuVeh4[600];
                        strcat(menuVeh4, "{FF0000}- {FFFFFF}Enforcer (Furgon Tactico)\t{FF0000}427\n");
                        if(PlayerInfo[playerid][Cargo] >= 2)
                                strcat(menuVeh4, "{FF0000}- {FFFFFF}S.W.A.T. Van (Tanquito)\t{FF0000}601\n");
                        if(PlayerInfo[playerid][Cargo] >= 3)
                        {
                                strcat(menuVeh4, "{FF0000}- {FFFFFF}Police Ranger (Pickup)\t{FF0000}599\n");
                                strcat(menuVeh4, "{FFD700}- {FFFFFF}Infernus Comandante [LUCES]\t{FFD700}411\n");
                                strcat(menuVeh4, "{00FF00}- {FFFFFF}Helicoptero Police Maverick\t{00FF00}497\n");
                        }
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP4, DIALOG_STYLE_LIST, "Selecionar un vehiculo SWAT.", menuVeh4, "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -1278.216552, 2711.282714, 50.132141))
                {
                        if(PlayerInfo[playerid][Org] != 3)              return ErrorMsg(playerid, "No tienes permisos.");
                        if(Patrulha[playerid] == false)                         return InfoMsg(playerid, "No estas en servicio.");
                        // P1-FBI-Vehiculos: menu reestructurado
                        // Antes: CopCarla (prestado de PN) + FBI Rancher + Infernus (cargo 6, bug)
                        // Ahora: Sedan Civil (3 modelos aleatorios para encubierto) + FBI Rancher (operativo)
                        //        + Infernus Director (cargo 5+, color azul FBI) + Helicoptero Maverick azul (cualquiera)
                        new menuVeh3[500];
                        strcat(menuVeh3, "{FF0000}- {FFFFFF}Sedan Civil (Encubierto)\t{FF0000}ALEATORIO\n");
                        strcat(menuVeh3, "{FF0000}- {FFFFFF}FBI Rancher (Operativo)\t{FF0000}490\n");
                        if(PlayerInfo[playerid][Cargo] >= 5)
                                strcat(menuVeh3, "{FFD700}- {FFFFFF}Infernus Director [LUCES]\t{FFD700}411\n");
                        strcat(menuVeh3, "{00FF00}- {FFFFFF}Helicoptero Maverick (Azul)\t{00FF00}487");
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP3, DIALOG_STYLE_LIST, "Selecionar un vehiculo FBI.", menuVeh3, "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, 667.180053, -1457.288818, 15.439465))
                {
                        if(PlayerInfo[playerid][Org] != 14)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(Patrulha[playerid] == false)                         return InfoMsg(playerid, "No estas en servicio.");
                        // P1-EJERCITO-Vehiculos: menu reestructurado con vehiculos militares propios
                        // Antes: CopCarla (prestado PN) + FBI Rancher (prestado FBI) - incoherente para un ejercito
                        // Ahora: vehiculos militares reales escalados por rango:
                        //   Patriot (470): vehiculo militar estandar (todos)
                        //   Barracks (433): camion de transporte de tropas (rango 2+)
                        //   Rhino (432): tanque blindado (rango 4+)
                        //   Hunter (425): helicoptero de combate (EXCLUSIVO General cargo 6)
                        // Coordenada helicoptero Ejercito: 689.569824, -1540.146484, 17.141462 (rot 5.900232)
                        new menuVeh5[600];
                        strcat(menuVeh5, "{FF0000}- {FFFFFF}Patriot (Vehiculo Militar)\t{FF0000}470\n");
                        if(PlayerInfo[playerid][Cargo] >= 2)
                                strcat(menuVeh5, "{FF0000}- {FFFFFF}Barracks (Camion Tropas)\t{FF0000}433\n");
                        if(PlayerInfo[playerid][Cargo] >= 4)
                                strcat(menuVeh5, "{FF0000}- {FFFFFF}Rhino (Tanque Blindado)\t{FF0000}432\n");
                        if(PlayerInfo[playerid][Cargo] >= 5)
                                strcat(menuVeh5, "{FFD700}- {FFFFFF}Infernus General [LUCES]\t{FFD700}411\n");
                        // FIX AUDIT 5P [M1]: Hunter exclusivo General (cargo 6), antes era >= 5 (Coronel)
                        if(PlayerInfo[playerid][Cargo] == 6)
                                strcat(menuVeh5, "{00FF00}- {FFFFFF}Hunter (Helicoptero Combate)\t{00FF00}425\n");
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP5, DIALOG_STYLE_LIST, "Selecionar un vehiculo Ejercito.", menuVeh5, "Seleccionar", "X");
                }
                // P0-REP-FIX: Menu de equipamiento de Reporteros (tecla H)
                // Funciona tanto afuera (HQ visible) como adentro (interior SAN NEWS)
                else if(PlayerToPoint(3.0, playerid, 753.274414, -1358.755981, 13.500000)
                     || PlayerToPoint(3.0, playerid, -5467.478027, -4536.691894, 4046.774902))
                {
                        if(PlayerInfo[playerid][Org] != 11)             return ErrorMsg(playerid, "No tienes permisos.");
                        // Menu unico con todas las opciones de Reporteros
                        new menuRep[300];
                        if(reportero[playerid] == false)
                                strcat(menuRep, "{FFFF00}- {FFFFFF}Vestir Uniforme de Reportero\n");
                        else
                                strcat(menuRep, "{FFFF00}- {FFFFFF}Quitar Uniforme\n");
                        strcat(menuRep, "{FFFF00}- {FFFFFF}Equipar Camara de Reportero\n");
