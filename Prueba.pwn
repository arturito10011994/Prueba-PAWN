stock GetPlayerOrg(playerid)
{
        new org;
        if(PlayerInfo[playerid][Org] > 0)
        {
                org = PlayerInfo[playerid][Org];
                return org;
        }
        return 0;
}

// =====================================================================
// P0-AUD: GetOrgCargoMax(orgid) - devuelve el cargo maximo (lider) de una org.
// Usado por /promover, /invitar y otros comandos para validar permisos.
// Tabla centralizada para evitar hardcodear rangos en cada comando.
// =====================================================================
stock GetOrgCargoMax(orgid)
{
        switch(orgid)
        {
                case 1:  return 5;   // PN: Comisario
                case 2:  return 3;   // Transito: Jefe
                case 3:  return 5;   // FBI: Director (reestructurado a 5 rangos)
                case 4:  return 3;   // SWAT: Comandante Tactico
                case 9:  return 3;   // Bennys: Jefe de Taller
                case 10: return 4;   // Paramedicos: Director Medico
                case 11: return 3;   // Reporteros: Director
                case 14: return 6;   // Ejercito: General
                case 5, 6, 7, 8, 12, 13: return 3;  // Bandas: Lider
        }
        return 3; // default
}

// =====================================================================
// P0-AUD: IsOrgLeader(playerid) - devuelve true si el jugador es el lider
// de su organizacion (cargo == cargoMax de su org).
// =====================================================================
stock IsOrgLeader(playerid)
{
        if(!IsPlayerConnected(playerid)) return false;
        if(PlayerInfo[playerid][Org] == 0) return false;
        return (PlayerInfo[playerid][Cargo] == GetOrgCargoMax(PlayerInfo[playerid][Org]));
}

stock IsPerto(playerid,id){
        new Float:x,Float:y,Float:z;
        GetPlayerPos(id,x,y,z);
        if(IsPlayerInRangeOfPoint(playerid,30,x,y,z)){
                return 1;
        }
        return 0;
}

// FIX P0-3: funcion especifica para arrestos con radio estricto (7m).
// El radio generico de IsPerto (30m) es demasiado amplio para arrestos:
// permitia arrestar a sospechosos en otra calle. 7m es el alcance realista
// para "agarrar" a un sospechoso desde una patrullera.
stock IsPertoArresto(playerid, id)
{
        new Float:x, Float:y, Float:z;
        GetPlayerPos(id, x, y, z);
        if(IsPlayerInRangeOfPoint(playerid, 7.0, x, y, z)) return 1;
        return 0;
}

// =====================================================================
// P0-PN-1: Validacion de vehiculo policial.
// Previene que un policia arreste desde un vehiculo civil o robado.
// Modelos incluidos:
//   523=Police HPV1000 (moto), 427=Enforcer (SWAT van), 490=FBI Rancher,
//   528=FBI Truck, 596/597/598=Police LSPD/SFPD/LVPD, 599=Police Ranger,
//   601=S.W.A.T. van, 432=Rhino (Ejercito), 433=Barracks (Ejercito)
// =====================================================================
stock IsVehiclePolicial(vehicleid)
{
        if(!IsValidVehicle(vehicleid)) return 0;
        switch(GetVehicleModel(vehicleid))
        {
                case 432, 433, 427, 490, 523, 528, 596, 597, 598, 599, 601:
                        return 1;
        }
        return 0;
}

// =====================================================================
// P0-PN-3: Sistema de celdas multiples.
// AssignJailCell(playerid) reserva la primera celda libre y devuelve su indice.
// FreeJailCell(playerid) libera la celda que tenia asignada el jugador.
// InitJailCells() inicializa los arrays (llamar en OnGameModeInit).
// =====================================================================
stock AssignJailCell(playerid)
{
        // FIX AUDIT ASSIGNJAILCELL [C1]: liberar celda previa antes de asignar nueva
        // (evita cell leak cuando un jugador es arrestado dos veces)
        if(playerid < 0 || playerid >= MAX_PLAYERS) return -1; // FIX C2: bounds check
        if(g_PlayerCell[playerid] != -1)
                FreeJailCell(playerid); // libera celda anterior
        for(new c = 0; c < MAX_JAIL_CELLS; c++)
        {
                if(g_JailCellOccupied[c] == -1)
                {
                        g_JailCellOccupied[c] = playerid;
                        g_PlayerCell[playerid] = c;
                        return c;
                }
        }
        // FIX AUDIT SPAWN S3-3: todas las celdas estan ocupadas. Encolar al jugador
        // en g_JailQueue y devolver -2 para seÃ¯Â¿Â½alar "en cola". OnPlayerSpawn
        // detecta -2 y NO teleporta a una celda fisica; el jugador esperara hasta
        // que FreeJailCell lo asigne cuando una celda se libere.
        // Evitar duplicar al jugador en la cola: si ya esta encolado, no re-enconlar.
        for(new i = 0; i < g_JailQueueCount; i++)
        {
                if(g_JailQueue[i] == playerid) return -2;
        }
        if(g_JailQueueCount < MAX_PLAYERS)
        {
                g_JailQueue[g_JailQueueCount++] = playerid;
        }
        return -2; // en cola
}

stock FreeJailCell(playerid)
{
        if(g_PlayerCell[playerid] != -1)
        {
                g_JailCellOccupied[g_PlayerCell[playerid]] = -1;
                // FIX AUDIT SPAWN S3-3: si hay jugadores en cola, asignar la celda
                // recien liberada al siguiente en cola. Si el siguiente sigue
                // conectado y logueado, teleportarlo a la celda liberada.
                new freedCell = g_PlayerCell[playerid];
                g_PlayerCell[playerid] = -1;
                if(g_JailQueueCount > 0)
                {
                        new nextPlayer = g_JailQueue[0];
                        // Shift FIFO: mover todos los demas una posicion hacia atras
                        for(new i = 0; i < g_JailQueueCount - 1; i++)
                                g_JailQueue[i] = g_JailQueue[i + 1];
                        g_JailQueue[--g_JailQueueCount] = -1;
                        // Asignar la celda liberada al siguiente jugador
                        if(nextPlayer >= 0 && nextPlayer < MAX_PLAYERS && IsPlayerConnected(nextPlayer) && pLogado[nextPlayer])
                        {
                                g_JailCellOccupied[freedCell] = nextPlayer;
                                g_PlayerCell[nextPlayer] = freedCell;
                                SetPlayerPos(nextPlayer, g_JailCells[freedCell][0], g_JailCells[freedCell][1], g_JailCells[freedCell][2]);
                                SetPlayerInterior(nextPlayer, 5);
                                SetPlayerVirtualWorld(nextPlayer, 0);
                                new msgQueue[128];
                                format(msgQueue, sizeof(msgQueue), "Se libero una celda. Te quedan %d minutos de carcel.", PlayerInfo[nextPlayer][pjail] / 60);
                                InfoMsg(nextPlayer, msgQueue);
                                printf("[S3-3] Jugador %d en cola recibio celda %d", nextPlayer, freedCell);
                        }
                }
        }
        else
        {
                // FIX AUDIT SPAWN S3-3: si el jugador estaba en cola (no tenia celda
                // asignada), removerlo de la cola al liberar.
                for(new i = 0; i < g_JailQueueCount; i++)
                {
                        if(g_JailQueue[i] == playerid)
                        {
                                for(new j = i; j < g_JailQueueCount - 1; j++)
                                        g_JailQueue[j] = g_JailQueue[j + 1];
                                g_JailQueue[--g_JailQueueCount] = -1;
                                break;
                        }
                }
        }
        return 1;
}

stock InitJailCells()
{
        for(new c = 0; c < MAX_JAIL_CELLS; c++) g_JailCellOccupied[c] = -1;
        for(new i = 0; i < MAX_PLAYERS; i++) g_PlayerCell[i] = -1;
        for(new i = 0; i < MAX_PLAYERS; i++) g_JailQueue[i] = -1;
        g_JailQueueCount = 0;
        printf("[P0-PN-3] Sistema de celdas inicializado: %d celdas disponibles", MAX_JAIL_CELLS);
        return 1;
}

// =====================================================================
// P1-PN-4: Sistema anti-AFK para patrullaje policial.
// CheckPatrulhaAFK se llama cada 5 min por SetTimerEx por jugador.
// Si el policia NO se movio mas de 5m desde el ultimo check, se lo saca
// de servicio. Si se movio, se actualiza la posicion de referencia.
// =====================================================================
forward CheckPatrulhaAFK(playerid);
public CheckPatrulhaAFK(playerid)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        if(Patrulha[playerid] == false) return 1; // ya no esta en servicio

        // FIX AUDIT AGENT4 AFK-02: anyadidas exenciones para estados legititamente
        // estaticos. Sin esto, un policia en stakeout legitimo (vigilando un sitio,
        // esperando ordenes, en PD, etc.) era kickeado del servicio tras 5 min quieto.
        // Threshold 5m/5min era muy estricto para stakeouts reales.
        // IMPORTANTE: en vez de return 1 directo, reprogramar el timer para que el
        // check continÃ¯Â¿Â½e cuando el jugador recupere movilidad (herido->revive,
        // algemado->libre, etc.). Si hacemos return 1 sin reprogramar, el timer muere
        // y el AFK check nunca vuelve a disparar.
        new pstate = GetPlayerState(playerid);
        if(pstate == PLAYER_STATE_WASTED || pstate == PLAYER_STATE_SPECTATING
           || PlayerInfo[playerid][pCongelado] || PlayerInfo[playerid][pjail] > 0
           || MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0 || IsAssistindo[playerid])
        {
                // Actualizar posicion de referencia + reprogramar timer
                new Float:tmpX, Float:tmpY, Float:tmpZ;
                GetPlayerPos(playerid, tmpX, tmpY, tmpZ);
                g_PatrulhaLastX[playerid] = tmpX;
                g_PatrulhaLastY[playerid] = tmpY;
                g_PatrulhaAFKTimer[playerid] = SetTimerEx("CheckPatrulhaAFK", PATRULHA_AFK_INTERVAL, false, "i", playerid);
                return 1;
        }

        new Float:curX, Float:curY, Float:curZ;
        GetPlayerPos(playerid, curX, curY, curZ);

        // Calcular distancia 2D desde la ultima posicion registrada
        new Float:dx = curX - g_PatrulhaLastX[playerid];
        new Float:dy = curY - g_PatrulhaLastY[playerid];
        new Float:delta = floatsqroot(dx * dx + dy * dy);

        if(delta < PATRULHA_AFK_MIN_DELTA)
        {
                // Policfa AFK: sacarlo de servicio
                Patrulha[playerid] = false;
                if(policiaon > 0) policiaon--;
                // FIX AUDIT AGENT1 WC-14: antes de ResetPlayerWeapons+CarregarArmas,
                // guardar las armas actuales. Sin esto, si el policia adquirio armas
                // personales legittimas mientras estaba en servicio (las recogio del
                // suelo, las compro), esas armas se perdian al sacarlo de servicio
                // porque CarregarArmas carga el snapshot del momento en que entro.
                SalvarArmas(playerid);
                ResetPlayerWeapons(playerid);
                CarregarArmas(playerid);
                SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                SetPlayerArmour(playerid, 0);
                SetPlayerColor(playerid, 0xFFFFFFFF);
                ErrorMsg(playerid, "Fuiste removido del servicio por inactividad (AFK).");
                printf("[P1-PN-4] Policia ID %d removido del servicio por AFK (delta=%.2fm)", playerid, delta);
                g_PatrulhaAFKTimer[playerid] = 0;
        }
        else
        {
                // Policfa activo: actualizar posicion y reprogramar check
                g_PatrulhaLastX[playerid] = curX;
                g_PatrulhaLastY[playerid] = curY;
                g_PatrulhaAFKTimer[playerid] = SetTimerEx("CheckPatrulhaAFK", PATRULHA_AFK_INTERVAL, false, "i", playerid);
        }
        return 1;
}

// Llamar cuando un policia entra en servicio (Patrulha = true) para
// inicializar posicion de referencia y arrancar el timer anti-AFK.
stock StartPatrulhaAFKTimer(playerid)
{
        GetPlayerPos(playerid, g_PatrulhaLastX[playerid], g_PatrulhaLastY[playerid], g_PatrulhaLastZ[playerid]);
        if(g_PatrulhaAFKTimer[playerid]) KillTimer(g_PatrulhaAFKTimer[playerid]);
        g_PatrulhaAFKTimer[playerid] = SetTimerEx("CheckPatrulhaAFK", PATRULHA_AFK_INTERVAL, false, "i", playerid);
        return 1;
}

// Llamar cuando un policia sale de servicio (Patrulha = false) para
// detener el timer anti-AFK.
stock StopPatrulhaAFKTimer(playerid)
{
        if(g_PatrulhaAFKTimer[playerid])
        {
                KillTimer(g_PatrulhaAFKTimer[playerid]);
                g_PatrulhaAFKTimer[playerid] = 0;
        }
        return 1;
}

stock addlider(playerid, idorg)
{
        new String[500];
        format(String, sizeof(String), PASTA_ORGS, idorg);
        if(!DOF2_FileExists(String))return true;

        if(!strcmp(DOF2_GetString(String,VagasORG[0]),"ninguno",true))
        {
                DOF2_SetString(String,VagasORG[0], Name(playerid));
                DOF2_SaveFile();
        }
        return true;
}
stock tirarlider(playerid, idorg)
{
        format(String, sizeof(String), PASTA_ORGS, idorg);
        if(!DOF2_FileExists(String))return true;
        if(!strcmp(DOF2_GetString(String,VagasORG[0]),"ninguno",true))return ErrorMsg(playerid, "No hay lider en esa org.");
        DOF2_SetString(String,VagasORG[0], "ninguno");
        return true;
}
stock convidarmembro(playerid, idorg)
{
        new String[500];
        format(String, sizeof(String), PASTA_ORGS, idorg);
        if(!DOF2_FileExists(String))return false;
        // P1-AUD-2: buscar primer slot vacio. Si no hay, retornar false.
        for(new i=1; i< sizeof VagasORG; i++)
        {
                if(!strcmp(DOF2_GetString(String,VagasORG[i]), "ninguno",true))
                {
                        DOF2_SetString(String, VagasORG[i], Name(playerid));
                        DOF2_SaveFile();
                        return true;
                }
        }
        // No hay vacantes: avisar al lider que invito
        ErrorMsg(playerid, "No hay vacantes en la organizacion (max 20 miembros).");
        return false;
}
stock expulsarmembro(playerid, idorg)
{
        new String[500];
        format(String, sizeof(String), PASTA_ORGS, idorg);
        if(!DOF2_FileExists(String))return false;
        new targetName[MAX_PLAYER_NAME];
        format(targetName, sizeof(targetName), "%s", Name(playerid));
        for(new i=1; i< sizeof VagasORG; i++)
        {
                if(!strcmp(DOF2_GetString(String,VagasORG[i]), targetName, true))
                {
                        DOF2_SetString(String, VagasORG[i], "ninguno");
                        DOF2_SaveFile();
                        // P2-AUD-2: si el jugador expulsado esta conectado, actualizar su estado
                        foreach(new j : Player)
                        {
                                if(pLogado[j] && !strcmp(Name(j), targetName, true))
                                {
                                        // FIX AUDIT PRENSA: resetear flags de org civil al expulsar
                                        FlushPlayerOrgFlags(j);
                                        PlayerInfo[j][Org] = 0;
                                        PlayerInfo[j][Cargo] = 0;
                                        if(Patrulha[j] == true)
                                        {
                                                Patrulha[j] = false;
                                                if(policiaon > 0) policiaon--;
                                                RemoverArmasOrg(j);
                                                SetPlayerSkin(j, PlayerInfo[j][pSkin]);
                                                SetPlayerArmour(j, 0);
                                                SetPlayerColor(j, 0xFFFFFFFF);
                                        }
                                        ErrorMsg(j, "Fuiste expulsado de la organizacion.");
                                        SalvarArmas(j);
                                        break;
                                }
                        }
                        return true;
                }
        }
        return false;
}
stock ChecarOrg(playerid)
{
        new String[500];
        new orgid = PlayerInfo[playerid][Org];
        format(String, sizeof(String), PASTA_ORGS, orgid);
        // P1-AUD-1 + P2-AUD-1: bucle en vez de 21 if repetidos.
        // Antes: slot 10 estaba comentado, causando expulsiones fantasma.
        // Ahora: itera todos los slots 0..20 sin excepciones.
        for(new i = 0; i < sizeof VagasORG; i++)
        {
                if(strcmp(DOF2_GetString(String, VagasORG[i]), Name(playerid), true) == 0)
                        return 1;
        }
        PlayerInfo[playerid][Org] = 0;
        PlayerInfo[playerid][Cargo] = 0;
        InfoMsg(playerid, "Fue expulsado.");
        return 0;
}

stock membrosorg(playerid, idorg)
{
        new String[500], corda[3000], wiki[200], orgname[35];
        format(String, sizeof(String), PASTA_ORGS, idorg);

        // Nombre de la org
        switch(idorg)
        {
                case 1: orgname = "Policia Nacional";
                case 2: orgname = "Transito";
                case 3: orgname = "FBI";
                case 4: orgname = "SWAT";
                case 5:  strcpy(orgname, GangOrgNombre[0]); // Banda Roja (dinamico)
                case 6:  strcpy(orgname, GangOrgNombre[1]); // Banda Sobras de Plomo (dinamico)
                case 7:  strcpy(orgname, GangOrgNombre[2]); // Banda Amarilla (dinamico)
                case 8:  strcpy(orgname, GangOrgNombre[3]); // Banda Verde (dinamico)
                case 9: orgname = "Bennys";
                case 10: orgname = "Paramedicos"; // FIX AUDIT9 BUG6: faltaba case 10
                case 11: orgname = "Reporteros";
                case 12: strcpy(orgname, GangOrgNombre[4]); // Banda Delincuentes Anonimos (dinamico)
                case 13: strcpy(orgname, GangOrgNombre[5]); // Moto Club (dinamico)
                case 14: orgname = "Ejercito Nacional";
                default: orgname = "Organizacion";
        }

        // Tabla de rangos por org
        format(wiki,200,"{FFFF00}=== %s ===\n\n",orgname);
        strcat(corda, wiki);

        // P0-INFOORG-YO: mostrar nombre y cargo del jugador actual al inicio.
        // Asi cada jugador ve su propio nombre y rango cuando abre /infoorg.
        new meuNome[24], meuCargo[40];
        GetPlayerName(playerid, meuNome, sizeof(meuNome));
        strcpy(meuCargo, NomeCargoOff(meuNome, idorg), sizeof(meuCargo));
        new meuIDF = PlayerInfo[playerid][IDF];
        format(wiki, 200, "{00FF00}[ Tu informacion ]\n{FFFFFF}Nombre: {FFFF00}%s {FFFFFF}(IDF: %04d)\n{FFFFFF}Cargo: {FFFF00}%s\n\n", meuNome, meuIDF, meuCargo);
        strcat(corda, wiki);

        strcat(corda, "{FF6347}[ Rangos ]\n");
        if(idorg == 2)
        {
                strcat(corda, "{FFFFFF}1-Cadete | 2-Oficial | 3-Jefe de Transito\n\n");
        }
        else if(idorg == 1)
        {
                strcat(corda, "{FFFFFF}1-Oficial | 2-Sargento | 3-Teniente | 4-Capitan | 5-Comisario\n\n");
        }
        else if(idorg == 3)
        {
                strcat(corda, "{FFFFFF}1-Agente Encubierto | 2-Agente Especial | 3-Supervisor\n");
                strcat(corda, "{FFFFFF}4-Jefe Division | 5-Director\n\n");
        }
        else if(idorg == 4)
        {
                strcat(corda, "{FFFFFF}1-Operador | 2-Tirador Selecto | 3-Comandante Tactico\n\n");
        }
        else if(idorg == 14)
        {
                strcat(corda, "{FFFFFF}1-Soldado | 2-Sargento | 3-Teniente | 4-Capitan | 5-Coronel | 6-General\n\n");
        }
        else if(idorg == 9)
        {
                strcat(corda, "{FFFFFF}1-Aprendiz | 2-Mecanico | 3-Jefe de Taller\n\n");
        }
        else if(idorg == 11)
        {
                strcat(corda, "{FFFFFF}1-Periodista | 2-Editor | 3-Director\n\n");
        }
        else if(idorg == 10) { strcat(corda, "{FFFFFF}1-Enfermero | 2-Paramedico | 3-Medico/Cirujano | 4-Director Medico\n\n"); } // FIX AUDIT9 BUG6
        else if(idorg == 5 || idorg == 6 || idorg == 7 || idorg == 8 || idorg == 12 || idorg == 13)
        {
                // Bandas: mostrar rangos personalizados (pueden ser cambiados por el lider)
                new idx = OrgGangIndex(idorg);
                if(idx != -1)
                {
                        format(wiki, 200, "{FFFFFF}1-%s | 2-%s | 3-%s\n\n", GangRangoC1[idx], GangRangoC2[idx], GangRangoC3[idx]);
                        strcat(corda, wiki);
                }
        }

        // Integrantes
        strcat(corda, "{FF6347}[ Integrantes ]\n");
        new tieneIntegrantes = false;
        for(new i = 0; i < sizeof VagasORG; i++)
        {
                new miembro[35];
                format(miembro, 35, "%s", DOF2_GetString(String, VagasORG[i]));
                if(strcmp(miembro, "ninguno", true) != 0 && strlen(miembro) > 1)
                {
                        format(wiki, 200, "{FFFF00}%s {FFFFFF}- %s\n", VagasORG[i], NomeCargoOff(miembro, idorg));
                        strcat(corda, wiki);
                        tieneIntegrantes = true;
                }
        }
        if(!tieneIntegrantes) strcat(corda, "{AAAAAA}Sin integrantes registrados.\n");

        ShowPlayerDialog(playerid, DIALOG_MEMBROSORG, DIALOG_STYLE_MSGBOX, "Info Organizacion", corda, "Cerrar", #);
        return true;
}
stock NomeCargoOff(Nome[], orgid)
{
        new CARGO[40], Crogo, strings[150];
        format(strings, sizeof(strings), PASTA_CONTAS, Nome);
        Crogo = DOF2_GetInt(strings, "pCargo");
        if(orgid == 2) // Transito
        {
                if(Crogo==1) CARGO="Cadete";
                else if(Crogo==2) CARGO="Oficial";
                else if(Crogo==3) CARGO="Jefe de Transito";
                else CARGO="Sin Rango";
        }
        else if(orgid == 1) // Policia Nacional
        {
                if(Crogo==1) CARGO="Oficial";
                else if(Crogo==2) CARGO="Sargento";
                else if(Crogo==3) CARGO="Teniente";
                else if(Crogo==4) CARGO="Capitan";
                else if(Crogo==5) CARGO="Comisario";
                else CARGO="Sin Rango";
        }
        else if(orgid == 3) // FBI (5 rangos)
        {
                if(Crogo==1) CARGO="Agente Encubierto";
                else if(Crogo==2) CARGO="Agente Especial";
                else if(Crogo==3) CARGO="Supervisor";
                else if(Crogo==4) CARGO="Jefe Division";
                else if(Crogo==5) CARGO="Director";
                else CARGO="Sin Rango";
        }
        else if(orgid == 4) // SWAT (rangos propios tacticos)
        {
                if(Crogo==1) CARGO="Operador";
                else if(Crogo==2) CARGO="Tirador Selecto";
                else if(Crogo==3) CARGO="Comandante Tactico";
                else CARGO="Sin Rango";
        }
        else if(orgid == 14) // Ejercito
        {
                if(Crogo==1) CARGO="Soldado";
                else if(Crogo==2) CARGO="Sargento";
                else if(Crogo==3) CARGO="Teniente";
                else if(Crogo==4) CARGO="Capitan";
                else if(Crogo==5) CARGO="Coronel";
                else if(Crogo==6) CARGO="General";
                else CARGO="Sin Rango";
        }
        else if(orgid == 9) // Bennys
        {
                if(Crogo==1) CARGO="Aprendiz";
                else if(Crogo==2) CARGO="Mecanico";
                else if(Crogo==3) CARGO="Jefe de Taller";
                else CARGO="Sin Rango";
        }
        else if(orgid == 11) // Reporteros
        {
                if(Crogo==1) CARGO="Periodista";
                else if(Crogo==2) CARGO="Editor";
                else if(Crogo==3) CARGO="Director";
                else CARGO="Sin Rango";
        }
        else if(orgid == 10) // FIX AUDIT9 BUG6: Paramedicos
        {
                if(Crogo==1) CARGO="Enfermero";
                else if(Crogo==2) CARGO="Paramedico";
                else if(Crogo==3) CARGO="Medico/Cirujano";
                else if(Crogo==4) CARGO="Director Medico";
                else CARGO="Sin Rango";
        }
        else
        {
                if(Crogo==1) CARGO="Miembro";
                else if(Crogo==2) CARGO="SubLider";
                else if(Crogo==3) CARGO="Lider";
                else CARGO="Sin Rango";
        }
        return CARGO;
}

// Convierte org ID de gang a indice de array (0-5)
stock OrgGangIndex(org)
{
        switch(org)
        {
                case 5:  return 0;
                case 6:  return 1;
                case 7:  return 2;
                case 8:  return 3;
                case 12: return 4;
                case 13: return 5;
        }
        return -1;
}

// Carga rangos y nombre de org desde InfoOrg/X.ini al iniciar
stock CargarDatosGang(orgid)
{
        new String[200], idx = OrgGangIndex(orgid);
        if(idx == -1) return;
        format(String, sizeof(String), PASTA_ORGS, orgid);
        if(!DOF2_FileExists(String)) return;
        new tmp[64];
        format(tmp, sizeof(tmp), "%s", DOF2_GetString(String, "RangoC1"));
        if(strlen(tmp) > 1) strcpy(GangRangoC1[idx], tmp);
        format(tmp, sizeof(tmp), "%s", DOF2_GetString(String, "RangoC2"));
        if(strlen(tmp) > 1) strcpy(GangRangoC2[idx], tmp);
        format(tmp, sizeof(tmp), "%s", DOF2_GetString(String, "RangoC3"));
        if(strlen(tmp) > 1) strcpy(GangRangoC3[idx], tmp);
        format(tmp, sizeof(tmp), "%s", DOF2_GetString(String, "OrgNombre"));
        if(strlen(tmp) > 1) strcpy(GangOrgNombre[idx], tmp);
}

// Guarda rangos y nombre en InfoOrg/X.ini
stock GuardarDatosGang(orgid)
{
        new String[200], idx = OrgGangIndex(orgid);
        if(idx == -1) return;
        format(String, sizeof(String), PASTA_ORGS, orgid);
        if(!DOF2_FileExists(String)) return;
        DOF2_SetString(String, "RangoC1", GangRangoC1[idx]);
        DOF2_SetString(String, "RangoC2", GangRangoC2[idx]);
        DOF2_SetString(String, "RangoC3", GangRangoC3[idx]);
        DOF2_SetString(String, "OrgNombre", GangOrgNombre[idx]);
        DOF2_SaveFile();
}

stock NomeCargo(playerid)
{
        new CARGO[40];
        new org = PlayerInfo[playerid][Org];
        new cargo = PlayerInfo[playerid][Cargo];
        if(org == 0) { CARGO = "Civil"; return CARGO; }

        // Transito (org 2): 1=Cadete 2=Oficial 3=Jefe de Transito
        if(org == 2)
        {
                if(cargo == 1) CARGO = "Cadete";
                else if(cargo == 2) CARGO = "Oficial";
                else if(cargo == 3) CARGO = "Jefe de Transito";
                else CARGO = "Sin Rango";
        }
        // Policia Nacional (org 1): 1=Oficial 2=Sargento 3=Teniente 4=Capitan 5=Comisario(Lider)
        else if(org == 1)
        {
                if(cargo == 1) CARGO = "Oficial";
                else if(cargo == 2) CARGO = "Sargento";
                else if(cargo == 3) CARGO = "Teniente";
                else if(cargo == 4) CARGO = "Capitan";
                else if(cargo == 5) CARGO = "Comisario";
                else CARGO = "Sin Rango";
        }
        // FBI (org 3): 5 rangos. Reestructurado: se elimino el rango "Agente"
        // (era identico al rango 4 en equipamiento). Ahora todos los rangos
        // tienen equipamiento escalado y todos pueden usar /encubrir.
        // 1=Agente Encubierto 2=Agente Especial 3=Supervisor 4=Jefe Division 5=Director
        else if(org == 3)
        {
                if(cargo == 1) CARGO = "Agente Encubierto";
                else if(cargo == 2) CARGO = "Agente Especial";
                else if(cargo == 3) CARGO = "Supervisor";
                else if(cargo == 4) CARGO = "Jefe Division";
                else if(cargo == 5) CARGO = "Director";
                else CARGO = "Sin Rango";
        }
        // SWAT (org 4): rangos PROPIOS tacticos (fix Bug #1: antes copiados de Transito).
        // 1=Operador 2=Tirador Selecto 3=Comandante Tactico (Lider)
        else if(org == 4)
        {
                if(cargo == 1) CARGO = "Operador";
                else if(cargo == 2) CARGO = "Tirador Selecto";
                else if(cargo == 3) CARGO = "Comandante Tactico";
                else CARGO = "Sin Rango";
        }
        // Ejercito (org 14): 1=Soldado 2=Sargento 3=Teniente 4=Capitan 5=Coronel 6=General(Lider)
        else if(org == 14)
        {
                if(cargo == 1) CARGO = "Soldado";
                else if(cargo == 2) CARGO = "Sargento";
                else if(cargo == 3) CARGO = "Teniente";
                else if(cargo == 4) CARGO = "Capitan";
                else if(cargo == 5) CARGO = "Coronel";
                else if(cargo == 6) CARGO = "General";
                else CARGO = "Sin Rango";
        }
        // Bennys (org 9): 1=Ayudante/Aprendiz 2=Mecanico 3=Jefe de Taller
        // P0-BEN-SKIN: masculino usa "Ayudante", femenino usa "Aprendiz"
        else if(org == 9)
        {
                if(cargo == 1)
                {
                        if(PlayerInfo[playerid][pSexo] == 2) CARGO = "Aprendiz";
                        else CARGO = "Ayudante";
                }
                else if(cargo == 2)
                {
                        if(PlayerInfo[playerid][pSexo] == 2) CARGO = "Mecanica";
                        else CARGO = "Mecanico";
                }
                else if(cargo == 3)
                {
                        if(PlayerInfo[playerid][pSexo] == 2) CARGO = "Jefa de Taller";
                        else CARGO = "Jefe de Taller";
                }
                else CARGO = "Sin Rango";
        }
        // Paramedicos (org 10): 1=Enfermero 2=Paramedico 3=Medico/Cirujano 4=Director Medico
        // CAMBIO 2026-07-09 - Bug #12: agregados rangos propios para paramedicos.
        // Antes caian al default "Miembro/SubLider/Lider" igual que las bandas.
        else if(org == 10)
        {
                if(cargo == 1) CARGO = "Enfermero";
                else if(cargo == 2) CARGO = "Paramedico";
                else if(cargo == 3) CARGO = "Medico/Cirujano";
                else if(cargo == 4) CARGO = "Director Medico";
                else CARGO = "Sin Rango";
        }
        // Reporteros (org 11): 1=Periodista 2=Editor 3=Director
        else if(org == 11)
        {
                if(cargo == 1) CARGO = "Periodista";
                else if(cargo == 2) CARGO = "Editor";
                else if(cargo == 3) CARGO = "Director";
                else CARGO = "Sin Rango";
        }
        // Bandas (usan rangos personalizados)
        else
        {
                new idx = OrgGangIndex(org);
                if(idx != -1)
                {
                        if(cargo == 1) strcpy(CARGO, GangRangoC1[idx]);
                        else if(cargo == 2) strcpy(CARGO, GangRangoC2[idx]);
                        else if(cargo == 3) strcpy(CARGO, GangRangoC3[idx]);
                        else CARGO = "Sin Rango";
                }
                else
                {
                        if(cargo == 1) CARGO = "Miembro";
                        else if(cargo == 2) CARGO = "SubLider";
                        else if(cargo == 3) CARGO = "Lider";
                        else CARGO = "Sin Rango";
                }
        }
        return CARGO;
}
stock NomeOrg(playerid)
{
        new orG[35],org;
        org = PlayerInfo[playerid][Org];

        // P1-FBI-2: si el FBI esta en modo encubierto, aparece como Civil
        if(org == 3 && g_FBIEncubierto[playerid] == true)
        {
                orG = "Civil";
                return orG;
        }

        if(org == 0)
        {
                orG = "Civil";
        }
        if(org == 1)
        {
                orG = "Policia Nacional";
        }
        if(org == 2)
        {
                orG = "Transito";
        }
        if(org == 3)
        {
                orG = "FBI";
        }
        if(org == 4)
        {
                orG = "SWAT";
        }
        if(org == 5) { strcpy(orG, GangOrgNombre[0]); }
        if(org == 6) { strcpy(orG, GangOrgNombre[1]); }
        if(org == 7) { strcpy(orG, GangOrgNombre[2]); }
        if(org == 8) { strcpy(orG, GangOrgNombre[3]); }
        if(org == 9)
        {
                orG = "Bennys";
        }
        if(org == 10)
        {
                orG = "Paramedicos"; // Migrado a Org 10 - organizacion medica oficial
        }
        if(org == 11)
        {
                orG = "Reporteros";
        }
        if(org == 12) { strcpy(orG, GangOrgNombre[4]); }
        if(org == 13) { strcpy(orG, GangOrgNombre[5]); }
        if(org == 14)
        {
                orG = "Ejercito Nacional";
        }
        return orG;
}

stock GetPlayer2DZone2(playerid, zone[], len)
{
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        for(new i = 0; i != sizeof(gSAZones); i++)
        {
                if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4])
                {
                        return format(zone, len, gSAZones[i][SAZONE_NAME], 0);
                }
        }
        return 0;
}

stock GetPlayerCaja(playerid)
{
        new Float:px, Float:py, Float:pz;

        for(new Caja = 1; Caja < MAX_CajaS; Caja++)
        {
                GetDynamicObjectPos(CajaInfo[Caja][Caja_Object], px, py, pz);
                if(IsPlayerInRangeOfPoint(playerid, 5.0, px, py, pz))
                        return Caja;
        }
        return 0;
}

stock CreateCaja(objectid, Float:x, Float:y, Float:z, Float:rotx, Float:roty, Float:rotz)
{
        if(Cajaid >= MAX_CajaS)return 0;

    CajaInfo[Cajaid][Caja_Object] = CreateDynamicObject(objectid, x, y, z, rotx, roty, rotz);
    CajaInfo[Cajaid][Caja_Dinheiro] = 0;
    CajaInfo[Cajaid][Caja_Roubada] = false;

        new Float:pX, Float:pY, Float:pZ;

        GetDynamicObjectPos(CajaInfo[Cajaid][Caja_Object], pX, pY, pZ);
        GetXYInFrontOfCaja(CajaInfo[Cajaid][Caja_Object], pX, pY, 1.0);
        CajaInfo[Cajaid][Caja_Pickup] = CreatePickup(1274 , 1, pX,pY,pZ);
        CajaInfo[Cajaid][Caja_Text] = Create3DTextLabel("{FFFFFF}Caja Registradora\n{FFFFFF}Aprete '{FFFF00}F{FFFFFF}' para tener acceso", 0x33FFFF88, pX, pY, pZ, 15.0, 0);

    Cajaid ++;
        return 0;
}

stock GranaRoubo(playerid, Caja_id)
{
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);

        SetPVarFloat(playerid, "RouboX", x);
        SetPVarFloat(playerid, "RouboY", y);
        SetPVarFloat(playerid, "RouboZ", z);

        RoubandoCaja[playerid] = true;
        ApplyAnimation(playerid,"ROB_BANK","CAT_Safe_Rob",4.1,1,0,0,0,1);

        SetTimerEx(#ApplyAnim, 500, 0, "i", playerid);
        SetTimerEx("PegarMoney", 10000, 0, "id", playerid, Caja_id);
        return 0;
}

stock ConvertTimeX(number)
{
        new hours = 0, mins = 0, secs = 0, string[100];
        hours = floatround(number / 3600);
        mins = floatround((number / 60) - (hours * 60));
        secs = floatround(number - ((hours * 3600) + (mins * 60)));
        new days = 0;

        if(hours >= 24)
        {
                days = floatround((hours/24), floatround_floor);
                hours = hours % 24;
        }

        if(days > 0)
        {
                format(string, 100, "%d dias, %02d:%02d:%02d", days, hours, mins, secs);
        }
        else if(hours > 0)
        {
                format(string, 100, "%02d:%02d:%02d", hours, mins, secs);
        }
        else
        {
                format(string, 100, "%02d", secs);
        }
        return string;
}

