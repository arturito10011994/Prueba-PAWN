                // no tenian spawn, impidiendo a los paramedicos alquilar vehiculo en esas zonas.
                // Coordenadas de spawn approximadas (cerca del hospital, en la calle).
                else if(PlayerToPoint(3.0, playerid, 2035.9244, -1413.1837, 17.1843) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 2 LS General
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
