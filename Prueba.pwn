CallBack::RecuperarHP(playerid)
{
        new Float:health;
        GetPlayerHealth(playerid,health);
        if(health > 99)
        {
                ClearAnimations(playerid);
                TogglePlayerControllable(playerid, 1);
        }
        else
        {
                SetPlayerHealth(playerid, health+10);
                SetTimerEx("RecuperarHP",5000,false,"i",playerid);
        }
        return 1;
}

CallBack:: EstaSegurandoArmaProibida(playerid)
{
    new idArma = GetPlayerWeapon(playerid);

    for (new i = 0; i < sizeof(ArmaProibidaIDs); i++)
    {
        if (idArma == ArmaProibidaIDs[i])
            return true;
    }

    return false;
}

stock MsgSdx(){
        new retorno[248],msg = random(5);
        switch(msg){
                case 0:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Hola, gracias por traer mi paquete!";
                }
                case 1:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Wow, eres muy rapido!";
                }
                case 2:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Muchas gracias, que tengas buen turno.";
                }
                case 3:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Menos mal que mi paquete llego bien jaja..";
                }
                case 4:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Hola, como le va senor/a?";
                }
                case 5:{
                        retorno = "{FFFF00}Vecino/a\n{FFFFFF}Perdoname, recibe bien en los correos?";
                }
        }
        return retorno;
}

// FIX P2-1 + P2-5 + P2-6: guard profesion/servicio + skin valida + mundo/interior.
CallBack::BatendoPorta(playerid, progress){
                // P2-1: si el jugador ya no es repartidor o cerro servicio, abortar.
                if(PlayerInfo[playerid][pProfissao] != 8 || !EmServico[playerid]) return 1;
                if(!IsPlayerConnected(playerid)) return 1;

                // P2-6: skin valida de tabla blanca (antes random(311) podia dar IDs inexistentes).
                new SkinActor = Correos_ValidActorSkins[random(sizeof(Correos_ValidActorSkins))], txt[148];
                new engine, lights, alarm, doors, bonnet, boot, objective, idv = VeiculoCivil[playerid];
                if(!IsValidVehicle(idv))
                {
                        ErrorMsg(playerid, "Tu furgoneta ya no existe. Reinicia la ruta.");
                        Correos_FlushPlayer(playerid);
                        return 1;
                }
                GetVehicleParamsEx(idv, engine, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(idv, engine, lights, alarm, doors, bonnet, 1, objective);
                GetVehicleTrunkPosition(VeiculoCivil[playerid], PosV[0], PosV[1], PosV[2]);
                SetPlayerCheckpoint(playerid, PosV[0], PosV[1], PosV[2], 1);
                Casavehcorreios[playerid] = true;
                // Repartidor libre para ir a la van a buscar la caja
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                // Usar la posicion del checkpoint de entrega (puerta de la casa) para el actor
                new Float:cpX = GetPVarFloat(playerid, "CheckCasaX");
                new Float:cpY = GetPVarFloat(playerid, "CheckCasaY");
                new Float:cpZ = GetPVarFloat(playerid, "CheckCasaZ");
                new Float:cpA = GetPVarFloat(playerid, "CheckCasaA");
                format(txt, sizeof(txt), "%s", MsgSdx());
                // P2-5: actor y label en el mundo/interior correctos del jugador.
                new world = GetPlayerVirtualWorld(playerid);
                new interior = GetPlayerInterior(playerid);
                actorcorreios[playerid] = CreateActor(SkinActor, cpX, cpY, cpZ, cpA);
                SetActorVirtualWorld(actorcorreios[playerid], world);
                SetActorInvulnerable(actorcorreios[playerid], true);
                textcorreios[playerid] = CreateDynamic3DTextLabel(txt, -1, cpX, cpY, cpZ + 0.7, 15.0,
                        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, world, interior);
                InfoMsg(playerid, "El vecino salio de la casa. Ve a la van a buscar su caja y entregasela.");
        return 1;
}

// Funcion auxiliar distancia 2D (declarada aqui para evitar warning 208)
stock Float:GetDistance2D(Float:x1, Float:y1, Float:x2, Float:y2)
{
        return floatsqroot(((x2-x1)*(x2-x1)) + ((y2-y1)*(y2-y1)));
}

// =============================================================
// HELPERS CORREOS (profissao 8) - refactor arquitectonico
// =============================================================

// FIX P0-2: destruir los 10 objetos attachados a la van del jugador.
// Debe llamarse SIEMPRE antes de DestroyVehicle(VeiculoCivil[playerid]).
stock DestroyCorreosVanObjects(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        for(new i = 0; i < CORREOS_VAN_SLOTS; i++)
        {
                if(IsValidDynamicObject(g_CorreosVanObj[playerid][i]))
                        DestroyDynamicObject(g_CorreosVanObj[playerid][i]);
                // FIX: -1 es el valor invalido universal para objetos del streamer.
                // (STREAMER_INVALID_ID no existe en versiones antiguas del plugin; INVALID_STREAMER_ID en nuevas).
                g_CorreosVanObj[playerid][i] = -1;
        }
        return 1;
}

// FIX P0-3 + P2-9: flush centralizado de TODO el estado de Correos.
// Llamar en: OnPlayerDisconnect, OnPlayerDeath, /salirtrabajo, /fixme, /uniforme (off).
stock Correos_FlushPlayer(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;

        // 1. Timers pendientes
        new t = GetPVarInt(playerid, "VanDestroyTimer");
        if(t != -1) { KillTimer(t); SetPVarInt(playerid, "VanDestroyTimer", -1); }
        // FIX SPRINT1 C-10: matar los 5 timers de progreso de Correos.
        // Antes: si el jugador desconectaba con un timer de progreso pendiente
        // (2-10s), el callback disparaba sobre el nuevo slot reusado, recreando
        // estado Correos (EntregaFinalCP=1, CP en HQ Correos) y cobrando $80
        // al nuevo jugador sin haber completado la ruta.
        if(g_BatendoPortaTmr[playerid] != -1) { KillTimer(g_BatendoPortaTmr[playerid]); g_BatendoPortaTmr[playerid] = -1; }
        if(g_EntregandoCxTmr[playerid] != -1) { KillTimer(g_EntregandoCxTmr[playerid]); g_EntregandoCxTmr[playerid] = -1; }
        if(g_PegandoCajasPTmr[playerid] != -1) { KillTimer(g_PegandoCajasPTmr[playerid]); g_PegandoCajasPTmr[playerid] = -1; }
        if(g_ColocandoCajaTmr[playerid] != -1) { KillTimer(g_ColocandoCajaTmr[playerid]); g_ColocandoCajaTmr[playerid] = -1; }
        if(g_PegandoCajaVTmr[playerid] != -1) { KillTimer(g_PegandoCajaVTmr[playerid]); g_PegandoCajaVTmr[playerid] = -1; }

        // 2. Actor del vecino (FIX: antes quedaba vivo hasta GMX)
        if(IsValidActor(actorcorreios[playerid]))
        {
                ClearActorAnimations(actorcorreios[playerid]);
                DestroyActor(actorcorreios[playerid]);
        }
        actorcorreios[playerid] = INVALID_ACTOR_ID;

        // 3. Label 3D del vecino
        if(textcorreios[playerid] != Text3D:INVALID_3DTEXT_ID)
        {
                if(IsValidDynamic3DTextLabel(textcorreios[playerid]))
                        DestroyDynamic3DTextLabel(textcorreios[playerid]);
        }
        textcorreios[playerid] = Text3D:INVALID_3DTEXT_ID;

        // 4. Objetos attachados a la van (FIX P0-2: antes se leaked)
        DestroyCorreosVanObjects(playerid);

        // 5. Cajas-objeto del almacen (PlayerObject)
        for(new i = 1; i <= 10; i++)
        {
                if(IsValidPlayerObject(playerid, CajasSdxObj[playerid][i]))
                        DestroyPlayerObject(playerid, CajasSdxObj[playerid][i]);
                CajasSdxObj[playerid][i] = INVALID_OBJECT_ID;
        }

        // 6. Caja en mano (attached object slot 1)
        RemovePlayerAttachedObject(playerid, 1);

        // 7. Vehiculo
        // FIX AUDIT CORREOS A4-06 + ALTOS-VERIFY-A2: validar modelo antes de DestroyVehicle
        // Y siempre limpiar g_CorreosVehicleOwner aunque el modelo no coincida.
        // Antes: si la van fue destruida por evento externo (explosion, /rtc admin)
        // y el vehicleid fue reusado por otro sistema (e.g., camion de Camionero),
        // DestroyVehicle destruiria el vehiculo EQUIVOCADO.
        // Ahora: solo destruir si el modelo coincide con CORREOS_VAN_MODEL (413).
        // FIX ALTOS-VERIFY-A2 (stale state): siempre limpiar g_CorreosVehicleOwner[vehicleid]
        // incluso si no destruimos. Si no limpiamos y SA-MP reusa el vehicleid para
        // otro vehiculo (Camionero, civil, etc.), el lookup O(1) bloquearia falsamente
        // al nuevo dueÃ¯Â¿Â½o con "Esta van pertenece a un cartero".
        if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(VeiculoCivil[playerid]))
        {
                // FIX AUDIT CORREOS A5-01: limpiar registro de dueÃ¯Â¿Â½o SIEMPRE.
                g_CorreosVehicleOwner[VeiculoCivil[playerid]] = INVALID_PLAYER_ID;
                // Solo destruir si el modelo coincide con van de Correos.
                if(GetVehicleModel(VeiculoCivil[playerid]) == CORREOS_VAN_MODEL)
                        DestroyVehicle(VeiculoCivil[playerid]);
        }
        VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
        // FIX AUDIT CORREOS A4-03: resetear VehAlugado para evitar soft-lock post-flush.
        // Antes: el jugador hacia /uniforme off, OnPlayerDeath, /salirtrabajo, /cancelarcorreos
        // o /fixme, y VehAlugado quedaba en 1, bloqueando cualquier nuevo alquiler.
        // Workaround previo: /dvehiculo. Ahora: reset automatico.
        VehAlugado[playerid] = 0;

        // 8. PVars de Correos
        DeletePVar(playerid, "EntregaPagoPendiente");
        DeletePVar(playerid, "EntregaFinalCP");
        DeletePVar(playerid, "CheckCasaX");
        DeletePVar(playerid, "CheckCasaY");
        DeletePVar(playerid, "CheckCasaZ");
        DeletePVar(playerid, "CheckCasaA");
        DeletePVar(playerid, "LastVanId");

        // 9. Flags
        EntregaSdx[playerid] = false;
        CajaMao[playerid] = false;
        Casavehcorreios[playerid] = false;
        Casavehcorreios2[playerid] = false;
        checkcasa[playerid] = false;
        PegandoCajas[playerid] = false;
        CajasSdx[playerid] = 0;
        EntregasTotales[playerid] = 0;
        EntregaDistTotal[playerid] = 0.0;
        EntregaPosUltX[playerid] = 0.0;
        EntregaPosUltY[playerid] = 0.0;
        PegouVehProf[playerid] = false;
        g_CorreosRutaActiva[playerid] = false;
        g_LastDriverVeh[playerid] = INVALID_VEHICLE_ID;

        // 10. Estado visual del jugador
        DisablePlayerCheckpoint(playerid);
        // FIX AUDIT ANIM ANIM-VERIFY-4 (CRITICO): no unfreezar algemado/herido.
        SafeUnfreeze(playerid);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        ClearAnimations(playerid);
        return 1;
}

// =====================================================================
// FIX SPRINT2 A-02: flushers dedicados anÃ¯Â¿Â½logos a Correos_FlushPlayer.
// Antes el flush de Empaquetador/Camionero estaba inline en /salirtrabajo,
// OnPlayerDeath, OnVehicleDeath - cada sitio tenÃ¯Â¿Â½a que copiar 10-20 lÃ¯Â¿Â½neas
// de reset. Si se aÃ¯Â¿Â½adÃ¯Â¿Â½a una nueva variable habÃ¯Â¿Â½a que tocar 4 sitios.
// Ahora: un Ã¯Â¿Â½nico punto de cambio. Llamar desde cualquier cleanup.
// =====================================================================
stock Empaquetador_FlushPlayer(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        // FIX SPRINT2 A-14: matar timer de abandono si esta activo
        if(g_EmpAbandonoTmr[playerid] != -1)
        {
                KillTimer(g_EmpAbandonoTmr[playerid]);
                g_EmpAbandonoTmr[playerid] = -1;
        }
        // FIX AUDIT EMPAQUETADOR EMP-A1-04/A2-01: matar timer EmpaquetadorProxTienda.
        if(g_EmpProxTiendaTmr[playerid] != -1)
        {
                KillTimer(g_EmpProxTiendaTmr[playerid]);
                g_EmpProxTiendaTmr[playerid] = -1;
        }
        // FIX FREEZE: matar timer de congelacion de vehiculo al limpiar ruta legacy.
        if(g_EmpFreezeTmr[playerid] != -1)
        {
                KillTimer(g_EmpFreezeTmr[playerid]);
                g_EmpFreezeTmr[playerid] = -1;
        }
        g_EmpVehiculoCongelado[playerid] = 0;
        EmpaquetadorActivo[playerid] = false;
        EmpaquetadorEntregas[playerid] = 0;
        EmpaquetadorTienda[playerid] = 0;
        if(IsValidVehicle(EmpaquetadorVehiculo[playerid]))
        {
                DestroyVehicle(EmpaquetadorVehiculo[playerid]);
        }
        // FIX SPRINT3 B-14: si VeiculoCivil apunta al mismo vehiculo, resetearlo tambien.
        if(VeiculoCivil[playerid] == EmpaquetadorVehiculo[playerid])
        {
                VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
                VehAlugado[playerid] = 0;
        }
        EmpaquetadorVehiculo[playerid] = INVALID_VEHICLE_ID;
        DisablePlayerCheckpoint(playerid);
        // FIX AUDIT EMPAQUETADOR EMP-A4-05/A5: descongelar al jugador si estaba freezado mid-cobro.
        SafeUnfreeze(playerid);  // M-04 alineado
        return 1;
}

stock Camionero_FlushPlayer(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        // FIX SPRINT2 A-14: matar timer de abandono si esta activo
        if(g_CamionAbandonoTmr[playerid] != -1)
        {
                KillTimer(g_CamionAbandonoTmr[playerid]);
                g_CamionAbandonoTmr[playerid] = -1;
        }
        // Matar timer de reconexiÃ¯Â¿Â½n si estÃ¯Â¿Â½ activo
        if(CamionReconTmr[playerid] != -1)
        {
                KillTimer(CamionReconTmr[playerid]);
                CamionReconTmr[playerid] = -1;
        }
        // Destruir truck trackeado en CamionVehId
        if(CamionVehId[playerid] != -1 && IsValidVehicle(CamionVehId[playerid]))
                DestroyVehicle(CamionVehId[playerid]);
        CamionVehId[playerid] = -1;
        // FIX SPRINT1 C-12: tambiÃ¯Â¿Â½n resetear VeiculoCivil (truck original puede seguir vivo)
        if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(VeiculoCivil[playerid]))
                DestroyVehicle(VeiculoCivil[playerid]);
        VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
        VehAlugado[playerid] = 0;
        // Reset de flags
        Cargase[playerid] = false;
        Carregou[playerid] = 0;
        CamionCargando[playerid] = false;
        CamionDescargando[playerid] = false;
        CamionEnRuta[playerid] = false;
        CamionPago[playerid] = 0;
        // PVars
        DeletePVar(playerid, "CamionCobro");
        DeletePVar(playerid, "CamionPagoPendiente");
        DeletePVar(playerid, "CamionTruckVeh"); // FIX SPRINT1 C-07
        DisablePlayerCheckpoint(playerid);
        // FIX AUDIT CAMIONERO CAM-A1-03/CAM-A2-03 (ALTO): descongelar al jugador si estaba freezado.
        // Antes: si Camionero_FlushPlayer se llamaba mid-carga/descarga (truck destruido, abandono, etc.),
        // los timers FinCargaCamion/FinDescargaCamion early-returneaban (CamionCargando/Descargando=false)
        // y NUNCA llegaban al TogglePlayerControllable(true). El jugador quedaba soft-lockeado hasta /fixme.
        // TogglePlayerControllable(1) es idempotente: si ya estaba freezado, no hace nada; si no, lo descongela.
        SafeUnfreeze(playerid);  // M-04 alineado
        return 1;
}

// =====================================================================
// SISTEMA SEPULTURERO - Funciones helper
// =====================================================================

// Verifica si hay al menos un Sepulturero conectado (para decidir si crear cadaveres).
stock Sepulturero_HayConectado()
{
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && pLogado[i] && PlayerInfo[i][pProfissao] == 10)
                        return 1;
        }
        return 0;
}

// Crea un cadaver en la posicion del jugador muerto.
stock Sepulturero_CrearCadaver(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        // Buscar slot libre
        new slot = -1;
        for(new i = 0; i < MAX_CADAVERES; i++)
        {
                if(g_CadaveresActivo[i] == 0) { slot = i; break; }
        }
        // Si no hay slot libre, sobrescribir el mas viejo
        if(slot == -1)
        {
                new oldestTime = 0x7FFFFFFF;
                for(new i = 0; i < MAX_CADAVERES; i++)
                {
                        if(g_CadaveresTiempo[i] < oldestTime) { oldestTime = g_CadaveresTiempo[i]; slot = i; }
                }
                Sepulturero_EliminarCadaver(slot);
        }
        // Obtener posicion de muerte
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        z += 0.5; // Elevar un poco para que no quede bajo tierra
        // Guardar datos
        g_CadaveresPos[slot][0] = x;
        g_CadaveresPos[slot][1] = y;
        g_CadaveresPos[slot][2] = z;
        g_CadaveresTiempo[slot] = gettime();
        g_CadaveresActivo[slot] = 1;
        // Nombre del jugador muerto
        new nombre[24];
        GetPlayerName(playerid, nombre, sizeof(nombre));
        format(g_CadaveresNombre[slot], 24, "%s", nombre);
        // Crear pickup visual (modelo 3092 = bolsa de cuerpo)
        g_CadaveresPickup[slot] = CreateDynamicPickup(3092, 23, x, y, z, -1, -1, -1, 200.0);
        // Crear texto 3D "Cadaver de [nombre]"
        new labelStr[80];
        format(labelStr, sizeof(labelStr), "{FF0000}Cadaver de {FFFFFF}%s\n{FFFF00}Sepulturero: presiona F para recoger", nombre);
        g_CadaveresLabel[slot] = Create3DTextLabel(labelStr, 0xFF0000FF, x, y, z + 1.0, 15.0, 0);
        // Timer de expiracion (5 minutos)
        if(g_CadaveresTimer[slot] != -1) KillTimer(g_CadaveresTimer[slot]);
        g_CadaveresTimer[slot] = SetTimerEx("Sepulturero_CadaverExpira", CADAVER_LIFETIME_MS, false, "i", slot);
        // Notificar a todos los Sepultureros conectados
        new msg[128];
        format(msg, sizeof(msg), "[SEPULTURERO] Nuevo cadaver en (%.0f, %.0f, %.0f). Ve a recogerlo.", x, y, z);
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && pLogado[i] && PlayerInfo[i][pProfissao] == 10)
                {
                        InfoMsg(i, msg);
                        // Si no tiene cadaver en mano, setear CP automatico al nuevo cadaver
                        if(g_SepultureroTieneCadaver[i] == 0 && g_SepultureroEnHospital[i] == 0)
                        {
                                SetPlayerCheckpoint(i, x, y, z, 5.0);
                        }
                }
        }
        return slot + 1; // Retornar 1-based (0 = error)
}

// Elimina un cadaver del mapa (cuando se recoge o expira).
stock Sepulturero_EliminarCadaver(slot)
{
        if(slot < 0 || slot >= MAX_CADAVERES) return 0;
        if(g_CadaveresActivo[slot] == 0) return 0;
        if(g_CadaveresPickup[slot] != -1) { DestroyDynamicPickup(g_CadaveresPickup[slot]); g_CadaveresPickup[slot] = -1; }
        if(g_CadaveresLabel[slot] != Text3D:INVALID_3DTEXT_ID) { Delete3DTextLabel(g_CadaveresLabel[slot]); g_CadaveresLabel[slot] = Text3D:INVALID_3DTEXT_ID; }
        if(g_CadaveresTimer[slot] != -1) { KillTimer(g_CadaveresTimer[slot]); g_CadaveresTimer[slot] = -1; }
        g_CadaveresActivo[slot] = 0;
        g_CadaveresTiempo[slot] = 0;
        return 1;
}

// Callback: cadaver expira (5 minutos sin ser recogido).
CallBack::Sepulturero_CadaverExpira(slot)
{
        Sepulturero_EliminarCadaver(slot);
        return 1;
}

// Encuentra el hospital mas cercano a una posicion y retorna su ID (1=LS, 2=LV, 3=SF).
stock Sepulturero_HospitalCercano(Float:x, Float:y, Float:z)
{
        new bestId = 1;
        new Float:bestDist = 999999.0;
        for(new i = 0; i < 3; i++)
        {
                new Float:dx = x - SepultureroHospitales[i][0];
                new Float:dy = y - SepultureroHospitales[i][1];
                new Float:dz = z - SepultureroHospitales[i][2];
                new Float:dist = floatsqroot(dx*dx + dy*dy + dz*dz);
                if(dist < bestDist) { bestDist = dist; bestId = i + 1; }
        }
        return bestId;
}

// Flush del Sepulturero (llamar en disconnect, death, /salirtrabajo, /fixme).
stock Sepulturero_FlushPlayer(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        // Matar timer de hospital
        if(g_SepultureroHospitalTmr[playerid] != -1) { KillTimer(g_SepultureroHospitalTmr[playerid]); g_SepultureroHospitalTmr[playerid] = -1; }
        // Si llevaba un cadaver, liberarlo (eliminar del mapa - el cadaver se pierde)
        if(g_SepultureroTieneCadaver[playerid] > 0)
        {
                Sepulturero_EliminarCadaver(g_SepultureroTieneCadaver[playerid] - 1);
        }
        // Reset estado
        g_SepultureroTieneCadaver[playerid] = 0;
        g_SepultureroEnHospital[playerid] = 0;
        g_SepultureroPagoPendiente[playerid] = 0;
        g_SepultureroHospitalOrigen[playerid] = 0;
        // No resetear g_SepultureroRacha (se mantiene entre sesiones como en Minero)
        // No resetear g_SepultureroLastRecoger (cooldown se resetea en ZerarDados)
        DisablePlayerCheckpoint(playerid);
        // Descongelar si estaba esperando en hospital
        SafeUnfreeze(playerid);  // M-04 alineado
        return 1;
}

// Callback: fin de espera en hospital (30s).
CallBack::SepultureroFinHospital(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        g_SepultureroHospitalTmr[playerid] = -1;
        if(PlayerInfo[playerid][pProfissao] != 10) return 1;
        if(g_SepultureroEnHospital[playerid] != 1) return 1;
        g_SepultureroEnHospital[playerid] = 0;
        // Descongelar
        SafeUnfreeze(playerid);  // M-04 alineado
        // Setear CP al cementerio (punto de cobro)
        SetPlayerCheckpoint(playerid, SEPULTURERO_NPC_X, SEPULTURERO_NPC_Y, SEPULTURERO_NPC_Z, 5.0);
        GameTextForPlayer(playerid, "~g~Certificado listo!~n~~w~Lleva el cadaver al cementerio", 4000, 5);
        SuccesMsg(playerid, "Certificado de defuncion listo. Lleva el cadaver al cementerio para cobrar.");
        return 1;
}

// =====================================================================
// SISTEMA RECOLECTOR NIVEL 2 - Helper para modelo aleatorio de laton
// =====================================================================
// Retorna 1331 o 1339 aleatoriamente (latones de basura grandes)
stock RecNivel2_ModeloLaton()
{
        return (random(2) == 0) ? 1331 : 1339;
}

// =====================================================================
// SISTEMA RECOLECTOR NIVEL 2 - Callback recoger basura (3s en CP)
// =====================================================================
CallBack::RecNivel2RecogerBasura(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        g_RecNivel2RecogerTmr[playerid] = -1;
        if(PlayerInfo[playerid][pProfissao] != 6) return 1;
        if(!g_RecNivel2Activo[playerid]) return 1;
        if(g_RecNivel2EsperandoDescarga[playerid]) return 1;
        // Verificar que sigue en rango del punto actual
        new puntoActual = g_RecNivel2Punto[playerid];
        if(puntoActual >= RECOLECTOR_NIVEL2_PAGOS) return 1;
        if(!IsPlayerInRangeOfPoint(playerid, RECOLECTOR_NIVEL2_RADIO_CP, RecolectorRutaPuntos[puntoActual][0], RecolectorRutaPuntos[puntoActual][1], RecolectorRutaPuntos[puntoActual][2]))
        {
                InfoMsg(playerid, "Te alejaste del punto. Vuelve e intenta de nuevo.");
                return 1;
        }
        // Recoger basura
        g_RecNivel2Recogidos[playerid]++;
        // Destruir laton
        if(g_RecNivel2LatonObj[playerid] != -1) { DestroyDynamicObject(g_RecNivel2LatonObj[playerid]); g_RecNivel2LatonObj[playerid] = -1; }
        g_RecNivel2LatonPunto[playerid] = -1;
        DisablePlayerCheckpoint(playerid);
        new msg[128];
        format(msg, sizeof(msg), "Basura %d/11 recogida.", g_RecNivel2Recogidos[playerid]);
        SuccesMsg(playerid, msg);
        // Avanzar al siguiente punto
        g_RecNivel2Punto[playerid]++;
        if(g_RecNivel2Punto[playerid] >= RECOLECTOR_NIVEL2_PAGOS)
        {
                // Todos los puntos recogidos -> CP al punto de descarga
                SetPlayerCheckpoint(playerid, RECOLECTOR_DESCARGA_X, RECOLECTOR_DESCARGA_Y, RECOLECTOR_DESCARGA_Z, 8.0);
                SuccesMsg(playerid, "Todos los puntos recogidos. Lleva la basura al punto de descarga (-27, 1411).");
                GameTextForPlayer(playerid, "~g~Basura completa!~n~~w~Ve a descargar", 4000, 5);
        }
        else
        {
                // Siguiente punto + nuevo laton
                new sigPunto = g_RecNivel2Punto[playerid];
                SetPlayerCheckpoint(playerid, RecolectorRutaPuntos[sigPunto][0], RecolectorRutaPuntos[sigPunto][1], RecolectorRutaPuntos[sigPunto][2], RECOLECTOR_NIVEL2_RADIO_CP);
                g_RecNivel2LatonObj[playerid] = CreateDynamicObject(RecNivel2_ModeloLaton(), RecolectorRutaPuntos[sigPunto][0], RecolectorRutaPuntos[sigPunto][1], RecolectorRutaPuntos[sigPunto][2] - 1.0, 0.0, 0.0, RecolectorRutaPuntos[sigPunto][3], -1, -1, -1, 100.0, 100.0);
                g_RecNivel2LatonPunto[playerid] = sigPunto;
                new msg2[128];
                format(msg2, sizeof(msg2), "~g~Punto %d/11 recogido!~n~~w~Siguiente punto marcado", g_RecNivel2Recogidos[playerid]);
                GameTextForPlayer(playerid, msg2, 3000, 5);
        }
        return 1;
}

// =====================================================================
// SISTEMA RECOLECTOR NIVEL 2 - Callback fin descarga (10s)
// =====================================================================
CallBack::RecNivel2FinDescarga(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        g_RecNivel2DescargaTmr[playerid] = -1;
        if(PlayerInfo[playerid][pProfissao] != 6) return 1;
        if(g_RecNivel2EsperandoDescarga[playerid] != 1) return 1;
        // Descarga completada -> estado 4 = ir al punto final a dejar el camion.
        g_RecNivel2EsperandoDescarga[playerid] = 4;
        SafeUnfreeze(playerid);  // M-04 alineado
        // CP al punto final (-35, 1374) donde el camion desaparecera.
        SetPlayerCheckpoint(playerid, RECOLECTOR_COBRO_X, RECOLECTOR_COBRO_Y, RECOLECTOR_COBRO_Z, 5.0);
        GameTextForPlayer(playerid, "~g~Descarga completada!~n~~w~Lleva el camion al punto final", 4000, 5);
        SuccesMsg(playerid, "Descarga completada. Lleva el camion al punto final marcado para devolverlo.");
        return 1;
}

// FIX SPRINT2 A-02: helper unificado que limpia TODOS los trabajos.
// Llamar en: OnPlayerDisconnect, OnPlayerDeath, OnPlayerSpawn, /salirtrabajo,
// /dvehiculo, /fixme, OnVehicleDeath (jugador dueÃ¯Â¿Â½o). Reemplaza la dispersiÃ¯Â¿Â½n
// de lÃ¯Â¿Â½gica de cleanup que causÃ¯Â¿Â½ los bugs C-01, C-08, A-01 del PDF original.
stock FlushPlayerJobs(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        // FIX AUDIT PESCADOR P-A2-05: matar timers Pesca en flush.
        Pesca_KillTimers(playerid);
        // Carnicero
        if(Desossando[playerid] > 0)
        {
                if(IsValidDynamicObject(ObjetoAcougue[playerid][0])) DestroyDynamicObject(ObjetoAcougue[playerid][0]);
                if(IsValidDynamicObject(ObjetoAcougue[playerid][1])) DestroyDynamicObject(ObjetoAcougue[playerid][1]);
                Desossando[playerid] = 0;
        }
        // Empaquetador
        Empaquetador_FlushPlayer(playerid);
        // SISTEMA EMPAQUETADOR REDISEÃ¯Â¿Â½ADO: flush del nuevo sistema.
        if(g_EmpCajaObj[playerid] != -1) { DestroyDynamicObject(g_EmpCajaObj[playerid]); g_EmpCajaObj[playerid] = -1; }
        if(g_EmpDescargaTmr[playerid] != -1) { KillTimer(g_EmpDescargaTmr[playerid]); g_EmpDescargaTmr[playerid] = -1; }
        if(g_EmpRecogerTmr[playerid] != -1) { KillTimer(g_EmpRecogerTmr[playerid]); g_EmpRecogerTmr[playerid] = -1; }
        // Cleanup timer de congelacion de vehiculo
        if(g_EmpFreezeTmr[playerid] != -1) { KillTimer(g_EmpFreezeTmr[playerid]); g_EmpFreezeTmr[playerid] = -1; }
        g_EmpVehiculoCongelado[playerid] = 0;
        if(g_EmpVehiculoAsignado[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(g_EmpVehiculoAsignado[playerid]))
        {
                DestroyVehicle(g_EmpVehiculoAsignado[playerid]);
                g_EmpVehiculoAsignado[playerid] = INVALID_VEHICLE_ID;
        }
        g_EmpRutaActiva[playerid] = 0;
        g_EmpNivelActual[playerid] = 0;
        g_EmpEntregasHechas[playerid] = 0;
        g_EmpEntregasTotales[playerid] = 0;
        g_EmpEsperandoDescarga[playerid] = 0;
        g_EmpTieneCaja[playerid] = 0;
        g_EmpCajaActivaIdx[playerid] = -1;
        g_EmpFaseEntrega[playerid] = 0;
        if(g_EmpCajaAttachedObj[playerid] != -1) { DestroyDynamicObject(g_EmpCajaAttachedObj[playerid]); g_EmpCajaAttachedObj[playerid] = -1; }
        g_EmpTiendasUsadas[playerid] = 0;
        g_EmpCajasUsadas[playerid] = 0;
        // Correos (usar flusher dedicado existente)
        if(PlayerInfo[playerid][pProfissao] == 8 || g_CorreosRutaActiva[playerid])
                Correos_FlushPlayer(playerid);
        // Camionero
        Camionero_FlushPlayer(playerid);
        // FIX SEPULTURERO: flush del Sepulturero (limpia timer de hospital, libera cadaver, reset estado).
        Sepulturero_FlushPlayer(playerid);
        // Minero
        EtapasMinerador[playerid] = 0;
        TemMinerio[playerid] = 0;
        // FIX: NO resetear g_RocaCounter ni g_FatigaMinero aqui.
        // Se resetean solo en OnPlayerDisconnect/ZerarDados para no perder el contador
        // cuando el jugador spawnea o muere.
        // Recolector
        PegouLixo[playerid] = false;
        Covaconcerto[playerid] = false;
        // FIX AUDIT RECOLECTOR REC-A1-02/A2-01/A4-05/A5-02: matar timers Cova/BotouBau en flush.
        // Antes: timers fire-and-forget, no se podian matar. Si el jugador desconectaba mid-timer,
        // el timer disparaba sobre el slot reusado (slot-reuse contamination).
        if(g_CovaTmr[playerid] != -1) { KillTimer(g_CovaTmr[playerid]); g_CovaTmr[playerid] = -1; }
        if(g_BotouBauTmr[playerid] != -1) { KillTimer(g_BotouBauTmr[playerid]); g_BotouBauTmr[playerid] = -1; }
        // SISTEMA RECOLECTOR NIVEL 2: flush completo.
        if(g_RecNivel2LatonObj[playerid] != -1) { DestroyDynamicObject(g_RecNivel2LatonObj[playerid]); g_RecNivel2LatonObj[playerid] = -1; }
        if(g_RecNivel2DescargaTmr[playerid] != -1) { KillTimer(g_RecNivel2DescargaTmr[playerid]); g_RecNivel2DescargaTmr[playerid] = -1; }
        if(g_RecNivel2RecogerTmr[playerid] != -1) { KillTimer(g_RecNivel2RecogerTmr[playerid]); g_RecNivel2RecogerTmr[playerid] = -1; }
        if(g_RecNivel2Vehiculo[playerid] != -1 && IsValidVehicle(g_RecNivel2Vehiculo[playerid]))
        {
                DestroyVehicle(g_RecNivel2Vehiculo[playerid]);
                g_RecNivel2Vehiculo[playerid] = -1;
        }
        g_RecNivel2Activo[playerid] = 0;
        g_RecNivel2Punto[playerid] = 0;
        g_RecNivel2Recogidos[playerid] = 0;
        g_RecNivel2LatonPunto[playerid] = -1;
        g_RecNivel2EsperandoDescarga[playerid] = 0;
        // FIX AUDIT RECOLECTOR REC-A1-01/A3-01/A5-19: reset Podecmd en flush (anti soft-lock).
        // Antes: Podecmd se seteaba false en /iniciarba pero solo se reseteaba en BotouBau (al completar ruta)
        // o en ZerarDados (al desconectar). Si el jugador moria o salia mid-ruta, quedaba bloqueado para siempre.
        Podecmd[playerid] = true;
        // FIX AUDIT RECOLECTOR REC-A2-04: remover attached object slot 7 (basura) en flush.
        RemovePlayerAttachedObject(playerid, 7);
        // Constructor
        PegouMaterial[playerid] = false;
        // Flags transversales
        UsouCMD[playerid] = false;
        EmServico[playerid] = false;
        PegouVehProf[playerid] = false;
        // Attached objects de trabajos (slot 5 = algemas policia NO tocar aquÃ¯Â¿Â½,
        // slot 6 = material Constructor, slot 7 = basura Recolector, slot 9 = pickaxe Minero)
        // FIX SPRINT2 H-A4-01: basura migrada de slot 5 a slot 7 para evitar conflict
        // con algemas (19418) que causaba jailbreak al dispararse BotouBau.
        RemovePlayerAttachedObject(playerid, 7);
        RemovePlayerAttachedObject(playerid, 6);
        // FIX AUDIT CEL MEJORA-2 (ALTO): respetar ownership del slot 9.
        // No remover slot 9 si fue el radio quien lo attacho (no la caja/objeto del Empaquetador).
        if(!g_RadioSlot9Attached[playerid])
                RemovePlayerAttachedObject(playerid, 9);
        // slot 1 = caja Carnicero (ya limpiada arriba si Desossando>0, pero defense in depth)
        RemovePlayerAttachedObject(playerid, 1);
        DisablePlayerCheckpoint(playerid);
        return 1;
}

// FIX AUDIT PRENSA: helper para resetear TODO el estado de orgs civiles
stock FlushPlayerOrgFlags(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        reportero[playerid] = false;
        mecanico[playerid] = false;
        paramedico[playerid] = false;
        if(g_ChalecoActivo[playerid]) SetPlayerArmour(playerid, 0.0);
        g_ChalecoPermitido[playerid] = false;
        g_ChalecoActivo[playerid] = false;
        if(PlayerInfo[playerid][Org] == 9 || PlayerInfo[playerid][Org] == 10 || PlayerInfo[playerid][Org] == 11)
        {
                SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                SetPlayerArmour(playerid, 0.0);
                SetPlayerColor(playerid, 0xFFFFFFFF);
        }
        return 1;
}

// FIX P2-13: logging por archivo (DOF2, sin MySQL).
// Registra cada cobro de ruta de Correos para auditoria economica.
stock Correos_LogPago(playerid, monto, Float:dist, cajas)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(!pLogado[playerid]) return 0;

        // Path absoluto relativo al exe: scriptfiles/Logs/Correos_Pagos.log
        // Esto es consistente con el resto del GM (Contas/, Inventarios/, Relatorios/ viven en scriptfiles/).
        // La carpeta scriptfiles/Logs/ debe existir; si no, fopen falla silenciosamente (return 0).
        new File:log = fopen("scriptfiles/Logs/Correos_Pagos.log", io_append);
        if(!log) return 0;

        new hora, minuto, segundo, dia, mes, ano;
        gettime(hora, minuto, segundo);
        getdate(ano, mes, dia);

        new entry[256];
        format(entry, sizeof(entry),
                "[%02d/%02d/%04d %02d:%02d:%02d] %s (ID:%d IDF:%d) - Ruta: %d cajas, Dist: %.1fm, Pago: $%d, VIP:%d\r\n",
                dia, mes, ano, hora, minuto, segundo,
                PlayerName(playerid), playerid, PlayerInfo[playerid][IDF],
                cajas, dist, monto, PlayerInfo[playerid][pVIP]);
        fwrite(log, entry);
        fclose(log);
        return 1;
}

CallBack::PegandoCajaV(playerid, progress){
                // P2-1: guard profesion/servicio.
                if(PlayerInfo[playerid][pProfissao] != 8 || !EmServico[playerid]) return 1;
                if(!IsPlayerConnected(playerid)) return 1;

                // P2-2: manejar CajasSdx == 0 para evitar soft-lock.
                // Antes: el if(CajasSdx > 0) fallaba silenciosamente y dejaba al jugador congelado.
                if(CajasSdx[playerid] <= 0)
                {
                        ErrorMsg(playerid, "No hay cajas restantes en la van. Algo salio mal, ruta reiniciada.");
                        Correos_FlushPlayer(playerid);
                        return 1;
                }
                static Float:aPos[3];
                CajasSdx[playerid]--;
                // Dar CARRY y caja al jugador - queda libre para caminar al vecino
                // FIX AUDIT ANIM ANIM-A4-19 (MEDIO): check pCongelado antes de CARRY.
                if(!PlayerInfo[playerid][pCongelado])
                        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
                SetPlayerAttachedObject(playerid, 1, CORREOS_OBJ_CAJA_MANO, 5, 0.044377, 0.029049, 0.161334, 265.922912, 9.904896, 21.765972, 0.500000, 0.500000, 0.500000);
                // FIX AUDIT ANIM ANIM-VERIFY-2 (CRITICO): no unfreezar algemado.
                SafeUnfreeze(playerid);
                new restantes2 = CajasSdx[playerid];
                new msgvan[128];
                format(msgvan, sizeof(msgvan), "Tomo la Caja. Entregasela al vecino. (%d de entregas restantes)", restantes2);
                InfoMsg(playerid, msgvan);
                if(!IsValidActor(actorcorreios[playerid]))
                {
                        ErrorMsg(playerid, "El vecino ya no esta. Ruta reiniciada.");
                        Correos_FlushPlayer(playerid);
                        return 1;
                }
                GetActorPos(actorcorreios[playerid], aPos[0], aPos[1], aPos[2]);
                Casavehcorreios2[playerid] = true;
                SetPlayerCheckpoint(playerid, aPos[0], aPos[1], aPos[2], 1);
        return 1;
}

