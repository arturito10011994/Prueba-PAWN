                case DIALOG_CATVIPS:
                {
                        if(response)
                        {
                                // FIX ALTO-VIP-007 (ALTO): cooldown de 3s entre compras VIP.
                                // ANTES: sin cooldown. Un jugador podia comprar VIP multiples veces rapidamente.
                                if(gettime() - GetPVarInt(playerid, "CD_VIPPurchase") < VIP_COOLDOWN_PURCHASE_SEC)
                                        return ErrorMsg(playerid, "Espera unos segundos antes de otra compra VIP.");
                                SetPVarInt(playerid, "CD_VIPPurchase", gettime());

                                if(listitem == 0)
                                {
                                        // FIX ALTO-VIP-007: validar downgrade. No permitir comprar VIP inferior al actual.
                                        if(PlayerInfo[playerid][pVIP] >= 1 && IsVIPActive(playerid))
                                                return ErrorMsg(playerid, "Ya tienes VIP igual o superior. Espera a que expire para comprar CLASSIC.");
                                        if(PlayerInfo[playerid][pCoins] < VIP_PRICE_CLASSIC_COINS)         return ErrorMsg(playerid, "Coins insuficiente.");
                                        PlayerInfo[playerid][pCoins] -= VIP_PRICE_CLASSIC_COINS;
                                        PlayerInfo[playerid][ExpiraVIP] = ConvertDays(VIP_CLASSIC_DAYS);
                                        PlayerInfo[playerid][pVIP] = VIP_LEVEL_CLASSIC;
                                        PlayerInfo[playerid][pBanco] += VIP_CLASSIC_BONUS_BANK;
                                        SalvarDados(playerid); SalvarVIP(playerid); // FIX AUDIT3 XS3-08: persistir VIP
                                        SuccesMsg(playerid, "Compraste un VIP CLASSIC y recibiste sus beneficios.");
                                }
                                if(listitem == 1)
                                {
                                        if(PlayerInfo[playerid][pVIP] >= 2 && IsVIPActive(playerid))
                                                return ErrorMsg(playerid, "Ya tienes VIP igual o superior. Espera a que expire para comprar ADVANCED.");
                                        if(PlayerInfo[playerid][pCoins] < VIP_PRICE_ADVANCED_COINS)        return ErrorMsg(playerid, "Coins insuficiente.");
                                        PlayerInfo[playerid][pBanco] += VIP_ADVANCED_BONUS_BANK;
                                        PlayerInfo[playerid][pCoins] -= VIP_PRICE_ADVANCED_COINS;
                                        PlayerInfo[playerid][ExpiraVIP] = ConvertDays(VIP_ADVANCED_DAYS);
                                        PlayerInfo[playerid][pVIP] = VIP_LEVEL_ADVANCED;
                                        PlayerInfo[playerid][pSegundosJogados] += 7200;
                                        SalvarDados(playerid); SalvarVIP(playerid); // FIX AUDIT3 XS3-08: persistir VIP
                                        SuccesMsg(playerid, "Compraste un VIP ADVANCED y recibiste sus beneficios.");
                                }
                                if(listitem == 2)
                                {
                                        if(PlayerInfo[playerid][pVIP] >= 3 && IsVIPActive(playerid))
                                                return ErrorMsg(playerid, "Ya tienes VIP PREMIUM. Espera a que expire para comprar de nuevo.");
                                        if(PlayerInfo[playerid][pCoins] < VIP_PRICE_PREMIUM_COINS)        return ErrorMsg(playerid, "Coins insuficiente.");
                                        PlayerInfo[playerid][pBanco] += VIP_PREMIUM_BONUS_BANK;
                                        PlayerInfo[playerid][pCoins] -= VIP_PRICE_PREMIUM_COINS;
                                        PlayerInfo[playerid][ExpiraVIP] = ConvertDays(VIP_PREMIUM_DAYS);
                                        PlayerInfo[playerid][pVIP] = VIP_LEVEL_PREMIUM;
                                        PlayerInfo[playerid][pSegundosJogados] += 7200+7200;
                                        SalvarDados(playerid); SalvarVIP(playerid); // FIX AUDIT7 VIP-NEW-1: ahora persiste VIP 3
                                        new alevehinv = randomEx(0,1);
                                        if(alevehinv == 0)
                                        {
                                                GanharItem(playerid, 522, 1);
                                                SalvarInventario(playerid);
                                                InfoMsg(playerid, "Recibiste una NRG 500 de su vip.");
                                        }
                                        if(alevehinv == 1)
                                        {
                                                GanharItem(playerid, 560, 1);
                                                SalvarInventario(playerid);
                                                InfoMsg(playerid, "Recibiste un Sultan de su vip.");
                                        }
                                        SuccesMsg(playerid, "Compraste un vip y recibiste sus beneficios.");
                                }
                        }
                }
                case DIALOG_AUTO_ESCOLA:
                {
                        if(response)
                        {
                                // FIX AUDIT LIC LIC-A3-01 (CRITICO): prevenir multi-examen simultaneo.
                                // ANTES: DIALOG_AUTO_ESCOLA no validaba examen ya activo. Si el jugador
                                // tenia IniciouTesteHabilitacaoA=1 y volvia a abrir el menu, podia
                                // iniciar examen B tambien, teniendo 2 examenes activos a la vez.
                                // Esto combinado con LIC-A3-02 permitia obtener licencias gratis.
                                // Ahora: bloquear si hay cualquier examen activo.
                                if(IniciouTesteHabilitacaoA[playerid] == 1
                                   || IniciouTesteHabilitacaoB[playerid] == 1
                                   || IniciouTesteHabilitacaoC[playerid] == 1
                                   || IniciouTesteHabilitacaoD[playerid] == 1
                                   || IniciouTesteHabilitacaoE[playerid] == 1)
                                {
                                        return ErrorMsg(playerid, "Ya tienes un examen en curso. Termina o cancela antes de iniciar otro.");
                                }
                                // FIX AUDIT LIC LIC-A2-04 (CRITICO): validar deuda fiscal en autoescuela.
                                // ANTES: licencias de conducir NO validaban ImpuestoPendiente (asimetria
                                // con Armas/Pesca que SI validan). Jugador con cuenta bancaria bloqueada
                                // podia obtener licencias de conducir. Ahora: bloquear.
                                if(PlayerInfo[playerid][ImpuestoPendiente] > 0) return ErrorMsg(playerid, "El Ayuntamiento informa: No puedes sacar licencias con deuda fiscal pendiente. Paga primero.");
                                // FIX AUDIT LIC LIC-A2-05 (CRITICO): validar pRG en autoescuela.
                                // ANTES: autoescuela no validaba pRG (Documento de Identidad). Jugador sin
                                // documento podia obtener licencias de conducir. Ahora: bloquear.
                                if(PlayerInfo[playerid][pRG] == 0) return ErrorMsg(playerid, "Necesitas tu Documento de Identidad (RG) para sacar licencias. Obtenlo en el Ayuntamiento.");
                                // FIX AUDIT LIC LIC-A4-08 (ALTO): validar estado del jugador en autoescuela.
                                // ANTES: algemado/preso/herido/espectando/muerto podian iniciar examen.
                                if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMsg(playerid, "No puedes iniciar examen espectando.");
                                if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "No puedes iniciar examen estando algemado.");
