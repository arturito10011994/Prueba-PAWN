DroparItem(playerid, slotIndex, quantia)
{
        // FIX AUDIT INV I5-1: rename `modelid` a `slotIndex` (fix cosmetico Sprint 5 DOC).
        // Antes: el parametro se llamaba `modelid`, lo que confundia con itemid (1..30000).
        // En realidad es un slot index del array PlayerInventario (1..32). Los callers
        // (L38905 OnPlayerClickPlayerTextDraw) pasan GetPVarInt(#VarSlotInv) que es el
        // slot clickeado en el inventario. Renombrar aclara el contrato de la funcion.
        // FIX AUDIT INV I0-1: validar quantia > 0. Antes: solo validaba == 0.
        // Un jugador podia entrar "-100" en DIALOG_QTDINV. Unidades -= (-100) = +100 = DUPE.
        if(quantia <= 0) return ErrorMsg(playerid, "La cantidad debe ser mayor que 0.");
        if(PlayerInventario[playerid][slotIndex][Unidades] < quantia) return ErrorMsg(playerid, "Usted no tiene la cantidad requerida.");
        if(IsPlayerConnected(playerid))
        {
                new str[128], Float:x, Float:y, Float:z;
                if(PlayerInventario[playerid][slotIndex][Slot] != -1)
                {
                        ShowItemBox(playerid, ItemNomeInv(PlayerInventario[playerid][slotIndex][Slot]), "Soltar", slotIndex, 3);
                        GetPlayerPos(playerid, x,y,z);
                        for(new i = 0; i < MAX_OBJECTS; i++)
                        {
                                if(DropItemSlot[i][DropItem] == 0)
                                {
                                        DropItemSlot[i][DropItem] = CreateDynamicObject(18631, x,y,z-1, 0, 0, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
                                        DropItemSlot[i][DropItemUni] = quantia;
                                        DropItemSlot[i][DropItemID] = PlayerInventario[playerid][slotIndex][Slot];
                                        DropItemSlot[i][Virtual] = GetPlayerVirtualWorld(playerid);
                                        DropItemSlot[i][Interior] = GetPlayerInterior(playerid);
                                        format(str, sizeof(str), "{FFFF00}%s\n{FFFFFF}X%s", ItemNomeInv(PlayerInventario[playerid][slotIndex][Slot]), ConvertMoney(quantia));
                                        DropItemSlot[i][LabelItem] = CreateDynamic3DTextLabel(str, -1, x,y,z-1, 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
                                        PlayerInventario[playerid][slotIndex][Unidades] -= quantia;
                                        AtualizarInventario(playerid, slotIndex);
                                        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0, 1);
                                        // FIX AUDIT INV I0-2: persistir inmediatamente tras DroparItem.
                                        // Antes: NO llamaba SalvarInventario. Si el server crasheaba antes del SaveTimer,
                                        // el disco tenia la cantidad original = el item se duplicaba al reconectar.
                                        SalvarInventario(playerid);
                                        return 1;
                                }
                        }
                }
        }
        return 0;
}

AtualizarInventario(playerid, i)
{
        new str[64];
        if(PlayerInventario[playerid][i][Unidades] < 1)
        {
                PlayerInventario[playerid][i][Unidades] = 0;
                PlayerInventario[playerid][i][Slot] = -1;
        }
        if(PlayerInventario[playerid][i][Slot] == -1)
        {
                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], "");
                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][i], 0.000000, 0.000000, 0.000000, 999);
        }
        else
        {
                format(str, sizeof(str), "%s - %s unidades", ItemNomeInv(PlayerInventario[playerid][i][Slot]), ConvertMoney(PlayerInventario[playerid][i][Unidades]));
                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], str);
                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][i], 0.000000, 0.000000, 0.000000, 1);
        }
        PlayerTextDrawShow(playerid, DrawInv[playerid][38]);
        PlayerTextDrawShow(playerid, DrawInv[playerid][i]);
        return 1;
}

FuncaoItens(playerid, slotIndex, quantia)//  AQUI VOCÃ¯Â¿Â½ PODE DEFINIR AS FUNÃ¯Â¿Â½Ã¯Â¿Â½ES DE CADA ITEM. SEGUE AS FUNÃ¯Â¿Â½Ã¯Â¿Â½ES PRONTAS ABAIXO
{
        // FIX AUDIT INV I5-1: rename `modelid` a `slotIndex` (fix cosmetico Sprint 5 DOC).
        // Antes: el parametro se llamaba `modelid`, lo que confundia con itemid (1..30000).
        // En realidad es un slot index del array PlayerInventario (1..32). Los callers
        // (L38904 OnPlayerClickPlayerTextDraw) pasan GetPVarInt(#VarSlotInv) que es el
        // slot clickeado en el inventario. Renombrar aclara el contrato de la funcion.
        // FIX AUDIT INV I0-1: validar quantia > 0 globalmente. Antes: solo validaba == 0.
        // Cases de armas (331-371) y item 1212 permitian DUPE con cantidades negativas.
        if(quantia <= 0) return ErrorMsg(playerid, "La cantidad debe ser mayor que 0.");
        new fomesede = randomEx(1,20);
        switch(PlayerInventario[playerid][slotIndex][Slot])
        {
                case 19469:
                {
                        ShowPlayerDialog(playerid, DIALOG_ARRASTARP, DIALOG_STYLE_INPUT, "Agarrar jugador", "Ingresa el ID del jugador que deseas agarrar/soltar", "Segurar", "Soltar");
                }
                case 11750:
                {
                        ShowPlayerDialog(playerid, DIALOG_ALGEMARP, DIALOG_STYLE_INPUT, "Esposar jugador", "Ingresa el ID del jugador que deseas esposar/desesposar", "Algemar", "Soltar");
                }
                case 19942:
                {
                        if(quantia != 1) return ErrorMsg(playerid, "Usted solo consigue utilizar 1 cantidad..");
                        cmd_inventario(playerid);
                        new stringg[50];
                        format(stringg, sizeof(stringg), "%d", FrequenciaConectada[playerid]);
                        PlayerTextDrawSetString(playerid, RadioVOIP[playerid][29], stringg);
                        for(new i; i < 32; i++)
                        {
                                PlayerTextDrawShow(playerid, RadioVOIP[playerid][i]);
                                if(i == 32)break;
                        }
                        SelectTextDraw(playerid, 0xFF0000FF);
                }
                case 19995:
                {
                        if(quantia != 1) return ErrorMsg(playerid, "Usted solo consigue utilizar 1 cantidad..");
                        if(IsBandido(playerid))
                        {
                                // P0-BANDA-FAB: FIX fabrica de armas.
                                // Antes: 5 puntos con radio 1m (casi imposible acertar), sin mensaje
                                // si no estabas en ningun punto, y los bloques en cascada sin return.
                                // Ahora: radio 3m, mensaje de error si no estas en ningun punto,
                                // y return 1 despues de cada intercambio para evitar dobles cobros.
