        return LipeStrondaProfs;
}

stock temlicenca(playerid)
{
        new LipeStrongLicenca[256];
        new bool:alguna = false;
        if(CheckInventario2(playerid, 1853)) { strcat(LipeStrongLicenca, "{00FF00}Moto "); alguna = true; }
        if(CheckInventario2(playerid, 1854)) { strcat(LipeStrongLicenca, "{00FF00}Auto "); alguna = true; }
        if(CheckInventario2(playerid, 1855)) { strcat(LipeStrongLicenca, "{00FF00}Camion "); alguna = true; }
        if(CheckInventario2(playerid, 19857)) { strcat(LipeStrongLicenca, "{00FF00}Trailero "); alguna = true; }
        if(CheckInventario2(playerid, 1856)) { strcat(LipeStrongLicenca, "{00FF00}Aerea "); alguna = true; }
        if(!alguna) { LipeStrongLicenca = "{FF0000}Ninguna"; }
        return LipeStrongLicenca;
}

// =====================================================================
// T2-1: Sistema de cancelacion selectiva de licencia.
// =====================================================================

// Devuelve el item ID de la licencia requerida para conducir el vehiculo
// indicado. Devuelve -1 si el vehiculo no requiere licencia.
// 1853=Moto (Cat A), 1854=Auto (Cat B), 1855=Camion (Cat C),
// 19857=Trailero (Cat E), 1856=Aerea (Cat D)
//
// =====================================================================
// FIX SPRINT4 9.2: Sistema de permisos basado en items.
// Helpers centralizados que abstraen CheckInventario2(playerid, MODELID) para que
// todo el codigo consulte permisos via una unica API. Si en el futuro se migran
// los campos legacy (LicencaConduzir, pCarteiraT) a items de inventario completos,
// solo hay que cambiar la implementacion aqui, no en 30+ sitios.
// Beneficio: fuente unica de verdad para permisos, facilita debugging, permite
// migracion gradual sin romper callers.
//
// Nota: el campo pCarteiraT sigue existiendo en PlayerInfo por persistencia, pero los
// callers ya no lo consultan directamente. Si en el futuro se migra a item de inventario,
// solo hay que cambiar la implementacion de TieneCarnetTrabajo.
// =====================================================================
// =====================================================================

// Item IDs de licencias (centralizados para evitar magic numbers).
#define LIC_ITEM_MOTO        1853   // Cat. A
#define LIC_ITEM_AUTO        1854   // Cat. B
#define LIC_ITEM_CAMION      1855   // Cat. C
#define LIC_ITEM_AEREA       1856   // Cat. D
#define LIC_ITEM_TRAILERO    19857  // Cat. E

// Verifica si el jugador tiene la licencia de conducir para un modelo de vehiculo.
// USO: if(!TieneLicenciaConducir(playerid, GetVehicleModel(veh))) return ErrorMsg(...)
// FIX AUDIT LIC LIC-A4-01 (CRITICO): detectar Trailero (Cat E) cuando el Camion tiene trailer.
// ANTES: GetLicenciaByVehicle devolvia 1855 (Camion Cat C) para el Linerunner (model 403).
// Si el jugador tiene Cat C pero no Cat E, podia conducir Linerunner+trailer sin licencia Trailero.
// Ahora: si el vehiculo es un Camion (model 403/514/515) y tiene trailer acoplado,
// requiere Cat E (19857). Cat E requiere Cat C previa (validado en DIALOG_AUTO_ESCOLA).
stock TieneLicenciaConducir(playerid, vehicleModel)
{
        if(!IsPlayerConnected(playerid)) return 0;
        new licItem = GetLicenciaByVehicle(vehicleModel);
        if(licItem <= 0) return 1; // modelo no requiere licencia
        // Si es Camion (Cat C), verificar si tiene trailer acoplado (requiere Cat E).
        if(licItem == LIC_ITEM_CAMION && IsPlayerInAnyVehicle(playerid))
        {
                new vehId = GetPlayerVehicleID(playerid);
                if(IsValidVehicle(vehId) && IsTrailerAttachedToVehicle(vehId))
                {
                        // Tiene trailer acoplado: requiere Cat E (19857).
                        if(!CheckInventario2(playerid, LIC_ITEM_TRAILERO)) return 0;
                }
        }
        return CheckInventario2(playerid, licItem);
}

// Verifica si el jugador tiene la licencia especifica por categoria.
// USO: if(!TieneLicenciaCategoria(playerid, LIC_ITEM_CAMION)) return ErrorMsg(...)
stock TieneLicenciaCategoria(playerid, licItem)
{
        if(!IsPlayerConnected(playerid)) return 0;
        if(licItem != LIC_ITEM_MOTO && licItem != LIC_ITEM_AUTO
           && licItem != LIC_ITEM_CAMION && licItem != LIC_ITEM_AEREA
           && licItem != LIC_ITEM_TRAILERO)
                return 0; // item invalido
        return CheckInventario2(playerid, licItem);
}

// Verifica si el jugador tiene Carnet de Trabajo.
// FIX SPRINT4 9.2: por ahora consulta el campo legacy pCarteiraT. Si en el futuro
// se migra a item de inventario (model X), solo hay que cambiar la implementacion
// aqui, y los 12+ callers no se enteran.
stock TieneCarnetTrabajo(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        return (PlayerInfo[playerid][pCarteiraT] == 1);
}

// Verifica si el jugador puede tomar un trabajo especifico.
// Combina: Carnet de Trabajo + licencia de conducir requerida (si aplica).
// jobId: 1=Pescador, 2=Minero, 3=Carnicero, 4=Camionero, 5=Constructor,
//        6=Recolector, 7=Empaquetador, 8=Correos, 9=Medico (dehabilitado)
// Retorna: 1 si puede, 0 si no. errorMessage[128] se llena con razon si no puede.
stock PuedeTomarTrabajo(playerid, jobId, errorMessage[] = "", errorSize = 0)
{
        if(!IsPlayerConnected(playerid)) return 0;
        if(PlayerInfo[playerid][pProfissao] != 0)
        {
                if(errorSize > 0) format(errorMessage, errorSize, "Ya tienes un trabajo. Usa /salirtrabajo primero.");
                return 0;
        }
        if(!TieneCarnetTrabajo(playerid))
        {
                if(errorSize > 0) format(errorMessage, errorSize, "Necesitas Carnet de Trabajo. Obtenlo en el Ayuntamiento.");
                return 0;
        }
        // Trabajos que requieren licencia de conducir
        if(jobId == 4) // Camionero - necesita Camion (Cat C)
        {
                if(!TieneLicenciaCategoria(playerid, LIC_ITEM_CAMION))
                {
                        if(errorSize > 0) format(errorMessage, errorSize, "No tienes licencia de camion (Cat. C).");
                        return 0;
                }
        }
        else if(jobId == 7) // Empaquetador - necesita Auto (Cat B)
        {
                if(!TieneLicenciaCategoria(playerid, LIC_ITEM_AUTO))
                {
                        if(errorSize > 0) format(errorMessage, errorSize, "No tienes licencia de auto (Cat. B).");
                        return 0;
                }
        }
        else if(jobId == 8) // Correos - necesita Auto (Cat B)
        {
                if(!TieneLicenciaCategoria(playerid, LIC_ITEM_AUTO))
                {
                        if(errorSize > 0) format(errorMessage, errorSize, "No tienes licencia de auto (Cat. B).");
                        return 0;
                }
        }
        return 1;
}

stock GetLicenciaByVehicle(modelid)
{
        // FIX AUDIT LIC LIC-A2-19/LIC-A4-01 (CRITICO/ALTO): bicis no requieren licencia.
        // ANTES: bicis 481/509/510 estaban listadas como motos (Cat A). Jugador
        // sin licencia moto no podia andar en bici. Ahora: bicis no requieren licencia.
        if(modelid == 481 || modelid == 509 || modelid == 510)
                return -1;  // no requiere licencia
        // Motos (Cat A)
        if(modelid == 448 || modelid == 461 || modelid == 462 || modelid == 463 ||
           modelid == 468 || modelid == 471 || modelid == 521 || modelid == 522 ||
           modelid == 523 || modelid == 581 || modelid == 586)
                return 1853;
        // Aviones y helicopteros (Cat D)
        if(modelid == 460 || modelid == 476 || modelid == 488 || modelid == 497 ||
           modelid == 511 || modelid == 512 || modelid == 513 || modelid == 519 ||
           modelid == 520 || modelid == 553 || modelid == 577 || modelid == 592 ||
           modelid == 593 || modelid == 417 || modelid == 425 || modelid == 447 ||
           modelid == 469 || modelid == 487 || modelid == 548 || modelid == 563)
                return 1856;
        // Camiones pesados (Cat C) - Trailero (Cat E) requiere Cat C previa
        // Camion model 403 (Linerunner) puede tener trailer acoplado.
        // Si el jugador esta en un 403 con trailer, requiere Cat E (19857).
        // Eso se verifica en TieneLicenciaConducir con IsTrailerAttachedToVehicle.
        if(modelid == 403 || modelid == 406 || modelid == 443 || modelid == 455 ||
           modelid == 514 || modelid == 515 || modelid == 524)
                return 1855;
        // Trailero (Cat E) - se maneja en TieneLicenciaConducir (requiere trailer acoplado)
        // Por defecto autos (Cat B)
        return 1854;
}

// Cancela SOLO la licencia del vehiculo que el jugador esta conduciendo.
// FIX AUDIT-AUDIT6-003: Si no esta en vehiculo, cancela SOLO 1 licencia (la mas barata que tenga).
// ANTES: cancelaba TODAS. Era vector de abuso admin destructivo via /retirarlicencia.
// Llamada desde radares, /multartransito y /retirarlicencia.
stock CancelarLicenciaConducir(playerid)
{
        new licenciasCanceladas = 0;
        // Detectar si esta conduciendo un vehiculo
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                new vehModel = GetVehicleModel(GetPlayerVehicleID(playerid));
                new licenciaReq = GetLicenciaByVehicle(vehModel);
                // FIX AUDIT-AUDIT6-006 (ALTO): si es Camion (Cat C) con trailer acoplado, requiere Cat E (Trailero).
                // ANTES: cancelaba Cat C al conducir Linerunner+trailer (debia cancelar Cat E).
                // Estado inconsistente: jugador con Cat E pero sin Cat C (requiere previa).
                if(licenciaReq == LIC_ITEM_CAMION)
                {
                        new _vehId = GetPlayerVehicleID(playerid);
                        if(IsValidVehicle(_vehId) && IsTrailerAttachedToVehicle(_vehId))
                                licenciaReq = LIC_ITEM_TRAILERO;
                }
                if(licenciaReq > 0)
                {
                        // Cancelar SOLO la licencia del vehiculo que conduce
                        if(CheckInventario2(playerid, licenciaReq))
                        {
                                RetirarItem(playerid, licenciaReq);
                                licenciasCanceladas = 1;
                                new licName[24];
                                switch(licenciaReq)
                                {
                                        case 1853:  licName = "Moto (Cat. A)";
                                        case 1854:  licName = "Auto (Cat. B)";
                                        case 1855:  licName = "Camion (Cat. C)";
                                        case 19857: licName = "Trailero (Cat. E)";
                                        case 1856:  licName = "Aerea (Cat. D)";
                                        default:    licName = "Desconocida";
                                }
                                new msgDet[128];
                                format(msgDet, sizeof(msgDet), "| TRANSITO | Licencia cancelada: %s. Las demas licencias se mantienen.", licName);
                                SendClientMessage(playerid, 0xFF8C00FF, msgDet);
                        }
                }
        }
        else
        {
                // FIX AUDIT-AUDIT6-003 (CRITICO): NUNCA cancelar TODAS las licencias si esta a pie.
                // ANTES: rama else hacia 5 RetirarItem sin discriminar ($73k wiped en 1 comando).
                // Vector de abuso admin destructivo via /retirarlicencia.
                // Ahora: cancelar SOLO la licencia mas barata que tenga (prioridad Moto>Auto>Camion>Trailero>Aerea).
                new _licToCancel = 0;
                if(CheckInventario2(playerid, 1853))      _licToCancel = 1853;
                else if(CheckInventario2(playerid, 1854))  _licToCancel = 1854;
                else if(CheckInventario2(playerid, 1855))  _licToCancel = 1855;
                else if(CheckInventario2(playerid, 19857)) _licToCancel = 19857;
                else if(CheckInventario2(playerid, 1856))  _licToCancel = 1856;
                if(_licToCancel > 0)
                {
                        RetirarItem(playerid, _licToCancel);
                        licenciasCanceladas = 1;
                        new _licName[24];
                        switch(_licToCancel)
                        {
                                case 1853:  _licName = "Moto (Cat. A)";
                                case 1854:  _licName = "Auto (Cat. B)";
                                case 1855:  _licName = "Camion (Cat. C)";
                                case 19857: _licName = "Trailero (Cat. E)";
                                case 1856:  _licName = "Aerea (Cat. D)";
                                default:    _licName = "Desconocida";
                        }
                        new _msgDet[160];
                        format(_msgDet, sizeof(_msgDet), "| TRANSITO | Licencia cancelada: %s. Las demas se mantienen.", _licName);
                        SendClientMessage(playerid, 0xFF8C00FF, _msgDet);
                }
                else
                {
                        licenciasCanceladas = 0;
                }
        }
        // FIX AUDIT-AUDIT6-004 (CRITICO): NO resetear puntos al cancelar licencia.
        // ANTES: reset total permitia burn-cycle (quemar Moto $4k para resetear 12 puntos y seguir conduciendo Aerea $40k).
        // Ahora: solo decrementar 25% (3 puntos) por licencia cancelada. Puntos reales se mantienen.
        // El reset total solo ocurre al PAGAR multas (en otra parte del sistema).
        new _puntosAct = GetPVarInt(playerid, "T2_1_PuntosLicencia");
        if(_puntosAct > 3) SetPVarInt(playerid, "T2_1_PuntosLicencia", _puntosAct - 3);
        else               SetPVarInt(playerid, "T2_1_PuntosLicencia", 0);
        // FIX AUDIT-AUDIT6-012 (ALTO): eliminado PVar T2_1_LicenciaSuspendida (dead code - nunca se setea a 1, nunca se lee, no se persiste).
        // FIX SPRINT3 B-15: reset LicencaConduzir legacy.
        // Antes: aunque retiramos los items del inventario, NO reseteabamos el campo
        // legacy LicencaConduzir (bool). Pero tras Sprint 1 C-11, Camionero/Empaquetador/
        // Correos ya NO usan LicencaConduzir (usan CheckInventario2). Aun asi, lo
        // reseteamos por consistencia: cualquier sistema legacy que siga consultando
        // el campo vera el valor correcto (sin licencia).
        PlayerInfo[playerid][LicencaConduzir] = 0;
        // Guardar inventario
        SalvarInventario(playerid);
        // FIX AUDIT-AUDIT6-015 (ALTO): persistir PVar T2_1_PuntosLicencia inmediatamente.
        // ANTES: ventana de inconsistencia ~11min (SaveTimer rotatorio). Crash pierde el reset.
        SalvarDados(playerid);
        return licenciasCanceladas;
}
stock VIP(playerid)
{
        new LipeStrondaVIP[64];
        if(PlayerInfo[playerid][pVIP] == 0) { LipeStrondaVIP = "GRATIS"; }
        if(PlayerInfo[playerid][pVIP] == 1) { LipeStrondaVIP = "CLASSIC"; }
        else if(PlayerInfo[playerid][pVIP] == 2) { LipeStrondaVIP = "ADVANCED"; }
        else if(PlayerInfo[playerid][pVIP] == 3) { LipeStrondaVIP = "PREMIUM"; }
        return LipeStrondaVIP;
}

stock ConvertDays(dias)
{
        new
                valueday = 86400*dias,
                daysconvert,
                gtime = gettime()
        ;

        #emit LOAD.S.PRI gtime
        #emit LOAD.S.ALT valueday
        #emit ADD
        #emit STOR.S.PRI daysconvert

        return daysconvert;
}

stock convertNumber(n)
{
        new dia, hr, mn, seg, resto;

        resto = n;
        seg = resto % 60;
        resto /= 60;
        mn = resto % 60;
        resto /= 60;
        hr = resto % 24;
        resto /= 24;
        dia = resto;

        new str[50];
        format(str, sizeof(str), "%dd, %02dh %02dm %02ds", dia, hr, mn, seg);
        return str;
}

stock CarregarVIP(playerid)
{
        new string[80];
        format(string, sizeof(string), PASTA_VIPS, Name(playerid));
        if(DOF2_FileExists(string))
        {
                // FIX CRIT-VIP-001 (CRITICO): clamp pVIP [0,3] y ExpiraVIP al cargar desde VIPS/.ini.
                // ANTES: sin validacion. Un jugador que editara VIPS/<nick>.ini con Level=3,
                // VipExpira=9999999999 obtenia VIP 3 permanente gratis (bypass del clamp en OnPlayerLogin).
                new _loadVIPLevel = DOF2_GetInt(string,"Level");
                if(_loadVIPLevel < 0 || _loadVIPLevel > 3)
                {
                        printf("[VIP TAMPER] Jugador %d (%s) cargo Level=%d de VIPS/.ini, reseteado a 0.", playerid, Name(playerid), _loadVIPLevel);
                        _loadVIPLevel = 0;
                }
                new _loadExpira = DOF2_GetInt(string,"VipExpira");
                // ExpiraVIP maximo: 1 ano (365 dias) desde ahora. Si es mayor, sospechar tampering.
                if(_loadExpira < 0 || _loadExpira > gettime() + (365 * 86400))
                {
                        printf("[VIP TAMPER] Jugador %d (%s) cargo VipExpira=%d, reseteado a 0.", playerid, Name(playerid), _loadExpira);
                        _loadExpira = 0;
                }
                PlayerInfo[playerid][ExpiraVIP] = _loadExpira;
                PlayerInfo[playerid][pVIP] = _loadVIPLevel;
                if(PlayerInfo[playerid][pVIP] > 0 && gettime() > PlayerInfo[playerid][ExpiraVIP])
                {
                        DOF2_RemoveFile(string);
                        PlayerInfo[playerid][ExpiraVIP] = 0;
                        PlayerInfo[playerid][pVIP] = 0;
                        InfoMsg(playerid, "Tu beneficio expiro.");
                }
                else if(PlayerInfo[playerid][pVIP] > 0)
                {
                        format(string, sizeof(string), "Tu beneficio expira el %s.", convertNumber(PlayerInfo[playerid][ExpiraVIP]-gettime()));
                        InfoMsg(playerid, string);
                        SetPlayerColor(playerid, VIP_COLOR);
                }
        }
        return 1;
}


stock SalvarVIP(playerid)
{
        // FIX AUDIT4 PERS-HIGH-03: validar conexion antes de persistir.
        if(!IsPlayerConnected(playerid)) return 1;
        // FIX ALTO-VIP-002: reducir buffer de 5000 (20KB stack) a 128 (path real ~34 chars).
        new File[128];
        format(File, sizeof(File), PASTA_VIPS, Name(playerid));
        if(PlayerInfo[playerid][pVIP] >= 1)
        {
                if(!DOF2_FileExists(File)) DOF2_CreateFile(File);
                DOF2_SetInt(File, "VipExpira", PlayerInfo[playerid][ExpiraVIP]);
                DOF2_SetInt(File, "Level", PlayerInfo[playerid][pVIP]);
                DOF2_SaveFile();
        }
        else
        {
                // FIX CRIT-VIP-002 (CRITICO): eliminar archivo VIPS/.ini cuando pVIP=0.
                // ANTES: SalvarVIP solo escribia si pVIP>=1. Si pVIP bajaba a 0 (por /quitarvip
                // o expiracion), el archivo quedaba en disco. Al reconectar, CarregarVIP lo
                // leia y restauraba el VIP (bypass total de /quitarvip).
                // AHORA: si pVIP=0 y el archivo existe, eliminarlo.
                if(DOF2_FileExists(File))
                {
                        DOF2_RemoveFile(File);
                }
        }
        return 1;
}

// =====================================================================
// FIX MEJORA-VIP-1: helper IsVIPActive(playerid) - fuente unica de verdad.
// Centraliza la validacion de VIP activo (pVIP > 0 Y ExpiraVIP > gettime()).
// Usar en PayDay bonus, multiplicadores de trabajo, comandos exclusivos VIP.
// Elimina la dualidad de checks inconsistentes (pVIP>=1, pVIP!=0, pVIP<2, etc).
// =====================================================================
stock IsVIPActive(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(!IsPlayerConnected(playerid)) return 0;
        if(PlayerInfo[playerid][pVIP] < 1) return 0;
        if(PlayerInfo[playerid][ExpiraVIP] <= 0) return 0;
        if(gettime() > PlayerInfo[playerid][ExpiraVIP]) return 0;
        return 1;
}

// =====================================================================
// FIX MEJORA-VIP-2: helper GetVIPLevel(playerid) - retorna nivel VIP activo.
// Retorna 0 si no tiene VIP o ya expiro, 1/2/3 si esta activo.
// =====================================================================
stock GetVIPLevel(playerid)
{
        if(!IsVIPActive(playerid)) return 0;
        return PlayerInfo[playerid][pVIP];
}

// =====================================================================
// FIX MEJORA-VIP-3: helper ResetVIPVisuals(playerid) - reset color VIP.
// Llamar cuando el VIP expira o es removido para resetear el color dorado.
// =====================================================================
stock ResetVIPVisuals(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        // Reset color al default (blanco). Otros sistemas pueden setear color de org/faccion despues.
        SetPlayerColor(playerid, 0xFFFFFFFF);
        return 1;
}

// =====================================================================
// FIX MEJORA-VIP-4: helper GetVIPMultiplier(playerid) - multiplicador de pago.
// Retorna 1.0 si no VIP, 1.0 si VIP 1 (sin mult de pago), 2.0 si VIP 2/3.
// Unifica los 12 multiplicadores VIP dispersos en la GM.
// =====================================================================
stock Float:GetVIPMultiplier(playerid)
{
        if(!IsVIPActive(playerid)) return 1.0;
        if(PlayerInfo[playerid][pVIP] >= 2) return 2.0;
        return 1.0;
}

// =====================================================================
// FIX MEJORA-COINS-2: helper ComprarConCoins(playerid, precio) - centraliza compra.
// Valida pCoins >= precio, descuenta, persiste. Retorna 1 si OK, 0 si fallo.
// Reduce 19 bloques duplicados en tienda VIP a 1 llamada.
// =====================================================================
stock ComprarConCoins(playerid, precio)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        if(precio < 0) return 0; // FIX: precio negativo = exploit
        if(PlayerInfo[playerid][pCoins] < precio) return 0;
        PlayerInfo[playerid][pCoins] -= precio;
        // FIX MEJORA-COINS-3: persistir inmediatamente tras compra (no esperar SaveTimer).
        SalvarDados(playerid);
        return 1;
}

// =====================================================================
// FIX MEJORA-COINS-4: helper AC_AddCoins(playerid, cantidad) - anti-cheat coins.
// Valida rango, previene overflow, persiste. Similar a AC_AddPlayerMoney pero para pCoins.
// =====================================================================
stock AC_AddCoins(playerid, cantidad)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        if(cantidad == 0) return 1;
        // FIX: clamp cantidad para prevenir overflow
        if(cantidad < -COINS_MAX_AMOUNT) cantidad = -COINS_MAX_AMOUNT;
        if(cantidad > COINS_MAX_AMOUNT) cantidad = COINS_MAX_AMOUNT;
        new _newCoins = PlayerInfo[playerid][pCoins] + cantidad;
        if(_newCoins < 0) _newCoins = 0;
        if(_newCoins > COINS_MAX_AMOUNT) _newCoins = COINS_MAX_AMOUNT;
        PlayerInfo[playerid][pCoins] = _newCoins;
        SalvarDados(playerid);
        return 1;
}

stock PreloadAnimLib(playerid, animlib[])
{
        ApplyAnimation(playerid,animlib,"null",0.0,0,0,0,0,1);
}

stock randomEx(minnum = cellmin, maxnum = cellmax)
        return random(maxnum - minnum + 1) + minnum;// by Y_Less

stock GetPlayerID(Nome[])
{
        foreach(new i: Player)
        {
                if(IsPlayerConnected(i))
                {
                        if(!strcmp(Name(i), Nome, true, 24)) return i;
                }
        }
        return -1;
}

stock BanirPlayer(playerid, administrador, Motivo1[])
{
        new File[255];
        new Data[24], Dia, Mes, Ano, Hora, Minuto;
        gettime(Hora, Minuto);
        getdate(Ano, Mes, Dia);
        format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
        format(File, sizeof(File), PASTA_BANIDOS, Name(playerid));
        DOF2_CreateFile(File);
        DOF2_SetString(File, "Administrador", Name(administrador));
        DOF2_SetString(File, "Motivo", Motivo1);
        DOF2_SetString(File, "Data", Data);
        DOF2_SetString(File, "Desban", "Nunca");
        DOF2_SetInt(File, "DDesban", gettime() + 60 * 60 * 24 * 999);
        DOF2_SaveFile();
        foreach(new i : Player)
        {
                format(Str, sizeof(Str), "El Administrador %s(%d) baneo al jugador %s(%d). Motivo: %s", Name(playerid),PlayerInfo[playerid][IDF], Name(administrador),PlayerInfo[administrador][IDF], Motivo1);
                WarningMsg(i, Str);
        }

        Log("Logs/Banir.ini", Str);
        // FIX ALTO-VIP-005 (ALTO): eliminar archivo VIPS/.ini al banear jugador.
        // ANTES: el archivo VIPS/<nick>.ini quedaba huerfano. Si el jugador era desbaneado,
        // al reconectar CarregarVIP leia el archivo stale y restauraba el VIP gratis.
        {
                new _vipFileB[80];
                format(_vipFileB, sizeof(_vipFileB), PASTA_VIPS, Name(playerid));
                if(DOF2_FileExists(_vipFileB)) DOF2_RemoveFile(_vipFileB);
        }
        Kick(playerid);
        return 1;
}

stock AgendarBan(playerid[], administrador, Motivo1[], Dias)
{
        new File[255];
        new Data[24], Dia, Mes, Ano, Hora, Minuto;
        gettime(Hora, Minuto);
        getdate(Ano, Mes, Dia);
        format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
        format(File, sizeof(File), PASTA_BANIDOS, playerid);
        DOF2_CreateFile(File);
        DOF2_SetString(File, "Administrador", Name(administrador));
        DOF2_SetString(File, "Motivo", Motivo1);
        DOF2_SetString(File, "Data", Data);
        if(Dias == 999)
        {
                DOF2_SetString(File, "Desban", "Nunca");
                DOF2_SetInt(File, "DDesban", gettime() + 60 * 60 * 24 * 999); // 999 DIAS
        }
        else
        {
                getdate(Ano, Mes, Dia);
                Dia += Dias;
                if(Mes == 1 || Mes == 3 || Mes == 5 || Mes == 7 || Mes == 8 || Mes == 10 || Mes == 12)
                {
                        if(Dia > 31)
                        {
                                Dia -= 31;
                                Mes++;
                                if(Mes > 12) Mes = 1;
                        }
                }
                if(Mes == 4 || Mes == 6 || Mes == 9 || Mes == 11)
                {
                        if(Dia > 30)
                        {
                                Dia -= 30;
                                Mes++;
                        }
                }
                if(Mes == 2)
                {
                        if(Dia > 28)
                        {
                                Dia-=28;
                                Mes++;
                        }
                }
                gettime(Hora, Minuto);
                format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
                //
                DOF2_SetString(File, "Desban", Data);
                DOF2_SetInt(File, "DDesban", gettime() + 60 * 60 * 24 * Dias);
        }
        DOF2_SaveFile();
        return 1;
}

stock Agendarjail(playerid[], tempo, administrador, Motivo1[])
{
        new File[255];
        if(tempo < 0)
        {
                format(File, 56, PASTA_CONTAS, playerid);
                new TempoAtual = DOF2_GetInt(File, "pjail");
                if(tempo * -1 >= TempoAtual / 60)
                {
                        DOF2_SetInt(File, "pjail", 0);
                        DOF2_SaveFile();
                        format(File, 56, PASTA_AGENDADOS, playerid);
                        if(DOF2_FileExists(File)) DOF2_RemoveFile(File);
                        return 0;
                }
                else
                {
                        new tempo1 = tempo * -1 * 60;
                        TempoAtual -= tempo1;
                        DOF2_SetInt(File, "pjail", TempoAtual);
                        DOF2_SaveFile();
                        format(File, 56, PASTA_AGENDADOS, playerid);
                        if(DOF2_FileExists(File)) DOF2_SetInt(File, "Tempo", DOF2_GetInt(File, "Tempo") - tempo * -1), DOF2_SaveFile();
                        return 0;
                }
        }
        if(tempo > 0)
        {
                format(File, 56, PASTA_CONTAS, playerid);
                if(DOF2_GetInt(File, "pjail") > 0)
                {
                        new Tempo9;
                        Tempo9 = tempo * 60;
                        DOF2_SetInt(File, "pjail", DOF2_GetInt(File, "pjail") + Tempo9);
                        DOF2_SaveFile();
                }
                else
                {
                        DOF2_SetInt(File, "pjail", tempo * 60);
                        DOF2_SaveFile();
                }
                format(File, 56, PASTA_AGENDADOS, playerid);
                if(!DOF2_FileExists(File))
                {
                        DOF2_CreateFile(File);
                        DOF2_SetInt(File, "Tempo", tempo);
                        DOF2_SetString(File, "Administrador", Name(administrador));
                        DOF2_SetString(File, "Motivo", Motivo1);
                        DOF2_SaveFile();
                }
                else
                {
                        new ADM[24], Motivo2[56], Tempo1;
                        format(ADM, 24, "%s", DOF2_GetString(File, "Administrador")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                        format(Motivo2, 56, "%s", DOF2_GetString(File, "Motivo")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                        Tempo1 = DOF2_GetInt(File, "Tempo");
                        format(Str, sizeof(Str), "%s | %s", ADM, Name(administrador));
                        DOF2_SetString(File, "Administrador", Str);
                        format(Str, sizeof(Str), "%s | %s", Motivo2, Motivo1);
                        DOF2_SetString(File, "Motivo", Str);
                        DOF2_SetInt(File, "Tempo", tempo + Tempo1);
                        DOF2_SaveFile();
                }
        }
        return 1;
}

stock BanirIP(playerid, administrador, Motivo1[])
{
        new File[255];
        new Data[24], Dia, Mes, Ano, Hora, Minuto;
        gettime(Hora, Minuto);
        getdate(Ano, Mes, Dia);
        format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
        format(File, sizeof(File), PASTA_BANIDOSIP, GetPlayerIpEx(playerid));
        DOF2_CreateFile(File);
        DOF2_SetString(File, "Administrador", Name(administrador));
        DOF2_SetString(File, "Motivo", Motivo1);
        DOF2_SetString(File, "Data", Data);
        DOF2_SaveFile();

        new logmsg[256];
        format(logmsg, sizeof(logmsg), "[BANIP] Admin: %s | Jugador: %s | IP: %s | Motivo: %s | Fecha: %s",
                Name(administrador), Name(playerid), GetPlayerIpEx(playerid), Motivo1, Data);
        Log("Logs/BanirIP.ini", logmsg);
        return 1;
}

stock ZerarDados(playerid)
{
        // FIX AUDIT LOGIN F0-7: zeroear pSenha al resetear datos del slot.
        // Esto se llama en OnPlayerConnect y OnPlayerDisconnect. Antes pSenha
        // no se reseteaba, exponiendo la contrasena del jugador anterior si
        // el slot se reusaba. Ahora: borramos el contenido explicitamente.
        PlayerInfo[playerid][pSenha][0] = '\0';
        // FIX AUDIT LOGIN F1-8: matar los 4 timers de login al resetear slot.
        // Estos timers (TimerLogin, timerloginname, TxdLogin, loginp) son
        // one-shot timers creados durante el flujo de login. Si el jugador
        // se desconectaba antes de que dispararan, quedaban zombies corriendo
        // sobre el slot. En slot reuse, el nuevo ocupante sufria efectos del
        // jugador anterior (skin random, HUD show, aviso de bienvenida, etc).
        // Ahora: matamos los 4 timers en ZerarDados, que se llama tanto en
        // OnPlayerConnect (al inicio del slot) como en OnPlayerDisconnect.
        // Si el timer ya disparo o no existe, KillTimer no hace nada (safe).
        if(TimerLogin[playerid] != 0) { KillTimer(TimerLogin[playerid]); TimerLogin[playerid] = 0; }
        if(timerloginname[playerid] != 0) { KillTimer(timerloginname[playerid]); timerloginname[playerid] = 0; }
        if(g_TxdLoginTimer[playerid] != -1) { KillTimer(g_TxdLoginTimer[playerid]); g_TxdLoginTimer[playerid] = -1; }
        if(g_loginpTimer[playerid] != -1) { KillTimer(g_loginpTimer[playerid]); g_loginpTimer[playerid] = -1; }
        // FIX ALTO-XP-001/002 (ALTO): cleanup del sistema XP en ZerarDados.
        // Mata timer XP_Hide pendiente y destruye XPTXD para evitar slot-reuse exploit.
        XP_CleanupPlayer(playerid);
        // FIX AUDIT SPAWN S0-4: resetear mutex g_Saving al resetear slot.
        // Si SalvarDados crasheaba mid-flush (porque el server se cayo), el mutex
        // g_Saving[playerid] quedaba en true para siempre. En slot reuse, el
        // nuevo jugador no podia guardar jamas: todas las llamadas a SalvarDados
        // retornaban en `if(g_Saving[playerid]) return 1;`.
        // Ahora: reseteamos g_Saving a false en ZerarDados. Asi, aunque el
        // jugador anterior dejo el mutex pegado, el nuevo jugador lo encuentra libre.
        g_Saving[playerid] = false;
        // FIX AUDIT SPAWN S0-7: matar TimerCad al resetear slot.
        // TimerCad (AttCad 100ms one-shot) se crea en la seleccion de skin. Solo
        // se matava en el bloque if(pLogado==true) de OnPlayerDisconnect. Si el
        // jugador se desconectaba DURANTE la seleccion (pLogado=false), TimerCad
        // quedaba zombie. AttCad disparaba sobre slot reusado, causando glitches
        // visuales al nuevo jugador.
        // Ahora: matamos TimerCad en ZerarDados tambien. Si ya disparo o no
        // existe, KillTimer no hace nada (safe).
        if(TimerCad[playerid]) { KillTimer(TimerCad[playerid]); TimerCad[playerid] = 0; }
        // FIX AUDIT LOGIN F1-9: destruir actorcad al resetear slot.
        // actorcad se crea en L30244 (DIALOG_LOGIN success, previo a spawn)
        // y se recrea 6 veces en el selector de skin (L37451, L37460, etc).
        // Si el jugador se desconectaba durante la seleccion de personaje
        // (entre L30244 y el final del selector), el actorcad quedaba vivo
        // en memoria sin que nadie lo destruyera. Memory leak real de actor.
        // En slot reuse, el nuevo jugador tampoco podia ver el actor (porque
        // no es suyo, es un actor con ID de actor asignado por SA-MP), pero
        // el actor zombie seguia ocupando 1 slot en la lista global de actores
        // de SA-MP (maximo 1000 actores por servidor).
        // Fix: si actorcad no es INVALID_ACTOR_ID, destruirlo.
        // NOTA: INVALID_ACTOR_ID es 0xFFFF (65535) en SA-MP. Usamos comparacion
        // con 0 porque en L2524 no se inicializa actorcad a INVALID_ACTOR_ID,
        // pero CreateActor retorna un valor >= 0 si tuvo exito. Si nunca se
        // creo, el valor es 0 (porque new X[MAX_PLAYERS] inicializa a 0).
        // Para mas seguridad, podriamos inicializar actorcad[MAX_PLAYERS] a
        // INVALID_ACTOR_ID (-1 o 0xFFFF), pero eso requeriria tocar L2524
        // y podria romper otros sitios que asumen 0 = "no creado". Por ahora,
        // solo destruimos si actorcad > 0 (defensivo: si el actor ID es 0
        // legitimo, raramente se destruira sin querer, y SA-MP resiste
        // DestroyActor invalido sin crashear).
        if(actorcad[playerid] > 0) { DestroyActor(actorcad[playerid]); actorcad[playerid] = 0; }
        // FIX AUDIT SPAWN S0-5: guard IsValidActor antes de DestroyActor(actorcorreios).
        // Antes: DestroyActor(actorcorreios[playerid]) se llamaba SIN verificar si
        // el actor es valido. Cuando un jugador entraba, actorcorreios se inicializaba
        // a 0 (default de Pawn). SA-MP asigna IDs de actor secuenciales desde 0.
        // Si el jugador se desconectaba sin haber creado su actorcorreios, el valor
        // era 0. DestroyActor(0) destruiria el actor ID 0 del servidor, que podria
        // ser el actorcorreios de OTRO jugador (u otro actor global).
        // Ahora: solo destruir si IsValidActor retorna true. Si el actor no existe
        // o no es valido, no hacemos nada (safe).
        if(IsValidActor(actorcorreios[playerid])) DestroyActor(actorcorreios[playerid]);
        RotaMaconha[playerid] = false;
        // FIX AUDIT 5P: resetear rutas y cooldowns de territorios para evitar slot-reuse
        RotaPiezas[playerid] = false;
        RotaCucina[playerid] = false;
        for(new t = 0; t < MAX_TERRITORIOS; t++)
                g_TerrPickupLastUse[playerid][t] = 0;
        // FIX AUDIT 5P: limpiar flags de robo/desmantelamiento (defensa en profundidad)
        // FIX AUDIT10 A2-X1: liberar flag per-negocio si el jugador tenia robo en curso.
        if(GetPVarInt(playerid, "RoboEnCurso") == 1)
        {
                new robaN = GetPVarInt(playerid, "RoboNegocioID");
                if(robaN >= 0 && robaN < 9) g_Negocios[robaN][n_siendoRobado] = false;
        }
        DeletePVar(playerid, "RoboEnCurso");
        DeletePVar(playerid, "RoboTimerID");
        DeletePVar(playerid, "DesmancharEnCurso");
        DeletePVar(playerid, "DesmancharTimerID");
        // FIX AUDIT ASSIGNJAILCELL: resetear celda del jugador para evitar slot-reuse
        FreeJailCell(playerid);
        PlayerInfo[playerid][pSkin] = 0;
        Din[playerid] = 0;
        vl[playerid] = 0;
        ChatAtendimento[playerid] = 0;
        // FIX AUDIT SPAM-H3+H7: reset InviteAtt, IDAvaliou y NumeroChatAtendimento en ZerarDados.
        // Antes: InviteAtt e IDAvaliou NO se reseteaban en ZerarDados. En slot reuse,
        // el nuevo jugador heredaba identidades stale de atencion admin.
        // Adicionalmente, NumeroChatAtendimento no se reseteaba (solo en /terminar L50419).
        InviteAtt[playerid] = 9999;
        IDAvaliou[playerid] = 999;
        NumeroChatAtendimento[playerid] = 0;
        PlayerInfo[playerid][pDinheiro] = 0;
        PlayerInfo[playerid][pBanco] = 0;
        PlayerInfo[playerid][pIdade] = 0;
        PlayerInfo[playerid][pSegundosJogados] = 0;
        PlayerInfo[playerid][pAvisos] = 0;
        PlayerInfo[playerid][pRG] = 0;
        PlayerInfo[playerid][pNome] = 0;
        PlayerInfo[playerid][pNascimento] = 0;
        PlayerInfo[playerid][pPai] = 0;
        PlayerInfo[playerid][pMae] = 0;
        PlayerInfo[playerid][pjail] = 0;
        PlayerInfo[playerid][pAdmin] = 0;
        // FIX AUDIT LOGIN F2-1: resetear IDF, pEmail y g_ChalecoPermitido en ZerarDados.
        // Antes: estas 3 variables NO se reseteaban en ZerarDados. En slot reuse
        // (jugador A desconecta, jugador B entra en el mismo slot), el nuevo
        // jugador heredaba:
        //   - IDF (ID de cuenta) del anterior -> /gasreclamar (L1755) permitia
        //     reclamar ingresos de gasolinera del jugador anterior sin check
        //     pLogado. Vector de grief economico.
        //   - pEmail del anterior -> /cuenta (L40235) mostraba email del
        //     anterior sin check pLogado. Vector de info leak.
        //   - g_ChalecoPermitido del anterior -> el nuevo jugador podia usar
        //     /chaleco aunque no fuera policia/medico. Vector de bypass de
        //     permisos.
        // Ahora: resetear las 3 explicitamente.
        PlayerInfo[playerid][IDF] = 0;
        PlayerInfo[playerid][pEmail][0] = '\0';
        g_ChalecoPermitido[playerid] = false;
        // FIX AUDIT AC-H15: resetear g_ChalecoActivo en ZerarDados (faltaba).
        // Antes: g_ChalecoPermitido se reseteaba pero g_ChalecoActivo NO.
        // En slot reuse, el nuevo jugador heredaba g_ChalecoActivo=true del anterior,
        // lo que podia causar falsos negativos en el AC anti-armour hack (el check
        // OnPlayerUpdate L29853 exime si g_ChalecoActivo=true).
        g_ChalecoActivo[playerid] = false;
        // FIX CRITICO BUG LICENCIAS: resetear g_InventoryLoaded en ZerarDados.
        // Esto asegura que el SaveTimer NO guarde un inventario vacio antes de que
        // LoadInv cargue el inventario real del disco en el proximo login.
        g_InventoryLoaded[playerid] = false;
        // FIX AUDIT LOGIN F3-4 (verificacion V1/V3): resetear flag anti-dupe armas en ZerarDados.
        // Evita que el nuevo jugador del slot herede el flag true del anterior, lo que
        // causaria que TxdLogin no le cargue las armas (porque cree que ya estan cargadas).
        g_WeaponsLoadedFromSpawn[playerid] = false;
        PlayerInfo[playerid][pInterior] = 0;
        PlayerInfo[playerid][pPosX] = 0;
        PlayerInfo[playerid][pPosY] = 0;
        PlayerInfo[playerid][pPosZ] = 0;
        PlayerInfo[playerid][pPosA] = 0;
        PlayerInfo[playerid][pCamX] = 0;
        PlayerInfo[playerid][pCamY] = 0;
        PlayerInfo[playerid][pCamZ] = 0;
        PlayerInfo[playerid][pCongelado] = false;
        PlayerInfo[playerid][pCalado] = false;
        PlayerInfo[playerid][ImpuestoPendiente] = 0;
        PlayerInfo[playerid][ImpuestoPayDaysSinPagar] = 0;
        PlayerInfo[playerid][BancoBloqueado] = 0;
        PlayerInfo[playerid][DeudaFiscalReportada] = 0;
        PlayerInfo[playerid][LicenciaPesca] = 0;
        PlayerInfo[playerid][LicenciaArmas] = 0;
        PlayerInfo[playerid][pVIP] = 0;
        PlayerInfo[playerid][ExpiraVIP] = 0;
        // FIX ALTO-VIP-006 (ALTO): eliminar archivo VIPS/.ini en ZerarDados (slot reuse prevention).
        // ANTES: ZerarDados reseteaba memoria pero no eliminaba el archivo VIPS/.ini.
        // Al reconectar, CarregarVIP leia el archivo stale y restauraba el VIP del jugador anterior.
        {
                new _vipFileZ[80];
                format(_vipFileZ, sizeof(_vipFileZ), PASTA_VIPS, Name(playerid));
                if(DOF2_FileExists(_vipFileZ)) DOF2_RemoveFile(_vipFileZ);
        }
        PlayerInfo[playerid][vKey] = 0;
        PlayerInfo[playerid][vCoins] = 0;
        PlayerInfo[playerid][pProfissao] = 0;
        PlayerInfo[playerid][Org] = 0;
        PlayerInfo[playerid][Cargo] = 0;
        PlayerInfo[playerid][convite] = 0;
        PlayerInfo[playerid][pProcurado] = 0;
        PlayerInfo[playerid][pMultas] = 0;
        // FIX AUDIT SPAWN S1-9: resetear Casa a -1 (no 0) en ZerarDados.
        // Antes: Casa se reseteaba a 0. Pero 0 NO es "sin casa", es la PRIMERA
        // casa de la lista (CasaInfo[0]). En slot reuse, el nuevo jugador
        // "heredaba" casa 0 sin haberla comprado. Si CasaInfo[0] era una casa
        // valida, el nuevo jugador aparecia en ella.
        // Ahora: resetear a -1 (que significa "sin casa"). -1 nunca colisiona
        // con un ID de casa valido (que empiezan en 0).
        PlayerInfo[playerid][Casa] = -1;
        PlayerInfo[playerid][Entrada] = 0;
        PlayerInfo[playerid][pEvaluacion] = 0;

        ModoTransacao[playerid] = 0;
        // FIX AUDIT CEL CEL-A2-01 (CRITICO): NO resetear TiempoAnuncio en ZerarDados.
        // ANTES: se reseteaba a 0 aqui, permitiendo bypass del cooldown de 60s reconectando.
        // AHORA: TiempoAnuncio se carga desde disco en OnPlayerLogin (L31699), asi que NO
        // debe resetearse aqui. Si la cuenta tiene TiempoAnuncio > 0 guardado, el jugador
        // seguira en cooldown al reconectar (comportamiento correcto anti-bypass).
        // TiempoAnuncio[playerid] = 0;  // ELIMINADO
        // FIX AUDIT SPAWN S2-3: resetear pSexo en ZerarDados.
        // Antes: pSexo no se reseteaba. En slot reuse, el nuevo jugador heredaba
        // el sexo del anterior (1=masculino o 2=femenino). Si el nuevo jugador
        // era femenino pero heredaba masculino, los skins mostrados eran masculinos.
        PlayerInfo[playerid][pSexo] = 0;
        // FIX AUDIT SPAWN S2-7: resetear MostrandoMenu en ZerarDados.
        // Antes: MostrandoMenu no se reseteaba. En slot reuse, el nuevo jugador
        // heredaba MostrandoMenu=true sin haber abierto el menu. El primer
        // /mudarskin no funcionaba porque el sistema creia que ya estaba en menu.
        MostrandoMenu[playerid] = false;
        // FIX AUDIT INV I0-7: resetear PlayerInventario en ZerarDados.
        // Antes: PlayerInventario NO se reseteaba en ZerarDados. En slot reuse,
        // el nuevo jugador heredaba el inventario del anterior hasta que LoadInv
        // ejecutaba (2s post-login). Si SaveTimer disparaba en esa ventana,
        // persistia inventario stale al disco del nuevo jugador.
        for(new invSlot = 0; invSlot < 33; invSlot++)
        {
                PlayerInventario[playerid][invSlot][Slot] = -1;
                PlayerInventario[playerid][invSlot][Unidades] = 0;
        }
        // FIX AUDIT INV I0-8: resetear qtdinv, ItemBox vars y matar HideItemBox timer.
        qtdinv[playerid] = 0;
        SetPVarInt(playerid, "#VarSlotInv", 0);
        MaxPlayerItemBox[playerid] = 7;
        IndexItemBox[playerid] = 0;
        for(new ib = 0; ib < 7; ib++) InfoItemBox[playerid][ib][ItemBoxLoading] = 0;
        LavouMao[playerid] = false;
        PegouVehProf[playerid] = false;
        CajaMao[playerid] = false;
        CajasSdx[playerid] = 0;
        EntregasTotales[playerid] = 0;
        EntregaDistTotal[playerid] = 0.0;
        EntregaPosUltX[playerid] = 0.0;
        EntregaPosUltY[playerid] = 0.0;
        EtapasMinerador[playerid] = 0;
        TemMinerio[playerid] = 0;
        // FIX: resetear contadores de racha y fatiga solo al desconectar (no al spawnear).
        g_RocaCounter[playerid] = 0;
        g_FatigaMinero[playerid] = 0;
        g_RocasAcumuladas[playerid] = 0;
        // FIX M-A2-08: limpiar pickaxe (slot 9) en ZerarDados.
        // Antes: si un Minero desconectaba con pickaxe attached, el nuevo slot heredaba
        // el objeto visual sin ser Minero. Leak visual hasta GMX.
        RemovePlayerAttachedObject(playerid, 9);
        // FIX AUDIT CEL MEJORA-2 (ALTO): resetear flag de ownership slot 9 en ZerarDados.
        // Antes: si un jugador con radio attached (g_RadioSlot9Attached=true) desconectaba,
        // el slot reusado heredaba el flag=true sin tener radio attached. El nuevo
        // jugador presionaba B, el handler de press veia flag=true y NO attachaba el radio
        // (porque ya estaba "usado"). Ahora: reset del flag en ZerarDados.
        g_RadioSlot9Attached[playerid] = false;
        // FIX AUDIT9 BUG5: cleanup objetos carnicero en slot-reuse
        if(IsValidDynamicObject(ObjetoAcougue[playerid][0])) DestroyDynamicObject(ObjetoAcougue[playerid][0]);
        if(IsValidDynamicObject(ObjetoAcougue[playerid][1])) DestroyDynamicObject(ObjetoAcougue[playerid][1]);
        Desossando[playerid] = 0;
        // FIX AUDIT10 A1-X7: cleanup cargarrp/AttArrastar en slot-reuse.
        // Sin esto, un civil que reusa el slot de un cop hereda ArrastadoID
        // del cop anterior y puede liberar/arrastrar presos sin ser policia.
        if(AttArrastar[playerid]) { KillTimer(AttArrastar[playerid]); AttArrastar[playerid] = 0; }
        ArrastadoID[playerid] = 0;
        Arrastado[playerid] = 0;
        // FIX AUDIT10 A3-X4: cleanup lockpick state (LockTimer/LockUse/LockCount/
        // LockCorrect/VehicleLockedID/LockProgress) en slot-reuse. Sin esto, un
        // jugador que reusa el slot de alguien que abandono mid-lockpick queda
        // permanentemente bloqueado para /lockpick ("Ya estas usando la ganzua").
        if(LockTimer[playerid]) { KillTimer(LockTimer[playerid]); LockTimer[playerid] = 0; }
        LockUse[playerid] = false;
        LockCount[playerid] = 0;
        Correct[playerid] = 0;
        VehicleLockedID[playerid] = 0;
        LockProgress[playerid] = 207.0;
        // Reset Empaquetador
        EmpaquetadorActivo[playerid] = false;
        EmpaquetadorEntregas[playerid] = 0;
        EmpaquetadorTienda[playerid] = 0;
        // FIX P1-5: IsValidVehicle() en vez de != 0.
        if(IsValidVehicle(EmpaquetadorVehiculo[playerid]))
        {
                DestroyVehicle(EmpaquetadorVehiculo[playerid]);
                EmpaquetadorVehiculo[playerid] = INVALID_VEHICLE_ID;
        }
        // FIX SPRINT2 A-03: resetear PegouLixo (Recolector) que faltaba en ZerarDados.
        // Antes: si un Recolector con PegouLixo=true desconectaba y su slot era reusado,
        // ZerarDados ejecutaba pero NO reseteaba PegouLixo. Si el nuevo jugador caminaba
        // por un CP de Recolector, cobraba sin haber recolectado. Combinado con el guard
        // de C-03 (valida pProfissao==6 en bloque PegouLixo), esto es defense in depth:
        // si el nuevo slot tambien toma el trabajo de Recolector, no hereda el estado.
        PegouLixo[playerid] = false;
        Covaconcerto[playerid] = false;
        BigEar[playerid] = 0;
        VehAlugado[playerid] = 0;
        Localizando[playerid] = -1; // FIX P0-MED-6: -1 = sin tracking. Antes: 0 causaba tracking fantasma del jugador ID 0.
        Carregou[playerid] = 0;
        MotorOn[playerid] = 0;
        InventarioAberto[playerid] = 0;
        EquipouCasco[playerid] = 0;
        CargoTumba[playerid] = 0;
        cova[playerid] = 0;
        ocupadodemais[playerid] = 0;
        GPS[playerid] = false;
        RefuelTime[playerid] = 0;
        TrackCar[playerid] = 0;
        FrequenciaConectada[playerid] = 0;
        UltimaFala[playerid] = 0;
        FomePlayer[playerid] = 0;
        SedePlayer[playerid] = 0;
        PassouRadar[playerid] = 0;
        Page[playerid] = 0;
        TemCinto[playerid] = false;
        Susurrando[playerid] = false;
        Falando[playerid] = false;
        Gritando[playerid] = false;
        Casavehcorreios[playerid] = false;
        Casavehcorreios2[playerid] = false;
        checkcasa[playerid] = false;
        Falou[playerid] = false;
        Susurrou[playerid] = false;
        Gritou[playerid] = false;
        PlantandoMaconha[playerid] = false;
        RoubandoCaja[playerid] = false;
        Moved[playerid] = false;
        FirstLogin[playerid] = false;
        pJogando[playerid] = false;

        pLogado[playerid] = false;
        IsAssistindo[playerid] = false;
        UsouCMD[playerid] = false;
        Patrulha[playerid] = false;
        // FIX AUDIT6-FIX-PERF: resetear flag de TextDraw de velocidad (slot-reuse defense)
        mostrandovelo[playerid] = 0;
        // FIX AUDIT VELOCIMETRO VEL-A1-09/A2-04/A3-03/A4-04 (MEDIO): reset caches lastVelo* en ZerarDados.
        // Antes: si un slot era reusado, los caches lastVeloSpeed/Fuel/Gear del jugador anterior
        // quedaban stale. El primer strcmp() en VelocimetroEx retornaba 0 (iguales) y NO actualizaba
        // el TextDraw, mostrando velocidad/fuel/marcha del jugador anterior.
        lastVeloSpeed[playerid][0] = 0;
        lastVeloFuel[playerid][0] = 0;
        lastVeloGear[playerid][0] = 0;
        // FIX AUDIT VELOCIMETRO VEL-A2-13/A2-05/A3-02 (MEDIO): matar TimerVelo + reset variable en ZerarDados.
        // Antes: ZerarDados NO mataba TimerVelo (solo lo hacia OnPlayerDisconnect L21454).
        // Si un slot era reusado, el timer del jugador anterior podia seguir disparando.
        if(TimerVelo[playerid]) { KillTimer(TimerVelo[playerid]); TimerVelo[playerid] = 0; }
        // FIX AUDIT AGENT4 AFK-07: resetear variables de tracking anti-AFK de
        // patrulla. Sin esto, si un slot es reusado por un nuevo jugador que
        // entra en patrulla y por algun bug el timer CheckPatrulhaAFK dispara
        // antes de StartPatrulhaAFKTimer, usaria posiciones stale del policia
        // anterior. Defensa en profundidad.
        g_PatrulhaLastX[playerid] = 0.0;
        g_PatrulhaLastY[playerid] = 0.0;
        g_PatrulhaLastZ[playerid] = 0.0;
        g_PatrulhaAFKTimer[playerid] = 0;
        // FIX AUDIT AFK H4: resetear timer TestAway y gracia post-spawn en ZerarDados.
        // Antes: si un jugador A se desconectaba mid-countdown y el slot era reusado
        // por jugador B, el timer TestAway seguia disparando sobre el slot de B.
        // Ahora: KillTimer del TestAway pendiente y reset de variables.
        if(g_TestAwayTimer[playerid]) { KillTimer(g_TestAwayTimer[playerid]); g_TestAwayTimer[playerid] = 0; }
        // Reset de gracia post-spawn (no arrastrar timestamp del jugador anterior).
        g_LastSpawnTs[playerid] = 0;
        // FIX AUDIT AFK H6: resetear flag de /dormir//descansar (no arrastrar estado).
        g_DormindoODescansando[playerid] = false;
        PegouMaterial[playerid] = false;
        // FIX AUDIT HAMBRE H1-4: KillTimer TimerFomebar/TimerSedebar en ZerarDados.
        // Antes: solo se seteaba TimerFomebar[playerid] = 0 (perdiendo el ID del timer
        // sin matarlo). Si el slot se reusaba, el timer seguia corriendo sobre el
        // nuevo jugador (hambre/sed 2x). Ahora: matar el timer si esta activo.
        if(TimerFomebar[playerid]) { KillTimer(TimerFomebar[playerid]); TimerFomebar[playerid] = 0; }
        if(TimerSedebar[playerid]) { KillTimer(TimerSedebar[playerid]); TimerSedebar[playerid] = 0; }
        // MEJORA HAMBRE #1: resetear Sueno y matar TimerSueno en ZerarDados.
        SuenoPlayer[playerid] = 100;
        if(TimerSueno[playerid]) { KillTimer(TimerSueno[playerid]); TimerSueno[playerid] = 0; }
        // MEJORA HAMBRE #2: resetear Estamina en ZerarDados.
        EstaminaPlayer[playerid] = 100;
        // FIX AUDIT HAMBRE H3-3: resetear caches de hambre/sed en ZerarDados.
        // Antes: Colete_lastFome/Sede no se reseteaban. En slot reuse, el nuevo
        // jugador heredaba el cache de TextDraw del anterior. El primer tick
        // de Colete comparaba str (nuevo valor) con cache (viejo) y si eran
        // iguales NO actualizaba los TDs. Ahora: resetear a string vacio
        // para forzar actualizacion en el primer tick.
        Colete_lastFome[playerid][0] = '\0';
        Colete_lastSede[playerid][0] = '\0';
        TimerColete[playerid] = 0;
        TimerUpdate[playerid] = 0;
        TimerPBugar[playerid] = 0;
        TimerPayDay[playerid] = 0;
        TimerAttVeh[playerid] = 0;
        TimerRadar[playerid] = 0;
        TimerLocalizar[playerid] = 0;
        TimerTesteAerea[playerid] = 0;
        TimerTesteCaminhao[playerid] = 0;
        TimerTesteVeiculo[playerid] = 0;
        TimerTesteMoto[playerid] = 0;
        // FIX AUDIT-AUDIT6-005 (ALTO): resetear 5/5 timers (faltaba Trailero).
        // ANTES: ZerarDados reseteaba solo 4 (Aerea, Caminhao, Veiculo, Moto).
        // Slot-reuse heredaba TimerTesteTrailero stale. KillTimer sobre ID reciclado podria matar timer ajeno.
        if(TimerTesteTrailero[playerid]) { KillTimer(TimerTesteTrailero[playerid]); TimerTesteTrailero[playerid] = 0; }
        if(TimerHacker[playerid]) { KillTimer(TimerHacker[playerid]); TimerHacker[playerid] = 0; } // FIX AUDIT9 BUG1: matar timer antes de reset
        Assistindo[playerid] = -1;
        Erro[playerid] = 0;
        ErroLogin[playerid] = 0; // FIX AUDIT LOGIN F2-9: reset de ErroLogin en ZerarDados
        Cargase[playerid] = false;
        // FIX AUDIT8 BUG1: reset de variables camionero (state-leak en slot-reuse)
        if(CamionReconTmr[playerid] != -1) { KillTimer(CamionReconTmr[playerid]); CamionReconTmr[playerid] = -1; }
        // FIX AUDIT CAMIONERO CAM-A1-08/CAM-A5-18 (MEDIO): matar timer de abandono (30s) en ZerarDados.
        // Antes: ZerarDados mataba CamionReconTmr (3min) pero NO g_CamionAbandonoTmr. Si el slot previo
        // dejo un timer de abandono vivo (disconnect abrupto), el nuevo ocupante lo heredaba stale.
        if(g_CamionAbandonoTmr[playerid] != -1) { KillTimer(g_CamionAbandonoTmr[playerid]); g_CamionAbandonoTmr[playerid] = -1; }
        // FIX AUDIT EMPAQUETADOR EMP-A1-01/A2-02 (ALTO): matar g_EmpAbandonoTmr y g_EmpProxTiendaTmr en ZerarDados.
        if(g_EmpAbandonoTmr[playerid] != -1) { KillTimer(g_EmpAbandonoTmr[playerid]); g_EmpAbandonoTmr[playerid] = -1; }
        if(g_EmpProxTiendaTmr[playerid] != -1) { KillTimer(g_EmpProxTiendaTmr[playerid]); g_EmpProxTiendaTmr[playerid] = -1; }
        // SISTEMA EMPAQUETADOR REDISEÃ¯Â¿Â½ADO: reset en ZerarDados.
        if(g_EmpDescargaTmr[playerid] != -1) { KillTimer(g_EmpDescargaTmr[playerid]); g_EmpDescargaTmr[playerid] = -1; }
        if(g_EmpRecogerTmr[playerid] != -1) { KillTimer(g_EmpRecogerTmr[playerid]); g_EmpRecogerTmr[playerid] = -1; }
        if(g_EmpCajaObj[playerid] != -1) { DestroyDynamicObject(g_EmpCajaObj[playerid]); g_EmpCajaObj[playerid] = -1; }
        g_EmpRutaActiva[playerid] = 0;
        g_EmpNivelActual[playerid] = 0;
        g_EmpEntregasHechas[playerid] = 0;
        g_EmpEntregasTotales[playerid] = 0;
        g_EmpEsperandoDescarga[playerid] = 0;
        g_EmpTieneCaja[playerid] = 0;
        g_EmpCajaActivaIdx[playerid] = -1;
        g_EmpFaseEntrega[playerid] = 0;
        // FIX VERIFY-A5: matar freeze timer antes de resetear (consistencia con otros 4 timers Empaquetador).
        if(g_EmpFreezeTmr[playerid] != -1) { KillTimer(g_EmpFreezeTmr[playerid]); g_EmpFreezeTmr[playerid] = -1; }
        g_EmpVehiculoCongelado[playerid] = 0;
        g_EmpVehiculoAsignado[playerid] = INVALID_VEHICLE_ID;
        g_EmpTiendasUsadas[playerid] = 0;
        g_EmpCajasUsadas[playerid] = 0;
        // Cargar progresion persistente desde PVars (restaurada al reconectar)
        g_EmpCajasCompletadas[playerid] = GetPVarInt(playerid, "EmpCajasCompletadas");
        g_EmpRecorridosCompletados[playerid] = GetPVarInt(playerid, "EmpRecorridosCompletados");
        // FIX AUDIT CAMIONERO CAM-A2-06 (MEDIO): resetear cooldown de /cargar en ZerarDados.
        g_CamionLastCargar[playerid] = 0;
        // FIX AUDIT CONSTRUCTOR CON-A1-04/A2-02/A3-07/A4-01/A5-05 (ALTO): resetear cooldown de material en ZerarDados.
        // Antes: g_LastMatCollect (cooldown 30s del Constructor, FIX SPRINT3 B-16) NO se reseteaba en ZerarDados.
        // Si el slot era reusado, el nuevo jugador heredaba el cooldown del anterior (slot-reuse leak).
        g_LastMatCollect[playerid] = 0;
        // FIX UX CONSTRUCTOR #7: resetear contador de racha en ZerarDados (slot-reuse defense).
        g_MatCounter[playerid] = 0;
        // FIX SEPULTURERO: resetear estado del Sepulturero en ZerarDados (slot-reuse defense).
        g_SepultureroTieneCadaver[playerid] = 0;
        g_SepultureroEnHospital[playerid] = 0;
        g_SepultureroPagoPendiente[playerid] = 0;
        g_SepultureroHospitalOrigen[playerid] = 0;
        g_SepultureroLastRecoger[playerid] = 0;
        g_SepultureroRacha[playerid] = 0;
        if(g_SepultureroHospitalTmr[playerid] != -1) { KillTimer(g_SepultureroHospitalTmr[playerid]); g_SepultureroHospitalTmr[playerid] = -1; }
        // FIX AUDIT RECOLECTOR REC-A1-02/A2-01/A4-05/A5-02: matar timers Cova/BotouBau en ZerarDados.
        if(g_CovaTmr[playerid] != -1) { KillTimer(g_CovaTmr[playerid]); g_CovaTmr[playerid] = -1; }
        if(g_BotouBauTmr[playerid] != -1) { KillTimer(g_BotouBauTmr[playerid]); g_BotouBauTmr[playerid] = -1; }
        // MEJORA RECOLECTOR #10: reset racha en ZerarDados (slot-reuse defense).
        g_RecolectorRacha[playerid] = 0;
        // SISTEMA RECOLECTOR NIVEL 2: reset completo en ZerarDados (slot-reuse defense).
        if(g_RecNivel2LatonObj[playerid] != -1) { DestroyDynamicObject(g_RecNivel2LatonObj[playerid]); g_RecNivel2LatonObj[playerid] = -1; }
        if(g_RecNivel2DescargaTmr[playerid] != -1) { KillTimer(g_RecNivel2DescargaTmr[playerid]); g_RecNivel2DescargaTmr[playerid] = -1; }
        if(g_RecNivel2RecogerTmr[playerid] != -1) { KillTimer(g_RecNivel2RecogerTmr[playerid]); g_RecNivel2RecogerTmr[playerid] = -1; }
        g_RecNivel2Activo[playerid] = 0;
        g_RecNivel2Punto[playerid] = 0;
        g_RecNivel2Recogidos[playerid] = 0;
        g_RecNivel2Vehiculo[playerid] = -1;
        g_RecNivel2LatonPunto[playerid] = -1;
        g_RecNivel2EsperandoDescarga[playerid] = 0;
        CamionVehId[playerid] = -1;
        CamionPago[playerid] = 0;
        CamionCargando[playerid] = false;
        CamionDescargando[playerid] = false;
        CamionEnRuta[playerid] = false;
        MostrandoRG[playerid] = false;
        // FIX AUDIT RG RG-A1-01/RG-A3-01 (CRITICO): cleanup wizard RG en ZerarDados.
        // ANTES: si el jugador se desconectaba con wizard en progreso o timer criandorg
        // pendiente, el slot reusado heredaba el estado. Otro jugador recibia pRG=1 gratis.
        // Ahora: KillTimer + reset flags en ZerarDados (llamado en disconnect/slot-reuse).
        if(g_CriandoRGTmr[playerid]) { KillTimer(g_CriandoRGTmr[playerid]); g_CriandoRGTmr[playerid] = 0; }
        g_WizardRGStage[playerid] = 0;
        // FIX AUDIT RG RG-A3-02 (CRITICO): ocultar TD_RG visibles en disconnect/slot-reuse.
        // ANTES: TD_RG globales NO se ocultaban en disconnect. Slot reusado heredaba TDs visibles.
        for(new r=0;r<24;r++) TextDrawHideForPlayer(playerid, TD_RG[r]);
        for(new r=0;r<6;r++) PlayerTextDrawHide(playerid, RG_p[playerid][r]);
        CancelSelectTextDraw(playerid);
        Carregou[playerid] = 0;
        ocupadodemais[playerid] = 0;
        RepairCar[playerid] = 0;
        CarregandoTelaLogin[playerid] = 0;
        TimerLogin[playerid] = 0;
        CheckpointPontosMoto[playerid] = 0;
        CheckpointPontosVeiculo[playerid] = 0;
        CheckpointPontosCaminhao[playerid] = 0;
        CheckpointPontosTrailero[playerid] = 0;
        IniciouTesteHabilitacaoA[playerid] = 0;
        AutoEscolaMoto[playerid] = 0;
        IniciouTesteHabilitacaoB[playerid] = 0;
        AutoEscolaVeiculo[playerid] = 0;
        IniciouTesteHabilitacaoC[playerid] = 0;
        AutoEscolaCaminhao[playerid] = 0;
        IniciouTesteHabilitacaoD[playerid] = 0;
        IniciouTesteHabilitacaoE[playerid] = 0;
        AutoEscolaTrailero[playerid] = 0;
        // FIX AUDIT LIC LIC-A1-02 (CRITICO): reset trailer var en ZerarDados.
        AutoEscolaTrailer[playerid] = 0;
        // FIX AUDIT-AUDIT6-019 (ALTO): resets RotaHabilitacao* eliminados (variables eliminadas - dead code).
        CheckpointPontosAerea[playerid] = 0;
        AutoEscolaAerea[playerid] = 0;
        // FIX P1-4: INVALID_VEHICLE_ID en vez de 0. El ID 0 es un vehiculo valido;
        // las guardas que comparan != INVALID_VEHICLE_ID trataban 0 como "valido".
        VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
        Covaconcerto[playerid] = false;
        Podecmd[playerid] = true;
        ltumba[playerid] = false;
        EmServico[playerid] = false;
        PegandoCajas[playerid] = false;
        RecentlyShot[playerid] = 0;
        InventarioAberto[playerid] = 0;
        SetPlayerColor(playerid, 0xFFFFFFFF);
        SetPlayerSkillLevel(playerid,WEAPONSKILL_PISTOL,200);
    SetPlayerSkillLevel(playerid,WEAPONSKILL_MICRO_UZI,200);
        for(new i=0;i<6;i++){
                Preview[playerid][i] = 0;
        }
        EntregaSdx[playerid] = false;

        // =====================================================================
        // CAMBIO 2026-07-09 - Bug #13: reset de 17 variables medicas faltantes.
        // Antes: estas variables no se reseteaban en ZerarDados, causando
        // state-leak entre sesiones (especialmente tras /gmx).
        // Ahora: se resetean TODAS a sus valores por defecto, y se destruyen
        // los recursos huÃ¯Â¿Â½rfanos (sangre, CP, timer de localizador) si quedaron
        // activos al momento del reset.
        // =====================================================================

        // 1. Destruir recursos huÃ¯Â¿Â½rfanos ANTES de resetear las variables
        //    (necesitamos el valor actual para saber quÃ¯Â¿Â½ destruir).
        if(SangueObjeto[playerid] > -1)
        {
            DestroyObject(SangueObjeto[playerid]);
            SangueObjeto[playerid] = -1;
        }
        if(CheckMEDICO[playerid] > -1)
        {
            DestroyDynamicCP(CheckMEDICO[playerid]);
            CheckMEDICO[playerid] = -1;
        }
        if(HandleLocalizador[playerid] != -1)
        {
            KillTimer(HandleLocalizador[playerid]);
            HandleLocalizador[playerid] = -1;
        }

        // 2. Reset de variables medicas a sus valores por defecto.
        paramedico[playerid] = false;
        EntrouHosp[playerid] = 0;
        Flooder[playerid] = 0;
        ChamouPolicia[playerid] = 0;
        VezesMorreu[playerid] = 0;
        SegundosAviso[playerid] = 0;
        // SISTEMA ANTI-CHEAT: inicializar variables
        g_AC_LastUpdate[playerid] = 0;
        g_AC_Strikes[playerid] = 0;
        // FIX AUDIT AC-MEJORA1: resetear contador de throttle anti-weapon en ZerarDados.
        g_AC_UpdateCount[playerid] = 0;
        // FIX AUDIT AGENT3 SP-01: resetear variables de rate-limit de comandos
        g_CmdLastTick[playerid] = 0;
        g_CmdWindowStart[playerid] = 0;
        g_CmdCountWindow[playerid] = 0;
        g_CmdStrikes[playerid] = 0;
        // FIX AUDIT AGENT1 WC-01 FULL: resetear tracking server-side de armas.
        // Sin esto, si un slot es reusado por un nuevo jugador, heredaria
        // el tracking de armas del jugador anterior (falso positivo de cheat).
        for(new s = 0; s < 13; s++)
        {
                g_PlayerWeapons[playerid][s][0] = 0;
                g_PlayerWeapons[playerid][s][1] = 0;
        }
        g_PlayerWeaponsSynced[playerid] = false;
        // FIX AUDIT AGENT4 AFK-12: resetear AntiAFK_Ativado per-jugador a true
        // (por defecto, AntiAFK activado para todos los jugadores nuevos).
        AntiAFK_Ativado[playerid] = true;
        // FIX AUDIT AGENT4 AFK-10: resetear strikes AFK (no acumular entre sesiones
        // en el mismo slot). Para persistencia real entre sesiones, ver SalvarDados.
        g_AFKStrikes[playerid] = 0;
        g_AFKLastKickTs[playerid] = 0;
        // FIX AUDIT AFK H8: resetear ban temporal AFK en ZerarDados (slot reuse).
        // Si el slot se reusa, el nuevo jugador NO debe heredar el ban del anterior.
        // El ban se persiste en disco via SalvarDados y se carga en OnPlayerConnect.
        g_AFKBanUntilTs[playerid] = 0;
        g_AC_LastX[playerid] = 0.0;
        g_AC_LastY[playerid] = 0.0;
        g_AC_LastZ[playerid] = 0.0;
        SetPVarInt(playerid, "ACTPImmune", gettime()); // inmunidad inicial 5s
        PlanoSaude[playerid] = 0;
        KitsMedicos[playerid] = 0;
        KitsMedicosGratuitos[playerid] = 0;
        Vendajes[playerid] = 0; // CAMBIO 2026-07-18
        Sangrando[playerid] = false; // CAMBIO 2026-07-18
        SangradoTick[playerid] = 0; // CAMBIO 2026-07-18
        Enfermedad[playerid] = 0; // CAMBIO 2026-07-18
        EnfermedadTick[playerid] = 0; // CAMBIO 2026-07-18
        EnfermedadTiempo[playerid] = 0; // CAMBIO 2026-07-18
        TieneReceta[playerid] = 0; // CAMBIO 2026-07-18
        LluviaTick[playerid] = 0; // CAMBIO 2026-07-18
        ItemAntigripal[playerid] = 0; // CAMBIO 2026-07-20: reset items de cura
        ItemAntibiotico[playerid] = 0;
        ItemSuero[playerid] = 0;
        EfectoTick[playerid] = 0; // CAMBIO 2026-07-20: reset efectos visuales
        TosUltimaVez[playerid] = 0;
        TriagePrio[playerid] = 0; // CAMBIO 2026-07-20: reset triaje
        TriageMedico[playerid] = -1;
        Fractura[playerid] = 0; // CAMBIO 2026-07-20: reset fractura
        FracturaTick[playerid] = 0;
        CaidaAltura[playerid] = 0.0;
        CaidaX[playerid] = 0.0; // FIX BUG #2
        CaidaY[playerid] = 0.0; // FIX BUG #2
        InteriorAnterior[playerid] = 0; // FIX CRASH 2026-07-20
        VelocidadeVeh[playerid] = 0.0; // CAMBIO 2026-07-20: reset velocidad vehicular
        SaliendoVehMovil[playerid] = 0;
        Quemadura[playerid] = 0; // CAMBIO 2026-07-20: reset quemadura
        QuemaduraTick[playerid] = 0;
        SolTick[playerid] = 0;
        ItemPomada[playerid] = 0;
        CurarTarget[playerid] = -1; // CAMBIO 2026-07-20: reset cobro escalonado
        CurarCosto[playerid] = 0;
        CurarDetalle[playerid][0] = EOS;
        // Nota: las vacunas NO se resetean en ZerarDados porque persisten 7 dias reales
        // Solo se resetean en cuentas nuevas (OnPlayerDisconnect no las toca)
        SegundosOrg10[playerid] = 0; // CAMBIO 2026-07-12 - Fase 2
        SegundosOrg1[playerid] = 0;  // P1-PN-Vehiculos: reset horas PN
        Localizando[playerid] = -1; // ya estaba arriba pero reafirmamos por seguridad
        MatouPlayer[playerid] = -1;
        FoiSocorrido[playerid] = 0;
        MinutosMorte[playerid] = 0;
        SegundosMorte[playerid] = 0;
        XMorte[playerid] = -1.0;
        YMorte[playerid] = -1.0;
        ZMorte[playerid] = -1.0;
        InteriorMorte[playerid] = 0;
        // =====================================================================

        return 1;
}

stock SalvarDados(playerid)
{
        // FIX AUDIT4 PERS-HIGH-03: validar conexion antes de persistir. Evita
        // escribir datos stale/incompletos de un slot ya desconectado (p ej.
        // cuando el callback SaveTimer tiene un indice que se desconecto entre
        // ticks).
        if(!IsPlayerConnected(playerid)) return 1;
        // FIX AUDIT LOGIN F3-2: mutex g_Saving contra re-entry.
        // Si SalvarDados ya se esta ejecutando para este playerid (llamado
        // desde otro punto del mismo tick), salir para no pisar el guardado.
        if(g_Saving[playerid]) return 1;
        g_Saving[playerid] = true;
        new File[500];
        // FIX AUDIT LOGIN F2-2: Email ampliado a 64 chars (igual que pEmail[64] en enum pInfo L793).
        // Antes: Email[25] + format(Email, 24, ...) trunciaba silenciosamente el
        // email a 23 caracteres al persistir. DIALOG_EMAIL validaba 13-40 chars,
        // asi que los emails de 24-40 chars se aceptaban en registro pero se
        // guardaban truncados. Al reconectar, /cuenta mostraba el email cortado.
        // Ahora: Email[64] + format con sizeof(Email) para no hardcodear.
        new Data[24], Email[64], Dia, Mes, Ano, Hora, Minuto, Float:A, Float:X, Float:Y, Float:Z;
        // FIX AUDIT4 PERS-HIGH-04: si esta spectating, usar posicion guardada en memoria
        // para no persistir la posicion del espectado.
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING)
        {
                X = PlayerInfo[playerid][pCamX];
                Y = PlayerInfo[playerid][pCamY];
                Z = PlayerInfo[playerid][pCamZ];
                Pos[0] = PlayerInfo[playerid][pPosX];
                Pos[1] = PlayerInfo[playerid][pPosY];
                Pos[2] = PlayerInfo[playerid][pPosZ];
        }
        else if(GetPlayerState(playerid) == PLAYER_STATE_WASTED)
        {
                // FIX AUDIT LOGIN F2-7: si el jugador esta muerto (WASTED), usar
                // posicion guardada en memoria para no persistir 0,0,0 (posicion
                // fantasma). Antes: si el jugador moria y se llamaba SalvarDados
                // antes de respawn, GetPlayerPos devolvia 0,0,0 (o posicion invalida)
                // y se guardaba como posicion del jugador. Al reconectar, aparecia
                // en el centro del mapa. Lo mismo para health/armour.
                X = PlayerInfo[playerid][pCamX];
                Y = PlayerInfo[playerid][pCamY];
                Z = PlayerInfo[playerid][pCamZ];
                Pos[0] = PlayerInfo[playerid][pPosX];
                Pos[1] = PlayerInfo[playerid][pPosY];
                Pos[2] = PlayerInfo[playerid][pPosZ];
        }
        else
        {
                GetPlayerCameraPos(playerid, X, Y, Z);
                GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
        }
        gettime(Hora, Minuto);
        getdate(Ano, Mes, Dia);
        GetPlayerFacingAngle(playerid, A);
        new Float:health;
        GetPlayerHealth(playerid,health);
        new Float:armour;
        GetPlayerArmour(playerid,armour);
        // FIX AUDIT LOGIN F0-4: clamp health/armour al persistir.
        // Antes: si el jugador estaba en estado herido (OnPlayerDeath setea
        // SetPlayerHealth(1000000.0)), SalvarDados guardaba pVida=1000000 en
        // el archivo INI. Al reconectar, DIALOG_LOGIN cargaba pVida=1000000,
        // TxdLogin aplicaba SetPlayerHealth(1000000), y el anti-cheat
        // OnPlayerUpdate L28241 lo kickeaba por HP>100. El jugador quedaba
        // PERMANENTEMENTE BLOQUEADO de su cuenta (kick loop infinito).
        // Ahora: si health>100, lo guardamos como 100 (maximo legitimo).
        // Idem armour: maximo 100 (no se puede tener chaleco > 100 legitimo).
        if(health > 100.0) health = 100.0;
        if(health < 0.0) health = 0.0;
        if(armour > 100.0) armour = 100.0;
        if(armour < 0.0) armour = 0.0;
        format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
        format(Email, sizeof(Email), "%s", PlayerInfo[playerid][pEmail]); // FIX AUDIT LOGIN F2-2: usar sizeof en vez de 24 hardcoded

        format(File, sizeof(File), PASTA_CONTAS, Name(playerid));
        // FIX SPRINT3 M-10: crear archivo si no existe.
        // Antes: si DOF2_FileExists(File) era false (cuenta recien migrada o archivo
        // corrupto), SalvarDados no persistia NADA. El jugador podia perder todo el
        // progreso de la sesion. Ahora: si no existe, crearlo antes de escribir.
        if(!DOF2_FileExists(File))
                DOF2_CreateFile(File);
        if(DOF2_FileExists(File))
        {
                DOF2_SetInt(File, "IDF", PlayerInfo[playerid][IDF]);
                DOF2_SetString(File,"pEmail", Email);
                DOF2_SetInt(File, "pDinheiro", PlayerInfo[playerid][pDinheiro]);
                DOF2_SetInt(File,"pSexo", PlayerInfo[playerid][pSexo]);
                DOF2_SetInt(File, "pBanco", PlayerInfo[playerid][pBanco]);
                DOF2_SetInt(File, "pIdade", PlayerInfo[playerid][pIdade]);
                DOF2_SetInt(File, "pSegundosJogados", PlayerInfo[playerid][pSegundosJogados]);
                DOF2_SetInt(File, "pAvisos", PlayerInfo[playerid][pAvisos]);
                DOF2_SetInt(File, "pjail", PlayerInfo[playerid][pjail]);
                // P1-FBI-2: persistir modo encubierto FBI entre sesiones
                DOF2_SetInt(File, "pEncubierto", PlayerInfo[playerid][pEncubierto] ? 1 : 0);
                DOF2_SetInt(File, "MinutosMorte", MinutosMorte[playerid]);
                DOF2_SetInt(File, "SegundosMorte", SegundosMorte[playerid]);
                // FIX AUDIT MEDICO A3-HIGH-03: persistir MatouPlayer y FoiSocorrido.
                // ANTES: estas variables se reseteaban al reconectar (ZerarDados L22019-22020).
                // El anti-farm de /socorrer (MatouPlayer[playerid] == target || (gettime() - FoiSocorrido[target]) <= 600)
                // se podia bypass con: matar a alguien, desconectarse, reconectar, socorrerlo = pago $0 evadido.
                // AHORA: persistir en disco para que el bypass por reconexion no funcione.
                // MatouPlayer guarda el IDF del ultimo jugador que este player mato (o -1 si nadie).
                // FoiSocorrido guarda el timestamp del ultimo socorro recibido (o 0 si nunca).
                DOF2_SetInt(File, "MatouPlayer", MatouPlayer[playerid]);
                DOF2_SetInt(File, "FoiSocorrido", FoiSocorrido[playerid]);
                // FIX AUDIT CEL CEL-A2-01 (CRITICO): persistir TiempoAnuncio.
                // ANTES: solo se reseteaba en ZerarDados L19422 al desconectar. Esto permitia
                // bypass del cooldown de 60s reconectando. Ahora persistimos el valor restante.
                DOF2_SetInt(File, "TiempoAnuncio", TiempoAnuncio[playerid]);
                // FIX AUDIT CEL MEJORA-4 (ALTO): persistir DefibCooldown (item 11738).
                // ANTES: DefibCooldown era un PVar temporal que se reseteaba al reconectar.
                // El cooldown de 60s del defibrilador civil se podia bypass reconectando:
                // jugador usaba /defibrilador, se desconectaba, reconectaba, cooldown=0.
                // Ahora persistimos el timestamp en disco.
                DOF2_SetInt(File, "DefibCooldown", GetPVarInt(playerid, "DefibCooldown"));
                // FIX AUDIT CHAL MEJORA-4 (ALTO): persistir CD_selfheal.
                // ANTES: CD_selfheal era PVar temporal, se reseteaba al reconectar.
                // El cooldown de 60s de /chaleco, /chalecome, /chalecostaff, /curarme,
                // /curarstaff, /revivirme se podia bypass reconectando. Ahora persistimos.
                DOF2_SetInt(File, "CD_selfheal", GetPVarInt(playerid, "CD_selfheal"));
                DOF2_SetInt(File, "PlanoSaude", PlanoSaude[playerid]);
                DOF2_SetInt(File, "KitsMedicos", KitsMedicos[playerid]); // Fase 1: persistir kits
                DOF2_SetInt(File, "KitsMedicosGratuitos", KitsMedicosGratuitos[playerid]); // CAMBIO 2026-07-09 - Bug #7: persistir tope de kits gratis por payday
                DOF2_SetInt(File, "Vendajes", Vendajes[playerid]); // CAMBIO 2026-07-18: persistir vendajes
                DOF2_SetInt(File, "Enfermedad", Enfermedad[playerid]); // CAMBIO 2026-07-20: persistir enfermedad activa
                // FIX AUDIT MEDICO MED-A5-06: persistir EnfermedadTick y EnfermedadTiempo.
                // ANTES: solo se persistia Enfermedad (tipo). Tick y Tiempo se reseteaban al reconectar.
                // Eso permitia bypass de progresion a neumonia: desconectar, reconectar, volver a empezar.
                // AHORA: persistir ambos para que la progresion continue tras reconexion.
                DOF2_SetInt(File, "EnfermedadTick", EnfermedadTick[playerid]);
                DOF2_SetInt(File, "EnfermedadTiempo", EnfermedadTiempo[playerid]);
                DOF2_SetInt(File, "TieneReceta", TieneReceta[playerid]); // CAMBIO 2026-07-20: persistir receta medica activa
                DOF2_SetInt(File, "ItemAntigripal", ItemAntigripal[playerid]); // CAMBIO 2026-07-20: persistir items de cura
                DOF2_SetInt(File, "ItemAntibiotico", ItemAntibiotico[playerid]);
                DOF2_SetInt(File, "ItemSuero", ItemSuero[playerid]);
                DOF2_SetInt(File, "Fractura", Fractura[playerid]); // CAMBIO 2026-07-20: persistir fractura activa
                DOF2_SetInt(File, "FracturaTick", FracturaTick[playerid]);
                DOF2_SetInt(File, "Quemadura", Quemadura[playerid]); // CAMBIO 2026-07-20: persistir quemadura
                DOF2_SetInt(File, "QuemaduraTick", QuemaduraTick[playerid]);
                DOF2_SetInt(File, "ItemPomada", ItemPomada[playerid]);
                DOF2_SetInt(File, "VacunaAntigripal", VacunaAntigripal[playerid]); // CAMBIO 2026-07-20: persistir vacunas
                DOF2_SetInt(File, "VacunaAntitetanica", VacunaAntitetanica[playerid]);
                DOF2_SetInt(File, "VacunaAntirrabica", VacunaAntirrabica[playerid]);
                DOF2_SetInt(File, "VacunaHepatitis", VacunaHepatitis[playerid]);
                DOF2_SetInt(File, "SegundosOrg10", SegundosOrg10[playerid]); // CAMBIO 2026-07-12 - Fase 2: persistir horas en Org 10
                DOF2_SetInt(File, "SegundosOrg1", SegundosOrg1[playerid]); // P1-PN-Vehiculos: persistir horas en Org 1
                DOF2_SetString(File, "pLastLogin", Data);
                DOF2_SetInt(File, "pInterior", GetPlayerInterior(playerid));
                // FIX AUDIT SPAWN S2-2: persistir VirtualWorld.
                // Antes: el VW no se guardaba. Si el jugador se desconectaba en VW != 0,
                // al reconectar aparecia en VW 0 (por defecto). No volvia a su VW.
                // Ahora: guardar VW y cargarlo en DIALOG_LOGIN.
                DOF2_SetInt(File, "pVW", GetPlayerVirtualWorld(playerid));
                DOF2_SetFloat(File, "pPosX", Pos[0]);
                DOF2_SetFloat(File, "pPosY", Pos[1]);
                DOF2_SetFloat(File, "pPosZ", Pos[2]);
                DOF2_SetFloat(File, "pPosA", A);
                DOF2_SetFloat(File, "pCamX", X);
                DOF2_SetFloat(File, "pCamY", Y);
                DOF2_SetFloat(File, "pCamZ", Z);
                DOF2_SetBool(File, "pCongelado", PlayerInfo[playerid][pCongelado]);
                DOF2_SetBool(File, "pCalado", PlayerInfo[playerid][pCalado]);
                // FIX AUDIT HAMBRE H0-2: clamp [0,100] al guardar pFome/pSede.
                // Antes: si FomePlayer=114 en memoria (comer con fomesede max 20 a 94),
                // se persistia pFome=114. El jugador tenia ~5.3h de buffer extra de
                // hambre. Ahora: clamp bidireccional antes de persistir. Variables
                // locales en scope de bloque para no contaminar el resto de la funcion.
                { new fomeClamp = FomePlayer[playerid]; if(fomeClamp < 0) fomeClamp = 0; if(fomeClamp > 100) fomeClamp = 100; new sedeClamp = SedePlayer[playerid]; if(sedeClamp < 0) sedeClamp = 0; if(sedeClamp > 100) sedeClamp = 100; DOF2_SetInt(File, "pFome", fomeClamp); DOF2_SetInt(File, "pSede", sedeClamp); }
                DOF2_SetInt(File, "pCoins", PlayerInfo[playerid][pCoins]);
                // FIX ALTO-VIP-004 (ALTO): persistir pVIP y ExpiraVIP en Contas/.ini.
                DOF2_SetInt(File, "pVIP", PlayerInfo[playerid][pVIP]);
                DOF2_SetInt(File, "ExpiraVIP", PlayerInfo[playerid][ExpiraVIP]);
                DOF2_SetInt(File, "pProfissao", PlayerInfo[playerid][pProfissao]);
                DOF2_SetInt(File, "pOrg", PlayerInfo[playerid][Org]);
                DOF2_SetInt(File, "pCargo", PlayerInfo[playerid][Cargo]);
                DOF2_SetInt(File, "pProcurado", GetPlayerWantedLevel(playerid));
                DOF2_SetInt(File, "pMultas", PlayerInfo[playerid][pMultas]);
                DOF2_SetInt(File, "pCasa", PlayerInfo[playerid][Casa]);
                DOF2_SetInt(File, "pLevel", GetPlayerScore(playerid));
                DOF2_SetInt(File, "pXP", PlayerInfo[playerid][pXP]);
                DOF2_SetInt(File, "LicencaConduzir", PlayerInfo[playerid][LicencaConduzir]);
                DOF2_SetString(File, "pNome", PlayerInfo[playerid][pNome]);
                DOF2_SetString(File, "pNascimento", PlayerInfo[playerid][pNascimento]);
                DOF2_SetString(File, "pPai", PlayerInfo[playerid][pPai]);
                DOF2_SetString(File, "pMae", PlayerInfo[playerid][pMae]);
                DOF2_SetInt(File, "pRG", PlayerInfo[playerid][pRG]);
                DOF2_SetInt(File, "pCarteiraT", PlayerInfo[playerid][pCarteiraT]);
                DOF2_SetInt(File, "Piezas", PlayerInfo[playerid][PiezasArma]);
                DOF2_SetFloat(File, "pVida", health);
                DOF2_SetFloat(File, "pColete", armour);
                DOF2_SetInt(File, "ImpuestoPendiente", PlayerInfo[playerid][ImpuestoPendiente]);
                DOF2_SetInt(File, "ImpuestoPayDaysSinPagar", PlayerInfo[playerid][ImpuestoPayDaysSinPagar]);
                DOF2_SetInt(File, "BancoBloqueado", PlayerInfo[playerid][BancoBloqueado]);
                DOF2_SetInt(File, "DeudaFiscalReportada", PlayerInfo[playerid][DeudaFiscalReportada]);
                DOF2_SetInt(File, "LicenciaPesca", PlayerInfo[playerid][LicenciaPesca]);
                DOF2_SetInt(File, "LicenciaArmas", PlayerInfo[playerid][LicenciaArmas]);
                // FIX AUDIT2 AGENT4 SP-12: persistir strike counters para evitar bypass por reconexion.
                DOF2_SetInt(File, "AFKStrikes", g_AFKStrikes[playerid]);
                DOF2_SetInt(File, "AFKLastKickTs", g_AFKLastKickTs[playerid]);
                DOF2_SetInt(File, "CmdStrikes", g_CmdStrikes[playerid]);
                // FIX AUDIT FLOOD-H1: persistir g_CmdLastTick para que el decay funcione tras reconectar.
                DOF2_SetInt(File, "CmdLastTick", g_CmdLastTick[playerid]);
                // FIX AUDIT AC-H5: persistir g_AC_Strikes para evitar bypass por reconexion.
                DOF2_SetInt(File, "AC_Strikes", g_AC_Strikes[playerid]);
                // FIX AUDIT AFK H8: persistir ban temporal AFK para que sobreviva reconexion.
                DOF2_SetInt(File, "AFKBanUntilTs", g_AFKBanUntilTs[playerid]);
                // FIX AUDIT10 BUG1: persistir PuntosLicencia (Transito) para que no se resetee al reconectar.
                DOF2_SetInt(File, "T2_1_PuntosLicencia", GetPVarInt(playerid, "T2_1_PuntosLicencia"));
                // FIX AUDIT10 A4-X1: persistir durabilidad de herramientas (Ganzua/Taladro/LockPick).
                DOF2_SetInt(File, "GanzuaUsos", GetPVarInt(playerid, "GanzuaUsos"));
                DOF2_SetInt(File, "TaladroUsos", GetPVarInt(playerid, "TaladroUsos"));
                DOF2_SetInt(File, "LockPickUsos", GetPVarInt(playerid, "LockPickUsos"));
                // FIX AUDIT LOGIN F1-2: persistir pSkin en SalvarDados.
                // Antes: pSkin solo se persistia en SalvarDadosSkin (L18831,
                // funcion separada). Si SalvarDadosSkin no se llamaba (por
                // ejemplo en disconnect rapido, saveall, /gmx), el skin del
                // jugador se perdia al reconectar. Ahora: SalvarDados tambien
                // persiste pSkin como fuente principal. Si SalvarDadosSkin
                // despues tambien lo setea, no pasa nada (es idempotente).
                // Nota: usar GetPlayerSkin (skin actual en memoria) en vez
                // de PlayerInfo[playerid][pSkin] porque este ultimo puede
                // estar desactualizado si el skin cambio por comandos admin.
                DOF2_SetInt(File, "pSkin", GetPlayerSkin(playerid));
                // FIX AUDIT LOGIN F1-5: backup automatico antes de DOF2_SaveFile.
                // Antes: si el servidor crasheaba durante el DOF2_SaveFile() (flush
                // fisico a disco), el archivo Contas/<nick>.ini quedaba truncado o
                // corrupto. El jugador perdia TODOS sus datos al reconectar.
                //
                // Fix aplicado (sin modificar DOF2 internals, sin romper nada):
                //   1. Antes de DOF2_SaveFile, si el archivo ya existe en disco,
                //      copiarlo a Contas/backup/<nick>.ini.bak
                //   2. Si DOF2_SaveFile truÃ¯Â¿Â½a el archivo principal, el .bak sigue
                //      existiendo y se puede restaurar manualmente.
                //   3. Si DOF2_SaveFile funciona (caso normal), el .bak queda como
                //      snapshot del estado anterior al guardado actual.
                //
                // Nota: esto NO es atomic write real (eso requeriria fork DOF2),
                // pero SI es defense-in-depth: el .bak es un punto de restauracion
                // si el archivo principal se corrompe. El backup se hace solo en
                // disconnect/saveall/gmx (no en cada SaveTimer para no saturar disco).
                //
                // Para restaurar un backup: copiar manualmente
                //   Contas/backup/<nick>.ini.bak -> Contas/<nick>.ini
                // Se podria automatizar en OnGameModeInit (verificar archivos
                // corruptos y auto-restaurar .bak), pero eso seria F1-5 v2.
                if(DOF2_FileExists(File))
                {
                        new backupPath[256];
                        format(backupPath, sizeof(backupPath), "Contas/backup/%s.ini.bak", Name(playerid));
                        // Crear carpeta backup si no existe (DOF2 no crea carpetas).
                        // Si la carpeta no existe, DOF2_SaveFile falla silenciosamente
                        // y simplemente no se hace backup. El guardado principal
                        // no se ve afectado.
                        DOF2_CopyFile(File, backupPath);
                }
                DOF2_SaveFile();
        }
        // FIX AUDIT LOGIN F3-2: liberar mutex al final de SalvarDados.
        g_Saving[playerid] = false;
        return 1;
}

stock SalvarDadosSkin(playerid)
{
        new File[255];
        // FIX AUDIT LOGIN F2-2: Email ampliado a 64 chars (igual que pEmail[64] en enum pInfo L793).
        // Antes: Email[25] + format(Email, 24, ...) trunciaba silenciosamente el
        // email a 23 caracteres al persistir. DIALOG_EMAIL validaba 13-40 chars,
        // asi que los emails de 24-40 chars se aceptaban en registro pero se
        // guardaban truncados. Al reconectar, /cuenta mostraba el email cortado.
        // Ahora: Email[64] + format con sizeof(Email) para no hardcodear.
        new Data[24], Email[64], Dia, Mes, Ano, Hora, Minuto, Float:A, Float:X, Float:Y, Float:Z;
        GetPlayerCameraPos(playerid, X, Y, Z);
        gettime(Hora, Minuto);
        getdate(Ano, Mes, Dia);
        // FIX AUDIT SPAWN S1-5: no guardar 0,0,0 si esta spectating o WASTED.
        // Antes: GetPlayerPos en spectating mode retorna 0,0,0. Si el server
        // crasheaba entre SalvarDadosSkin y el primer SalvarDados post-spawn,
        // el disco tenia posicion 0,0,0 = oceano sur de LS = soft-lock.
        // Ahora: si esta spectating o WASTED, usar posicion guardada en memoria.
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || GetPlayerState(playerid) == PLAYER_STATE_WASTED)
        {
                Pos[0] = PlayerInfo[playerid][pPosX];
                Pos[1] = PlayerInfo[playerid][pPosY];
                Pos[2] = PlayerInfo[playerid][pPosZ];
        }
        else
        {
                GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
        }
        GetPlayerFacingAngle(playerid, A);
        new Float:health;
        GetPlayerHealth(playerid,health);
        new Float:armour;
        GetPlayerArmour(playerid,armour);
        // FIX AUDIT LOGIN F0-4: clamp health/armour al persistir (SalvarDadosSkin).
        // Ver comentario completo en SalvarDados (mas arriba). Mismo fix
        // aplicado a SalvarDadosSkin para evitar pVida=1000000 en disco.
        if(health > 100.0) health = 100.0;
        if(health < 0.0) health = 0.0;
        if(armour > 100.0) armour = 100.0;
        if(armour < 0.0) armour = 0.0;
        format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
        format(Email, sizeof(Email), "%s", PlayerInfo[playerid][pEmail]); // FIX AUDIT LOGIN F2-2: usar sizeof en vez de 24 hardcoded

        format(File, sizeof(File), PASTA_CONTAS, Name(playerid));
        if(DOF2_FileExists(File))
        {
                DOF2_SaveFile();
                DOF2_SetInt(File, "IDF", PlayerInfo[playerid][IDF]);
                DOF2_SetString(File,"pEmail", Email);
                DOF2_SetInt(File, "pSkin", GetPlayerSkin(playerid));
                DOF2_SetInt(File, "pDinheiro", PlayerInfo[playerid][pDinheiro]);
                DOF2_SetInt(File,"pSexo", PlayerInfo[playerid][pSexo]);
                DOF2_SetInt(File, "pBanco", PlayerInfo[playerid][pBanco]);
                DOF2_SetInt(File, "pIdade", PlayerInfo[playerid][pIdade]);
                DOF2_SetInt(File, "pSegundosJogados", PlayerInfo[playerid][pSegundosJogados]);
                DOF2_SetInt(File, "pAvisos", PlayerInfo[playerid][pAvisos]);
                DOF2_SetInt(File, "pjail", PlayerInfo[playerid][pjail]);
                // P1-FBI-2: persistir modo encubierto FBI entre sesiones
                DOF2_SetInt(File, "pEncubierto", PlayerInfo[playerid][pEncubierto] ? 1 : 0);
                DOF2_SetString(File, "pLastLogin", Data);
                DOF2_SetInt(File, "pInterior", GetPlayerInterior(playerid));
                // FIX AUDIT SPAWN S2-2: persistir VirtualWorld.
                // Antes: el VW no se guardaba. Si el jugador se desconectaba en VW != 0,
                // al reconectar aparecia en VW 0 (por defecto). No volvia a su VW.
                // Ahora: guardar VW y cargarlo en DIALOG_LOGIN.
                DOF2_SetInt(File, "pVW", GetPlayerVirtualWorld(playerid));
                DOF2_SetFloat(File, "pPosX", Pos[0]);
                DOF2_SetFloat(File, "pPosY", Pos[1]);
                DOF2_SetFloat(File, "pPosZ", Pos[2]);
                DOF2_SetFloat(File, "pPosA", A);
                DOF2_SetFloat(File, "pCamX", X);
                DOF2_SetFloat(File, "pCamY", Y);
                DOF2_SetFloat(File, "pCamZ", Z);
                DOF2_SetBool(File, "pCongelado", PlayerInfo[playerid][pCongelado]);
                DOF2_SetBool(File, "pCalado", PlayerInfo[playerid][pCalado]);
                // FIX AUDIT HAMBRE H0-2: clamp [0,100] al guardar pFome/pSede.
                // Antes: si FomePlayer=114 en memoria (comer con fomesede max 20 a 94),
                // se persistia pFome=114. El jugador tenia ~5.3h de buffer extra de
                // hambre. Ahora: clamp bidireccional antes de persistir. Variables
                // locales en scope de bloque para no contaminar el resto de la funcion.
                { new fomeClamp = FomePlayer[playerid]; if(fomeClamp < 0) fomeClamp = 0; if(fomeClamp > 100) fomeClamp = 100; new sedeClamp = SedePlayer[playerid]; if(sedeClamp < 0) sedeClamp = 0; if(sedeClamp > 100) sedeClamp = 100; DOF2_SetInt(File, "pFome", fomeClamp); DOF2_SetInt(File, "pSede", sedeClamp); }
                DOF2_SetInt(File, "pCoins", PlayerInfo[playerid][pCoins]);
                // FIX ALTO-VIP-004 (ALTO): persistir pVIP y ExpiraVIP en Contas/.ini.
                DOF2_SetInt(File, "pVIP", PlayerInfo[playerid][pVIP]);
                DOF2_SetInt(File, "ExpiraVIP", PlayerInfo[playerid][ExpiraVIP]);
                DOF2_SetInt(File, "pProfissao", PlayerInfo[playerid][pProfissao]);
                DOF2_SetInt(File, "pOrg", PlayerInfo[playerid][Org]);
                DOF2_SetInt(File, "pCargo", PlayerInfo[playerid][Cargo]);
                DOF2_SetInt(File, "pProcurado", GetPlayerWantedLevel(playerid));
                DOF2_SetInt(File, "pMultas", PlayerInfo[playerid][pMultas]);
                DOF2_SetInt(File, "pCasa", PlayerInfo[playerid][Casa]);
                DOF2_SetInt(File, "pLevel", GetPlayerScore(playerid));
                DOF2_SetInt(File, "pXP", PlayerInfo[playerid][pXP]);
                DOF2_SetInt(File, "LicencaConduzir", PlayerInfo[playerid][LicencaConduzir]);
                DOF2_SetString(File, "pNome", PlayerInfo[playerid][pNome]);
                DOF2_SetString(File, "pNascimento", PlayerInfo[playerid][pNascimento]);
                DOF2_SetString(File, "pPai", PlayerInfo[playerid][pPai]);
                DOF2_SetString(File, "pMae", PlayerInfo[playerid][pMae]);
                DOF2_SetInt(File, "pRG", PlayerInfo[playerid][pRG]);
                DOF2_SetInt(File, "pCarteiraT", PlayerInfo[playerid][pCarteiraT]);
                DOF2_SetInt(File, "Piezas", PlayerInfo[playerid][PiezasArma]);
                DOF2_SetFloat(File, "pVida", health);
                DOF2_SetFloat(File, "pColete", armour);
                DOF2_SetInt(File, "ImpuestoPendiente", PlayerInfo[playerid][ImpuestoPendiente]);
                DOF2_SetInt(File, "ImpuestoPayDaysSinPagar", PlayerInfo[playerid][ImpuestoPayDaysSinPagar]);
                DOF2_SetInt(File, "BancoBloqueado", PlayerInfo[playerid][BancoBloqueado]);
                DOF2_SetInt(File, "DeudaFiscalReportada", PlayerInfo[playerid][DeudaFiscalReportada]);
                DOF2_SetInt(File, "LicenciaPesca", PlayerInfo[playerid][LicenciaPesca]);
                DOF2_SetInt(File, "LicenciaArmas", PlayerInfo[playerid][LicenciaArmas]);
                // FIX AUDIT SPAWN S3-5: persistir campos medical, AFK y tools en SalvarDadosSkin.
                // Antes: SalvarDadosSkin (que se llama en SELECCIONAR skin y /mudarskin) solo
                // persistia los campos basicos. Los campos medical (KitsMedicos, Vendajes,
                // Enfermedad, Fractura, Quemadura, Vacunas, Pomada, etc), AFK (g_AFKStrikes,
                // g_AFKLastKickTs, g_CmdStrikes), y tools (GanzuaUsos, TaladroUsos,
                // LockPickUsos) se perdian si el servidor crasheaba entre SalvarDadosSkin
                // y el proximo SalvarDados (por ej. por /mudarskin en medio de un save cycle).
                // Ahora: persistir todos los campos extras tambien en SalvarDadosSkin.
                // Medical:
                DOF2_SetInt(File, "MatouPlayer", MatouPlayer[playerid]);
                DOF2_SetInt(File, "FoiSocorrido", FoiSocorrido[playerid]);
                DOF2_SetInt(File, "PlanoSaude", PlanoSaude[playerid]);
                DOF2_SetInt(File, "KitsMedicos", KitsMedicos[playerid]);
                DOF2_SetInt(File, "KitsMedicosGratuitos", KitsMedicosGratuitos[playerid]);
                DOF2_SetInt(File, "Vendajes", Vendajes[playerid]);
                DOF2_SetInt(File, "Enfermedad", Enfermedad[playerid]);
                DOF2_SetInt(File, "EnfermedadTick", EnfermedadTick[playerid]);
                DOF2_SetInt(File, "EnfermedadTiempo", EnfermedadTiempo[playerid]);
                DOF2_SetInt(File, "TieneReceta", TieneReceta[playerid]);
                DOF2_SetInt(File, "ItemAntigripal", ItemAntigripal[playerid]);
                DOF2_SetInt(File, "ItemAntibiotico", ItemAntibiotico[playerid]);
                DOF2_SetInt(File, "ItemSuero", ItemSuero[playerid]);
                DOF2_SetInt(File, "Fractura", Fractura[playerid]);
                DOF2_SetInt(File, "FracturaTick", FracturaTick[playerid]);
                DOF2_SetInt(File, "Quemadura", Quemadura[playerid]);
                DOF2_SetInt(File, "QuemaduraTick", QuemaduraTick[playerid]);
                DOF2_SetInt(File, "ItemPomada", ItemPomada[playerid]);
                DOF2_SetInt(File, "VacunaAntigripal", VacunaAntigripal[playerid]);
                DOF2_SetInt(File, "VacunaAntitetanica", VacunaAntitetanica[playerid]);
                DOF2_SetInt(File, "VacunaAntirrabica", VacunaAntirrabica[playerid]);
                DOF2_SetInt(File, "VacunaHepatitis", VacunaHepatitis[playerid]);
                DOF2_SetInt(File, "SegundosOrg10", SegundosOrg10[playerid]);
                DOF2_SetInt(File, "SegundosOrg1", SegundosOrg1[playerid]);
                DOF2_SetInt(File, "MinutosMorte", MinutosMorte[playerid]);
                DOF2_SetInt(File, "SegundosMorte", SegundosMorte[playerid]);
                // AFK:
                DOF2_SetInt(File, "AFKStrikes", g_AFKStrikes[playerid]);
                DOF2_SetInt(File, "AFKLastKickTs", g_AFKLastKickTs[playerid]);
                DOF2_SetInt(File, "AFKBanUntilTs", g_AFKBanUntilTs[playerid]);
                DOF2_SetInt(File, "CmdStrikes", g_CmdStrikes[playerid]);
                // FIX AUDIT FLOOD-H1: persistir g_CmdLastTick (segundo sitio).
                DOF2_SetInt(File, "CmdLastTick", g_CmdLastTick[playerid]);
                // FIX AUDIT AC-H5: persistir g_AC_Strikes (segundo sitio SalvarDadosSkin).
                DOF2_SetInt(File, "AC_Strikes", g_AC_Strikes[playerid]);
                // Tools:
                DOF2_SetInt(File, "GanzuaUsos", GetPVarInt(playerid, "GanzuaUsos"));
                DOF2_SetInt(File, "TaladroUsos", GetPVarInt(playerid, "TaladroUsos"));
                DOF2_SetInt(File, "LockPickUsos", GetPVarInt(playerid, "LockPickUsos"));
                DOF2_SetInt(File, "T2_1_PuntosLicencia", GetPVarInt(playerid, "T2_1_PuntosLicencia"));
                DOF2_SaveFile();
        }
        return 1;
}

stock SalvarEvaluacion(playerid)
{
        // FIX AUDIT4 PERS-HIGH-03: validar conexion antes de persistir.
        if(!IsPlayerConnected(playerid)) return 1;
        // FIX AUDIT4 PERS-CRIT-03: antes solo persistia si pAdmin >= 1. Si un admin
        // era demovido a 0, SalvarEvaluacion skip -> archivo en disco conservaba
        // AdminLevel=5 -> al reconectar recuperaba admin sin autorizacion (bypass
        // democion). Fix: persistir SIEMPRE. Si pAdmin==0, eliminar archivo para
        // que CarregarEvaluacion no cargue nivel stale.
        new File[64];
        format(File, sizeof(File), PASTA_AVALIACAO, Name(playerid));
        if(PlayerInfo[playerid][pAdmin] >= 1)
        {
                if(!DOF2_FileExists(File)) DOF2_CreateFile(File);
                DOF2_SetInt(File, "Evaluacion", PlayerInfo[playerid][pEvaluacion]);
                DOF2_SetInt(File, "AdminLevel", PlayerInfo[playerid][pAdmin]);
                DOF2_SaveFile();
        }
        else
        {
                // Admin demovido a 0: eliminar archivo para evitar reload stale
                if(DOF2_FileExists(File)) DOF2_RemoveFile(File);
        }
        return 1;
}

stock CarregarEvaluacion(playerid)
{
        new File[50];
        format(File, sizeof(File), PASTA_AVALIACAO, Name(playerid));
        // FIX AUDIT4 PERS-MED-07: if sin llaves causaba que las 2 lineas siguientes
        // siempre ejecutaran (incluso si el archivo no existe). DOF2_GetInt en archivo
        // inexistente retorna 0 -> pAdmin=0 silenciosamente. Fix: aÃ¯Â¿Â½adir llaves.
        if(DOF2_FileExists(File))
        {
                PlayerInfo[playerid][pEvaluacion] = DOF2_GetInt(File, "Evaluacion");
                PlayerInfo[playerid][pAdmin] = DOF2_GetInt(File, "AdminLevel");
        }
        return 1;
}

stock GetPlayerIpEx(playerid)
{
        new pIP[36];
        GetPlayerIp(playerid, pIP, 36);
        return pIP;
}

stock Log(Account[], string[])
{
        if(!DOF2_FileExists(Account))
        {
                DOF2_CreateFile(Account);
        }
        new dia, mes, ano, hora, minuto, segundo, Data[24];
        gettime(hora, minuto, segundo);
        getdate(ano, mes, dia);
        format(Data, 24, "%02d/%02d/%d - %02d:%02d:%02d", dia, mes, ano, hora, minuto, segundo);
        DOF2_SetString(Account, Data, string);
        DOF2_SaveFile();
}

stock DeletarLog(const File1[])
{
        if(!fexist(File1))
        {
                printf(" Este archivo no existe, usa Log(\"Account\"");
                return 0;
        }
        fremove(File1);
        return 1;
}

stock SendAdminMessage(Cor, Mensagem[])
{
        foreach(new i: Player)
        {
                if(PlayerInfo[i][pAdmin] > 0)
                {
                        SendClientMessage(i, Cor, Mensagem);
                }
        }
        return 1;
}

// =====================================================================
// SISTEMA ADMINISTRATIVO DE INVESTIGACION DE MUERTES Y COMBATE
//
// Proposito: cada vez que un jugador dispara un arma de fuego, se envia
// una alerta a todos los administradores conectados con:
//   - ID y nombre del tirador
//   - Arma utilizada
//   - Zona geografica y coordenadas donde se efectuo el disparo
//   - IDF (database ID) para usar con /spec
//
// Adicionalmente, se coloca un checkpoint rojo en el mapa de cada admin
// que este en servicio staff (pJogando == false), no este espectando
// (IsAssistindo == false) y no este en vehiculo. El checkpoint marca
// el lugar exacto del disparo para que el admin pueda /ir o /spec.
//
// En OnPlayerDeath, si hubo asesino, se envia una alerta separada con
// el formato "ID x disparo a ID y" + arma + zona + checkpoint en el
// lugar del crimen.
//
// Anti-spam: cooldown de 15 segundos por tirador (PVar "pLastShotAlert").
// Inmunidad: admins nivel 3+ no disparan alertas (pueden testear armas).
// Visibilidad: SOLO admins (PlayerInfo[i][pAdmin] >= 1) ven los mensajes.
// =====================================================================
stock AlertaDisparoAdmins(shooterid, weaponid, Float:sx, Float:sy, Float:sz)
{
        // Validaciones basicas
        if(!IsPlayerConnected(shooterid)) return 0;
        if(!pLogado[shooterid]) return 0;
        // Inmunidad: admins nivel 3+ pueden testear armas sin disparar alertas
        if(PlayerInfo[shooterid][pAdmin] >= 3) return 0;

        // Cooldown per-shooter: 15 segundos (anti-spam en fuego automatico)
        new now = gettime();
        new last = GetPVarInt(shooterid, "pLastShotAlert");
        if(now - last < 15) return 0;
        SetPVarInt(shooterid, "pLastShotAlert", now);

        new sname[MAX_PLAYER_NAME], wname[32], zona[MAX_ZONE_NAME];
        GetPlayerName(shooterid, sname, sizeof(sname));
        GetWeaponName(weaponid, wname, sizeof(wname));
        if(strlen(wname) == 0) format(wname, sizeof(wname), "Arma %d", weaponid);
        GetPlayer2DZone2(shooterid, zona, sizeof(zona));
        if(strlen(zona) == 0) zona = "Zona desconocida";

        new msg[200];
        format(msg, sizeof(msg), "[ALERTA DISPARO] ID %d (%s) disparo [%s] en %s (X:%.0f Y:%.0f Z:%.0f) | /spec %d",
                shooterid, sname, wname, zona, sx, sy, sz, PlayerInfo[shooterid][IDF]);

        foreach(new i : Player)
        {
                if(!IsPlayerConnected(i)) continue;
                if(PlayerInfo[i][pAdmin] < 1) continue;
                SendClientMessage(i, 0xFF6600FF, msg);

                // Checkpoint solo para admins en servicio staff que no esten
                // espectando ni en vehiculo (evita romper checkpoints de gameplay)
                if(pJogando[i] == false && IsAssistindo[i] == false && !IsPlayerInAnyVehicle(i))
                {
                        SetPlayerCheckpoint(i, sx, sy, sz, 4.0);
                }
        }
        return 1;
}

// Alerta de kill: se llama desde OnPlayerDeath cuando killerid != INVALID_PLAYER_ID.
// Formato: "ID x disparo a ID y" + arma + zona + checkpoint en el lugar del crimen.
stock AlertaKillAdmins(killerid, victimid, reason)
{
        if(!IsPlayerConnected(killerid) || !IsPlayerConnected(victimid)) return 0;
        if(killerid == victimid) return 0; // suicidio: no alertar
        // Inmunidad: si el asesino es admin nivel 3+, no alertar
        if(PlayerInfo[killerid][pAdmin] >= 3) return 0;

        new kname[MAX_PLAYER_NAME], vname[MAX_PLAYER_NAME], wname[32], zona[MAX_ZONE_NAME];
        GetPlayerName(killerid, kname, sizeof(kname));
        GetPlayerName(victimid, vname, sizeof(vname));
        GetWeaponName(reason, wname, sizeof(wname));
        if(strlen(wname) == 0) format(wname, sizeof(wname), "Causa %d", reason);
        GetPlayer2DZone2(victimid, zona, sizeof(zona));
        if(strlen(zona) == 0) zona = "Zona desconocida";

        new Float:vx, Float:vy, Float:vz;
        GetPlayerPos(victimid, vx, vy, vz);

        new msg[220];
        format(msg, sizeof(msg), "[KILL ALERT] ID %d (%s) disparo a ID %d (%s) con [%s] en %s (X:%.0f Y:%.0f) | /spec %d",
                killerid, kname, victimid, vname, wname, zona, vx, vy, PlayerInfo[killerid][IDF]);

        foreach(new i : Player)
        {
                if(!IsPlayerConnected(i)) continue;
                if(PlayerInfo[i][pAdmin] < 1) continue;
                SendClientMessage(i, 0xFF0000FF, msg);

                // Checkpoint en el lugar del crimen (sobreescribe el de disparo)
                if(pJogando[i] == false && IsAssistindo[i] == false && !IsPlayerInAnyVehicle(i))
                {
                        SetPlayerCheckpoint(i, vx, vy, vz, 5.0);
                }
        }
        return 1;
}

stock SendRadioMessage(Cor, Mensagem[])
{
        foreach(new i: Player)
        {
                // P1-MED-4: paramedicos en servicio tambien reciben /d
                if(IsPolicial(i) || (PlayerInfo[i][Org] == 10 && paramedico[i]))
                {
                        SendClientMessage(i, Cor, Mensagem);
                }
        }
        return 1;
}

// =====================================================================
// P1-1: Radios separadas por organizacion + radio departamental.
//
// SendOrgPolicialMessage: envia un mensaje SOLO a miembros de una
// organizacion policial especifica que esten en servicio (Patrulha==true).
// Se usa para el comando /r (radio interna de cada org).
//
// GetOrgPolicialColor: devuelve el color identificador de cada org policial
// para uso en radios. Permite distincion visual rapida en el chat.
//
// GetOrgPolicialTag: devuelve un tag corto (3-5 letras) para prefijar
// mensajes departamentales (/d) y saber que org los envia sin ocupar
// demasiado espacio en pantalla.
// =====================================================================
stock SendOrgPolicialMessage(color, const message[], orgid)
{
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && pLogado[i])
                {
                        if(PlayerInfo[i][Org] == orgid && Patrulha[i] == true)
                        {
                                SendClientMessage(i, color, message);
                        }
                }
        }
        return 1;
}

stock GetOrgPolicialColor(orgid)
{
        switch(orgid)
        {
                case 1:  return 0x0066FFFF; // Policia Nacional - azul brillante
                case 2:  return 0xFF8C00FF; // Transito - naranja
                case 3:  return 0x1E3A8AFF; // FBI - azul oscuro
                case 4:  return 0x556B2FFF; // SWAT - verde militar oscuro
                case 14: return 0x6B8E23FF; // Ejercito - verde oliva
        }
        return 0xDDA0DDFF; // fallback: violeta claro (color anterior)
}

stock GetOrgPolicialTag(orgid, tag[], len)
{
        switch(orgid)
        {
                case 1:  format(tag, len, "PN");
                case 2:  format(tag, len, "TR");
                case 3:  format(tag, len, "FBI");
                case 4:  format(tag, len, "SWAT");
                case 14: format(tag, len, "EJ");
                default: format(tag, len, "ORG");
        }
        return 1;
}

// Radio exclusiva por banda: solo los miembros de la MISMA org reciben el mensaje
stock SendGangMessage(Cor, Mensagem[], orgid)
{
        foreach(new i: Player)
        {
                if(PlayerInfo[i][Org] == orgid)
                {
                        SendClientMessage(i, Cor, Mensagem);
                }
        }
        return 1;
}

stock SetPlayerMoney(ID1, Quantia)
{
        // FIX VERIFY-MONEYAC-3/4 NEW-H10: antes este stock solo seteaba pDinheiro y
        // llamaba ResetPlayerMoney, pero NO sincronizaba el cliente con GivePlayerMoney.
        // Esto causaba que el display del cliente parpadease a $0 durante ~1s hasta
        // que TimerHack re-sync. Ahora usamos AC_SetPlayerMoney que sincroniza correctamente.
        // Mantenemos la firma para compatibilidad con callers existentes.
        AC_SetPlayerMoney(ID1, Quantia);
        return 1;
}

// =====================================================================
// SISTEMA ANTI-CHEAT DE DINERO (VERIFY-MONEYAC)
//
// Wrappers autoritarios para TODA operacion de dinero nativa. Estos
// wrappers garantizan que el estado server-side (PlayerInfo[x][pDinheiro])
// sea la UNICA fuente de verdad. El dinero client-side (GetPlayerMoney) se
// sincroniza desde el servidor y nunca se lee como autoritativo.
//
// Patron de uso CORRECTO en la GM:
//   - Sumar dinero:  AC_AddPlayerMoney(playerid, +100);
//   - Restar dinero: AC_AddPlayerMoney(playerid, -100);
//   - Setear dinero: AC_SetPlayerMoney(playerid, 5000);
//   - Re-sync:       AC_GivePlayerMoney(playerid, PlayerInfo[playerid][pDinheiro]);
//   - Reset a 0:     AC_ResetPlayerMoney(playerid);
//
// En OnPlayerUpdate, si delta > $10k (strike) o > $100k (kick), se detecta
// money hack. Se usa grace window de 2s via PVar "AC_MoneyChangeTime" para
// no falsear transacciones legitimas grandes (PayDay, compras, /dardinero).
//
// Anti-spam: PVar "AC_LastMoneyAlert" con cooldown 30s para no spamear
// AC_Alert en fuego automatico.
// =====================================================================

// Re-sync el cliente con el valor server-side. NO cambia pDinheiro.
// USO: despues de cualquier modificacion a pDinheiro, llamar esto para
// actualizar el display del cliente. El parametro amount debe ser siempre
// PlayerInfo[playerid][pDinheiro] (servidor autoritativo).
//
// FIX VERIFY-MONEYAC-FIX-3/5: este wrapper SIEMPRE hace ResetPlayerMoney
// antes de GivePlayerMoney. Esto es CRITICO porque GivePlayerMoney es
// ADITIVO (suma al saldo client-side), no absoluto. Sin Reset, el saldo
// client-side se duplicaria temporalmente, causando falsos positivos en
// OnPlayerUpdate (diff > $10k = strike, diff > $100k = kick).
// Los 22+ sitios existentes que usan `pDinheiro += N; GivePlayerMoney(x, pDinheiro)`
// SIN Reset previo son seguros ahora porque todos pasan por este wrapper
// cuando migran, y los que no migran son cubiertos por el grace window
// automatico del TimerHack (1s re-sync).
stock AC_GivePlayerMoney(playerid, amount)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        // Defensa en profundidad: si el caller paso un amount != pDinheiro,
        // podria ser un bug (alguien llama GivePlayerMoney(x, 100) sin setear
        // pDinheiro). Forzamos el valor server-side.
        if(amount != PlayerInfo[playerid][pDinheiro])
        {
                printf("[AC_MONEY] WARN: AC_GivePlayerMoney(%d, %d) llamado con amount != pDinheiro (%d). Forzando sync con pDinheiro.",
                        playerid, amount, PlayerInfo[playerid][pDinheiro]);
                amount = PlayerInfo[playerid][pDinheiro];
        }
        // Clamp anti-overflow: pDinheiro no puede ser negativo ni > 999,999,999
        if(amount < 0)
        {
                printf("[AC_MONEY] WARN: pDinheiro negativo (%d) para player %d. Clamp a 0.", amount, playerid);
                PlayerInfo[playerid][pDinheiro] = 0;
                amount = 0;
        }
        if(amount > 999999999)
        {
                printf("[AC_MONEY] WARN: pDinheiro > 999,999,999 (%d) para player %d. Clamp a max.", amount, playerid);
                PlayerInfo[playerid][pDinheiro] = 999999999;
                amount = 999999999;
        }
        // CRITICAL: ResetPlayerMoney antes de GivePlayerMoney para evitar
        // duplicacion temporal del saldo client-side.
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, amount);
        return 1;
}

// Sumar/restar dinero al jugador. Actualiza pDinheiro Y sincroniza cliente.
// USO: AC_AddPlayerMoney(playerid, +100) o AC_AddPlayerMoney(playerid, -50).
// Setea PVar "AC_MoneyChangeTime" para grace window en OnPlayerUpdate.
stock AC_AddPlayerMoney(playerid, delta)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        new newVal = PlayerInfo[playerid][pDinheiro] + delta;
        // Clamp anti-overflow
        if(newVal < 0)
        {
                printf("[AC_MONEY] WARN: AC_AddPlayerMoney(%d, %d) resultaria en pDinheiro=%d. Clamp a 0.",
                        playerid, delta, newVal);
                newVal = 0;
        }
        if(newVal > 999999999)
        {
                printf("[AC_MONEY] WARN: AC_AddPlayerMoney(%d, %d) resultaria en pDinheiro=%d. Clamp a max.",
                        playerid, delta, newVal);
                newVal = 999999999;
        }
        PlayerInfo[playerid][pDinheiro] = newVal;
        // Grace window de 2s: OnPlayerUpdate no disparara alertas en esta ventana
        SetPVarInt(playerid, "AC_MoneyChangeTime", gettime());
        // Sincronizar cliente
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, PlayerInfo[playerid][pDinheiro]);
        return 1;
}

// Setear dinero a un valor exacto. Actualiza pDinheiro Y sincroniza.
// USO: AC_SetPlayerMoney(playerid, 5000) para setear dinero a $5000.
stock AC_SetPlayerMoney(playerid, amount)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        // Clamp anti-overflow
        if(amount < 0)
        {
                printf("[AC_MONEY] WARN: AC_SetPlayerMoney(%d, %d) - amount negativo. Clamp a 0.", playerid, amount);
                amount = 0;
        }
        if(amount > 999999999)
        {
                printf("[AC_MONEY] WARN: AC_SetPlayerMoney(%d, %d) - amount > 999M. Clamp a max.", playerid, amount);
                amount = 999999999;
        }
        PlayerInfo[playerid][pDinheiro] = amount;
        // Grace window de 2s
        SetPVarInt(playerid, "AC_MoneyChangeTime", gettime());
        // Sincronizar cliente
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, PlayerInfo[playerid][pDinheiro]);
        return 1;
}

// Reset a 0. USO: AC_ResetPlayerMoney(playerid) para poner dinero a 0.
// NO usar para re-sync (usar AC_GivePlayerMoney para eso).
stock AC_ResetPlayerMoney(playerid)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        PlayerInfo[playerid][pDinheiro] = 0;
        SetPVarInt(playerid, "AC_MoneyChangeTime", gettime());
        ResetPlayerMoney(playerid);
        return 1;
}

stock GetVehicleDriver(vehicleid)
{
  foreach(new i: Player)
  {
        if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2) return i;
  }
  return -1;
}

stock GetVehiclePassenger(vehicleid)
{
  foreach(new i: Player)
  {
        if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 3) return i;
  }
  return -1;
}

// =====================================================================
// CAMBIO 2026-07-12 - Fase 3: Paramedico Elegido para Helicoptero
// Devuelve el ID del paramedico (Org 10) con mayor rango (Cargo).
// Si hay empate en rango, devuelve el con mas horas en Org 10 (SegundosOrg10).
// Si no hay paramedicos online, devuelve -1.
// =====================================================================
// =====================================================================
// P1-MED: HayParamedicoRangoMinOnline(minRango)
// Devuelve true si hay al menos 1 paramedico (Org 10) conectado con
// Cargo >= minRango. Se usa para el fallback de /triage y /yeso:
// si no hay ningun paramedico de rango 2+ conectado, se permite que
// cualquier paramedico (rango 1 incluido) use esos comandos.
// =====================================================================
stock bool:HayParamedicoRangoMinOnline(minRango)
{
    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][Org] == 10 && PlayerInfo[i][Cargo] >= minRango)
                return true;
    }
    return false;
}

// =====================================================================
// P0-REP-FIX3: GetEstacionamientoLibreReporteros()
// Devuelve el indice (0-3) del primer estacionamiento libre de Reporteros.
// Si todos estan ocupados, devuelve -1.
// Las 4 coordenadas oficiales (pasadas por el usuario):
//   0: 645.125366, -1375.514892, 13.675843
//   1: 645.132263, -1365.841918, 13.616061
//   2: 645.141479, -1353.370849, 13.546875
//   3: 645.148864, -1342.926513, 13.546875
// Verifica si hay algun vehiculo cerca (radio 3m) de cada posicion.
// =====================================================================
stock GetEstacLibreRep()
{
        new Float:estacionamientos[4][4] = {
                {645.125366, -1375.514892, 13.675843, 359.955780},
                {645.132263, -1365.841918, 13.616061, 359.955780},
                {645.141479, -1353.370849, 13.546875, 359.955780},
                {645.148864, -1342.926513, 13.546875, 359.955780}
        };
        new Float:checkX, Float:checkY, Float:checkZ;
        for(new i = 0; i < 4; i++)
        {
                checkX = estacionamientos[i][0];
                checkY = estacionamientos[i][1];
                checkZ = estacionamientos[i][2];
                // Verificar si hay algun vehiculo cerca (radio 3m)
                new bool:ocupado = false;
                foreach(new j : Player)
                {
                        if(pLogado[j] && VeiculoCivil[j] != INVALID_VEHICLE_ID && IsValidVehicle(VeiculoCivil[j]))
                        {
                                new Float:vx, Float:vy, Float:vz;
                                GetVehiclePos(VeiculoCivil[j], vx, vy, vz);
                                // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
                                if(floatsqroot((checkX - vx)*(checkX - vx) + (checkY - vy)*(checkY - vy) + (checkZ - vz)*(checkZ - vz)) < 3.0)
                                {
                                        ocupado = true;
                                        break;
                                }
                        }
                }
                if(!ocupado)
                        return i;
        }
        return -1; // todos ocupados
}

stock GetParamedicoElegido()
{
    new bestId = -1;
    new bestRank = -1;
    new bestTime = -1;

    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][Org] == 10)
        {
            if(PlayerInfo[i][Cargo] > bestRank)
            {
                bestRank = PlayerInfo[i][Cargo];
                bestTime = SegundosOrg10[i];
                bestId = i;
            }
            else if(PlayerInfo[i][Cargo] == bestRank)
            {
                if(SegundosOrg10[i] > bestTime)
                {
                    bestTime = SegundosOrg10[i];
                    bestId = i;
                }
            }
        }
    }
    return bestId;
}

// =====================================================================
// P1-PN-Vehiculos: GetPoliciaElegido (Policia Nacional).
// Devuelve el ID del policia (Org 1) con mayor rango (Cargo).
// Si hay empate en rango, devuelve el con mas horas en Org 1 (SegundosOrg1).
// Si no hay policias PN online, devuelve -1.
// Se usa para controlar el acceso al helicoptero PN (solo el elegido puede usarlo).
// =====================================================================
stock GetPoliciaElegido()
{
    new bestId = -1;
    new bestRank = -1;
    new bestTime = -1;

    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][Org] == 1)
        {
            if(PlayerInfo[i][Cargo] > bestRank)
            {
                bestRank = PlayerInfo[i][Cargo];
                bestTime = SegundosOrg1[i];
                bestId = i;
            }
            else if(PlayerInfo[i][Cargo] == bestRank)
            {
                if(SegundosOrg1[i] > bestTime)
                {
                    bestTime = SegundosOrg1[i];
                    bestId = i;
                }
            }
        }
    }
    return bestId;
}

stock Name(playerid)
{
        new pNameVar[MAX_PLAYER_NAME];
        GetPlayerName(playerid, pNameVar, 24);
        return pNameVar;
}
stock VelocidadDoVeiculo(vehicleid)
{
        new Float:xPos[3];
        GetVehicleVelocity(vehicleid, xPos[0], xPos[1], xPos[2]);
        return floatround(floatsqroot(xPos[0] * xPos[0] + xPos[1] * xPos[1] + xPos[2] * xPos[2]) * 170.00);
}

// FIX AUDIT WANTED: wrapper que sincroniza pProcurado + SetPlayerWantedLevel nativo
// Valida rango [0,6] con clamp. Usar SIEMPRE en vez de SetPlayerWantedLevel directo.
stock SetPlayerWantedLevelSync(playerid, level)
{
        if(!IsPlayerConnected(playerid)) return 0;
        if(level < 0) level = 0;
        if(level > 6) level = 6;
        PlayerInfo[playerid][pProcurado] = level;
        SetPlayerWantedLevel(playerid, level);
        return 1;
}

stock MaconhaPronta(playerid)
{
        new pronta = 0;
        for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid ++)
        {
                if(MaconhaInfo[maconhaid][PodeUsar] == false && MaconhaInfo[maconhaid][Crescida] >= Max_Crescida)
                {
                        if(strcmp(MaconhaInfo[maconhaid][Dono], Name(playerid), true) == 0)
                        {
                                pronta++;
                        }
                }
        }
        if(pronta > 0){
                new string[128];
                if(pronta == 1)format(string, sizeof string, "%d de tus plantaciones pueden cosecharse, usa /cmaconha",pronta);
                else format(string, sizeof string, "Puedes cosechar %d plantaciones, usa /maconhas",pronta);
                return InfoMsg(playerid, string);
        }
        return true;
}

stock CheckSlot()
{
        for(new slot = 0; slot < MAX_MACONHA; slot++)
        {
                if(MaconhaInfo[slot][PodeUsar] == true)
                {
                        MaconhaInfo[slot][PodeUsar] = false;
                        return slot;
                }
        }
        return -1;
}

stock CountPlantacao(playerid)
{
        new count = 0;

        for(new maconhaid=0;maconhaid < MAX_MACONHA;maconhaid++)
        {
                if(MaconhaInfo[maconhaid][PodeUsar] == false && strcmp(MaconhaInfo[maconhaid][Dono], Name(playerid), true)==0)
                {
                        count++;
                }
        }

        return count;
}
stock PertoMaconha(playerid)
{
        new count = 0;

        for(new mac = 0; mac < MAX_MACONHA; mac++)
        {
                if(!MaconhaInfo[mac][PodeUsar] && IsPlayerInRangeOfPoint(playerid, 200.0, MaconhaInfo[mac][mX],MaconhaInfo[mac][mY],MaconhaInfo[mac][mZ]))
                {
                        count++;
                }
        }

        return count;
}

stock GetXYInFrontOfCaja(objectid, &Float:q, &Float:w, Float:distance)
{
        new Float:a, Float:rotx, Float:roty;
        GetDynamicObjectPos(objectid, q, w, a);

        GetDynamicObjectRot(objectid, rotx, roty, a);

        q -= (distance * floatsin(-a, degrees));
        w -= (distance * floatcos(-a, degrees));
        return 1;
}
#include "../modulos/mapa/mapserver.inc"

public OnGameModeInit()
{
        // [FRP-MARKER] (Task PAWN-INVESTIGATE-2): print unico al inicio de OnGameModeInit
        // para que el usuario pueda verificar si el .amx cargado es el ultimo compilado.
        // Si NO aparece esta linea en server_log.txt al arrancar el server, entonces
        // samp-server.exe esta cargando un .amx antiguo (revisar directorio gamemodes/).
        // NOTA: Pawn 3.2.3664 NO soporta __DATE__/__TIME__ (macros de C, no de Pawn).
        // En su lugar, el string VERSION_AMX es hardcoded por el asistente al generar
        // el archivo. Compara el timestamp del log del server con este string.
        #define FRP_AMX_VERSION "2026-09-23 10:00:00 Detroit (BANDAVEH + auditvehorg + menu admin actualizado)"
        printf("[FRP-MARKER] OnGameModeInit ejecutado. .amx version: %s", FRP_AMX_VERSION);
        // P0-BEN-CAPO/REPARAR: inicializar timers y estado de capo/reparacion
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
                g_BenCapoTimer[i] = -1;
                g_BenCapoVeh[i] = -1;
                g_BenRepararTimer[i] = -1;
                g_BenRepararVeh[i] = -1;
                g_TowLightObj[i] = -1;
                // P0-MED-CHALECO: inicializar estado de chaleco
                g_ChalecoPermitido[i] = false;
                g_ChalecoActivo[i] = false;
                // P0-BEN-BALIZA: inicializar baliza, caja y timer de parpadeo
                g_TowBarObj[i] = -1;
                g_TowCajaObj[i] = -1;
                g_TowCaja2Obj[i] = -1;
                g_TowPieza1Obj[i] = -1;
                g_TowPieza2Obj[i] = -1;
                g_TowCaja1558Obj[i] = -1;
                g_TowCoronaObj[i] = -1;
                g_TowVehID[i] = INVALID_VEHICLE_ID;
                g_TowFlashTimer[i] = -1;
                g_TowFlashState[i] = false;
                // P0-BEN-GRUA: inicializar llamadas de grua
                g_GruaCalls[i][gc_active] = false;
                g_GruaCalls[i][gc_callerID] = INVALID_PLAYER_ID;
                g_GruaCalls[i][gc_vehID] = INVALID_VEHICLE_ID;
                g_GruaCalls[i][gc_callTimer] = -1;
                g_GruaCalls[i][gc_unfreezeTimer] = -1;
                g_GruaCalls[i][gc_acceptedByMech] = -1;
        }
        // P0-BEN-GRUA: inicializar estado de vehiculos
        for(new v = 0; v < MAX_VEHICLES; v++)
        {
                g_VehGruaLlamada[v] = false;
                g_VehGruaTowed[v] = false;
                g_VehGruaOwnerIDF[v] = -1;
                g_VehGruaMecanicoIDF[v] = -1;
                g_VehGruaDeuda[v] = 0;
                g_VehGruaPrecioOriginal[v] = 0;
        }
        // FIX VEH-TIMER-MONITOR: inicializar timers de monitoreo de vehiculos en llamas.
        // g_VehBurnTimer = -1 (inactivo), g_VehBurning = false.
        for(new i = 0; i < MAX_DVEHICLES; i++)
        {
                g_VehBurnTimer[i] = -1;
                g_VehBurning[i] = false;
        }
        // Crear carpeta de logs si no existe
        new File:fTest = fopen("logs/.keep", io_write);
        if(fTest) fclose(fTest);
        // FIX AUDIT INV I2-3 (complemento): crear carpeta Inventarios/backup/ en arranque.
        // Sin esto, el backup .bak de SalvarInventario (FIX I2-3 L11224) falla silenciosamente
        // en el primer arranque tras aplicar el fix (la carpeta no existe). DOF2_CopyFile
        // no crea carpetas. Patron replicado de la carpeta logs/ (linea anterior).
        new File:fInvBackup = fopen("Inventarios/backup/.keep", io_write);
        if(fInvBackup) fclose(fInvBackup);
        // CRIT-6 (AUD3-CRIT-001): crear carpetas de backup faltantes en arranque.
        // Las carpetas Conce/Veiculos/backup/, Conce/Postos/backup/ e
        // InfoOrg/backup/ NUNCA se creaban. Esto hacia que los backups .bak de
        // los archivos de concesionaria/organizacion fallaran silenciosamente
        // (DOF2_CopyFile no crea carpetas). Patron replicado de Inventarios/backup/.
        new File:fbk1 = fopen("Conce/Veiculos/backup/.keep", io_write);
        if(fbk1) fclose(fbk1);
        new File:fbk2 = fopen("Conce/Postos/backup/.keep", io_write);
        if(fbk2) fclose(fbk2);
        new File:fbk3 = fopen("InfoOrg/backup/.keep", io_write);
        if(fbk3) fclose(fbk3);
        // FIX AUDIT AFK B1: rotacion de Logs/AfkReincidencia.log en arranque.
        // Antes: el log se abria con io_append en cada kick AFK y cada intento de
        // reconexion con ban activo. Un atacante podia llenar el disco spawneando
        // strikes (forzando kicks). Ahora: en OnGameModeInit, si el log existe y
        // supera AFK_LOG_MAX_SIZE_BYTES (1 MB, definido en L1186), se renombra a
        // .old y se crea uno nuevo. Patron simple de rotacion (1 generacion .old).
        if(DOF2_FileExists("Logs/AfkReincidencia.log"))
        {
                // FIX AUDIT AFK B1: rotacion de log compatible con Pawn.
                // Antes: usaba fseek(SEEK_END) + ftell() que NO existen en Pawn 3.2.3664.
                // Ahora: metodo simple - leer primeros 4 bytes del archivo. Si el archivo
                // es muy grande, DOF2_CopyFile lo copia completo a .old y truncamos.
                // Para evitar leer archivos enormes, usamos un buffer de 1 byte y
                // comprobamos si fopen en modo lectura tiene exito (el archivo existe).
                // La rotacion se hace en cada OnGameModeInit (1 vez por arranque).
                // Patron simple: siempre rotar al arrancar (copia a .old + trunca).
                DOF2_CopyFile("Logs/AfkReincidencia.log", "Logs/AfkReincidencia.log.old");
                new File:trunc = fopen("Logs/AfkReincidencia.log", io_write);
                if(trunc) fclose(trunc);
                printf("[AFK-B1] Log AfkReincidencia.log rotado en arranque. Backup en .old.");
        }
        // FIX AUDIT AFK H10: crear carpeta Logs/ para AntiAFKAdmin.log (si no existe).
        // Ya creada por logs/.keep arriba, pero por defense-in-depth.
        SetGameModeText(VERSAOSERVER);
    SendRconCommand("language Espacol - Esp");
        SendRconCommand("ackslimit 5000");
        SendRconCommand(SERVERFORUM);
        SendRconCommand("rcon 0");
        SendRconCommand("stream_distance 500.0");
        SendRconCommand("stream_rate 1000");
        print("=======================================================================");
        print("= Carregando: "SERVER_NAME" Roleplay v1.0");
        print("=======================================================================");
        printf(" ");
        AntiDeAMX();
        DisableCrashDetectLongCall();
        ORGCarrega();
        LoadVehicles();
        LoadDealerships();
        LoadFuelStations();
        CarregarMapas();
        CarregarHospitalTonyConters(); // CAMBIO 2026-07-09: mapping hospital pequeÃ¯Â¿Â½o de TONY CONTERAS
        CarregarTechoHospital(); // CAMBIO 2026-07-12: objetos del techo del hospital (puerta + helipuerto)
        CarregarFarmaciaSF(); // CAMBIO 2026-07-13: mapping Farmacia San Fierro
        CriarCasas();
        CriarRadares();
        CarregarGZ2();
        CarregarPlantacao();
        CarregarDinRoubos();
        // FIX AUDIT4 PERS-HIGH-02: asignar a variable global para poder KillTimer en OnGameModeExit
        timerChamadaUmSegundo = SetTimer("ChamadaUmSegundo", 1000, true);
        // FIX ALTO-VIP-001 (ALTO): timer periodico de expiracion VIP cada 60s.
        // ANTES: la expiracion VIP solo se checkeaba en OnPlayerSpawn y CarregarVIP (login).
        // Si el VIP expiraba mid-sesion, el jugador mantenia pVIP y todos los beneficios hasta
        // el proximo spawn (puede ser horas). AHORA: timer cada 60s recorre jugadores y valida.
        SetTimer("VIPExpiryCheck", VIP_CHECK_INTERVAL_MS, true);
        
        // =====================================================================
        
        // CLINICA SOTORP - DESHABILITADA (se mantiene comentada para futuro)
        
        // =====================================================================
        
        // PickUniformeMEDICO[0] = CreateDynamicPickup(1275, 23, 1217.0269,-1745.9863,13.5955);
        
