// FUEL-ARCHITECTURE: obtiene el precio por litro de una estacion.
// Si la estacion tiene precio configurado (>0), lo usa.
// Si no, usa el precio default (PRECO_GASOLINA o PRECO_DIESEL).
// tipoComb: 0=gasolina, 1=diesel
// NOTA: esta stock debe ir DESPUES de la declaracion de FuelStationCreated,
// FuelStationPrecioGasolina y FuelStationPrecioDiesel (Pawn requiere variables
// declaradas antes de usarse en una stock).
stock GetFuelStationPrecio(stationid, tipoComb)
{
    // Validar estacion existente; si no existe, retornar default
    if(stationid < 1 || stationid >= MAX_FUEL_STATIONS || !FuelStationCreated[stationid])
        return (tipoComb == 1) ? PRECO_DIESEL : PRECO_GASOLINA;
    if(tipoComb == 1)
    {
        if(FuelStationPrecioDiesel[stationid] > 0) return FuelStationPrecioDiesel[stationid];
        return PRECO_DIESEL;
    }
    else
    {
        if(FuelStationPrecioGasolina[stationid] > 0) return FuelStationPrecioGasolina[stationid];
        return PRECO_GASOLINA;
    }
}

// FUEL-ARCHITECTURE: Cobra el fuel ya cargado en un repostaje y finaliza.
// CRIT-1 fix: NO usa money-clamp `cost = min(cost, pDinheiro)` que permitia
// free fuel. En su lugar, si el jugador no tiene dinero para todo el fuel
// cargado, REVIERTE el fuel al nivel que puede pagar.
// CRIT-2 fix: se llama en TODOS los paths de cancelacion (out-of-range,
// exit-vehicle, state-change, disconnect).
// Retorna 1 si cobra algo, 0 si no habia fuel cargado.
stock Fuel_CobrarYFinalizar(playerid, vehicleid, cancelReason[64] = "")
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(vehicleid < 1 || vehicleid >= MAX_VEHICLES) return 0;
    if(!g_VehFuel[vehicleid][vf_initialized]) return 0;

    new Float:fuelInicial = GetPVarFloat(playerid, "Fuel");
    new Float:fuelCargado = g_VehFuel[vehicleid][vf_actual] - fuelInicial;
    if(fuelCargado <= 0.0)
    {
        // No hay fuel cargado, solo limpiar estado
        SetPVarInt(playerid, "FuelStation", 0);
        SetPVarFloat(playerid, "Fuel", 0.0);
        DeletePVar(playerid, "FuelPrecioInicio"); // CRIT-4: limpiar snapshot de precio
        RefuelTime[playerid] = 0;
        return 0;
    }

    new stationid = GetPVarInt(playerid, "FuelStation");
    // CRIT-4 (AUD2-CRIT-001): usar el precio snapshot al iniciar repostaje (PVar
    // "FuelPrecioInicio") en vez del precio actual. Evita exploit: el dueno
    // sube el precio MID-REPOSTAJE y Fuel_CobrarYFinalizar recalcula el costo
    // con el nuevo precio sobre TODO el fuel cargado. Fallback defensivo al
    // precio actual si el PVar no fue seteado (refuel pre-fix o anomalia).
    new precioPorLitro = GetPVarInt(playerid, "FuelPrecioInicio");
    if(precioPorLitro <= 0) precioPorLitro = GetFuelStationPrecio(stationid, g_VehFuel[vehicleid][vf_tipoComb]);
    new costTotal = floatround(fuelCargado * precioPorLitro);
    if(costTotal < 0) costTotal = 0;

    new costAPagar = costTotal;
    new Float:fuelAPagar = fuelCargado;

    // CRIT-1 fix: si no tiene dinero para todo, revertir fuel al nivel afford
    if(PlayerInfo[playerid][pDinheiro] < costTotal)
    {
        if(precioPorLitro <= 0)
        {
            costAPagar = 0;
            fuelAPagar = 0.0;
        }
        else
        {
            // Calcular cuantos litros puede pagar
            new litrosAfford = PlayerInfo[playerid][pDinheiro] / precioPorLitro;
            costAPagar = litrosAfford * precioPorLitro;
            fuelAPagar = float(litrosAfford);
        }
        // Revertir fuel al nivel que puede pagar
        g_VehFuel[vehicleid][vf_actual] = fuelInicial + fuelAPagar;
        Fuel[vehicleid] = g_VehFuel[vehicleid][vf_actual];
    }

    // Cobrar
    if(costAPagar > 0) AC_AddPlayerMoney(playerid, -costAPagar);

    // Mensaje
    new msg[180];
    if(cancelReason[0] != '\0')
    {
        // Path de cancelacion
        if(fuelAPagar > 0.0)
            format(msg, sizeof(msg), "%s Pagaste $%d por %.1f L cargados.", cancelReason, costAPagar, fuelAPagar);
        else
            format(msg, sizeof(msg), "%s No tenias dinero para el fuel cargado. Revertido.", cancelReason);
    }
    else
    {
        // Path normal (completado)
        format(msg, sizeof(msg), "Repostaje completado: %.1f L por $%d", fuelAPagar, costAPagar);
    }
    if(fuelAPagar < fuelCargado && fuelAPagar > 0.0)
    {
        new msgExtra[80];
        format(msgExtra, sizeof(msgExtra), " (sin dinero para %.1f L adicional)", fuelCargado - fuelAPagar);
        strcat(msg, msgExtra, sizeof(msg));
    }
    SuccesMsg(playerid, msg);

    // CRIT-3 fix: acreditar ingresos al dueno de la gasolinera
    if(stationid > 0 && stationid < MAX_FUEL_STATIONS && FuelStationCreated[stationid])
    {
        if(costAPagar > 0 && FuelStationOwnerIDF[stationid] > 0)
        {
            FuelStationCaja[stationid] += costAPagar;
            // GASBIZ-FASE2-A A2 (AUD4-HIGH-007): log anti-laundering para
            // compras cruzadas (buyerIDF != ownerIDF). El bug: Jugador A
            // (dinero sucio) repostea en gasolinera de B (complice). B
            // reclama la caja (con 5% loss en /setduenoestacion) y obtiene
            // dinero "limpio". Para detectar patrones de lavado, registrar
            // el par (comprador -> dueno) y el monto en Logs/FuelSales.log.
            // El admin podra entonces cruzar estos logs con sospechosos
            // de lavado (volumen alto, reciprocidad A<->B, etc.).
            // Nota: self-purchase (buyerIDF == ownerIDF) NO se loguea aqui
            // (es un wash trivial sin impacto financiero real).
            if(PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
            {
                new _launderLog[256];
                format(_launderLog, sizeof(_launderLog),
                    "[LAUNDER-SUSPECT] buyer=%s (IDF %d) -> duenoIDF=%d, station=%d, monto=$%d, litros=%.1f",
                    PlayerName(playerid), PlayerInfo[playerid][IDF],
                    FuelStationOwnerIDF[stationid], stationid, costAPagar, fuelAPagar);
                Log("Logs/FuelSales.log", _launderLog);
            }
        }
    }

    // Limpiar estado
    SetPVarInt(playerid, "FuelStation", 0);
    SetPVarFloat(playerid, "Fuel", 0.0);
    DeletePVar(playerid, "FuelPrecioInicio"); // CRIT-4: limpiar snapshot de precio
    RefuelTime[playerid] = 0;
    // CRIT-7 (AUD3-CRIT-002): SalvarDados ANTES de SaveFuelStation. Antes,
    // SaveFuelStation persistia la caja (income al dueno) ANTES de que el
    // jugador se guardara (SalvarDados solo lo llamaba el SaveTimer global,
    // cada N segundos). Si crash entre SaveFuelStation y el proximo
    // SalvarDados del timer: el dueno recibe income en disco (caja persisted)
    // PERO el jugador conserva su dinero en disco (no se desconto a tiempo)
    // = MONEY CREATION. Ahora persistimos el dinero descontado del jugador
    // ANTES de persistir la caja. Si crash entre SalvarDados y SaveFuelStation:
    // el jugador pierde dinero, el dueno no recibe income (loss asimetrico,
    // no dupe). Guard: solo si costAPagar > 0 (si no hubo cobro, no hay
    // estado de dinero que persistir).
    if(costAPagar > 0) SalvarDados(playerid);
    // GAS-STATION-BUSINESS: actualizar 3D label y guardar stock
    if(stationid > 0 && stationid < MAX_FUEL_STATIONS && FuelStationCreated[stationid])
    {
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        // Si falla (ej. disco lleno, permisos), el income del dueno no se
        // persiste Ã¢Â€Â” el jugador ya pago (AC_AddPlayerMoney) y la caja en
        // memoria se incremento, pero disco mantiene el valor previo. En el
        // proximo reload el dueno pierde este income (loss asimetrico, no
        // dupe). Loguear para que el admin pueda compensar manualmente.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
            Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en Fuel_CobrarYFinalizar (stationid no persistido en disco).");
        }
    }
    return 1;
}

// CRIT-3 fix: comando para que el dueno reclame sus ingresos acumulados
CMD:gasreclamar(playerid, params[])
{
        new stationid;
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USE: /gasreclamar [id]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(FuelStationOwnerIDF[stationid] != PlayerInfo[playerid][IDF] || PlayerInfo[playerid][IDF] <= 0)
                return ErrorMsg(playerid, "No eres dueno de esta gasolinera.");
        new monto = FuelStationCaja[stationid];
        if(monto <= 0) return ErrorMsg(playerid, "No hay ingresos acumulados.");
        FuelStationCaja[stationid] = 0;
        // FIX AUDIT2 AGENT2 M-15: REORDENAR. SaveFuelStation PRIMERO para
        // persistir la caja limpia en disco. Antes AC_AddPlayerMoney se
        // ejecutaba antes de SaveFuelStation; si crash entre ambos, el
        // jugador recibia el ingreso en memoria (perdido en crash) pero la
        // caja en disco mantenia el monto (jugador podria reclamar de nuevo
        // tras restart = DUPE del ingreso). Ahora persistir caja limpia
        // primero; si crash entre SaveFuelStation y AC_AddPlayerMoney, el
        // jugador no recibe el ingreso pero la caja ya esta limpia (loss
        // asimetrico, no dupe).
        SaveFuelStation(stationid);
        AC_AddPlayerMoney(playerid, monto);
        SalvarDados(playerid);
        new msg[128];
        format(msg, sizeof(msg), "Reclamaste $%d de ingresos de '%s'.", monto, FuelStationName[stationid]);
        SuccesMsg(playerid, msg);
        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[GASRECLAMAR] %s (IDF %d) reclamo $%d de gasolinera %d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], monto, stationid);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// ==================== COMANDOS ADMIN NUEVOS ====================

CMD:vercuenta(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /vercuenta [IDF]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new info[600];
        format(info, sizeof(info),
                "{FFFF00}=== %s (IDF %d) ===\n\n{FFFFFF}Admin: {FFFF00}%d\nOrg: {FFFF00}%d  Cargo: %d\n\
                Dinero: {00FF00}$%d\nBanco: {00FF00}$%d\nCoins: {FFFF00}%d\nVIP: {FFFF00}%d\n\
                Casa: {FFFF00}%d\nProfissao: {FFFF00}%d\nWanted: {FFFF00}%d",
                PlayerName(id), targetID, PlayerInfo[id][pAdmin], PlayerInfo[id][Org], PlayerInfo[id][Cargo],
                PlayerInfo[id][pDinheiro], PlayerInfo[id][pBanco], PlayerInfo[id][pCoins],
                PlayerInfo[id][pVIP], PlayerInfo[id][Casa], PlayerInfo[id][pProfissao], PlayerInfo[id][pProcurado]);
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Info Cuenta", info, "Cerrar", "");
        return 1;
}

CMD:vehinfo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /vehinfo [IDF]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new vehID = GetPlayerVehicleID(id);
        new info[512];
        if(vehID > 0)
        {
                new Float:hp, Float:fuel;
                GetVehicleHealth(vehID, hp);
                if(vehID < MAX_VEHICLES && g_VehFuel[vehID][vf_initialized]) fuel = g_VehFuel[vehID][vf_actual];
                else fuel = Fuel[vehID];
                new model = GetVehicleModel(vehID);
                format(info, sizeof(info),
                        "{FFFF00}=== Info Vehiculo ===\n\n{FFFFFF}Jugador: {FFFF00}%s (ID %d)\n\
                        Vehiculo: {FFFF00}%d (Modelo %d)\nVida: {00FF00}%.0f\nCombustible: {00FF00}%.1f L\n\
                        Interior: {FFFF00}%d  VW: %d",
                        PlayerName(id), id, vehID, model, hp, fuel, GetPlayerInterior(id), GetPlayerVirtualWorld(id));
        }
        else format(info, sizeof(info), "{FF0000}%s no esta en un vehiculo.", PlayerName(id));
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Info Vehiculo", info, "Cerrar", "");
        return 1;
}

CMD:saveall(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        new count = 0;
        foreach(new i : Player) { if(pLogado[i]) { SalvarDados(i); SalvarInventario(i); SalvarVIP(i); count++; } }
        for(new v = 1; v < MAX_DVEHICLES; v++) if(VehicleCreated[v] == VEHICLE_PLAYER) SaveVehicle(v);
        GuardarVehOrg(5); GuardarVehOrg(6); GuardarVehOrg(7); GuardarVehOrg(8); GuardarVehOrg(12); GuardarVehOrg(13);
        new msg[128];
        format(msg, sizeof(msg), "Guardado completo: %d jugadores + vehiculos.", count);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:serverinfo(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        new count = 0, admins = 0, police = 0, medics = 0, bandits = 0;
        foreach(new i : Player)
        {
                if(pLogado[i]) { count++; if(PlayerInfo[i][pAdmin] > 0) admins++; if(IsPolicial(i)) police++; if(PlayerInfo[i][Org] == 10) medics++; if(IsBandido(i)) bandits++; }
        }
        new info[512];
        format(info, sizeof(info),
                "{FFFF00}=== Info del Servidor ===\n\n{FFFFFF}Jugadores: {00FF00}%d / %d\nAdmins: {FFFF00}%d\n\
                Policias: {00FF00}%d\nParamedicos: {00FF00}%d\nBandas: {FF4444}%d\nVeh max: {FFFF00}%d\nEstaciones: {FFFF00}%d",
                count, MAX_PLAYERS, admins, police, medics, bandits, MAX_DVEHICLES, MAX_FUEL_STATIONS);
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Info Servidor", info, "Cerrar", "");
        return 1;
}

CMD:darcoins(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID, cantidad;
        if(sscanf(params, "ii", targetID, cantidad)) return ErrorMsg(playerid, "USE: /darcoins [IDF] [cantidad]");
        if(cantidad < 1 || cantidad > 100000) return ErrorMsg(playerid, "Cantidad invalida (1-100000)");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        PlayerInfo[id][pCoins] += cantidad;
        SalvarDados(id);
        new msg[128];
        format(msg, sizeof(msg), "Le diste %d coins a %s.", cantidad, PlayerName(id));
        SuccesMsg(playerid, msg);
        format(msg, sizeof(msg), "Un admin te dio %d coins.", cantidad);
        InfoMsg(id, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[DARCOINS] %s (IDF %d) dio %d coins a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], cantidad, PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// ==========================================================================
// FIX MEJORA-COINS-5: /coins - Ver propio balance de coins (cualquier jugador)
// ==========================================================================
CMD:coins(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        new _msg[128];
        format(_msg, sizeof(_msg), "Tienes {FFFF00}%d{FFFFFF} coins.", PlayerInfo[playerid][pCoins]);
        SuccesMsg(playerid, _msg);
        return 1;
}

// ==========================================================================
// FIX MEJORA-COINS-6: /vercoins [id] - Admin ve coins de otro jugador (nivel 4+)
// ==========================================================================
CMD:vercoins(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 4) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff.");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /vercoins [IDF]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new _msg[128];
        format(_msg, sizeof(_msg), "%s tiene {FFFF00}%d{FFFFFF} coins.", PlayerName(id), PlayerInfo[id][pCoins]);
        SuccesMsg(playerid, _msg);
        return 1;
}

CMD:darvip(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID, nivel, dias;
        if(sscanf(params, "iii", targetID, nivel, dias)) return ErrorMsg(playerid, "USE: /darvip [IDF] [nivel 1-3] [dias]");
        if(nivel < 1 || nivel > 3) return ErrorMsg(playerid, "Nivel VIP invalido (1-3)");
        if(dias < 1 || dias > 365) return ErrorMsg(playerid, "Dias invalidos (1-365)");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        PlayerInfo[id][pVIP] = nivel;
        PlayerInfo[id][ExpiraVIP] = ConvertDays(dias);
        SalvarDados(id); SalvarVIP(id);
        new msg[128];
        format(msg, sizeof(msg), "Le diste VIP %d por %d dias a %s.", nivel, dias, PlayerName(id));
        SuccesMsg(playerid, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[DARVIP] %s (IDF %d) dio VIP %d por %d dias a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], nivel, dias, PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

CMD:adminlogs(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 3) return ErrorMsg(playerid, "No tienes permisos.");
        new logPath[64] = "Logs/AdminAcciones.ini";
        if(!fexist(logPath)) return ErrorMsg(playerid, "No hay logs de admin aun.");
        new File:handle = fopen(logPath, io_read);
        if(!handle) return ErrorMsg(playerid, "No se pudo abrir el log.");
        new line[256], output[2048];
        new lineCount = 0;
        while(fread(handle, line))
        {
                if(lineCount < 30) { strcat(output, line, sizeof(output)); lineCount++; }
        }
        fclose(handle);
        if(lineCount == 0) output = "No hay registros.";
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Logs Admin (ultimos 30)", output, "Cerrar", "");
        return 1;
}

// =====================================================================
// COMANDOS ADMIN - Dar horas de juego, horas de trabajo, quitar VIP
// =====================================================================

CMD:darhorasjuego(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID, horas;
        if(sscanf(params, "ii", targetID, horas)) return ErrorMsg(playerid, "USE: /darhorasjuego [IDF] [horas]");
        if(horas < 1 || horas > 1000) return ErrorMsg(playerid, "Horas invalidas (1-1000)");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        PlayerInfo[id][pSegundosJogados] += (horas * 3600);
        SalvarDados(id);
        new msg[128];
        format(msg, sizeof(msg), "Le diste %d horas de juego a %s. Total: %d horas.", horas, PlayerName(id), PlayerInfo[id][pSegundosJogados] / 3600);
        SuccesMsg(playerid, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[DARHORASJUEGO] %s (IDF %d) dio %d horas de juego a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], horas, PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        new msg2[128];
        format(msg2, sizeof(msg2), "Un admin te dio %d horas de juego. Total: %d horas.", horas, PlayerInfo[id][pSegundosJogados] / 3600);
        SuccesMsg(id, msg2);
        return 1;
}

CMD:darhorastrabajo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID, horas;
        if(sscanf(params, "ii", targetID, horas)) return ErrorMsg(playerid, "USE: /darhorastrabajo [IDF] [horas]");
        if(horas < 1 || horas > 1000) return ErrorMsg(playerid, "Horas invalidas (1-1000)");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        if(PlayerInfo[id][pProfissao] == 0) return ErrorMsg(playerid, "Ese jugador no tiene trabajo.");
        // FIX: no existe pSegundosTrabajo, usamos pSegundosJogados como proxy.
        // Esto es util para testing de niveles (ej: dar 6h para desbloquear Nivel 2 Recolector).
        PlayerInfo[id][pSegundosJogados] += (horas * 3600);
        SalvarDados(id);
        new msg[128];
        format(msg, sizeof(msg), "Le diste %d horas de trabajo a %s. Total horas juego: %d.", horas, PlayerName(id), PlayerInfo[id][pSegundosJogados] / 3600);
        SuccesMsg(playerid, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[DARHORASTRABAJO] %s (IDF %d) dio %d horas de trabajo a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], horas, PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        new msg2[128];
        format(msg2, sizeof(msg2), "Un admin te dio %d horas de trabajo. Total horas: %d.", horas, PlayerInfo[id][pSegundosJogados] / 3600);
        SuccesMsg(id, msg2);
        return 1;
}

CMD:quitarvip(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /quitarvip [IDF]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        if(PlayerInfo[id][pVIP] == 0) return ErrorMsg(playerid, "Ese jugador no tiene VIP.");
        PlayerInfo[id][pVIP] = 0;
        PlayerInfo[id][ExpiraVIP] = 0;
        // FIX ALTO-VIP-003: reset color dorado al quitar VIP.
        ResetVIPVisuals(id);
        SalvarDados(id); SalvarVIP(id); // FIX CRIT-VIP-002: SalvarVIP ahora elimina VIPS/.ini cuando pVIP=0
        new msg[128];
        format(msg, sizeof(msg), "Le quitaste el VIP a %s.", PlayerName(id));
        SuccesMsg(playerid, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[QUITARVIP] %s (IDF %d) quito VIP a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        new msg2[128];
        format(msg2, sizeof(msg2), "Un admin te quito el VIP.");
        InfoMsg(id, msg2);
        return 1;
}

CMD:lookupip(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 4) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /lookupip [IDF del jugador]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new targetIP[16], ip2[16];
        GetPlayerIp(id, targetIP, sizeof(targetIP));
        new info[600];
        format(info, sizeof(info), "{FFFF00}=== Busqueda por IP ===\n\n{FFFFFF}Jugador: {FFFF00}%s (IDF %d)\nIP: {FFFF00}%s\n\n{FFFF00}Jugadores con la misma IP:\n", PlayerName(id), targetID, targetIP);
        new count = 0;
        foreach(new i : Player)
        {
                if(i == id) continue;
                if(!pLogado[i]) continue;
                GetPlayerIp(i, ip2, sizeof(ip2));
                if(strcmp(targetIP, ip2) == 0)
                {
                        new line2[128];
                        format(line2, sizeof(line2), "{FFFFFF}- %s (IDF %d, admin %d)\n", PlayerName(i), PlayerInfo[i][IDF], PlayerInfo[i][pAdmin]);
                        strcat(info, line2, sizeof(info));
                        count++;
                }
        }
        if(count == 0) strcat(info, "{00FF00}No se encontraron otros jugadores con la misma IP.\n");
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Lookup IP", info, "Cerrar", "");
        return 1;
}

CMD:findalt(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 5) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /findalt [IDF del jugador]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new targetIP[16], ip2[16];
        GetPlayerIp(id, targetIP, sizeof(targetIP));
        new info[600];
        format(info, sizeof(info), "{FFFF00}=== Busqueda de cuentas alternativas ===\n\n{FFFFFF}Jugador: {FFFF00}%s (IDF %d)\nIP: {FFFF00}%s\n\n{FFFF00}Cuentas con la misma IP conectadas:\n", PlayerName(id), targetID, targetIP);
        new count = 0;
        foreach(new i : Player)
        {
                if(i == id) continue;
                if(!pLogado[i]) continue;
                GetPlayerIp(i, ip2, sizeof(ip2));
                if(strcmp(targetIP, ip2) == 0)
                {
                        new line2[128];
                        format(line2, sizeof(line2), "{FFFFFF}- %s (IDF %d, Org %d, Admin %d)\n", PlayerName(i), PlayerInfo[i][IDF], PlayerInfo[i][Org], PlayerInfo[i][pAdmin]);
                        strcat(info, line2, sizeof(info));
                        count++;
                }
        }
        if(count == 0) strcat(info, "{00FF00}No se encontraron cuentas alternativas conectadas.\n");
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Find Alt", info, "Cerrar", "");
        return 1;
}

