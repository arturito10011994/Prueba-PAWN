// FUEL-ARCHITECTURE: Sistema de combustible RP elite.
//   PRECO_GASOLINA = $150/L  -> Sultan 55L x $150 = $8,250 lleno (~5.5% de 1h nuevo)
//   PRECO_DIESEL   = $120/L  -> 20% mas barato (camiones)
//   Bidon: precio DINAMICO = (precio gasolina estacion x GALAO_LITROS) x 1.33
//   Si gasolina $150/L: bidon = 150 x 20 x 1.33 = $3,990
//   Si gasolina $200/L: bidon = 200 x 20 x 1.33 = $5,320
//   Bidon es herramienta de emergencia, NO combustible barato.
#define GALAO_RECARGO                          133 // % del precio de gasolina (33% mas caro)

// Capacidad del bidon (litros que aporta al tanque)
#define GALAO_LITROS                            20

// Consumo ralenti base (L/minuto) cuando motor ON + vehiculo detenido.
// Se multiplica por un factor segun categoria (GetRalentiByCategory).
// Base: 0.015 L/min = 0.9 L/h (realista para sedan medio).
#define FUEL_RALENTI_LPM                        0.015

// Mejora: multiplicador de ralenti por categoria (moto=0.5x, camion=3.0x)
stock Float:GetRalentiMultByCategory(cat)
{
    switch(cat)
    {
        case 0: return 0.4;  // moto pequena (0.36 L/h)
        case 1: return 0.5;  // moto grande (0.45 L/h)
        case 2: return 0.7;  // economico (0.63 L/h)
        case 3: return 1.0;  // sedan (0.9 L/h)
        case 4: return 1.3;  // SUV/pickup (1.17 L/h)
        case 5: return 1.5;  // deportivo (1.35 L/h)
        case 6: return 2.0;  // utilitario (1.8 L/h)
        case 7: return 3.0;  // camion/bus (2.7 L/h)
    }
    return 1.0;
}

