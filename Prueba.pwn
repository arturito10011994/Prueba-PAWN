// P0-MED-CHALECO/P0-REP-CHALECO: sistema de chaleco activable para Paramedicos y Reporteros.
// Al vestir el uniforme se les otorga el derecho a usar chaleco, pero NO se les activa
// automaticamente (para que se vea el skin completo). Lo activan/desactivan con /chaleco.
new bool:g_ChalecoPermitido[MAX_PLAYERS];   // true = tiene derecho a usar chaleco (uniforme vestido)
new bool:g_ChalecoActivo[MAX_PLAYERS];      // true = chaleco equipado actualmente

// FIX AUDIT CHAL MEJORA-1/2: helpers centralizados para chaleco.
// SetChalecoState: setea ambos flags + armour en 1 llamada. Reemplaza patron duplicado.
// ClearChalecoState: resetea armour a 0 + ambos flags. Reemplaza SetPlayerArmour(0) sin reset.
stock SetChalecoState(playerid, Float:amount, bool:setActivo)
{
        if(!IsPlayerConnected(playerid)) return 0;
        g_ChalecoPermitido[playerid] = true;
        g_ChalecoActivo[playerid] = setActivo;
        SetPlayerArmour(playerid, amount);
        return 1;
}
stock ClearChalecoState(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        SetPlayerArmour(playerid, 0.0);
        g_ChalecoPermitido[playerid] = false;
        g_ChalecoActivo[playerid] = false;
        return 1;
}
// FIX AUDIT CHAL MEJORA-3: #define para magic numbers del sistema de chaleco.
#define CHALECO_FULL          100.0
#define CHALECO_REPORTERO      50.0
#define CHALECO_REMOVE          0.0
