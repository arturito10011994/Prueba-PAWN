stock IsPlayerInPlace(playerid,Float:XMin,Float:YMin,Float:XMax,Float:YMax )
{
        new RetValue = 0;
        new Float:X,Float:Y,Float:Z;
        GetPlayerPos(playerid,X,Y,Z );

        if( X >= XMin && Y >= YMin && X < XMax && Y < YMax )
        {
        RetValue = 1;
        }
        return RetValue;
}

stock GetVehicleTrunkPosition(vehicleid, &Float:x, &Float:y, &Float:z)
{
    new
        Float:vehsize,
        Float:vehangle,
        Float:n;

    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, vehangle);

    GetVehicleModelInfo(GetVehicleModel(vehicleid), VEHICLE_MODEL_INFO_SIZE, n, vehsize, n);

    x -= ((vehsize / 1.6) * floatsin(-vehangle, degrees));
    y -= ((vehsize / 1.6) * floatcos(-vehangle, degrees));
}

stock GuardarItem2(playerid)
{
        new Item = GetPlayerWeapon(playerid);
        new Ammo = GetPlayerAmmo(playerid);
        new orgid = GetPlayerOrg(playerid);
        if(Item == 0) return SendClientMessage(playerid, -1, "{FF2400}[ x ] {BEBEBE}No puedes guardar tu arma en el cofre.");
        // FIX AUDIT COFRE [C5]: agregar return tras primer slot vacio (antes duplicaba a TODOS los slots)
        for(new i = 0; i < 50; i++)
        {
                if(CofreArma[i][orgid] == 0)
                {
                        CofreArma[i][orgid] = Item;
                        CofreAmmo[i][orgid] = Ammo;
                        RemoverItem2(playerid, Item);
                        SalvarCofre(orgid);
                        // FIX AUDIT: registrar movimiento en el log de la org
                        new logMsg[128], pName[24], wname[32];
                        GetPlayerName(playerid, pName, sizeof(pName));
                        GetWeaponName(Item, wname, sizeof(wname));
                        format(logMsg, sizeof(logMsg), "%s deposito %s (%d balas) en el cofre", pName, wname, Ammo);
                        AlmReg_Movimiento(orgid, logMsg);
                        SendClientMessage(playerid, -1, "{00FF00}[ [v] ] {BEBEBE}Guardaste tu arma en el cofre de la banda.");
                        return 1; // FIX: salir inmediatamente tras guardar (evita dupe)
                }
        }
        SendClientMessage(playerid, -1, "{FF2400}[ x ] {BEBEBE}Tu cofre esta lleno!");
        return 1;
}

stock RemoverItem2(playerid, item)
{
        new Arma[13][2];
        // FIX AUDIT COFRE [B4]: eliminado dead code "if(i == 13)break;" (i < 13 ya acota el loop)
        // FIX AUDIT2 AGENT1 W-04: leer de tracking server-side (g_PlayerWeapons) en vez
        // de GetPlayerWeaponData (cliente puede tener armas cheat).
        for(new i = 1; i < 13; ++i)
        {
                Arma[i][0] = g_PlayerWeapons[playerid][i][0];
                Arma[i][1] = g_PlayerWeapons[playerid][i][1];
        }
        ResetPlayerWeapons(playerid);
        for(new i = 1; i < 13; ++i)
        {
                if(item != Arma[i][0]) GivePlayerWeapon(playerid, Arma[i][0], Arma[i][1]);
        }
}

stock ItemOpcoes2(playerid, Item)
{
        new orgid = GetPlayerOrg(playerid);
        if(CofreArma[Item][orgid] == 0) return PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
        ItemOpcion[playerid] = Item;
        // FIX AUDIT COFRE [B7]: traducir mensaje PT a ES + eliminar mencion "Tirar al Suelo" (callback inexistente)
        return ShowPlayerDialog(playerid, DIALOG_ARMAS12, DIALOG_STYLE_LIST, "Cofre de Banda", "Tomar Arma\nRetirar del Cofre", "OK", "Salir");
}

stock SalvarCofreF(idbau)
{
    new Arq[64];
        format(Arq, sizeof(Arq), PASTA_COFRES, idbau);
        // FIX AUDIT COFRE [C6]: crear archivo si no existe (antes no persistia en primera ejecucion)
        if(!DOF2_FileExists(Arq)) DOF2_CreateFile(Arq);
        DOF2_SetInt(Arq, "CofreID", CofreInfo[idbau][CofreID]);
        DOF2_SetFloat(Arq, "CofrePosX", CofreInfo[idbau][CofrePosX]);
        DOF2_SetFloat(Arq, "CofrePosY", CofreInfo[idbau][CofrePosY]);
        DOF2_SetFloat(Arq, "CofrePosZ", CofreInfo[idbau][CofrePosZ]);
        DOF2_SetFloat(Arq, "CofrePosR", CofreInfo[idbau][CofrePosR]);
        // FIX AUDIT COFRE [C6]: tambien guardar armas en SalvarCofreF (antes se perdian si crasheaba despues de /Traercofre)
        new str[32];
        for(new i = 0; i < 50; i++)
        {
                format(str, sizeof(str), "Arma inv %d", i);
                DOF2_SetInt(Arq, str, CofreArma[i][idbau]);
                format(str, sizeof(str), "Ammo inv %d", i);
                DOF2_SetInt(Arq, str, CofreAmmo[i][idbau]);
        }
        DOF2_SaveFile();
        return 1;
}

stock SalvarCofre(idorg)
{
        new Arq[64], str[32];
        format(Arq, sizeof(Arq), PASTA_COFRES, idorg);
        if(!DOF2_FileExists(Arq)) DOF2_CreateFile(Arq);
        // Armas y municion (sistema original)
        for(new i = 0; i < 50; i++)
        {
                format(str, sizeof(str), "Arma inv %d", i);
                DOF2_SetInt(Arq, str, CofreArma[i][idorg]);
                format(str, sizeof(str), "Ammo inv %d", i);
                DOF2_SetInt(Arq, str, CofreAmmo[i][idorg]);
        }
        DOF2_SetInt(Arq, "CofreID", CofreInfo[idorg][CofreID]);
        DOF2_SetFloat(Arq, "CofrePosX", CofreInfo[idorg][CofrePosX]);
        DOF2_SetFloat(Arq, "CofrePosY", CofreInfo[idorg][CofrePosY]);
        DOF2_SetFloat(Arq, "CofrePosZ", CofreInfo[idorg][CofrePosZ]);
        DOF2_SetFloat(Arq, "CofrePosR", CofreInfo[idorg][CofrePosR]);
        // SISTEMA ALMACEN ORG: nuevos campos
        DOF2_SetInt(Arq, "FondoOrg", g_FondoOrg[idorg]);
        DOF2_SetInt(Arq, "DrogaMacoha", g_AlmacenDrogas[idorg][DROGA_MACONHA]);
        DOF2_SetInt(Arq, "DrogaCocaina", g_AlmacenDrogas[idorg][DROGA_COCAINA]);
        DOF2_SetInt(Arq, "DrogaCrack", g_AlmacenDrogas[idorg][DROGA_CRACK]);
        DOF2_SetInt(Arq, "DrogaPastaBase", g_AlmacenDrogas[idorg][DROGA_PASTABASE]);
        DOF2_SetInt(Arq, "HerrGanzua", g_CofreHerramientas[idorg][HERR_GANZUA]);
        DOF2_SetInt(Arq, "HerrTaladro", g_CofreHerramientas[idorg][HERR_TALADRO]);
        DOF2_SetInt(Arq, "HerrExplosivo", g_CofreHerramientas[idorg][HERR_EXPLOSIVO]);
        DOF2_SetInt(Arq, "PiezasArmas", g_CofrePiezas[idorg]);
        // Municion separada (20 slots)
        for(new i = 0; i < MAX_MUNICION_SLOTS; i++)
        {
                format(str, sizeof(str), "MunicionTipo%d", i);
                DOF2_SetInt(Arq, str, CofreMunicionTipo[i][idorg]);
                format(str, sizeof(str), "MunicionCant%d", i);
                DOF2_SetInt(Arq, str, CofreMunicionCant[i][idorg]);
        }
        DOF2_SaveFile();
        return 1;
}

stock CarregarCofre(idorg)
{
        new Arq[64], str[32], string[180];
        format(Arq, sizeof(Arq), PASTA_COFRES, idorg);
        if(DOF2_FileExists(Arq))
        {
                for(new i = 0; i < 50; i++)
                {
                        format(str, sizeof(str), "Arma inv %d", i);
                        CofreArma[i][idorg] = DOF2_GetInt(Arq, str);
                        format(str, sizeof(str), "Ammo inv %d", i);
                        CofreAmmo[i][idorg] = DOF2_GetInt(Arq, str);
                }
                CofreInfo[idorg][CofreID] = DOF2_GetInt(Arq, "CofreID");
                CofreInfo[idorg][CofrePosX] = DOF2_GetFloat(Arq, "CofrePosX");
                CofreInfo[idorg][CofrePosY] = DOF2_GetFloat(Arq, "CofrePosY");
                CofreInfo[idorg][CofrePosZ] = DOF2_GetFloat(Arq, "CofrePosZ");
                CofreInfo[idorg][CofrePosR] = DOF2_GetFloat(Arq, "CofrePosR");
                // SISTEMA ALMACEN ORG: cargar nuevos campos
                g_FondoOrg[idorg] = DOF2_GetInt(Arq, "FondoOrg");
                g_AlmacenDrogas[idorg][DROGA_MACONHA] = DOF2_GetInt(Arq, "DrogaMacoha");
                g_AlmacenDrogas[idorg][DROGA_COCAINA] = DOF2_GetInt(Arq, "DrogaCocaina");
                g_AlmacenDrogas[idorg][DROGA_CRACK] = DOF2_GetInt(Arq, "DrogaCrack");
                g_AlmacenDrogas[idorg][DROGA_PASTABASE] = DOF2_GetInt(Arq, "DrogaPastaBase");
                g_CofreHerramientas[idorg][HERR_GANZUA] = DOF2_GetInt(Arq, "HerrGanzua");
                g_CofreHerramientas[idorg][HERR_TALADRO] = DOF2_GetInt(Arq, "HerrTaladro");
                g_CofreHerramientas[idorg][HERR_EXPLOSIVO] = DOF2_GetInt(Arq, "HerrExplosivo");
                g_CofrePiezas[idorg] = DOF2_GetInt(Arq, "PiezasArmas");
                for(new i = 0; i < MAX_MUNICION_SLOTS; i++)
                {
                        format(str, sizeof(str), "MunicionTipo%d", i);
                        CofreMunicionTipo[i][idorg] = DOF2_GetInt(Arq, str);
                        format(str, sizeof(str), "MunicionCant%d", i);
                        CofreMunicionCant[i][idorg] = DOF2_GetInt(Arq, str);
                }
                ObjetoCofre[idorg] = CreateDynamicObject(19772, CofreInfo[idorg][CofrePosX], CofreInfo[idorg][CofrePosY], CofreInfo[idorg][CofrePosZ], 0.0, 0.0, CofreInfo[idorg][CofrePosR]);
                format(string, sizeof(string), "{BEBEBE}ID Cofre: %d\nPresiona {FF2400}H\n{BEBEBE}Para Abrir el Menu del Cofre", CofreInfo[idorg][CofreID]);
                TextoCofreOrg[idorg] = CreateDynamic3DTextLabel(string, -1, CofreInfo[idorg][CofrePosX], CofreInfo[idorg][CofrePosY], CofreInfo[idorg][CofrePosZ], 25.0);
                return 1;
        }
    return 1;
}

// =====================================================================
// SISTEMA ALMACEN ORG - HELPERS Y MENUS
// =====================================================================

// Helper: registrar movimiento en archivo INI de la org
stock AlmReg_Movimiento(orgid, const accion[])
{
        new logFile[64];
        format(logFile, sizeof(logFile), "Logs/OrgMovimientos%d.ini", orgid);
        if(!DOF2_FileExists(logFile)) DOF2_CreateFile(logFile);
        new dia, mes, ano, hora, minuto, segundo, key[32];
        getdate(ano, mes, dia);
        gettime(hora, minuto, segundo);
        format(key, sizeof(key), "%02d/%02d/%d %02d:%02d:%02d", dia, mes, ano, hora, minuto, segundo);
        DOF2_SetString(logFile, key, accion);
        DOF2_SaveFile();
}

// Helper: verificar si el jugador puede retirar del cofre
// Regla: lider (cargoMax) puede siempre. Si NO hay lider online, el cargo inmediatamente inferior (cargoMax-1) puede.
stock AlmPuedeRetirar(playerid, orgid)
{
        new cargoMax = GetOrgCargoMax(orgid);
        new miCargo = PlayerInfo[playerid][Cargo];
        // Lider puede siempre
        if(miCargo >= cargoMax) return 1;
        // Si no es lider, verificar si hay algun lider online
        new hayLiderOnline = 0;
        foreach(new i : Player)
        {
                if(!pLogado[i]) continue;
                if(PlayerInfo[i][Org] != orgid) continue;
                if(PlayerInfo[i][Cargo] >= cargoMax) { hayLiderOnline = 1; break; }
        }
        // Si hay lider online, solo el lider puede retirar
        if(hayLiderOnline) return 0;
        // Si NO hay lider online, el cargo inmediatamente inferior puede retirar
        if(miCargo >= cargoMax - 1) return 1;
        return 0;
}

// Helper: mostrar el menu principal del almacen de organizacion
stock AlmMostrarMenuPrincipal(playerid, orgid)
{
        // FIX UX: usar el titulo del dialogo para mostrar org y cargo (no son opciones clickeables)
        // Antes estaban en el body como lineas, lo que desplazaba los listitem y rompia la seleccion.
        new titulo[128];
        format(titulo, sizeof(titulo), "Almacen de %s | Cargo: %s", g_HQNombres[orgid], NomeCargo(playerid));
        new menu[400];
        format(menu, sizeof(menu),
                "{00FF00}1. {FFFFFF}Cofre de Armamento (armas + municion)\n\
                {00FF00}2. {FFFFFF}Almacen X (drogas)\n\
                {00FF00}3. {FFFFFF}Fondo de Organizacion (dinero)\n\
                {00FF00}4. {FFFFFF}Herramientas y Piezas\n\
                {00FF00}5. {FFFFFF}Ver Movimientos");
        SetPVarInt(playerid, "CofreOrgAbierto", orgid);
        SetPVarInt(playerid, "CofreDialogoAbierto", 1);
        ShowPlayerDialog(playerid, DIALOG_ALMACEN_ORG, DIALOG_STYLE_LIST, titulo, menu, "Seleccionar", "Cerrar");
}

// Helper: mostrar menu de armamento (armas)
stock AlmMostrarArmas(playerid, orgid)
{
        new Inv[1200], Nick[32];
        strcat(Inv, "{00FF00}>> Guardar Arma en Mano <<\n");
        strcat(Inv, "{00FF00}>> Ver Municion Separada <<\n");
        for(new ii = 0; ii < 50; ii++)
        {
                GetWeaponName(CofreArma[ii][orgid], Nick, sizeof(Nick));
                strcat(Inv, CofreArma[ii][orgid] > 0 ? (CofreArma[ii][orgid] == 18 ? ("{FFDC33}Coctel Molotov") : (Nick)) : ("{BEBEBE}(Vacio)"));
                strcat(Inv, "\n");
        }
        SetPVarInt(playerid, "AlmOpActual", COFRE_OP_ARMAMENTO);
        ShowPlayerDialog(playerid, DIALOG_ALMACEN_ARMAS, DIALOG_STYLE_LIST, "Cofre de Armamento", Inv, "Seleccionar", "Volver");
}

// Helper: mostrar menu de municion separada
stock AlmMostrarMunicion(playerid, orgid)
{
        new Inv[800], Nick[32];
        strcat(Inv, "{00FF00}>> Depositar Municion del Arma en Mano <<\n");
        for(new i = 0; i < MAX_MUNICION_SLOTS; i++)
        {
                if(CofreMunicionTipo[i][orgid] > 0)
                {
                        GetWeaponName(CofreMunicionTipo[i][orgid], Nick, sizeof(Nick));
                        format(Inv, sizeof(Inv), "%s{FFDC33}%s {FFFFFF}x %d balas\n", Inv, Nick, CofreMunicionCant[i][orgid]);
                }
                else
                {
                        strcat(Inv, "{BEBEBE}(Vacio)\n");
                }
        }
        SetPVarInt(playerid, "AlmOpActual", COFRE_OP_MUNICION);
        ShowPlayerDialog(playerid, DIALOG_ALMACEN_MUNICION, DIALOG_STYLE_LIST, "Municion Separada", Inv, "Seleccionar", "Volver");
}

