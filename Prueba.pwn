ConvertMoney(number)
{
        new real,mil,milhao,milhaor,bilhao,bilhaor,string[100];
        if(number > 999999999)
        {
                bilhao = number / 1000000000;
                bilhaor = number % 1000000000;
                milhao =  bilhaor / 1000000;
                milhaor = bilhaor % 1000000;
                mil = milhaor / 1000;
                real = milhaor % 1000;
        }
        else if(number > 999999)
        {
                milhao = number / 1000000;
                milhaor = number % 1000000;
                mil = milhaor / 1000;
                real = milhaor % 1000;
        }
        else if(number > 999)
        {
                mil = number / 1000;
                real = number % 1000;
        }
        if(number > 999999999)
        {
                format(string, 100, "%d.%03d.%03d.%03d", bilhao, milhao, mil, real);
        }
        else if(number > 999999)
        {
                format(string, 100, "%d.%03d.%03d", milhao, mil, real);
        }
        else if(number > 999)
        {
                format(string, 100, "%d.%03d", mil, real);
        }
        else
        {
                format(string, 100, "%d", number);
        }
        return string;
}

// FIX AUDIT AFK M7: helper IsAFKExempt(playerid) para reducir codigo duplicado.
// Antes: las 6 exenciones (herido, preso, algemado, dormir, spectating, WASTED)
// estaban duplicadas en AntiAway (6 continues) y TestAway (6 returns con hide TDs).
// Ahora: este helper centraliza la logica para futuros usos. AntiAway y TestAway
// mantienen su codigo actual por seguridad (no romper nada), pero nuevos callers
// pueden usar IsAFKExempt(playerid) en una sola linea.
// Retorna: true si el jugador esta en estado legÃ¯Â¿Â½timamente AFK (no deberia ser
// kickeado), false si deberia ser chequeado por AntiAway.
// NOTA: NO incluye el check de pCongelado con auto-release H9 (ese tiene logica
// especial que libera al jugador, no es un simple true/false).
stock IsAFKExempt(playerid)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return true;
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) return true; // herido
        if(PlayerInfo[playerid][pjail] > 0) return true;                           // preso
        if(g_DormindoODescansando[playerid]) return true;                          // /dormir/descansar
        if(IsAssistindo[playerid]) return true;                                     // spectating admin
        new pstate = GetPlayerState(playerid);
        if(pstate == PLAYER_STATE_SPECTATING || pstate == PLAYER_STATE_WASTED) return true;
        return false;
}

CallBack::AntiAway()
{
        // FIX AUDIT AGENT4 AFK-12: AntiAFK_Ativado es ahora per-jugador. El timer
        // global itera todos los jugadores y salta los que tienen AntiAFK_Ativado[i]=false.
        new Float:X, Float:Y, Float:Z;
        new Float:CX, Float:CY, Float:CZ;
        foreach(new i: Player)
        {
                // FIX AUDIT AGENT4 AFK-01: era return 0 (abortaba todo el foreach en el primer
                // jugador no logueado, dejando AFK detection rota para el resto). Mismo
                // patron que ya fue corregido en Checkjail L10695 (FIX AUDIT 5P).
                if(!IsPlayerConnected(i) || pLogado[i] == false) continue;
                // FIX AUDIT AGENT4 AFK-12: skip jugadores con AntiAFK_Ativado[i]=false
                // (admin desactivo AntiAFK para ese jugador en especifico).
                if(AntiAFK_Ativado[i] == false) continue;
                // FIX AUDIT AFK H7: perodo de gracia post-spawn.
                // Antes: AntiAway podia flaggear AFK a un jugador recien spawneado en 10s,
                // antes de que terminara de cargar el mapa. Ahora: si han pasado menos
                // de AFK_GRACE_PERIOD_SEC (60s) desde el ultimo spawn, skip el check.
                if(gettime() - g_LastSpawnTs[i] < AFK_GRACE_PERIOD_SEC) continue;
                // FIX AUDIT AGENT4 AFK-04: eximir estados legititamente congelados.
                // Sin esto, jugadores herido/preso/algemado/spectating son kickeados
                // por AFK mientras esperan revive/arresto/paramedico.
                if(MinutosMorte[i] > 0 || SegundosMorte[i] > 0) continue;
                if(PlayerInfo[i][pjail] > 0) continue;
                if(PlayerInfo[i][pCongelado])
                {
                        // FIX AUDIT AFK H9: auto-release de algemado tras 10 min.
                        // Antes: si el cop se desconectaba sin /desalgemar, el jugador
                        // quedaba algemado indefinidamente. Un cop malicioso podia algemar
                        // a un amigo para eximirlo de AFK (bypass H9).
                        // Ahora: si AlgemadoTs esta seteado (algemado por cop) y han pasado
                        // mas de ALGEMADO_TIMEOUT_SEC (600s = 10 min), liberar automaticamente.
                        // Nota: solo aplica a algemados por cop (AlgemadoCop != 0). Los
                        // algemados por admin (/congelar) NO se auto-liberan (el admin debe
                        // decidir cuando liberar).
                        new algTs = GetPVarInt(i, "AlgemadoTs");
                        new algCop = GetPVarInt(i, "AlgemadoCop");
                        if(algCop > 0 && algTs > 0 && (gettime() - algTs) >= ALGEMADO_TIMEOUT_SEC)
                        {
                                // Auto-release: liberar al jugador algemado.
                                TogglePlayerControllable(i, true);
                                PlayerInfo[i][pCongelado] = false;
                                DeletePVar(i, "AlgemadoPor");
                                DeletePVar(i, "AlgemadoCop");
                                DeletePVar(i, "AlgemadoTs");
                                ClearAnimations(i);
                                RemovePlayerAttachedObject(i, 5);
                                SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
                                InfoMsg(i, "Fuiste liberado automaticamente tras 10 min de algemado (cop no disponible).");
                                printf("[AFK-H9] Jugador %s (ID %d) auto-liberado tras 10 min de algemado (cop %d no dispon.).",
                                        PlayerName(i), i, algCop);
                                // Continuar con el check AFK (ya no esta exento).
                        }
                        else
                        {
                                // Aun dentro del periodo de 10 min - eximir de AFK.
                                continue;
                        }
                }
                // FIX AUDIT AFK H6: eximir jugadores en /dormir o /descansar (animaciones largas).
                if(g_DormindoODescansando[i]) continue;
                if(IsAssistindo[i]) continue;
                new pstate = GetPlayerState(i);
                if(pstate == PLAYER_STATE_SPECTATING || pstate == PLAYER_STATE_WASTED) continue;
                // FIX AUDIT AFK H4: si ya hay countdown TestAway pendiente, no crear otro.
                // Antes: si AntiAway disparaba dos veces (5 min despues) y el primer
                // countdown no habia terminado (improbable, 10s << 5min), se creaban
                // dos timers. Ahora: skip si g_TestAwayTimer[i] != 0.
                if(g_TestAwayTimer[i] != 0) continue;
                GetPlayerPos(i, X, Y, Z);
                GetPlayerCameraPos(i, CX, CY, CZ);
                // FIX AUDIT AGENT4 AFK-08: antes usaba == exacto en floats. SA-MP
                // GetPlayerPos es determinista, pero jitter de sincronizacion o
                // animacion de respiracion podria causar X != pPosX aunque el
                // jugador este quieto. Si esto pasa, AntiAway considera que se
                // movio y no dispara TestAway (falso negativo, no falso positivo).
                // Fix: usar tolerancia epsilon de 0.5m (medio metro).
                // FIX AUDIT AFK M6: usar #define AFK_EPSILON_M en vez de magic number.
                if(floatabs(X - PlayerInfo[i][pPosX]) < AFK_EPSILON_M
                   && floatabs(Y - PlayerInfo[i][pPosY]) < AFK_EPSILON_M
                   && floatabs(Z - PlayerInfo[i][pPosZ]) < AFK_EPSILON_M)
                {
                        // FIX AUDIT AFK H4: trackear el ID del timer para poder KillTimer.
                        g_TestAwayTimer[i] = SetTimerEx("TestAway", 1000, false, "ii", i, AFK_COUNTDOWN_SEC);
                        Moved[i] = false;
                }
                GetPlayerPos(i, PlayerInfo[i][pPosX], PlayerInfo[i][pPosY], PlayerInfo[i][pPosZ]);
                GetPlayerCameraPos(i, PlayerInfo[i][pCamX], PlayerInfo[i][pCamY], PlayerInfo[i][pCamZ]);
        }
        return 1;
}

CallBack::TestAway(playerid, TimeTo)
{
        // FIX AUDIT AFK H2: validar IsPlayerConnected + pLogado al inicio.
        // Antes: TestAway no tenia guard. Si un jugador A se desconectaba mid-countdown
        // y el slot era reusado por jugador B, el timer seguia disparando sobre el slot
        // de A (= B ahora). B reciba kick "Fuiste expulsado por estar AFK" en pantalla
        // de login. Esto es un vector de griefing/DoS.
        // Ahora: si el slot no esta conectado o no esta logueado, cancelar el countdown
        // sin kickear (no es culpa del nuevo ocupante).
        if(!IsPlayerConnected(playerid) || !pLogado[playerid])
        {
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(AntiAFK_Ativado[playerid] == false)
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        // FIX AUDIT AFK H3: re-evaluar las 6 exenciones de AntiAway en cada tick de TestAway.
        // Antes: TestAway solo checkeaba AntiAFK y Moved. Si el jugador entraba en estado
        // herido/preso/algemado/spectating DURANTE el countdown, TestAway no lo exima y
        // kickea al jugador en estado legitimo.
        // Ahora: las mismas 6 exenciones de AntiAway L12818-12823 se re-evaluan aqui.
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
        {
                // Jugador herido durante countdown - cancelar AFK kick.
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(PlayerInfo[playerid][pjail] > 0)
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(PlayerInfo[playerid][pCongelado])
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        // FIX AUDIT AFK H6: eximir jugadores en /dormir o /descansar (animaciones largas).
        if(g_DormindoODescansando[playerid])
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(IsAssistindo[playerid])
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        new pstate = GetPlayerState(playerid);
        if(pstate == PLAYER_STATE_SPECTATING || pstate == PLAYER_STATE_WASTED)
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(Moved[playerid] == true)
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        new Float:X, Float:Y, Float:Z;
        new Float:CX, Float:CY, Float:CZ;
        GetPlayerPos(playerid, X, Y, Z);
        GetPlayerCameraPos(playerid, CX, CY, CZ);
        // FIX AUDIT2 AGENT4 S-03: AFK-08 estaba incompleto. AntiAway usa epsilon 0.5m
        // (L10916) pero TestAway seguia con == exacto. Jitter sub-metro del cliente
        // (sincronizacion, animacion de respiracion, desync) hacia que X != pPosX fuera
        // TRUE en jugadores estaticos, cancelando el countdown AFK. Deteccion AFK
        // inutilizada para jugadores con jitter. Fix: usar epsilon 0.5m tambien aqui.
        // FIX AUDIT AFK M6: usar #define AFK_EPSILON_M en vez de magic number.
        if(floatabs(X - PlayerInfo[playerid][pPosX]) > AFK_EPSILON_M || floatabs(Y - PlayerInfo[playerid][pPosY]) > AFK_EPSILON_M
           || floatabs(Z - PlayerInfo[playerid][pPosZ]) > AFK_EPSILON_M || floatabs(CX - PlayerInfo[playerid][pCamX]) > AFK_EPSILON_M
           || floatabs(CY - PlayerInfo[playerid][pCamY]) > AFK_EPSILON_M || floatabs(CZ - PlayerInfo[playerid][pCamZ]) > AFK_EPSILON_M)
        {
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                return 0;
        }
        if(TimeTo == 0)
        {
                InfoMsg(playerid, "Fuiste expulsado por estar AFK.");
                TextDrawHideForPlayer(playerid, Textdraw0);
                TextDrawHideForPlayer(playerid, Textdraw1);
                PlayerTextDrawHide(playerid, Textdraw2[playerid]);
                PlayerTextDrawDestroy(playerid, Textdraw2[playerid]);
                g_TestAwayTimer[playerid] = 0;
                // FIX AUDIT AGENT4 AFK-10: strike counter AFK. 3 strikes en 24h = ban 1h.
                // FIX AUDIT AFK H8: ban temporal automatico de 1h al llegar a 3 strikes.
                // Cada kick por AFK incrementa el contador. Si llega a AFK_STRIKES_THRESHOLD
                // (3), se setea g_AFKBanUntilTs = gettime() + AFK_BAN_DURATION_SEC (3600s).
                // Al reconectar, OnPlayerConnect verifica AFKBanUntilTs > gettime() = ban activo.
                g_AFKStrikes[playerid]++;
                g_AFKLastKickTs[playerid] = gettime();
                printf("[AFK-AC] %s (ID %d) kickeado por AFK. Strike %d acumulado.",
                        PlayerName(playerid), playerid, g_AFKStrikes[playerid]);
                if(g_AFKStrikes[playerid] >= AFK_STRIKES_THRESHOLD)
                {
                        new logmsg[200];
                        format(logmsg, sizeof(logmsg), "[AFK-REINCIDENCIA] %s (ID %d) acumulo %d strikes AFK en 24h. BAN TEMPORAL 1h activado.",
                                PlayerName(playerid), playerid, g_AFKStrikes[playerid]);
                        new File:f = fopen("Logs/AfkReincidencia.log", io_append);
                        if(f) { fwrite(f, logmsg); fwrite(f, "\r\n"); fclose(f); }
                        SendAdminMessage(0xFF6600FF, logmsg);
                        // FIX AUDIT AFK H8: ban temporal automatico de 1h al llegar a 3 strikes.
                        // Antes: solo se logueaba. El atacante podia reconectar inmediatamente
                        // y seguir farmeando PayDay con macro de chat (bypass H5 ya cerrado,
                        // pero el macro de movimiento < 0.5m cada 5 min sigue funcionando).
                        // Ahora: se setea AFKBanUntilTs = gettime() + 3600. Al reconectar,
                        // OnPlayerConnect verificara AFKBanUntilTs > gettime() = ban activo,
                        // y kickeara al jugador con mensaje "Baneado por AFK 1h, espera Xs".
                        // Esto persiste en disco via SalvarDados (se agrego AFKBanUntilTs).
                        g_AFKBanUntilTs[playerid] = gettime() + AFK_BAN_DURATION_SEC;
                        // Resetear strikes tras el ban (no acumular mas alla de 3).
                        // Si vuelve a acumular 3 dentro de la ventana 24h despues del ban,
                        // se le aplicara otro ban de 1h.
                        g_AFKStrikes[playerid] = 0;
                }
                Kick(playerid);
                return 0;
        }
        TextDrawShowForPlayer(playerid, Textdraw0);
        TextDrawShowForPlayer(playerid, Textdraw1);
        format(Motivo, sizeof(Motivo), "%i", TimeTo);
        PlayerTextDrawSetString(playerid, Textdraw2[playerid], Motivo);
        PlayerTextDrawShow(playerid, Textdraw2[playerid]);
        // FIX AUDIT AFK H4: trackear el ID del timer re-agendado para poder KillTimer.
        g_TestAwayTimer[playerid] = SetTimerEx("TestAway", 1000, false, "ii", playerid, TimeTo - 1);
        return g_TestAwayTimer[playerid];
}

CallBack::SpawnP(playerid)
{
        // FIX AUDIT MEDICO A4-REHAB-MED-02: validar IsPlayerConnected antes de SpawnPlayer.
        // ANTES: si el jugador se desconectaba durante los 500ms del SetTimerEx y otro
        // jugador reusaba el slot, SpawnPlayer(slot_id) podia spawnear al nuevo jugador
        // en la posicion savede SetSpawnInfo del target original.
        // AHORA: solo spawnear si el jugador sigue conectado y logueado.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        #undef SpawnPlayerID
        SpawnPlayer(playerid);
        #define SpawnPlayerIDerI(%0) SetTimerEx("SpawnP", 500, false, "i", %0)
        return 1;
}

CallBack::KickPlayer(playerid)
{
        #undef Kick
        Kick(playerid);
        #define Kick(%0) SetTimerEx("KickPlayer", 500, false, "i", %0)
        return 1;
}

// FIX AUDIT AFK H8: callback para kickear jugador con ban temporal AFK activo.
// Se invoca 500ms despues de que OnPlayerConnect detecta AFKBanUntilTs > gettime().
// El delay permite que el mensaje de ban llegue al cliente antes de la desconexion.
CallBack::AFKBanKick(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        new banMsg[128];
        GetPVarString(playerid, "AFKBanMsg", banMsg, sizeof(banMsg));
        ErrorMsg(playerid, banMsg);
        DeletePVar(playerid, "AFKBanMsg");
        // Loguear el kick por ban AFK para auditoria.
        printf("[AFK-BAN] %s (ID %d) kickeado por ban temporal AFK activo hasta %d.",
                PlayerName(playerid), playerid, g_AFKBanUntilTs[playerid]);
        new File:f = fopen("Logs/AfkReincidencia.log", io_append);
        if(f)
        {
                new logLine[256];
                format(logLine, sizeof(logLine), "[%d] [AFK-BAN-ACTIVE] %s (ID %d) intento reconectar con ban activo hasta %d.\r\n",
                        gettime(), PlayerName(playerid), playerid, g_AFKBanUntilTs[playerid]);
                fwrite(f, logLine);
                fclose(f);
        }
        // Usar Kick directo (no macro) para evitar delay extra.
        #undef Kick
        Kick(playerid);
        #define Kick(%0) SetTimerEx("KickPlayer", 500, false, "i", %0)
        return 1;
}

CallBack::Checkjail()
{
        foreach(new i: Player)
        {
                // FIX AUDIT 5P: era return 0 (detenia todo el timer), ahora continue (salta este jugador)
                if(!IsPlayerConnected(i) || pLogado[i] == false) continue;
                PlayerInfo[i][pSegundosJogados] += 2;
                if(PlayerInfo[i][pjail] > 0)
                {
                        PlayerInfo[i][pjail]-= 2;
                        SetPlayerHealth(i, 9999);
                        // FIX AUDIT ASSIGNJAILCELL: cambiar == 0 a <= 0 para liberar en pjail negativo tambien
                        if(PlayerInfo[i][pjail] <= 0)
                        {
                                SetPlayerPos(i, 1685.698608, -2334.948730, 13.546875);
                                TogglePlayerControllable(i, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", i);
                                SetPlayerInterior(i, 0);
                                SetPlayerVirtualWorld(i, 0);
                                SetPlayerHealth(i, 100);
                                SetPlayerArmour(i, 0);
                                InfoMsg(i, "esta livre.");
                                // P0-PN-3: liberar la celda que tenia asignada
                                FreeJailCell(i);
                        }
                        else
                        {
                                // P0-PN-3: verificar distancia contra TODAS las celdas,
                                // no solo la original. Si el preso escapa de su celda,
                                // se lo teleporta de vuelta a SU celda asignada.
                                new bool:inAnyCell = false;
                                for(new c = 0; c < MAX_JAIL_CELLS; c++)
                                {
                                        if(IsPlayerInRangeOfPoint(i, 15.0, g_JailCells[c][0], g_JailCells[c][1], g_JailCells[c][2])) // FIX AUDIT: 50m -> 15m
                                        {
                                                inAnyCell = true;
                                                break;
                                        }
                                }
                                if(!inAnyCell)
                                {
                                        SetPlayerVirtualWorld(i, i);
                                        // Teleportar a la celda asignada, o a la 0 si no tiene
                                        new cellIdx = (g_PlayerCell[i] != -1) ? g_PlayerCell[i] : 0;
                                        SetPlayerPos(i, g_JailCells[cellIdx][0], g_JailCells[cellIdx][1], g_JailCells[cellIdx][2]);
                                        SetPlayerInterior(i, 5);
                                        TogglePlayerControllable(i, false);
                                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                                        InfoMsg(i, "Aun no has cumplido tu prision..");
                                }
                        }
                }
        }
        return 1;
}

CallBack::DiminuirTempo(Time)
{
                if(Time == 0)
                {
                        GameTextForAll("~r~CONTEOO !", 1000, 6);
                        ConteoIniciada = false;
                }
                else
                {
                        format(Str, sizeof(Str), "~g~%d", Time);
                        GameTextForAll(Str, 1000, 6);
                        SetTimerEx("DiminuirTempo", 1000, false, "i", Time - 1);
                }
                return 1;
}

CallBack::ProxDetector(Float:radi, playerid, string[],col1,col2,col3,col4,col5)
{
        if(IsPlayerConnected(playerid))
        {
                new Float:posx, Float:posy, Float:posz;
                new Float:oldposx, Float:oldposy, Float:oldposz;
                new Float:tempposx, Float:tempposy, Float:tempposz;
                GetPlayerPos(playerid, oldposx, oldposy, oldposz);
                // FIX AUDIT SPAM-H4+H5: cachear VW e Interior del emisor fuera del loop.
                // Antes: GetPlayerVirtualWorld se llamaba dentro del loop por cada iteracion
                // (2 natives x 300 jugadores = 600 natives por mensaje). Ademas, el else
                // branch (L13345) enviaba chat a jugadores en VW DISTINTO (fuga cross-dimensiones).
                // Y no se filtraba por Interior (fuga entre calle y hospital/interiores).
                // Ahora: cachear VW e Interior del emisor fuera del loop, y en el else branch
                // hacer continue (NO enviar a jugadores en VW distinto). Ademas agregar check
                // de Interior para que no se filtre chat entre interiores distintos.
                new senderVW = GetPlayerVirtualWorld(playerid);
                new senderInterior = GetPlayerInterior(playerid);
                // FIX CHAT-EMISOR: enviar el mensaje al propio emisor ANTES del loop.
                // El loop abajo tiene un check IsPlayerStreamedIn(playerid, i) que devuelve
                // false cuando i == playerid (un jugador no esta streamed-in para si mismo
                // en SA-MP). Sin este fix, el emisor nunca recibe su propio mensaje y piensa
                // que el chat no funciona. El emisor usa col1 (color del tier mas cercano).
                SendClientMessage(playerid, col1, string);
                foreach(new i: Player)
                {
                        if(i == playerid) continue; // FIX CHAT-EMISOR: ya enviado arriba
                        if(IsPlayerConnected(i))
                        {
                                // FIX AUDIT SPAM-MEJORA1: skip si no esta streamado (no visible al emisor).
                                // Antes: ProxDetector iteraba TODOS los 300 jugadores por cada mensaje,
                                // incluso los que estan en el otro lado del mapa y no pueden ver al emisor.
                                // Ahora: IsPlayerStreamedIn filtra antes de GetPlayerPos, reduciendo
                                // de ~300 iteraciones a ~30-100 (solo jugadores visibles).
                                if(!IsPlayerStreamedIn(playerid, i)) continue;
                                // FIX AUDIT SPAM-H4+H5: skip si VW o Interior distinto.
                                if(GetPlayerVirtualWorld(i) != senderVW) continue;
                                if(GetPlayerInterior(i) != senderInterior) continue;
                                GetPlayerPos(i, posx, posy, posz);
                                tempposx = (oldposx -posx);
                                tempposy = (oldposy -posy);
                                tempposz = (oldposz -posz);
                                // FIX AUDIT SPAM-H4: VW check ya hecho arriba con continue.
                                // El else branch original (L13345) que enviaba a VW distinto
                                // se elimina (era fuga cross-dimensiones).
                                // Verificar si estan en el mismo VW (codigo original preservado
                                // para compatibilidad, pero ahora siempre true porque el else
                                // ya no existe - el continue filtra antes).
                                new playerworld = senderVW;
                                new player2world = GetPlayerVirtualWorld(i);
                                if(playerworld == player2world)
                                {
                                        if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16)))
                                        {
                                                SendClientMessage(i, col1, string);
                                        }
                                        else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8)))
                                        {
                                                SendClientMessage(i, col2, string);
                                        }
                                        else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4)))
                                        {
                                                SendClientMessage(i, col3, string);
                                        }
                                        else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2)))
                                        {
                                                SendClientMessage(i, col4, string);
                                        }
                                        else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
                                        {
                                                SendClientMessage(i, col5, string);
                                        }
                                }
                                // FIX AUDIT SPAM-H4: else branch eliminado - antes enviaba
                                // chat a jugadores en VW distinto (fuga cross-dimensiones).
                                // Ahora: el continue en L13324 filtra antes de llegar aqui.
                        }
                }
        }
        return 1;
}

CallBack::Relogio()
{
        new minuto, hora, segundo;

        gettime(hora, minuto, segundo);

        switch(hora)
        {
                case 6:
                        { SetWorldTime(8); }
                case 9:
                        { SetWorldTime(10); }
                case 12:
                        { SetWorldTime(12); }
                case 13:
                        { SetWorldTime(15); }
                case 14:
                        { SetWorldTime(16); }
                case 15:
                        { SetWorldTime(18); }
                case 17:
                        { SetWorldTime(20); }
                case 18:
                        { SetWorldTime(21); }
                case 19:
                        { SetWorldTime(23); }
                case 23:
                        { SetWorldTime(0); }
                case 22:
                        { SetWorldTime(0); }
                case 0:
                        { SetWorldTime(3); }
                case 5:
                        { SetWorldTime(2); }
        }
        return 1;
}

