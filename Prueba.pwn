                                        TextoCasa[i] = CreateDynamic3DTextLabel(string, -1, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], 15.0);
                                        return 1;
                                }
                        }
                }
                else if(interior == 9) // Casa Level 9
                {
                        for(new i; i < MAX_CASAS; i++)
                        {
                                format(File, sizeof(File), PASTA_CASAS, i);
                                if(!DOF2_FileExists(File))
                                {
                                        new Float:X, Float:Y, Float:Z;
                                        GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
                                        DOF2_CreateFile(File);
                                        DOF2_SetString(File, "CasaDono", "ninguno");
                                        DOF2_SetString(File, "Casa Texto", "ninguno");
                                        DOF2_SetInt(File, "CasaId", i);
                                        DOF2_SetInt(File, "CasaAVenda", 1);
                                        DOF2_SetInt(File, "CasaPickup", 1273);
                                        DOF2_SetInt(File, "CasaMapIcon", 31);
                                        DOF2_SetInt(File, "CasaValor", valor);
                                        DOF2_SetInt(File, "CasaInterior", 5);

                                        DOF2_SetFloat(File, "CasaX", X);
                                        DOF2_SetFloat(File, "CasaY", Y);
                                        DOF2_SetFloat(File, "CasaZ", Z);

                                        DOF2_SetFloat(File, "CasaInteriorX", 140.3679);
                                        DOF2_SetFloat(File, "CasaInteriorY", 1367.8837);
                                        DOF2_SetFloat(File, "CasaInteriorZ", 1083.8621);
                                        DOF2_SaveFile();

                                        CasaInfo[i][CasaId] = DOF2_GetInt(File, "CasaId");
                                        CasaInfo[i][CasaAVenda] = DOF2_GetInt(File, "CasaAVenda");
                                        CasaInfo[i][CasaPickup] = DOF2_GetInt(File, "CasaPickup");
                                        CasaInfo[i][CasaMapIcon] = DOF2_GetInt(File, "CasaMapIcon");
                                        CasaInfo[i][CasaValor] = DOF2_GetInt(File, "CasaValor");
                                        CasaInfo[i][CasaInterior] = DOF2_GetInt(File, "CasaInterior");

                                        CasaInfo[i][CasaX] = DOF2_GetFloat(File, "CasaX");
                                        CasaInfo[i][CasaY] = DOF2_GetFloat(File, "CasaY");
                                        CasaInfo[i][CasaZ] = DOF2_GetFloat(File, "CasaZ");

                                        CasaInfo[i][CasaInteriorX] = DOF2_GetFloat(File, "CasaInteriorX");
                                        CasaInfo[i][CasaInteriorY] = DOF2_GetFloat(File, "CasaInteriorY");
                                        CasaInfo[i][CasaInteriorZ] = DOF2_GetFloat(File, "CasaInteriorZ");

                                        format(CasaInfo[i][CasaDono], 30, "%s", DOF2_GetString(File, "CasaDono")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                        format(CasaInfo[i][CasaTexto], 64, "%s", DOF2_GetString(File, "CasaTexto")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco

                                        PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
                                        MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                                        new string[1500]; // FIX AUDIT3 MS-05: reducido de 5000 a 1500
                                        format(string, sizeof(string), "{FFFFFF}Propietario: {FFFF00}%s\n{FFFFFF}Numero: {FFFF00}%d\nValor: {FFFF00}%s\n{FFFFFF}Presiona '{FFFF00}Y{FFFFFF}' para entrar.", CasaInfo[i][CasaDono], CasaInfo[i][CasaId], ConvertMoney(CasaInfo[i][CasaValor]));
                                        TextoCasa[i] = CreateDynamic3DTextLabel(string, -1, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], 15.0);
                                        return 1;
                                }
                        }
                }
                else if(interior == 10) // Casa Level 10
                {
                        for(new i; i < MAX_CASAS; i++)
                        {
                                format(File, sizeof(File), PASTA_CASAS, i);
                                if(!DOF2_FileExists(File))
                                {
                                        new Float:X, Float:Y, Float:Z;
                                        GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
                                        DOF2_CreateFile(File);
                                        DOF2_SetString(File, "CasaDono", "ninguno");
                                        DOF2_SetString(File, "Casa Texto", "ninguno");
                                        DOF2_SetInt(File, "CasaId", i);
                                        DOF2_SetInt(File, "CasaAVenda", 1);
                                        DOF2_SetInt(File, "CasaPickup", 1273);
                                        DOF2_SetInt(File, "CasaMapIcon", 31);
                                        DOF2_SetInt(File, "CasaValor", valor);
                                        DOF2_SetInt(File, "CasaInterior", 5);

                                        DOF2_SetFloat(File, "CasaX", X);
                                        DOF2_SetFloat(File, "CasaY", Y);
                                        DOF2_SetFloat(File, "CasaZ", Z);

                                        DOF2_SetFloat(File, "CasaInteriorX", 1267.8407);
                                        DOF2_SetFloat(File, "CasaInteriorY", -776.9587);
                                        DOF2_SetFloat(File, "CasaInteriorZ", 1091.9063);
                                        DOF2_SaveFile();

                                        CasaInfo[i][CasaId] = DOF2_GetInt(File, "CasaId");
                                        CasaInfo[i][CasaAVenda] = DOF2_GetInt(File, "CasaAVenda");
                                        CasaInfo[i][CasaPickup] = DOF2_GetInt(File, "CasaPickup");
                                        CasaInfo[i][CasaMapIcon] = DOF2_GetInt(File, "CasaMapIcon");
                                        CasaInfo[i][CasaValor] = DOF2_GetInt(File, "CasaValor");
                                        CasaInfo[i][CasaInterior] = DOF2_GetInt(File, "CasaInterior");

                                        CasaInfo[i][CasaX] = DOF2_GetFloat(File, "CasaX");
                                        CasaInfo[i][CasaY] = DOF2_GetFloat(File, "CasaY");
                                        CasaInfo[i][CasaZ] = DOF2_GetFloat(File, "CasaZ");

                                        CasaInfo[i][CasaInteriorX] = DOF2_GetFloat(File, "CasaInteriorX");
                                        CasaInfo[i][CasaInteriorY] = DOF2_GetFloat(File, "CasaInteriorY");
                                        CasaInfo[i][CasaInteriorZ] = DOF2_GetFloat(File, "CasaInteriorZ");

                                        format(CasaInfo[i][CasaDono], 30, "%s", DOF2_GetString(File, "CasaDono")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                        format(CasaInfo[i][CasaTexto], 64, "%s", DOF2_GetString(File, "CasaTexto")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco

                                        PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
                                        MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                                        new string[1500]; // FIX AUDIT3 MS-05: reducido de 5000 a 1500
                                        format(string, sizeof(string), "{FFFFFF}Propietario: {FFFF00}%s\n{FFFFFF}Numero: {FFFF00}%d\nValor: {FFFF00}%s\n{FFFFFF}Presiona '{FFFF00}Y{FFFFFF}' para entrar.", CasaInfo[i][CasaDono], CasaInfo[i][CasaId], ConvertMoney(CasaInfo[i][CasaValor]));
                                        TextoCasa[i] = CreateDynamic3DTextLabel(string, -1, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], 15.0);
                                        return 1;
                                }
                        }
                }
        }
        return 1;
}

CMD:dcasa(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        {
                new id, AccountCA[5000], mensagem[128];
                if(sscanf(params, "i", id)) return ErrorMsg(playerid, "Use: /dcasa [ID da casa].");
                {
                        if(IsPlayerInRangeOfPoint(playerid, 2.0, CasaInfo[id][CasaX], CasaInfo[id][CasaY], CasaInfo[id][CasaZ]))
                        {
                                format(AccountCA, sizeof(AccountCA), PASTA_CASAS, id);
                                if(DOF2_FileExists(AccountCA))
                                {
                                        DOF2_RemoveFile(AccountCA);
                                        format(mensagem, sizeof(mensagem), "deleto casa id: %d.", id);
                                        SuccesMsg(playerid, mensagem);
                                        DestroyDynamicPickup(PickupCasa[id]);
                                        DestroyDynamicMapIcon(MapIconCasa[id]);
                                        DestroyDynamic3DTextLabel(TextoCasa[id]);
                                        CasaInfo[id][CasaX] = 0;
                                        CasaInfo[id][CasaY] = 0;
                                        CasaInfo[id][CasaZ] = 0;
                                        CasaInfo[id][CasaInteriorX] = 0;
                                        CasaInfo[id][CasaInteriorY] = 0;
                                        CasaInfo[id][CasaInteriorZ] = 0;
                                        return 1;
                                }
                                else
                                {
                                        format(mensagem, sizeof(mensagem), "Casa [%d] no existente.", id);
                                        ErrorMsg(playerid, mensagem);
                                }
                        }
                        else
                        {
                                format(mensagem, sizeof(mensagem), "No estas cerca de la casa ID: %d.", id);
                                ErrorMsg(playerid, mensagem);
                        }
                }
        }
        return 1;
}

CMD:vendercasa(playerid, params[])
{
        new File[255];
        for(new i = 0; i < MAX_CASAS; i++)
        {
                if(IsPlayerInRangeOfPoint(playerid, 10.0, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]))
                {
                        format(File, sizeof(File), PASTA_CASAS, i);
                        if(strcmp(DOF2_GetString(File, "CasaDono"), Name(playerid), false))
                        {
                                ErrorMsg(playerid, "Esta casa no es tuya.");
                                return 1;
                        }
                        else if(CasaInfo[i][CasaAVenda] == 1)
                        {
                                ErrorMsg(playerid, "Tu casa ya esta en venta");
                                return 1;
                        }
                        else
                        {
                                if(IsPlayerConnected(playerid))
                                {
                                        PlayerInfo[playerid][Casa] = -1;
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        // (venta critica de casa).
                                        AC_AddPlayerMoney(playerid, CasaInfo[i][CasaValor]);
                                        // FIX AUDIT2 AGENT2 M-02: SalvarDados inmediato. La casa
                                        // se persiste via DOF2_SaveFile abajo. Si crash antes del
                                        // SaveTimer, sin SalvarDados el vendedor pierde la casa (en
                                        // disco queda 'en venta' sin dueno) sin recibir el dinero.
                                        SalvarDados(playerid);

                                        DOF2_SetString(File, "CasaDono", "ninguno");
                                        DOF2_SetInt(File, "CasaAVenda", 1);
                                        DOF2_SetInt(File, "CasaPickup", 1273);
                                        DOF2_SetInt(File, "CasaMapIcon", 31);
                                        DOF2_SaveFile();

                                        format(CasaInfo[i][CasaDono], 30, "%s", DOF2_GetString(File, "CasaDono")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                        CasaInfo[i][CasaAVenda] = DOF2_GetInt(File, "CasaAVenda");
                                        CasaInfo[i][CasaPickup] = DOF2_GetInt(File, "CasaPickup");
                                        CasaInfo[i][CasaMapIcon] = DOF2_GetInt(File, "CasaMapIcon");

                                        DestroyDynamicPickup(PickupCasa[i]);
                                        DestroyDynamicMapIcon(MapIconCasa[i]);

                                        PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
                                        MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                                        return 1;
                                }
                        }
                }
        }
        return 1;
}

CMD:menuanim(playerid)
{
        // FIX AUDIT ANIM ANIM-A1-03/A2-01/A3-03/A4-20 (CRITICO): validaciones de estado.
        // ANTES: /menuanim no validaba nada. Un algemado podia sobrescribir
        // SPECIAL_ACTION_CUFFED con HANDSUP. Un herido (1M HP) podia cancelar
        // CRCKIDLE4 y caminar invulnerable. Un espectador podia animarse.
        // AHORA: bloquear en estados no validos.
        if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMsg(playerid, "No puedes usar animaciones ahora.");
        if(IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "Sal del vehiculo para usar animaciones.");
        if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "No puedes usar animaciones estando algemado.");
        if(MinutosMorte[playerid] > 0) return ErrorMsg(playerid, "No puedes usar animaciones estando herido.");
        if(g_DormindoODescansando[playerid]) return ErrorMsg(playerid, "Ya estas en una animacion larga (/dormir o /descansar).");
        ShowPlayerDialog(playerid, DIALOG_MENUANIM, DIALOG_STYLE_LIST, "Menu Anim", "{FFFF00}-{FFFFFF} Maos para cima\n{FFFF00}+{FFFFFF} Sentar-se\n{FFFF00}+{FFFFFF} Deitar-se\n{FFFF00}+{FFFFFF} Apontar\n{FFFF00}+{FFFFFF} Abaixar\n{FFFF00}+{FFFFFF} Bracos Cruzados\n{FFFF00}+{FFFFFF} Parar animacoes", "Seleccionar", "X");
        return 1;
}

CMD:criarradar(playerid, params[])
{
        new Account[255];
        if(PlayerInfo[playerid][pAdmin] >= 6)
        {
                new Velocidad, MultaMin, MultaMax, Float:RadarX, Float:RadarY, Float:RadarZ, Float:RadarRZ;
                if(sscanf(params, "iii", Velocidad, MultaMin, MultaMax))
                {
                        return ErrorMsg(playerid, "Use: /criarradar [Velocidad] [MultaMin] [MultaMax]");
                }
                else if(Velocidad <= 0 || Velocidad > 150)
                {
                        return ErrorMsg(playerid, "Usa una Velocidad de 1Km a 150Km.");
                }
                else if(MultaMin < 0 || MultaMax < 0 || MultaMin > MultaMax)
                {
                        return ErrorMsg(playerid, "La multa minima no puede ser mayor que la maxima.");
                }
                else
                {
                        for(new i; i < MAX_RADAR; i++)
                        {
                                format(Account, sizeof(Account), PASTA_RADAR, i);
                                if(!DOF2_FileExists(Account))
                                {
                                        GetPlayerPos(playerid, Float:RadarX, Float:RadarY, Float:RadarZ);
                                        GetPlayerFacingAngle(playerid, Float:RadarRZ);

                                        DOF2_CreateFile(Account);
                                        DOF2_SetInt(Account, "RadarID", i);
                                        DOF2_SetInt(Account, "RadarVelocidad", Velocidad);
                                        DOF2_SetInt(Account, "RadarMultaMin", MultaMin);
                                        DOF2_SetInt(Account, "RadarMultaMax", MultaMax);

                                        DOF2_SetFloat(Account, "RadarPosX", RadarX);
                                        DOF2_SetFloat(Account, "RadarPosY", RadarY);
                                        DOF2_SetFloat(Account, "RadarPosZ", RadarZ);
                                        DOF2_SetFloat(Account, "RadarPosR", RadarRZ);
                                        DOF2_SaveFile();

                                        RadarInfo[i][RadarID] = DOF2_GetInt(Account, "RadarID");
                                        RadarInfo[i][RadarVelocidad] = DOF2_GetInt(Account, "RadarVelocidad");
                                        RadarInfo[i][RadarMultaMin] = DOF2_GetInt(Account, "RadarMultaMin");
                                        RadarInfo[i][RadarMultaMax] = DOF2_GetInt(Account, "RadarMultaMax");

                                        RadarInfo[i][RadarPosX] = DOF2_GetFloat(Account, "RadarPosX");
                                        RadarInfo[i][RadarPosY] = DOF2_GetFloat(Account, "RadarPosY");
                                        RadarInfo[i][RadarPosZ] = DOF2_GetFloat(Account, "RadarPosZ");
                                        RadarInfo[i][RadarPosR] = DOF2_GetFloat(Account, "RadarPosR");

                                        ObjetoRadar[i] = CreateDynamicObject(18880, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]-1.5, 0.0, 0.0, RadarInfo[i][RadarPosR]);
                                        ObjetoRadar2[i] = CreateDynamicObject(18880, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]-1.5, 0.0, 0.0, RadarInfo[i][RadarPosR] + 180.0);

                                        SetPlayerPos(playerid, RadarX + 1, RadarY + 1, RadarZ + 1);

                                        new string[1500]; // FIX AUDIT3 MS-05: reducido de 5000 a 1500
                                        format(string, sizeof(string), "{FFFFFF}Radar de Velocidad\nID: [{00FF00}%d{FFFFFF}]\nVelocidad Maxima: [{FF2400}%d KM/H{FFFFFF}]\nMulta: [{FFFF00}$%d - $%d{FFFFFF}]", RadarInfo[i][RadarID], RadarInfo[i][RadarVelocidad], RadarInfo[i][RadarMultaMin], RadarInfo[i][RadarMultaMax]);
                                        TextoRadar[i] = CreateDynamic3DTextLabel(string, -1, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]+4, 50.0);

                                        format(string, sizeof(string), "Radar %d com Velocidad de %d KM/H criado com exito! Multa: $%d - $%d", RadarInfo[i][RadarID], RadarInfo[i][RadarVelocidad], RadarInfo[i][RadarMultaMin], RadarInfo[i][RadarMultaMax]);
                                        SuccesMsg(playerid, string);
                                        return 1;
                                }
                        }
                }
        }
        else
        {
                return ErrorMsg(playerid, "No tienes permisos.");
        }
        return 1;
}

CMD:dradar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] >= 6)
        {
                new id, arq1[50], mensagem[128];
                if(sscanf(params, "i", id)) return ErrorMsg(playerid,  "Use: /dradar [ID do Radar].");
                format(arq1, sizeof(arq1), PASTA_RADAR, id);
                if(DOF2_FileExists(arq1))
                {
                        format(mensagem, sizeof(mensagem), "Eliminaste el radar ID %d.", id);
                        SuccesMsg(playerid, mensagem);
                        DestroyDynamicObject(ObjetoRadar[id]);
                        DestroyDynamicObject(ObjetoRadar2[id]);
                        DestroyDynamic3DTextLabel(TextoRadar[id]);
                        for(new a = 0; a < MAX_PLAYERS; a++)
                        {
                                if(_:RadarMapIcon[a][id] != -1)
                                {
                                        DestroyDynamicMapIcon(RadarMapIcon[a][id]);
                                        RadarMapIcon[a][id] = STREAMER_TAG_MAP_ICON:-1;
                                }
                        }
                        RadarInfo[id][RadarPosX] = 0;
                        RadarInfo[id][RadarPosY] = 0;
                        RadarInfo[id][RadarPosZ] = 0;
                        RadarInfo[id][RadarPosR] = 0;
                        RadarInfo[id][RadarVelocidad] = 999;
                        RadarInfo[id][RadarMultaMin] = 0;
                        RadarInfo[id][RadarMultaMax] = 0;
                        DOF2_RemoveFile(arq1);
                        return 1;
                }
                else
                {
                        format(mensagem, sizeof(mensagem), "El radar %d no existe en los archivos del servidor.", id);
                        ErrorMsg(playerid, mensagem);
                }
        }
        else
        {
                ErrorMsg(playerid, "No tienes permisos.");
        }
        return 1;
}

// ==========================================
// COMANDO: /EDITARRADARVEL (editar velocidad y multas sin recrear el radar)
// ==========================================
CMD:editarradarvel(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");

        new id, Velocidad, MultaMin, MultaMax, arq1[50];
        if(sscanf(params, "iiii", id, Velocidad, MultaMin, MultaMax))
        {
                return ErrorMsg(playerid, "Use: /editarradarvel [ID] [Velocidad] [MultaMin] [MultaMax]");
        }

        format(arq1, sizeof(arq1), PASTA_RADAR, id);
        if(!DOF2_FileExists(arq1)) return ErrorMsg(playerid, "Ese radar no existe.");

        if(Velocidad <= 0 || Velocidad > 150)
        {
                return ErrorMsg(playerid, "Usa una Velocidad de 1Km a 150Km.");
        }
        if(MultaMin < 0 || MultaMax < 0 || MultaMin > MultaMax)
        {
                return ErrorMsg(playerid, "La multa minima no puede ser mayor que la maxima.");
        }

        RadarInfo[id][RadarVelocidad] = Velocidad;
        RadarInfo[id][RadarMultaMin] = MultaMin;
        RadarInfo[id][RadarMultaMax] = MultaMax;

        DOF2_SetInt(arq1, "RadarVelocidad", Velocidad);
        DOF2_SetInt(arq1, "RadarMultaMin", MultaMin);
        DOF2_SetInt(arq1, "RadarMultaMax", MultaMax);
        DOF2_SaveFile();

        // Recrea el texto 3D para reflejar los nuevos valores (no se puede editar el texto en vivo)
        new string[1500]; // FIX AUDIT3 MS-05: reducido de 5000 a 1500
        DestroyDynamic3DTextLabel(TextoRadar[id]);
        format(string, sizeof(string), "{FFFFFF}RADAR ID:{00FF00}%d{FFFFFF}\nVelocidad Maxima: {FF2400}%d KM/H{FFFFFF}\nMulta: {FFFF00}$%d - $%d{FFFFFF}", RadarInfo[id][RadarID], RadarInfo[id][RadarVelocidad], RadarInfo[id][RadarMultaMin], RadarInfo[id][RadarMultaMax]);
        TextoRadar[id] = CreateDynamic3DTextLabel(string, -1, RadarInfo[id][RadarPosX], RadarInfo[id][RadarPosY], RadarInfo[id][RadarPosZ]+4, 50.0);

        new mensagem[160];
        format(mensagem, sizeof(mensagem), "Radar %d actualizado: %d KM/H, Multa $%d - $%d.", id, Velocidad, MultaMin, MultaMax);
        SuccesMsg(playerid, mensagem);
        return 1;
}

// ==========================================
// COMANDO: /RADARMAPA (toggle icono minimapa - solo admins)
// ==========================================
CMD:radarmapa(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");

        if(RadarMapVisible[playerid])
        {
                Radar_HideAdminMap(playerid);
                SuccesMsg(playerid, "Iconos de radares ocultados del minimapa.");
        }
        else
        {
                Radar_ShowAdminMap(playerid);
                SuccesMsg(playerid, "Iconos de radares mostrados en el minimapa (solo tu los ves).");
        }
        return 1;
}

// ==========================================
// COMANDO: /RADARPANEL (panel admin)
// ==========================================
CMD:radarpanel(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");

        new str[700];
        format(str, sizeof(str),
                "{FFFFFF}RADAR PANEL ADMIN\n\n"\
                "{00FF00}/criarradar{FFFFFF} [Velocidad] [MultaMin] [MultaMax]\n"\
                "{00FF00}/dradar{FFFFFF} [ID] - Elimina un radar\n"\
                "{00FF00}/editarradar{FFFFFF} [ID] - Mover/girar/subir-bajar con el mouse\n"\
                "{00FF00}/editarradarvel{FFFFFF} [ID] [Vel] [MultaMin] [MultaMax]\n"\
                "{00FF00}/radarmapa{FFFFFF} - Muestra/oculta radares en tu minimapa\n"\
                "{00FF00}/radarlogs{FFFFFF} - Ver historial de multas recientes\n"\
                "\n{FFFF00}Radares cargados: %d", IniciarRadares
        );
        ShowPlayerDialog(playerid, 9991, DIALOG_STYLE_MSGBOX, "Radar Panel Admin", str, "OK", "");
        return 1;
}

// ==========================================
// COMANDO: /RADARLOGS (historial de multas - admin)
// ==========================================
// ==========================================
// COMANDO: /EDITARRADAR (mover/girar/subir-bajar con el mouse)
// ==========================================
CMD:editarradar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");

        new id, arq1[50];
        if(sscanf(params, "i", id)) return ErrorMsg(playerid, "Use: /editarradar [ID del Radar]");
        format(arq1, sizeof(arq1), PASTA_RADAR, id);
        if(!DOF2_FileExists(arq1)) return ErrorMsg(playerid, "Ese radar no existe.");

        EditandoRadar[playerid] = id;
        EditDynamicObject(playerid, ObjetoRadar[id]);

        SendClientMessage(playerid, -1, "{FFFF00}[RADAR] Modo edicion activado.");
        SendClientMessage(playerid, -1, "{FFFFFF}Usa el mouse para mover/subir-bajar/girar el radar.");
        SendClientMessage(playerid, -1, "{FFFFFF}Click izquierdo: mover | Ctrl: subir/bajar | Shift: girar | ESC: cancelar.");
        return 1;
}

// ==========================================
// COMANDO: /EDITARMAPA (editar con el mouse cualquier objeto
// de mapeo suelto, ej. los del archivo mapserver.inc)
// ==========================================
CMD:editarmapa(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);

        new nearbyObjs[50];
        new total = Streamer_GetNearbyItems(px, py, pz, STREAMER_TYPE_OBJECT, nearbyObjs, sizeof(nearbyObjs), 8.0);

        if(total <= 0)
        {
                return ErrorMsg(playerid, "No hay ningun objeto de mapeo cerca de ti (acercate mas, radio 8 metros).");
        }

        new objectid = -1, Float:bestdist = 999999.0, Float:dist;
        for(new i = 0; i < total; i++)
        {
                if(Streamer_GetDistanceToItem(px, py, pz, STREAMER_TYPE_OBJECT, nearbyObjs[i], dist))
                {
                        if(dist < bestdist)
                        {
                                bestdist = dist;
                                objectid = nearbyObjs[i];
                        }
                }
        }

        if(objectid == -1 || !IsValidDynamicObject(objectid))
        {
                return ErrorMsg(playerid, "No se pudo identificar ningun objeto valido cerca de ti.");
        }

        EditandoMapaObj[playerid] = objectid;
        EditDynamicObject(playerid, objectid);

        new Float:ox, Float:oy, Float:oz, Float:orx, Float:ory, Float:orz, modelid;
        modelid = Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID);
        GetDynamicObjectPos(objectid, ox, oy, oz);
        GetDynamicObjectRot(objectid, orx, ory, orz);

        SendClientMessage(playerid, -1, "{FFFF00}[MAPA] Modo edicion activado sobre el objeto mas cercano.");
        new str[200];
        format(str, sizeof(str), "{FFFFFF}ObjectID: {00FF00}%d{FFFFFF} | Model: {00FF00}%d{FFFFFF} | Pos actual: {00FFFF}%.4f, %.4f, %.4f", objectid, modelid, ox, oy, oz);
        SendClientMessage(playerid, -1, str);
        SendClientMessage(playerid, -1, "{FFFFFF}Click izquierdo: mover | Ctrl: subir/bajar | Shift: girar | ESC: cancelar.");
        SendClientMessage(playerid, -1, "{FFFFFF}Al terminar (clic derecho o Enter), te mostrare las coordenadas finales en el chat.");
        return 1;
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
        // --- Manejo del comando /editarcofre (cofre de banda) ---
        if(GetPVarInt(playerid, "EditandoCofreFlag") == 1)
        {
                new cofreEditId = GetPVarInt(playerid, "EditandoCofreID");
                if(cofreEditId >= 0 && cofreEditId < MAX_ORGS)
                {
                        if(response == EDIT_RESPONSE_FINAL)
                        {
                                if(IsValidDynamicObject(ObjetoCofre[cofreEditId]))
                                {
                                        SetDynamicObjectPos(ObjetoCofre[cofreEditId], x, y, z);
                                        SetDynamicObjectRot(ObjetoCofre[cofreEditId], rx, ry, rz);
                                        CofreInfo[cofreEditId][CofrePosX] = x;
                                        CofreInfo[cofreEditId][CofrePosY] = y;
                                        CofreInfo[cofreEditId][CofrePosZ] = z;
                                        CofreInfo[cofreEditId][CofrePosR] = rz;
                                        if(IsValidDynamic3DTextLabel(TextoCofreOrg[cofreEditId]))
                                                DestroyDynamic3DTextLabel(TextoCofreOrg[cofreEditId]);
                                        new string[180];
                                        format(string, sizeof(string), "{BEBEBE}ID Cofre: %d\nPresiona {FF2400}H\n{BEBEBE}Para Abrir el Menu del Cofre", CofreInfo[cofreEditId][CofreID]);
                                        TextoCofreOrg[cofreEditId] = CreateDynamic3DTextLabel(string, -1, x, y, z, 25.0);
                                        SalvarCofreF(cofreEditId);
                                        new logMsg[160], pName[24];
                                        GetPlayerName(playerid, pName, sizeof(pName));
                                        format(logMsg, sizeof(logMsg), "Admin %s (ID:%d) edito cofre de org %d a (%.2f, %.2f, %.2f, rot %.2f)", pName, playerid, cofreEditId, x, y, z, rz);
                                        Log("Logs/AdminAcciones.ini", logMsg);
                                        SuccesMsg(playerid, "Cofre editado y guardado correctamente.");
                                }
                                // FIX AUDIT: solo limpiar PVars en FINAL (no en UPDATE)
                                DeletePVar(playerid, "EditandoCofreID");
                                DeletePVar(playerid, "EditandoCofreFlag");
                        }
                        else if(response == EDIT_RESPONSE_CANCEL)
                        {
                                ErrorMsg(playerid, "Edicion cancelada. La posicion del cofre no se modifico.");
                                // FIX AUDIT: solo limpiar PVars en CANCEL
                                DeletePVar(playerid, "EditandoCofreID");
                                DeletePVar(playerid, "EditandoCofreFlag");
                        }
                        // EDIT_RESPONSE_UPDATE: no hacer nada (el admin sigue editando)
                }
                return 1;
        }

        // --- Manejo del comando /editarmapa (objetos sueltos de mapeo) ---
        if(EditandoMapaObj[playerid] != -1)
        {
                if(response == EDIT_RESPONSE_CANCEL)
                {
                        EditandoMapaObj[playerid] = -1;
                        SendClientMessage(playerid, -1, "{FF0000}[MAPA] Edicion cancelada, no se guardo nada.");
                        return 1;
                }

                if(response == EDIT_RESPONSE_FINAL)
                {
                        new modelid = Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID);
                        EditandoMapaObj[playerid] = -1;

                        SendClientMessage(playerid, -1, "{00FF00}[MAPA] Posicion final (copia esto y pasaselo a quien edite mapserver.inc):");
                        new str[200];
                        format(str, sizeof(str), "{FFFFFF}CreateDynamicObject(%d,%.7f,%.7f,%.7f,%.7f,%.7f,%.7f);", modelid, x, y, z, rx, ry, rz);
                        SendClientMessage(playerid, -1, str);
                }
                return 1;
        }

        // --- Manejo del sistema de radares (ya existente) ---
        new id = EditandoRadar[playerid];
        if(id == -1) return 1; // no esta editando ningun radar

        if(response == EDIT_RESPONSE_CANCEL)
        {
                EditandoRadar[playerid] = -1;
                SendClientMessage(playerid, -1, "{FF0000}[RADAR] Edicion cancelada, no se guardaron cambios.");
                return 1;
        }

        if(response == EDIT_RESPONSE_FINAL || response == EDIT_RESPONSE_UPDATE)
        {
                // Actualiza posicion en vivo del segundo objeto (lado opuesto) mientras edita
                SetDynamicObjectPos(ObjetoRadar2[id], x, y, z);
                SetDynamicObjectRot(ObjetoRadar2[id], rx, ry, rz + 180.0);

                if(response == EDIT_RESPONSE_FINAL)
                {
                        new arq1[50], string[5000];
                        format(arq1, sizeof(arq1), PASTA_RADAR, id);

                        RadarInfo[id][RadarPosX] = x;
                        RadarInfo[id][RadarPosY] = y;
                        RadarInfo[id][RadarPosZ] = z;
                        RadarInfo[id][RadarPosR] = rz;

                        DOF2_SetFloat(arq1, "RadarPosX", x);
                        DOF2_SetFloat(arq1, "RadarPosY", y);
                        DOF2_SetFloat(arq1, "RadarPosZ", z);
                        DOF2_SetFloat(arq1, "RadarPosR", rz);
                        DOF2_SaveFile();

                        // Recrea el texto 3D en la nueva posicion (no se puede reposicionar directamente)
                        DestroyDynamic3DTextLabel(TextoRadar[id]);
                        format(string, sizeof(string), "{FFFFFF}RADAR ID:{00FF00}%d{FFFFFF}\nVelocidad Maxima: {FF2400}%d KM/H{FFFFFF}\nMulta: {FFFF00}$%d - $%d{FFFFFF}", RadarInfo[id][RadarID], RadarInfo[id][RadarVelocidad], RadarInfo[id][RadarMultaMin], RadarInfo[id][RadarMultaMax]);
                        TextoRadar[id] = CreateDynamic3DTextLabel(string, -1, x, y, z+4, 50.0);

                        EditandoRadar[playerid] = -1;
                        SendClientMessage(playerid, -1, "{00FF00}[RADAR] Posicion guardada correctamente.");
                }
        }
        return 1;
}

CMD:radarlogs(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");

        new str[1500], rname[MAX_PLAYER_NAME], count = 0;
        new total = (LogIndex < 20) ? LogIndex : 20; // muestra solo las ultimas 20 para no desbordar el dialogo

        if(LogIndex == 0)
        {
                ShowPlayerDialog(playerid, 9992, DIALOG_STYLE_MSGBOX, "Radar Logs", "{FFFFFF}Aun no hay multas registradas.", "OK", "");
                return 1;
        }

        for(new i = LogIndex - 1; i >= 0 && count < total; i--)
        {
                if(IsPlayerConnected(RadarLogs[i][LogPlayer]))
                        GetPlayerName(RadarLogs[i][LogPlayer], rname, sizeof(rname));
                else
                        format(rname, sizeof(rname), "ID:%d", RadarLogs[i][LogPlayer]);

                format(str, sizeof(str), "%s{FFFFFF}%s {FFFF00}| Radar %d {FFFFFF}| %d km/h {FF2400}| -$%d\n",
                        str, rname, RadarLogs[i][LogRadarID], RadarLogs[i][LogSpeed], RadarLogs[i][LogMulta]);
                count++;
        }
        ShowPlayerDialog(playerid, 9992, DIALOG_STYLE_MSGBOX, "Radar Logs (ultimas multas)", str, "OK", "");
        return 1;
}

CMD:remolcar(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMsg(playerid, "No estas en un vehiculo!");
        new vehicleid = GetPlayerVehicleID(playerid);
        if(IsTrailerAttachedToVehicle(vehicleid))
        {
                DetachTrailerFromVehicle(vehicleid);
                return 1;
        }
        new Float:x, Float:y, Float:z;
        new Float:dist, Float:closedist=8, closeveh;
        for(new i=1; i < MAX_VEHICLES; i++)
        {
                if(i != vehicleid && GetVehiclePos(i, x, y, z))
                {
                        dist = GetPlayerDistanceFromPoint(playerid, x, y, z);
                        if(dist < closedist)
                        {
                                closedist = dist;
                                closeveh = i;
                        }
                }
        }
        if(!closeveh) return ErrorMsg(playerid, "No estas cerca de un vehiculo!");
        AttachTrailerToVehicle(closeveh, vehicleid);
        return 1;
}

CMD:ejetar(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMsg(playerid, "No estas en un vehiculo!");
        new pid, msg[128];
        if(sscanf(params, "d", pid)) return ErrorMsg(playerid,  "USAGE: /ejetar [player]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == pid)
                        {
                                new vehicleid = GetPlayerVehicleID(playerid);
                                if(!IsPlayerInVehicle(i, vehicleid)) return ErrorMsg(playerid, "El jugador no esta en su vehiculo!.");
                                RemovePlayerFromVehicle(i);
                                format(msg, sizeof(msg), "El conductor del vehiculo %04d (%d) te expulso del vehiculo.", GetPlayerIdfixo(playerid), playerid);
                                InfoMsg(i, msg);
                        }
                }
        }

        return 1;
}

CMD:ejetarll(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMsg(playerid, "No estas conduciendo un vehiculo!");
        new vehicleid = GetPlayerVehicleID(playerid);
        new msg[128];
        format(msg, sizeof(msg), "El conductor del vehiculo %04d (%d) te expulso del vehiculo.", GetPlayerIdfixo(playerid), playerid);
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && i != playerid && IsPlayerInVehicle(i, vehicleid))
                {
                        RemovePlayerFromVehicle(i);
                        InfoMsg(playerid, msg);
                }
        }
        SuccesMsg(playerid, "Expulsaste a todos los pasajeros.");
        return 1;
}

CMD:limparmods(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMsg(playerid, "No estas en un vehiculo!");
        new vehicleid = GetPlayerVehicleID(playerid);
        new id = GetVehicleID(vehicleid);
        if(GetPlayerVehicleAccess(playerid, id) < 2)
                return ErrorMsg(playerid, "Este no es tu vehiculo!");
        for(new i=0; i < sizeof(VehicleMods[]); i++)
        {
                RemoveVehicleComponent(VehicleID[id], GetVehicleComponentInSlot(VehicleID[id], i));
                VehicleMods[id][i] = 0;
        }
        VehiclePaintjob[id] = 255;
        ChangeVehiclePaintjob(VehicleID[id], 255);
        SaveVehicle(id);
        SuccesMsg(playerid, "Eliminaste todos los mods de tu vehiculo.");
        return 1;
}

CMD:localizarv(playerid, params[])
{
        if(TrackCar[playerid])
        {
                TrackCar[playerid] = 0;
                DisablePlayerCheckpoint(playerid);
                SuccesMsg(playerid, "Ya no estas rastreando tu vehiculo.");
                return 1;
        }
        new playername[24];
        GetPlayerName(playerid, playername, sizeof(playername));
        new info[256], bool:found;
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] == VEHICLE_PLAYER && strcmp(VehicleOwner[i], playername) == 0)
                {
                        found = true;
                        format(info, sizeof(info), "{FFFF00}%s{FFFFFF}ID: {FFFF00}%d  {FFFFFF}Name: {FFFF00}%s\n", info, i, VehicleNames[VehicleModel[i]-400]);
                }
        }
        if(!found) return ErrorMsg(playerid, "No tienes ningun vehiculo!");
        ShowPlayerDialog(playerid, DIALOG_FINDVEHICLE, DIALOG_STYLE_LIST, "Localizando tu vehiculo", info, "Encontrar", "X");
        return 1;
}

CMD:mv(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMsg(playerid, "No estas en un vehiculo!");
        new vehicleid = GetPlayerVehicleID(playerid);
        if(IsBicycle(vehicleid)) return ErrorMsg(playerid, "No estas en un vehiculo!");
        new id = GetVehicleID(vehicleid);
        if(GetPlayerVehicleAccess(playerid, id) < 1)
                return ErrorMsg(playerid, "No tienes la llave de este vehiculo!");
        SetPVarInt(playerid, "DialogValue1", id);
        ShowDialog(playerid, DIALOG_VEHICLE);
        return 1;
}

// ==========================================================================
// FIX MEJORA-VEH-1: /misvehiculos - Listar vehiculos personales del jugador.
// Muestra un dialog con todos los vehiculos del jugador (ID, modelo, posicion).
// Usa el dialog DIALOG_FINDVEHICLE existente para reutilizar la opcion de localizar.
// ==========================================================================
CMD:misvehiculos(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        new playername[24];
        GetPlayerName(playerid, playername, sizeof(playername));
        new info[768], bool:found;
        new count = 0;
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] == VEHICLE_PLAYER && strcmp(VehicleOwner[i], playername) == 0)
                {
                        found = true;
                        count++;
                        // FIX DIAG-VEH-2: mostrar estado correcto del vehiculo (3 niveles).
                        // ANTES: IsValidVehicle(VehicleID[i]) retornaba true para nativeID reciclado.
                        // AHORA: 3 niveles - Destruido / Averiado / Activo.
                        new _estado[24];
                        new Float:_vehHp;
                        if(!IsValidVehicle(VehicleID[i]) || GetVehicleModel(VehicleID[i]) != VehicleModel[i])
                                _estado = "{FF0000}Destruido";
                        else
                        {
                                GetVehicleHealth(VehicleID[i], _vehHp);
                                if(_vehHp < 400.0)
                                        _estado = "{FFA500}Averiado";
                                else
                                        _estado = "{00FF00}Activo";
                        }
                        // FIX DIAG-VEH-3: quitar prefijo "N. " para que sscanf(inputtext[4]) funcione.
                        format(info, sizeof(info), "%s{FFFFFF}ID: {FFFF00}%d  {FFFFFF}Modelo: {FFFF00}%s  {FFFFFF}Estado: %s\n", info, i, VehicleNames[VehicleModel[i]-400], _estado);
                }
        }
        if(!found) return ErrorMsg(playerid, "No tienes ningun vehiculo personal.");
        new title[64];
        format(title, sizeof(title), "Tus Vehiculos (%d) - Selecciona para localizar", count);
        ShowPlayerDialog(playerid, DIALOG_FINDVEHICLE, DIALOG_STYLE_LIST, title, info, "Localizar", "Cerrar");
        return 1;
}

// ==========================================================================
// FIX MEJORA-VEH-2: /guardarveh - Guardar posicion actual del vehiculo que conduces.
// Actualiza posicion, interior y VW del vehiculo personal que el jugador conduce.
// Solo funciona si el jugador es dueno del vehiculo.
// ==========================================================================
CMD:guardarveh(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return ErrorMsg(playerid, "Debes estar conduciendo un vehiculo para guardarlo.");
        new nativeVeh = GetPlayerVehicleID(playerid);
        if(nativeVeh <= 0) return ErrorMsg(playerid, "Vehiculo invalido.");
        new dveh = GetVehicleID(nativeVeh);
        if(!IsValidVehicle1(dveh))
                return ErrorMsg(playerid, "Este vehiculo no es un vehiculo personal.");
        if(VehicleCreated[dveh] != VEHICLE_PLAYER)
                return ErrorMsg(playerid, "Este vehiculo no es un vehiculo personal.");
        if(GetPlayerVehicleAccess(playerid, dveh) < 2)
                return ErrorMsg(playerid, "No eres dueno de este vehiculo.");
        // Actualizar posicion
        GetVehiclePos(nativeVeh, VehiclePos[dveh][0], VehiclePos[dveh][1], VehiclePos[dveh][2]);
        GetVehicleZAngle(nativeVeh, VehiclePos[dveh][3]);
        VehicleInterior[dveh] = GetPlayerInterior(playerid);
        VehicleWorld[dveh] = GetPlayerVirtualWorld(playerid);
        SaveVehicle(dveh);
        SuccesMsg(playerid, "Vehiculo guardado en esta posicion.");
        return 1;
}

CMD:venderv(playerid, params[])
{
        new pid, id, price, msg[128];
        if(sscanf(params, "ddd", pid, id, price)) return ErrorMsg(playerid,  "USAGE: /venderv [player] [vehicleid] [price]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == pid)
                        {
                                if(GetPlayerVehicleAccess(playerid, id) < 2)
                                        return ErrorMsg(playerid, "No eres dueno de este vehiculo!");
                                if(price < 1) return ErrorMsg(playerid, "Valor invalido.");
                                if(!PlayerToPlayer(playerid, i, 10.0)) return ErrorMsg(playerid, "El jugador esta muy lejos!");
                                SetPVarInt(i, "DialogValue1", playerid);
                                SetPVarInt(i, "DialogValue2", id);
                                SetPVarInt(i, "DialogValue3", price);
                                ShowDialog(i, DIALOG_VEHICLE_SELL);
                                format(msg, sizeof(msg), "Le ofreciste a %04d comprar tu vehiculo por $%d", GetPlayerIdfixo(i), price);
                                SuccesMsg(playerid, msg);
                        }
                }
        }

        return 1;
}

CMD:darchaves(playerid, params[])
{
        new pid, id, msg[128];
        if(sscanf(params, "dd", pid, id)) return ErrorMsg(playerid,  "USAGE: /darchaves [player] [vehicleid]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == pid)
                        {
                                if(!IsValidVehicle1(id)) return ErrorMsg(playerid,  "ID de vehiculo no valido!");
                                if(GetPlayerVehicleAccess(playerid, id) < 2)
                                        return ErrorMsg(playerid,  "No eres dueno de este vehiculo!");
                                if(!PlayerToPlayer(playerid, i, 10.0)) return ErrorMsg(playerid,  "El jugador esta muy lejos!");
                                SetPVarInt(i, "CarKeys", id);
                                format(msg, sizeof(msg), "Entregaste las llaves de tu auto a %04d", GetPlayerIdfixo(i));
                                SuccesMsg(playerid, msg);
                                format(msg, sizeof(msg), "%04d te deu as chaves do carro", GetPlayerIdfixo(playerid));
                                InfoMsg(i, msg);
                        }
                }
        }
        return 1;
}

CMD:trancar(playerid, params[])
{
        new vehicleid;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                vehicleid = GetPlayerVehicleID(playerid);
        }
        else
        {
                vehicleid = GetClosestVehicle(playerid);
                if(!PlayerToVehicle(playerid, vehicleid, 5.0)) vehicleid = 0;
        }
        if(!vehicleid) return ErrorMsg(playerid, "No, estas cerca de un vehiculo!");
        new id = GetVehicleID(vehicleid);
        if(!IsValidVehicle1(id)) return ErrorMsg(playerid, "No tienes las llaves de este vehiculo!");
        if(GetPlayerVehicleAccess(playerid, id) < 2)
                return ErrorMsg(playerid, "No tienes las llaves de este vehiculo!");
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(doors == 1)
        {
                doors = 0;
                VehicleLock[id] = 0;
                GameTextForPlayer(playerid, "~g~portas aberto", 3000, 6);
        }
        else
        {
                doors = 1;
                VehicleLock[id] = 1;
                GameTextForPlayer(playerid, "~r~portas fechadas", 3000, 6);
        }
        SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
        SaveVehicle(id);
        return 1;
}

CMD:alarmev(playerid, params[])
{
        new vehicleid;
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                vehicleid = GetPlayerVehicleID(playerid);
        }
        else
        {
                vehicleid = GetClosestVehicle(playerid);
                if(!PlayerToVehicle(playerid, vehicleid, 5.0)) vehicleid = 0;
        }
        if(!vehicleid) return ErrorMsg(playerid, "No estas cerca de un vehiculo!");
        new id = GetVehicleID(vehicleid);
        if(!IsValidVehicle1(id)) return ErrorMsg(playerid, "No tienes las llaves de este vehiculo!");
        if(GetPlayerVehicleAccess(playerid, id) < 2)
                return ErrorMsg(playerid, "No tienes las llaves de este vehiculo!");
        if(VehicleSecurity[vehicleid] == 0)
        {
                VehicleSecurity[vehicleid] = 1;
                VehicleAlarm[id] = 1;
                GameTextForPlayer(playerid, "~g~alarme ligado", 3000, 6);
        }
        else
        {
                ToggleAlarm(vehicleid, VEHICLE_PARAMS_OFF);
                VehicleSecurity[vehicleid] = 0;
                VehicleAlarm[id] = 0;
                GameTextForPlayer(playerid, "~r~alarme desligado", 3000, 6);
        }
        SaveVehicle(id);
        return 1;
}

CMD:maletero(playerid, params[])
{
        new vehicleid = GetClosestVehicle(playerid);
        if(!PlayerToVehicle(playerid, vehicleid, 5.0)) vehicleid = 0;
        if(!vehicleid || IsBicycle(vehicleid) || IsPlayerInAnyVehicle(playerid))
                return ErrorMsg(playerid, "No estas cerca de un vehiculo.!");
        new id = GetVehicleID(vehicleid);
        if(!IsValidVehicle1(id)) return ErrorMsg(playerid, "No tienes las llaves de este vehiculo.!");
        if(GetPlayerVehicleAccess(playerid, id) < 2)
                return ErrorMsg(playerid, "No tienes las llaves de este vehiculo.!");
        ToggleBoot(vehicleid, VEHICLE_PARAMS_ON);
        SetPVarInt(playerid, "DialogValue1", id);
        ShowDialog(playerid, DIALOG_TRUNK);
        return 1;
}

CMD:abastecer(playerid, params[])
{
        // GASBIZ-FASE2-B C3: anti-spam al inicio del comando. Antes: el
        // anti-spam solo existia en DIALOG_FUEL case 0 (L38782), pero el
        // jugador podia ejecutar /abastecer mientras repostaba: el comando
        // hacia el loop de IsPlayerInRangeOfPoint, encontraba la estacion,
        // seteaba el PVar "FuelStation" (sobrescribiendo el PVar ya seteado
        // por el refuel en curso Ã¢Â€Â” el valor seria el mismo, sin dano) y
        // abria DIALOG_FUEL. El DIALOG_FUEL case 0 entonces rechazaba con
        // "Ya estas abasteciendo!" (L38784). Funcionalmente OK, pero el
        // jugador recibe un dialog innecesario. Ahora: rechazar en el
        // comando mismo, sin abrir el dialog. Mensaje consistente con el
        // de DIALOG_FUEL case 0 ("Ya estas repostando" segun spec).
        if(RefuelTime[playerid] > 0)
                return ErrorMsg(playerid, "Ya estas repostando.");
        for(new i=1; i < MAX_FUEL_STATIONS; i++)
        {
                if(FuelStationCreated[i])
                {
                        if(IsPlayerInRangeOfPoint(playerid, 15.0, FuelStationPos[i][0], FuelStationPos[i][1], FuelStationPos[i][2]))
                        {
                                if(!FuelStationAbierta[i])
                                        return ErrorMsg(playerid, "Esta gasolinera esta cerrada. No puedes repostar.");
                                SetPVarInt(playerid, "FuelStation", i);
                                ShowDialog(playerid, DIALOG_FUEL);
                                return 1;
                        }
                }
        }
        ErrorMsg(playerid, "No estas en una estacion de combustible!");
        return 1;
}

CMD:rtc(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(!IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "No estas en un vehiculo!");
        SetVehicleToRespawn(GetPlayerVehicleID(playerid));
        SuccesMsg(playerid, "Vehiculo respawneado");
        return 1;
}

CMD:rac(playerid, params[])
{
        new bool:vehicleused[MAX_VEHICLES];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && IsPlayerInAnyVehicle(i))
                {
                        vehicleused[GetPlayerVehicleID(i)] = true;
                }
        }
        for(new i=1; i < MAX_VEHICLES; i++)
        {
                if(!vehicleused[i])
                {
                        SetVehicleToRespawn(i);
                }
        }
        new msg[128];
        foreach(new i : Player)
        {
                format(msg, sizeof(msg), "El administrador %04d ha regenerado todos los vehÃ¯Â¿Â½culos sin conductor.", GetPlayerIdfixo(playerid), playerid);
                InfoMsg(i, msg);
        }
        return 1;
}

CMD:setgasolina(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(!IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "No estas en un vehiculo");
        new amount, msg[128];
        if(sscanf(params, "d", amount)) return ErrorMsg(playerid,  "USAGE: /setgasolina [0-capacidad]");
        new vehicleid = GetPlayerVehicleID(playerid);
        // FUEL-ARCHITECTURE: rango 0 a capacidad del tanque (no 0-100 fijo)
        if(vehicleid < 1 || vehicleid >= MAX_VEHICLES || !g_VehFuel[vehicleid][vf_initialized])
                return ErrorMsg(playerid, "Vehiculo sin sistema de combustible inicializado.");
        new Float:cap = g_VehFuel[vehicleid][vf_capacidad];
        if(amount < 0 || float(amount) > cap)
        {
                new errMsg[100];
                format(errMsg, sizeof(errMsg), "Valor invalido. Rango: 0 a %d L (capacidad de este vehiculo).", floatround(cap));
                return ErrorMsg(playerid, errMsg);
        }
        g_VehFuel[vehicleid][vf_actual] = float(amount);
        Fuel[vehicleid] = float(amount);
        g_VehFuel[vehicleid][vf_alertStage] = 0;
        format(msg, sizeof(msg), "Seteaste combustible a %d L (%.0f%% del tanque).", amount, Fuel_GetPercent(vehicleid));
        SuccesMsg(playerid, msg);
        // FUEL-ARCHITECTURE: log de /setgasolina para auditoria admin
        new logmsg[180];
        format(logmsg, sizeof(logmsg), "[%s] Admin %s (IDF %d) seteo fuel de veh %d a %d L (cap %.0f)",
                "SETGASOLINA", PlayerName(playerid), PlayerInfo[playerid][IDF], vehicleid, amount, cap);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// VERIFY-FUEL-FEATURE: comando /motor para apagar/encender el motor manualmente.
// Solo funciona para conductores. Si el combustible es 0, no se puede encender.
// Las bicicletas no tienen motor (ignoran el comando).
CMD:motor(playerid, params[])
{
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return ErrorMsg(playerid, "Debes estar conduciendo un vehiculo.");
        new vehicleid = GetPlayerVehicleID(playerid);
        if(vehicleid <= 0)
                return ErrorMsg(playerid, "Vehiculo invalido.");
        if(IsBicycle(vehicleid))
                return ErrorMsg(playerid, "Las bicicletas no tienen motor.");
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(engine == 1)
        {
                // Apagar motor
                SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
                InfoMsg(playerid, "Motor apagado.");
        }
        else
        {
                // Encender motor: requiere combustible (FUEL-ARCHITECTURE)
                if(vehicleid >= 1 && vehicleid < MAX_VEHICLES && g_VehFuel[vehicleid][vf_initialized])
                {
                        if(g_VehFuel[vehicleid][vf_actual] <= 0.0)
                                return ErrorMsg(playerid, "Sin combustible. Usa /abastecer o un bidon de emergencia.");
                }
                else if(Fuel[vehicleid] <= 0.0)
                {
                        return ErrorMsg(playerid, "Sin combustible. Usa /abastecer o un bidon de emergencia.");
                }
                SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective);
                InfoMsg(playerid, "Motor encendido.");
        }
        return 1;
}

CMD:addv(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(!IsPlayerSpawned(playerid)) return ErrorMsg(playerid, "You can't use this command now!");
        new model, dealerid, color1, color2, price;
        if(sscanf(params, "ddddd", dealerid, model, color1, color2, price))
                return ErrorMsg(playerid, "USAGE: /addv [dealerid] [model] [color1] [color2] [price]");
        if(!IsValidDealership(dealerid)) return ErrorMsg(playerid,  "ID invalido");
        // [DEAL-FASE2-3] FIX AUD3-003: validar proximidad del admin al
        // dealership. Antes: el admin podia ejecutar /addv desde cualquier
        // parte del mapa (ej. HQ de banda en interior 5) y crear un vehiculo
        // dealership etiquetado como perteneciente a dealerid X pero fisicamente
        // en la posicion del admin. Esto causaba (a) confusion visual (label
        // "Concessionaria ID: X" en posiciones raras), (b) combinado con
        // AUD3-006, mismatch Interior/Vehiculo al comprar, (c) griefing admin
        // descuidado spawnando vehiculos en zonas que no deberian.
        // Ahora: el admin debe estar a 30m del DealershipPos[dealerid] para
        // crear el vehiculo. 30m es generoso (alcanza para crear varios
        // vehiculos alrededor del punto sin moverse). IsPlayerInRangeOfPoint
        // es native SA-MP, ya usada en 4+ lugares del GM (L5579, L7110,
        // L9408, L9795, L10401). Si el admin necesita crear vehiculos
        // remotamente, debe primero /gotodealership y luego /addv.
        if(!IsPlayerInRangeOfPoint(playerid, 30.0, DealershipPos[dealerid][0],
                DealershipPos[dealerid][1], DealershipPos[dealerid][2]))
                return ErrorMsg(playerid,  "Debes estar cerca de la concesionaria para agregarle vehiculos. Usa /gotodealership primero.");
        if(model < 400 || model > 611) return ErrorMsg(playerid,  "Invalid model ID!");
        if(color1 < 0 || color2 < 0) return ErrorMsg(playerid,  "Invalid color!");
        // [DEAL-FASE2-3] FIX AUD1-012: clamp upper bound de colores a
        // [0, 255] (rango valido de colores de vehiculo en SA-MP). Antes:
        // solo se validaba el lower bound (< 0). Un admin podia pasar
        // color1=999, que SA-MP tipicamente interpreta como `999 mod 256`
        // o clamp interno, pero es validacion incompleta. Ahora: rechazar
        // explicitamente > 255 con mensaje claro. Patron alineado con el
        // lower bound ( early return ErrorMsg), sin clamp silencioso.
        if(color1 > 255 || color2 > 255) return ErrorMsg(playerid,  "Invalid color (0-255)!");
        if(price < 0) return ErrorMsg(playerid,  "Invalid price!");
        new Float:X, Float:Y, Float:Z, Float:angle;
        GetPlayerPos(playerid, X, Y, Z);
        GetPlayerFacingAngle(playerid, angle);
        X += floatmul(floatsin(-angle, degrees), 4.0);
        Y += floatmul(floatcos(-angle, degrees), 4.0);
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(!VehicleCreated[i])
                {
                        new msg[128];
                        VehicleCreated[i] = VEHICLE_DEALERSHIP;
                        VehicleModel[i] = model;
                        VehiclePos[i][0] = X;
                        VehiclePos[i][1] = Y;
                        VehiclePos[i][2] = Z;
                        VehiclePos[i][3] = angle+90.0;
                        VehicleColor[i][0] = color1;
                        VehicleColor[i][1] = color2;
                        VehicleInterior[i] = GetPlayerInterior(playerid);
                        VehicleWorld[i] = GetPlayerVirtualWorld(playerid);
                        // [DEAL-FASE1] FIX HIGH-1 (DEAL-AUD1-003): /addv no valida Valor > 0.
                        // Antes: VehicleValue[i] = price; sin clamp. price=0 creaba vehÃƒÂ­culos
                        // gratis en la concesionaria (regalo encubierto bypass nivel 7).
                        // Ahora: clamp [1, 10000000] alineado con LoadVehicles (L8587-8592)
                        // para que runtime y restart sean consistentes (defense-in-depth).
                        if(price < 1) price = 1;
                        if(price > 10000000) price = 10000000;
                        VehicleValue[i] = price;
                        valstr(VehicleOwner[i], dealerid);
                        VehicleNumberPlate[i] = PLACA_CONCESSIONARIA;
                        for(new d=0; d < sizeof(VehicleTrunk[]); d++)
                        {
                                VehicleTrunk[i][d][0] = 0;
                                VehicleTrunk[i][d][1] = 0;
                        }
                        for(new d=0; d < sizeof(VehicleMods[]); d++)
                        {
                                VehicleMods[i][d] = 0;
                        }
                        VehiclePaintjob[i] = 255;
                        VehicleLock[i] = 0;
                        VehicleAlarm[i] = 0;
                        UpdateVehicle(i, 0);
                        SaveVehicle(i);
                        format(msg, sizeof(msg), "Added vehicle id %d to dealerid %d", i, dealerid);
                        SuccesMsg(playerid,  msg);
                        return 1;
                }
        }
        // [DEAL-FASE2-3] FIX AUD3-007: mensaje explicito sobre slots
        // disponibles en vez del mensaje generico anterior
        // ("Can't add any more vehicles!"). Antes: el admin no sabia si
        // era un bug, un permiso, o limite de capacidad. Ahora: mensaje
        // claro indica que MAX_DVEHICLES (500) esta lleno y que debe liberar
        // slots via /deletedealership o esperar que players vendan. El
        // contador de slots libres se loguea tambien a printf para que el
        // staff pueda verlo en server.log y tomar accion proactiva.
        // Nota: copiamos Name(playerid) a un local antes del printf porque
        // Name() retorna un array local a su stack frame Ã¢Â€Â” al pasarlo
        // directo a printf como vararg, el dato podria estar ya sobre-escrito
        // (UB en SA-MP). Patron seguro: GetPlayerName a local, luego printf.
        new _freeSlots = 0, _adminName[24];
        GetPlayerName(playerid, _adminName, sizeof(_adminName));
        for(new _i=1; _i < MAX_DVEHICLES; _i++) if(!VehicleCreated[_i]) _freeSlots++;
        printf("[DEAL-FASE2-3 AUD3-007] /addv fallo: slots DVEHICLES llenos. Libres: %d / %d (admin: %s).",
                _freeSlots, MAX_DVEHICLES, _adminName);
        ErrorMsg(playerid,  "No hay slots disponibles: los 500 slots de vehiculos (MAX_DVEHICLES) estan en uso. Libera slots con /deletedealership o espera que players vendan.");
        return 1;
}

CMD:editv(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                new id = GetVehicleID(GetPlayerVehicleID(playerid));
                if(!IsValidVehicle1(id)) return ErrorMsg(playerid,  "This is not a dynamic vehicle!");
                SetPVarInt(playerid, "DialogValue1", id);
                ShowDialog(playerid, DIALOG_EDITVEHICLE);
                return 1;
        }
        new vehicleid;
        if(sscanf(params, "d", vehicleid)) return ErrorMsg(playerid,  "USAGE: /editv [vehicleid]");
        if(!IsValidVehicle1(vehicleid)) return ErrorMsg(playerid,  "Invalid vehicleid!");
        SetPVarInt(playerid, "DialogValue1", vehicleid);
        ShowDialog(playerid, DIALOG_EDITVEHICLE);
        return 1;
}

// Comando admin para reparar vehiculo (salud 1000 + damage status + motor on)
// Uso: /fixveh (repara el vehiculo en el que estas) o /fixveh [nativeID] (repara ese vehiculo)
CMD:fixveh(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "Sem permissao");
        new targetVeh;

        if(IsPlayerInAnyVehicle(playerid))
        {
                // Si esta en un vehiculo, reparar ese
                targetVeh = GetPlayerVehicleID(playerid);
        }
        else
        {
                // Si paso un ID, usar ese
                if(sscanf(params, "d", targetVeh))
                {
                        // Sin parametro y a pie: buscar vehiculo mas cercano dentro de 10m
                        new Float:px, Float:py, Float:pz;
                        GetPlayerPos(playerid, px, py, pz);
                        new Float:closestDist = 99999.0;
                        new closestVeh = INVALID_VEHICLE_ID;
                        for(new v = 1; v < MAX_VEHICLES; v++)
                        {
                                if(!IsValidVehicle(v)) continue;
                                new Float:vx, Float:vy, Float:vz;
                                GetVehiclePos(v, vx, vy, vz);
                                new Float:dist = floatsqroot((px-vx)*(px-vx) + (py-vy)*(py-vy));
                                if(dist < closestDist && dist < 10.0)
                                {
                                        closestDist = dist;
                                        closestVeh = v;
                                }
                        }
                        if(closestVeh == INVALID_VEHICLE_ID)
                                return ErrorMsg(playerid, "No hay vehiculos cerca. Usa /fixveh [nativeID] o subete a uno.");
                        targetVeh = closestVeh;
                }
        }

        if(!IsValidVehicle(targetVeh))
                return ErrorMsg(playerid, "Vehiculo invalido.");

        // Reparar: salud 1000, damage status limpio, motor on
        SetVehicleHealth(targetVeh, 1000.0);
        UpdateVehicleDamageStatus(targetVeh, 0, 0, 0, 0);
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(targetVeh, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(targetVeh, 1, lights, 0, doors, bonnet, boot, objective);

        // Si es un vehiculo personal, guardar la salud
        new dveh = GetVehicleID(targetVeh);
        if(dveh > 0 && dveh < MAX_DVEHICLES && VehicleCreated[dveh] == VEHICLE_PLAYER)
        {
                Fuel_SavePersistent(targetVeh);
        }
        // AUD4-009 (BANDAVEH-MEDIO): si es vehiculo de banda (vf_orgSlot > 0),
        // tambien persistir fuel al slot de la org. ANTES /fixveh solo persistia
        // fuel para vehiculos personales. Vehiculos de banda reparados por admin
        // no tenian su fuel sincronizado a g_VehOrgFuelPersist, asi que al
        // destruir el vehiculo (via /dvehiculo o explosion) se perdia el fuel
        // post-reparacion (que ya estaba cargado a tope). Ahora: sync explicito.
        if(targetVeh >= 1 && targetVeh < MAX_VEHICLES
           && g_VehFuel[targetVeh][vf_initialized]
           && g_VehFuel[targetVeh][vf_orgSlot] > 0)
        {
                Fuel_SavePersistent(targetVeh);
        }

        new msg[128];
        format(msg, sizeof(msg), "Vehiculo ID %d reparado (salud 100%%, motor encendido).", targetVeh);
        SuccesMsg(playerid, msg);

        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[FIXVEH] %s (IDF %d, admin %d) reparo vehiculo nativeID %d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerInfo[playerid][pAdmin], targetVeh);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// Comando admin para traer un vehiculo personal a la posicion del admin
// Uso: /traerveh [dveh] (ID interno del vehiculo personal, 1-500)
CMD:traerveh(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "Sem permissao");
        new dveh;
        if(sscanf(params, "d", dveh))
                return ErrorMsg(playerid, "USAGE: /traerveh [dveh] (ID del vehiculo personal 1-500)");
        if(dveh < 1 || dveh >= MAX_DVEHICLES)
                return ErrorMsg(playerid, "ID de vehiculo invalido (1-500).");
        if(!IsValidVehicle1(dveh))
                return ErrorMsg(playerid, "Ese vehiculo no existe.");
        if(VehicleCreated[dveh] != VEHICLE_PLAYER)
                return ErrorMsg(playerid, "Ese no es un vehiculo personal.");
        if(!IsValidVehicle(VehicleID[dveh]))
                return ErrorMsg(playerid, "El vehiculo no esta creado en el mundo.");

        // Traer el vehiculo a la posicion del admin
        new Float:px, Float:py, Float:pz, Float:pa;
        GetPlayerPos(playerid, px, py, pz);
        GetPlayerFacingAngle(playerid, pa);

        SetVehiclePos(VehicleID[dveh], px + 2.0, py + 2.0, pz);
        SetVehicleZAngle(VehicleID[dveh], pa);
        LinkVehicleToInterior(VehicleID[dveh], GetPlayerInterior(playerid));
        SetVehicleVirtualWorld(VehicleID[dveh], GetPlayerVirtualWorld(playerid));

        // Reparar al traer (puede estar averiado)
        SetVehicleHealth(VehicleID[dveh], 1000.0);
        UpdateVehicleDamageStatus(VehicleID[dveh], 0, 0, 0, 0);

        // Actualizar posicion persistente
        VehiclePos[dveh][0] = px + 2.0;
        VehiclePos[dveh][1] = py + 2.0;
        VehiclePos[dveh][2] = pz;
        VehiclePos[dveh][3] = pa;
        VehicleInterior[dveh] = GetPlayerInterior(playerid);
        VehicleWorld[dveh] = GetPlayerVirtualWorld(playerid);
        SaveVehicle(dveh);

        new msg[128];
        format(msg, sizeof(msg), "Vehiculo '%s' (ID %d) traido a tu posicion.", VehicleOwner[dveh], dveh);
        SuccesMsg(playerid, msg);

        new logmsg[256];
        format(logmsg, sizeof(logmsg), "[TRAERVEH] %s (IDF %d, admin %d) trajo vehiculo dveh=%d (%s) a su posicion",
                PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerInfo[playerid][pAdmin], dveh, VehicleOwner[dveh]);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

CMD:adddealership(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(!IsPlayerSpawned(playerid)) return ErrorMsg(playerid,  "No puedes usar el comando!");
        // [DEAL-FASE1] FIX HIGH-3 (DEAL-AUD3-001): /adddealership no valida posiciÃƒÂ³n Z.
        // Antes: GetPlayerPos se llamaba DENTRO del for loop DESPUÃƒÂ‰S de
        // DealershipCreated[i] = 1, sin validar Z. Un admin podia crear
        // concesionarias "en el cielo" (Z muy alto) o "bajo tierra" (Z <= 0),
        // dejando slots en estado invÃƒÂ¡lido. Ahora: validar Z > 0 ANTES de
        // mutar DealershipCreated/DealershipPos. Si Z <= 0, retornar error
        // sin tocar el slot.
        new Float:X, Float:Y, Float:Z;
        GetPlayerPos(playerid, X, Y, Z);
        if(Z <= 0.0) return ErrorMsg(playerid,  "Posicion invalida: Z debe ser > 0 (no se puede crear en el cielo o bajo tierra).");
        for(new i=1; i < MAX_DEALERSHIPS; i++)
        {
                if(!DealershipCreated[i])
                {
                        new msg[128];
                        DealershipCreated[i] = 1;
                        DealershipPos[i][0] = X;
                        DealershipPos[i][1] = Y;
                        DealershipPos[i][2] = Z;
                        UpdateDealership(i, 0);
                        SaveDealership(i);
                        format(msg, sizeof(msg), "Concessionaria %d adicionada.", i);
                        SuccesMsg(playerid,  msg);
                        return 1;
                }
        }
        // [DEAL-FASE2-3] FIX AUD3-007: mensaje explicito sobre slots
        // disponibles en vez del mensaje generico anterior
        // ("Ya tienes muchas concesionarias."). Antes: el admin no sabia
        // cuantas concesionarias existian ni cual era el limite. Ahora:
        // mensaje claro indica que MAX_DEALERSHIPS esta lleno. Log a printf
        // con el conteo para diagnostico staff.
        new _freeD = 0, _usedD = 0, _adminName2[24];
        GetPlayerName(playerid, _adminName2, sizeof(_adminName2));
        for(new _i=1; _i < MAX_DEALERSHIPS; _i++)
        {
                if(DealershipCreated[_i]) _usedD++;
                else _freeD++;
        }
        printf("[DEAL-FASE2-3 AUD3-007] /adddealership fallo: slots llenos. En uso: %d / %d. Libres: %d (admin: %s).",
                _usedD, MAX_DEALERSHIPS, _freeD, _adminName2);
        ErrorMsg(playerid,  "No hay slots disponibles: todos los slots de concesionarias (MAX_DEALERSHIPS) estan en uso. Elimina una con /deletedealership antes de crear una nueva.");
        return 1;
}

CMD:deletedealership(playerid, params[])
{
        new dealerid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "d", dealerid)) return ErrorMsg(playerid,  "USAGE: /deletedealership [dealerid]");
        if(!IsValidDealership(dealerid)) return ErrorMsg(playerid,  "ID invalido!");
        for(new i=1; i < MAX_DVEHICLES; i++)
        {
                if(VehicleCreated[i] == VEHICLE_DEALERSHIP && strval(VehicleOwner[i]) == dealerid)
                {
                        DestroyVehicle(VehicleID[i]);
                        Delete3DTextLabel(VehicleLabel[i]);
                        VehicleCreated[i] = 0;
                        // [DEAL-FASE2-3] FIX AUD1-006: persistir Created=0 en
                        // disco para evitar orphan dealership vehicles al
                        // reiniciar. Antes: el comando solo persistia el estado
                        // del dealership (SaveDealership(dealerid)), NO el de
                        // los vehiculos asociados. Al reiniciar, LoadVehicles
                        // re-leia v<i>.ini con Created=1 y recreaba los
                        // vehiculos huerfanos (sin dealership padre), con
                        // labels "Concessionaria ID: X" pero sin pickup ni
                        // label de concesionaria en el mapa. Peor: si un
                        // jugador compraba un huerfano, el nuevo VEHICLE_PLAYER
                        // spawneaba en DealershipPos[dealerid]=(0,0,0) (void).
                        // Patron replicado de DesmancharVeh (DEAL-FASE1
                        // CRIT-1): mutar memoria + persistir en disco en el
                        // mismo paso.
                        SaveVehicle(i);
                }
        }
        DealershipCreated[dealerid] = 0;
        Delete3DTextLabel(DealershipLabel[dealerid]);
        SaveDealership(dealerid);
        format(msg, sizeof(msg), "Concessionaria %d deletada.", dealerid);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:movedealership(playerid, params[])
{
        new dealerid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "d", dealerid)) return ErrorMsg(playerid,  "USAGE: /movedealership [dealerid]");
        if(!IsValidDealership(dealerid)) return ErrorMsg(playerid,  "ID invalido");
        // [DEAL-FASE1] FIX HIGH-4 (DEAL-AUD3-002): /movedealership no valida Z.
        // Antes: GetPlayerPos se llamaba directamente sobre DealershipPos[dealerid],
        // sin validar Z. Si el admin estaba "en el cielo" o "bajo tierra",
        // la concesionaria quedaba en posiciÃƒÂ³n invÃƒÂ¡lida persistida en disco vÃƒÂ­a
        // SaveDealership. Ahora: leer a variables locales, validar Z > 0, y solo
        // entonces mutar DealershipPos (evita corrupciÃƒÂ³n de estado on-error).
        new Float:X, Float:Y, Float:Z;
        GetPlayerPos(playerid, X, Y, Z);
        if(Z <= 0.0) return ErrorMsg(playerid,  "Posicion invalida: Z debe ser > 0 (no se puede mover en el cielo o bajo tierra).");
        DealershipPos[dealerid][0] = X;
        DealershipPos[dealerid][1] = Y;
        DealershipPos[dealerid][2] = Z;
        UpdateDealership(dealerid, 1);
        SaveDealership(dealerid);
        format(msg, sizeof(msg), "Concessionaria %d movida.", dealerid);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:gotodealership(playerid, params[])
{
        new dealerid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");

        if(sscanf(params, "d", dealerid)) return ErrorMsg(playerid, "USAGE: /gotodealership [dealerid]");
        if(!IsValidDealership(dealerid)) return ErrorMsg(playerid, "ID invalido");
        SetPlayerPos(playerid, DealershipPos[dealerid][0], DealershipPos[dealerid][1], DealershipPos[dealerid][2]);
        TogglePlayerControllable(playerid, false);
        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
        format(msg, sizeof(msg), "Teleportado para concessionaria %d", dealerid);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:addfuelstation(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(!IsPlayerSpawned(playerid)) return ErrorMsg(playerid, "No puedes usar el comando!");
        new nombre[32];
        if(sscanf(params, "s[32]", nombre)) return ErrorMsg(playerid, "USE: /addfuelstation [nombre]");
        // GASBIZ-FASE2-B C5: sanitizar INI injection en FuelStationName. Antes:
        // el nombre se persistia via SaveFuelStation (linea
        // `format(line, sizeof(line), "Name=%s\r\n", FuelStationName[stationid])`)
        // sin sanitizar. Un admin malicioso podia inyectar:
        // - '=' para crear/overridear keys arbitrarias (ej. nombre
        //   "x\r\nOwnerIDF=999" cambiaria el dueno a IDF 999).
        // - '\r' y '\n' para inyectar nuevas lineas y sobrescribir campos
        //   del .ini (ej. "x\r\nCaja=9999999" seteaba la caja a 9.9M).
        // - '{' para prevenir secciones INI raras (DOF2/fopen parser
        //   podria interpretar `{section}` como inicio de seccion).
        // El task spec dice "loop de sanitizacion que ya existe (busca
        // nombre[c] == '{')" Ã¢Â€Â” el loop no existia previamente en este
        // comando, asi que se anade completo con los 4 checks (`{`, `=`,
        // `\r`, `\n`). Patron de sanitizacion similar al de anuncios
        // (L52871, `for(new i = 0; i < strlen(anuncio); i++) if(anuncio[i]
        // == '~') anuncio[i] = '-';`).
        for(new c = 0; c < strlen(nombre); c++)
        {
                if(nombre[c] == '{') nombre[c] = '-';
                if(nombre[c] == '=') nombre[c] = '-';
                if(nombre[c] == '\r') nombre[c] = ' ';
                if(nombre[c] == '\n') nombre[c] = ' ';
        }
        for(new i=1; i < MAX_FUEL_STATIONS; i++)
        {
                if(!FuelStationCreated[i])
                {
                        new msg[128];
                        FuelStationCreated[i] = 1;
                        GetPlayerPos(playerid, FuelStationPos[i][0], FuelStationPos[i][1], FuelStationPos[i][2]);
                        // GAS-STATION-BUSINESS: inicializar todos los campos
                        format(FuelStationName[i], 32, "%s", nombre);
                        FuelStationPrecioGasolina[i] = 3;
                        FuelStationPrecioDiesel[i] = 4;
                        FuelStationOwnerIDF[i] = 0; // Servidor
                        FuelStationGasolinaStock[i] = FS_DEFAULT_GAS_STOCK;
                        FuelStationGasolinaCap[i] = FS_DEFAULT_GAS_CAP;
                        FuelStationPetroleoStock[i] = FS_DEFAULT_PET_STOCK;
                        FuelStationPetroleoCap[i] = FS_DEFAULT_PET_CAP;
                        FuelStationAbierta[i] = true;
                        FuelStationValor[i] = FS_DEFAULT_VALOR;
                        FuelStationLastRestock[i] = gettime();
                        UpdateFuelStation(i, 0);
                        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
                        new _saveRes = SaveFuelStation(i);
                        if(_saveRes == 0)
                        {
                                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:addfuelstation (estacion no persistida en disco).");
                                return ErrorMsg(playerid, "Error: no se pudo guardar la gasolinera en disco. Contacta un admin.");
                        }
                        format(msg, sizeof(msg), "Gasolinera '%s' creada (ID %d). Stock: %dL gas / %dL pet.", nombre, i, FS_DEFAULT_GAS_STOCK, FS_DEFAULT_PET_STOCK);
                        SuccesMsg(playerid, msg);
                        return 1;
                }
        }
        ErrorMsg(playerid, "Ya tienes muchas estaciones");
        return 1;
}

CMD:deletefuelstation(playerid, params[])
{
        new stationid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USAGE: /deletefuelstation [stationid]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        // GASBIZ-FASE2-B B6+B1: pagar compensacion al dueno ANTES de eliminar la
        // estacion (B6) y notificar al dueno online del cambio (B1). Antes: al
        // eliminar una gasolinera con dueno, el dueno perdia (a) el valor de
        // compra de la estacion (FuelStationValor), y (b) la caja acumulada no
        // reclamada (FuelStationCaja). Era un confiscamiento sin compensacion
        // y sin notificacion. Ahora: si FuelStationOwnerIDF[stationid] > 0,
        // pagar 50% del valor de compra (FuelStationValor/2) + la caja acumulada
        // al dueno. Si esta online: AC_AddPlayerMoney + SalvarDados + InfoMsg
        // (el InfoMsg cumple doble funcion B6+B1: notifica eliminacion +
        // compensacion, "NO agregues notificacion si ya existe"). Si offline:
        // Fuel_Station_ResolveOwnerName + DOF2_SetInt en Contas/<Name>.ini campo
        // pDinheiro (mismo patron que CRIT-2 en CMD:setduenoestacion). La
        // compensacion se captura ANTES de resetear los campos (lineas abajo)
        // porque esos resets ponen valor=0 y caja=0, perdiendo la informacion.
        new _compOwnerIDF = FuelStationOwnerIDF[stationid];
        new _compValor = FuelStationValor[stationid];
        new _compCaja = FuelStationCaja[stationid];
        if(_compOwnerIDF > 0)
        {
                // Compensacion = 50% del valor + caja acumulada
                new _compMonto = (_compValor / 2) + _compCaja;
                // Buscar dueno online
                new _compSlot = -1;
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == _compOwnerIDF)
                        {
                                _compSlot = p;
                                break;
                        }
                }
                if(_compSlot != -1)
                {
                        // Online: AC_AddPlayerMoney + SalvarDados + InfoMsg
                        if(_compMonto > 0)
                        {
                                AC_AddPlayerMoney(_compSlot, _compMonto);
                                SalvarDados(_compSlot);
                        }
                        new _compMsg[256];
                        if(_compMonto > 0)
                                format(_compMsg, sizeof(_compMsg), "Tu gasolinera (ID %d) fue eliminada por un admin. Compensacion $%d acreditada (50%% valor + caja acumulada).", stationid, _compMonto);
                        else
                                format(_compMsg, sizeof(_compMsg), "Tu gasolinera (ID %d) fue eliminada por un admin. Sin compensacion (valor y caja en 0).", stationid);
                        InfoMsg(_compSlot, _compMsg);
                }
                else
                {
                        // Offline: resolver nombre via helper y modificar Contas/<Name>.ini.
                        // Mismo patron que CRIT-2 en CMD:setduenoestacion.
                        if(_compMonto > 0)
                        {
                                new _compOwnerName[24];
                                if(Fuel_Station_ResolveOwnerName(_compOwnerIDF, _compOwnerName, sizeof(_compOwnerName)))
                                {
                                        new _compAccFile[64];
                                        format(_compAccFile, sizeof(_compAccFile), PASTA_CONTAS, _compOwnerName);
                                        if(DOF2_FileExists(_compAccFile))
                                        {
                                                new _compCurrentMoney = DOF2_GetInt(_compAccFile, "pDinheiro");
                                                DOF2_SetInt(_compAccFile, "pDinheiro", _compCurrentMoney + _compMonto);
                                                DOF2_SaveFile();
                                        }
                                        // Si no existe el archivo Contas/<Name>.ini, la compensacion
                                        // se pierde (NO es dupe). El admin debe compensar manualmente.
                                }
                                // Si el helper no resolvio nombre (offline y sin marker),
                                // la compensacion se pierde (NO es dupe). Log para admin.
                        }
                }
                // Log de compensacion para auditoria (online u offline)
                new _compLog[300];
                format(_compLog, sizeof(_compLog), "[DELETEFUELSTATION-COMPENSATION] Admin %s elimino estacion %d: pagado $%d al dueno IDF %d (%s). valor=$%d (50%%=$%d), caja=$%d.",
                        PlayerName(playerid), stationid, _compMonto, _compOwnerIDF,
                        (_compSlot != -1) ? "online-memoria" : "offline-disco",
                        _compValor, _compValor/2, _compCaja);
                Log("Logs/AdminAcciones.ini", _compLog);
        }
        FuelStationCreated[stationid] = 0;
        // GAS-STATION-BUSINESS: resetear todos los campos al eliminar
        FuelStationPrecioGasolina[stationid] = 0;
        FuelStationPrecioDiesel[stationid] = 0;
        FuelStationOwnerIDF[stationid] = 0;
        FuelStationGasolinaStock[stationid] = 0;
        FuelStationGasolinaCap[stationid] = 0;
        FuelStationPetroleoStock[stationid] = 0;
        FuelStationPetroleoCap[stationid] = 0;
        FuelStationAbierta[stationid] = false;
        FuelStationValor[stationid] = 0;
        FuelStationCaja[stationid] = 0;
        FuelStationLastRestock[stationid] = 0;
        format(FuelStationName[stationid], 32, "");
        Delete3DTextLabel(FuelStationLabel[stationid]);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:deletefuelstation (estacion no persistida en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar la gasolinera en disco. Contacta un admin.");
        }
        format(msg, sizeof(msg), "Estacion %d eliminada.", stationid);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:movefuelstation(playerid, params[])
{
        new stationid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USAGE: /movefuelstation [stationid]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        GetPlayerPos(playerid, FuelStationPos[stationid][0], FuelStationPos[stationid][1], FuelStationPos[stationid][2]);
        // GASBIZ-FASE2-B B3: validar posicion Z > 0. Antes: un admin podia
        // ejecutar /movefuelstation desde una posicion invalida (ej. en el
        // cielo tras un teleport mal hecho, o bajo tierra/en interior sin
        // coords Z validas), persistiendo coords Z <= 0 en el .ini de la
        // gasolinera. La estacion quedaba en una posicion inaccesible para
        // /abastecer (IsPlayerInRangeOfPoint nunca matcheaba) y el 3D label
        // se mostraba bajo tierra o en el cielo. Ahora: rechazar si Z <= 0.
        if(FuelStationPos[stationid][2] <= 0.0)
                return ErrorMsg(playerid, "Posicion invalida (Z <= 0). No puedes mover la gasolinera a una posicion bajo tierra o en el cielo.");
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:movefuelstation (posicion no persistida en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar la gasolinera en disco. Contacta un admin.");
        }
        format(msg, sizeof(msg), "Posto %d movido.", stationid);
        SuccesMsg(playerid, msg);
        // GASBIZ-FASE2-B B1: notificar al dueno online del cambio admin.
        // Solo si la estacion tiene dueno y el dueno NO es el caller (evitar
        // notificacion redundante cuando el dueno es admin y se cambia a si
        // mismo la posicion de su propia estacion).
        if(FuelStationOwnerIDF[stationid] > 0 && PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
        {
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == FuelStationOwnerIDF[stationid])
                        {
                                new _ownerNotify[160];
                                format(_ownerNotify, sizeof(_ownerNotify), "Un admin ha movido tu gasolinera (ID %d) a una nueva posicion.", stationid);
                                InfoMsg(p, _ownerNotify);
                                break;
                        }
                }
        }
        return 1;
}

CMD:gotofuelstation(playerid, params[])
{
        new stationid, msg[128];
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USAGE: /gotofuelstation [stationid]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        SetPlayerPos(playerid, FuelStationPos[stationid][0], FuelStationPos[stationid][1], FuelStationPos[stationid][2]);
        TogglePlayerControllable(playerid, false);
        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
        format(msg, sizeof(msg), "Teleportado para o Posto %d", stationid);
        SuccesMsg(playerid, msg);
        return 1;
}

// FUEL-ARCHITECTURE: comando para ajustar precios de una estacion.
// Permiso: admin nivel 6+ O dueno de la estacion (FuelStationOwnerIDF).
// Uso: /setprecoestacion [stationid] [gasolina] [diesel]
// Precios en $/L. Si se pasa 0, usa el default (PRECO_GASOLINA/PRECO_DIESEL).
// Limites: 0 a 1000 ($/L) para evitar precios absurdos.
CMD:setprecoestacion(playerid, params[])
{
        new stationid, precioGasolina, precioDiesel, msg[200];
        if(sscanf(params, "ddd", stationid, precioGasolina, precioDiesel))
                return ErrorMsg(playerid, "USAGE: /setprecoestacion [stationid] [gasolina $/L] [diesel $/L] (0 = default)");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID de estacion invalido");
        if(precioGasolina < 1 || precioGasolina > FS_MAX_PRECIO_GAS) return ErrorMsg(playerid, "Precio gasolina invalido (1-6 $/L)");
        if(precioDiesel < 1 || precioDiesel > FS_MAX_PRECIO_PET) return ErrorMsg(playerid, "Precio petroleo invalido (1-8 $/L)");

        // Verificar permiso: admin 6+ o dueno de la estacion
        new bool:esAdmin = (PlayerInfo[playerid][pAdmin] >= 6);
        new bool:esDueno = (FuelStationOwnerIDF[stationid] == PlayerInfo[playerid][IDF] && PlayerInfo[playerid][IDF] > 0);
        if(!esAdmin && !esDueno)
                return ErrorMsg(playerid, "No eres admin ni dueno de esta estacion.");

        FuelStationPrecioGasolina[stationid] = precioGasolina;
        FuelStationPrecioDiesel[stationid] = precioDiesel;
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:setprecoestacion (precios no persistidos en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar la gasolinera en disco. Contacta un admin.");
        }

        new gasolinaShow = (precioGasolina == 0) ? PRECO_GASOLINA : precioGasolina;
        new dieselShow = (precioDiesel == 0) ? PRECO_DIESEL : precioDiesel;
        format(msg, sizeof(msg), "Estacion %d: Gasolina $%d/L, Diesel $%d/L. Precios actualizados.", stationid, gasolinaShow, dieselShow);
        SuccesMsg(playerid, msg);

        // GASBIZ-FASE2-B B1: notificar al dueno online del cambio admin.
        // Solo si la estacion tiene dueno y el dueno NO es el caller (evitar
        // notificacion redundante cuando el dueno cambia sus propios precios).
        if(FuelStationOwnerIDF[stationid] > 0 && PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
        {
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == FuelStationOwnerIDF[stationid])
                        {
                                new _ownerNotify[180];
                                format(_ownerNotify, sizeof(_ownerNotify), "Un admin ha cambiado los precios de tu gasolinera (ID %d): Gasolina $%d/L, Diesel $%d/L.", stationid, gasolinaShow, dieselShow);
                                InfoMsg(p, _ownerNotify);
                                break;
                        }
                }
        }

        // Log de auditoria
        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[SETPRECOESTACION] %s (IDF %d, admin %d) seteo estacion %d: gasolina $%d, diesel $%d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerInfo[playerid][pAdmin], stationid, precioGasolina, precioDiesel);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// FUEL-ARCHITECTURE: comando para setear el dueno de una estacion (admin 6+).
// Uso: /setduenoestacion [stationid] [IDF dueno]
// IDF 0 = sin dueno (estacion publica, solo admin puede cambiar precios).
CMD:setduenoestacion(playerid, params[])
{
        new stationid, duenoIDF, msg[200];
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "Sem permissao");
        if(sscanf(params, "dd", stationid, duenoIDF))
                return ErrorMsg(playerid, "USAGE: /setduenoestacion [stationid] [IDF dueno] (0 = sin dueno)");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID de estacion invalido");
        if(duenoIDF < 0) return ErrorMsg(playerid, "IDF invalido");

        // GASBIZ-CRIT-1: validar que el IDF del nuevo dueno corresponda a una
        // cuenta registrada. El GM guarda Contas/<Name>.ini (por nombre), NO
        // Contas/<IDF>.ini (por numero), asi que NO podemos validar con
        // Contas/<IDF>.ini porque siempre fallaria. En su lugar usamos el
        // marker file IDs/<IDFzero-padded>.ini (creado en L32999-33003 al
        // registrar cuenta, key "IDF de:"). Si existe, el IDF es valido.
        if(duenoIDF > 0)
        {
                new markerFile[64];
                format(markerFile, sizeof(markerFile), "IDs/%04d.ini", duenoIDF);
                if(!DOF2_FileExists(markerFile))
                        return ErrorMsg(playerid, "IDF no corresponde a ninguna cuenta registrada (marker file IDs no encontrado).");
        }

        // GASBIZ-CRIT-2 (AUD2-HIGH-007): pagar caja acumulada al dueno anterior
        // antes de transferir ownership. Antes el nuevo dueno heredaba la caja
        // acumulada injustamente. Resolvemos el nombre del dueno anterior via
        // Fuel_Station_ResolveOwnerName (que usa marker file IDs/<IDF>.ini),
        // y modificamos su Contas/<Name>.ini offline (o pBanco en memoria si
        // esta online). Sin esto, el antiguo dueno pierde ingresos legitimos.
        new prevOwnerIDF = FuelStationOwnerIDF[stationid];
        new cajaMonto = FuelStationCaja[stationid];

        // GASBIZ-CRIT-9 (AUD4-CRIT-001): si la estacion ya tiene dueno
        // (prevOwnerIDF > 0), requerir admin nivel 7 (dueno del server) para
        // resetear/transferir. Antes un admin nivel 6 podia resetear el dueno
        // a 0 (robar la gasolinera) o transferirla a otro sin co-sign del
        // dueno del server. El sistema de co-sign de 2 admins seria mas
        // complejo (requiere PVars para almacenar el primer co-sign, timeout,
        // etc.); la mitigacion simple es subir el nivel requerido a 7, que en
        // la practica solo lo tiene el dueno del server. Si prevOwnerIDF == 0
        // (estacion publica), admin 6 sigue siendo suficiente para asignar
        // primer dueno (no hay dueno anterior a perjudicar).
        if(prevOwnerIDF > 0 && PlayerInfo[playerid][pAdmin] < 7)
                return ErrorMsg(playerid, "Esta gasolinera ya tiene dueno. Resetear/transferir requiere admin nivel 7 (dueno del server).");

        // GASBIZ-FASE2-B B7: cancelar refuels activos ANTES de cambiar el dueno.
        // Antes: al transferir ownership de una estacion con refuels en curso,
        // los refuels continuaban procesandose bajo el NUEVO dueno. Si el nuevo
        // dueno subia el precio MID-REPOSTAJE, el costo se calculaba con el
        // precio snapshot al inicio (CRIT-4) Ã¢Â€Â” OK para el dinero, pero el income
        // del refuel en curso iba a la caja del NUEVO dueno (injusto: el fuel
        // cargado fue "vendido" por el dueno anterior). Ahora: cancelamos todos
        // los refuels activos en esta estacion antes de transferir ownership.
        // Fuel_CobrarYFinalizar cobra el fuel ya cargado al jugador, acredita
        // income a FuelStationCaja[stationid] (que todavia pertenece al dueno
        // anterior), y limpia RefuelTime + PVars. El payout block de abajo
        // (CRIT-2) then paga la caja (incluyendo este nuevo income) al dueno
        // anterior. PatrÃƒÂ³n similar al HIGH-005 (deletefuelstation cancela
        // refuels). Refresh de cajaMonto tras el loop para capturar el income
        // nuevo de los refuels cancelados.
        foreach(new j : Player)
        {
                if(IsPlayerConnected(j) && pLogado[j] && RefuelTime[j] > 0
                        && GetPVarInt(j, "FuelStation") == stationid)
                {
                        new _vehidB7 = GetPlayerVehicleID(j);
                        if(_vehidB7 > 0)
                                Fuel_CobrarYFinalizar(j, _vehidB7, "Gasolinera cambio de dueno. Repostaje cancelado.");
                }
        }
        // Refresh de cajaMonto: el loop de arriba pudo haber agregado income a
        // la caja via Fuel_CobrarYFinalizar (linea 1929: FuelStationCaja +=).
        // Sin refresh, el payout al dueno anterior usaria el valor stale
        // capturado en L51615, perdiendo el income de los refuels cancelados.
        cajaMonto = FuelStationCaja[stationid];

        if(prevOwnerIDF > 0 && prevOwnerIDF != duenoIDF && cajaMonto > 0)
        {
                // CRIT-5 (AUD2-CRIT-002): aplicar 5% de impuesto al payout al dueno
                // anterior (mismo calculo que en /gasreclamar). Sin esto, el dueno
                // anterior recibia el 100% del caja acumulado sin tributar, mientras
                // que el dueno actual si tributa al reclamar via /gasreclamar
                // (asimetria fiscal). impuesto = ceil(5% de cajaMonto); neto se
                // acredita al dueno anterior; impuesto se suma a ImpuestoPendiente
                // del dueno anterior si esta online (el jugador lo paga luego en el
                // Ayuntamiento). Offline: el impuesto se descuenta del payout pero
                // no se persiste en ImpuestoPendiente (perdida asimetrica, no dupe).
                new impuesto = floatround(float(cajaMonto) * 0.05, floatround_ceil);
                new neto = cajaMonto - impuesto;
                if(neto < 0) neto = 0;
                // GASBIZ-CRIT-11 (AUD5-CRIT-001): persistir caja=0 ANTES de pagar
                // al dueno anterior. Antes el orden era: (a) income-add al dueno
                // anterior (PlayerInfo[][pBanco]+=neto o DOF2_SetInt), (b)
                // SalvarDados/DOF2_SaveFile (persist income del dueno), (c) caja=0
                // (memoria), (d) SaveFuelStation (persist caja=0, fuera del if).
                // Si crash entre (b) y (d): el dueno anterior recibia el ingreso en
                // disco (persistido) PERO la caja en disco mantenia el monto
                // original (SaveFuelStation no se ejecutaba aun). El nuevo dueno
                // heredaba la caja = DUPE del ingreso. Ahora persistimos caja=0
                // primero; si crash antes del payout al dueno, el ingreso se
                // pierde (loss asimetrico, no dupe). El dueno anterior puede
                // reclamar el ingreso NO persistido solo si hay log manual del
                // admin (no hay log automatico aqui porque el payout no se ejecuto).
                FuelStationCaja[stationid] = 0;
                // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
                // Si falla, no hacer payout (el dueno anterior no recibe ingreso en
                // disco, pero la caja en disco mantiene el monto Ã¢Â€Â” el admin debe
                // reintentar el comando o compensar manualmente). Memory state:
                // caja=0; disk state: caja=original. En reload, disk wins y el
                // dueno anterior mantiene el monto acumulado (reclamable via
                // /gasreclamar). NO es dupe.
                new _saveResPayout = SaveFuelStation(stationid);
                if(_saveResPayout == 0)
                {
                        Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:setduenoestacion (payout block: caja=0 no persistido en disco). Payout cancelado.");
                        return ErrorMsg(playerid, "Error: no se pudo persistir caja=0 en disco. Payout cancelado. Contacta un admin.");
                }
                // Buscar dueno anterior online
                new prevOwnerSlot = -1;
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == prevOwnerIDF)
                        {
                                prevOwnerSlot = p;
                                break;
                        }
                }
                if(prevOwnerSlot != -1)
                {
                        // Online: sumar neto a pBanco en memoria, persistir impuesto en
                        // ImpuestoPendiente (jugador lo paga luego en Ayuntamiento).
                        PlayerInfo[prevOwnerSlot][pBanco] += neto;
                        PlayerInfo[prevOwnerSlot][ImpuestoPendiente] += impuesto;
                        SalvarDados(prevOwnerSlot);
                        new payMsg[256];
                        format(payMsg, sizeof(payMsg), "[SETDUENOESTACION] Tu gasolinera %d fue transferida. Ingresos $%d (-$%d impuesto) acreditados a tu banco. Impuesto pendiente actualizado.", stationid, neto, impuesto);
                        SendClientMessage(prevOwnerSlot, 0x00FF00FF, payMsg);
                }
                else
                {
                        // Offline: resolver nombre via helper y modificar Contas/<Name>.ini.
                        // Antes este codigo intentaba Contas/<IDF>.ini (numerico) que
                        // NUNCA existe -> el payout se perdia. Ahora resolvemos
                        // nombre con el marker file y abrimos Contas/<Name>.ini.
                        // CRIT-5: persistir neto (cajaMonto - impuesto). El impuesto
                        // no se persiste en ImpuestoPendiente offline (per spec CRIT-5).
                        new prevOwnerName[24];
                        if(Fuel_Station_ResolveOwnerName(prevOwnerIDF, prevOwnerName, sizeof(prevOwnerName)))
                        {
                                new accFile[64];
                                format(accFile, sizeof(accFile), PASTA_CONTAS, prevOwnerName);
                                if(DOF2_FileExists(accFile))
                                {
                                        new currentBank = DOF2_GetInt(accFile, "pBanco");
                                        DOF2_SetInt(accFile, "pBanco", currentBank + neto);
                                        DOF2_SaveFile();
                                }
                                // Si no existe el archivo Contas/<Name>.ini, el payout
                                // se pierde (NO es dupe). El admin debe compensar
                                // manualmente. Se loggea abajo para auditoria.
                        }
                        // Si el helper no resolvio nombre (offline y sin marker),
                        // el payout se pierde (NO es dupe). Log para admin.
                }
                // Log de payout para auditoria (online u offline)
                new payLog[300];
                format(payLog, sizeof(payLog), "[SETDUENOESTACION-PAYOUT] Admin %s transfirio estacion %d: pagado $%d (neto) al dueno anterior IDF %d (%s). Impuesto 5%% = $%d.",
                        PlayerName(playerid), stationid, neto, prevOwnerIDF,
                        (prevOwnerSlot != -1) ? "online-memoria" : "offline-disco", impuesto);
                Log("Logs/AdminAcciones.ini", payLog);
                // caja ya reseteada y persistida arriba (CRIT-11)
        }

        FuelStationOwnerIDF[stationid] = duenoIDF;
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        // Esta llamada persiste el nuevo OwnerIDF (y caja=0 si entro al payout).
        // Si falla, el disco mantiene el OwnerIDF anterior (el admin ve ErrorMsg
        // y debe reintentar). Memory state: OwnerIDF=duenoIDF; disk state:
        // OwnerIDF=prevOwnerIDF. En reload, disk wins y el dueno anterior
        // permanece Ã¢Â€Â” el admin debe repetir el comando (el payout block NO se
        // re-ejecuta porque prevOwnerIDF seguira siendo el mismo, y el monto de
        // caja ya esta a 0 Ã¢Â€Â” loss asimetrico, no dupe).
        new _saveResFinal = SaveFuelStation(stationid);
        if(_saveResFinal == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:setduenoestacion (final: nuevo OwnerIDF no persistido en disco).");
                return ErrorMsg(playerid, "Error: no se pudo persistir el nuevo dueno en disco. Contacta un admin.");
        }
        UpdateFuelStation(stationid, 1); // GASBIZ-CRIT-3: refrescar 3D label con nuevo dueno

        if(duenoIDF == 0)
                format(msg, sizeof(msg), "Estacion %d ahora es publica (sin dueno).", stationid);
        else
                format(msg, sizeof(msg), "Estacion %d: dueno seteado a IDF %d.", stationid, duenoIDF);
        SuccesMsg(playerid, msg);

        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[SETDUENOESTACION] Admin %s (IDF %d) seteo dueno de estacion %d a IDF %d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], stationid, duenoIDF);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// ==================== GAS-STATION-BUSINESS: Comandos de gestion ====================

// /comprargasolinera [id] - jugador compra una gasolinera del servidor
CMD:comprargasolinera(playerid, params[])
{
        new stationid;
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USE: /comprargasolinera [id]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID de gasolinera invalido");
        // GASBIZ-FASE2-A A3 (AUD4-HIGH-007 defense-in-depth): validar IDF
        // valido ANTES de transferir propiedad. Sin IDF, el jugador no
        // podria reclamar la caja (CRIT-9 en /gasreclamar exige
        // FuelStationOwnerIDF == PlayerInfo[playerid][IDF] && IDF > 0).
        // Tambien previene que un slot corrupto (IDF=0) se convierta en
        // dueno fantasma (la estacion quedaria sin dueno reclamble).
        if(PlayerInfo[playerid][IDF] <= 0) return ErrorMsg(playerid, "Tu cuenta no tiene IDF valido.");
        if(FuelStationOwnerIDF[stationid] != 0) return ErrorMsg(playerid, "Esta gasolinera ya tiene dueno.");
        if(PlayerInfo[playerid][pDinheiro] < FuelStationValor[stationid]) {
                new msg[128];
                format(msg, sizeof(msg), "Necesitas $%d para comprar esta gasolinera.", FuelStationValor[stationid]);
                return ErrorMsg(playerid, msg);
        }
        // GASBIZ-FASE2-B C1: cancelar refuels activos ANTES de transferir
        // ownership. Antes: al comprar una gasolinera publica con refuels en
        // curso, los refuels continuaban procesandose bajo el NUEVO dueno.
        // Aunque CRIT-4 (precio snapshot) protege el costo para el jugador,
        // el income del refuel en curso iba a la caja del NUEVO dueno Ã¢Â€Â” pero
        // al momento del buy, FuelStationOwnerIDF == 0, asi que
        // Fuel_CobrarYFinalizar (L1925-1929) NO acreditaba income a la caja
        // (linea 1927: `if(costAPagar > 0 && FuelStationOwnerIDF[stationid] > 0)`
        // fallaba). El jugador pagaba el fuel pero nadie recibia el income
        // (money sink). Y el refuel continuaba con el NUEVO dueno debido al
        // PVar "FuelStation" ya seteado, generando income retroactivo no
        // deseado una vez el dueno estuviera asignado. Ahora: cancelamos
        // todos los refuels activos en esta estacion antes de la transferencia
        // de ownership. Mismo patron que B7 en /setduenoestacion. Los
        // jugadores repostando reciben InfoMsg de cancelacion + cobro por el
        // fuel ya cargado. Income no acreditado (estacion publica, owner=0).
        foreach(new j : Player)
        {
                if(IsPlayerConnected(j) && pLogado[j] && RefuelTime[j] > 0
                        && GetPVarInt(j, "FuelStation") == stationid)
                {
                        new _vehidC1 = GetPlayerVehicleID(j);
                        if(_vehidC1 > 0)
                                Fuel_CobrarYFinalizar(j, _vehidC1, "Gasolinera comprada. Repostaje cancelado.");
                }
        }
        AC_AddPlayerMoney(playerid, -FuelStationValor[stationid]);
        // FIX AUDIT2 AGENT2 M-05: SalvarDados antes de SaveFuelStation.
        // La gasolinera se persiste via SaveFuelStation (transferencia de
        // dueno). Sin SalvarDados, si crash antes del SaveTimer, el jugador
        // obtiene la gasolinera gratis (dinero en disco = original).
        SalvarDados(playerid);
        FuelStationOwnerIDF[stationid] = PlayerInfo[playerid][IDF];
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        // Si falla, el jugador ya pago (AC_AddPlayerMoney + SalvarDados) pero
        // el dueno no se persistio en disco. En reload, la gasolinera vuelve
        // a ser del servidor Ã¢Â€Â” el jugador pierde el dinero (loss asimetrico,
        // no dupe). Log para que el admin compense manualmente al jugador.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:comprargasolinera (nuevo dueno no persistido). Jugador perdio el dinero.");
                return ErrorMsg(playerid, "Error: no se pudo guardar la transferencia de dueno en disco. Contacta un admin para compensar.");
        }
        new msg[180];
        format(msg, sizeof(msg), "Compraste '%s' (ID %d) por $%d. Eres el nuevo propietario.", FuelStationName[stationid], stationid, FuelStationValor[stationid]);
        SuccesMsg(playerid, msg);
        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[COMPRARGASOLINERA] %s (IDF %d) compro gasolinera %d por $%d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], stationid, FuelStationValor[stationid]);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// /gestiongas - menu de gestion para duenos de gasolineras
CMD:gestiongas(playerid)
{
        // Buscar gasolineras del jugador
        new ownedStations[10], count = 0;
        for(new s = 1; s < MAX_FUEL_STATIONS && count < 10; s++)
        {
                if(FuelStationCreated[s] && FuelStationOwnerIDF[s] == PlayerInfo[playerid][IDF])
                {
                        ownedStations[count] = s;
                        count++;
                }
        }
        if(count == 0) return ErrorMsg(playerid, "No eres dueno de ninguna gasolinera.");
        new menu[512];
        for(new i = 0; i < count; i++)
        {
                new s = ownedStations[i];
                new line[100];
                format(line, sizeof(line), "{FFFF00}%s{FFFFFF} (ID %d) - Gas: %d/%d  Pet: %d/%d  %s\n",
                        FuelStationName[s], s,
                        FuelStationGasolinaStock[s], FuelStationGasolinaCap[s],
                        FuelStationPetroleoStock[s], FuelStationPetroleoCap[s],
                        FuelStationAbierta[s] ? "{00FF00}Abierta" : "{FF0000}Cerrada");
                strcat(menu, line, sizeof(menu));
        }
        SetPVarInt(playerid, "GestionGasCount", count);
        for(new i = 0; i < count; i++)
        {
                new pvarName[32];
                format(pvarName, sizeof(pvarName), "GestionGas_%d", i);
                SetPVarInt(playerid, pvarName, ownedStations[i]);
        }
        ShowPlayerDialog(playerid, DIALOG_GAS_GESTION, DIALOG_STYLE_LIST, "Mis Gasolineras", menu, "Gestionar", "X");
        return 1;
}

// /gasinfo [id] - admin ve info completa de una gasolinera
CMD:gasinfo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        new stationid;
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USE: /gasinfo [id]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        // GASBIZ-CRIT-3: usar helper que resuelve IDF->Name via marker file
        // IDs/<IDFzero-padded>.ini (key "IDF de:") en vez de Contas/<IDF>.ini
        // (que no existe: SalvarDados escribe Contas/<Name>.ini). Antes
        // /gasinfo siempre mostraba "Desconocido (offline)" para duenos offline.
        new ownerName[24];
        Fuel_Station_ResolveOwnerName(FuelStationOwnerIDF[stationid], ownerName, sizeof(ownerName));
        new lastRestock[32];
        if(FuelStationLastRestock[stationid] > 0)
        {
                new diff = gettime() - FuelStationLastRestock[stationid];
                new days = diff / 86400;
                new hours = (diff % 86400) / 3600;
                format(lastRestock, sizeof(lastRestock), "Hace %dd %dh", days, hours);
        }
        else lastRestock = "Nunca";
        new info[512];
        format(info, sizeof(info),
                "{FFFF00}=== %s (ID %d) ===\n\n\
                {FFFFFF}Propietario: {FFFF00}%s (IDF %d)\n\
                {FFFFFF}Gasolina: {00FF00}%d / %d L\n\
                {FFFFFF}Petroleo: {00FF00}%d / %d L\n\
                {FFFFFF}Precio Gas: {FFFF00}$%d/L (max %d)\n\
                {FFFFFF}Precio Pet: {FFFF00}$%d/L (max %d)\n\
                {FFFFFF}Valor: {00FF00}$%d\n\
                {FFFFFF}Estado: %s\n\
                {FFFFFF}Ultimo abastecimiento: {FFFF00}%s\n\
                {FFFFFF}Caja acumulada: {00FF00}$%d",
                FuelStationName[stationid], stationid,
                ownerName, FuelStationOwnerIDF[stationid],
                FuelStationGasolinaStock[stationid], FuelStationGasolinaCap[stationid],
                FuelStationPetroleoStock[stationid], FuelStationPetroleoCap[stationid],
                FuelStationPrecioGasolina[stationid], FS_MAX_PRECIO_GAS,
                FuelStationPrecioDiesel[stationid], FS_MAX_PRECIO_PET,
                FuelStationValor[stationid],
                FuelStationAbierta[stationid] ? "{00FF00}Abierta" : "{FF0000}Cerrada",
                lastRestock,
                FuelStationCaja[stationid]);
        ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Info Gasolinera", info, "Cerrar", "");
        return 1;
}

// /gasnombre [id] [nombre] - dueno o admin cambia el nombre
CMD:gasnombre(playerid, params[])
{
        new stationid, nombre[32];
        if(sscanf(params, "ds[32]", stationid, nombre)) return ErrorMsg(playerid, "USE: /gasnombre [id] [nombre]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        new bool:esAdmin = (PlayerInfo[playerid][pAdmin] >= 6);
        new bool:esDueno = (FuelStationOwnerIDF[stationid] == PlayerInfo[playerid][IDF] && PlayerInfo[playerid][IDF] > 0);
        if(!esAdmin && !esDueno) return ErrorMsg(playerid, "No eres dueno ni admin.");
        // GASBIZ-FASE2-B C5: sanitizar INI injection en FuelStationName. Antes:
        // el nombre se persistia via SaveFuelStation (linea
        // `format(line, sizeof(line), "Name=%s\r\n", FuelStationName[stationid])`)
        // sin sanitizar. Un admin/dueno malicioso podia inyectar:
        // - '=' para crear/overridear keys arbitrarias (ej. nombre
        //   "x\r\nOwnerIDF=999" cambiaria el dueno a IDF 999).
        // - '\r' y '\n' para inyectar nuevas lineas y sobrescribir campos
        //   del .ini (ej. "x\r\nCaja=9999999" seteaba la caja a 9.9M).
        // - '{' para prevenir secciones INI raras (DOF2/fopen parser
        //   podria interpretar `{section}` como inicio de seccion).
        // El task spec dice "loop de sanitizacion que ya existe (busca
        // nombre[c] == '{')" Ã¢Â€Â” el loop no existia previamente en este
        // comando, asi que se anade completo con los 4 checks (`{`, `=`,
        // `\r`, `\n`). Mismo patron aplicado a CMD:addfuelstation (C5).
        for(new c = 0; c < strlen(nombre); c++)
        {
                if(nombre[c] == '{') nombre[c] = '-';
                if(nombre[c] == '=') nombre[c] = '-';
                if(nombre[c] == '\r') nombre[c] = ' ';
                if(nombre[c] == '\n') nombre[c] = ' ';
        }
        format(FuelStationName[stationid], 32, "%s", nombre);
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:gasnombre (nombre no persistido en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar el nombre en disco. Contacta un admin.");
        }
        new msg[100];
        format(msg, sizeof(msg), "Gasolinera %d renombrada a '%s'.", stationid, nombre);
        SuccesMsg(playerid, msg);
        // GASBIZ-FASE2-B B1: notificar al dueno online del cambio admin.
        // Solo si la estacion tiene dueno y el dueno NO es el caller (evitar
        // notificacion redundante cuando el dueno renombra su propia estacion).
        if(FuelStationOwnerIDF[stationid] > 0 && PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
        {
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == FuelStationOwnerIDF[stationid])
                        {
                                new _ownerNotify[160];
                                format(_ownerNotify, sizeof(_ownerNotify), "Un admin ha renombrado tu gasolinera (ID %d) a '%s'.", stationid, nombre);
                                InfoMsg(p, _ownerNotify);
                                break;
                        }
                }
        }
        return 1;
}

// /gasabrir [id] - dueno abre su gasolinera
CMD:gasabrir(playerid, params[])
{
        new stationid;
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USE: /gasabrir [id]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(FuelStationOwnerIDF[stationid] != PlayerInfo[playerid][IDF]) return ErrorMsg(playerid, "No eres dueno de esta gasolinera.");
        FuelStationAbierta[stationid] = true;
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:gasabrir (estado no persistido en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar el estado en disco. Contacta un admin.");
        }
        SuccesMsg(playerid, "Gasolinera abierta.");
        // GASBIZ-FASE2-B B1: notificar al dueno online del cambio admin.
        // Caso tipico: el dueno es el caller (el comando exige ser dueno).
        // El guard `PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid]`
        // cubre el edge case donde un admin nivel 7 forzar abriria una
        // gasolinera de otro dueno via un path admin (no existe hoy pero
        // defense-in-depth). Para no spamear al dueno con su propia accion,
        // solo notificamos si el caller NO es el dueno.
        if(FuelStationOwnerIDF[stationid] > 0 && PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
        {
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == FuelStationOwnerIDF[stationid])
                        {
                                InfoMsg(p, "Un admin ha abierto tu gasolinera.");
                                break;
                        }
                }
        }
        return 1;
}

// /gascerrar [id] - dueno cierra su gasolinera
CMD:gascerrar(playerid, params[])
{
        new stationid;
        if(sscanf(params, "d", stationid)) return ErrorMsg(playerid, "USE: /gascerrar [id]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(FuelStationOwnerIDF[stationid] != PlayerInfo[playerid][IDF]) return ErrorMsg(playerid, "No eres dueno de esta gasolinera.");
        FuelStationAbierta[stationid] = false;
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:gascerrar (estado no persistido en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar el estado en disco. Contacta un admin.");
        }
        SuccesMsg(playerid, "Gasolinera cerrada.");
        // GASBIZ-FASE2-B B1: notificar al dueno online del cambio admin.
        // Mismo guard que /gasabrir: solo notificar si el caller NO es el dueno.
        if(FuelStationOwnerIDF[stationid] > 0 && PlayerInfo[playerid][IDF] != FuelStationOwnerIDF[stationid])
        {
                foreach(new p : Player)
                {
                        if(pLogado[p] && PlayerInfo[p][IDF] == FuelStationOwnerIDF[stationid])
                        {
                                InfoMsg(p, "Un admin ha cerrado tu gasolinera.");
                                break;
                        }
                }
        }
        return 1;
}

// /gasrestock [id] [tipo] [litros] - dueno solicita abastecimiento
// tipo: 1=gasolina, 2=petroleo. Costo: $1-2/L aleatorio. Instantaneo por ahora (traileros despues).
CMD:gasrestock(playerid, params[])
{
        new stationid, tipo, litros;
        if(sscanf(params, "ddd", stationid, tipo, litros)) return ErrorMsg(playerid, "USE: /gasrestock [id] [tipo 1=gas 2=pet] [litros]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(FuelStationOwnerIDF[stationid] != PlayerInfo[playerid][IDF]) return ErrorMsg(playerid, "No eres dueno de esta gasolinera.");
        if(tipo < 1 || tipo > 2) return ErrorMsg(playerid, "Tipo invalido (1=gasolina, 2=petroleo)");
        if(litros < 1 || litros > 50000) return ErrorMsg(playerid, "Litros invalidos (1-50000)");

        // Verificar espacio disponible
        new espacioDisponible;
        if(tipo == 1)
        {
                espacioDisponible = FuelStationGasolinaCap[stationid] - FuelStationGasolinaStock[stationid];
                if(litros > espacioDisponible)
                {
                        new msg[100];
                        format(msg, sizeof(msg), "Capacidad insuficiente. Espacio disponible: %d L.", espacioDisponible);
                        return ErrorMsg(playerid, msg);
                }
        }
        else
        {
                espacioDisponible = FuelStationPetroleoCap[stationid] - FuelStationPetroleoStock[stationid];
                if(litros > espacioDisponible)
                {
                        new msg[100];
                        format(msg, sizeof(msg), "Capacidad insuficiente. Espacio disponible: %d L.", espacioDisponible);
                        return ErrorMsg(playerid, msg);
                }
        }

        // Precio de compra: $1 o $2 aleatorio por litro
        new precioPorLitro = 1 + random(2); // 1 o 2
        new costoTotal = litros * precioPorLitro;
        if(PlayerInfo[playerid][pDinheiro] < costoTotal)
        {
                new msg[128];
                format(msg, sizeof(msg), "Dinero insuficiente. Costo: $%d ($%d/L x %d L)", costoTotal, precioPorLitro, litros);
                return ErrorMsg(playerid, msg);
        }

        AC_AddPlayerMoney(playerid, -costoTotal);
        if(tipo == 1)
                FuelStationGasolinaStock[stationid] += litros;
        else
                FuelStationPetroleoStock[stationid] += litros;
        FuelStationLastRestock[stationid] = gettime();
        UpdateFuelStation(stationid, 1);
        // FIX AUDIT2 AGENT2 M-06: SalvarDados antes de SaveFuelStation.
        // El stock de la gasolinera se persiste via SaveFuelStation. Sin
        // SalvarDados, si crash antes del SaveTimer, el jugador obtiene el
        // stock gratis (dinero en disco = original).
        SalvarDados(playerid);
        SaveFuelStation(stationid);

        new msg[180];
        format(msg, sizeof(msg), "Abastecimiento completado: %d L de %s por $%d ($%d/L).", litros, tipo == 1 ? "gasolina" : "petroleo", costoTotal, precioPorLitro);
        SuccesMsg(playerid, msg);

        new logmsg[200];
        format(logmsg, sizeof(logmsg), "[GASRESTOCK] %s (IDF %d) abastecio gasolinera %d: %d L %s por $%d",
                PlayerName(playerid), PlayerInfo[playerid][IDF], stationid, litros, tipo == 1 ? "gasolina" : "petroleo", costoTotal);
        Log("Logs/AdminAcciones.ini", logmsg);
        return 1;
}

// /gassetcap [id] [capGas] [capPet] - admin setea capacidades
CMD:gassetcap(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        new stationid, capGas, capPet;
        if(sscanf(params, "ddd", stationid, capGas, capPet)) return ErrorMsg(playerid, "USE: /gassetcap [id] [capGas] [capPet]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(capGas < 1000 || capGas > 100000) return ErrorMsg(playerid, "Capacidad gasolina invalida (1000-100000)");
        if(capPet < 500 || capPet > 100000) return ErrorMsg(playerid, "Capacidad petroleo invalida (500-100000)");
        FuelStationGasolinaCap[stationid] = capGas;
        FuelStationPetroleoCap[stationid] = capPet;
        // Clamp stock si excede nueva capacidad
        if(FuelStationGasolinaStock[stationid] > capGas) FuelStationGasolinaStock[stationid] = capGas;
        if(FuelStationPetroleoStock[stationid] > capPet) FuelStationPetroleoStock[stationid] = capPet;
        UpdateFuelStation(stationid, 1);
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:gassetcap (capacidades no persistidas en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar las capacidades en disco. Contacta un admin.");
        }
        new msg[128];
        format(msg, sizeof(msg), "Capacidades actualizadas: Gas %dL, Pet %dL.", capGas, capPet);
        SuccesMsg(playerid, msg);
        return 1;
}

// /gassetvalor [id] [valor] - admin setea precio de compra de la gasolinera
CMD:gassetvalor(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        new stationid, valor;
        if(sscanf(params, "dd", stationid, valor)) return ErrorMsg(playerid, "USE: /gassetvalor [id] [valor]");
        if(!IsValidFuelStation(stationid)) return ErrorMsg(playerid, "ID invalido");
        if(valor < 100000 || valor > 50000000) return ErrorMsg(playerid, "Valor invalido (100000-50000000)");
        if(FuelStationOwnerIDF[stationid] != 0) return ErrorMsg(playerid, "No se puede cambiar el valor de una gasolinera con dueno.");
        FuelStationValor[stationid] = valor;
        // GASBIZ-CRIT-8 (AUD3-CRIT-003): verificar return de SaveFuelStation.
        new _saveRes = SaveFuelStation(stationid);
        if(_saveRes == 0)
        {
                Log("Logs/AdminAcciones.ini", "[GASBIZ-CRIT-8] SaveFuelStation fallo en CMD:gassetvalor (valor no persistido en disco).");
                return ErrorMsg(playerid, "Error: no se pudo guardar el valor en disco. Contacta un admin.");
        }
        new msg[128];
        format(msg, sizeof(msg), "Valor de gasolinera %d seteado a $%d.", stationid, valor);
        SuccesMsg(playerid, msg);
        return 1;
}

CMD:radio(playerid, params[])
{
        new freq;
        if(sscanf(params, "d", freq)) return ErrorMsg(playerid, "Uso: /freq [FREQ. 1-1000 (0 Desligar)]");
        if(freq > MAX_FREQUENCIAS || freq < 0) return ErrorMsg(playerid, "Freq Invalida!");
        // FIX AUDIT AGENT3 SP-09: sin cooldown, un policial podia spamear /radio 190
        // para llenar el chat de radio con "X salio / X entro" miles de veces.
        // Adicionalmente, cada llamada hace 2 broadcasts a frecuencia + 1 SetTimerEx.
        // Cooldown 3s (suficiente para cambios legitimos pero no para flood).
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_radio") < 3)
                return ErrorMsg(playerid, "Espera 3s para cambiar de frecuencia de nuevo.");
        SetPVarInt(playerid, "CD_radio", now);
        // Anti-loop: si el jugador ya esta en la frecuencia solicitada, no hacer nada
        if(FrequenciaConectada[playerid] == freq && freq != 0)
                return InfoMsg(playerid, "Ya estas conectado a esa frecuencia."), 1;
        // FIX AUDIT2 AGENT4 S-13: estructura if-if-else mal formada. Antes:
        // if(freq==0) { ... } if(freq==190) { ... } else { ... }
        // Si freq==0, el primer if ejecuta, Y como freq!=190, el else tambien
        // ejecuta, conectando a freq 0. Fix: cambiar segundo if a else if.
        if(freq == 0)
        {
                FrequenciaConectada[playerid] = 0;
                InfoMsg(playerid, "Radio desligado!");
                SvDetachListenerFromStream(Frequencia[freq], playerid);
                FrequenciaConectada[playerid] = 0;
        }
        else if(freq == 190)
        {
                if(IsPolicial(playerid))
                {
                        new string[128];
                        format(string, 128, "Frequencia conectada: (%d).", freq);
                        SuccesMsg(playerid, string);

                        format(string, 128, "%04d salio de la frecuencia(%d)", GetPlayerIdfixo(playerid), FrequenciaConectada[playerid]);
                        MsgFrequencia(FrequenciaConectada[playerid], 0xBF0000FF, string);
                        format(string, 128, "%04d entro en la frecuencia(%d)", GetPlayerIdfixo(playerid), freq);
                        MsgFrequencia(freq, 0xFF6C00FF, string);

                        SetTimerEx("ConectarNaFrequencia", 100, false, "id", playerid, freq);
                }
                else
                {
                        ErrorMsg(playerid, "Sin permiso para usar esa frecuencia!");
                }
        } 
        else 
        {
                new string[128];
                format(string, 128, "Frequencia conectada: (%d).", freq);
                SuccesMsg(playerid, string);

                format(string, 128, "%04d salio de la frecuencia(%d)", GetPlayerIdfixo(playerid), FrequenciaConectada[playerid]);
                MsgFrequencia(FrequenciaConectada[playerid], 0xBF0000FF, string);
                format(string, 128, "%04d entro en la frecuencia(%d)", GetPlayerIdfixo(playerid), freq);
                MsgFrequencia(freq, 0xFF6C00FF, string);

                SetTimerEx("ConectarNaFrequencia", 100, false, "id", playerid, freq);
        }
        for(new i; i < 32; i++)
        {
                PlayerTextDrawHide(playerid, RadioVOIP[playerid][i]);
                if(i == 32)break;
        }
        CancelSelectTextDraw(playerid);
        return 1;
}


CMD:en(playerid)
{
        if(PlayerInfo[playerid][pVIP] < 2)                                              return ErrorMsg(playerid, "No tienes permisos.");
        FomePlayer[playerid] = 100;
        SedePlayer[playerid] = 100;
        return 1;
}
CMD:mudarskin(playerid, params[])
{
        if(PlayerInfo[playerid][pVIP] < 2)                                              return ErrorMsg(playerid, "No tienes permisos.");
        if(MostrandoMenu[playerid] == false)
        {
                TextDrawShowForPlayer(playerid, TDCadastro[2]);
                TextDrawShowForPlayer(playerid, TDCadastro[3]);
                for(new i=0;i<7;i++){
                        PlayerTextDrawShow(playerid, TDCadastro_p[playerid][i]);
                        if(i == 7)break;
                }
                MostrandoMenu[playerid] = true;
                SelectTextDraw(playerid, 0xFF0000FF);
                InfoMsg(playerid, "Utilice la tecla F para cancelar el cambio de skin y eliminar el tde.");
        }
        else
        {
                TextDrawHideForPlayer(playerid, TDCadastro[2]);
                TextDrawHideForPlayer(playerid, TDCadastro[3]);
                for(new i=0;i<7;i++){
                        PlayerTextDrawHide(playerid, TDCadastro_p[playerid][i]);
                        if(i == 7)break;
                }
                MostrandoMenu[playerid] = false;
                SalvarDadosSkin(playerid);
                CancelSelectTextDraw(playerid);
        }
        return 1;
}


