//
//   HALLAZGO PRINCIPAL CONFIRMADO POR LOS 5 AGENTES:
//   El "arresto fantasma" que reportaba el usuario NO existe como tal.
//   El SendClientMessageToAll esta DENTRO del if(PlayerToPoint), por lo que
//   si el oficial no esta en el garaje LSPD: NO se anuncia, NO se arresta,
//   NO se muestra error. El bug real es SILENT FAILURE (el comando no hace
//   nada y no le dice al oficial por que).
//
//   8 FIXES CRITICOS APLICADOS:
//   [C1] Numero <= 0 validation: agregado `if(Numero <= 0) return ErrorMsg`
//        antes de continuar (antes Numero=0 o negativo causaba jail permanente).
//   [C2] arrestedTerrID guardado ANTES del teleport: Terr_ZonaDelJugador(i)
//        se llamaba DESPUES de SetPlayerPos (preso ya en celda = siempre -1).
//        El decomiso policial NUNCA funcionaba. Ahora se guarda antes.
//   [C3] else con ErrorMsg: si el oficial no esta en garaje LSPD, ahora
//        recibe "Debes estar en el garaje del LSPD para arrestar al sospechoso."
//        (antes era silent failure).
//   [C4] Mensaje de bonus enviado: el format(str, "Recibiste bonificacion...")
//        se hacia pero NUNCA se enviaba con SendClientMessage. Dead code.
//   [C5] Cell leak en re-arresto: si el preso ya tenia celda asignada, no
//        se liberaba antes de asignar nueva. Agregado FreeJailCell(i) antes
//        de AssignJailCell(i) si ya tenia celda.
//   [C6] pCongelado reset: el preso quedaba permanentemente algemado en estado
//        pCongelado=true. Agregado PlayerInfo[i][pCongelado] = false al arrestar.
//   [C7] Esposas visuales removidas: no se llamaba RemovePlayerAttachedObject(i,5)
//        ni SetPlayerSpecialAction(SPECIAL_ACTION_NONE). Las esposas visuales
//        persistian en la celda. Agregado.
//   [C8] Decomiso policial ahora funciona: todas las referencias a terrID
//        cambiadas a arrestedTerrID (guardado antes del teleport). El bloque
//        de decomiso era dead code total.
//   Adicional: SalvarDados(playerid) despues de bonus al banco (persistir pago).
//   [C9 CRITICO] RetirarItem OOB access: la funcion original usaba `modelid` como
//     indice directo del array PlayerInventario (33 slots, indices 0-32), pero los
//     callers pasan modelids > 32 (1212, 854, 1279, etc.) = array index out of bounds.
//     Los items ilegales NO se confiscaban. Reescrita para buscar por slot (recorre
//     los 33 slots buscando el modelid correcto). Ahora los presos pierden sus items.
//   [C10 CRITICO] Reconnect jail bypass: si un preso se desconectaba con pjail > 0 y
//     reconectaba, NO volvia a la celda (g_PlayerCell se resetea en RAM). Agregado
//     chequeo en OnPlayerSpawn: si pjail > 0, asignar celda y teleportar de vuelta.
// =====================================================================
//
// [2026-08-10 23:58] [FIX-ARRESTO-FINAL] [P0-FIX-ARRESTO-FINAL] - Fixes finales
//   del sistema de arresto:
//   - RetirarItem reescrita (C9): ahora busca por slot, no por modelid como indice
//   - Reconnect jail fix (C10): OnPlayerSpawn verifica pjail > 0 y teleporta a celda
//   Ambos bugs eran CRITICOS: items no se confiscaban + jail bypass por reconnect.
// =====================================================================
//
// [2026-08-11 00:34] [AUDIT-ASSIGNJAILCELL-6P] [P0-FIX-ASSIGNJAILCELL] - Fixes
//   tras auditoria exhaustiva con 5 agentes + 6to (yo) sobre AssignJailCell:
//
//   BUG CRITICO #2 CONFIRMADO POR LOS 5 AGENTES:
//   AssignJailCell NO verificaba g_PlayerCell[playerid] != -1 antes de asignar
//   nueva celda. Si un jugador era arrestado dos veces (via /prender o /jail admin),
//   la celda previa quedaba marcada como ocupada permanentemente. Tras 6 re-arrestos
//   acumulados, todas las celdas quedaban stale -> fallback permanente a celda 0.
//
//   4 FIXES CRITICOS APLICADOS:
//   [C1] AssignJailCell: agregado FreeJailCell(playerid) al inicio de la funcion.
//        Si el jugador ya tenia celda asignada, se libera antes de asignar nueva.
//        Fix de 1 linea que resuelve el bug principal.
//   [C2] AssignJailCell: agregado bounds check if(playerid < 0 || playerid >= MAX_PLAYERS)
//        para evitar OOB access.
//   [C3] ZerarDados: agregado FreeJailCell(playerid) para resetear celda al reconectar
//        (defensa en profundidad contra slot-reuse).
//   [C4] SalvarDados(i) + SalvarInventario(i) despues de arrestar: persistir pjail y
//        inventario confiscado del preso. Antes si el server crasheaba entre el arresto
//        y el proximo SalvarDados, el preso perdia el jail time.
//   [C5] Checkjail: cambiado if(pjail == 0) a if(pjail <= 0) para liberar presos con
//        pjail negativo (causado por Numero <= 0 que ya fue validado pero defensa en
//        profundidad).
// =====================================================================

// =====================================================================
// FASE 5: CONTRABANDO DE ARMAS
// =====================================================================

// Inicializar ofertas de arma al arrancar el servidor
stock CArmas_Init()
{
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        g_OfertasArma[i][oa_activa] = false;
        g_OfertasArma[i][oa_vendedorIDF] = 0;
        g_OfertasArma[i][oa_vendedorPlayerid] = -1;
        g_OfertasArma[i][oa_vendedorOrg] = 0;
        g_OfertasArma[i][oa_itemID] = 0;
        g_OfertasArma[i][oa_armaID] = 0;
        g_OfertasArma[i][oa_precio] = 0;
        g_OfertasArma[i][oa_cantidad] = 0;
        g_OfertasArma[i][oa_timestamp] = 0;
        g_OfertasArma[i][oa_nombreArma][0] = EOS;
    }
    printf("[P0-FASE5-CONTRABANDO] Sistema inicializado. %d slots de oferta disponibles.", MAX_OFERTAS_ARMA);
    return 1;
}

// Buscar slot libre de oferta
stock CArmas_SlotLibre()
{
    new nowTs = gettime();
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        // Reusar slots expirados
        if(g_OfertasArma[i][oa_activa] && (nowTs - g_OfertasArma[i][oa_timestamp]) > OFERTA_ARMA_EXPIRE)
        {
            g_OfertasArma[i][oa_activa] = false;
            return i;
        }
        if(!g_OfertasArma[i][oa_activa]) return i;
    }
    return -1;
}

// Actualizar el playerid del vendedor por su IDF (por si reconecto)
stock CArmas_ActVendedor()
{
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        if(!g_OfertasArma[i][oa_activa]) continue;
        // Buscar si el vendedor sigue online
        new encontrado = false;
        foreach(new p : Player)
        {
            if(pLogado[p] && PlayerInfo[p][IDF] == g_OfertasArma[i][oa_vendedorIDF])
            {
                g_OfertasArma[i][oa_vendedorPlayerid] = p;
                encontrado = true;
                break;
            }
        }
        if(!encontrado)
            g_OfertasArma[i][oa_vendedorPlayerid] = -1;
    }
    return 1;
}

// Cancelar todas las ofertas de un jugador (al desconectarse)
stock CArmas_CancelPorPlayer(playerid)
{
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        if(!g_OfertasArma[i][oa_activa]) continue;
        if(g_OfertasArma[i][oa_vendedorIDF] == PlayerInfo[playerid][IDF])
        {
            // Devolver el arma al inventario del vendedor
            // (solo si el item sigue existiendo - el itemID es el model del inventario)
            // Nota: no podemos llamar GanharItem aqui porque el jugador se esta desconectando,
            // el inventario se guardara mas tarde. Solo marcamos la oferta como cancelada.
            // El arma YA fue removida del inventario al crear la oferta, asi que la perdida es real.
            // SOLUCION: re-agregar el item al inventario antes de que se guarde.
            GanharItem(playerid, g_OfertasArma[i][oa_itemID], g_OfertasArma[i][oa_cantidad]);
            SalvarInventario(playerid);
            g_OfertasArma[i][oa_activa] = false;
            g_OfertasArma[i][oa_vendedorIDF] = 0;
            g_OfertasArma[i][oa_vendedorPlayerid] = -1;
            g_OfertasArma[i][oa_vendedorOrg] = 0;
            printf("[P0-FASE5] Oferta %d cancelada por desconexion del vendedor (IDF %d). Item %d devuelto.",
                   i, PlayerInfo[playerid][IDF], g_OfertasArma[i][oa_itemID]);
        }
    }
    return 1;
}

// Limpiar ofertas expiradas (llamar periodicamente o al consultar /ofertasarma)
stock CArmas_LimpiarExp()
{
    new nowTs = gettime();
    new limpiadas = 0;
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        if(!g_OfertasArma[i][oa_activa]) continue;
        if((nowTs - g_OfertasArma[i][oa_timestamp]) > OFERTA_ARMA_EXPIRE)
        {
            // Devolver el arma al vendedor si sigue online
            CArmas_ActVendedor();
            new vp = g_OfertasArma[i][oa_vendedorPlayerid];
            if(vp != -1 && IsPlayerConnected(vp) && pLogado[vp])
            {
                GanharItem(vp, g_OfertasArma[i][oa_itemID], g_OfertasArma[i][oa_cantidad]);
                SalvarInventario(vp);
                new msgExp[140];
                format(msgExp, sizeof(msgExp), "[CONTRABANDO] Tu oferta de %s expiro. El arma volvio a tu inventario.", g_OfertasArma[i][oa_nombreArma]);
                InfoMsg(vp, msgExp);
            }
            g_OfertasArma[i][oa_activa] = false;
            limpiadas++;
        }
    }
    return limpiadas;
}

// /venderarma [nombreArma] [cantidad] [precio]
// FASE 5 MEJORA: ahora acepta NOMBRE del arma en vez de ID numerico.
// El jugador puede escribir nombres cortos como "desert", "ak47", "mp5", "shotgun", etc.
// Tambien acepta "dinero" para Dinero Sucio y "piezas" para Piezas de Fabricacion.
// Usa /listarmas para ver los nombres disponibles y que tienes en inventario.
CMD:venderarma(playerid, params[])
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    if(!IsBandido(playerid)) return ErrorMsg(playerid, "Solo las bandas pueden vender armas en el mercado negro.");
    new nombreArma[32], cantidad, precio;
    if(sscanf(params, "s[32]ii", nombreArma, cantidad, precio))
        return ErrorMsg(playerid, "USE: /venderarma [nombreArma] [cantidad] [precio]. Ej: /venderarma desert 100 5000 (Desert Eagle 100 balas por $5000). Usa /listarmas para ver nombres.");
    if(cantidad < 1 || cantidad > 9999)
        return ErrorMsg(playerid, "Cantidad invalida. Usa entre 1 y 9999.");
    if(precio < 100)
        return ErrorMsg(playerid, "Precio minimo: $100.");
    if(precio > 1000000)
        return ErrorMsg(playerid, "Precio maximo: $1,000,000.");
    // Resolver el nombre del arma a itemID
    new itemID = 0;
    new esArma = false;
    // Nota: esDineroSucio y esPiezas se eliminaron (no se usaban, ItemNomeInv resuelve el nombre)
    // Buscar por nombre corto usando strcmp (case-insensitive)
    if(!strcmp(nombreArma, "desert", true) || !strcmp(nombreArma, "deagle", true) || !strcmp(nombreArma, "eagle", true))
    { itemID = 348; esArma = true; }
    else if(!strcmp(nombreArma, "pistola", true) || !strcmp(nombreArma, "9mm", true))
    { itemID = 346; esArma = true; }
    else if(!strcmp(nombreArma, "silenciadora", true) || !strcmp(nombreArma, "silenc", true))
    { itemID = 347; esArma = true; }
    else if(!strcmp(nombreArma, "shotgun", true) || !strcmp(nombreArma, "escopeta", true))
    { itemID = 349; esArma = true; }
    else if(!strcmp(nombreArma, "sawnoff", true) || !strcmp(nombreArma, "recortada", true))
    { itemID = 350; esArma = true; }
    else if(!strcmp(nombreArma, "combat", true) || !strcmp(nombreArma, "combatshotgun", true))
    { itemID = 351; esArma = true; }
    else if(!strcmp(nombreArma, "uzi", true))
    { itemID = 352; esArma = true; }
    else if(!strcmp(nombreArma, "mp5", true))
    { itemID = 353; esArma = true; }
    else if(!strcmp(nombreArma, "ak47", true) || !strcmp(nombreArma, "ak", true) || !strcmp(nombreArma, "ak-47", true))
    { itemID = 355; esArma = true; }
    else if(!strcmp(nombreArma, "m4", true))
    { itemID = 356; esArma = true; }
    else if(!strcmp(nombreArma, "tec9", true) || !strcmp(nombreArma, "tec", true))
    { itemID = 372; esArma = true; }
    else if(!strcmp(nombreArma, "rifle", true) || !strcmp(nombreArma, "countryrifle", true))
    { itemID = 357; esArma = true; }
    else if(!strcmp(nombreArma, "sniper", true))
    { itemID = 358; esArma = true; }
    else if(!strcmp(nombreArma, "rpg", true))
    { itemID = 359; esArma = true; }
    else if(!strcmp(nombreArma, "lanca", true) || !strcmp(nombreArma, "flamethrower", true))
    { itemID = 361; esArma = true; }
    else if(!strcmp(nombreArma, "minigun", true))
    { itemID = 362; esArma = true; }
    else if(!strcmp(nombreArma, "satchel", true) || !strcmp(nombreArma, "c4", true))
    { itemID = 363; esArma = true; }
    else if(!strcmp(nombreArma, "granada", true))
    { itemID = 342; esArma = true; }
    else if(!strcmp(nombreArma, "molotov", true))
    { itemID = 344; esArma = true; }
    else if(!strcmp(nombreArma, "cuchillo", true) || !strcmp(nombreArma, "faca", true) || !strcmp(nombreArma, "knife", true))
    { itemID = 335; esArma = true; }
    else if(!strcmp(nombreArma, "katana", true))
    { itemID = 338; esArma = true; }
    else if(!strcmp(nombreArma, "motosierra", true) || !strcmp(nombreArma, "chainsaw", true))
    { itemID = 341; esArma = true; }
    else if(!strcmp(nombreArma, "cacetete", true) || !strcmp(nombreArma, "porra", true) || !strcmp(nombreArma, "baton", true))
    { itemID = 334; esArma = true; }
    else if(!strcmp(nombreArma, "baseball", true) || !strcmp(nombreArma, "taco", true))
    { itemID = 336; esArma = true; }
    else if(!strcmp(nombreArma, "dinero", true) || !strcmp(nombreArma, "sucio", true) || !strcmp(nombreArma, "dinerSucio", true))
    { itemID = 1212; }
    else if(!strcmp(nombreArma, "piezas", true) || !strcmp(nombreArma, "fabricacion", true))
    { itemID = 19995; }
    else
    {
        new msgErr[160];
        format(msgErr, sizeof(msgErr), "Arma no reconocida: '%s'. Usa /listarmas para ver nombres disponibles.", nombreArma);
        return ErrorMsg(playerid, msgErr);
    }
    // Buscar el item en el inventario
    new slotItem = -1;
    new tieneCantidad = 0;
    for(new s = 0; s < 33; s++)
    {
        if(PlayerInventario[playerid][s][Slot] == itemID && PlayerInventario[playerid][s][Unidades] > 0)
        {
            slotItem = s;
            tieneCantidad = PlayerInventario[playerid][s][Unidades];
            break;
        }
    }
    if(slotItem == -1)
        return ErrorMsg(playerid, "No tienes ese item en el inventario. Usa /listarmas para ver que tienes.");
    if(tieneCantidad < cantidad)
    {
        new msg[128];
        format(msg, sizeof(msg), "Solo tienes %d unidades de ese item. Pediste %d.", tieneCantidad, cantidad);
        return ErrorMsg(playerid, msg);
    }
    // Limpiar ofertas expiradas antes de buscar slot
    CArmas_LimpiarExp();
    // Buscar slot libre
    new slot = CArmas_SlotLibre();
    if(slot == -1)
        return ErrorMsg(playerid, "Mercado negro lleno. Intenta mas tarde.");
    // Remover el item del inventario del vendedor
    PlayerInventario[playerid][slotItem][Unidades] -= cantidad;
    if(PlayerInventario[playerid][slotItem][Unidades] <= 0)
        PlayerInventario[playerid][slotItem][Slot] = -1;
    AtualizarInventario(playerid, slotItem);
    SalvarInventario(playerid);
    // Crear la oferta
    g_OfertasArma[slot][oa_activa] = true;
    g_OfertasArma[slot][oa_vendedorIDF] = PlayerInfo[playerid][IDF];
    g_OfertasArma[slot][oa_vendedorPlayerid] = playerid;
    g_OfertasArma[slot][oa_vendedorOrg] = PlayerInfo[playerid][Org];
    g_OfertasArma[slot][oa_itemID] = itemID;
    g_OfertasArma[slot][oa_armaID] = esArma ? GetArmaInv(itemID) : 0;
    g_OfertasArma[slot][oa_precio] = precio;
    g_OfertasArma[slot][oa_cantidad] = cantidad;
    g_OfertasArma[slot][oa_timestamp] = gettime();
    // Nombre legible (usar ItemNomeInv para mostrar nombre completo)
    new nombreItem[32];
    strcpy(nombreItem, ItemNomeInv(itemID), 32);
    strcpy(g_OfertasArma[slot][oa_nombreArma], nombreItem, 32);
    // Mensaje al vendedor
    new msgOk[200];
    format(msgOk, sizeof(msgOk), "Oferta creada. %s x%d por $%d. Expira en 5 min. Usa /cancelaroferta %d para cancelar.", g_OfertasArma[slot][oa_nombreArma], cantidad, precio, slot);
    SuccesMsg(playerid, msgOk);
    // Anuncio global a bandidos
    new msgAll[200];
    format(msgAll, sizeof(msgAll), "[CONTRABANDO] %s ofrece %s x%d por $%d. Usa /ofertasarma para ver.", g_HQNombres[PlayerInfo[playerid][Org]], g_OfertasArma[slot][oa_nombreArma], cantidad, precio);
    foreach(new p : Player)
    {
        if(pLogado[p] && IsBandido(p) && p != playerid)
            SendClientMessage(p, 0xAA00FFFF, msgAll);
    }
    printf("[P0-FASE5] Vendedor %d (IDF %d, org %d) creo oferta slot %d: item %d x%d por $%d",
           playerid, PlayerInfo[playerid][IDF], PlayerInfo[playerid][Org], slot, itemID, cantidad, precio);
    return 1;
}

// /listarmas - muestra las armas y items que el jugador tiene en inventario + nombres validos
CMD:listarmas(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    new str[1500], line[160];
    strcat(str, "{FFFF00}=== Tus Armas/Items para Contrabando ===\n\n");
    strcat(str, "{FFFFFF}Nombre corto\tItemID\tCantidad\n");
    new count = 0;
    // Recorrer inventario y mostrar items vendibles
    for(new s = 0; s < 33; s++)
    {
        new itemID = PlayerInventario[playerid][s][Slot];
        new cant = PlayerInventario[playerid][s][Unidades];
        if(itemID <= 0 || cant <= 0) continue;
        new nombreCorto[32];
        new esVendible = false;
        // Mapear itemID a nombre corto
        switch(itemID)
        {
            case 334: { strcpy(nombreCorto, "cacetete/porra", 32); esVendible = true; }
            case 335: { strcpy(nombreCorto, "cuchillo/faca", 32); esVendible = true; }
            case 336: { strcpy(nombreCorto, "baseball/taco", 32); esVendible = true; }
            case 338: { strcpy(nombreCorto, "katana", 32); esVendible = true; }
            case 341: { strcpy(nombreCorto, "motosierra", 32); esVendible = true; }
            case 342: { strcpy(nombreCorto, "granada", 32); esVendible = true; }
            case 344: { strcpy(nombreCorto, "molotov", 32); esVendible = true; }
            case 346: { strcpy(nombreCorto, "pistola/9mm", 32); esVendible = true; }
            case 347: { strcpy(nombreCorto, "silenciadora/silenc", 32); esVendible = true; }
            case 348: { strcpy(nombreCorto, "desert/deagle", 32); esVendible = true; }
            case 349: { strcpy(nombreCorto, "shotgun/escopeta", 32); esVendible = true; }
            case 350: { strcpy(nombreCorto, "sawnoff/recortada", 32); esVendible = true; }
            case 351: { strcpy(nombreCorto, "combat", 32); esVendible = true; }
            case 352: { strcpy(nombreCorto, "uzi", 32); esVendible = true; }
            case 353: { strcpy(nombreCorto, "mp5", 32); esVendible = true; }
            case 355: { strcpy(nombreCorto, "ak47/ak", 32); esVendible = true; }
            case 356: { strcpy(nombreCorto, "m4", 32); esVendible = true; }
            case 357: { strcpy(nombreCorto, "rifle", 32); esVendible = true; }
            case 358: { strcpy(nombreCorto, "sniper", 32); esVendible = true; }
            case 359: { strcpy(nombreCorto, "rpg", 32); esVendible = true; }
            case 361: { strcpy(nombreCorto, "lanca/flamethrower", 32); esVendible = true; }
            case 362: { strcpy(nombreCorto, "minigun", 32); esVendible = true; }
            case 363: { strcpy(nombreCorto, "satchel/c4", 32); esVendible = true; }
            case 372: { strcpy(nombreCorto, "tec9/tec", 32); esVendible = true; }
            case 1212: { strcpy(nombreCorto, "dinero/sucio", 32); esVendible = true; }
            case 19995: { strcpy(nombreCorto, "piezas/fabricacion", 32); esVendible = true; }
        }
        if(!esVendible) continue;
        format(line, sizeof(line), "{FFFF00}%s{FFFFFF}\t%d\t{00FF00}%d\n", nombreCorto, itemID, cant);
        strcat(str, line);
        count++;
    }
    if(count == 0)
        strcat(str, "\n{FF0000}No tienes items vendibles. Roba armas o compra en Tienda Ilegal.\n");
    strcat(str, "\n{AAAAAA}Para vender: /venderarma [nombreCorto] [cantidad] [precio]");
    strcat(str, "\n{AAAAAA}Ej: /venderarma desert 100 5000");
    ShowPlayerDialog(playerid, 9995, DIALOG_STYLE_TABLIST_HEADERS, "Listar Armas para Contrabando", str, "Cerrar", "");
    return 1;
}

// /ofertasarma - lista de ofertas activas
CMD:ofertasarma(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    CArmas_LimpiarExp();
    new str[1500], line[160];
    strcat(str, "{FFFF00}=== Mercado Negro - Contrabando de Armas ===\n\n");
    new count = 0;
    for(new i = 0; i < MAX_OFERTAS_ARMA; i++)
    {
        if(!g_OfertasArma[i][oa_activa]) continue;
        new nowTs = gettime();
        new restante = OFERTA_ARMA_EXPIRE - (nowTs - g_OfertasArma[i][oa_timestamp]);
        if(restante < 0) restante = 0;
        new mins = restante / 60;
        new segs = restante % 60;
        format(line, sizeof(line), "{FFFFFF}[%d] {FFFF00}%s{FFFFFF} x{00FF00}%d{FFFFFF} - ${00FF00}%d{FFFFFF} - {AAAAAA}%s (%dm %ds)\n",
               i, g_OfertasArma[i][oa_nombreArma], g_OfertasArma[i][oa_cantidad],
               g_OfertasArma[i][oa_precio], g_HQNombres[g_OfertasArma[i][oa_vendedorOrg]],
               mins, segs);
        strcat(str, line);
        count++;
    }
    if(count == 0)
        strcat(str, "{AAAAAA}No hay ofertas activas. Usa /venderarma para crear una.\n");
    else
        strcat(str, "\n{AAAAAA}Para comprar: /comprararma [ID de oferta]");
    ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_TABLIST, "Contrabando de Armas", str, "Cerrar", "");
    return 1;
}

// /comprararma [slot] - compra una oferta del mercado negro
CMD:comprararma(playerid, params[])
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    new slot;
    if(sscanf(params, "i", slot))
        return ErrorMsg(playerid, "USE: /comprararma [ID de oferta]. Usa /ofertasarma para ver IDs.");
    if(slot < 0 || slot >= MAX_OFERTAS_ARMA)
        return ErrorMsg(playerid, "ID de oferta invalido.");
    // Limpiar expiradas antes
    CArmas_LimpiarExp();
    if(!g_OfertasArma[slot][oa_activa])
        return ErrorMsg(playerid, "Esa oferta ya no esta disponible.");
    // Actualizar playerid del vendedor (por si reconecto)
    CArmas_ActVendedor();
    // Validar que el vendedor siga conectado
    new vp = g_OfertasArma[slot][oa_vendedorPlayerid];
    if(vp == -1 || !IsPlayerConnected(vp) || !pLogado[vp])
        return ErrorMsg(playerid, "El vendedor se desconecto. Oferta cancelada.");
    if(vp == playerid)
        return ErrorMsg(playerid, "No puedes comprar tu propia oferta. Usa /cancelaroferta.");
    // Validar que el comprador tenga dinero
    if(PlayerInfo[playerid][pDinheiro] < g_OfertasArma[slot][oa_precio])
    {
        new msg[128];
        format(msg, sizeof(msg), "No tienes dinero suficiente. Necesitas $%d.", g_OfertasArma[slot][oa_precio]);
        return ErrorMsg(playerid, msg);
    }
    // Validar que el vendedor SIGA teniendo el item (defensa en profundidad - aunque se removio al crear oferta)
    // (no se valida porque el item ya fue removido al crear la oferta)
    // Transferir dinero: comprador paga, vendedor recibe
    // FIX AUDIT AGENT5 XS-08: antes escribia pDinheiro directamente sin
    // AC_AddPlayerMoney ni SalvarDados del comprador. Resultado: (1) si server
    // crashea antes del SaveTimer (60s), el comprador recupera su dinero Y retiene
    // el arma que ya fue persistida por SalvarInventario = DUPE POR CRASH.
    // (2) Sin AC_AddPlayerMoney, el diff en OnPlayerUpdate disparaba strikes falsos.
    AC_AddPlayerMoney(playerid, -g_OfertasArma[slot][oa_precio]);
    AC_AddPlayerMoney(vp, g_OfertasArma[slot][oa_precio]);
    // Dar el item al comprador
    GanharItem(playerid, g_OfertasArma[slot][oa_itemID], g_OfertasArma[slot][oa_cantidad]);
    SalvarInventario(playerid);
    SalvarInventario(vp);
    SalvarDados(vp);
    SalvarDados(playerid); // FIX XS-08: faltaba SalvarDados del comprador
    // Mensajes
    new msgC[180];
    format(msgC, sizeof(msgC), "Compraste %s x%d por $%d. Item agregado a tu inventario.",
           g_OfertasArma[slot][oa_nombreArma], g_OfertasArma[slot][oa_cantidad], g_OfertasArma[slot][oa_precio]);
    SuccesMsg(playerid, msgC);
    new msgV[180];
    format(msgV, sizeof(msgV), "Vendiste %s x%d por $%d. Dinero recibido.",
           g_OfertasArma[slot][oa_nombreArma], g_OfertasArma[slot][oa_cantidad], g_OfertasArma[slot][oa_precio]);
    SuccesMsg(vp, msgV);
    printf("[P0-FASE5] Comprador %d compro slot %d a vendedor %d (IDF %d). Item %d x%d por $%d",
           playerid, slot, vp, g_OfertasArma[slot][oa_vendedorIDF],
           g_OfertasArma[slot][oa_itemID], g_OfertasArma[slot][oa_cantidad], g_OfertasArma[slot][oa_precio]);
    // Marcar oferta como inactiva
    g_OfertasArma[slot][oa_activa] = false;
    g_OfertasArma[slot][oa_vendedorIDF] = 0;
    g_OfertasArma[slot][oa_vendedorPlayerid] = -1;
    g_OfertasArma[slot][oa_vendedorOrg] = 0;
    return 1;
}

// /cancelaroferta [slot] - cancelar oferta propia y devolver item al inventario
CMD:cancelaroferta(playerid, params[])
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    new slot;
    if(sscanf(params, "i", slot))
        return ErrorMsg(playerid, "USE: /cancelaroferta [ID de oferta].");
    if(slot < 0 || slot >= MAX_OFERTAS_ARMA)
        return ErrorMsg(playerid, "ID de oferta invalido.");
    if(!g_OfertasArma[slot][oa_activa])
        return ErrorMsg(playerid, "Esa oferta no esta activa.");
    if(g_OfertasArma[slot][oa_vendedorIDF] != PlayerInfo[playerid][IDF])
        return ErrorMsg(playerid, "Solo puedes cancelar tus propias ofertas.");
    // Devolver el item al inventario
    GanharItem(playerid, g_OfertasArma[slot][oa_itemID], g_OfertasArma[slot][oa_cantidad]);
    SalvarInventario(playerid);
    // Marcar como inactiva
    g_OfertasArma[slot][oa_activa] = false;
    g_OfertasArma[slot][oa_vendedorIDF] = 0;
    g_OfertasArma[slot][oa_vendedorPlayerid] = -1;
    g_OfertasArma[slot][oa_vendedorOrg] = 0;
    new msg[140];
    format(msg, sizeof(msg), "Oferta cancelada. %s x%d devuelto a tu inventario.", g_OfertasArma[slot][oa_nombreArma], g_OfertasArma[slot][oa_cantidad]);
    SuccesMsg(playerid, msg);
    return 1;
}

// =====================================================================
// FIN FASE 5: CONTRABANDO DE ARMAS
// =====================================================================

// =====================================================================
// FASE 6: RANKING Y RESPETO DE BANDAS
// =====================================================================

// Inicializar estadisticas al arrancar el servidor
stock StatsBandas_Init()
{
    for(new i = 0; i < MAX_STATS_GUERRAS; i++)
    {
        g_StatsBanda[i][sb_guerrasGanadas] = 0;
        g_StatsBanda[i][sb_guerrasPerdidas] = 0;
        g_StatsBanda[i][sb_guerrasEmpatadas] = 0;
        g_StatsBanda[i][sb_robosExitosos] = 0;
        g_StatsBanda[i][sb_desmantelamientos] = 0;
    }
    // Cargar desde archivo INI
    StatsBandas_Cargar();
    printf("[P0-FASE6-RESPETO] Sistema inicializado.");
    return 1;
}

// Persistir estadisticas a EstadisticasBandas.ini
stock StatsBandas_Guardar()
{
    new fname[64] = "InfoOrg/EstadisticasBandas.ini";
    // FIX AUDIT FASE6: logica invertida - era `if(DOF2_FileExists)` deberia ser `if(!DOF2_FileExists)`
    if(!DOF2_FileExists(fname)) DOF2_CreateFile(fname);
    new key[32];
    for(new i = 5; i <= 13; i++)
    {
        if(i == 9) continue; // skip Bennys
        format(key, sizeof(key), "Banda%d_Ganadas", i);
        DOF2_SetInt(fname, key, g_StatsBanda[i][sb_guerrasGanadas]);
        format(key, sizeof(key), "Banda%d_Perdidas", i);
        DOF2_SetInt(fname, key, g_StatsBanda[i][sb_guerrasPerdidas]);
        format(key, sizeof(key), "Banda%d_Empatadas", i);
        DOF2_SetInt(fname, key, g_StatsBanda[i][sb_guerrasEmpatadas]);
        format(key, sizeof(key), "Banda%d_Robos", i);
        DOF2_SetInt(fname, key, g_StatsBanda[i][sb_robosExitosos]);
        format(key, sizeof(key), "Banda%d_Desmant", i);
        DOF2_SetInt(fname, key, g_StatsBanda[i][sb_desmantelamientos]);
    }
    DOF2_SaveFile();
    return 1;
}

// Cargar estadisticas desde EstadisticasBandas.ini
stock StatsBandas_Cargar()
{
    new fname[64] = "InfoOrg/EstadisticasBandas.ini";
    if(!DOF2_FileExists(fname)) return 0;
    new key[32];
    for(new i = 5; i <= 13; i++)
    {
        if(i == 9) continue;
        format(key, sizeof(key), "Banda%d_Ganadas", i);
        g_StatsBanda[i][sb_guerrasGanadas] = DOF2_GetInt(fname, key);
        format(key, sizeof(key), "Banda%d_Perdidas", i);
        g_StatsBanda[i][sb_guerrasPerdidas] = DOF2_GetInt(fname, key);
        format(key, sizeof(key), "Banda%d_Empatadas", i);
        g_StatsBanda[i][sb_guerrasEmpatadas] = DOF2_GetInt(fname, key);
        format(key, sizeof(key), "Banda%d_Robos", i);
        g_StatsBanda[i][sb_robosExitosos] = DOF2_GetInt(fname, key);
        format(key, sizeof(key), "Banda%d_Desmant", i);
        g_StatsBanda[i][sb_desmantelamientos] = DOF2_GetInt(fname, key);
    }
    printf("[P0-FASE6-RESPETO] Estadisticas cargadas desde %s", fname);
    return 1;
}

// Calcular respeto de una banda (formula ponderada)
// Retorna valor entero de respeto (puede ser negativo)
stock CalcularRespetoBanda(orgid)
{
    if(orgid < 5 || orgid > 13 || orgid == 9) return 0;
    new respeto = 0;
    // +100 por cada territorio conquistado
    new terrDueno = 0;
    for(new t = 0; t < MAX_TERRITORIOS; t++)
    {
        if(g_Terr[t][t_duenoOrg] == orgid)
            terrDueno++;
    }
    respeto += terrDueno * 100;
    // +50 por cada guerra de bandas ganada
    respeto += g_StatsBanda[orgid][sb_guerrasGanadas] * 50;
    // -50 por cada guerra de bandas perdida
    respeto -= g_StatsBanda[orgid][sb_guerrasPerdidas] * 50;
    // +10 por cada miembro online
    new miembrosOnline = 0;
    foreach(new p : Player)
    {
        if(pLogado[p] && PlayerInfo[p][Org] == orgid)
            miembrosOnline++;
    }
    respeto += miembrosOnline * 10;
    // -30 por cada captura policial reciente en sus territorios
    new capturasRecientes = 0;
    for(new t = 0; t < MAX_TERRITORIOS; t++)
    {
        if(g_Terr[t][t_duenoOrg] == orgid && g_Terr[t][t_capturasPolicia] > 0)
            capturasRecientes += g_Terr[t][t_capturasPolicia];
    }
    respeto -= capturasRecientes * 30;
    // Bonus base para que el respeto no sea negativo al inicio
    respeto += 100; // base de participacion
    return respeto;
}

// Contar territorios de una banda
stock ContarTerritoriosBanda(orgid)
{
    new count = 0;
    for(new t = 0; t < MAX_TERRITORIOS; t++)
    {
        if(g_Terr[t][t_duenoOrg] == orgid)
            count++;
    }
    return count;
}

// Contar miembros online de una banda
stock ContarMiembrosBandaOnline(orgid)
{
    new count = 0;
    foreach(new p : Player)
    {
        if(pLogado[p] && PlayerInfo[p][Org] == orgid)
            count++;
    }
    return count;
}

// /rankingbandas - top 6 bandas por respeto
CMD:rankingbandas(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    new str[1500], line[200];
    strcat(str, "{FFFF00}=== Ranking de Bandas - Respeto ===\n\n");
    // Calcular respeto de las 6 bandas
    new orgs[6] = {5, 6, 7, 8, 12, 13};
    new respetos[6];
    for(new i = 0; i < 6; i++)
        respetos[i] = CalcularRespetoBanda(orgs[i]);
    // Ordenar de mayor a menor (bubble sort simple)
    for(new i = 0; i < 5; i++)
    {
        for(new j = i + 1; j < 6; j++)
        {
            if(respetos[j] > respetos[i])
            {
                // Swap respeto
                new tmpR = respetos[i];
                respetos[i] = respetos[j];
                respetos[j] = tmpR;
                // Swap org
                new tmpO = orgs[i];
                orgs[i] = orgs[j];
                orgs[j] = tmpO;
            }
        }
    }
    // Mostrar ranking
    new posiciones[6][12] = {"1ro", "2do", "3ro", "4to", "5to", "6to"};
    new colores[6] = {0xFF4444FF, 0xAAAAAAFF, 0xFFFF00FF, 0x00CC00FF, 0xAA00FFFF, 0x4B0082FF};
    for(new i = 0; i < 6; i++)
    {
        new terr = ContarTerritoriosBanda(orgs[i]);
        new ganadas = g_StatsBanda[orgs[i]][sb_guerrasGanadas];
        new perdidas = g_StatsBanda[orgs[i]][sb_guerrasPerdidas];
        new online = ContarMiembrosBandaOnline(orgs[i]);
        // FIX AUDIT FASE6 B1: agregados tabuladores \t para que DIALOG_STYLE_TABLIST_HEADERS muestre columnas
        format(line, sizeof(line), "{FFFFFF}%s.\t{%06x}%s{FFFFFF}\t{00FF00}%d resp{FFFFFF}\tTerr:%d\tG/P:%d/%d\tOnline:%d\n",
               posiciones[i], (colores[i] & 0xFFFFFF), g_HQNombres[orgs[i]], respetos[i], terr, ganadas, perdidas, online);
        strcat(str, line);
    }
    strcat(str, "\n{AAAAAA}Formula: +100/territorio, +50/guerra ganada, +10/miembro online, -50/guerra perdida, -30/captura policial");
    ShowPlayerDialog(playerid, 9996, DIALOG_STYLE_TABLIST_HEADERS, "Ranking de Bandas", str, "Cerrar", "");
    return 1;
}

// /respetobanda - info detallada de tu propia banda
CMD:respetobanda(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
    if(!IsBandido(playerid)) return ErrorMsg(playerid, "Solo las bandas tienen respeto.");
    new org = PlayerInfo[playerid][Org];
    new respeto = CalcularRespetoBanda(org);
    new terr = ContarTerritoriosBanda(org);
    new ganadas = g_StatsBanda[org][sb_guerrasGanadas];
    new perdidas = g_StatsBanda[org][sb_guerrasPerdidas];
    new empatadas = g_StatsBanda[org][sb_guerrasEmpatadas];
    new robos = g_StatsBanda[org][sb_robosExitosos];
    new desmant = g_StatsBanda[org][sb_desmantelamientos];
    new online = ContarMiembrosBandaOnline(org);
    // Calcular capturas recientes en territorios propios
    new capturasRecientes = 0;
    for(new t = 0; t < MAX_TERRITORIOS; t++)
    {
        if(g_Terr[t][t_duenoOrg] == org && g_Terr[t][t_capturasPolicia] > 0)
            capturasRecientes += g_Terr[t][t_capturasPolicia];
    }
    new str[800];
    format(str, sizeof(str),
        "{FFFF00}=== %s - Respeto ===\n\n"\
        "{FFFFFF}Respeto total: {00FF00}%d\n\n"\
        "{FFFFFF}=== Territorios ===\n"\
        "{FFFFFF}Conquistados: {FFFF00}%d\n\n"\
        "{FFFFFF}=== Guerra de Bandas ===\n"\
        "{00FF00}Ganadas: %d | {FF0000}Perdidas: %d | {AAAAAA}Empatadas: %d\n\n"\
        "{FFFFFF}=== Actividad ===\n"\
        "{FFFFFF}Robos exitosos: {FFFF00}%d\n"\
        "{FFFFFF}Desmantelamientos: {FFFF00}%d\n"\
        "{FFFFFF}Miembros online: {00FF00}%d\n\n"\
        "{FFFFFF}=== Penalizaciones ===\n"\
        "{FF0000}Capturas policiales en territorios: %d (-%d respeto)\n\n"\
        "{AAAAAA}Desglose:\n"\
        "{AAAAAA}+100 por territorio: +%d\n"\
        "{AAAAAA}+50 por guerra ganada: +%d\n"\
        "{AAAAAA}-50 por guerra perdida: -%d\n"\
        "{AAAAAA}+10 por miembro online: +%d\n"\
        "{AAAAAA}-30 por captura policial: -%d\n"\
        "{AAAAAA}+100 base de participacion: +100",
        g_HQNombres[org], respeto,
        terr,
        ganadas, perdidas, empatadas,
        robos, desmant, online,
        capturasRecientes, capturasRecientes * 30,
        terr * 100,
        ganadas * 50,
        perdidas * 50,
        online * 10,
        capturasRecientes * 30);
    ShowPlayerDialog(playerid, 9996, DIALOG_STYLE_MSGBOX, "Respeto de Banda", str, "Cerrar", "");
    return 1;
}

