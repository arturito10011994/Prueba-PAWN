                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Wires");
                                }
                                if(listitem == 4)
                                {
                                        AddVehicleComponent(wVeiculo,1077), OnVehicleMod(playerid, wVeiculo, 1077);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Classic");
                                }
                                if(listitem == 5)
                                {
                                        AddVehicleComponent(wVeiculo,1078), OnVehicleMod(playerid, wVeiculo, 1078);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Twist");
                                }
                                if(listitem == 6)
                                {
                                        AddVehicleComponent(wVeiculo,1079), OnVehicleMod(playerid, wVeiculo, 1079);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Cutter");
                                }
                                if(listitem == 7)
                                {
                                        AddVehicleComponent(wVeiculo,1083), OnVehicleMod(playerid, wVeiculo, 1083);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Dollar");
                                }
                                if(listitem == 8)
                                {
                                        AddVehicleComponent(wVeiculo,1085), OnVehicleMod(playerid, wVeiculo, 1085);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Atomic");
                                }
                                if(listitem == 9)
                                {
                                        AddVehicleComponent(wVeiculo,1097), OnVehicleMod(playerid, wVeiculo, 1097);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Virtual");
                                }
                                // P0-BEN-TUNE: volver al menu principal despues de aplicar
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                        else
                        {
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                }
                case DIALOG_MECANICAColores:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        ChangeVehicleColor(wVeiculo, 1, 1), OnVehicleRespray(playerid, wVeiculo, 1, 1);         // BRANCO
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 1)
                                {
                                        ChangeVehicleColor(wVeiculo, 79, 79), OnVehicleRespray(playerid, wVeiculo, 79, 79);       // AZUL
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 2)
                                {
                                        ChangeVehicleColor(wVeiculo, 194, 194), OnVehicleRespray(playerid, wVeiculo, 194, 194);     // AMARELO
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 3)
                                {
                                        ChangeVehicleColor(wVeiculo, 211, 211), OnVehicleRespray(playerid, wVeiculo, 211, 211);     // ROXO
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 4)
                                {
                                        ChangeVehicleColor(wVeiculo, 137, 137), OnVehicleRespray(playerid, wVeiculo, 137, 137);     // VERDE
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 5)
                                {
                                        ChangeVehicleColor(wVeiculo, 75, 75), OnVehicleRespray(playerid, wVeiculo, 75, 75);       // CINZA
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 6)
                                {
                                        ChangeVehicleColor(wVeiculo, 136, 136), OnVehicleRespray(playerid, wVeiculo, 136, 136);     // ROSA
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 7)
                                {
                                        ChangeVehicleColor(wVeiculo, 129, 129), OnVehicleRespray(playerid, wVeiculo, 129, 129);     // MARROM
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 8)
                                {
                                        ChangeVehicleColor(wVeiculo, 3, 3), OnVehicleRespray(playerid, wVeiculo, 3, 3);        // VERMELHO
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                if(listitem == 9)
                                {
                                        ChangeVehicleColor(wVeiculo, 158, 158), OnVehicleRespray(playerid, wVeiculo, 158, 158);    // LARANJA
                                        SuccesMsg(playerid, "Cor Alterada"); ActualizarTuningColor(playerid, "Color Aplicado");
                                }
                                // FASE 7: Colores Combinados (2 colores) - seleccionar color 1
                                if(listitem == 10)
                                {
                                        new menu2c[400];
                                        strcat(menu2c, "{FFFF00}Color 1: {FFFFFF}Blanco (1)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FFFFFF}Azul (79)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FFFF00}Amarillo (194)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FFFFFF}Morado (211)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {00CC00}Verde (137)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {AAAAAA}Cinza (75)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FF66FF}Rosa (136)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {996633}Marron (129)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FF0000}Rojo (3)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {FF9900}Naranja (158)\n");
                                        strcat(menu2c, "{FFFF00}Color 1: {000000}Negro (0)\n");
                                        ShowPlayerDialog(playerid, DIALOG_MECANICA2Colores1, DIALOG_STYLE_LIST, "Color 1 (primario)", menu2c, "Siguiente", "X");
                                        return 1;
                                }
                                // P0-BEN-TUNE: volver al menu principal
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                        else
                        {
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                }
                case DIALOG_MECANICA2Colores1: // FASE 7: selector color 1 para combinados
                {
                        if(!response)
                        {
                                // Volver al menu de colores
                                new menustr3[400];
                                strcat(menustr3, "{FFFF00}Colores {FFFFFF}Blanco\n{FFFF00}Colores {FFFFFF}Azul\n{FFFF00}Colores {FFFFFF}Amarillo\n{FFFF00}Colores {FFFFFF}Morado\n{FFFF00}Colores {FFFFFF}Verde\n{FFFF00}Colores {FFFFFF}Cinza\n{FFFF00}Colores {FFFFFF}Rosa\n{FFFF00}Colores {FFFFFF}Marron\n{FFFF00}Colores {FFFFFF}Verde\n{FFFF00}Colores {FFFFFF}Naranja\n{FFFF00}Colores {00FF00}Combinados (2 colores)\n");
                                ShowPlayerDialog(playerid, DIALOG_MECANICAColores, DIALOG_STYLE_LIST, "Central de Bennys", menustr3, "Confirmar", "X");
                                return 1;
                        }
                        // Guardar color 1 seleccionado en PVar
                        new color1IDs[11] = {1, 79, 194, 211, 137, 75, 136, 129, 3, 158, 0}; // Blanco, Azul, Amarillo, Morado, Verde, Cinza, Rosa, Marron, Rojo, Naranja, Negro
                        if(listitem < 0 || listitem > 10)
                                return ErrorMsg(playerid, "Seleccion invalida.");
                        SetPVarInt(playerid, "Tune2Colores1", color1IDs[listitem]);
                        // Mostrar selector de color 2
                        new menu2c2[400];
                        strcat(menu2c2, "{FFFF00}Color 2: {FFFFFF}Blanco (1)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FFFFFF}Azul (79)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FFFF00}Amarillo (194)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FFFFFF}Morado (211)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {00CC00}Verde (137)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {AAAAAA}Cinza (75)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FF66FF}Rosa (136)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {996633}Marron (129)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FF0000}Rojo (3)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {FF9900}Naranja (158)\n");
                        strcat(menu2c2, "{FFFF00}Color 2: {000000}Negro (0)\n");
                        ShowPlayerDialog(playerid, DIALOG_MECANICA2Colores2, DIALOG_STYLE_LIST, "Color 2 (secundario)", menu2c2, "Aplicar", "X");
                }
                case DIALOG_MECANICA2Colores2: // FASE 7: selector color 2 para combinados
                {
                        if(!response)
                        {
                                // Volver al selector de color 1
                                new menu2c[400];
                                strcat(menu2c, "{FFFF00}Color 1: {FFFFFF}Blanco (1)\n{FFFF00}Color 1: {FFFFFF}Azul (79)\n{FFFF00}Color 1: {FFFF00}Amarillo (194)\n{FFFF00}Color 1: {FFFFFF}Morado (211)\n{FFFF00}Color 1: {00CC00}Verde (137)\n{FFFF00}Color 1: {AAAAAA}Cinza (75)\n{FFFF00}Color 1: {FF66FF}Rosa (136)\n{FFFF00}Color 1: {996633}Marron (129)\n{FFFF00}Color 1: {FF0000}Rojo (3)\n{FFFF00}Color 1: {FF9900}Naranja (158)\n{FFFF00}Color 1: {000000}Negro (0)\n");
                                ShowPlayerDialog(playerid, DIALOG_MECANICA2Colores1, DIALOG_STYLE_LIST, "Color 1 (primario)", menu2c, "Siguiente", "X");
                                return 1;
                        }
                        // Aplicar los 2 colores al vehiculo
                        new color2IDs[11] = {1, 79, 194, 211, 137, 75, 136, 129, 3, 158, 0};
                        if(listitem < 0 || listitem > 10)
                                return ErrorMsg(playerid, "Seleccion invalida.");
                        new color1 = GetPVarInt(playerid, "Tune2Colores1");
                        new color2 = color2IDs[listitem];
                        DeletePVar(playerid, "Tune2Colores1");
                        // Aplicar los 2 colores
                        ChangeVehicleColor(wVeiculo, color1, color2);
                        OnVehicleRespray(playerid, wVeiculo, color1, color2);
                        // FIX INFERNUSS 2 COLORES: forzar render del vehiculo con toggle de params.
                        // Algunos modelos (Infernus) tienen muy poco area de color secundario y SA-MP
                        // no siempre refresca el render al cambiar colores. Forzamos con SetVehicleParamsEx.
                        new eng, lts, alrm, drs, bnt, bt, obj;
                        GetVehicleParamsEx(wVeiculo, eng, lts, alrm, drs, bnt, bt, obj);
                        SetVehicleParamsEx(wVeiculo, eng, lts, alrm, drs, bnt, bt, obj);
                        new msgOk[160];
                        format(msgOk, sizeof(msgOk), "Colores combinados aplicados. Color 1: %d | Color 2: %d.", color1, color2);
                        SuccesMsg(playerid, msgOk);
                        ActualizarTuningColor(playerid, "Colores Combinados Aplicados");
                        // Volver al menu principal de Bennys
                        ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                }
                case DIALOG_REGISTRO:
                {
                        // FIX AUDIT LOGIN F2-3: kick si presiona X sin texto (no re-abrir dialog).
                        // Antes: si el jugador presionaba X (cancelar) SIN haber escrito texto,
                        // el dialog se re-abria. Si volvia a presionar X sin texto, se re-abria
                        // otra vez. Bucle infinito. El jugador no podia salir del dialog sin
                        // escribir algo. Eso era una UX trap (trampa de experiencia de usuario).
                        // Ahora: si presiona X sin texto, kickear al jugador. Es mas estricto
                        // pero permite escapar limpiamente sin tener que escribir algo.
                        if(!strlen(inputtext))
                        {
                                InfoMsg(playerid, "No ingresaste nada. Desconectado.");
                                Kick(playerid);
                                return 1;
                        }
                        if(!response)
                        {
                                InfoMsg(playerid, "Decidiste no hacer Login.");
                                Kick(playerid);
                                return 1;
                        }
                        else
                        {
                                format(Str, 256, "Sea Bienvenido de nuevo a nuestro servidor, %s!\nPara crear su cuenta, coloque su contraseÃ¯Â¿Â½a abajo.\n*Su contraseÃ¯Â¿Â½a debe tener de 4 a 20 caracteres.", Name(playerid));
                                if(!strlen(inputtext)) return ShowPlayerDialog(playerid, DIALOG_REGISTRO, DIALOG_STYLE_PASSWORD, "Usted es nuevo.", Str, "Crear", "X"); // FIX AUDIT4 HIGH-DBG-6
                                if(strlen(inputtext) < 4 || strlen(inputtext) > 20)
                                {
                                        ErrorMsg(playerid, "Tu contrasena debe tener entre 4 y 20 caracteres.");
                                        format(Str, 256, "Sea Bienvenido de nuevo a nuestro servidor, %s!\nPara crear su cuenta, tiene que colocar su contraseÃ¯Â¿Â½a abajo.\n*Su contraseÃ¯Â¿Â½a debe tener de 8 a 20 caracteres.", Name(playerid));
                                        return ShowPlayerDialog(playerid, DIALOG_REGISTRO, DIALOG_STYLE_PASSWORD, "Eres nuevo.", Str, "Criar", "X"); // FIX AUDIT4 HIGH-DBG-6
                                }
                                new SHA256_password[85];
                                format(PlayerInfo[playerid][pSenha], 20, "%s", inputtext);
                                SHA256_PassHash(PlayerInfo[playerid][pSenha], passwordSalt, SHA256_password, sizeof (SHA256_password));
                                // FIX AUDIT LOGIN F0-7: zeroear pSenha en RAM tras hashear.
                                // Antes: el plaintext de la contrasena se quedaba en
                                // PlayerInfo[playerid][pSenha] para siempre (hasta
                                // disconnect). En slot reuse, el nuevo jugador del slot
                                // podia leer la contrasena del anterior. Ahora: una
                                // vez hasheada, borramos el plaintext inmediatamente.
                                PlayerInfo[playerid][pSenha][0] = '\0';

                                new uid = GetIdfixo();
                                if(!DOF2_FileExists(Account))
                                {
                                        // FIX AUDIT LOGIN F1-4: registro mas seguro (no crea archivo vacio).
                                        // Antes: el codigo hacia DOF2_CreateFile(Account) seguido de
                                        // DOF2_SaveFile() - esto escribia un archivo VACIO al disco
                                        // inmediatamente. Si el servidor crasheaba entre ese momento
                                        // y los DOF2_SetX/DOF2_SaveFile finales (linea ~29572), el
                                        // archivo quedaba VACIO con el nombre del jugador. El
                                        // jugador quedaba PERMANENTEMENTE BLOQUEADO de su cuenta:
                                        // la cuenta "existia" pero no tenia senha ni datos.
                                        //
                                        // Fix aplicado (minimal, sin romper nada):
                                        //   1. Eliminar el DOF2_SaveFile() redundante de la linea
                                        //      que creaba el archivo vacio. DOF2_CreateFile ya crea
                                        //      el archivo en memoria cacheada; no es necesario
                                        //      flushearlo a disco ANTES de escribir los datos.
                                        //   2. Los DOF2_SetX() que siguen escriben en memoria.
                                        //   3. El DOF2_SaveFile() final (L29572) flushea TODO junto
                                        //      al disco. Si el servidor crashea antes, el archivo
                                        //      NO existe en disco (DOF2_CreateFile crea en cache).
                                        //      En ese caso, el jugador simplemente no tendra cuenta
                                        //      y podra registrarse de nuevo. No queda bloqueado.
                                        //
                                        // Nota: DOF2 hace cache en memoria y solo escribe a disco
                                        // en DOF2_SaveFile(). Por eso eliminar el SaveFile redundante
                                        // es seguro: si crashea antes del SaveFile final, el archivo
                                        // no se llega a crear en disco. Si crashea despues, se creo
                                        // completo con todos los datos. Nunca queda a medias.
                                        //
                                        // Atomic write real (escribir a .tmp + rename) requeriria
                                        // un include DOF2 modificado que soporte rutas .tmp, lo cual
                                        // esta fuera del alcance de F1 (seria F1-4 v2). Esta solucion
                                        // ya cubre el 99% del caso: el archivo o esta completo o no
                                        // esta. La unica ventana de riesgo es el flush fisico de
                                        // DOF2_SaveFile (microsegundos), donde un crash podria
                                        // truncar el archivo. Para mitigar eso, ver F1-5 (SalvarDados).
                                        DOF2_CreateFile(Account);
                                        // (eliminado DOF2_SaveFile() redundante que creaba archivo vacio)
                                        DOF2_SetString(Account, "pSenha", SHA256_password);
                                        DOF2_SetString(Account, "pEmail", "");
                                        DOF2_SetInt(Account, "IDF", uid);
                                        PlayerInfo[playerid][IDF] = uid;
                                        DOF2_SetInt(Account, "pSexo", 0);
                                        DOF2_SetInt(Account, "pSkin", 0);
                                        DOF2_SetInt(Account, "pDinheiro", 0);
                                        DOF2_SetInt(Account, "pBanco", 0);
                                        DOF2_SetInt(Account, "pIdade", 0);
                                        DOF2_SetInt(Account, "pSegundosJogados", 0);
                                        DOF2_SetInt(Account, "pAvisos", 0);
                                        DOF2_SetInt(Account, "pjail", 0);
                                        DOF2_SetInt(Account, "pLastLogin", 0);
                                        DOF2_SetInt(Account, "pInterior", 0);
                                        // FIX AUDIT SPAWN S3-4: unificar posicion de spawn inicial.
                                        // Antes: el registro guardaba pPosX=1685.698608 (_position original),
                                        // pero SetSpawnInfo en el flujo de nuevo registro usaba
                                        // 1568.130615 (linea ~30672). El primer spawn del jugador
                                        // usaba 1568.130615, pero si crasheaba antes del primer
                                        // SalvarDados, al reconectar cargaba 1685.698608. Inconsistencia.
                                        // Ahora: guardar 1568.130615 en el registro para que el primer
                                        // spawn (cargado desde disco) coincida con el SetSpawnInfo.
                                        DOF2_SetFloat(Account, "pPosX", 1568.130615);
                                        DOF2_SetFloat(Account, "pPosY", -1891.800415);
                                        DOF2_SetFloat(Account, "pPosZ", 13.559370);
                                        DOF2_SetFloat(Account, "pPosA", 1.185642);
                                        DOF2_SetFloat(Account, "pCamX", 0);
                                        DOF2_SetFloat(Account, "pCamY", 0);
                                        DOF2_SetFloat(Account, "pCamZ", 0);
                                        DOF2_SetBool(Account, "pCongelado", false);
                                        DOF2_SetBool(Account, "pCalado", false);
                                        // FIX AUDIT HAMBRE H0-4: escribir pFome=100, pSede=100 en disco al registrar (no 0).
                                        DOF2_SetInt(Account, "pFome", 100);
                                        FomePlayer[playerid] = 100;
                                        DOF2_SetInt(Account, "pSede", 100);
                                        SedePlayer[playerid] = 100;
                                        DOF2_SetInt(Account, "pCoins", 0);
                                        // FIX AUDIT LOGIN F2-6: inicializar pAdmin, pVIP, ExpiraVIP al registrar.
                                        // Antes: estos 3 campos NO se inicializaban en Contas/.ini al
                                        // registrar. Como resultado, DOF2_GetInt(Account, "pAdmin"),
                                        // DOF2_GetInt(Account, "pVIP"), DOF2_GetInt(Account, "ExpiraVIP")
                                        // retornaban 0 al cargar (porque las claves no existian), pero
                                        // algunos sistemas esperaban que SÃ¯Â¿Â½ existieran y se confundian.
                                        // Inicializar explicitamente a 0 es defense-in-depth.
                                        // Nota: pAdmin NO se persiste en Contas/.ini (se persiste en
                                        // Admins/.ini con clave AdminLevel). Pero mantenerlo en 0 aqui
                                        // asegura que si alguien manualmente pone "pAdmin=7" en
                                        // Contas/.ini, no tendra efecto (porque CarregarEvaluacion
                                        // sobreescribe desde Admins/.ini y porque ya hemos visto que
                                        // DIALOG_LOGIN NUNCA carga pAdmin de Contas/.ini tras F1-3).
                                        DOF2_SetInt(Account, "pAdmin", 0);
                                        DOF2_SetInt(Account, "pVIP", 0);
                                        DOF2_SetInt(Account, "ExpiraVIP", 0);
                                        DOF2_SetInt(Account, "pProfissao", 0);
                                        DOF2_SetInt(Account, "pOrg", 0);
                                        DOF2_SetInt(Account, "pCargo", 0);
                                        DOF2_SetInt(Account, "pProcurado", 0);
                                        DOF2_SetInt(Account, "pMultas", 0);
                                        DOF2_SetInt(Account, "pCasa", -1);
                                        DOF2_SetInt(Account, "pLevel", 0);
                                        DOF2_SetInt(Account, "pXP", 0);
                                        DOF2_SetInt(Account, "LicencaConduzir", 0);
                                        DOF2_SetString(Account,"pNome","");
                                        DOF2_SetString(Account,"pNascimento","");
                                        DOF2_SetString(Account,"pPai","");
                                        DOF2_SetString(Account,"pMae","");
                                        DOF2_SetInt(Account, "pRG", 0);
                                        DOF2_SetInt(Account, "pCarteiraT", 0);
                                        DOF2_SetInt(Account, "Piezas", 0);
                                        DOF2_SetFloat(Account, "pVida", 100);
                                        // FIX AUDIT CHAL CHAL-A3-02 (CRITICO): nuevas cuentas NO deben tener chaleco.
                                        // ANTES: pColete=100 al registrar. TODAS las cuentas nuevas arrancaban
                                        // con armour=100 gratis. Al reconectar, OnPlayerLogin L6196 seteaba
                                        // g_ChalecoPermitido=true automaticamente (pColete > 0) sin ser
                                        // paramedico ni reportero. Chaleco gratis infinito para civiles.
                                        // Ahora: pColete=0 al registrar. Solo paramedicos/reporteros con
                                        // uniforme vestido pueden tener chaleco.
                                        DOF2_SetFloat(Account, "pColete", 0);
                                        PlayerInfo[playerid][pVida] = 100;
                                        PlayerInfo[playerid][Casa] = -1;
                                        DOF2_SaveFile();
                                }

                                CriarInventario(playerid);
                                for(new i = 0; i < 38; ++i)
                                {
                                        PlayerTextDrawHide(playerid, TxtLoginCDA[playerid][i]);
                                        if(i == 38)break;
                                }
                                new tarquivo[64];
                                format(tarquivo, sizeof(tarquivo), "IDs/%04d.ini",uid);
                                if(!DOF2_FileExists(tarquivo))
                                {
                                        DOF2_CreateFile(tarquivo);
                                        DOF2_SetString(tarquivo,"IDF de:", Name(playerid));

                                }
                                new Account2[255];
                                format(Account2, sizeof(Account2), "IDCONTAS/%04d.ini", GetPlayerIdfixo(playerid));
                                if(!DOF2_FileExists(Account2))
                                {
                                        DOF2_CreateFile(Account2);
                                        DOF2_SaveFile();
                                }
                                ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Coloca tu email para continuar con el proximo paso \n{FF0000}Debes colocar un email valido.", "Listo", "");
                        }
                }
                case DIALOG_MECANICAPJ:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        ChangeVehiclePaintjob(wVeiculo, 0), OnVehiclePaintjob(playerid, wVeiculo, 0);
                                        SuccesMsg(playerid, "Design Adicionado.");
                                }
                                if(listitem == 1)
                                {
                                        ChangeVehiclePaintjob(wVeiculo, 1), OnVehiclePaintjob(playerid, wVeiculo, 1);
                                        SuccesMsg(playerid, "Design Adicionado.");
                                }
                                if(listitem == 2)
                                {
                                        ChangeVehiclePaintjob(wVeiculo, 2), OnVehiclePaintjob(playerid, wVeiculo, 2);
                                        SuccesMsg(playerid, "Design Adicionado.");
                                }
                                // P0-BEN-TUNE: volver al menu principal
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                        else
                        {
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                }
                case DIALOG_MECANICANITRO:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        AddVehicleComponent(wVeiculo,1009), OnVehicleMod(playerid, wVeiculo, 1009);    // NITRO 1
                                        SuccesMsg(playerid, "Nitro Lv1 Adicionado.");
                                }
                                if(listitem == 1)
                                {
                                        AddVehicleComponent(wVeiculo,1008), OnVehicleMod(playerid, wVeiculo, 1008);    // NITRO 2
                                        SuccesMsg(playerid, "Nitro Lv2 Adicionado.");
                                }
                                if(listitem == 2)
                                {
                                        AddVehicleComponent(wVeiculo,1010), OnVehicleMod(playerid, wVeiculo, 1010);    // NITRO 3
                                        SuccesMsg(playerid, "Nitro Lv3 Adicionado.");
                                }
                                // P0-BEN-TUNE: volver al menu principal
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                        else
                        {
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                }
                case D_VOIP:{
                        if(response){
                                switch(listitem){
                                        case 0:{
                                                Falando[playerid] = true;
                                                if(Susurrando[playerid] == true){
                                                        Susurrando[playerid] = false;
                                                }
                                                if(Gritando[playerid] == true){
                                                        Gritando[playerid] = false;
                                                }
                                                SuccesMsg(playerid, "Cambiaste el modo de tu voip a (Hablando)");
                                        }
                                        case 1:{
                                                Susurrando[playerid] = true;
                                                if(Falando[playerid] == true){
                                                        Falando[playerid] = false;
                                                }
                                                if(Gritando[playerid] == true){
                                                        Gritando[playerid] = false;
                                                }
                                                SuccesMsg(playerid, "Cambiaste el modo de tu voip a (Susurrando)");
                                        }
                                        case 2:{
                                                Gritando[playerid] = true;
                                                if(Falando[playerid] == true){
                                                        Falando[playerid] = false;
                                                }
                                                if(Susurrando[playerid] == true){
                                                        Susurrando[playerid] = false;
                                                }
                                                SuccesMsg(playerid, "Cambiaste el modo de tu voip a (Gritando)");
                                        }
                                }
                        }
                }
                case DIALOG_LOGIN:
                {
                        // FIX AUDIT SPAWN S3-1: optimizacion de performance en handler DIALOG_LOGIN.
                        // Este handler se ejecuta en cada login exitoso. Evitar operaciones de I/O
                        // o calculos pesados sincronos dentro del bloque. Cualquier DOF2_SetX
                        // seguido de DOF2_SaveFile bloquea el tick SA-MP. En logins masivos
                        // (50+ jugadores conectando a la vez), eso genera lag spikes.
                        // F3-1 ya elimino el DOF2_SaveFile redundante al final del bloque.
                        // Mantener este handler lo mas ligero posible: solo cargar datos y
                        // spawnear. Persistir (SalvarDados) en timers o eventos async.
                        // FIX AUDIT LOGIN F0-5: re-validar ban al procesar respuesta de login.
                        // Defense in depth: si el ban se emitio entre el click en ACEPTAR
                        // (que valida ban) y el envio de la contrasena (que llega aqui),
                        // el jugador no debe poder loguear.
                        new banFile[255];
                        format(banFile, sizeof(banFile), PASTA_BANIDOS, Name(playerid));
                        if(DOF2_FileExists(banFile) && gettime() <= DOF2_GetInt(banFile, "DDesban"))
                        {
                                new StrM[450];
                                strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANEADO{FFFFFF} -x-x-x-x-x-\n\nEsta cuenta fue baneada mientras intentabas entrar.\n\n{FFA500}Cuenta:{E64022} ");
                                strcat(StrM, Name(playerid));
                                strcat(StrM, "\n\n{FFFFFF}Si lo considera un error, entre a nuestro discord\n{FFFF00}\t\t*******{FFFFFF}");
                                strcat(StrM, SERVERFORUM);
                                strcat(StrM, "{FFFF00}*******");
                                ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                                Kick(playerid);
                                return 1;
                        }
                        format(banFile, sizeof(banFile), PASTA_BANIDOSIP, GetPlayerIpEx(playerid));
                        if(DOF2_FileExists(banFile))
                        {
                                new StrM[450];
                                strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANIDO{FFFFFF} -x-x-x-x-x-\n\nTu IP fue baneada mientras intentabas entrar.\n\n{FFFF00}IP:{FFFFFF} ");
                                strcat(StrM, GetPlayerIpEx(playerid));
                                strcat(StrM, "\n\nSe considera um erro, entre em nosso discord\n{FFFF00}\t\t*******{FFFFFF}");
                                strcat(StrM, SERVERFORUM);
                                strcat(StrM, "{FFFF00}*******");
                                ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                                Kick(playerid);
                                return 1;
                        }
                        // FIX AUDIT LOGIN F2-3: kick si presiona X sin texto (no re-abrir dialog).
                        // Antes: si el jugador presionaba X sin texto, el dialog se re-abria.
                        // Bucle infinito de UX trap. Ahora: kick directo (igual que DIALOG_REGISTRO).
                        if(!strlen(inputtext))
                        {
                                InfoMsg(playerid, "No ingresaste nada. Desconectado.");
                                Kick(playerid);
                                return 1;
                        }
                        if(!response)
                        {
                                InfoMsg(playerid, "Decidiste no hacer login.");
                                Kick(playerid);
                                return 1;
                        }
                        else
                        {
                                if(!checkPasswordAccount(playerid, inputtext))
                                {
                                        format(Str, sizeof(Str), "Bienvenido de nuevo, %s.\nPara entrar al servidor escribe tu contrasena abajo.", Name(playerid));
                                        ShowPlayerDialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_PASSWORD, "Bienvenido de nuevo", Str, "Ingresar", "X"); // FIX AUDIT4 HIGH-DBG-6: password masked
                                        // FIX AUDIT LOGIN F2-9: usar ErroLogin (separado de Erro chat flood).
                                        ErroLogin[playerid]++;
                                        if(ErroLogin[playerid] == 3)
                                        {
                                                InfoMsg(playerid, "Contrasena incorrecta");
                                                Kick(playerid);
                                                return 1;
                                        }
                                        return 1;
                                }
                                else
                                {
                                        for(new i = 0; i < 38; ++i)
                                        {
                                                PlayerTextDrawHide(playerid, TxtLoginCDA[playerid][i]);
                                                if(i == 38)break;
                                        }
                                        if(DOF2_FileExists(Account))
                    {
                                                format(PlayerInfo[playerid][pLastLogin], 24, "%s", DOF2_GetString(Account, "pLastLogin")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                format(PlayerInfo[playerid][pEmail],64, "%s", DOF2_GetString(Account,"pEmail")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                PlayerInfo[playerid][IDF] = DOF2_GetInt(Account, "IDF");
                                                PlayerInfo[playerid][pSkin] = DOF2_GetInt(Account, "pSkin");
                                                PlayerInfo[playerid][pSexo] = DOF2_GetInt(Account, "pSexo");
                                                SetPlayerSkin(playerid, DOF2_GetInt(Account, "pSkin"));
                                                PlayerInfo[playerid][pDinheiro] = DOF2_GetInt(Account, "pDinheiro");
                                                PlayerInfo[playerid][pBanco] = DOF2_GetInt(Account, "pBanco");
                                                PlayerInfo[playerid][pIdade] = DOF2_GetInt(Account, "pIdade");
                                                PlayerInfo[playerid][pSegundosJogados] = DOF2_GetInt(Account, "pSegundosJogados");
                                                PlayerInfo[playerid][pAvisos] = DOF2_GetInt(Account, "pAvisos");
                                                PlayerInfo[playerid][pjail] = DOF2_GetInt(Account, "pjail");
                                                // P1-FBI-2: cargar modo encubierto FBI persistido
                                                PlayerInfo[playerid][pEncubierto] = DOF2_GetInt(Account, "pEncubierto") ? true : false;
                                                MinutosMorte[playerid] = DOF2_GetInt(Account, "MinutosMorte");
                                                SegundosMorte[playerid] = DOF2_GetInt(Account, "SegundosMorte");
                                                // FIX AUDIT MEDICO A3-HIGH-03: cargar MatouPlayer y FoiSocorrido persistidos.
                                                MatouPlayer[playerid] = DOF2_GetInt(Account, "MatouPlayer");
                                                FoiSocorrido[playerid] = DOF2_GetInt(Account, "FoiSocorrido");
                                                // FIX ALTOS-VERIFY-MED-A2: distinguir "cuenta vieja sin clave" de "vÃ¯Â¿Â½ctima = player 0".
                                                // ANTES: cuentas viejas sin la clave "MatouPlayer" cargaban 0 (default DOF2_GetInt).
                                                // Eso sobreescribÃ¯Â¿Â½a el -1 seteado por ZerarDados. El check anti-farm
                                                // MatouPlayer[playerid] == target daba falso positivo si target era el player ID 0
                                                // (valortotal = 0, paramedico no cobraba por ese socorro).
                                                // AHORA: si MatouPlayer == 0, resetear a -1 (nadie matado). Solo se setea a un
                                                // playerid vÃ¯Â¿Â½lido (> 0) cuando el jugador mata a alguien (L23017).
                                                if(MatouPlayer[playerid] == 0) MatouPlayer[playerid] = -1;
                                                // FIX AUDIT MEDICO MED-A5-03: EntrouHosp es DEAD STATE.
                                                // Antes se cargaba desde .ini pero NUNCA se leia para tomar decisiones.
                                                // El DOF2_GetInt siempre retornaba 0 (default). El load era no-op.
                                                // Ahora: NO cargar, dejar en 0 (default). Evita I/O innecesario.
                                                // EntrouHosp[playerid] = DOF2_GetInt(Account, "EntrouHosp"); // deprecated
                                                EntrouHosp[playerid] = 0;
                                                // FIX AUDIT CEL CEL-A2-01 (CRITICO): cargar TiempoAnuncio persistido.
                                                // ANTES: TiempoAnuncio siempre cargaba en 0 (ZerarDados L19422 lo resetea).
                                                // Esto permitia bypass del cooldown de 60s reconectando: hacÃ¯Â¿Â½a /anuncio,
                                                // veÃ¯Â¿Â½a "espera 60s", desconectaba, reconectaba y TiempoAnuncio era 0 otra vez.
                                                // AHORA: cargar el valor persistido en SalvarDados para que el cooldown
                                                // se respete entre sesiones. Cuentas viejas sin la clave cargan 0 (default).
                                                TiempoAnuncio[playerid] = DOF2_GetInt(Account, "TiempoAnuncio");
                                                // FIX AUDIT CEL CEL-A2-01 (CRITICO): clamp por si el valor persistido es corrupto.
                                                if(TiempoAnuncio[playerid] < 0) TiempoAnuncio[playerid] = 0;
                                                if(TiempoAnuncio[playerid] > 60) TiempoAnuncio[playerid] = 60;
                                                // FIX AUDIT CEL MEJORA-4 (ALTO): cargar DefibCooldown persistido.
                                                // Anti-bypass por reconexion del cooldown de 60s del defibrilador civil.
                                                SetPVarInt(playerid, "DefibCooldown", DOF2_GetInt(Account, "DefibCooldown"));
                                                // FIX AUDIT CHAL MEJORA-4 (ALTO): cargar CD_selfheal persistido.
                                                // Anti-bypass por reconexion del cooldown 60s de chaleco/cura/revive.
                                                SetPVarInt(playerid, "CD_selfheal", DOF2_GetInt(Account, "CD_selfheal"));
                                                PlanoSaude[playerid] = DOF2_GetInt(Account, "PlanoSaude");
                                                                                        KitsMedicos[playerid] = DOF2_GetInt(Account, "KitsMedicos"); // Fase 1: cargar kits
                                                                                        KitsMedicosGratuitos[playerid] = DOF2_GetInt(Account, "KitsMedicosGratuitos"); // CAMBIO 2026-07-09 - Bug #7
                                                                                        Vendajes[playerid] = DOF2_GetInt(Account, "Vendajes"); // CAMBIO 2026-07-18
                                                                                Enfermedad[playerid] = DOF2_GetInt(Account, "Enfermedad"); // CAMBIO 2026-07-20
                                                                                // FIX AUDIT MEDICO MED-A5-06: cargar EnfermedadTick y EnfermedadTiempo persistidos.
                                                                                EnfermedadTick[playerid] = DOF2_GetInt(Account, "EnfermedadTick");
                                                                                EnfermedadTiempo[playerid] = DOF2_GetInt(Account, "EnfermedadTiempo");
                                                                                TieneReceta[playerid] = DOF2_GetInt(Account, "TieneReceta"); // CAMBIO 2026-07-20
                                                                                ItemAntigripal[playerid] = DOF2_GetInt(Account, "ItemAntigripal"); // CAMBIO 2026-07-20
                                                                                ItemAntibiotico[playerid] = DOF2_GetInt(Account, "ItemAntibiotico"); // CAMBIO 2026-07-20
                                                                                ItemSuero[playerid] = DOF2_GetInt(Account, "ItemSuero"); // CAMBIO 2026-07-20
                                                                                Fractura[playerid] = DOF2_GetInt(Account, "Fractura"); // CAMBIO 2026-07-20: cargar fractura
                                                                                FracturaTick[playerid] = DOF2_GetInt(Account, "FracturaTick");
                                                                                Quemadura[playerid] = DOF2_GetInt(Account, "Quemadura"); // CAMBIO 2026-07-20: cargar quemadura
                                                                                QuemaduraTick[playerid] = DOF2_GetInt(Account, "QuemaduraTick");
                                                                                ItemPomada[playerid] = DOF2_GetInt(Account, "ItemPomada"); // CAMBIO 2026-07-20
                                                                                VacunaAntigripal[playerid] = DOF2_GetInt(Account, "VacunaAntigripal"); // CAMBIO 2026-07-20
                                                                                VacunaAntitetanica[playerid] = DOF2_GetInt(Account, "VacunaAntitetanica");
                                                                                VacunaAntirrabica[playerid] = DOF2_GetInt(Account, "VacunaAntirrabica");
                                                                                VacunaHepatitis[playerid] = DOF2_GetInt(Account, "VacunaHepatitis");
                                                                                        SegundosOrg10[playerid] = DOF2_GetInt(Account, "SegundosOrg10"); // CAMBIO 2026-07-12 - Fase 2
                                                                                        SegundosOrg1[playerid] = DOF2_GetInt(Account, "SegundosOrg1"); // P1-PN-Vehiculos: cargar horas PN
                                        // Fase 3: anti-evasion. Si el jugador se desconecto estando herido,
                                        // al reconectar se le envia al hospital mas cercano en vez de dejarlo
                                        // herido en su ultima posicion (evita evadir el rol medico).
                                        // FIX AUDIT SPAWN S3-8: anti-evasion via PVar en vez de override directo.
                                        // Antes: este bloque hacia override directo de pPosX/Y/Z/Interior/Casa
                                        // a hospital. Pero F2-10 clamps (mas abajo) podian pisar el override
                                        // si los valores de hospital estaban fuera del rango [-4000, 4000]
                                        // o si algun otro clamp los modificaba. Eso causaba bypass del fix.
                                        // Ahora: setear PVar "AntiEvasion"=1 y aplicar el override DESPUES
                                        // de los clamps F2-10 (al final de este bloque de carga).
                                        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
                                        {
                                            SetPVarInt(playerid, "AntiEvasion", 1);
                                        }
                                        // FIX AUDIT LOGIN F1-3: NO cargar pAdmin de Contas/<nick>.ini.
                                        // Antes: esta linea hacia
                                        //   PlayerInfo[playerid][pAdmin] = DOF2_GetInt(Account, "pAdmin");
                                        // pero SalvarDados nunca escribe la clave "pAdmin" en Contas/.ini
                                        // (solo SalvarEvaluacion escribe "AdminLevel" en Admins/.ini).
                                        // Por eso DOF2_GetInt(Account, "pAdmin") siempre retornaba 0,
                                        // pisando el pAdmin correcto que CarregarEvaluacion (L18931)
                                        // ya habia cargado de Admins/<nick>.ini. El resultado: el
                                        // jugador quedaba con pAdmin=0 durante ~2s (ventana entre
                                        // DIALOG_LOGIN y TxdLogin que re-aplica pAdmin del archivo
                                        // de evaluacion). En esa ventana, comandos admin no funcionaban.
                                        // Fix: eliminar la linea. pAdmin ya viene correcto de
                                        // CarregarEvaluacion (L5835) y TxdLogin (L5849) re-confirma.
                                        // Fuente unica de verdad: Admins/<nick>.ini -> AdminLevel.
                                        // NOTA: si en el futuro se quiere guardar pAdmin en
                                        // Contas/.ini (unificar todo en un archivo), habria que:
                                        //   1. Anadir en SalvarDados: DOF2_SetInt(File, "pAdmin", PlayerInfo[playerid][pAdmin]);
                                        //   2. Eliminar SalvarEvaluacion/CarregarEvaluacion o adaptarlos.
                                        //   3. Actualizar este fix. Por ahora, fuente unica = Admins/.ini.
                                        PlayerInfo[playerid][pInterior] = DOF2_GetInt(Account, "pInterior");
                                        // FIX AUDIT SPAWN S2-2: cargar VirtualWorld persistido.
                                        // Antes: pVW no se cargaba. El jugador siempre aparecia en VW 0.
                                        // Ahora: cargar pVW en PVar para usarlo despues en SetPlayerVirtualWorld
                                        // (en la rama Casa<0, donde no se setea VW = ID de casa).
                                        {
                                                new savedVW = DOF2_GetInt(Account, "pVW");
                                                if(savedVW < 0 || savedVW > 65535) savedVW = 0;
                                                SetPVarInt(playerid, "SavedVW", savedVW);
                                        }
                                                PlayerInfo[playerid][pPosX] = DOF2_GetFloat(Account, "pPosX");
                                                PlayerInfo[playerid][pPosY] = DOF2_GetFloat(Account, "pPosY");
                                                PlayerInfo[playerid][pPosZ] = DOF2_GetFloat(Account, "pPosZ");
                                                PlayerInfo[playerid][pPosA] = DOF2_GetFloat(Account, "pPosA");
                                                PlayerInfo[playerid][pCamX] = DOF2_GetFloat(Account, "pCamX");
                                                PlayerInfo[playerid][pCamY] = DOF2_GetFloat(Account, "pCamY");
                                                PlayerInfo[playerid][pCamZ] = DOF2_GetFloat(Account, "pCamZ");
                                                PlayerInfo[playerid][pCongelado] = DOF2_GetBool(Account, "pCongelado");
                                                PlayerInfo[playerid][pCalado] = DOF2_GetBool(Account, "pCalado");
                                                FomePlayer[playerid] = DOF2_GetInt(Account, "pFome");
                                                SedePlayer[playerid] = DOF2_GetInt(Account, "pSede");
                                                // FIX AUDIT HAMBRE H0-1: clamp [0,100] al cargar pFome/pSede.
                                                // Antes: si el .ini tenia pFome=114 o pFome=-5 (por corrupcion
                                                // o por guardar sin clamp antes de H0-2), el valor se cargaba
                                                // tal cual. El timer FomeBar/SedeBar lo bajaria a [0,100]
                                                // en unos pocos ticks, pero mientras tanto el jugador tenia
                                                // buffer de hambre/sed ilegitimo. Ahora: clamp al cargar.
                                                if(FomePlayer[playerid] < 0) FomePlayer[playerid] = 0;
                                                if(FomePlayer[playerid] > 100) FomePlayer[playerid] = 100;
                                                if(SedePlayer[playerid] < 0) SedePlayer[playerid] = 0;
                                                if(SedePlayer[playerid] > 100) SedePlayer[playerid] = 100;
                                                PlayerInfo[playerid][pVIP] = DOF2_GetInt(Account, "pVIP");
                                                // FIX CRIT-COINS-002 (CRITICO): clamp pCoins [0, COINS_MAX_AMOUNT] al cargar.
                                                // ANTES: sin validacion. Un jugador que editara Contas/<nick>.ini con pCoins=999999999
                                                // obtenia coins gratis al reconectar (exploit de tampering).
                                                {
                                                        new _loadCoins = DOF2_GetInt(Account, "pCoins");
                                                        if(_loadCoins < 0) _loadCoins = 0;
                                                        if(_loadCoins > COINS_MAX_AMOUNT)
                                                        {
                                                                printf("[COINS TAMPER] Jugador %d (%s) cargo pCoins=%d, clampeado a %d", playerid, Name(playerid), _loadCoins, COINS_MAX_AMOUNT);
                                                                _loadCoins = COINS_MAX_AMOUNT;
                                                        }
                                                        PlayerInfo[playerid][pCoins] = _loadCoins;
                                                }
                                                PlayerInfo[playerid][pProfissao] = DOF2_GetInt(Account, "pProfissao");
                                                // FIX AUDIT MEDICO A1-20: clamp pProfissao al cargar.
                                                // ANTES: cuentas viejas con pProfissao=9 (Medico legacy deshabilitado)
                                                // persistian indefinidamente. El jugador veia "Medico (deshabilitado)"
                                                // en /cuenta pero no podia hacer nada (0 comandos aceptan pProfissao 9).
                                                // AHORA: si pProfissao == 9, resetear a 0 (sin trabajo) y avisar.
                                                if(PlayerInfo[playerid][pProfissao] == 9)
                                                {
                                                        PlayerInfo[playerid][pProfissao] = 0;
                                                        printf("[MEDICO MIGRACION] Jugador %d tenia pProfissao=9 (Medico deshabilitado), reseteado a 0.", playerid);
                                                }
                                                PlayerInfo[playerid][Org] = DOF2_GetInt(Account, "pOrg");
                                                PlayerInfo[playerid][Cargo] = DOF2_GetInt(Account, "pCargo");
                                                // FIX AUDIT WANTED: clamp al cargar desde DB
                                                new loadWanted = DOF2_GetInt(Account, "pProcurado");
                                                if(loadWanted < 0) loadWanted = 0;
                                                if(loadWanted > 6) loadWanted = 6;
                                                PlayerInfo[playerid][pProcurado] = loadWanted;
                                                SetPlayerWantedLevel(playerid, loadWanted);
                                                PlayerInfo[playerid][pMultas] = DOF2_GetInt(Account, "pMultas");
                                                PlayerInfo[playerid][Casa] = DOF2_GetInt(Account, "pCasa");
                                                // FIX CRIT-XP-003 (CRITICO): clamp pLevel y pXP al cargar desde archivo.
                                                // ANTES: sin validacion. Un jugador que editara su .ini y seteara pLevel=999999999
                                                // obtenia ese nivel al reconectar (exploit de tampering).
                                                // AHORA: clamp [0, 100] para pLevel, [0, 1000000] para pXP.
                                                new _loadLevel = DOF2_GetInt(Account, "pLevel");
                                                if(_loadLevel < 0) _loadLevel = 0;
                                                if(_loadLevel > 100) { printf("[XP TAMPER] Jugador %d (%s) cargo pLevel=%d, clampeado a 100", playerid, Name(playerid), _loadLevel); _loadLevel = 100; }
                                                SetPlayerScore(playerid, _loadLevel);
                                                // FIX CRIT-XP-004 (CRITICO): sincronizar PlayerInfo[pLevel] con GetPlayerScore.
                                                // ANTES: PlayerInfo[pLevel] era campo shadow (nunca se seteaba, siempre 0).
                                                // AHORA: setearlo al cargar para que sea fuente de verdad consistente.
                                                PlayerInfo[playerid][pLevel] = _loadLevel;
                                                new _loadXP = DOF2_GetInt(Account, "pXP");
                                                if(_loadXP < 0) _loadXP = 0;
                                                if(_loadXP > 1000000) { printf("[XP TAMPER] Jugador %d (%s) cargo pXP=%d, clampeado a 1000000", playerid, Name(playerid), _loadXP); _loadXP = 1000000; }
                                                PlayerInfo[playerid][pXP] = _loadXP;
                                                PlayerInfo[playerid][LicencaConduzir] = DOF2_GetInt(Account, "LicencaConduzir");
                                                format(PlayerInfo[playerid][pNome],80, "%s", DOF2_GetString(Account,"pNome")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                format(PlayerInfo[playerid][pNascimento],30, "%s", DOF2_GetString(Account,"pNascimento")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                format(PlayerInfo[playerid][pPai],80, "%s", DOF2_GetString(Account,"pPai")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                format(PlayerInfo[playerid][pMae],80, "%s", DOF2_GetString(Account,"pMae")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                                PlayerInfo[playerid][pRG] = DOF2_GetInt(Account, "pRG");
                                                PlayerInfo[playerid][pCarteiraT] = DOF2_GetInt(Account, "pCarteiraT");
                                                PlayerInfo[playerid][PiezasArma] = DOF2_GetInt(Account, "Piezas");
                                                PlayerInfo[playerid][pVida] = DOF2_GetFloat(Account, "pVida");
                                                PlayerInfo[playerid][pColete] = DOF2_GetFloat(Account, "pColete");
                                                // FIX AUDIT LOGIN F0-4: clamp pVida/pColete al cargar.
                                                // Aunque SalvarDados ahora clamp-ea al guardar, archivos
                                                // creados ANTES del fix pueden tener pVida=1000000 o
                                                // valores absurdos por datos corruptos. Defensive
                                                // programming: clamp al cargar tambien.
                                                if(PlayerInfo[playerid][pVida] > 100.0) PlayerInfo[playerid][pVida] = 100.0;
                                                if(PlayerInfo[playerid][pVida] < 0.0) PlayerInfo[playerid][pVida] = 0.0;
                                                if(PlayerInfo[playerid][pColete] > 100.0) PlayerInfo[playerid][pColete] = 100.0;
                                                if(PlayerInfo[playerid][pColete] < 0.0) PlayerInfo[playerid][pColete] = 0.0;
                                                PlayerInfo[playerid][ImpuestoPendiente] = DOF2_GetInt(Account, "ImpuestoPendiente");
                                                PlayerInfo[playerid][ImpuestoPayDaysSinPagar] = DOF2_GetInt(Account, "ImpuestoPayDaysSinPagar");
                                                PlayerInfo[playerid][BancoBloqueado] = DOF2_GetInt(Account, "BancoBloqueado");
                                                PlayerInfo[playerid][DeudaFiscalReportada] = DOF2_GetInt(Account, "DeudaFiscalReportada");
                                                PlayerInfo[playerid][LicenciaPesca] = DOF2_GetInt(Account, "LicenciaPesca");
                                                PlayerInfo[playerid][LicenciaArmas] = DOF2_GetInt(Account, "LicenciaArmas");
                                                // FIX AUDIT2 AGENT4 SP-12/S-04/S-05: cargar strike counters persistidos.
                                                // S-04: ventana movil 24h para g_AFKLastKickTs. Si el ultimo kick
                                                // fue hace >24h, resetear g_AFKStrikes (ya cumplio el periodo de
                                                // penalizacion). S-05: al persistirse, los strikes AFK ya no se
                                                // resetean a 0 en reconexion.
                                                g_AFKStrikes[playerid] = DOF2_GetInt(Account, "AFKStrikes");
                                                g_AFKLastKickTs[playerid] = DOF2_GetInt(Account, "AFKLastKickTs");
                                                g_CmdStrikes[playerid] = DOF2_GetInt(Account, "CmdStrikes");
                                                // FIX AUDIT FLOOD-H1: cargar g_CmdLastTick persistido.
                                                // Antes: g_CmdLastTick NO se cargaba de disco. ZerarDados lo reseteaba a 0.
                                                // GetTickCount() - 0 >> 300000 siempre TRUE -> decay en cascada (9 strikes en 9s).
                                                // Ahora: cargar de disco. Si el valor es 0 o muy viejo, resetear a GetTickCount()
                                                // para que el decay tarde 5min reales.
                                                g_CmdLastTick[playerid] = DOF2_GetInt(Account, "CmdLastTick");
                                                if(g_CmdLastTick[playerid] == 0) g_CmdLastTick[playerid] = GetTickCount();
                                                // FIX AUDIT AC-H5: cargar g_AC_Strikes persistido (con decay 24h).
                                                // Antes: g_AC_Strikes se reseteaba a 0 en cada reconexion (ZerarDados),
                                                // permitiendo bypass del strike counter (3 strikes = kick). Ahora: se
                                                // carga de disco. Nota: AC_Strikes no tiene timestamp de ultimo strike
                                                // (a diferencia de AFKStrikes que tiene AFKLastKickTs), asi que el
                                                // decay 24h se aplicaria si se agregara AC_LastStrikeTs. Por ahora,
                                                // los strikes AC se acumulan hasta que el jugador reciba un kick (3
                                                // strikes) que los resetea a 0 (ver AC_Alert L29555-29559).
                                                g_AC_Strikes[playerid] = DOF2_GetInt(Account, "AC_Strikes");
                                                if(g_AFKLastKickTs[playerid] > 0 && (gettime() - g_AFKLastKickTs[playerid]) > AFK_STRIKES_WINDOW_SEC)
                                                {
                                                        g_AFKStrikes[playerid] = 0;
                                                }
                                                // FIX AUDIT AFK H8: cargar ban temporal AFK y verificar si esta activo.
                                                // Si AFKBanUntilTs > gettime() = ban activo: kickear al jugador con
                                                // mensaje "Baneado por AFK 1h, espera Xs". Esto persiste en disco
                                                // via SalvarDados (se agrego DOF2_SetInt AFKBanUntilTs).
                                                g_AFKBanUntilTs[playerid] = DOF2_GetInt(Account, "AFKBanUntilTs");
                                                if(g_AFKBanUntilTs[playerid] > 0 && g_AFKBanUntilTs[playerid] > gettime())
                                                {
                                                        new remainSec = g_AFKBanUntilTs[playerid] - gettime();
                                                        new banMsg[128];
                                                        format(banMsg, sizeof(banMsg), "Estas baneado temporalmente por AFK reincidente. Espera %d min %d s para reconectar.",
                                                                remainSec / 60, remainSec % 60);
                                                        // FIX AUDIT AFK H8: usar SetTimerEx para el Kick (delay 500ms) para que
                                                        // el mensaje llegue al cliente antes de la desconexion.
                                                        SetPVarString(playerid, "AFKBanMsg", banMsg);
                                                        SetTimerEx("AFKBanKick", 500, false, "i", playerid);
                                                }
                                                else if(g_AFKBanUntilTs[playerid] > 0 && g_AFKBanUntilTs[playerid] <= gettime())
                                                {
                                                        // Ban expirado - resetear para no volver a checkear.
                                                        g_AFKBanUntilTs[playerid] = 0;
                                                }
                                                // FIX AUDIT10 BUG1: cargar PuntosLicencia (Transito) desde disco.
                                                SetPVarInt(playerid, "T2_1_PuntosLicencia", DOF2_GetInt(Account, "T2_1_PuntosLicencia"));
                                                // FIX AUDIT10 A4-X1: cargar durabilidad de herramientas.
                                                SetPVarInt(playerid, "GanzuaUsos", DOF2_GetInt(Account, "GanzuaUsos"));
                                                SetPVarInt(playerid, "TaladroUsos", DOF2_GetInt(Account, "TaladroUsos"));
                                                SetPVarInt(playerid, "LockPickUsos", DOF2_GetInt(Account, "LockPickUsos"));
                                                // FIX AUDIT LOGIN F3-1: eliminar DOF2_SaveFile redundante en DIALOG_LOGIN.
                                                // Antes: el handler hacia 41 DOF2_GetX (cargas) seguidos de un
                                                // DOF2_SaveFile (flush a disco). Pero no se hace NINGUN DOF2_SetX
                                                // antes de ese SaveFile. Es un flush sin cambios = wasted I/O.
                                                // Cada DOF2_SaveFile bloquea el tick SA-MP (sincrono). En login
                                                // con 50 jugadores conectando a la vez, eso son 50 flushes
                                                // innecesarios. Eliminarlo mejora rendimiento del login.
                                                // Nota: si en el futuro se anaden DOF2_SetX antes de este punto,
                                                // habra que volver a poner el DOF2_SaveFile. Por ahora, no hay.
                                                // (eliminado DOF2_SaveFile redundante)
                                                //
                                        }
                                        // FIX AUDIT LOGIN F2-10: validaciones defensivas al cargar datos.
                                        // Antes: si el archivo INI estaba corrupto (por crash anterior,
                                        // edicion manual maliciosa, o bug de guardado), los datos
                                        // absurdos se cargaban tal cual: pAdmin=99, pVida=-50,
                                        // pPosX=NaN, etc. Eso causaba comportamientos impredecibles
                                        // (admin sin permisos pero con pAdmin=99, jugador con vida
                                        // negativa inmortal, spawn en posicion NaN, etc).
                                        // Ahora: clamp de variables criticas despues de cargar.
                                        // Defensive programming: nunca confiar en datos leidos de
                                        // disco sin validar.
                                        // pAdmin: clamp [0, 7] (maximo nivel legitimo)
                                        if(PlayerInfo[playerid][pAdmin] < 0) PlayerInfo[playerid][pAdmin] = 0;
                                        if(PlayerInfo[playerid][pAdmin] > 7) PlayerInfo[playerid][pAdmin] = 7;
                                        // pVIP: clamp [0, 3] (maximo nivel VIP legitimo segun /darvip L1892)
                                        if(PlayerInfo[playerid][pVIP] < 0) PlayerInfo[playerid][pVIP] = 0;
                                        if(PlayerInfo[playerid][pVIP] > 3) PlayerInfo[playerid][pVIP] = 3;
                                        // pVida, pColete: ya tienen clamp por F0-4, pero defensivo aqui tambien
                                        // (por si el archivo se modifica despues del load inicial)
                                        // NaN check: si el float es NaN (Not a Number), es != a si mismo.
                                        if(PlayerInfo[playerid][pVida] != PlayerInfo[playerid][pVida]) PlayerInfo[playerid][pVida] = 100.0;
                                        if(PlayerInfo[playerid][pColete] != PlayerInfo[playerid][pColete]) PlayerInfo[playerid][pColete] = 0.0;
                                        if(PlayerInfo[playerid][pVida] > 100.0) PlayerInfo[playerid][pVida] = 100.0;
                                        if(PlayerInfo[playerid][pVida] < 0.0) PlayerInfo[playerid][pVida] = 0.0;
                                        if(PlayerInfo[playerid][pColete] > 100.0) PlayerInfo[playerid][pColete] = 100.0;
                                        if(PlayerInfo[playerid][pColete] < 0.0) PlayerInfo[playerid][pColete] = 0.0;
                                        // pPosX/Y/Z: NaN check (si es NaN, respawn en posicion por defecto)
                                        if(PlayerInfo[playerid][pPosX] != PlayerInfo[playerid][pPosX]) PlayerInfo[playerid][pPosX] = 1685.698608;
                                        if(PlayerInfo[playerid][pPosY] != PlayerInfo[playerid][pPosY]) PlayerInfo[playerid][pPosY] = -2334.948730;
                                        if(PlayerInfo[playerid][pPosZ] != PlayerInfo[playerid][pPosZ]) PlayerInfo[playerid][pPosZ] = 13.546875;
                                        // FIX AUDIT SPAWN S1-7: clamp rango pPosX/Y/Z [-4000, 4000].
                                        // Antes: F2-10 hacia NaN check pero NO validaba rangos razonables.
                                        // Un jugador malo podia editar Contas/<nick>.ini a mano y poner
                                        // pPosX=999999. Al reconectar, aparecia en X=999999 (muy lejos
                                        // del mapa). Teleport exploit.
                                        // Ahora: si cualquier coordenada esta fuera de [-4000, 4000],
                                        // resetear a posicion por defecto. El mapa de SA tiene coords
                                        // validas aproximadamente entre -3000 y 3000. 4000 da margen.
                                        if(PlayerInfo[playerid][pPosX] < -4000.0 || PlayerInfo[playerid][pPosX] > 4000.0) PlayerInfo[playerid][pPosX] = 1685.698608;
                                        if(PlayerInfo[playerid][pPosY] < -4000.0 || PlayerInfo[playerid][pPosY] > 4000.0) PlayerInfo[playerid][pPosY] = -2334.948730;
                                        if(PlayerInfo[playerid][pPosZ] < -1000.0 || PlayerInfo[playerid][pPosZ] > 4000.0) PlayerInfo[playerid][pPosZ] = 13.546875;
                                        // FIX AUDIT SPAWN S2-4: detectar 0,0,0 en pPos (posicion invalida).
                                        // Antes: F2-10 hacia NaN check y range check, pero 0,0,0 NO es NaN
                                        // ni esta fuera de rango. Es un numero valido. Pero 0,0,0 es el
                                        // oceano sur de LS = soft-lock. Si el archivo tenia pPos=0,0,0
                                        // (por corrupcion o por GetPlayerPos en spectating), el jugador
                                        // aparecia alli.
                                        // Ahora: si las 3 coords son 0, resetear a posicion por defecto.
                                        if(PlayerInfo[playerid][pPosX] == 0.0 && PlayerInfo[playerid][pPosY] == 0.0 && PlayerInfo[playerid][pPosZ] == 0.0)
                                        {
                                                PlayerInfo[playerid][pPosX] = 1685.698608;
                                                PlayerInfo[playerid][pPosY] = -2334.948730;
                                                PlayerInfo[playerid][pPosZ] = 13.546875;
                                        }
                                        // pDinheiro: clamp [0, 999999999] (maximo segun AC_AddPlayerMoney L19193)
                                        if(PlayerInfo[playerid][pDinheiro] < 0) PlayerInfo[playerid][pDinheiro] = 0;
                                        if(PlayerInfo[playerid][pDinheiro] > 999999999) PlayerInfo[playerid][pDinheiro] = 999999999;
                                        // pBanco: clamp [0, 999999999] (no hay wrapper AC pero tiene sentido limitarlo)
                                        if(PlayerInfo[playerid][pBanco] < 0) PlayerInfo[playerid][pBanco] = 0;
                                        if(PlayerInfo[playerid][pBanco] > 999999999) PlayerInfo[playerid][pBanco] = 999999999;
                                        // pSkin: clamp [0, 311] (rango valido de skins SA-MP)
                                        if(PlayerInfo[playerid][pSkin] < 0) PlayerInfo[playerid][pSkin] = 0;
                                        if(PlayerInfo[playerid][pSkin] > 311) PlayerInfo[playerid][pSkin] = 0;
                                        // pProcurado (wanted): clamp [0, 6] (estrellas)
                                        if(PlayerInfo[playerid][pProcurado] < 0) PlayerInfo[playerid][pProcurado] = 0;
                                        if(PlayerInfo[playerid][pProcurado] > 6) PlayerInfo[playerid][pProcurado] = 6;
                                        // FIX AUDIT SPAWN S2-8: clamp pjail [0, 1440] (max 24 horas en minutos).
                                        // Antes: pjail no tenia clamp. Si el archivo tenia pjail=999999,
                                        // el jugador entraba en jail por 999999 minutos (casi 2 aÃ¯Â¿Â½os).
                                        // Ahora: max 1440 minutos (24 horas). Si es mayor, limitar.
                                        if(PlayerInfo[playerid][pjail] < 0) PlayerInfo[playerid][pjail] = 0;
                                        if(PlayerInfo[playerid][pjail] > 1440) PlayerInfo[playerid][pjail] = 1440;
                                        // FIX AUDIT SPAWN S0-1: clamp Casa [-1, MAX_CASAS-1].
                                        // Si pCasa en disco es >= MAX_CASAS o < -1, poner -1.
                                        // Esto previene out-of-bounds en CasaInfo[Casa] mas abajo.
                                        // Defense-in-depth: el bounds check tambien esta en L30399.
                                        if(PlayerInfo[playerid][Casa] >= MAX_CASAS || PlayerInfo[playerid][Casa] < -1)
                                        {
                                                PlayerInfo[playerid][Casa] = -1;
                                        }
                                        // FIX AUDIT SPAWN S3-8: aplicar anti-evasion override despues de
                                        // los clamps F2-10 (que podrian haber modificado pPosX/Y/Z/Interior).
                                        // Si AntiEvasion==1, forzar spawn en hospital LS P y resetear MinutosMorte
                                        // y Casa. Esto se hace aqui para que los clamps anteriores no pisen
                                        // el override.
                                        if(GetPVarInt(playerid, "AntiEvasion") == 1)
                                        {
                                            MinutosMorte[playerid] = 0;
                                            SegundosMorte[playerid] = 0;
                                            PlayerInfo[playerid][pPosX] = 1176.5480;
                                            PlayerInfo[playerid][pPosY] = -1323.2540;
                                            PlayerInfo[playerid][pPosZ] = 15.4;
                                            PlayerInfo[playerid][pPosA] = 0.0;
                                            PlayerInfo[playerid][pInterior] = 0;
                                            // FIX AUDIT SPAWN S1-3: resetear Casa=-1 en anti-evasion.
                                            PlayerInfo[playerid][Casa] = -1;
                                            DeletePVar(playerid, "AntiEvasion");
                                        }
                                        // FIX AUDIT LOGIN F2-5: re-abrir DIALOG_EMAIL si pEmail esta vacio.
                                        // Antes: si el jugador se desconectaba entre DIALOG_REGISTRO
                                        // (donde eligio senha) y DIALOG_EMAIL (donde escribe email),
                                        // su cuenta quedaba con pEmail="" permanente. El colegio nunca
                                        // le volvia a preguntar por el email. Ese jugador no podia
                                        // recuperar su cuenta si perdia la senha (no habia email
                                        // asociado para reseteo).
                                        // Ahora: al cargar los datos, si pEmail=="" Y FirstLogin==false
                                        // (jugador existente, no nuevo), re-abrimos DIALOG_EMAIL.
                                        // Si FirstLogin==true (registro nuevo), el flujo normal ya
                                        // pasa por DIALOG_EMAIL despues.
                                        if(FirstLogin[playerid] == false && strlen(PlayerInfo[playerid][pEmail]) == 0)
                                        {
                                                ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Tu cuenta no tiene email asociado.\n{FF0000}Debes escribir tu email para continuar.", "Validar", "");
                                                return 1;
                                        }
                                        // FIX AUDIT LOGIN F3-4: setear pLogado=true ANTES de SpawnPlayer.
                                        // Antes: pLogado[playerid]=true se seteaba DESPUES de los 3
                                        // SpawnPlayer (L30278, L30301, L30317). SpawnPlayer dispara
                                        // sincronamente OnPlayerSpawn, que veia pLogado=false y podia
                                        // comportarse mal (ej: no cargar textdraws, no inicializar
                                        // variables de trabajo, etc). Ahora: seteamos pLogado ANTES
                                        // del primer SpawnPlayer, asi OnPlayerSpawn ve pLogado=true.
                                        // Nota: este cambio tambien beneficia a OnPlayerStateChange
                                        // (disparado por SpawnPlayer) y otros callbacks sincronos.
                                        // Mantenemos los sets al final tambien (idempotentes).
                                        pLogado[playerid] = true;
                                        pJogando[playerid] = true;
                                        if(FirstLogin[playerid] == false)
                                        {
                                                // FIX AUDIT SPAWN S0-1: bounds check Casa contra out-of-bounds.
                                                // Antes: si el archivo Contas/<nick>.ini tenia pCasa >= MAX_CASAS (500)
                                                // (por corrupcion o edicion manual), DIALOG_LOGIN cargaba ese valor
                                                // y el branch Casa>=0 accedia CasaInfo[Casa] fuera de limite.
                                                // Eso causaba crash del server o memory corruption (leer datos
                                                // de otros arrays, posiciones absurdas, etc).
                                                // Ahora: si Casa >= MAX_CASAS, poner Casa = -1 (sin casa).
                                                // Asi el branch Casa>=0 no se ejecuta y aparece en posicion guardada.
                                                // Tambien clamp negativos (Casa < -1) a -1.
                                                if(PlayerInfo[playerid][Casa] >= MAX_CASAS || PlayerInfo[playerid][Casa] < -1)
                                                {
                                                        PlayerInfo[playerid][Casa] = -1;
                                                }
                                                // FIX AUDIT SPAWN S1-2: forzar spawn en jail si pjail > 0.
                                                // Antes: un preso con casa se teleportaba a la celda (interior 5, VW 0)
                                                // en OnPlayerSpawn, pero DESPUES DIALOG_LOGIN sobreescribia el
                                                // interior y VW con los de SU CASA. Checkjail solo comparaba X/Y/Z
                                                // (sin interior/VW) -> cree que sigue en jail -> no teleporta de
                                                // vuelta. El preso tenia VW de su casa durante toda su condena.
                                                // Ahora: si pjail > 0, forzamos Casa = -1 para que el branch Casa
                                                // no se ejecute. El preso spawnea en posicion guardada (que
                                                // OnPlayerSpawn sobreescribira con la celda de jail).
                                                if(PlayerInfo[playerid][pjail] > 0)
                                                {
                                                        PlayerInfo[playerid][Casa] = -1;
                                                }
                                                // FIX AUDIT SPAWN S1-8: ownership check Casa.
                                                // Antes: no habia validacion de que la casa pertenece al jugador.
                                                // Si la casa fue vendida a OTRO jugador (o el ID se reuso), el
                                                // jugador podia spawn en casa ajena. Bug de privacidad.
                                                // Ahora: si la casa existe pero el dueno no es el jugador,
                                                // poner Casa = -1 y spawnear en posicion guardada.
                                                if(PlayerInfo[playerid][Casa] >= 0 && PlayerInfo[playerid][Casa] < MAX_CASAS)
                                                {
                                                        if(strcmp(CasaInfo[PlayerInfo[playerid][Casa]][CasaDono], Name(playerid)) != 0)
                                                        {
                                                                PlayerInfo[playerid][Casa] = -1;
                                                        }
                                                }
                                                // FIX: Usar la posicion guardada del jugador en vez de coords hardcodeadas
                                                if(PlayerInfo[playerid][Casa] >= 0)
                                                {
                                                        PlayerInfo[playerid][Entrada] = PlayerInfo[playerid][Casa];
                                                        // FIX AUDIT SPAWN S2-1: SetPlayerInterior ANTES de SpawnPlayer.
                                                        // Antes: SetPlayerInterior se llamaba DESPUES de SpawnPlayer.
                                                        // Por 1 tick, el jugador estaba en interior incorrecto (0 por defecto).
                                                        // Eso causaba glitch visual (1 frame en interior equivocado).
                                                        // Ahora: setear interior ANTES de spawn. SetSpawnInfo no setea interior.
                                                        SetPlayerInterior(playerid, CasaInfo[PlayerInfo[playerid][Casa]][CasaInterior]);
                                                        SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][Casa]);
                                                        SetSpawnInfo(playerid, 0, PlayerInfo[playerid][pSkin],
                                                                CasaInfo[PlayerInfo[playerid][Casa]][CasaInteriorX],
                                                                CasaInfo[PlayerInfo[playerid][Casa]][CasaInteriorY],
                                                                CasaInfo[PlayerInfo[playerid][Casa]][CasaInteriorZ],
                                                                0.0, -1, -1, -1, -1, -1, -1);
                                                        SpawnPlayer(playerid);
                                                        SetPlayerHealth(playerid, PlayerInfo[playerid][pVida]);
                                                        SetPlayerArmour(playerid, PlayerInfo[playerid][pColete]);
                                                        if(PlayerInfo[playerid][pColete] > 0) g_ChalecoPermitido[playerid] = true;
                                                }
                                                else
                                                {
                                                        // Spawnear en la ultima posicion guardada del jugador
                                                        // FIX AUDIT SPAWN S2-1: SetPlayerInterior ANTES de SpawnPlayer (rama posicion guardada).
                                                        SetPlayerInterior(playerid, PlayerInfo[playerid][pInterior]);
                                                        // FIX AUDIT SPAWN S2-2: setear VW persistido (no 0 por defecto).
                                                        SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "SavedVW"));
                                                        SetSpawnInfo(playerid, 0, PlayerInfo[playerid][pSkin],
                                                                PlayerInfo[playerid][pPosX],
                                                                PlayerInfo[playerid][pPosY],
                                                                PlayerInfo[playerid][pPosZ],
                                                                PlayerInfo[playerid][pPosA],
                                                                -1, -1, -1, -1, -1, -1);
                                                        SpawnPlayer(playerid);
                                                        SetPlayerHealth(playerid, PlayerInfo[playerid][pVida]);
                                                        SetPlayerArmour(playerid, PlayerInfo[playerid][pColete]);
                                                        if(PlayerInfo[playerid][pColete] > 0) g_ChalecoPermitido[playerid] = true;
                                                }
                                                format(Str, sizeof(Str), "Bienvenido %04d. Su ultimo login fue el %s.", GetPlayerIdfixo(playerid), PlayerInfo[playerid][pLastLogin]);
                                                InfoMsg(playerid, Str);
                                                g_TxdLoginTimer[playerid] = SetTimerEx("TxdLogin", 2000, false, "d",playerid);
                                        }
                                        else
                                        {
                                                SetPlayerHealth(playerid, 100);
                                                PlayerInfo[playerid][pVida] = 100;
                                                SetSpawnInfo(playerid, 0, PlayerInfo[playerid][pSkin], 1568.130615, -1891.800415, 13.559370, 1.185642, -1, -1, -1, -1, -1, -1);
                                                SpawnPlayer(playerid);
                                                // FIX AUDIT LOGIN F2-11: aplicar HP/armour inmediatamente (registro nuevo).
                                                // Para registro nuevo, pVida=100 y pColete=100 (se setearon en registro).
                                                SetPlayerHealth(playerid, PlayerInfo[playerid][pVida]);
                                                SetPlayerArmour(playerid, PlayerInfo[playerid][pColete]);
                                                if(PlayerInfo[playerid][pColete] > 0) g_ChalecoPermitido[playerid] = true;
                                                FirstLogin[playerid] = false;
                                                g_TxdLoginTimer[playerid] = SetTimerEx("TxdLogin", 2000, false, "d",playerid);
                                        }
                                        CancelSelectTextDraw(playerid);
                                        // FIX AUDIT LOGIN F1-6: Timers() despues de pLogado=true.
                                        // Antes: Timers(playerid) se llamaba en L30041, ANTES de
                                        // pLogado[playerid]=true (L30044). Si el jugador se
                                        // desconectaba en esa ventana de 3 lineas (microsegundos),
                                        // los 8 timers creados por Timers() (FomeBar, SedeBar,
                                        // Colete, PayDay, PagoOrg, AttVeh, CheckRadares, TimerHack)
                                        // se quedaban corriendo sobre el slot sin que
                                        // OnPlayerDisconnect los matara (porque el bloque
                                        // KillTimer estaba detras de if(pLogado==true)).
                                        // En slot reuse, el nuevo jugador tenia 16 timers: 8 zombies
                                        // del anterior + 8 propios. Hambre/sed 2x, PayDay doble.
                                        //
                                        // Fix: mover Timers(playerid) a DESPUES de pLogado=true.
                                        // Asi, si el jugador se desconecta antes de pLogado=true,
                                        // los timers NUNCA llegaron a crearse. Si se desconecta
                                        // despues, OnPlayerDisconnect los mata correctamente.
                                        //
                                        // Diseno para futuros timers: si en el futuro se anaden
                                        // mas timers a stock Timers(), se beneficiaran automaticamente
                                        // de este fix (todos se crean despues de pLogado=true).
                                        // No hay que modificar nada mas. Si se crea un timer FUERA
                                        // de stock Timers() (por ejemplo en un comando o dialog),
                                        // recordar asignarlo a una variable per-player para poder
                                        // matarlo en OnPlayerDisconnect o ZerarDados.
                                        // FIX: solo forzar VW=0 si el jugador no esta en una casa
                                        if(PlayerInfo[playerid][Casa] < 0) SetPlayerVirtualWorld(playerid, 0);
                                        pLogado[playerid] = true;
                                        pJogando[playerid] = true;
                                        Timers(playerid);

                                        // P0-BEN-GRUA: cargar pagos pendientes de traslado de grua
                                        // (mientras el mecanico estuvo offline)
                                        LoadPendingTowPayments(playerid);

                                        // P0-TERRITORIO: mostrar GangZones al jugador
                                        Terr_MostrarAJugador(playerid);

                                        // P2-PN-4: resetear estado de patrullaje al conectar.
                                        // Antes: si el servidor crasheaba con policias en servicio, al reiniciar
                                        // policiaon arrancaba en 0 pero el jugador podia reconectar con Patrulha=true
                                        // (si se persistia), causando desincronizacion del contador.
                                        // Ahora: al conectar, Patrulha siempre se fuerza a false. El policia debe
                                        // re-entrar en servicio manualmente desde el textdraw.
                                        if(Patrulha[playerid] == true)
                                        {
                                                Patrulha[playerid] = false;
                                                printf("[P2-PN-4] Policia ID %d (%s) reconecto con Patrulha=true, forzado a false.", playerid, Name(playerid));
                                        }

                                        // P1-FBI-1: migracion FBI de 6 rangos a 5 rangos.
                                        // Si un FBI tiene cargo 6 (viejo Director), se lo demuele a 5 (nuevo Director).
                                        // Esto se hace una sola vez al conectar; despues el jugador guarda su nuevo cargo.
                                        if(PlayerInfo[playerid][Org] == 3 && PlayerInfo[playerid][Cargo] > 5)
                                        {
                                                printf("[P1-FBI-1] Migracion FBI: ID %d (%s) tenia cargo %d, demovido a 5 (Director).", playerid, Name(playerid), PlayerInfo[playerid][Cargo]);
                                                PlayerInfo[playerid][Cargo] = 5;
                                                SalvarDados(playerid);
                                        }
                                        // P1-FBI-2: restaurar modo encubierto persistido al conectar.
                                        // Si el FBI se desconecto estando encubierto (operativo en curso),
                                        // al reconectar sigue encubierto para no romper la cobertura.
                                        // Se le asigna un skin civil nuevo y color blanco.
                                        if(PlayerInfo[playerid][pEncubierto] == true && PlayerInfo[playerid][Org] == 3)
                                        {
                                                g_FBIEncubierto[playerid] = true;
                                                // Skin civil aleatorio (no podemos recuperar el skin exacto anterior,
                                                // pero cualquier skin civil sirve para mantener la cobertura)
                                                new idx = random(sizeof(g_FBISkinsCiviles));
                                                SetPlayerSkin(playerid, g_FBISkinsCiviles[idx]);
                                                SetPlayerColor(playerid, 0xFFFFFFFF); // color civil
                                                InfoMsg(playerid, "Modo encubierto restaurado. Sigues encubierto del operativo anterior.");
                                                printf("[P1-FBI-2] FBI ID %d (%s) reconecto en modo encubierto (operativo en curso).", playerid, Name(playerid));
                                        }
                                        else
                                        {
                                                // No estaba encubierto, asegurar flags en false
                                                g_FBIEncubierto[playerid] = false;
                                                g_FBISkinOriginal[playerid] = 0;
                                        }

                                        // CAMBIO 2026-07-12 - Fase 4: recuperar helicoptero pendiente si reconecta.
                                        if(HeliPendienteVeh != INVALID_VEHICLE_ID)
                                        {
                                            new pname[MAX_PLAYER_NAME];
                                            GetPlayerName(playerid, pname, MAX_PLAYER_NAME);
                                            if(strcmp(pname, HeliPendienteNome) == 0)
                                            {
                                                VeiculoCivil[playerid] = HeliPendienteVeh;
                                                VehAlugado[playerid] = 1;
                                                HeliPendienteVeh = INVALID_VEHICLE_ID;
                                                HeliPendienteNome[0] = EOS;
                                                InfoMsg(playerid, "Tu helicoptero del techo sigue disponible. Sube a usarlo.");
                                            }
                                        }

                                        // ===== AVISO DE DEUDA FISCAL AL CONECTARSE =====
                                        if(PlayerInfo[playerid][ImpuestoPendiente] > 0)
                                        {
                                                new deudamsg[256];
                                                new dias = PlayerInfo[playerid][ImpuestoPayDaysSinPagar];
                                                if(PlayerInfo[playerid][BancoBloqueado] == 1)
                                                {
                                                        format(deudamsg, sizeof(deudamsg), "AYUNTAMIENTO: Tu cuenta bancaria esta BLOQUEADA. Tienes una deuda fiscal de $%d (%d PayDays sin pagar). Ve al Ayuntamiento a pagar.", PlayerInfo[playerid][ImpuestoPendiente], dias);
                                                }
                                                else
                                                {
                                                        format(deudamsg, sizeof(deudamsg), "AYUNTAMIENTO: Tienes una deuda fiscal de $%d (%d PayDays sin pagar). Ve al Ayuntamiento a pagar antes de acumular recargos.", PlayerInfo[playerid][ImpuestoPendiente], dias);
                                                }
                                                SetTimerEx("AvisarDeudaLogin", 5000, false, "i", playerid); // avisa 5 seg despues de loguearse
                                                SetPVarString(playerid, "DeudaMsgLogin", deudamsg);
                                        }
                                        // Mensaje de bienvenida - se muestra una vez al loguearse y desaparece a los 10 segundos
                                        if(TimerBienvenida[playerid] != 0) { KillTimer(TimerBienvenida[playerid]); TimerBienvenida[playerid] = 0; }
                                        for(new _bi = 0; _bi < 3; _bi++) { PlayerTextDrawHide(playerid, TDBienvenida[playerid][_bi]); PlayerTextDrawDestroy(playerid, TDBienvenida[playerid][_bi]); }
                                        TDBienvenida[playerid][0] = CreatePlayerTextDraw(playerid, 320.0, 70.0, "~y~Bienvenido a~w~ Farandula RP");
                                        PlayerTextDrawLetterSize(playerid, TDBienvenida[playerid][0], 0.60, 2.8);
                                        PlayerTextDrawAlignment(playerid, TDBienvenida[playerid][0], 2);
                                        PlayerTextDrawColor(playerid, TDBienvenida[playerid][0], 0xFFFFFFFF);
                                        PlayerTextDrawSetOutline(playerid, TDBienvenida[playerid][0], 2);
                                        PlayerTextDrawSetShadow(playerid, TDBienvenida[playerid][0], 0);
                                        PlayerTextDrawBackgroundColor(playerid, TDBienvenida[playerid][0], 0x000000CC);
                                        PlayerTextDrawFont(playerid, TDBienvenida[playerid][0], 1);
                                        PlayerTextDrawSetProportional(playerid, TDBienvenida[playerid][0], 1);
                                        PlayerTextDrawShow(playerid, TDBienvenida[playerid][0]);
                                        TDBienvenida[playerid][1] = CreatePlayerTextDraw(playerid, 320.0, 115.0, "~w~Respeta las normas _ usa ~/~/ayuda para ver los comandos");
                                        PlayerTextDrawLetterSize(playerid, TDBienvenida[playerid][1], 0.30, 1.4);
                                        PlayerTextDrawAlignment(playerid, TDBienvenida[playerid][1], 2);
                                        PlayerTextDrawColor(playerid, TDBienvenida[playerid][1], 0xFFFF00FF);
                                        PlayerTextDrawSetOutline(playerid, TDBienvenida[playerid][1], 1);
                                        PlayerTextDrawSetShadow(playerid, TDBienvenida[playerid][1], 0);
                                        PlayerTextDrawBackgroundColor(playerid, TDBienvenida[playerid][1], 0x000000CC);
                                        PlayerTextDrawFont(playerid, TDBienvenida[playerid][1], 1);
                                        PlayerTextDrawSetProportional(playerid, TDBienvenida[playerid][1], 1);
                                        PlayerTextDrawShow(playerid, TDBienvenida[playerid][1]);
                                        TDBienvenida[playerid][2] = CreatePlayerTextDraw(playerid, 320.0, 145.0, "~r~Reporta bugs o abusos a un administrador");
                                        PlayerTextDrawLetterSize(playerid, TDBienvenida[playerid][2], 0.28, 1.3);
                                        PlayerTextDrawAlignment(playerid, TDBienvenida[playerid][2], 2);
                                        PlayerTextDrawColor(playerid, TDBienvenida[playerid][2], 0xFFFFFFFF);
                                        PlayerTextDrawSetOutline(playerid, TDBienvenida[playerid][2], 1);
                                        PlayerTextDrawSetShadow(playerid, TDBienvenida[playerid][2], 0);
                                        PlayerTextDrawBackgroundColor(playerid, TDBienvenida[playerid][2], 0x000000CC);
                                        PlayerTextDrawFont(playerid, TDBienvenida[playerid][2], 1);
                                        PlayerTextDrawSetProportional(playerid, TDBienvenida[playerid][2], 1);
                                        PlayerTextDrawShow(playerid, TDBienvenida[playerid][2]);
                                        TimerBienvenida[playerid] = SetTimerEx("OcultarBienvenida", 10000, false, "i", playerid);
                                        Erro[playerid] = 0;
                                        ErroLogin[playerid] = 0; // FIX AUDIT LOGIN F2-9: reset de ErroLogin en login success
                                        StopAudioStreamForPlayer(playerid);
                                        GangZoneShowForPlayer(playerid, Parabolica, 0xFFFFFF80);
                                GangZoneShowForPlayer(playerid, Barragem, 0xFFFFFF80);
                                        new hora, minuto;
                                        gettime(hora, minuto);
                                        jogadoreson++;
                                        if(Plataforma[playerid] == -1)
                                        {
                                                ShowPlayerDialog(playerid, D_ESCOLHERPLATAFORMA, DIALOG_STYLE_MSGBOX, "{FFFFFF}"SERVER_NAME" Roleplay", "{FFFFF0}EN CUAL PLATAFORMA USTED JUEGA?", "{FFFFFF}PC", "{FFFFFF}MOBILE");
                                        }
                                }
                        }
                }
                case DIALOG_EMAIL:
                {
                        // FIX AUDIT LOGIN F2-3: si el jugador presiona X (cancelar), kick.
                        // Antes: si presionaba X, el dialog se re-abria. Bucle infinito UX trap.
                        // Ahora: kick directo para permitir escapar limpiamente.
                        if(!response)
                        {
                                InfoMsg(playerid, "No ingresaste email. Desconectado.");
                                Kick(playerid);
                                return 1;
                        }
                        if(response)
                        {
                                if(strlen(inputtext) >= 13 && strlen(inputtext) <= 40)
                                {
                                        // FIX AUDIT LOGIN F2-4: validacion de email mejorada.
                                        // Antes: solo 4 dominios hardcoded (@gmail.com, @hotmail.com,
                                        // @outlook.com, @yahoo.com.br) y usaba strfind (cualquiera
                                        // que CONTENGA el dominio, no que TERMINARA con el).
                                        // Aceptar CUALQUIER dominio valido (formato texto@texto.dominio).
                                        // strfind aceptaba "hacker@gmail.com@evil.net" porque
                                        // contiene "@gmail.com". Eso es un bug.
                                        // Ahora:
                                        // 1. Verificar que el email tiene exactamente 1 @
                                        // 2. Verificar que termina con .X donde X es 2-4 letras
                                        // 3. IsValidInput sigue verificando caracteres validos
                                        // (NOTA: F2-4 v2 podria mejorar IsValidInput para aceptar
                                        // - y + validos en emails, pero eso requeriria tocar otra
                                        // funcion y podria romper otras validaciones. Por ahora
                                        // mantenemos IsValidInput como esta.)
                                        new atCount = 0;
                                        new atPos = -1;
                                        for(new i = 0; i < strlen(inputtext); i++)
                                        {
                                                if(inputtext[i] == '@') { atCount++; atPos = i; }
                                        }
                                        if(atCount == 1 && atPos > 0 && atPos < strlen(inputtext) - 3)
                                        {
                                                // Verificar que termina con .X (punto + 2-4 letras)
                                                new dotPos = -1;
                                                for(new i = strlen(inputtext) - 1; i > atPos; i--)
                                                {
                                                        if(inputtext[i] == '.') { dotPos = i; break; }
                                                }
                                                if(dotPos > 0 && (strlen(inputtext) - dotPos - 1) >= 2 && (strlen(inputtext) - dotPos - 1) <= 4)
                                                {
                                                        if(IsValidInput(inputtext))
                                                        {
                                                                format(PlayerInfo[playerid][pEmail], 40, "%s", inputtext);
                                                                actorcad[playerid] = CreateActor(0, 1984.0140,1194.2424,26.8835,135.6409);
                                                                SetPlayerCameraPos(playerid, 1981.038940, 1191.061401, 27.828259);
                                                                SetPlayerCameraLookAt(playerid, 1985.139648, 1195.111572, 27.636171);
                                                                for(new i=0;i<18;i++){
                                                                        TextDrawShowForPlayer(playerid, TDCadastro[i]);
                                                                        if(i == 18)break;
                                                                }
                                                                for(new i=0;i<7;i++){
                                                                        PlayerTextDrawShow(playerid, TDCadastro_p[playerid][i]);
                                                                        if(i == 7)break;
                                                                }
                                                                MostrandoMenu[playerid] = true;
                                                                SelectTextDraw(playerid, 0xFF0000FF);
                                                        }
                                                        else
                                                        {
                                                                ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Escribe tu email para continuar con el registro\n{FF0000}Caracteres invalidos detectados.", "Validar", "");
                                                                ErrorMsg(playerid, "El email contiene caracteres invalidos.");
                                                        }
                                                }
                                                else
                                                {
                                                        ErrorMsg(playerid, "Debes colocar un email valido (dominio .X con 2-4 letras).");
                                                        ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Escribe tu email para continuar con el registro\n{FF0000}Debes escribir el email correctamente.", "Validar", "");
                                                }
                                        }
                                        else
                                        {
                                                ErrorMsg(playerid, "Debes colocar un email valido (exactamente 1 @).");
                                                ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Escribe tu email para continuar con el registro\n{FF0000}Debes escribir el email correctamente.", "Validar", "");
                                        }
                                }else{
                                        ErrorMsg(playerid, "Debes colocar un email valido (13-40 caracteres).");
                                        ShowPlayerDialog(playerid, DIALOG_EMAIL, DIALOG_STYLE_INPUT, "{FFFFFF}Email", "\n{FFFFFF}Escribe tu email para continuar con el registro\n{FF0000}Debes escribir el email correctamente.", "Validar", "");
                                }
                        }
                }
                case D_ESCOLHERPLATAFORMA:
                {
                        if(response)
                  {
                                Plataforma[playerid] = 0;
                        }
                        else
                        {
                                Plataforma[playerid] = 1;
                        }
                }
                case D_HOSP:
                {
                    if(response)
                    {
                        switch(listitem)
                        {
                            // case 0: Kit Medico $1500 -> +1 kit en KitsMedicos[] (max 6)
                            case 0:
                            {
                                if(PlayerInfo[playerid][pDinheiro] < 1500)
                                    return SendClientMessage(playerid, -1, "| ERROR | No tienes dinero suficiente");
                                if(KitsMedicos[playerid] >= MAX_KITS_MEDICOS)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes el maximo de kits (6)");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -1500);
                                KitsMedicos[playerid] += 1;
                                new msg[128];
                                format(msg, sizeof(msg), "| HOSPITAL | Compraste un Kit Medico por {228B22}$1500{FFFFFF}. Total: {FF69B4}%d/%d{FFFFFF}. Usa /usarkit para curarte.", KitsMedicos[playerid], MAX_KITS_MEDICOS);
                                SendClientMessage(playerid, -1, msg);
                                return 1;
                            }
                            // case 1: Plano de Salud $5000 -> abre D_PLANOSAUDE para confirmar
                            case 1:
                            {
                                if(PlanoSaude[playerid] > 0)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes un plan de salud contratado");
                                ShowPlayerDialog(playerid, D_PLANOSAUDE, DIALOG_STYLE_MSGBOX, "{6C28BE}Plan de Salud",
                                    "\n{FFFFFF}El {6C28BE}Plan de Salud {FFFFFF}cubrira todas las tasas hospitalarias cuando mueras\n\nEste contrato dura 10 muertes. Luego de morir 10 veces necesitas renovar el contrato\n\n{00FF00}Deseas contratarlo?",
                                    "Contratar", "Cancelar");
                                return 1;
                            }
                            // case 2: Kit MEDICO gratis (solo medico) -> abre D_KITMEDICO
                            case 2:
                            {
                                if(PlayerInfo[playerid][Org] != 10)
                                    return SendClientMessage(playerid, -1, "| ERROR | Usted no pertenece a Paramedico"); // Migrado a Org 10
                                ShowPlayerDialog(playerid, D_KITMEDICO, DIALOG_STYLE_INPUT, "{FFFFFF}Kit {FF69B4}MEDICO",
                                    "\n{FFFFFF}Ingrese la cantidad de Kits Medicos que desea comprar (1-6):", "Comprar", "Cancelar");
                                return 1;
                            }
                            // case 3: Vendaje $750 -> +1 vendaje en Vendajes[] (max 8)
                            case 3:
                            {
                                if(PlayerInfo[playerid][pDinheiro] < 750)
                                    return SendClientMessage(playerid, -1, "| ERROR | No tienes dinero suficiente");
                                if(Vendajes[playerid] >= MAX_VENDAJES)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes el maximo de vendajes (8)");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -750);
                                Vendajes[playerid] += 1;
                                new msg[128];
                                format(msg, sizeof(msg), "| HOSPITAL | Compraste un vendaje por {228B22}$750{FFFFFF}. Total: {FF69B4}%d/%d{FFFFFF}. Usa /usarvendaje para curarte.", Vendajes[playerid], MAX_VENDAJES);
                                SendClientMessage(playerid, -1, msg);
                                return 1;
                            }
                            // case 4: Botiquin (solo medico) -> cura +100 HP + comida + agua
                            case 4:
                            {
                                if(PlayerInfo[playerid][Org] != 10)
                                    return SendClientMessage(playerid, -1, "| ERROR | Solo los Paramedicos pueden usar el botiquin"); // Migrado a Org 10
                                // FIX AUDIT MEDICO A4-REHAB-MED-01: cooldown 60s para botiquin.
                                // ANTES: botiquin era GRATIS para Org 10 (sin costo, sin cooldown, sin cap).
                                // HP+100, hambre+100, sed+100. Auto-curaciÃ¯Â¿Â½n y "comida gratis" ilimitada.
                                // AHORA: cooldown 60s via PVar CD_botiquin para evitar abuso PvP.
                                new _nowBq = gettime();
                                if(_nowBq - GetPVarInt(playerid, "CD_botiquin") < 60)
                                {
                                    new _faltaBq = 60 - (_nowBq - GetPVarInt(playerid, "CD_botiquin"));
                                    new _msgBq[100];
                                    format(_msgBq, sizeof(_msgBq), "| ERROR | Debes esperar %d segundos para usar otro botiquin.", _faltaBq);
                                    return SendClientMessage(playerid, -1, _msgBq);
                                }
                                SetPVarInt(playerid, "CD_botiquin", _nowBq);
                                new Float:hp; GetPlayerHealth(playerid, hp);
                                if(hp >= 100.0 && FomePlayer[playerid] >= 100 && SedePlayer[playerid] >= 100)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya estas completamente curado");
                                SetPlayerHealth(playerid, 100.0);
                                FomePlayer[playerid] = 100;
                                SedePlayer[playerid] = 100;
                                SendClientMessage(playerid, -1, "| HOSPITAL | Usaste un botiquin. Vida, hambre y sed al maximo.");
                                GameTextForPlayer(playerid, "~g~Botiquin aplicado", 2000, 3);
                                return 1;
                            }
                            // CAMBIO 2026-07-20: case 5: Vacunas ($800 c/u, inmunidad 7 dias)
                            case 5:
                            {
                                // Construir dialog de vacunas con estado actual
                                new vacStr[800];
                                new tiempoActual = gettime();
                                strcat(vacStr, "{FFFFFF}Vacuna\t{228B22}Precio\t{FFFFFF}Estado\n");

                                // Antigripal
                                if(VacunaAntigripal[playerid] > tiempoActual)
                                {
                                    new diasRest = (VacunaAntigripal[playerid] - tiempoActual) / 86400;
                                    new line[120];
                                    format(line, sizeof(line), "{FFFF00}Antigripal{FFFFFF}\t{228B22}$800\t{00FF00}Activa (%dd)\n", diasRest);
                                    strcat(vacStr, line);
                                }
                                else
                                    strcat(vacStr, "{FFFF00}Antigripal{FFFFFF}\t{228B22}$800\t{FF0000}No aplicada\n");

                                // Antitetanica
                                if(VacunaAntitetanica[playerid] > tiempoActual)
                                {
                                    new diasRest = (VacunaAntitetanica[playerid] - tiempoActual) / 86400;
                                    new line[120];
                                    format(line, sizeof(line), "{FFFF00}Antitetanica{FFFFFF}\t{228B22}$800\t{00FF00}Activa (%dd)\n", diasRest);
                                    strcat(vacStr, line);
                                }
                                else
                                    strcat(vacStr, "{FFFF00}Antitetanica{FFFFFF}\t{228B22}$800\t{FF0000}No aplicada\n");

                                // Antirrabica
                                if(VacunaAntirrabica[playerid] > tiempoActual)
                                {
                                    new diasRest = (VacunaAntirrabica[playerid] - tiempoActual) / 86400;
                                    new line[120];
                                    format(line, sizeof(line), "{FFFF00}Antirrabica{FFFFFF}\t{228B22}$800\t{00FF00}Activa (%dd)\n", diasRest);
                                    strcat(vacStr, line);
                                }
                                else
                                    strcat(vacStr, "{FFFF00}Antirrabica{FFFFFF}\t{228B22}$800\t{FF0000}No aplicada\n");

                                // Hepatitis
                                if(VacunaHepatitis[playerid] > tiempoActual)
                                {
                                    new diasRest = (VacunaHepatitis[playerid] - tiempoActual) / 86400;
                                    new line[120];
                                    format(line, sizeof(line), "{FFFF00}Hepatitis{FFFFFF}\t{228B22}$800\t{00FF00}Activa (%dd)\n", diasRest);
                                    strcat(vacStr, line);
                                }
                                else
                                    strcat(vacStr, "{FFFF00}Hepatitis{FFFFFF}\t{228B22}$800\t{FF0000}No aplicada\n");

                                strcat(vacStr, "\n{AAAAAA}Las vacunas otorgan inmunidad por 7 dias reales.\n");
                                strcat(vacStr, "{AAAAAA}Reducen 90% la probabilidad de contagio de esa enfermedad.\n");
                                strcat(vacStr, "{AAAAAA}Si ya tienes la enfermedad, la vacuna NO la cura - solo previene futuros contagios.");

                                ShowPlayerDialog(playerid, DIALOG_VACUNAS, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Carnet de Vacunacion", vacStr, "Comprar", "Cancelar");
                                return 1;
                            }
                        }
                    }
                    return 1;
                }
                // =====================================================================
                // CAMBIO 2026-07-20 - DIALOG_VACUNAS: comprar/aplicar vacunas
                // 4 tipos: Antigripal (0), Antitetanica (1), Antirrabica (2), Hepatitis (3)
                // Precio: $800 c/u, inmunidad 7 dias reales
                // =====================================================================
                case DIALOG_VACUNAS:
                {
                    if(response)
                    {
                        new precioVac = 800;
                        if(PlayerInfo[playerid][pDinheiro] < precioVac)
                            return ErrorMsg(playerid, "No tienes $800 para la vacuna.");

                        new tiempoActual = gettime();
                        new diasVac = 7;
                        new vencimiento = tiempoActual + (diasVac * 86400); // 7 dias en segundos
                        new vacName[24];

                        switch(listitem)
                        {
                            case 0: // Antigripal
                            {
                                if(VacunaAntigripal[playerid] > tiempoActual)
                                    return ErrorMsg(playerid, "Ya tienes la vacuna antigripal activa. Espera a que venza para renovarla.");
                                VacunaAntigripal[playerid] = vencimiento;
                                vacName = "Antigripal";
                            }
                            case 1: // Antitetanica
                            {
                                if(VacunaAntitetanica[playerid] > tiempoActual)
                                    return ErrorMsg(playerid, "Ya tienes la vacuna antitetanica activa. Espera a que venza para renovarla.");
                                VacunaAntitetanica[playerid] = vencimiento;
                                vacName = "Antitetanica";
                            }
                            case 2: // Antirrabica
                            {
                                if(VacunaAntirrabica[playerid] > tiempoActual)
                                    return ErrorMsg(playerid, "Ya tienes la vacuna antirrabica activa. Espera a que venza para renovarla.");
                                VacunaAntirrabica[playerid] = vencimiento;
                                vacName = "Antirrabica";
                            }
                            case 3: // Hepatitis
                            {
                                if(VacunaHepatitis[playerid] > tiempoActual)
                                    return ErrorMsg(playerid, "Ya tienes la vacuna contra hepatitis activa. Espera a que venza para renovarla.");
                                VacunaHepatitis[playerid] = vencimiento;
                                vacName = "Hepatitis";
                            }
                            default:
                            {
                                // FIX AUDITORIA 2026-07-20: listitem invalido, no hacer nada
                                return 1;
                            }
                        }

                        // Cobrar
                        AC_AddPlayerMoney(playerid, -precioVac);

                        // Animacion de inyeccion + feedback
                        ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
                        GameTextForPlayer(playerid, "~g~Vacuna aplicada!", 2000, 3);

                        new msg[200];
                        format(msg, sizeof(msg), "| HOSPITAL | Te aplicaste la vacuna %s por {228B22}$800{FFFFFF}. Inmunidad por 7 dias.", vacName);
                        SendClientMessage(playerid, 0x228B22FF, msg);

                        // Guardar datos inmediatamente
                        SalvarDados(playerid);
                    }
                    return 1;
                }
