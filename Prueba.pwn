        LockText[playerid][8] = CreatePlayerTextDraw(playerid, LockLocation[playerid], 385.0, "_"), PlayerTextDrawUseBox(playerid, LockText[playerid][8], 1);
        PlayerTextDrawLetterSize(playerid, LockText[playerid][8], 0.5, 1.4), PlayerTextDrawTextSize(playerid, LockText[playerid][8], LockLocation[playerid]+LockSize[playerid], 71.0);
        PlayerTextDrawFont(playerid, LockText[playerid][8], 1), PlayerTextDrawSetProportional(playerid, LockText[playerid][8], 1);
        PlayerTextDrawBackgroundColor(playerid, LockText[playerid][8], 255), PlayerTextDrawBoxColor(playerid, LockText[playerid][8], -1094795521);

        LockText[playerid][9] = CreatePlayerTextDraw(playerid, 207.0, 385.0, "_"), PlayerTextDrawUseBox(playerid, LockText[playerid][9], 1);
        PlayerTextDrawLetterSize(playerid, LockText[playerid][9], 0.5, 1.4), PlayerTextDrawTextSize(playerid, LockText[playerid][9], 207.0, 71.0);
        PlayerTextDrawFont(playerid, LockText[playerid][9], 1), PlayerTextDrawSetProportional(playerid, LockText[playerid][9], 1);
        PlayerTextDrawBackgroundColor(playerid, LockText[playerid][9], 255), PlayerTextDrawBoxColor(playerid, LockText[playerid][9], -5963521);

        LockText[playerid][10] = CreatePlayerTextDraw(playerid, 315.0, 386.0, "Presione (ESPACO) na barra para prosseguir"), PlayerTextDrawSetShadow(playerid, LockText[playerid][10], 0);
        PlayerTextDrawBackgroundColor(playerid, LockText[playerid][10], 255), PlayerTextDrawLetterSize(playerid, LockText[playerid][10], 0.18, 1.0);
        PlayerTextDrawFont(playerid, LockText[playerid][10], 2), PlayerTextDrawSetProportional(playerid, LockText[playerid][10], 1);
        PlayerTextDrawAlignment(playerid, LockText[playerid][10], 2), PlayerTextDrawSetShadow(playerid, LockText[playerid][10], 0), PlayerTextDrawColor(playerid, LockText[playerid][10], -56);
