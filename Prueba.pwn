    // FIX ALTO-XP-003 (ALTO): eliminada la recreacion de mda_TD[0..2] globales en darxp.
    // ANTES: cada vez que un jugador recibia XP, se destruian y recreaban los 3 TextDraws
    // GLOBALES (mda_TD[0]=SERVER_NAME, mda_TD[1]="Roleplay", mda_TD[2]=reloj) para TODOS
    // los jugadores. Esto causaba flicker visual + reset del reloj a "12:00 AM" + 6 RPC globales.
    // AHORA: mda_TD[0..2] se crean una sola vez en OnGameModeInit y nunca se recrean aqui.


    for(new i; i < sizeof XPTXD[]; i++){
        PlayerTextDrawShow(playerid, XPTXD[playerid][i]);
        }

        #if TEXT_SOUND_DEFAULT == true
                PlayerPlaySound(playerid, 5202, 0.0, 0.0, 0.0);
        #endif

        #if defined TEXT_TIME_DEFAULT
                // FIX CRIT-XP-005: guardar timer ID para poder matarlo en disconnect/ZerarDados.
                // ANTES: fire-and-forget. Si el jugador desconectaba antes de 5s, el callback
                // dispara sobre slot reusado.
                if(g_XPHideTimer[playerid] != -1) { KillTimer(g_XPHideTimer[playerid]); }
                g_XPHideTimer[playerid] = SetTimerEx("XP_Hide", TEXT_TIME_DEFAULT, 0, "i", playerid);
        #endif

    return 1;
}

stock checkPasswordAccount(playerid, password[]) {
        new SHA256_password[95],Account[256], returnSucess = 0;

        // Encryptar a senha
        SHA256_PassHash(password, passwordSalt, SHA256_password, sizeof (SHA256_password));
        format(Account, sizeof(Account), PASTA_CONTAS, Name(playerid));
        if(DOF2_FileExists(Account)){
                if (!strcmp(SHA256_password, DOF2_GetString(Account, "pSenha"))) {
                returnSucess = 1;
                }
        }
        return returnSucess;
}

stock IsABike(vehicleid)
{
    switch(GetVehicleModel(vehicleid)) {
        case 448, 461..463, 468, 521..523, 581, 586, 481, 509, 510:{ return 1; }
    }
    return 0;
}

stock IsABoat(vehicleid)
{
    switch(GetVehicleModel(vehicleid)) {
        case 472, 473, 493, 595, 484, 430, 453, 452, 446, 454:{ return 1; }
    }
    return 0;
}

stock IsValidInput(const ipstr[])
{
    for(new i = 0; ipstr[i] != EOS; ++i)
    {
        switch(ipstr[i])
        {
            case '0'..'9', 'A'..'Z', 'a'..'z', '_', '[', '@', ']', '.':
                continue;
            default:
                return 0;
        }
    }
    return 1;
}

stock GetPlayerIdfixo(playerid) return PlayerInfo[playerid][IDF];

// FIX AUDIT CEL MEJORA-6: helper GetPlayerByIdf(idf) - lookup O(1) inverso.
// Dado un IDF (numero de cuenta), retorna el playerid (0..499) o INVALID_PLAYER_ID.
// Reemplaza el foreach O(N=500) usado en DIALOG_BANCO4 para encontrar player por IDF.
// NOTA: el IDF es PlayerInfo[playerid][IDF], numero unico de cuenta. Si la cuenta
// existe pero el jugador no esta conectado, retorna INVALID_PLAYER_ID.
stock GetPlayerByIdf(idf)
{
        if(idf <= 0) return INVALID_PLAYER_ID;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == idf)
                        return i;
        }
        return INVALID_PLAYER_ID;
}

stock GetIdfixo()
{
        static controlFile[] = "IDs/Control.ini";

        if(!DOF2_FileExists(controlFile))
        {
                DOF2_CreateFile(controlFile);
                DOF2_SetInt(controlFile, "Last", 1000);
        }

        new currentTag = DOF2_GetInt(controlFile, "Last") + 1;
        DOF2_SetInt(controlFile, "Last", currentTag);

        return currentTag;
}

stock Timers(playerid)
{
        TimerFomebar[playerid] = SetTimerEx("FomeBar", minutos(8), true, "d", playerid);
        TimerSedebar[playerid] = SetTimerEx("SedeBar", minutos(8), true, "d", playerid);
        TimerColete[playerid] = SetTimerEx("Colete", 500, true, "d", playerid);
        TimerPayDay[playerid] = SetTimerEx("PayDay", minutos(30), false, "d", playerid);
        if(PlayerInfo[playerid][Org] > 0 && PlayerInfo[playerid][Cargo] > 0)
                TimerPagoOrg[playerid] = SetTimerEx("PagoOrg", 7200000, false, "i", playerid);
        TimerAttVeh[playerid] = SetTimerEx("AttVeh", 5000, true, "d", playerid);
        TimerRadar[playerid] = SetTimerEx("CheckRadares", 500, true, "d", playerid);
        TimerHacker[playerid] = SetTimerEx("TimerHack", 1000, false, "d", playerid);
        // MEJORA HAMBRE #1: timer de Sueno (cada 15 min decrementa SuenoPlayer).
        // Si SuenoPlayer llega a 0, el jugador se desmaya (NO se congela, solo
        // animacion KO_skid_front + SetPlayerDrunkLevel para efecto visual).
        // Si llega a <=5, aviso de cansancio.
        TimerSueno[playerid] = SetTimerEx("SuenoTimer", minutos(15), true, "d", playerid);
}

stock HeadshotCheck(playerid, &Float:x, &Float:y, &Float:z)
{
        new Float:fx,Float:fy,Float:fz;
        GetPlayerCameraFrontVector(playerid, fx, fy, fz);

        new Float:cx,Float:cy,Float:cz;
        GetPlayerCameraPos(playerid, cx, cy, cz);

        for(new Float:i = 0.0; i < 50; i = i + 0.5)
        {
                x = fx * i + cx;
                y = fy * i + cy;
                z = fz * i + cz;

                #if defined SHOWPATH
                CreatePickup(1239, 4, x, y, z, -1);
                #endif

                foreach(new player : Player)
                {
                        if(player == playerid) continue;
                        if(GetPlayerSpecialAction(player) == SPECIAL_ACTION_DUCK) //CROUCHING
                        {
                                if(IsPlayerInRangeOfPoint(player, 0.3, x, y, z))
                                {
                                        GameTextForPlayer(playerid, "~r~HEADSHOT!", 2000, 6);
                                        GameTextForPlayer(player, "~r~HEADSHOT!", 2000, 6);

                                        SetPlayerHealth(player, 0.0);
                                        CallRemoteFunction("OnPlayerDeath", "ddd", player, playerid, 34);
                                }
                        }
                        else //NOT CROUCHING
                        {
                                if(IsPlayerInRangeOfPoint(player, 0.3, x, y, z - 0.7))
                                {
                                        GameTextForPlayer(playerid, "~r~HEADSHOT!", 2000, 6);
                                        GameTextForPlayer(player, "~r~HEADSHOT!", 2000, 6);

                                        SetPlayerHealth(player, 0.0);
                                        CallRemoteFunction("OnPlayerDeath", "ddd", player, playerid, 34);
                                }
                        }
                }
                if(i == 50)break;
        }
        return 1;
}

