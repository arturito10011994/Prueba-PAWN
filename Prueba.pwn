        PlayerTextDrawUseBox(playerid, text, 1);
        PlayerTextDrawBoxColor(playerid, text, 0xFF5b6ed9);
        PlayerTextDrawLetterSize(playerid, text, 680.0, 500.0);
        PlayerTextDrawTextSize(playerid, text, 680.0, 500.0);

