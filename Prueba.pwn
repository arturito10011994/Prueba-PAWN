// =====================================================================
// FUEL-ARCHITECTURE: Sistema de combustible RP elite.
//
// Fuente unica de verdad: g_VehFuel[nativeID] contiene TODA la info de
// combustible del vehiculo nativo. Lookup O(1) sin GetVehicleID() scan.
//
//   vf_actual       -> combustible actual en litros
//   vf_capacidad    -> tanque maximo en litros (segun categoria de modelo)
//   vf_tipoComb     -> 0=gasolina, 1=diesel (afecta precio)
//   vf_persistentID -> 0=dinamico, >0=ID concesionario (1-500) para guardar
//   vf_orgSlot      -> 0=none, >0=slot org materializado (para guardar org)
//   vf_orgIdx       -> indice de banda (0-5) si vf_orgSlot>0
//   vf_consumoBase  -> L/100km segun categoria
//   vf_lastX/Y      -> posicion anterior para calculo de distancia
//   vf_alertStage   -> 0=ok, 1=20%, 2=10%, 3=5%, 4=0% (evita spam de alertas)
//   vf_lastSaveTick -> timestamp del ultimo guardado a disco (anti-spam IO)
//
// Persistencia:
//   - Vehiculos personales (vf_persistentID > 0): se guarda en
//     Conce/Veiculos/v<ID>.ini cuando SaveVehicle() lo invoca.
//   - Vehiculos de org (vf_orgSlot > 0): se guarda en
//     InfoOrg/VehiculosOrg<orgid>.ini cuando GuardarVehOrg() lo invoca.
//   - Vehiculos dinamicos (vf_persistentID == 0 && vf_orgSlot == 0):
//     NO se persisten. Se resetean a tanque lleno al crearse.
//
// Consumo:
//   - Por distancia: (distancia_km x consumoBase / 100) x mult_velocidad
//   - Ralenti: si motor ON + velocidad 0 -> FUEL_RALENTI_LPM por minuto
//   - Motor OFF: 0 consumo
// =====================================================================
enum E_VehFuel {
    Float:vf_actual,
    Float:vf_capacidad,
    vf_tipoComb,
    vf_persistentID,
    vf_orgSlot,
    vf_orgIdx,
    Float:vf_consumoBase,
    Float:vf_lastX,
    Float:vf_lastY,
    Float:vf_lastZ,    // Mejora: distancia 3D (colinas/tuneles)
    vf_alertStage,
    vf_lastSaveTick,
    bool:vf_initialized
}
new g_VehFuel[MAX_VEHICLES][E_VehFuel];

// Combustible persistente para vehiculos personales (indexado por ID concesionario 1-500)
new Float:VehicleFuelPersist[MAX_DVEHICLES];

// Combustible persistente para vehiculos de org (indexado por idx banda 0-5, slot 0-9)
new Float:g_VehOrgFuelPersist[6][MAX_VEH_ORG];

// Categorias de tanque (lookup por modelo de vehiculo)
// Retorna: 0=motopeq, 1=motogrande, 2=economico, 3=sedan, 4=suv, 5=deportivo, 6=utilitario, 7=camion
stock GetVehicleFuelCategory(modelid)
{
    switch(modelid)
    {
        // Moto pequena (20L, 3.5 L/100km)
        case 462, 448, 581, 509, 481, 510: return 0;
        // Moto grande (25L, 4.0 L/100km)
        case 522, 461, 463, 586, 468: return 1;
        // Economico (40L, 6.5 L/100km)
        case 426, 549, 542, 526, 439, 466, 467: return 2;
        // Sedan (55L, 8.0 L/100km)
        case 560, 550, 566, 410, 436, 421, 546, 540, 529: return 3;
        // SUV/Pickup (70L, 10.0 L/100km)
        case 489, 505, 479, 442, 554, 600, 543, 422, 551, 400, 424: return 4;
        // Deportivo (60L, 12.0 L/100km)
        case 411, 541, 451, 562, 558, 602, 603, 475, 565, 477, 587, 589, 496, 491, 506, 503, 502: return 5;
        // Utilitario/carga (120L, 18.0 L/100km)
        case 413, 440, 456, 499, 609, 524, 578, 455, 414, 478, 556: return 6;
        // Camion/Bus (250L, 35.0 L/100km)
        case 403, 406, 514, 515, 435, 450, 591, 437, 431, 408: return 7;
    }
    return 3; // sedan generico (default)
}

// Retorna la capacidad del tanque (litros) segun categoria
stock Float:GetFuelCapacityByCategory(cat)
{
    switch(cat)
    {
        case 0: return 20.0;  // moto pequena
        case 1: return 25.0;  // moto grande
        case 2: return 40.0;  // economico
        case 3: return 55.0;  // sedan
        case 4: return 70.0;  // SUV/pickup
        case 5: return 60.0;  // deportivo
        case 6: return 120.0; // utilitario
        case 7: return 250.0; // camion/bus
    }
    return 55.0; // default sedan
}

// Retorna el consumo base (L/100km) segun categoria
stock Float:GetFuelConsumoByCategory(cat)
{
    switch(cat)
    {
        case 0: return 3.5;   // moto pequena
        case 1: return 4.0;   // moto grande
        case 2: return 6.5;   // economico
        case 3: return 8.0;   // sedan
        case 4: return 10.0;  // SUV/pickup
        case 5: return 12.0;  // deportivo
        case 6: return 18.0;  // utilitario
        case 7: return 35.0;  // camion/bus
    }
    return 8.0; // default sedan
}

// MEJORA 6 FUEL-MEJORAS-4-6: overrides por modelo popular.
// Permite afinar el consumo (L/100km) para modelos especificos que deben
// diferir del default de su categoria (mas realista). Si el modelo no esta
// listado, cae al default por categoria via GetFuelConsumoByCategory(cat).
// Model IDs verificados como nativas via GetVehicleModel (usado en L2082,
// L5240, L6498, L9158, L9577).
stock Float:GetFuelConsumoByModel(modelid, cat)
{
    switch(modelid)
    {
        // Sultan (411): deportivo pero eficiente para su clase
        case 411: return 10.0;
        // Infernus (490): deportivo sediento
        case 490: return 14.0;
        // Turismo (451): muy deportivo
        case 451: return 13.0;
        // Camion (403): pesado
        case 403: return 40.0;
        // Bus (437): consumo alto
        case 437: return 38.0;
    }
    return GetFuelConsumoByCategory(cat); // default por categoria
}

// Retorna el tipo de combustible: 0=gasolina, 1=diesel
// Camiones y buses usan diesel; el resto gasolina.
stock GetFuelTypeByCategory(cat)
{
    if(cat == 6 || cat == 7) return 1; // diesel
    return 0; // gasolina
}

// Inicializa g_VehFuel[nativeID] para un vehiculo recien creado.
// Se llama desde UpdateVehicle, SpawnVehOrg, y creaciones de VeiculoCivil.
// Si persistentID > 0, carga el combustible desde VehicleFuelPersist.
// Si orgSlot > 0, carga desde g_VehOrgFuelPersist.
// Si ambos son 0, es dinamico -> tanque lleno.
stock Fuel_InitVehicle(nativeID, modelid, persistentID = 0, orgSlot = 0, orgIdx = -1)
{
    if(nativeID < 1 || nativeID >= MAX_VEHICLES) return 0;

    new cat = GetVehicleFuelCategory(modelid);
    g_VehFuel[nativeID][vf_capacidad] = GetFuelCapacityByCategory(cat);
    g_VehFuel[nativeID][vf_consumoBase] = GetFuelConsumoByModel(modelid, cat); // MEJORA 6 FUEL-MEJORAS-4-6: overrides por modelo popular
    g_VehFuel[nativeID][vf_tipoComb] = GetFuelTypeByCategory(cat);
    g_VehFuel[nativeID][vf_persistentID] = persistentID;
    g_VehFuel[nativeID][vf_orgSlot] = orgSlot;
    g_VehFuel[nativeID][vf_orgIdx] = orgIdx;
    g_VehFuel[nativeID][vf_alertStage] = 0;
    g_VehFuel[nativeID][vf_lastSaveTick] = 0;
    g_VehFuel[nativeID][vf_initialized] = true;

    // Cargar combustible desde persistencia o setear tanque lleno
    if(persistentID > 0 && persistentID < MAX_DVEHICLES)
    {
        // Vehiculo personal: cargar desde persistencia
        new Float:saved = VehicleFuelPersist[persistentID];
        if(saved <= 0.0 || saved > g_VehFuel[nativeID][vf_capacidad])
            g_VehFuel[nativeID][vf_actual] = g_VehFuel[nativeID][vf_capacidad]; // tanque lleno si invalido
        else
            g_VehFuel[nativeID][vf_actual] = saved;
    }
    else if(orgSlot > 0 && orgIdx >= 0 && orgIdx < 6)
    {
        // Vehiculo de org: cargar desde persistencia
        new Float:saved = g_VehOrgFuelPersist[orgIdx][orgSlot];
        if(saved <= 0.0 || saved > g_VehFuel[nativeID][vf_capacidad])
            g_VehFuel[nativeID][vf_actual] = g_VehFuel[nativeID][vf_capacidad];
        else
            g_VehFuel[nativeID][vf_actual] = saved;
    }
    else
    {
        // Dinamico: tanque lleno
        g_VehFuel[nativeID][vf_actual] = g_VehFuel[nativeID][vf_capacidad];
    }

    // Inicializar posicion para calculo de distancia (3D)
    new Float:vx, Float:vy, Float:vz;
    GetVehiclePos(nativeID, vx, vy, vz);
    g_VehFuel[nativeID][vf_lastX] = vx;
    g_VehFuel[nativeID][vf_lastY] = vy;
    g_VehFuel[nativeID][vf_lastZ] = vz;

    // Mantener compatibilidad con Fuel[] legacy
    Fuel[nativeID] = g_VehFuel[nativeID][vf_actual];
    return 1;
}

// Guarda el combustible de un vehiculo personal a su slot persistente.
// Se llama desde SaveVehicle() y disconnect/shutdown.
stock Fuel_SavePersistent(nativeID)
{
    if(nativeID < 1 || nativeID >= MAX_VEHICLES) return 0;
    if(!g_VehFuel[nativeID][vf_initialized]) return 0;
    new pid = g_VehFuel[nativeID][vf_persistentID];
    if(pid > 0 && pid < MAX_DVEHICLES)
    {
        VehicleFuelPersist[pid] = g_VehFuel[nativeID][vf_actual];
        return 1;
    }
    // Si es vehiculo de org, guardar en su array
    if(g_VehFuel[nativeID][vf_orgSlot] > 0)
    {
        new oidx = g_VehFuel[nativeID][vf_orgIdx];
        new oslot = g_VehFuel[nativeID][vf_orgSlot];
        if(oidx >= 0 && oidx < 6 && oslot >= 0 && oslot < MAX_VEH_ORG)
        {
            g_VehOrgFuelPersist[oidx][oslot] = g_VehFuel[nativeID][vf_actual];
            return 1;
        }
    }
    return 0; // dinamico, no se persiste
}

// Marca un vehiculo como destruido/desinicializado (al DestroyVehicle).
// Guarda su combustible si es persistente.
stock Fuel_DestroyVehicle(nativeID)
{
    if(nativeID < 1 || nativeID >= MAX_VEHICLES) return 0;
    if(!g_VehFuel[nativeID][vf_initialized]) return 0;
    Fuel_SavePersistent(nativeID);
    g_VehFuel[nativeID][vf_initialized] = false;
    g_VehFuel[nativeID][vf_persistentID] = 0;
    g_VehFuel[nativeID][vf_orgSlot] = 0;
    g_VehFuel[nativeID][vf_actual] = 0.0;
    Fuel[nativeID] = 0.0;
    return 1;
}

// Obtiene el porcentaje de combustible (0-100) para display y alertas.
stock Float:Fuel_GetPercent(nativeID)
{
    if(nativeID < 1 || nativeID >= MAX_VEHICLES) return 0.0;
    if(!g_VehFuel[nativeID][vf_initialized]) return 0.0;
    if(g_VehFuel[nativeID][vf_capacidad] <= 0.0) return 0.0;
    new Float:pct = (g_VehFuel[nativeID][vf_actual] / g_VehFuel[nativeID][vf_capacidad]) * 100.0;
    if(pct < 0.0) pct = 0.0;
    if(pct > 100.0) pct = 100.0;
    return pct;
}

