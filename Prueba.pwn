// - Eliminado CMD:curarid (no tenia restriccion geografica, cualquier
//   paramedico podia curar a cualquier jugador desde cualquier punto
//   del mapa). Toda curacion presencial ahora pasa por /curar
//   (en hospital, 3m -> 7m en Bug #5).

// ---------------------------------------------------------------------
// 2026-07-09 - Bug #1
// ---------------------------------------------------------------------
// - /revivirstaff [IDF] reescrito:
//   * Permiso subido de pAdmin >= 1 a pAdmin >= 2.
//   * Chaleco solo a partir de pAdmin >= 3.
//   * Validacion de target herido (no revive jugadores sanos).
//   * Log obligatorio en Logs/AdminAcciones.ini.
// - Eliminado CMD:reanimar (era comando admin con dialog vacio).
// - Eliminado case DIALOG_REANIMAR (cuerpo vacio en OnDialogResponse).
// - Eliminado CMD:reviver (no descongelaba al jugador revivido).
// - Creado nuevo CMD:reanimar [id] para paramedicos a pie (Org 10
//   + uniforme, target herido, <=3m, HP 100, no chaleco).
// - Creado sistema Defibrilador Portatil Civil (item 11738):
//   * Cualquier jugador con el item puede reanimar a un herido
//     cercano (<=1m).
//   * HP restaurado: 50 (no 100 como paramedico).
//   * Cooldown: 60s.
//   * Consume 1 unidad del item por uso.
//   * Avisa a paramedicos online (transparencia RP).
//   * Handler: case DIALOG_DEFIBRILADOR en OnDialogResponse.
//   * Dialog ID DIALOG_DEFIBRILADOR agregado al enum.

// =====================================================================
// FIN DEL CHANGELOG
// =====================================================================

// =====================================================================
// NUEVOS COMANDOS ADMIN (P2-Admin)
// =====================================================================

// ---------------------------------------------------------------------
// /curafull: cura TOTAL del admin a si mismo.
// Resetea: HP 100, Chaleco 100, Fractura, Quemadura, Enfermedad,
//          Hambre/Sed, Sangrado, Estado herido, VW/Interior de muerte.
// Nivel: 7 (Desarrollador / DueÃ¯Â¿Â½o). Solo el dueÃ¯Â¿Â½o puede usarlo en si mismo.
// ---------------------------------------------------------------------
CMD:curafull(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        // HP y chaleco
        SetPlayerHealth(playerid, 100.0);
        // FIX AUDIT AC-H8: setear g_ChalecoPermitido=true antes de SetPlayerArmour.
        // Antes: SetPlayerArmour(100) sin flag causaba strike AC (armour > 0 sin permiso).
        // Si el admin lvl 7 estaba jugando (pJogando=true), el AC lo strikeaba.
        SetChalecoState(playerid, CHALECO_FULL, false);
        // Fractura
        Fractura[playerid] = 0;
        FracturaTick[playerid] = 0;
        // Quemadura
        Quemadura[playerid] = 0;
        QuemaduraTick[playerid] = 0;
        // Enfermedad
        Enfermedad[playerid] = 0;
        EnfermedadTick[playerid] = 0;
        EnfermedadTiempo[playerid] = 0;
        // Hambre y sed
        FomePlayer[playerid] = 100;
        SedePlayer[playerid] = 100;
        // Estado de herido/muerte
        MinutosMorte[playerid] = 0;
        SegundosMorte[playerid] = 0;
        XMorte[playerid] = -1; YMorte[playerid] = -1; ZMorte[playerid] = -1;
        TriagePrio[playerid] = 0;
        TriageMedico[playerid] = -1;
        if(SangueObjeto[playerid] > -1)
        {
            DestroyObject(SangueObjeto[playerid]);
            SangueObjeto[playerid] = -1;
        }
        for(new t = 0; t < 7; t++)
            PlayerTextDrawHide(playerid, TelaMorteCDA[playerid][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[playerid] = false;        // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (/curafull admin).
        for(new _t = 0; _t < 5; _t++)
            TextDrawHideForPlayer(playerid, LogoBZ[_t]);
        // Congelado
        PlayerInfo[playerid][pCongelado] = false;
        TogglePlayerControllable(playerid, 1);
        // Log
        new logCf[128];
        format(logCf, sizeof(logCf), "[CURAFULL] %s (IDF %d) se curo al 100%%.", PlayerName(playerid), PlayerInfo[playerid][IDF]);
        Log("Logs/AdminAcciones.ini", logCf);
        SuccesMsg(playerid, "Te curaste al 100%%: HP, chaleco, fractura, quemadura, enfermedad, hambre, sed y estado de herido.");
        return 1;
}

// ---------------------------------------------------------------------
// /desbug: resetea TODO el estado del jugador (incluido inventario visual,
// animaciones, congelamiento, VW, interior, posicion si esta bugueado).
// Nivel: 2 (Administrador). Pensado para when un jugador queda bugueado.
// ---------------------------------------------------------------------
CMD:desbug(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /desbug [ID]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(PlayerInfo[id][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel."); // FIX AUDIT4 ADM3-04
        // FIX AUDIT LIC MEJORA-1/LIC-A3-09 (ALTO): cleanup completo de autoescuela via helper.
        // ANTES: /desbug no limpiaba estado de autoescuela. Jugador stuck en examen
        // no podia reiniciar. Ahora: llamar AutoEscola_FlushPlayer.
        AutoEscola_FlushPlayer(id);
        // Limpiar animaciones
        ClearAnimations(id);
        // Descongelar
        PlayerInfo[id][pCongelado] = false;
        TogglePlayerControllable(id, 1);
        // Reset especiales
        SetPlayerSpecialAction(id, SPECIAL_ACTION_NONE);
        // Quitar attached objects (esposas, etc.)
        for(new idx = 0; idx < 10; idx++) RemovePlayerAttachedObject(id, idx);
        // Reset VW e interior a 0
        SetPlayerVirtualWorld(id, 0);
        SetPlayerInterior(id, 0);
        // HP y chaleco
        SetPlayerHealth(id, 100.0);
        SetPlayerArmour(id, 0.0);
        // Estado herido/muerte
        MinutosMorte[id] = 0;
        SegundosMorte[id] = 0;
        XMorte[id] = -1; YMorte[id] = -1; ZMorte[id] = -1;
        TriagePrio[id] = 0;
        TriageMedico[id] = -1;
        if(SangueObjeto[id] > -1)
        {
            DestroyObject(SangueObjeto[id]);
            SangueObjeto[id] = -1;
        }
        for(new t = 0; t < 7; t++)
            PlayerTextDrawHide(id, TelaMorteCDA[id][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[id] = false;        // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (/curafulltarget admin).
        for(new _t = 0; _t < 5; _t++)
            TextDrawHideForPlayer(id, LogoBZ[_t]);
        // Fractura/quemadura/enfermedad
        Fractura[id] = 0; FracturaTick[id] = 0;
        Quemadura[id] = 0; QuemaduraTick[id] = 0;
        Enfermedad[id] = 0; EnfermedadTick[id] = 0; EnfermedadTiempo[id] = 0;
        // Trackers de caida/teleport (anti-falso-positivo de fractura)
        CaidaAltura[id] = 0.0;
        CaidaX[id] = 0.0;
        CaidaY[id] = 0.0;
        InteriorAnterior[id] = 0;
        VelocidadeVeh[id] = 0.0;
        SaliendoVehMovil[id] = 0;
        // Trackers de combate medico
        MatouPlayer[id] = -1;
        FoiSocorrido[id] = 0;
        // Hambre y sed
        FomePlayer[id] = 100;
        SedePlayer[id] = 100;
        // Quitar wanted level (si estaba buscado por bug)
        SetPlayerWantedLevelSync(id, 0); // FIX AUDIT WANTED: sync pProcurado = 0
        // Notificar
        new msg[128];
        format(msg, sizeof(msg), "El admin %s te desbugueo. Estado reseteado por completo.", PlayerName(playerid));
        SuccesMsg(id, msg);
        format(msg, sizeof(msg), "Desbugueaste a %s (estado completo reseteado).", PlayerName(id));
        SuccesMsg(playerid, msg);
        // Log
        new logDbg[180];
        format(logDbg, sizeof(logDbg), "[DESBUG] Admin %s (IDF %d) desbugueo a %s (IDF %d).", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), PlayerInfo[id][IDF]);
        Log("Logs/AdminAcciones.ini", logDbg);
        return 1;
}

// ---------------------------------------------------------------------
// /dararma [id] [arma] [municion]: dar arma EXTRA a un jugador
// (no sobreescribe como /setarma, suma a las existentes).
// Nivel: 7 (Desarrollador / DueÃ¯Â¿Â½o).
// ---------------------------------------------------------------------
CMD:dararma(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        new id, arma, municion;
        if(sscanf(params, "iii", id, arma, municion)) return ErrorMsg(playerid, "Uso: /dararma [ID] [arma 0-46] [municion]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(arma < 0 || arma > 46) return ErrorMsg(playerid, "ID de arma invalido (0-46).");
        if(municion < 1 || municion > 9999) return ErrorMsg(playerid, "Municion invalida (1-9999).");
        // FIX AUDIT AGENT1 WC-09: validar arma contra blocklist antes de dar.
        // Aunque /dararma es solo para admin nivel 7 (Desarrollador), validamos
        // igual para evitar kick auto del AC y para prevenir persistir armas
        // prohibidas en disco (SalvarArmas con el fix WC-02 no las persiste,
        // pero mejor prevenir que curar).
        if(!AC_IsWeaponAllowed(id, arma))
                return ErrorMsg(playerid, "Arma prohibida para el target. Si necesitas dar minigun al Ejercito, asegurate de que este en servicio (Patrulha=true).");
        GivePlayerWeapon(id, arma, municion);
        new msg[160];
        format(msg, sizeof(msg), "El admin %s te dio un arma (ID %d, %d balas).", PlayerName(playerid), arma, municion);
        SuccesMsg(id, msg);
        format(msg, sizeof(msg), "Diste arma %d con %d balas a %s.", arma, municion, PlayerName(id));
        SuccesMsg(playerid, msg);
        new logArma[180];
        format(logArma, sizeof(logArma), "[DARARMA] Admin %s (IDF %d) -> %s (IDF %d): arma %d, %d balas.", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), PlayerInfo[id][IDF], arma, municion);
        Log("Logs/AdminAcciones.ini", logArma);
        return 1;
}

// ---------------------------------------------------------------------
// /limpiarinventario [id]: vacia todo el inventario de un jugador.
// Nivel: 5 (Director / Fundador / Desarrollador / Dueno).
// ---------------------------------------------------------------------
CMD:limpiarinventario(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 5) return ErrorMsg(playerid, "No tienes permisos. Necesitas Director o superior.");
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /limpiarinventario [ID]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        // Vaciar 33 slots del inventario
        for(new slot = 0; slot < 33; slot++)
        {
                PlayerInventario[id][slot][Slot] = -1;
                PlayerInventario[id][slot][Unidades] = 0;
                PlayerInventario[id][slot][DropItem] = 0;
                PlayerInventario[id][slot][DropItemUni] = 0;
                PlayerInventario[id][slot][DropItemID] = -1;
        }
        SalvarInventario(id);
        new msg[160];
        format(msg, sizeof(msg), "El admin %s vacio tu inventario completamente.", PlayerName(playerid));
        ErrorMsg(id, msg);
        format(msg, sizeof(msg), "Inventario de %s vaciado (33 slots).", PlayerName(id));
        SuccesMsg(playerid, msg);
        new logInv[180];
        format(logInv, sizeof(logInv), "[LIMPIARINVENTARIO] Admin %s (IDF %d) vacio inventario de %s (IDF %d).", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), PlayerInfo[id][IDF]);
        Log("Logs/AdminAcciones.ini", logInv);
        return 1;
}

// ---------------------------------------------------------------------
// /darcoche [id] [modelo]: spawnea un vehiculo y pone al jugador como
// conductor. El vehiculo es temporal (no se guarda en concesionaria).
// Nivel: 7 (Desarrollador / Dueno).
// ---------------------------------------------------------------------
CMD:darcoche(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        new id, modelo;
        if(sscanf(params, "ii", id, modelo)) return ErrorMsg(playerid, "Uso: /darcoche [ID] [modelo 400-611]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(modelo < 400 || modelo > 611) return ErrorMsg(playerid, "Modelo invalido (400-611).");
        new Float:X, Float:Y, Float:Z, Float:A;
        GetPlayerPos(id, X, Y, Z);
        GetPlayerFacingAngle(id, A);
        new veh = CreateVehicle(modelo, X, Y, Z, A, -1, -1, 600); // 600s de vida util
        PutPlayerInVehicle(id, veh, 0);
        new msg[160];
        format(msg, sizeof(msg), "El admin %s te dio un vehiculo (modelo %d).", PlayerName(playerid), modelo);
        SuccesMsg(id, msg);
        format(msg, sizeof(msg), "Distele vehiculo %d a %s.", modelo, PlayerName(id));
        SuccesMsg(playerid, msg);
        new logCoche[180];
        format(logCoche, sizeof(logCoche), "[DAROCHE] Admin %s (IDF %d) -> %s (IDF %d): vehiculo modelo %d.", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), PlayerInfo[id][IDF], modelo);
        Log("Logs/AdminAcciones.ini", logCoche);
        return 1;
}

// ---------------------------------------------------------------------
// /darvehiculo [ID] [modelo] [precio] - crea vehiculo PERMANENTE
// Asigna el vehiculo al jugador con precio personalizable.
// Precio 0 = regalo. Precio > 0 = vehiculo con valor de venta.
// Nivel: 7 (Desarrollador/Dueno)
// ---------------------------------------------------------------------
CMD:darvehiculo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        new id, modelo, precio;
        if(sscanf(params, "iii", id, modelo, precio)) return ErrorMsg(playerid, "Uso: /darvehiculo [ID] [modelo 400-611] [precio 0=regalo]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(modelo < 400 || modelo > 611) return ErrorMsg(playerid, "Modelo invalido (400-611).");
        if(precio < 0) return ErrorMsg(playerid, "Precio invalido (0 o mas).");

        // Buscar slot libre en el sistema de vehiculos
        new slot = GetFreeVehicleID();
        if(slot == 0) return ErrorMsg(playerid, "No hay slots de vehiculos disponibles.");

        // Obtener posicion del jugador objetivo
        new Float:X, Float:Y, Float:Z, Float:A;
        GetPlayerPos(id, X, Y, Z);
        GetPlayerFacingAngle(id, A);

        // Configurar el vehiculo permanente
        VehicleCreated[slot] = VEHICLE_PLAYER;
        VehicleModel[slot] = modelo;
        VehiclePos[slot][0] = X;
        VehiclePos[slot][1] = Y;
        VehiclePos[slot][2] = Z;
        VehiclePos[slot][3] = A;
        VehicleColor[slot][0] = -1;
        VehicleColor[slot][1] = -1;
        VehicleInterior[slot] = GetPlayerInterior(id);
        VehicleWorld[slot] = GetPlayerVirtualWorld(id);
        GetPlayerName(id, VehicleOwner[slot], MAX_PLAYER_NAME);
        VehicleValue[slot] = precio;
        VehicleLock[slot] = 0;
        VehicleAlarm[slot] = 0;
        VehiclePaintjob[slot] = 0;
        // FIX AUDIT AGENT5 XS-11: limpiar VehicleTrunk antes de UpdateVehicle/SaveVehicle.
        // Sin esto, si el slot era reutilizado de un vehiculo vendido previamente que
        // tenia armas en el maletero, el nuevo dueno heredaba esas armas (dupe).
        for(new d=0; d < sizeof(VehicleTrunk[]); d++)
        {
                VehicleTrunk[slot][d][0] = 0;
                VehicleTrunk[slot][d][1] = 0;
        }

        // Crear el vehiculo fisico
        UpdateVehicle(slot, 0);
        SaveVehicle(slot);

        // Poner al jugador como conductor
        PutPlayerInVehicle(id, VehicleID[slot], 0);

        // Mensajes
        new msg[256];
        if(precio == 0)
                format(msg, sizeof(msg), "El admin %s te regalo un vehiculo (modelo %d).", PlayerName(playerid), modelo);
        else
                format(msg, sizeof(msg), "El admin %s te asigno un vehiculo (modelo %d, valor $%d).", PlayerName(playerid), modelo, precio);
        SuccesMsg(id, msg);

        if(precio == 0)
                format(msg, sizeof(msg), "Regalaste vehiculo %d a %s (gratis).", modelo, PlayerName(id));
        else
                format(msg, sizeof(msg), "Asignaste vehiculo %d a %s por $%d.", modelo, PlayerName(id), precio);
        SuccesMsg(playerid, msg);

        // Log
        new logVeh[256];
        format(logVeh, sizeof(logVeh), "[DARVEHICULO] Admin %s (IDF %d) -> %s (IDF %d): modelo %d, precio $%d, slot %d.", PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerName(id), PlayerInfo[id][IDF], modelo, precio, slot);
        Log("Logs/AdminAcciones.ini", logVeh);
        return 1;
}

// ---------------------------------------------------------------------
// /eliminarvehiculo [slot] - elimina un vehiculo PERMANENTE del sistema.
// El admin debe estar dentro del vehiculo o especificar el slot.
// Nivel: 7 (Desarrollador/Dueno)
// ---------------------------------------------------------------------
CMD:eliminarvehiculo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");

        new slot;
        // Si no pasa parametros, usar el vehiculo en el que esta
        if(sscanf(params, "i", slot))
        {
                if(!IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "Uso: /eliminarvehiculo [slot] o subite al vehiculo y usa /eliminarvehiculo sin parametros.");
                new sampVeh = GetPlayerVehicleID(playerid);
                slot = GetVehicleID(sampVeh);
                if(slot == 0) return ErrorMsg(playerid, "Este vehiculo no es permanente (no esta en el sistema).");
        }

        if(slot < 1 || slot >= MAX_DVEHICLES) return ErrorMsg(playerid, "Slot invalido.");
        if(!VehicleCreated[slot]) return ErrorMsg(playerid, "Ese slot no tiene ningun vehiculo.");

        // Guardar info para el mensaje
        new ownerName[MAX_PLAYER_NAME];
        strcpy(ownerName, VehicleOwner[slot]);
        new model = VehicleModel[slot];

        // Destruir el vehiculo fisico
        if(IsValidVehicle(VehicleID[slot]))
                DestroyVehicle(VehicleID[slot]);

        // Limpiar los datos del slot
        VehicleCreated[slot] = 0;
        VehicleModel[slot] = 0;
        VehicleOwner[slot][0] = EOS;
        VehicleValue[slot] = 0;
        VehicleLock[slot] = 0;
        VehicleAlarm[slot] = 0;

        // Eliminar el archivo
        new filename[64];
        format(filename, sizeof(filename), VEHICLE_FILE_PATH "v%d.ini", slot);
        if(fexist(filename)) fremove(filename);

        // Mensajes
        new msg[256];
        format(msg, sizeof(msg), "Vehiculo eliminado: slot %d, modelo %d, dueno %s.", slot, model, ownerName);
        SuccesMsg(playerid, msg);

        // Log
        new logVeh[256];
        format(logVeh, sizeof(logVeh), "[ELIMINARVEHICULO] Admin %s (IDF %d) elimino vehiculo slot %d (modelo %d, dueno %s).", PlayerName(playerid), PlayerInfo[playerid][IDF], slot, model, ownerName);
        Log("Logs/AdminAcciones.ini", logVeh);
        return 1;
}

// ---------------------------------------------------------------------
// /ircasa [id]: teletransporta al admin a la casa con el ID especificado.
// Nivel: 6 (Fundador / Desarrollador / Dueno) - mismo nivel que /crearcasa.
// ---------------------------------------------------------------------
CMD:ircasa(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos. Necesitas Fundador o superior.");
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /ircasa [ID de casa]");
        if(id < 0 || id >= MAX_CASAS) return ErrorMsg(playerid, "ID de casa invalido.");
        if(CasaInfo[id][CasaX] == 0.0 && CasaInfo[id][CasaY] == 0.0) return ErrorMsg(playerid, "Esa casa no existe.");
        SetPlayerPos(playerid, CasaInfo[id][CasaX], CasaInfo[id][CasaY], CasaInfo[id][CasaZ]);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        new msg[128];
        format(msg, sizeof(msg), "Teletransportado a casa ID %d.", id);
        SuccesMsg(playerid, msg);
        return 1;
}

// ---------------------------------------------------------------------
// /iraorg [id]: teletransporta al admin al HQ de la organizacion ID.
// Coords oficiales: 1=PN, 2=Transito, 3=FBI, 4=SWAT, 5=BandaRoja, 6=Sobras,
// 7=Amarilla, 8=Verde, 9=Bennys, 10=Paramedicos, 11=Reporteros, 12=Delincuentes,
// 13=MotoClub, 14=Ejercito.
// Nivel: 5 (Director / Fundador / Desarrollador / Dueno).
// ---------------------------------------------------------------------
CMD:iraorg(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 5) return ErrorMsg(playerid, "No tienes permisos. Necesitas Director o superior.");
        new orgid;
        if(sscanf(params, "d", orgid)) return ErrorMsg(playerid, "Uso: /iraorg [ID de org 1-14]");
        new Float:ox, Float:oy, Float:oz;
        // P0-HQ-CENTRAL: usa g_HQCoords en vez de coordenadas hardcodeadas.
        switch(orgid)
        {
                case 1:  { ox=g_HQCoords[1][0]; oy=g_HQCoords[1][1]; oz=g_HQCoords[1][2]; }
                case 2:  { ox=g_HQCoords[2][0]; oy=g_HQCoords[2][1]; oz=g_HQCoords[2][2]; }
                case 3:  { ox=g_HQCoords[3][0]; oy=g_HQCoords[3][1]; oz=g_HQCoords[3][2]; }
                case 4:  { ox=g_HQCoords[4][0]; oy=g_HQCoords[4][1]; oz=g_HQCoords[4][2]; }
                case 5:  { ox=g_HQCoords[5][0]; oy=g_HQCoords[5][1]; oz=g_HQCoords[5][2]; }
                case 6:  { ox=g_HQCoords[6][0]; oy=g_HQCoords[6][1]; oz=g_HQCoords[6][2]; }
                case 7:  { ox=g_HQCoords[7][0]; oy=g_HQCoords[7][1]; oz=g_HQCoords[7][2]; }
                case 8:  { ox=g_HQCoords[8][0]; oy=g_HQCoords[8][1]; oz=g_HQCoords[8][2]; }
                case 9:  { ox=g_HQCoords[9][0]; oy=g_HQCoords[9][1]; oz=g_HQCoords[9][2]; }
                case 10: { ox=g_HQCoords[10][0]; oy=g_HQCoords[10][1]; oz=g_HQCoords[10][2]; }
                case 11: { ox=g_HQCoords[11][0]; oy=g_HQCoords[11][1]; oz=g_HQCoords[11][2]; }
                case 12: { ox=g_HQCoords[12][0]; oy=g_HQCoords[12][1]; oz=g_HQCoords[12][2]; }
                case 13: { ox=g_HQCoords[13][0]; oy=g_HQCoords[13][1]; oz=g_HQCoords[13][2]; }
                case 14: { ox=g_HQCoords[14][0]; oy=g_HQCoords[14][1]; oz=g_HQCoords[14][2]; }
                default: return ErrorMsg(playerid, "ID de org invalido (1-14).");
        }
        SetPlayerPos(playerid, ox, oy, oz);
        // Paramedicos esta en interior 5
        if(orgid == 10) SetPlayerInterior(playerid, 5);
        else SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        // P0-HQ-CENTRAL: usar g_HQNombres en vez de switch hardcodeado.
        new orgName[35];
        strcpy(orgName, g_HQNombres[orgid], sizeof(orgName));
        new msg[80];
        format(msg, sizeof(msg), "Teletransportado a HQ: %s.", orgName);
        SuccesMsg(playerid, msg);
        return 1;
}

// ---------------------------------------------------------------------
// /reiniciar [segundos]: reinicia el gamemode con countdown configurable.
// - Si no se pasa argumento, default = 60 segundos.
// - Muestra en pantalla grande (GameText) cada 15 segundos: "Reinicio en X:YY"
// - Cuando quedan <= 10 segundos, muestra countdown regresivo segundo a segundo.
// - A los 0 segundos ejecuta GameModeExit() para reiniciar el server.
// - Nivel: 7 (Desarrollador / Dueno).
//
// Ejemplos:
//   /reiniciar           -> 60s por defecto
//   /reiniciar 120       -> 2 minutos
//   /reiniciar 30        -> 30 segundos (solo muestra countdown final 10-0)
// ---------------------------------------------------------------------

// Variables globales del sistema de reinicio (declaradas antes del comando)
new g_ReiniciarTimer = -1;
new g_ReiniciarSegundos = 0;

CMD:reiniciar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        new segundos = 60;
        if(strlen(params) > 0)
        {
                if(sscanf(params, "i", segundos)) return ErrorMsg(playerid, "Uso: /reiniciar [segundos] (default 60, min 10, max 3600)");
                if(segundos < 10) return ErrorMsg(playerid, "Minimo 10 segundos para evitar reinicios accidentales.");
                if(segundos > 3600) return ErrorMsg(playerid, "Maximo 3600 segundos (1 hora).");
        }
        // Cancelar reinicio anterior si hay uno en curso
        if(g_ReiniciarTimer != -1)
        {
                KillTimer(g_ReiniciarTimer);
                g_ReiniciarTimer = -1;
                SendClientMessageToAll(0xFF8800FF, "| REINICIO | Reinicio anterior cancelado. Nuevo reinicio programado.");
        }
        g_ReiniciarSegundos = segundos;
        // Anuncio inicial por chat
        new msgIni[180];
        format(msgIni, sizeof(msgIni), "| REINICIO | El servidor se reiniciara en %d segundos por orden de %s.", segundos, Name(playerid));
        SendClientMessageToAll(0xFF0000FF, msgIni);
        // GameText inicial grande (5 segundos visible)
        new gtIni[64];
        format(gtIni, sizeof(gtIni), "~r~Reinicio en~n~~w~%d s", segundos);
        GameTextForAll(gtIni, 5000, 5);
        // Iniciar timer de 1 segundo
        g_ReiniciarTimer = SetTimer("ReiniciarCountdown", 1000, true);
        // Log
        new logRst[180];
        format(logRst, sizeof(logRst), "[REINICIAR] Admin %s (IDF %d) inicio reinicio en %d segundos.", Name(playerid), PlayerInfo[playerid][IDF], segundos);
        Log("Logs/AdminAcciones.ini", logRst);
        new msgSucc[128];
        format(msgSucc, sizeof(msgSucc), "Reinicio programado en %d segundos. Countdown activo.", segundos);
        SuccesMsg(playerid, msgSucc);
        return 1;
}

// Timer callback: ejecuta cada 1 segundo, decrementa y muestra mensajes segun las reglas
forward ReiniciarCountdown();
public ReiniciarCountdown()
{
        g_ReiniciarSegundos--;
        if(g_ReiniciarSegundos <= 0)
        {
                // Reiniciar ahora
                GameTextForAll("~r~Reiniciando servidor...", 3000, 5);
                SendClientMessageToAll(0xFF0000FF, "| REINICIO | Reiniciando servidor ahora...");
                KillTimer(g_ReiniciarTimer);
                g_ReiniciarTimer = -1;
                SetTimer("ExecGMX", 3000, false);
                return 1;
        }
        new secs = g_ReiniciarSegundos;
        new mins = secs / 60;
        new remSecs = secs % 60;
        new gt[48];
        // Reglas de visualizacion:
        // - Siempre que queden 10s o menos: countdown segundo a segundo (3s visible)
        // - Cada 15 segundos (60, 45, 30, 15): anuncio grande de 5s
        if(secs <= 10)
        {
                format(gt, sizeof(gt), "~r~Reinicio en~n~~w~%d", secs);
                GameTextForAll(gt, 3000, 5);
        }
        else if(secs % 15 == 0)
        {
                format(gt, sizeof(gt), "~r~Reinicio en~n~~w~%d:%02d", mins, remSecs);
                GameTextForAll(gt, 5000, 5);
                new msgChat[100];
                format(msgChat, sizeof(msgChat), "| REINICIO | Reinicio en %d:%02d", mins, remSecs);
                SendClientMessageToAll(0xFFAA00FF, msgChat);
        }
        return 1;
}

// ---------------------------------------------------------------------
// /cancelarreiniciar: cancela un reinicio en curso.
// Nivel: 7 (Desarrollador / Dueno).
// ---------------------------------------------------------------------
CMD:cancelarreiniciar(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "Comando exclusivo del Desarrollador/Dueno.");
        if(g_ReiniciarTimer == -1) return ErrorMsg(playerid, "No hay ningun reinicio en curso.");
        KillTimer(g_ReiniciarTimer);
        g_ReiniciarTimer = -1;
        g_ReiniciarSegundos = 0;
        GameTextForAll("~g~Reinicio cancelado", 3000, 5);
        SendClientMessageToAll(0x00FF00FF, "| REINICIO | Reinicio cancelado por el administrador.");
        new logCanc[160];
        format(logCanc, sizeof(logCanc), "[REINICIAR] Admin %s (IDF %d) cancelo el reinicio en curso.", Name(playerid), PlayerInfo[playerid][IDF]);
        Log("Logs/AdminAcciones.ini", logCanc);
        SuccesMsg(playerid, "Reinicio cancelado.");
        return 1;
}
forward ExecGMX();
public ExecGMX()
{
        SendClientMessageToAll(0xFF0000FF, "| REINICIO | Reiniciando servidor ahora...");
        GameModeExit();
        return 1;
}

// =====================================================================
// FIN NUEVOS COMANDOS ADMIN
// =====================================================================

// =====================================================================
// P0-BEN-CAPO: /capo - abre el capo del vehiculo mas cercano (max 5m)
// y anima al mecanico durante 5 segundos. Al terminar, cierra el capo
// automaticamente y pone de pie al mecanico (ClearAnimations).
//
// Requisitos:
//   - Ser mecanico de Bennys (Org == 9)
//   - Tener el uniforme puesto (mecanico[playerid] == true)
//   - Estar a pie (no en vehiculo)
//   - No tener ya un /capo o /reparar en curso
// =====================================================================
CMD:capo(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden usar este comando.");
        if(mecanico[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
        if(IsPlayerInAnyVehicle(playerid))
                return ErrorMsg(playerid, "Debes estar a pie para usar /capo.");
        if(g_BenCapoTimer[playerid] != -1)
                return ErrorMsg(playerid, "Ya estas abriendo un capo, espera a que termine.");
        if(g_BenRepararTimer[playerid] != -1)
                return ErrorMsg(playerid, "Estas reparando un vehiculo, no puedes usar /capo ahora.");

        // Buscar vehiculo mas cercano dentro de 5m
        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        new closestVeh = -1;
        new Float:closestDist = 9999.0;
        new Float:vx, Float:vy, Float:vz;
        for(new v = 1; v < MAX_VEHICLES; v++)
        {
                if(!IsValidVehicle(v)) continue;
                GetVehiclePos(v, vx, vy, vz);
                // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
                new Float:dist = floatsqroot((vx - px)*(vx - px) + (vy - py)*(vy - py) + (vz - pz)*(vz - pz));
                if(dist < closestDist && dist < 5.0)
                {
                        closestDist = dist;
                        closestVeh = v;
                }
        }
        if(closestVeh == -1)
                return ErrorMsg(playerid, "No hay vehiculos cerca (maximo 5 metros).");

        // Abrir capo del vehiculo
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(closestVeh, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(closestVeh, engine, lights, alarm, doors, 1, boot, objective);

        // Animacion de reparacion en loop (5 segundos controlados por timer)
        // P0-BEN-CAPO-ANIM: cambiada de CAR/Fixn_Car_Loop (acostado boca arriba)
        // a BOMBER/BOM_Plant_Loop (agachado, parece trabajar en el suelo).
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 1, 0, 0, 0, 0, 1);

        g_BenCapoVeh[playerid] = closestVeh;
        g_BenCapoTimer[playerid] = SetTimerEx("BenCapoCerrar", 5000, false, "i", playerid);

        SuccesMsg(playerid, "Abriendo capo del vehiculo...");
        printf("[P0-BEN-CAPO] Mecanico ID %d abrio capo del vehiculo %d (5s)", playerid, closestVeh);
        return 1;
}

// Callback: cierra el capo y pone de pie al mecanico tras 5 segundos.
forward BenCapoCerrar(playerid);
public BenCapoCerrar(playerid)
{
        g_BenCapoTimer[playerid] = -1;
        new veh = g_BenCapoVeh[playerid];
        g_BenCapoVeh[playerid] = -1;

        // Pone de pie al mecanico (termina la animacion de agachado)
        ClearAnimations(playerid);

        // Cerrar capo si el vehiculo sigue siendo valido
        if(veh >= 0 && IsValidVehicle(veh))
        {
                new engine, lights, alarm, doors, bonnet, boot, objective;
                GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(veh, engine, lights, alarm, doors, 0, boot, objective);
        }
        SuccesMsg(playerid, "Capo cerrado.");
        return 1;
}

// =====================================================================
// P0-BEN-REPARAR: /reparar - reparacion completa de Bennys.
// FIX 2026-08-02: el mecanico debe estar A PIE junto al vehiculo (no
// como conductor). Es el mismo patron que /capo pero con 15 segundos
// de animacion y cobro al dueÃ¯Â¿Â½o/conductor del vehiculo.
//
// Requisitos:
//   - Ser mecanico de Bennys (Org == 9)
//   - Tener el uniforme puesto (mecanico[playerid] == true)
//   - Estar A PIE (no en vehiculo)
//   - Estar en uno de los 3 puntos de reparacion de Bennys
//   - Tener un vehiculo cerca (maximo 5 metros)
//
// Flujo:
//   1. Busca el vehiculo mas cercano (max 5m).
//   2. Busca al conductor/dueÃ¯Â¿Â½o del vehiculo (si hay alguien dentro).
//      Si lo hay: cobra $2,000, paga al mecanico, envia mensaje
//      "El mecanico esta reparando tu vehiculo. Costo: $2,000."
//   3. Abre el capo del vehiculo.
//   4. Apaga el motor (engine=0) para evitar que el vehiculo se mueva.
//   5. Si hay conductor dentro: lo congela (TogglePlayerControllable=0)
//      para que no pueda arrancar el motor durante la reparacion.
//   6. Aplica animacion CAR/Fixn_Car_Loop al MECANICO durante 15s.
//   7. Al terminar (callback BenRepararFin):
//        - RepairVehicle + SetVehicleHealth(1000)
//        - Cierra el capo automaticamente
//        - ClearAnimations (pone de pie al mecanico)
//        - Descongela al conductor si fue congelado
//        - Mensaje "Vehiculo listo, reparado completamente." al
//          mecanico y a los ocupantes del vehiculo.
// =====================================================================
CMD:reparar(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden usar este comando.");
        if(mecanico[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
        if(IsPlayerInAnyVehicle(playerid))
                return ErrorMsg(playerid, "Debes estar a pie para reparar un vehiculo.");
        if(g_BenRepararTimer[playerid] != -1)
                return ErrorMsg(playerid, "Ya estas reparando un vehiculo.");
        if(g_BenCapoTimer[playerid] != -1)
                return ErrorMsg(playerid, "Estas abriendo un capo, no puedes reparar ahora.");

        // P0-BEN-REPARAR-PERMS: permisos por rango.
        //   Rango 1 (Ayudante): solo en la zona segura del HQ de Bennys.
        //   Rango 2+ (Mecanico, Jefe de Taller): en cualquier parte.
        new cargo_reparar = PlayerInfo[playerid][Cargo];
        if(cargo_reparar == 1)
        {
                if(GetPVarInt(playerid, "P0_BEN_ZS_InHQ") != 1)
                        return ErrorMsg(playerid, "Como Ayudante solo puedes reparar dentro de la zona segura del taller de Bennys.");
        }

        // Buscar vehiculo mas cercano dentro de 5m
        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        new closestVeh = -1;
        new Float:closestDist = 9999.0;
        new Float:vx, Float:vy, Float:vz;
        for(new v = 1; v < MAX_VEHICLES; v++)
        {
                if(!IsValidVehicle(v)) continue;
                GetVehiclePos(v, vx, vy, vz);
                // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
                new Float:dist = floatsqroot((vx - px)*(vx - px) + (vy - py)*(vy - py) + (vz - pz)*(vz - pz));
                if(dist < closestDist && dist < 5.0)
                {
                        closestDist = dist;
                        closestVeh = v;
                }
        }
        if(closestVeh == -1)
                return ErrorMsg(playerid, "No hay vehiculos cerca (maximo 5 metros).");

        new veh = closestVeh;

        // P0-BEN-GRUA: verificar si el vehiculo tiene deuda de grua pendiente
        if(g_VehGruaTowed[veh] && g_VehGruaDeuda[veh] > 0)
        {
                new msgDeuda[156];
                format(msgDeuda, sizeof(msgDeuda), "Este vehiculo tiene un servicio de grua pendiente de $%d. El dueno debe pagar el traslado antes de repararlo (usa /pagargrua en el taller).", g_VehGruaDeuda[veh]);
                return ErrorMsg(playerid, msgDeuda);
        }

        // Buscar al conductor/dueÃ¯Â¿Â½o del vehiculo (cualquier ocupante, preferimos asiento 0)
        new clienteid = -1;
        foreach(new p : Player)
        {
                if(IsPlayerInVehicle(p, veh))
                {
                        // Preferir el conductor (asiento 0). Si lo encontramos, lo usamos.
                        if(GetPlayerVehicleSeat(p) == 0)
                        {
                                clienteid = p;
                                break;
                        }
                        // Si no hay conductor, aceptamos al primer pasajero
                        if(clienteid == -1)
                                clienteid = p;
                }
        }

        // P0-BEN-REPARAR-PERMS: NO se requiere que haya alguien dentro del vehiculo.
        // - Si hay alguien dentro: se le cobra $2,000 (cliente paga al mecanico).
        // - Si no hay nadie: reparacion gratuita (el mecanico hace el trabajo igual).
        if(clienteid != -1)
        {
                // Hay cliente: cobrar $2,000
                if(PlayerInfo[clienteid][pDinheiro] < 2000)
                        return ErrorMsg(playerid, "El cliente no tiene dinero suficiente para la reparacion ($2,000).");
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                // (transaccion critica cliente->mecanico).
                AC_AddPlayerMoney(clienteid, -2000);
                AC_AddPlayerMoney(playerid, 2000);
                // FIX AUDIT2 AGENT2 M-13: SalvarDados inmediato para ambos
                // (cliente + mecanico). Sin esto, si crash antes del SaveTimer,
                // el cliente no paga y/o el mecanico no cobra (loss/dupe).
                SalvarDados(clienteid);
                SalvarDados(playerid);
                new msgCli[128];
                format(msgCli, sizeof(msgCli), "El mecanico esta reparando tu vehiculo. Costo: $2,000.");
                InfoMsg(clienteid, msgCli);
                new msgMec[128];
                format(msgMec, sizeof(msgMec), "Reparando vehiculo. Cobraste $2,000 al cliente.");
                SuccesMsg(playerid, msgMec);
        }
        else
        {
                // Sin cliente: reparacion gratuita
                InfoMsg(playerid, "Reparando vehiculo (sin cliente, servicio gratuito).");
        }

        // Abrir capo y apagar motor del vehiculo
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(veh, 0, lights, alarm, doors, 1, boot, objective);

        // Congelar al cliente si esta dentro del vehiculo (no podra arrancar/moverse)
        if(clienteid != -1)
                TogglePlayerControllable(clienteid, 0);

        // Animacion de reparacion al MECANICO (que esta a pie) durante 15 segundos
        // P0-BEN-REPARAR-ANIM: cambiada de CAR/Fixn_Car_Loop (acostado boca arriba)
        // a BOMBER/BOM_Plant_Loop (agachado, parece trabajar en el suelo).
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 1, 0, 0, 0, 0, 1);

        g_BenRepararVeh[playerid] = veh;
        // Guardamos el cliente en g_BenCapoVeh para reusar la variable (ya no se usa para capo durante reparacion)
        // Mejor: usamos SetPVar para guardar el cliente por si acaso
        SetPVarInt(playerid, "BenRepararCliente", clienteid);
        // FIX PASADA 3: guardar tambien el IDF del cliente para evitar
        // reutilizacion de slot (si el cliente se desconecta y otro jugador
        // entra en su slot durante los 15s, no queremos congelar al inocente).
        if(clienteid != -1 && clienteid != INVALID_PLAYER_ID)
                SetPVarInt(playerid, "BenRepararClienteIDF", PlayerInfo[clienteid][IDF]);
        else
                SetPVarInt(playerid, "BenRepararClienteIDF", -1);
        g_BenRepararTimer[playerid] = SetTimerEx("BenRepararFin", 15000, false, "i", playerid);

        printf("[P0-BEN-REPARAR] Mecanico ID %d inicio reparacion del vehiculo %d (15s), cliente %d", playerid, veh, clienteid);
        return 1;
}

// Callback: termina la reparacion a los 15 segundos.
// - Repara el vehiculo
// - Cierra el capo automaticamente
// - Pone de pie al mecanico
// - Descongela al cliente si fue congelado
// - Avisa al mecanico y a los ocupantes del vehiculo
forward BenRepararFin(playerid);
public BenRepararFin(playerid)
{
        g_BenRepararTimer[playerid] = -1;
        new veh = g_BenRepararVeh[playerid];
        g_BenRepararVeh[playerid] = -1;
        new clienteid = GetPVarInt(playerid, "BenRepararCliente");
        new clienteIDF_guardado = GetPVarInt(playerid, "BenRepararClienteIDF");
        DeletePVar(playerid, "BenRepararCliente");
        DeletePVar(playerid, "BenRepararClienteIDF");

        // Reparar y cerrar capo si el vehiculo sigue siendo valido
        if(veh >= 0 && IsValidVehicle(veh))
        {
                RepairVehicle(veh);
                SetVehicleHealth(veh, 1000.0);
                new engine, lights, alarm, doors, bonnet, boot, objective;
                GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(veh, engine, lights, alarm, doors, 0, boot, objective);
        }

        // Pone de pie al mecanico (termina animacion agachado)
        ClearAnimations(playerid);

        // Descongelar al cliente si sigue siendo el mismo jugador (validar IDF)
        // FIX PASADA 3: si el cliente se desconecto y otro jugador ocupo su slot,
        // no queremos congelar/descongelar al nuevo inocente.
        if(clienteid != -1 && clienteid != INVALID_PLAYER_ID
           && IsPlayerConnected(clienteid) && pLogado[clienteid]
           && PlayerInfo[clienteid][IDF] == clienteIDF_guardado)
        {
                TogglePlayerControllable(clienteid, 1);
        }

        // Mensaje al mecanico
        SuccesMsg(playerid, "Vehiculo listo, reparado completamente.");

        // Mensaje a los ocupantes del vehiculo (validar que sigan conectados)
        new msgTodos[128];
        format(msgTodos, sizeof(msgTodos), "Vehiculo listo, reparado completamente.");
        foreach(new p : Player)
        {
                if(p != playerid && IsPlayerInVehicle(p, veh))
                        SuccesMsg(p, msgTodos);
        }
        printf("[P0-BEN-REPARAR] Mecanico ID %d completo reparacion del vehiculo %d", playerid, veh);
        return 1;
}

// =====================================================================
// FIN COMANDOS BENNYS (/capo, /reparar)
// =====================================================================

// =====================================================================
// P0-BEN-BALIZA: /baliza - activa o desactiva el parpadeo de faros del
// Bobcat de Bennys. Solo funciona si el mecanico esta conduciendo su
// Bobcat (modelo 422) sacado del menu de Bennys.
// Tambien se puede activar con la tecla N (KEY_NO).
// =====================================================================
CMD:baliza(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden usar este comando.");
        new result = BenToggleBalizaTow(playerid);
        if(result == -1)
                return ErrorMsg(playerid, "Debes estar conduciendo tu Bobcat de Bennys para activar la baliza.");
        return 1;
}

// =====================================================================
// P0-MED-CHALECO/P0-REP-CHALECO: /chaleco - activa/desactiva el chaleco
// antibalas para Paramedicos y Reporteros en servicio.
//
// Requisitos:
//   - Ser Paramedico (org 10) o Reportero (org 11)
//   - Tener el uniforme vestido (g_ChalecoPermitido == true)
//
// Comportamiento:
//   - Si el chaleco esta desactivado -> lo activa:
//       Paramedicos: 100% de armadura
//       Reporteros: 50% de armadura
//   - Si el chaleco esta activado -> lo desactiva (0% armadura)
//   - El jugador puede activarlo/desactivarlo las veces que quiera.
// =====================================================================
CMD:chaleco(playerid)
{
        new org = PlayerInfo[playerid][Org];
        if(org != 10 && org != 11)
                return ErrorMsg(playerid, "Solo Paramedicos y Reporteros pueden usar este comando.");
        if(!g_ChalecoPermitido[playerid])
                return ErrorMsg(playerid, "Debes vestir el uniforme primero para usar el chaleco.");

        if(g_ChalecoActivo[playerid])
        {
                // Desactivar chaleco (sin cooldown - es quitar proteccion)
                ClearChalecoState(playerid);
                SuccesMsg(playerid, "Chaleco antibalas retirado.");
                printf("[P0-CHALECO] Jugador %d (org %d) retiro chaleco", playerid, org);
        }
        else
        {
                // FIX AUDIT MEDICO A3-CRIT-01: cooldown 60s al ACTIVAR chaleco.
                // Antes: /chaleco era spameable en combate. Un paramedico podia quitarse
                // y ponerse el chaleco infinitamente, recargando 100% armadura cada vez
                // sin espera. Inmortalidad efectiva en PvP.
                // Ahora: 60s de cooldown al activar, compartido con /curarme, /chalecome
                // y /revivirme via PVar CD_selfheal. Desactivar el chaleco NO tiene cooldown
                // (es quitarse proteccion, no ganar ventaja).
                new now = gettime();
                if(now - GetPVarInt(playerid, "CD_selfheal") < 60)
                {
                        new falta = 60 - (now - GetPVarInt(playerid, "CD_selfheal"));
                        new msgCD[100];
                        format(msgCD, sizeof(msgCD), "Debes esperar %d segundos antes de equipar el chaleco.", falta);
                        return ErrorMsg(playerid, msgCD);
                }
                SetPVarInt(playerid, "CD_selfheal", now);

                // Activar chaleco segun org
                new Float:armorAmount;
                if(org == 10)
                        armorAmount = 100.0;  // Paramedicos: 100%
                else
                        armorAmount = 50.0;   // Reporteros: 50%
                SetPlayerArmour(playerid, armorAmount);
                g_ChalecoActivo[playerid] = true;
                new msg[100];
                format(msg, sizeof(msg), "Chaleco antibalas equipado (%.0f%% proteccion).", armorAmount);
                SuccesMsg(playerid, msg);
                printf("[P0-CHALECO] Jugador %d (org %d) equipo chaleco %.0f%%", playerid, org, armorAmount);
        }
        return 1;
}

// =====================================================================
// P0-BEN-BALIZA: Helpers para la baliza + caja + piezas en el Bobcat.
//
// Objetos attachados al Bobcat (modelo 422) - coordenadas EXACTAS del usuario:
//   1. Caja 2358:     X=-0.008, Y=-1.790, Z=-0.260, rot Z=179.599 (cama trasera)
//   2. Barra 11701:   X=0.000,  Y=0.000,  Z=0.770,  rot 0,0,0       (techo cabina)
//   3. Pieza 2040 #1: X=-0.665, Y=-2.087, Z=-0.240, rot Z=178.799  (cama izq)
//   4. Pieza 2040 #2: X=0.720,  Y=-2.211, Z=-0.220, rot 0,0,0       (cama der)
//   5. Caja 1558:     X=0.000,  Y=-1.010, Z=0.000,  rot 0,0,0       (centro)
//
// Parpadeo de faros (activable con tecla N o /baliza):
//   - Al sacar el Bobcat, se crean los objetos decorativos PERO el parpadeo
//     esta APAGADO. Los faros del vehiculo no parpadean hasta que el mecanico
//     active la baliza.
//   - Para activar/desactivar: presionar tecla N (KEY_NO) o usar /baliza.
//   - Cuando esta activada, un timer cada 200ms (rapido) alterna los faros
//     delanteros del Bobcat entre encendido (lights=1) y apagado (lights=0).
//   - Los faros del Bobcat SI alumbran de verdad (nativos del vehiculo).
// =====================================================================
// =====================================================================
// P0-BEN-BALIZA-LUCES: Helper SOLO para parpadeo de faros (sin objetos).
// Se usa para el Towtruck (525) que no lleva objetos decorativos.
// Configura el vehicleid para que el timer sepa a quien parpadear,
// pero NO crea ningun objeto??. La baliza queda apagada por defecto,
// se activa con tecla N o /baliza.
// =====================================================================
stock BenCrearBalizaSoloLuces(playerid, vehicleid)
{
        if(vehicleid < 0 || !IsValidVehicle(vehicleid)) return 0;
        // Limpiar cualquier baliza anterior
        BenDestruirBalizasTow(playerid);
        // Solo guardar el vehicleid para que el timer sepa a quien hacer parpadear
        g_TowVehID[playerid] = vehicleid;
        // Estado inicial: baliza APAGADA (timer no arranca)
        g_TowFlashState[playerid] = false;
        g_TowFlashTimer[playerid] = -1;
        printf("[P0-BEN-BALIZA-LUCES] Solo parpadeo de faros configurado en veh %d para mecanico %d (baliza apagada, usar tecla N o /baliza)", vehicleid, playerid);
        return 1;
}

stock BenCrearBalizasTow(playerid, vehicleid)
{
        if(vehicleid < 0 || !IsValidVehicle(vehicleid)) return 0;
        // Si ya hay baliza creada, primero la destruimos (evita leaks)
        BenDestruirBalizasTow(playerid);

        // 1. Caja 2358 - cama trasera (coordenada exacta del usuario)
        g_TowCajaObj[playerid] = CreateDynamicObject(2358, 0.0, 0.0, -1000.0, 0.0, 0.0, 0.0);
        if(g_TowCajaObj[playerid] != INVALID_OBJECT_ID)
        {
                AttachDynamicObjectToVehicle(g_TowCajaObj[playerid], vehicleid, -0.008, -1.790, -0.260, 0.000, 0.000, 179.599);
        }

        // 2. Barra 11701 - techo de la cabina (coordenada exacta del usuario)
        // Material amarillo FIJO (no cambia con el timer)
        g_TowBarObj[playerid] = CreateDynamicObject(11701, 0.0, 0.0, -1000.0, 0.0, 0.0, 0.0);
        if(g_TowBarObj[playerid] != INVALID_OBJECT_ID)
        {
                AttachDynamicObjectToVehicle(g_TowBarObj[playerid], vehicleid, 0.000, 0.000, 0.770, 0.000, 0.000, 0.000);
                // Aplicar material amarillo brillante FIJO
                SetDynamicObjectMaterial(g_TowBarObj[playerid], 0, 19325, "lsmall_shops", "lsmall_shops01", 0xFFFF00FF);
        }

        // 3. Pieza 2040 #1 - cama izquierda (coordenada exacta del usuario)
        g_TowPieza1Obj[playerid] = CreateDynamicObject(2040, 0.0, 0.0, -1000.0, 0.0, 0.0, 0.0);
        if(g_TowPieza1Obj[playerid] != INVALID_OBJECT_ID)
        {
                AttachDynamicObjectToVehicle(g_TowPieza1Obj[playerid], vehicleid, -0.665, -2.087, -0.240, 0.000, 0.000, 178.799);
        }

        // 4. Pieza 2040 #2 - cama derecha (coordenada exacta del usuario)
        g_TowPieza2Obj[playerid] = CreateDynamicObject(2040, 0.0, 0.0, -1000.0, 0.0, 0.0, 0.0);
        if(g_TowPieza2Obj[playerid] != INVALID_OBJECT_ID)
        {
                AttachDynamicObjectToVehicle(g_TowPieza2Obj[playerid], vehicleid, 0.720, -2.211, -0.220, 0.000, 0.000, 0.000);
        }

        // 5. Caja 1558 - centro (coordenada exacta del usuario)
        g_TowCaja1558Obj[playerid] = CreateDynamicObject(1558, 0.0, 0.0, -1000.0, 0.0, 0.0, 0.0);
        if(g_TowCaja1558Obj[playerid] != INVALID_OBJECT_ID)
        {
                AttachDynamicObjectToVehicle(g_TowCaja1558Obj[playerid], vehicleid, 0.000, -1.010, 0.000, 0.000, 0.000, 0.000);
        }

        // 6. Guardar el vehicleid para que el timer sepa a quien hacer parpadear
        g_TowVehID[playerid] = vehicleid;

        // Estado inicial: baliza APAGADA (timer no arranca)
        // El mecanico debe activarla con tecla N o /baliza
        g_TowFlashState[playerid] = false;
        g_TowFlashTimer[playerid] = -1;

        printf("[P0-BEN-BALIZA] 5 objetos decorativos creados en Bobcat %d para mecanico %d (baliza apagada, usar tecla N o /baliza)", vehicleid, playerid);
        return 1;
}

// Activa o desactiva el parpadeo de la baliza del Bobcat.
// Retorna 1 si la activo, 0 si la desactivo, -1 si no hay Bobcat valido.
stock BenToggleBalizaTow(playerid)
{
        // Validar que el mecanico tenga un Bobcat con baliza creada
        if(g_TowVehID[playerid] == INVALID_VEHICLE_ID || !IsValidVehicle(g_TowVehID[playerid]))
                return -1;
        // Validar que el mecanico este en ese vehiculo como conductor
        if(GetPlayerVehicleID(playerid) != g_TowVehID[playerid] || GetPlayerVehicleSeat(playerid) != 0)
                return -1;

        if(g_TowFlashTimer[playerid] != -1)
        {
                // Baliza activa -> desactivar
                KillTimer(g_TowFlashTimer[playerid]);
                g_TowFlashTimer[playerid] = -1;
                // Apagar los faros
                new engine, lights, alarm, doors, bonnet, boot, objective;
                GetVehicleParamsEx(g_TowVehID[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(g_TowVehID[playerid], engine, 0, alarm, doors, bonnet, boot, objective);
                g_TowFlashState[playerid] = false;
                SuccesMsg(playerid, "Baliza desactivada.");
                printf("[P0-BEN-BALIZA] Mecanico %d desactivo baliza", playerid);
                return 0;
        }
        else
        {
                // Baliza inactiva -> activar (timer a 200ms = mas rapido)
                g_TowFlashState[playerid] = false; // arranca apagado, el timer lo enciende
                g_TowFlashTimer[playerid] = SetTimerEx("BenTowFlashToggle", 200, true, "i", playerid);
                SuccesMsg(playerid, "Baliza activada.");
                printf("[P0-BEN-BALIZA] Mecanico %d activo baliza (200ms)", playerid);
                return 1;
        }
}

stock BenDestruirBalizasTow(playerid)
{
        // Detener el timer de parpadeo si esta activo
        if(g_TowFlashTimer[playerid] != -1)
        {
                KillTimer(g_TowFlashTimer[playerid]);
                g_TowFlashTimer[playerid] = -1;
        }
        // Apagar los faros del vehiculo antes de limpiar
        if(g_TowVehID[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(g_TowVehID[playerid]))
        {
                new engine, lights, alarm, doors, bonnet, boot, objective;
                GetVehicleParamsEx(g_TowVehID[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(g_TowVehID[playerid], engine, 0, alarm, doors, bonnet, boot, objective);
        }
        g_TowVehID[playerid] = INVALID_VEHICLE_ID;
        // Destruir todos los objetos decorativos si existen
        if(g_TowBarObj[playerid] != -1 && IsValidDynamicObject(g_TowBarObj[playerid]))
                DestroyDynamicObject(g_TowBarObj[playerid]);
        g_TowBarObj[playerid] = -1;
        if(g_TowCajaObj[playerid] != -1 && IsValidDynamicObject(g_TowCajaObj[playerid]))
                DestroyDynamicObject(g_TowCajaObj[playerid]);
        g_TowCajaObj[playerid] = -1;
        if(g_TowCaja2Obj[playerid] != -1 && IsValidDynamicObject(g_TowCaja2Obj[playerid]))
                DestroyDynamicObject(g_TowCaja2Obj[playerid]);
        g_TowCaja2Obj[playerid] = -1;
        if(g_TowPieza1Obj[playerid] != -1 && IsValidDynamicObject(g_TowPieza1Obj[playerid]))
                DestroyDynamicObject(g_TowPieza1Obj[playerid]);
        g_TowPieza1Obj[playerid] = -1;
        if(g_TowPieza2Obj[playerid] != -1 && IsValidDynamicObject(g_TowPieza2Obj[playerid]))
                DestroyDynamicObject(g_TowPieza2Obj[playerid]);
        g_TowPieza2Obj[playerid] = -1;
        if(g_TowCaja1558Obj[playerid] != -1 && IsValidDynamicObject(g_TowCaja1558Obj[playerid]))
                DestroyDynamicObject(g_TowCaja1558Obj[playerid]);
        g_TowCaja1558Obj[playerid] = -1;
        // Limpiar variables obsoletas
        if(g_TowCoronaObj[playerid] != -1 && IsValidDynamicObject(g_TowCoronaObj[playerid]))
                DestroyDynamicObject(g_TowCoronaObj[playerid]);
        g_TowCoronaObj[playerid] = -1;
        if(g_TowLightObj[playerid] != -1 && IsValidDynamicObject(g_TowLightObj[playerid]))
                DestroyDynamicObject(g_TowLightObj[playerid]);
        g_TowLightObj[playerid] = -1;
        // Resetear estado
        g_TowFlashState[playerid] = false;
        return 1;
}

// Callback: alterna los faros del Bobcat entre encendido y apagado cada 200ms.
// - No toca los objetos decorativos (la barra 11701 ya tiene material fijo).
// - Solo cambia el parametro "lights" del vehiculo con SetVehicleParamsEx.
forward BenTowFlashToggle(playerid);
public BenTowFlashToggle(playerid)
{
        // Validar que el vehiculo siga existiendo
        if(g_TowVehID[playerid] == INVALID_VEHICLE_ID || !IsValidVehicle(g_TowVehID[playerid]))
        {
                // El vehiculo fue destruido. Limpiar.
                BenDestruirBalizasTow(playerid);
                return 1;
        }
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(g_TowVehID[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
        if(g_TowFlashState[playerid])
        {
                // Estado ON -> cambiar a OFF (faros apagados)
                SetVehicleParamsEx(g_TowVehID[playerid], engine, 0, alarm, doors, bonnet, boot, objective);
                g_TowFlashState[playerid] = false;
        }
        else
        {
                // Estado OFF -> cambiar a ON (faros encendidos)
                SetVehicleParamsEx(g_TowVehID[playerid], engine, 1, alarm, doors, bonnet, boot, objective);
                g_TowFlashState[playerid] = true;
        }
        return 1;
}

// =====================================================================
// FIN HELPERS BALIZA TOWTRUCK
// =====================================================================

// =====================================================================
// P0-BEN-GRUA: Helpers para el sistema de llamada de grua.
// =====================================================================

// Devuelve el ID de zona geografica segun coordenadas X, Y del mapa.
// Limites aproximados del mapa de San Andreas.
stock GetZonaGrua(Float:x, Float:y)
{
        // Tierra Robada (noroeste): X[-1600, 400], Y[1800, 3000] -> $3,800
        if(x >= -1600.0 && x <= 400.0 && y >= 1800.0 && y <= 3000.0)
                return GRUA_ZONA_TIERRA;
        // Bone County (norte central): X[-1600, 400], Y[600, 1800] -> $3,500
        if(x >= -1600.0 && x <= 400.0 && y >= 600.0 && y < 1800.0)
                return GRUA_ZONA_BONE;
        // San Fierro (oeste norte): X[-3200, -1600], Y[800, 2200] -> $3,500
        if(x >= -3200.0 && x <= -1600.0 && y >= 800.0 && y <= 2200.0)
                return GRUA_ZONA_SF;
        // Las Venturas (este): X[1800, 3000], Y[600, 3000] -> $3,000
        if(x >= 1800.0 && x <= 3000.0 && y >= 600.0 && y <= 3000.0)
                return GRUA_ZONA_LV;
        // Whetstone (sudoeste): X[-3200, -1600], Y[-2600, -200] -> $3,000
        if(x >= -3200.0 && x <= -1600.0 && y >= -2600.0 && y <= -200.0)
                return GRUA_ZONA_WHETSTONE;
        // Flint County (centro-oeste): X[-2600, -400], Y[-200, 800] -> $2,500
        if(x >= -2600.0 && x <= -400.0 && y >= -200.0 && y <= 800.0)
                return GRUA_ZONA_FLINT;
        // Red County (centro-este): X[400, 1800], Y[-200, 600] -> $2,000
        if(x >= 400.0 && x <= 1800.0 && y >= -200.0 && y <= 600.0)
                return GRUA_ZONA_RED_COUNTY;
        // Los Santos (sur): X[-2600, 2200], Y[-2600, -200] -> $1,500
        if(x >= -2600.0 && x <= 2200.0 && y >= -2600.0 && y <= -200.0)
                return GRUA_ZONA_LS;
        // Default: tratar como zona costosa (cayo, area rural lejana)
        return GRUA_ZONA_LV;
}

// Devuelve el nombre de la zona segun su ID.
stock GetZonaNombreGrua(zoneID)
{
        new nombre[32];
        switch(zoneID)
        {
                case GRUA_ZONA_LS:         nombre = "Los Santos";
                case GRUA_ZONA_RED_COUNTY: nombre = "Red County";
                case GRUA_ZONA_FLINT:      nombre = "Flint County";
                case GRUA_ZONA_WHETSTONE:  nombre = "Whetstone";
                case GRUA_ZONA_LV:         nombre = "Las Venturas";
                case GRUA_ZONA_SF:         nombre = "San Fierro";
                case GRUA_ZONA_BONE:       nombre = "Bone County";
                case GRUA_ZONA_TIERRA:     nombre = "Tierra Robada";
                default:                   nombre = "Zona desconocida";
        }
        return nombre;
}

// Devuelve el precio base de traslado segun la zona.
stock GetPrecioGrua(zoneID)
{
        switch(zoneID)
        {
                case GRUA_ZONA_LS:         return 1500;
                case GRUA_ZONA_RED_COUNTY: return 2000;
                case GRUA_ZONA_FLINT:      return 2500;
                case GRUA_ZONA_WHETSTONE:  return 3000;
                case GRUA_ZONA_LV:         return 3000;
                case GRUA_ZONA_SF:         return 3500;
                case GRUA_ZONA_BONE:       return 3500;
                case GRUA_ZONA_TIERRA:     return 3800;
                default:                   return 3000;
        }
        return 3000;
}

// Guarda un pago pendiente de traslado de grua para un mecanico offline.
// Formato del archivo: una linea por pago pendiente, "IDF monto".
stock SavePendingTowPayment(mechanicIDF, amount)
{
        if(mechanicIDF < 0 || amount <= 0) return 0;
        new File:f = fopen("Contas/PendingTow.ini", io_append);
        if(!f) return 0;
        new line[64];
        format(line, sizeof(line), "%d %d\r\n", mechanicIDF, amount);
        fwrite(f, line);
        fclose(f);
        printf("[P0-BEN-GRUA] Pago pendiente guardado: mecanico IDF %d, monto $%d", mechanicIDF, amount);
        return 1;
}

// Carga y deposita todos los pagos pendientes de traslado de grua para el jugador.
// Se llama en OnPlayerConnect (despues del login). Devuelve el total depositado.
stock LoadPendingTowPayments(playerid)
{
        if(!pLogado[playerid]) return 0;
        new myIDF = PlayerInfo[playerid][IDF];
        if(myIDF < 0) return 0;

        new File:f = fopen("Contas/PendingTow.ini", io_read);
        if(!f) return 0;

        new line[64];
        new totalDepositado = 0;
        new pagos[MAX_PLAYERS * 2]; // pares (IDF, monto) a mantener en el archivo
        new count = 0;

        while(fread(f, line))
        {
            new idfRead, montoRead;
            if(sscanf(line, "dd", idfRead, montoRead)) continue;
            if(idfRead == myIDF)
            {
                // Este pago es para este jugador
                totalDepositado += montoRead;
            }
            else
            {
                // No es para este jugador, conservar en archivo
                if(count < sizeof(pagos) - 1)
                {
                        pagos[count++] = idfRead;
                        pagos[count++] = montoRead;
                }
            }
        }
        fclose(f);

        if(totalDepositado > 0)
        {
                // Depositar el dinero al jugador
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                // (pago atrasado por traslados de grua mientras offline).
                AC_AddPlayerMoney(playerid, totalDepositado);
                // Notificar
                new msg[180];
                format(msg, sizeof(msg), "[GRUA] Mientras estabas offline, recibiste $%d por traslados de grua que realizaste. Se depositaron en tu efectivo.", totalDepositado);
                // Retrasar el mensaje 5s para que llegue despues del login
                SetTimerEx("BenGruaNotifyPending", 5000, false, "is", playerid, msg);
                printf("[P0-BEN-GRUA] Jugador IDF %d recibio $%d de pagos pendientes", myIDF, totalDepositado);
        }

        // Reescribir el archivo sin los pagos ya depositados
        f = fopen("Contas/PendingTow.ini", io_write);
        if(f)
        {
                for(new i = 0; i < count; i += 2)
                {
                        new out[64];
                        format(out, sizeof(out), "%d %d\r\n", pagos[i], pagos[i+1]);
                        fwrite(f, out);
                }
                fclose(f);
        }
        return totalDepositado;
}

forward BenGruaNotifyPending(playerid, msg[]);
public BenGruaNotifyPending(playerid, msg[])
{
        if(IsPlayerConnected(playerid))
                SendClientMessage(playerid, 0x00FF00FF, msg);
        return 1;
}

// =====================================================================
// P0-BEN-GRUA: /llamargrua - cualquier jugador con vehiculo daÃ¯Â¿Â½ado.
// =====================================================================
CMD:llamargrua(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        // Debe estar en un vehiculo como conductor
        if(!IsPlayerInAnyVehicle(playerid))
                return ErrorMsg(playerid, "Debes estar dentro del vehiculo daÃ¯Â¿Â½ado para llamar la grua.");
        if(GetPlayerVehicleSeat(playerid) != 0)
                return ErrorMsg(playerid, "Debes ser el conductor del vehiculo para llamar la grua.");

        new veh = GetPlayerVehicleID(playerid);

        // Verificar que el vehiculo este daÃ¯Â¿Â½ado (HP < 500)
        new Float:vehHP;
        GetVehicleHealth(veh, vehHP);
        if(vehHP >= 500.0)
        {
                new msgHP[128];
                format(msgHP, sizeof(msgHP), "Tu vehiculo no esta lo suficientemente daÃ¯Â¿Â½ado para llamar la grua. (HP actual %.0f)", vehHP);
                return ErrorMsg(playerid, msgHP);
        }

        // Verificar que no tenga ya una llamada activa para este vehiculo
        if(g_VehGruaLlamada[veh])
                return ErrorMsg(playerid, "Ya hay una llamada de grua activa para este vehiculo.");

        // Verificar que no tenga deuda pendiente
        if(g_VehGruaTowed[veh] && g_VehGruaDeuda[veh] > 0)
        {
                new msgDeuda[156];
                format(msgDeuda, sizeof(msgDeuda), "Este vehiculo tiene una deuda de grua pendiente de $%d. Pagala en el taller de Bennys con /pagargrua.", g_VehGruaDeuda[veh]);
                return ErrorMsg(playerid, msgDeuda);
        }

        // Buscar slot libre en g_GruaCalls
        new slot = -1;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
                if(!g_GruaCalls[i][gc_active])
                {
                        slot = i;
                        break;
                }
        }
        if(slot == -1)
                return ErrorMsg(playerid, "El sistema de gruas esta saturado. Intenta de nuevo en un momento.");

        // Calcular zona y precio
        new Float:vx, Float:vy, Float:vz;
        GetVehiclePos(veh, vx, vy, vz);
        new zoneID = GetZonaGrua(vx, vy);
        new precio = GetPrecioGrua(zoneID);

        // Llenar la entrada
        g_GruaCalls[slot][gc_active] = true;
        g_GruaCalls[slot][gc_callerID] = playerid;
        GetPlayerName(playerid, g_GruaCalls[slot][gc_callerName], 24);
        g_GruaCalls[slot][gc_vehID] = veh;
        g_GruaCalls[slot][gc_vehX] = vx;
        g_GruaCalls[slot][gc_vehY] = vy;
        g_GruaCalls[slot][gc_vehZ] = vz;
        g_GruaCalls[slot][gc_zoneID] = zoneID;
        g_GruaCalls[slot][gc_precio] = precio;
        g_GruaCalls[slot][gc_acceptedByMech] = -1;

        // Marcar vehiculo como congelado por llamada de grua
        g_VehGruaLlamada[veh] = true;
        // Guardar info del dueÃ¯Â¿Â½o
        g_VehGruaOwnerIDF[veh] = PlayerInfo[playerid][IDF];
        GetPlayerName(playerid, g_VehGruaOwnerName[veh], 24);

        // Apagar motor del vehiculo
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(veh, 0, lights, alarm, doors, bonnet, boot, objective);

        // Sacar al jugador del vehiculo (queda a pie junto al vehiculo)
        // FIX PASADA 3: RemoveFromVehicle no es nativa de SA-MP, la correcta
        // es RemovePlayerFromVehicle.
        RemovePlayerFromVehicle(playerid);

        // Set 30s timer para cancelar la llamada si nadie acepta
        g_GruaCalls[slot][gc_callTimer] = SetTimerEx("BenGruaCallTimeout", 30000, false, "i", slot);
        // Set 5min timer para descongelar el vehiculo si nadie lo recoge
        g_GruaCalls[slot][gc_unfreezeTimer] = SetTimerEx("BenGruaUnfreezeTimeout", 300000, false, "i", slot);

        // Notificar al jugador
        new zonaNom[32];
        strcpy(zonaNom, GetZonaNombreGrua(zoneID), sizeof(zonaNom));
        new msgCaller[180];
        format(msgCaller, sizeof(msgCaller), "Llamaste a la grua de Bennys. Zona: %s. Precio estimado del traslado: $%d. Tu vehiculo ha sido inmovilizado. En 30s se cancelara si nadie acepta; en 5min se descongelara y podras usar un kit.", zonaNom, precio);
        SuccesMsg(playerid, msgCaller);

        // Notificar a todos los mecanicos de Bennys online en servicio
        new msgMech[200];
        format(msgMech, sizeof(msgMech), "[GRUA] %s (ID:%d) solicita grua en %s. Precio: $%d. Usa /aceptargrua para ver la lista.", g_GruaCalls[slot][gc_callerName], playerid, zonaNom, precio);
        foreach(new m : Player)
        {
                if(pLogado[m] && PlayerInfo[m][Org] == 9)
                        SendClientMessage(m, 0xFFD700FF, msgMech);
        }

        printf("[P0-BEN-GRUA] Jugador %s (ID:%d) llamo grua - slot %d, zona %s (%d), precio $%d, veh %d",
                g_GruaCalls[slot][gc_callerName], playerid, slot, zonaNom, zoneID, precio, veh);
        return 1;
}

// Callback: 30s sin nadie aceptar la llamada.
forward BenGruaCallTimeout(slot);
public BenGruaCallTimeout(slot)
{
        if(slot < 0 || slot >= MAX_PLAYERS) return 1;
        if(!g_GruaCalls[slot][gc_active]) return 1;

        // Solo cancelar si nadie acepto aun
        if(g_GruaCalls[slot][gc_acceptedByMech] != -1)
        {
                // Alguien acepto pero no llego a tiempo: el timer de 5min sigue vigente
                g_GruaCalls[slot][gc_callTimer] = -1;
                return 1;
        }

        new callerID = g_GruaCalls[slot][gc_callerID];
        // Limpiar el timer
        g_GruaCalls[slot][gc_callTimer] = -1;

        // Notificar al caller que la llamada expiro
        if(callerID != INVALID_PLAYER_ID && IsPlayerConnected(callerID))
        {
                ErrorMsg(callerID, "Tu llamada de grua expiro (30s) sin que ningun mecanico aceptara. Puedes volver a llamar con /llamargrua.");
        }
        printf("[P0-BEN-GRUA] Llamada slot %d expiro (30s)", slot);
        return 1;
}

// Callback: 5min - descongela el vehiculo si nunca fue remolcado.
forward BenGruaUnfreezeTimeout(slot);
public BenGruaUnfreezeTimeout(slot)
{
        if(slot < 0 || slot >= MAX_PLAYERS) return 1;
        if(!g_GruaCalls[slot][gc_active]) return 1;

        new veh = g_GruaCalls[slot][gc_vehID];
        new callerID = g_GruaCalls[slot][gc_callerID];

        // Limpiar entrada de llamada
        g_GruaCalls[slot][gc_active] = false;
        g_GruaCalls[slot][gc_callerID] = INVALID_PLAYER_ID;
        g_GruaCalls[slot][gc_vehID] = INVALID_VEHICLE_ID;
        g_GruaCalls[slot][gc_callTimer] = -1;
        g_GruaCalls[slot][gc_unfreezeTimer] = -1;
        g_GruaCalls[slot][gc_acceptedByMech] = -1;

        // Si el vehiculo NO fue remolcado (no tiene deuda), descongelarlo
        if(veh >= 0 && veh < MAX_VEHICLES && IsValidVehicle(veh))
        {
                if(!g_VehGruaTowed[veh])
                {
                        // Reactivar motor
                        new engine, lights, alarm, doors, bonnet, boot, objective;
                        GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
                        SetVehicleParamsEx(veh, 1, lights, alarm, doors, bonnet, boot, objective);
                        g_VehGruaLlamada[veh] = false;

                        if(callerID != INVALID_PLAYER_ID && IsPlayerConnected(callerID))
                        {
                                SuccesMsg(callerID, "Han pasado 5 minutos sin que la grua llegue. Tu vehiculo ha sido descongelado. Ya puedes usar un kit de reparacion o conducirlo.");
                        }
                        printf("[P0-BEN-GRUA] Vehiculo %d descongelado tras 5min de espera", veh);
                }
        }
        return 1;
}

// =====================================================================
// P0-BEN-GRUA: /aceptargrua - mecanico de Bennys acepta una llamada.
// Muestra un dialog con la lista de llamadas pendientes.
// =====================================================================
CMD:aceptargrua(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden aceptar llamadas de grua.");
        if(mecanico[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");

        // Construir la lista de llamadas activas
        new line[256];
        new lista[1024];
        new count = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
                if(g_GruaCalls[i][gc_active] && g_GruaCalls[i][gc_acceptedByMech] == -1)
                {
                        new zonaNom[32];
                        strcpy(zonaNom, GetZonaNombreGrua(g_GruaCalls[i][gc_zoneID]), sizeof(zonaNom));
                        format(line, sizeof(line), "{FFFFFF}%s (ID:%d)\t{FFFF00}%s\t{00FF00}$%d\n",
                                g_GruaCalls[i][gc_callerName], g_GruaCalls[i][gc_callerID], zonaNom, g_GruaCalls[i][gc_precio]);
                        strcat(lista, line);
                        count++;
                        // Guardar slot en PVar para usar al aceptar
                        SetPVarInt(playerid, "BenGruaSlot", i);
                }
        }
        if(count == 0)
                return ErrorMsg(playerid, "No hay llamadas de grua pendientes en este momento.");

        ShowPlayerDialog(playerid, DIALOG_ACEPTARGRUA, DIALOG_STYLE_LIST, "Llamadas de grua pendientes", lista, "Aceptar", "Cancelar");
        return 1;
}

// =====================================================================
// P0-BEN-GRUA: /pagargrua - el dueÃ¯Â¿Â½o paga la deuda de traslado.
// Debe estar en la zona segura del HQ de Bennys.
// =====================================================================
CMD:pagargrua(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        // Debe estar en la zona segura de Bennys
        // FIX AUDIT AC-H4: aceptar P0_BEN_ZS_InHQ (mecÃ¯Â¿Â½nicos, con protecciÃ¯Â¿Â½n AC)
        // o P0_BEN_ZS_InArea (no-miembros, sin protecciÃ¯Â¿Â½n AC pero tracking de area).
        if(GetPVarInt(playerid, "P0_BEN_ZS_InHQ") != 1 && GetPVarInt(playerid, "P0_BEN_ZS_InArea") != 1)
                return ErrorMsg(playerid, "Debes estar en el taller de Bennys para pagar la deuda de grua.");

        // Buscar el vehiculo del jugador que tenga deuda
        // Primero: vehiculo civil del jugador (si existe y tiene deuda)
        new veh = -1;
        if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(VeiculoCivil[playerid]))
        {
                if(g_VehGruaTowed[VeiculoCivil[playerid]] && g_VehGruaDeuda[VeiculoCivil[playerid]] > 0)
                        veh = VeiculoCivil[playerid];
        }
        // Si no, buscar el vehiculo mas cercano con deuda dentro de 10m
        if(veh == -1)
        {
                new Float:px, Float:py, Float:pz;
                GetPlayerPos(playerid, px, py, pz);
                new Float:closestDist = 9999.0;
                new Float:vx, Float:vy, Float:vz;
                for(new v = 1; v < MAX_VEHICLES; v++)
                {
                        if(!IsValidVehicle(v)) continue;
                        if(!g_VehGruaTowed[v] || g_VehGruaDeuda[v] <= 0) continue;
                        // Solo vehiculos donde el dueÃ¯Â¿Â½o sea este jugador
                        if(g_VehGruaOwnerIDF[v] != PlayerInfo[playerid][IDF]) continue;
                        GetVehiclePos(v, vx, vy, vz);
                        // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
                        new Float:dist = floatsqroot((vx - px)*(vx - px) + (vy - py)*(vy - py) + (vz - pz)*(vz - pz));
                        if(dist < closestDist && dist < 10.0)
                        {
                                closestDist = dist;
                                veh = v;
                        }
                }
        }
        if(veh == -1)
                return ErrorMsg(playerid, "No tienes ningun vehiculo con deuda de grua pendiente cerca.");

        new deuda = g_VehGruaDeuda[veh];
        if(PlayerInfo[playerid][pDinheiro] < deuda)
        {
                new msgFalta[128];
                format(msgFalta, sizeof(msgFalta), "Tu deuda de grua es de $%d pero solo tienes $%d en efectivo.", deuda, PlayerInfo[playerid][pDinheiro]);
                return ErrorMsg(playerid, msgFalta);
        }

        // Cobrar al jugador
        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
        AC_AddPlayerMoney(playerid, -deuda);
        // FIX AUDIT2 AGENT2 M-14: SalvarDados inmediato del pagador.
        // Sin esto, si crash antes del SaveTimer, el pago se revierte
        // (jugador recupera el dinero en disco y la deuda sigue activa).
        SalvarDados(playerid);

        // Pagar al mecanico original (si esta online) o guardar como pendiente
        new mecIDF = g_VehGruaMecanicoIDF[veh];
        if(mecIDF >= 0)
        {
                new mecOnline = -1;
                foreach(new m : Player)
                {
                        if(pLogado[m] && PlayerInfo[m][IDF] == mecIDF)
                        {
                                mecOnline = m;
                                break;
                        }
                }
                if(mecOnline != -1)
                {
                        // Mecanico online: pagar directo
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(mecOnline, deuda);
                        // FIX AUDIT2 AGENT2 M-14: SalvarDados inmediato del
                        // mecanico online. Sin esto, si crash antes del SaveTimer,
                        // el mecanico pierde el pago (loss asimetrico).
                        SalvarDados(mecOnline);
                        new msgMec[160];
                        format(msgMec, sizeof(msgMec), "[GRUA] %s pago tu traslado de grua. Recibiste $%d.", g_VehGruaOwnerName[veh], deuda);
                        SendClientMessage(mecOnline, 0x00FF00FF, msgMec);
                }
                else
                {
                        // Mecanico offline: guardar pendiente
                        SavePendingTowPayment(mecIDF, deuda);
                }
        }

        // Limpiar deuda y descongelar el vehiculo
        g_VehGruaDeuda[veh] = 0;
        g_VehGruaPrecioOriginal[veh] = 0;
        g_VehGruaTowed[veh] = false;
        g_VehGruaLlamada[veh] = false;
        g_VehGruaOwnerIDF[veh] = -1;
        g_VehGruaMecanicoIDF[veh] = -1;

        // Reactivar motor
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(veh, 1, lights, alarm, doors, bonnet, boot, objective);

        new msgOk[160];
        format(msgOk, sizeof(msgOk), "Pagaste $%d de deuda de grua. Tu vehiculo esta libre y puede ser reparado.", deuda);
        SuccesMsg(playerid, msgOk);
        printf("[P0-BEN-GRUA] Jugador %s (ID:%d) pago deuda de grua $%d por veh %d", g_VehGruaOwnerName[veh], playerid, deuda, veh);
        return 1;
}

// =====================================================================
// FIN SISTEMA GRUA /llamargrua /aceptargrua /pagargrua
// =====================================================================

// =====================================================================
// P2-4: CODIGOS DE LLAMADA POLICIAL (10-codes)
// Sistema de cÃ¯Â¿Â½digos rÃ¯Â¿Â½pidos para radio policial. Permite a los oficiales
// comunicarse de forma estandarizada y breve en situaciones de combate.
// Solo funciona para IsPolicial en servicio (Patrulha=true).
//
// Codigos implementados (alias fÃ¯Â¿Â½ciles de recordar):
//   /afirmativo  -> 10-4 "Entendido/Afirmativo"
//   /ubicacion   -> 10-20 "Ubicacion" (reporta tu zona actual)
//   /emergencia  -> 10-33 "Emergencia - oficial necesita ayuda" (alerta sonora a todos)
//   /accidente   -> 10-50 "Accidente vehicular"
//   /peligro     -> 10-99 "Sospechoso armado y peligroso"
// =====================================================================
CMD:afirmativo(playerid)
{
        if(!IsPolicial(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        new msg[128];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {00FF00}10-4 Afirmativo{FFFFFF}.", PlayerInfo[playerid][IDF]);
        SendRadioMessage(0xDDA0DDFF, msg);
        return 1;
}

CMD:ubicacion(playerid)
{
        if(!IsPolicial(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        new zone[MAX_ZONE_NAME];
        GetPlayer2DZone2(playerid, zone, sizeof(zone));
        new msg[160];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {FFFF00}10-20 Ubicacion: {FFFFFF}%s.", PlayerInfo[playerid][IDF], zone);
        SendRadioMessage(0xDDA0DDFF, msg);
        return 1;
}

CMD:emergencia(playerid)
{
        if(!IsPolicial(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        new zone[MAX_ZONE_NAME];
        GetPlayer2DZone2(playerid, zone, sizeof(zone));
        new msg[200];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {FF0000}10-33 EMERGENCIA - NECESITO AYUDA INMEDIATA EN %s{FFFFFF}!", PlayerInfo[playerid][IDF], zone);
        // Aviso urgente a TODAS las fuerzas del orden
        SendRadioMessage(0xFF0000FF, msg);
        // Sonido de alerta + GameText para todos los policiales en servicio
        foreach(new i : Player)
        {
                if(pLogado[i] && IsPolicial(i) && Patrulha[i])
                {
                        PlayerPlaySound(i, 1057, 0.0, 0.0, 0.0);
                        GameTextForPlayer(i, "~r~10-33 EMERGENCIA!", 3000, 5);
                }
        }
        return 1;
}

CMD:accidente(playerid)
{
        if(!IsPolicial(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        new zone[MAX_ZONE_NAME];
        GetPlayer2DZone2(playerid, zone, sizeof(zone));
        new msg[180];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {FFAA00}10-50 Accidente vehicular en %s{FFFFFF}. Se requiere ambulancia.", PlayerInfo[playerid][IDF], zone);
        SendRadioMessage(0xDDA0DDFF, msg);
        return 1;
}

CMD:peligro(playerid)
{
        if(!IsPolicial(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        new zone[MAX_ZONE_NAME];
        GetPlayer2DZone2(playerid, zone, sizeof(zone));
        new msg[200];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {FF0000}10-99 Sospechoso armado y peligroso en %s{FFFFFF}. Refuerzos requeridos.", PlayerInfo[playerid][IDF], zone);
        SendRadioMessage(0xFF8800FF, msg);
        return 1;
}

// =====================================================================
// FIN P2-4 10-CODES
// =====================================================================

// =====================================================================
// FIX P0-5: Zonas seguras en HQs policiales - callbacks de Streamer.
// Estos callbacks se invocan cuando un jugador entra/sale de un area
// dinamica registrada con CreateDynamicSphere / CreateDynamicRectangle, etc.
// El plugin Streamer los llama automaticamente; no necesitan forward explicito
// porque ya estan declarados en streamer.inc.
// =====================================================================
public OnPlayerEnterDynamicArea(playerid, areaid)
{
        // FIX AUDIT HQSAFE 6P: Las zonas seguras solo aplican a miembros de la faccion duena del HQ.
        // Antes cualquier jugador sin wanted podia entrar y volverse inmortal.
        // Ahora se valida PlayerInfo[playerid][Org] == OWNER_ORG antes de otorgar proteccion.
        // Excepciones: algemados, espectadores, wanted > 0 siempre se excluyen.

        // Helper: guardar HP previo para restaurar al salir (evitar free heal)
        new Float:prevHP;
        GetPlayerHealth(playerid, prevHP);
        if(prevHP > 100.0) prevHP = 100.0; // clamp

        // FIX P0-5: HQ Policia Nacional - zona segura (solo Org 1)
        if(areaid == AreaHQ_Policia)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 1) { // FIX AUDIT HQSAFE: solo miembros de PN
                        // FIX AUDIT AC-H4: NO setear P0_5_InHQ para no-miembros.
                        // Antes: se seteaba P0_5_InHQ=1 incluso para no-miembros,
                        // lo que exima anti-HP/anti-armour hack (OnPlayerUpdate
                        // checkea este PVar para eximir HP > 100). Un no-miembro
                        // podia entrar al HQ y tener HP > 100 sin ser detectado.
                        // Ahora: no setear P0_5_InHQ para no-miembros. Si en el
                        // futuro se necesita tracking de area para no-miembros,
                        // usar PVar separado (P0_5_InHQArea) que NO exima AC.
                        return 1; // NO otorgar proteccion ni setear PVar AC
                }
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP); // guardar HP previo
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_5_InHQ") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ de Policia Nacional. Estas protegido.");
                        SetPVarInt(playerid, "P0_5_InHQ", 1);
                }
                return 1;
        }
        // T0-2: HQ Transito - zona segura (solo Org 2)
        if(areaid == AreaHQ_Transito)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 2) { return 1; } // FIX AUDIT AC-H4: no setear InHQTransito para no-miembros
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "T0_2_InHQTransito") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ de Transito. Estas protegido.");
                        SetPVarInt(playerid, "T0_2_InHQTransito", 1);
                }
                return 1;
        }
        // P0-FBI-1: HQ FBI - zona segura (solo Org 3)
        if(areaid == AreaHQ_FBI)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 3) { return 1; } // FIX AUDIT AC-H4: no setear InHQFBI para no-miembros
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_FBI1_InHQFBI") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ del FBI. Estas protegido.");
                        SetPVarInt(playerid, "P0_FBI1_InHQFBI", 1);
                }
                return 1;
        }
        // P0-SWAT-1: HQ SWAT - zona segura (solo Org 4)
        if(areaid == AreaHQ_SWAT)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 4) { return 1; } // FIX AUDIT AC-H4: no setear InHQSWAT para no-miembros
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_SWAT1_InHQSWAT") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ del SWAT. Estas protegido.");
                        SetPVarInt(playerid, "P0_SWAT1_InHQSWAT", 1);
                }
                return 1;
        }
        // P0-EJ-1: HQ Ejercito - zona segura (solo Org 14)
        if(areaid == AreaHQ_Ejercito)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 14) { return 1; } // FIX AUDIT AC-H4: no setear InHQEJ para no-miembros
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_EJ1_InHQEJ") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ del Ejercito. Estas protegido.");
                        SetPVarInt(playerid, "P0_EJ1_InHQEJ", 1);
                }
                return 1;
        }
        // P0-REP-2: HQ Reporteros - zona segura (solo Org 11)
        if(areaid == AreaHQ_Reporteros)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 11) { return 1; } // FIX AUDIT AC-H4: no setear InHQREP para no-miembros
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_REP2_InHQREP") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al HQ de Reporteros. Estas protegido.");
                        SetPVarInt(playerid, "P0_REP2_InHQREP", 1);
                }
                return 1;
        }
        // P0-BEN-ZS: HQ Bennys - zona segura (solo Org 9)
        if(areaid == AreaHQ_Bennys)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                if(PlayerInfo[playerid][Org] != 9) {
                        // FIX AUDIT AC-H4: Bennys es EXCEPCION porque /pagargrua requiere
                        // saber si el jugador esta en el area. Pero NO seteamos
                        // P0_BEN_ZS_InHQ (que exime AC HP/armour). Usamos PVar
                        // separado P0_BEN_ZS_InArea (NO exime AC).
                        SetPVarInt(playerid, "P0_BEN_ZS_InArea", 1); // tracking area (NO exime AC)
                        return 1; // NO otorgar proteccion HP/armour
                }
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "P0_BEN_ZS_InHQ") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al taller de Bennys. Estas protegido.");
                        SetPVarInt(playerid, "P0_BEN_ZS_InHQ", 1);
                }
                return 1;
        }
        // M0-2: Hospital Central - zona segura (FIX AUDIT HQSAFE: agregar wanted check)
        if(areaid == AreaHospital_SafeZone)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1; // FIX AUDIT HQSAFE: hospital tambien excluye wanted
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "M0_2_InHospital") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al Hospital Central. Estas protegido.");
                        SetPVarInt(playerid, "M0_2_InHospital", 1);
                }
                return 1;
        }
        // FIX AUDIT MEDICO A3-HIGH-02: zona segura para area de revive en interior 2.
        if(areaid == AreaHospitalRevive_SafeZone)
        {
                if(PlayerInfo[playerid][pCongelado] == true) return 1;
                if(IsAssistindo[playerid] == true) return 1;
                if(GetPlayerWantedLevel(playerid) > 0) return 1;
                SetPVarFloat(playerid, "SZ_PrevHP", prevHP);
                SetPlayerHealth(playerid, 100000.0);
                SetPlayerArmour(playerid, 100.0);
                if(GetPVarInt(playerid, "M0_2_InHospitalRevive") == 0)
                {
                        SendClientMessage(playerid, 0x00FF00FF, "| ZONA SEGURA | Has entrado al area de revive del hospital. Estas protegido.");
                        SetPVarInt(playerid, "M0_2_InHospitalRevive", 1);
                }
                return 1;
        }
        return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
        // FIX AUDIT HQSAFE: al salir, restaurar HP previo (no forzar 100) y resetear armour
        new Float:prevHP = GetPVarFloat(playerid, "SZ_PrevHP");
        if(prevHP <= 0.0 || prevHP > 100.0) prevHP = 100.0; // fallback
        // FIX AUDIT AC-H4 (WARN-2 fix): solo resetear HP/armour si el jugador realmente
        // tenia proteccion (SZ_PrevHP estaba seteado). Si SZ_PrevHP no esta seteado,
        // el jugador era un no-miembro que no recibio proteccion al entrar (fix AC-H4),
        // asi que NO debemos resetear su HP/armour (causaria free heal o perdida de armour).
        new bool:hadProtection = (GetPVarType(playerid, "SZ_PrevHP") != 0);
        // FIX P0-5: HQ Policia Nacional - salir de zona segura
        if(areaid == AreaHQ_Policia)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_5_InHQ", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ de Policia Nacional. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_Transito)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "T0_2_InHQTransito", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ de Transito. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_FBI)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_FBI1_InHQFBI", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ del FBI. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_SWAT)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_SWAT1_InHQSWAT", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ del SWAT. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_Ejercito)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_EJ1_InHQEJ", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ del Ejercito. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_Reporteros)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_REP2_InHQREP", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del HQ de Reporteros. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHQ_Bennys)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "P0_BEN_ZS_InHQ", 0);
                // FIX AUDIT AC-H4: tambien resetear P0_BEN_ZS_InArea (no-miembros).
                DeletePVar(playerid, "P0_BEN_ZS_InArea");
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del taller de Bennys. Ya no estas protegido.");
                return 1;
        }
        if(areaid == AreaHospital_SafeZone)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "M0_2_InHospital", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del Hospital Central. Ya no estas protegido.");
                return 1;
        }
        // FIX AUDIT MEDICO A3-HIGH-02: leave de zona segura area de revive.
        if(areaid == AreaHospitalRevive_SafeZone)
        {
                if(hadProtection) { SetPlayerHealth(playerid, prevHP); SetPlayerArmour(playerid, 0.0); DeletePVar(playerid, "SZ_PrevHP"); }
                SetPVarInt(playerid, "M0_2_InHospitalRevive", 0);
                SendClientMessage(playerid, 0xFFAA00FF, "| ZONA SEGURA | Has salido del area de revive del hospital. Ya no estas protegido.");
                return 1;
        }
        return 1;
}

// =====================================================================
// FIN FIX P0-5
// =====================================================================

// =====================================================================
// T2-1: COMANDOS PROPIOS DE TRANSITO (Org 2)
// =====================================================================

// ---------------------------------------------------------------------
// /control: inicia un control de trafico en la posicion del oficial.
// Crea un checkpoint visual de 10m que dura 60 segundos.
// Avisa por radio departamental que hay control activo.
// Solo Transito (Org 2) en servicio.
// ---------------------------------------------------------------------
CMD:control(playerid)
{
        if(PlayerInfo[playerid][Org] != 2) return ErrorMsg(playerid, "Comando exclusivo de Transito.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en servicio.");
        // Cooldown de 60s entre controles
        new lastControl = GetPVarInt(playerid, "T2_1_ControlCD");
        new now = gettime();
        if(now - lastControl < 60) return ErrorMsg(playerid, "Debes esperar 60s entre controles.");
        SetPVarInt(playerid, "T2_1_ControlCD", now);
        // Crear checkpoint visual
        new Float:X, Float:Y, Float:Z;
        GetPlayerPos(playerid, X, Y, Z);
        SetPlayerCheckpoint(playerid, X, Y, Z, 10.0);
        // Aviso por radio departamental
        new zone[MAX_ZONE_NAME];
        GetPlayer2DZone2(playerid, zone, sizeof(zone));
        new msg[180];
        format(msg, sizeof(msg), "{FFFFFF}[{FF6347}DEP{FFFFFF}] {FFFF00}%04d{FFFFFF}: {FF8C00}CONTROL DE TRANSITO en %s{FFFFFF}. Detenganse los vehiculos.", PlayerInfo[playerid][IDF], zone);
        SendRadioMessage(0xFF8C00FF, msg);
        // Animacion de senalizacion
        ApplyAnimation(playerid, "POLICE", "CopTaze_Cop", 4.1, 0, 1, 1, 0, 0, 1);
        // Programar remocion del checkpoint en 60s
        SetTimerEx("QuitarControlTransito", 60000, false, "i", playerid);
        SuccesMsg(playerid, "Control de transito iniciado (60 segundos). Checkpoint visible.");
        return 1;
}
forward QuitarControlTransito(playerid);
public QuitarControlTransito(playerid)
{
        if(IsPlayerConnected(playerid)) DisablePlayerCheckpoint(playerid);
        return 1;
}

// =====================================================================
// ALIAS: /multatransito es un alias de /multartransito (sin la 'r').
// Llama a la misma logica. Correccion ortografica aceptada por los usuarios.
// =====================================================================
CMD:multatransito(playerid, params[]) return cmd_multartransito(playerid, params);

// ---------------------------------------------------------------------
// /multartransito [id] [cantidad $]: multa al jugador con ID especificado.
// Suma puntos a la licencia (1 punto/$500, max 6). A los 12 puntos,
// la licencia del vehiculo que conduce se CANCELA.
// Solo Transito (Org 2) en servicio.
// ---------------------------------------------------------------------
CMD:multartransito(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 2) return ErrorMsg(playerid, "Comando exclusivo de Transito.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en servicio.");
        new targetID, cantidad;
        if(sscanf(params, "ii", targetID, cantidad)) return ErrorMsg(playerid, "Uso: /multartransito [ID] [cantidad $]. El ID es el numero de TAB (ej: 1001).");
        if(cantidad < 100 || cantidad > 10000) return ErrorMsg(playerid, "Cantidad invalida ($100 - $10,000).");
        // Buscar slot por ID (mismo sistema que /verlicencia, /licencia, /ir)
        new id = -1;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
                {
                        id = i;
                        break;
                }
        }
        if(id == -1)
        {
                new errNoConn[160];
                format(errNoConn, sizeof(errNoConn), "Jugador no conectado. El ID es el numero de TAB (ej: 1001). Tu ID es: %d.", PlayerInfo[playerid][IDF]);
                return ErrorMsg(playerid, errNoConn);
        }
        if(!IsPerto(playerid, id)) return ErrorMsg(playerid, "No estas cerca del jugador.");
        // Calcular puntos (1 punto por cada $500 de multa, min 1, max 6)
        new puntos = cantidad / 500;
        if(puntos < 1) puntos = 1;
        if(puntos > 6) puntos = 6;
        // Aplicar multa
        PlayerInfo[id][pMultas] += cantidad;
        // Sumar puntos a PVar (acumulador de puntos de licencia)
        new puntosActuales = GetPVarInt(id, "T2_1_PuntosLicencia") + puntos;
        SetPVarInt(id, "T2_1_PuntosLicencia", puntosActuales);
        // Animacion
        ApplyAnimation(playerid, "POLICE", "CopTaze_Cop", 4.1, 0, 1, 1, 0, 0, 1);
        // Mensajes
        new msg[200];
        format(msg, sizeof(msg), "Multaste a %s (ID %d) por $%d (%d puntos). Total puntos licencia: %d/12", Name(id), PlayerInfo[id][IDF], cantidad, puntos, puntosActuales);
        SuccesMsg(playerid, msg);
        format(msg, sizeof(msg), "El oficial de Transito %s te multo por $%d. Puntos: +%d (total: %d/12).", Name(playerid), cantidad, puntos, puntosActuales);
        InfoMsg(id, msg);
        // Si llega a 12 puntos, CANCELAR licencia (debe sacar nueva en Escuela de Conduccion)
        if(puntosActuales >= 12)
        {
                CancelarLicenciaConducir(id);
                SendClientMessage(id, 0xFF0000FF, "| TRANSITO | Tu licencia de conducir fue CANCELADA por acumular 12 puntos.");
                SendClientMessage(id, 0xFF8C00FF, "| TRANSITO | Debes ir a la Escuela de Conduccion a sacar una nueva licencia haciendo el examen.");
                format(msg, sizeof(msg), "Licencia de %s (ID %d) CANCELADA (12 puntos acumulados).", Name(id), PlayerInfo[id][IDF]);
                SuccesMsg(playerid, msg);
        }
        // Log
        new logMT[200];
        format(logMT, sizeof(logMT), "[MULTARTRANSITO] Oficial %s (ID %d) -> %s (ID %d): $%d, %d puntos.", Name(playerid), PlayerInfo[playerid][IDF], Name(id), PlayerInfo[id][IDF], cantidad, puntos);
        Log("Logs/AdminAcciones.ini", logMT);
        return 1;
}

// ---------------------------------------------------------------------
// /retirarlicencia [id]: CANCELA la licencia del vehiculo que conduce
// el jugador con ID especificado. Si no esta conduciendo, cancela TODAS.
// El jugador debe ir a la Escuela de Conduccion a sacar una nueva.
// Solo Transito (Org 2) cargo >= 2 (Oficial o superior).
// ---------------------------------------------------------------------
CMD:retirarlicencia(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 2) return ErrorMsg(playerid, "Comando exclusivo de Transito.");
        if(PlayerInfo[playerid][Cargo] < 2) return ErrorMsg(playerid, "Necesitas ser Oficial o superior.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en servicio.");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "Uso: /retirarlicencia [ID]. El ID es el numero de TAB (ej: 1001).");
        // Buscar slot por ID (mismo sistema que /verlicencia, /licencia, /ir)
        new id = -1;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
                {
                        id = i;
                        break;
                }
        }
        if(id == -1)
        {
                new errNoConn[160];
                format(errNoConn, sizeof(errNoConn), "Jugador no conectado. El ID es el numero de TAB (ej: 1001). Tu ID es: %d.", PlayerInfo[playerid][IDF]);
                return ErrorMsg(playerid, errNoConn);
        }
        if(!IsPerto(playerid, id)) return ErrorMsg(playerid, "No estas cerca del jugador.");
        // CANCELAR licencia (selectiva: solo la del vehiculo que conduce, o la MAS BARATA si esta a pie)
        // FIX AUDIT-AUDIT6-VRF1-001 (BAJO): comentario actualizado - antes cancelaba TODAS las licencias on-foot,
        // ahora solo cancela 1 (la mas barata que tenga). Ver CON-CRIT-003 / CancelarLicenciaConducir.
        CancelarLicenciaConducir(id);
        // Mensajes
        new msg[180];
        format(msg, sizeof(msg), "Le CANCELASTE la licencia de conducir a %s (ID %d). Debe sacar nueva en Escuela de Conduccion.", Name(id), PlayerInfo[id][IDF]);
        SuccesMsg(playerid, msg);
        format(msg, sizeof(msg), "El oficial de Transito %s te CANCELO la licencia de conducir.", Name(playerid));
        InfoMsg(id, msg);
        SendClientMessage(id, 0xFF8C00FF, "| TRANSITO | Debes ir a la Escuela de Conduccion a sacar una nueva licencia haciendo el examen.");
        // Log
        new logRL[180];
        format(logRL, sizeof(logRL), "[RETIRARLICENCIA] Oficial %s (ID %d) -> %s (ID %d): licencia CANCELADA.", Name(playerid), PlayerInfo[playerid][IDF], Name(id), PlayerInfo[id][IDF]);
        Log("Logs/AdminAcciones.ini", logRL);
        return 1;
}

// ---------------------------------------------------------------------
// /verlicencia [id]: el oficial de Transito revisa los puntos y estado
// de las licencias del jugador objetivo. Funciona igual que /licencia [id].
// Muestra: puntos acumulados (X/12), licencias en inventario, vehiculo
// actual y multas.
// Solo Transito (Org 2) en servicio.
// ---------------------------------------------------------------------
CMD:verlicencia(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 2) return ErrorMsg(playerid, "Comando exclusivo de Transito.");
        if(Patrulha[playerid] == false) return ErrorMsg(playerid, "No estas en servicio.");
        new targetID;
        if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "Uso: /verlicencia [ID]. Tu propio ID es el que ves en TAB (ej: 1001, 1002...).");
        // Buscar slot por ID (mismo sistema que /licencia, /ir, /kick)
        new id = -1;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
                {
                        id = i;
                        break;
                }
        }
        if(id == -1)
        {
                new errNoConn[160];
                format(errNoConn, sizeof(errNoConn), "Jugador no conectado. El ID es el numero de 4 digitos que ves en TAB (ej: 1001). Tu ID es: %d.", PlayerInfo[playerid][IDF]);
                return ErrorMsg(playerid, errNoConn);
        }
        if(!IsPerto(playerid, id)) return ErrorMsg(playerid, "No estas cerca del jugador.");
        // FIX AUDIT4 HIGH-DBG-3: debug SendClientMessage eliminado del comando de licencias
        // new debugMsg[128];
        // format(debugMsg, sizeof(debugMsg), "DEBUG: Buscando IDF %d -> encontrado slot %d (nombre: %s)", targetID, id, Name(id));
        // SendClientMessage(playerid, 0xAAAAAAFF, debugMsg);
        new puntos = GetPVarInt(id, "T2_1_PuntosLicencia");
        new str[512];
        format(str, sizeof(str), "{FFFFFF}Titular: {FFFF00}%s {FFFFFF}(ID: {FFFF00}%04d{FFFFFF})\n\n", Name(id), PlayerInfo[id][IDF]);
        new strPuntos[80];
        if(puntos >= 9) format(strPuntos, sizeof(strPuntos), "{FF0000}%d/12{FFFFFF} (PELIGRO: proxima cancelacion)\n", puntos);
        else if(puntos >= 6) format(strPuntos, sizeof(strPuntos), "{FF8C00}%d/12{FFFFFF} (riesgo)\n", puntos);
        else format(strPuntos, sizeof(strPuntos), "{00FF00}%d/12{FFFFFF}\n", puntos);
        strcat(str, strPuntos);
        strcat(str, "{FFFFFF}Licencias de conduccion:\n");
        // DEBUG: test individual con mensaje
        new chkMoto = CheckInventario2(id, 1853);
        new chkAuto = CheckInventario2(id, 1854);
        new chkCamion = CheckInventario2(id, 1855);
        new chkTrail = CheckInventario2(id, 19857);
        new chkAerea = CheckInventario2(id, 1856);
        // FIX AUDIT4 HIGH-DBG-3: debug SendClientMessage eliminado del comando de licencias
        // new dbg2[200];
        // format(dbg2, sizeof(dbg2), "DEBUG CheckInventario2(slot=%d): Moto=%d Auto=%d Camion=%d Trail=%d Aerea=%d", id, chkMoto, chkAuto, chkCamion, chkTrail, chkAerea);
        // SendClientMessage(playerid, 0xAAAAAAFF, dbg2);
        if(chkMoto)    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. A  - Moto\n");
        else           strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. A  - Moto\n");
        if(chkAuto)    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. B  - Automovil\n");
        else           strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. B  - Automovil\n");
        if(chkCamion)  strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. C  - Camion\n");
        else           strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. C  - Camion\n");
        if(chkTrail)   strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. E  - Trailero\n");
        else           strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. E  - Trailero\n");
        if(chkAerea)   strcat(str, "  {00FF00}[[v]] {FFFFFF}Aerea   - Piloto\n");
        else           strcat(str, "  {FF4444}[[x]] {AAAAAA}Aerea   - Piloto\n");
        if(IsPlayerInAnyVehicle(id) && GetPlayerState(id) == PLAYER_STATE_DRIVER)
        {
                new vehModel = GetVehicleModel(GetPlayerVehicleID(id));
                new licReq = GetLicenciaByVehicle(vehModel);
                new licName[24];
                switch(licReq)
                {
                        case 1853:  licName = "Moto (Cat. A)";
                        case 1854:  licName = "Auto (Cat. B)";
                        case 1855:  licName = "Camion (Cat. C)";
                        case 19857: licName = "Trailero (Cat. E)";
                        case 1856:  licName = "Aerea (Cat. D)";
                        default:    licName = "Sin licencia requerida";
                }
                new strVeh[160];
                if(licReq > 0)
                {
                        new tiene = CheckInventario2(id, licReq);
                        format(strVeh, sizeof(strVeh), "\n{FFFF00}Conduciendo ahora:{FFFFFF} Modelo %d\nRequiere: %s - %s\n", vehModel, licName, tiene ? ("{00FF00}[LICENCIA OK]") : ("{FF0000}[SIN LICENCIA - INFRACCION]"));
                }
                else
                {
                        format(strVeh, sizeof(strVeh), "\n{FFFF00}Conduciendo ahora:{FFFFFF} Modelo %d (sin licencia requerida)\n", vehModel);
                }
                strcat(str, strVeh);
        }
        new strMultas[80];
        format(strMultas, sizeof(strMultas), "\n{FFFF00}Multas acumuladas:{FFFFFF} $%d\n", PlayerInfo[id][pMultas]);
        strcat(str, strMultas);
        ShowPlayerDialog(playerid, 9993, DIALOG_STYLE_MSGBOX, "Ver Licencia - Transito", str, "Cerrar", #);
        return 1;
}

// =====================================================================
// FIN T2-1 COMANDOS TRANSITO
// =====================================================================

// =====================================================================
// Comando /miid: muestra tu ID (IDF) y tu slot para diagnostico.
// Util para saber que ID usar en comandos como /verlicencia, /ir, etc.
// =====================================================================
CMD:miid(playerid)
{
        new str[512];
        new licStr[256];
        licStr = temlicenca(playerid);
        format(str, sizeof(str), "{FFFF00}=== Tu Identificacion ===\n\n{FFFFFF}Nombre: {00FF00}%s\n{FFFFFF}Tu ID (usar en comandos): {FF0000}%d\n{FFFFFF}Slot interno: %d\n\n{FFFF00}Licencias:{FFFFFF} %s\n\n{AAAAAA}Usa el ID resaltado en rojo en todos los comandos:\n/verlicencia %d\n/multartransito %d [cantidad]\n/retirarlicencia %d",
                Name(playerid), PlayerInfo[playerid][IDF], playerid, licStr,
                PlayerInfo[playerid][IDF], PlayerInfo[playerid][IDF], PlayerInfo[playerid][IDF]);
        ShowPlayerDialog(playerid, 9994, DIALOG_STYLE_MSGBOX, "Mi ID", str, "Cerrar", #);
        return 1;
}

