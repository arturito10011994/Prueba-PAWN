CallBack:: LockpickTimer(playerid)
{
        LockProgress[playerid] = LockProgress[playerid]+4, PlayerTextDrawTextSize(playerid, LockText[playerid][9], LockProgress[playerid], 71.0);
        for(new i; i < 12; i++) 
        { 
                PlayerTextDrawShow(playerid, LockText[playerid][i]);
                if(i == 12)break; 
        }
        if(LockCount[playerid] < 4 && LockProgress[playerid] > 428.9) return PlayerTextDrawColor(playerid, LockText[playerid][LockCount[playerid]+2], 0xFF0000AA), DestroyLockPick(playerid), KillTimer(LockTimer[playerid]), LockCount[playerid]++, LockProgress[playerid] = 207.0, CreateLocPick(playerid);
        if(LockCount[playerid] == 4 && LockProgress[playerid] > 428.9)
        {
                PlayerTextDrawColor(playerid, LockText[playerid][LockCount[playerid]+2], 0xFF0000AA), PlayerTextDrawShow(playerid, LockText[playerid][LockCount[playerid]+2]), SetTimerEx("DestroyLockPick", 2000, false, "i", playerid), KillTimer(LockTimer[playerid]);
        if(Correct[playerid] != 3) return SetVehicleParamsEx(VehicleLockedID[playerid], Engine[playerid], Lights[playerid], 1, DoorsLockPick[playerid], Bonnet[playerid], Boot[playerid], Objective[playerid]), InfoMsg(playerid, "No lograste forzar la cerradura y activaste la alarma");
                if(DoorsLockPick[playerid] == 0) return SetVehicleParamsEx(VehicleLockedID[playerid], Engine[playerid], Lights[playerid], Alarm[playerid], 1, Bonnet[playerid], Boot[playerid], Objective[playerid]), InfoMsg(playerid, "A lockpick quebrou!"), Correct[playerid] = 0;
                SetVehicleParamsEx(VehicleLockedID[playerid], Engine[playerid], Lights[playerid], 1, 0, Bonnet[playerid], Boot[playerid], Objective[playerid]), SuccesMsg(playerid, "El vehiculo fue abierto! La alarma se activo."), Correct[playerid] = 0;
        }
        return 1;
}
CallBack:: DestroyLockPick(playerid)
{
    PlayerTextDrawDestroy(playerid, LockText[playerid][8]), PlayerTextDrawDestroy(playerid, LockText[playerid][9]), PlayerTextDrawDestroy(playerid, LockText[playerid][10]);
    if(LockCount[playerid] == 4)
    {
                PlayerTextDrawColor(playerid, LockText[playerid][2], 1768516095), PlayerTextDrawColor(playerid, LockText[playerid][3], 1768516095), PlayerTextDrawColor(playerid, LockText[playerid][4], 1768516095), PlayerTextDrawColor(playerid, LockText[playerid][5], 1768516095), PlayerTextDrawColor(playerid, LockText[playerid][6], 1768516095);
                LockUse[playerid] = false, LockProgress[playerid] = 207.0, Correct[playerid] = 0, LockCount[playerid] = 0;
                for(new i; i < 12; i++) 
                { 
                        PlayerTextDrawHide(playerid, LockText[playerid][i]); 
                        if(i == 12)break;
                }
        }
        return 0;
}

CallBack::TimerAn()
{
        foreach(new i : Player)
        {
            if(TiempoAnuncio[i] > 0) TiempoAnuncio[i] --;
            // FIX AUDIT PRENSA: decrementar cooldowns de reporteros
            if(GetPVarInt(i, "EntrevistaCooldown") > 0) SetPVarInt(i, "EntrevistaCooldown", GetPVarInt(i, "EntrevistaCooldown") - 1);
            if(GetPVarInt(i, "TransmisionCooldown") > 0) SetPVarInt(i, "TransmisionCooldown", GetPVarInt(i, "TransmisionCooldown") - 1);
        }
        return true;
}
XP_::XP_Hide(playerid)
{
    // FIX CRIT-XP-005 (CRITICO): guard de conexion + reset timer ID.
    // ANTES: sin guard. Si el jugador desconectaba antes de 5s, el callback dispara sobre
    // slot reusado (PlayerTextDrawHide sobre XPTXD del nuevo jugador + sonido 6402 random).
    if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
    g_XPHideTimer[playerid] = -1; // reset timer ID (ya disparo)
    // FIX MED-XP-001: usar sizeof XPTXD[] en vez de hardcoded 20.
    // FIX MED-XP-002: eliminado dead code `if(i == 20)break;` (nunca se ejecuta, i < 20).
    for(new i; i < sizeof XPTXD[]; i++)
    {
        PlayerTextDrawHide(playerid, XPTXD[playerid][i]);
    }
    // FIX ALTO-XP-004: respetar TEXT_SOUND_DEFAULT como darxp respetaba TEXT_SOUND_DEFAULT
    #if TEXT_SOUND_DEFAULT == true
    PlayerPlaySound(playerid, 6402, 0.0, 0.0, 0.0);
    #endif
    return 1; // FIX WARN-XP-001: function "XP_Hide" should return a value
}

CallBack::DesmancharVeh(playerid, progress)
{
                // FIX AUDIT 5P: validar que el jugador sigue conectado y que el desmantelamiento sigue en curso
                // (previene slot-reuse exploit)
                if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
                if(GetPVarInt(playerid, "DesmancharEnCurso") != 1) return 0;
                DeletePVar(playerid, "DesmancharEnCurso");
                DeletePVar(playerid, "DesmancharTimerID");
                new sampVehID = GetPlayerVehicleID(playerid);          // ID nativo SA-MP
                new internalVehID = GetVehicleID(sampVehID);           // ID interno del sistema
                new model = GetVehicleModel(sampVehID);               // Modelo del vehiculo

                // P0-MOTO-FIX: calcular valor del vehiculo correctamente.
                // Antes: usaba GetPVarInt(playerid, "DialogValue1") que solo se seteaba
                // al abrir el dialogo del vehiculo. Si el jugador no lo abria, daba $0.
                // Ahora: busca el ID interno con GetVehicleID() y usa VehicleValue.
                // Si el vehiculo no esta en el sistema (temporal/spawneado), usa valor por modelo.
                new value = 0;
                if(internalVehID > 0 && VehicleValue[internalVehID] > 0)
                {
                        value = VehicleValue[internalVehID] / 3;
                }
                else
                {
                        // Valor minimo por modelo para vehiculos temporales/no registrados
                        // Evita que el desmantelamiento de $0
                        switch(model)
                        {
                                case 400..410: value = 5000;   // autos baratos
                                case 411..430: value = 8000;   // autos medios
                                case 431..450: value = 6000;   // utilitarios
                                case 451..470: value = 12000;  // autos deportivos/militares
                                case 471..500: value = 7000;   // motos/quad
                                case 501..520: value = 9000;   // aviones/helis
                                case 521..540: value = 10000;  // motos deportivas
                                case 541..560: value = 15000;  // autos alto rendimiento
                                case 561..580: value = 8000;   // autos varios
                                case 581..600: value = 6000;   // motos/ciclomotores
                                case 601..611: value = 10000;  // vehiculos especiales
                                default: value = 5000;         // fallback minimo
                        }
                        value = value / 3;
                }

                new a[255];
                new noti = randomEx(0, 2);
                format(a, 255, "Vehiculo desmantelado y ganaste %s de dinero sucio", ConvertMoney(value));
                SuccesMsg(playerid, a);
                new location[MAX_ZONE_NAME];
                GetPlayer2DZone2(playerid, location, MAX_ZONE_NAME);
                if(noti == 1)
                {
                        foreach(new i : Player)
                        {
                                if(Patrulha[i] == true)
                                {
                                        format(Str, sizeof(Str), "Un ciudadano acaba de denunciar a alguien desmantelando un vehiculo en %s", location);
                                        WarningMsg(i, Str);
                                }
                        }
                }
                GanharItem(playerid, 1212, value);
                RemovePlayerFromVehicle(playerid);
                // [DEAL-FASE1] FIX CRIT-1 (DEAL-AUD1-001): Dupe vÃƒÂ­a desmantelamiento + reinicio.
                // DesmancharVeh destruÃƒÂ­a el vehÃƒÂ­culo con DestroyVehicle() pero NO actualizaba
                // VehicleCreated[] ni llamaba SaveVehicle(). Al reiniciar, el vehÃƒÂ­culo reaparecÃƒÂ­a
                // porque el .ini seguÃƒÂ­a con Created=1, permitiendo explotar el ciclo infinito:
                //   1) cancelar diÃƒÂ¡logo de compra para conducir vehÃƒÂ­culo de concesionaria,
                //   2) llevarlo al punto de desmantelamiento,
                //   3) obtener dinero sucio por VehicleValue/3,
                //   4) reiniciar el servidor -> el vehÃƒÂ­culo reaparece en la concesionaria,
                //      listo para repetir el ciclo.
                // Fix: marcar como destruido en memoria, persistir Created=0 al .ini y limpiar fuel.
                if(internalVehID > 0)
                {
                        VehicleCreated[internalVehID] = 0; // marcar como destruido en memoria
                        SaveVehicle(internalVehID);       // persistir Created=0 al .ini
                        Fuel_SavePersistent(sampVehID);   // guardar fuel persistente si corresponde
                        Fuel_DestroyVehicle(sampVehID);   // limpiar estructura de fuel en memoria
                }
                DestroyVehicle(sampVehID);
                Controle(playerid, 1);
                // FASE 6: contar desmantelamiento para estadisticas de respeto
                new desmOrg = PlayerInfo[playerid][Org];
                if(IsBandido(playerid)) // FIX AUDIT FASE6 B2: usar IsBandido en vez de rango manual
                {
                    g_StatsBanda[desmOrg][sb_desmantelamientos]++;
                    StatsBandas_Guardar();
                }
                return 1; // FIX WARNING 209: faltaba return al final de la funcion
}

// =====================================================================
// P0-BEN-VEH: Sistema de remolque para Towtruck de Bennys.
// TowUpdate se ejecuta cada 200ms mientras hay vehiculos remolcando.
// Posiciona el vehiculo remolcado detras del Towtruck, siguiendo su angulo.
// =====================================================================
forward TowUpdate();
public TowUpdate()
{
        new bool:anyTowing = false;
        new Float:tx, Float:ty, Float:tz, Float:ta;
        for(new v = 1; v < MAX_VEHICLES; v++)
        {
                if(towingVehicle[v] > 0 && IsValidVehicle(v) && IsValidVehicle(towingVehicle[v]))
                {
                        anyTowing = true;
                        GetVehiclePos(v, tx, ty, tz);
                        GetVehicleZAngle(v, ta);
                        // Posicionar el vehiculo remolcado 6m detras del Towtruck
                        new Float:bx = tx - (6.0 * floatsin(ta, degrees));
                        new Float:by = ty - (6.0 * floatcos(ta, degrees));
                        SetVehiclePos(towingVehicle[v], bx, by, tz);
                        SetVehicleZAngle(towingVehicle[v], ta);
                        SetVehicleVirtualWorld(towingVehicle[v], GetVehicleVirtualWorld(v));
                }
                else if(towingVehicle[v] > 0)
                {
                        // El Towtruck o el remolcado ya no existen, limpiar
                        towingVehicle[v] = 0;
                }
        }
        // Si nadie esta remolcando, detener el timer
        if(!anyTowing && towTimerActive)
        {
                KillTimer(GetPVarInt(0, "TowTimerID"));
                DeletePVar(0, "TowTimerID");
                towTimerActive = false;
        }
        return 1;
}

CallBack::RepararVeh(playerid, progress)
{
                // FIX AUDIT10 A2-X8: prevenir slot-reuse contamination.
                if(!IsPlayerConnected(playerid)) return 1;
                new wVeiculo = GetPlayerVehicleID(playerid);
                SuccesMsg(playerid, "Vehiculo reparado.");
                RepairVehicle(wVeiculo);
                SetVehicleHealth(wVeiculo, 1000.0);
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
        return 1;
}
// FIX SPRINT3 M-27: CallBack::DescarregarCarga eliminado (dead code).
// Esta funcion (~170 lineas) NO era invocada en ningun sitio (verificado con grep:
// solo la definicion + 2 menciones en comentarios). Era remanente de una refactor
// previa que reemplazo el flujo DescarregarCarga por CamionCobro+CamionPago. Los
// payouts mostrados en el dialogo /cargar coincidian con esta funcion muerta (H-A1-02
// ya corregido en Sprint 3). Eliminada para reducir deuda tecnica y evitar confusion.

CallBack::FinCargaCamion(playerid, Float:dx, Float:dy, Float:dz, Float:radius)
{
        // FIX SPRINT1 C-06: prevenir slot-reuse contamination.
        // Antes: si el Camionero desconectaba y su slot era reusado en los 30s del timer,
        // el callback dispara sobre el nuevo jugador, setea CamionEnRuta=true y crea CP.
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 4) return 1; // debe seguir siendo Camionero
        if(!CamionCargando[playerid]) return 1; // no debe haber perdido el estado en el medio
        CamionCargando[playerid] = false;
        CamionEnRuta[playerid] = true;
        // FIX AUDIT CAMIONERO CAM-A3-04 (ALTO): no descongelar algemados (bypass de algemado).
        // Antes: si el Camionero era algemado durante los 30s de cargando, este TogglePlayerControllable(1)
        // lo descongelaba al finalizar, permitiendo escapar del arresto.
        SafeUnfreeze(playerid);  // M-04 alineado
        DisablePlayerCheckpoint(playerid);
        SetPlayerCheckpoint(playerid, dx, dy, dz, radius);
        GameTextForPlayer(playerid, "~g~Listo! Ve al destino.", 4000, 3);
        SuccesMsg(playerid, "Carga lista. Dirijase al checkpoint de entrega.");
        return 1;
}

CallBack::FinDescargaCamion(playerid)
{
        // FIX SPRINT1 C-06: prevenir slot-reuse contamination + pago fantasma.
        // Antes: si el Camionero desconectaba y su slot era reusado en los 60s del timer,
        // el callback dispara sobre el nuevo jugador, setea CamionCobro=1 + CamionPagoPendiente
        // sobre un jugador que no es Camionero. Cuando entra al CP de cobro, cobra sin serlo.
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 4) return 1; // debe seguir siendo Camionero
        if(!CamionDescargando[playerid]) return 1; // no debe haber perdido el estado en el medio
        new pay = CamionPago[playerid];
        if(PlayerInfo[playerid][pVIP] >= 1) pay *= 2;
        CamionDescargando[playerid] = false;
        Cargase[playerid] = false;
        Carregou[playerid] = 0;
        CamionEnRuta[playerid] = false;
        // FIX AUDIT CAMIONERO CAM-A3-05 (ALTO): no descongelar algemados (bypass de algemado).
        // Antes: si el Camionero era algemado durante los 60s de descargando, este TogglePlayerControllable(1)
        // lo descongelaba al finalizar, permitiendo escapar del arresto.
        SafeUnfreeze(playerid);  // M-04 alineado
        new trailerVeh = (CamionVehId[playerid] != -1) ? CamionVehId[playerid] : GetPlayerVehicleID(playerid);
        // FIX AUDIT7 BUG5: validar trailer existe antes de respawnear
        new trailerId = GetVehicleTrailer(trailerVeh);
        if(trailerId > 0 && trailerId < MAX_VEHICLES && IsValidVehicle(trailerId))
        {
                SetVehicleToRespawn(trailerId);
        }
        // FIX SPRINT1 C-07: guardar el truck original en PVar ANTES de resetear CamionVehId.
        // Antes: FinDescargaCamion reseteaba CamionVehId=-1, y el bloque CamionCobro usaba
        // el fallback GetPlayerVehicleID(playerid) que retorna CUALQUIER vehiculo del que el
        // jugador sea conductor al entrar al CP de cobro. Vector de grief masivo: Camionero
        // entra a vehiculo ajeno y lo destruye. Ahora: trackear el truck original en PVar
        // para que el cobro SIEMPRE destruya el truck correcto.
        SetPVarInt(playerid, "CamionTruckVeh", CamionVehId[playerid]);
        CamionVehId[playerid] = -1;
        // NO se da el pago aqui - se entrega en el checkpoint de cobro
        SetPVarInt(playerid, "CamionPagoPendiente", pay); // guardar pago pendiente
        new paystr[128];
        format(paystr, sizeof(paystr), "~w~Carga descargada!~n~~y~Cobro pendiente: $%d", pay);
        GameTextForPlayer(playerid, paystr, 5000, 3);
        new smsg[128];
        format(smsg, sizeof(smsg), "Carga descargada. Dirijase al punto de cobro para recibir $%d.", pay);
        SuccesMsg(playerid, smsg);
        // Activar checkpoint de cobro
        SetPlayerCheckpoint(playerid, -512.7632, -541.0153, 25.5234, 5.0);
        SetPVarInt(playerid, "CamionCobro", 1);
        return 1;
}

CallBack::CamionTimerCB(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1; // FIX AUDIT7 CS-05: condicion invertida
        // FIX SPRINT3 M-28: validar pProfissao + CamionVehId asignado antes de actuar.
        // Antes: si el Camionero desconectaba y su slot era reusado por un nuevo jugador,
        // este timer (3min desde VerificarTeste) dispara sobre el nuevo slot. Aunque
        // IsPlayerConnected=true, el nuevo jugador podria no ser Camionero y heredar el
        // reset de CamionVehId/Cargase/etc. AHORA: solo actuar si sigue siendo Camionero.
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 4) return 1;
        new veh = CamionVehId[playerid];
        if(veh != -1 && IsValidVehicle(veh)) SetVehicleToRespawn(veh);
        CamionVehId[playerid] = -1;
        Cargase[playerid] = false;
        Carregou[playerid] = 0;
        CamionEnRuta[playerid] = false;
        CamionCargando[playerid] = false;
        CamionDescargando[playerid] = false;
        CamionReconTmr[playerid] = -1;
        return 1;
}

forward VanSinRepartidor(playerid);
public VanSinRepartidor(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        // FIX AUDIT CORREOS A4-01 + A3-01: delegar todo el cleanup a Correos_FlushPlayer.
        // Antes: este callback hacia reset manual de ~9 variables + 2 PVars + actor + label,
        // PERO olvidaba: VehAlugado (soft-lock post-flush), PegouVehProf, g_LastDriverVeh,
        // CajaMao, checkcasa, PegandoCajas, EntregaDistTotal, EntregaPosUltX/Y,
        // 4 PVars de cobro (EntregaPagoPendiente, EntregaFinalCP, EntregaDistPendiente,
        // EntregaCajasPendiente), y los 5 timer IDs de progreso.
        // Eso permitia state leak y cobro en CP incorrecto (NO duplicacion de dinero).
        // Ahora: una sola llamada centralizada garantiza cleanup completo y consistente.
        Correos_FlushPlayer(playerid);
        ErrorMsg(playerid, "Tu furgoneta fue destruida por inactividad. Selecciona un nuevo vehiculo.");
        return 1;
}

CallBack::BotouBau(playerid, progress)
{
                // FIX SPRINT1 C-06: prevenir slot-reuse contamination.
                // Antes: si el Recolector desconectaba y su slot era reusado en los 10s
                // del timer BotouBau, el callback dispara sobre el nuevo jugador y le
                // entrega dinero + setea PegouLixo=false sin que hubiese recogido basura.
                if(!IsPlayerConnected(playerid)) return 1;
                if(!pLogado[playerid]) return 1;
                if(PlayerInfo[playerid][pProfissao] != 6) return 1; // debe seguir siendo Recolector
                if(!PegouLixo[playerid]) return 1; // debe tener basura en mano
                // FIX AUDIT RECOLECTOR: reset timer ID al ejecutar el callback.
                g_BotouBauTmr[playerid] = -1;
                // MEJORA RECOLECTOR #7: sistema de niveles - novato <3h: $5-25, experto >3h: $15-75.
                new pagoMin, pagoMax;
                if(PlayerInfo[playerid][pSegundosJogados] < RECOLECTOR_NOVATO_HORAS)
                {
                        pagoMin = 5; pagoMax = 25;  // Novato
                }
                else
                {
                        pagoMin = 15; pagoMax = 75; // Experto
                }
                new dincova = randomEx(pagoMin, pagoMax);
                // MEJORA RECOLECTOR #8: racha - 10 basuras seguidas = +50% bonus.
                g_RecolectorRacha[playerid]++;
                if(g_RecolectorRacha[playerid] % RECOLECTOR_RACHA_LIMITE == 0)
                {
                        dincova = floatround(dincova * 1.5);
                }
                new covastr[255];
                new pagoFinal = (PlayerInfo[playerid][pVIP] >= 1) ? dincova * 2 : dincova;
                AC_AddPlayerMoney(playerid, pagoFinal);
                // Mensaje detallado con desglose.
                format(covastr, sizeof(covastr), "Ganaste $%i por esta basura. (VIP x2: %s, Racha: %d/10)",
                        pagoFinal,
                        (PlayerInfo[playerid][pVIP] >= 1) ? ("Si") : ("No"),
                        g_RecolectorRacha[playerid] % RECOLECTOR_RACHA_LIMITE);
                SuccesMsg(playerid, covastr);
                if(g_RecolectorRacha[playerid] % RECOLECTOR_RACHA_LIMITE == 0)
                {
                        GameTextForPlayer(playerid, "~g~RACHA DE BASURA!~n~~w~Bonus +50%%!", 3000, 5);
                }
                else
                {
                        GameTextForPlayer(playerid, "~g~Basura depositada!~n~~w~Cobro recibido", 3000, 5);
                }
                RemovePlayerAttachedObject(playerid, 7); // FIX SPRINT2 H-A4-01: slot 7 (basura Recolector migrada de slot 5)
                ClearAnimations(playerid);
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                PegouLixo[playerid] = false;
                // MEJORA RECOLECTOR #9: cooldown variable por nivel (novato 5s, experto 3s).
                new cooldownRec = (PlayerInfo[playerid][pSegundosJogados] < RECOLECTOR_NOVATO_HORAS) ? RECOLECTOR_COOLDOWN_NOVATO : RECOLECTOR_COOLDOWN_EXPERTO;
                SetTimerEx("ExpireAntComannd", cooldownRec * 1000, false, "i", playerid);
                // FIX AUDIT2 AGENT2 M-25: SalvarDados para persistir payout de truck job
                // (recoleccion de basura - VIP y no-VIP - 2 sitios cubiertos).
                SalvarDados(playerid);
        return 1;
}
CallBack::Cova(playerid, progress)
{
                // FIX SPRINT1 C-06: prevenir slot-reuse contamination.
                // Antes: si el Recolector desconectaba y su slot era reusado en los 10s
                // del timer Cova, el callback dispara sobre el nuevo jugador y le attacha
                // un objeto de basura visual + setea PegouLixo=true.
                if(!IsPlayerConnected(playerid)) return 1;
                if(!pLogado[playerid]) return 1;
                if(PlayerInfo[playerid][pProfissao] != 6) return 1; // debe seguir siendo Recolector
                if(!Covaconcerto[playerid]) return 1; // no debe tener un Cova pendiente ya procesado
                // FIX AUDIT RECOLECTOR: reset timer ID al ejecutar el callback.
                g_CovaTmr[playerid] = -1;
                // FIX SPRINT1 C-05: random(sizeof) + default.
                // Antes: random(10) retornaba 0..9 (10 valores) pero el switch tenia 11 cases (0..10).
                // Case 10 era DEAD CODE (nunca alcanzable) - las coordenadas (18.442813, 1334.873413)
                // nunca se entregaban. Ademas faltaba default para resiliencia.
                // Ahora: random(11) hace case 10 alcanzable. Default vuelve a caso 0 como fallback.
                new locallixo = random(11);
                switch(locallixo){
                        case 0:{
                                SetPlayerCheckpoint(playerid, 24.118854, 1384.762695, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 1:{
                                // FIX REC-VERIFY PROB-02: case 1 usaba mismas coords que case 0 (sobre-representacion).
                                // Ahora usa coords unicas (Bote 1 = 20.505460, 1387.800292).
                                SetPlayerCheckpoint(playerid, 20.505460, 1387.800292, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 2:{
                                SetPlayerCheckpoint(playerid, 20.505460, 1387.800292, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 3:{
                                SetPlayerCheckpoint(playerid, 33.100147, 1348.264160, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 4:{
                                SetPlayerCheckpoint(playerid, 30.621374, 1345.285400, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 5:{
                                SetPlayerCheckpoint(playerid, 28.793310, 1342.226318, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 6:{
                                SetPlayerCheckpoint(playerid, 27.303512, 1339.422729, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 7:{
                                SetPlayerCheckpoint(playerid, 26.155256, 1337.490844, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 8:{
                                SetPlayerCheckpoint(playerid, 23.932958, 1336.910034, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 9:{
                                SetPlayerCheckpoint(playerid, 21.434928, 1335.923828, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        case 10:{
                                SetPlayerCheckpoint(playerid, 18.442813, 1334.873413, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                        default:{
                                SetPlayerCheckpoint(playerid, 24.118854, 1384.762695, 9.171875, 3.0);
                                InfoMsg(playerid, "Lleva la basura al bote.");
                        }
                }
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                // FIX SPRINT2 H-A4-01: migrado de slot 5 a slot 7.
                // Antes: SLOT 5 se usaba simultaneamente para basura (Recolector, 1265)
                // y algemas (policia, 19418). Si un Recolector con basura en mano era
                // algemado, las algemas SOBREESCRIBEN la basura. Cuando BotouBau dispara
                // (10s), RemovePlayerAttachedObject(slot 5) elimina las ALGEMAS y
                // TogglePlayerControllable(1) DESCONGELA al preso. Vector de escape
                // de custodia. Ahora: basura en slot 7 (libre), algemas siguen en slot 5.
                SetPlayerAttachedObject(playerid, 7, 1265, 5);
                PegouLixo[playerid] = true;
                Covaconcerto[playerid] = false;
        return 1;
}

CallBack::Desossar(playerid, progress)
{
                // FIX AUDIT CARNICERO CA-A1-01/A2-01/A2-04/A4-03: guards completos.
                if(!IsPlayerConnected(playerid)) return 1;
                if(!pLogado[playerid]) return 1;
                if(PlayerInfo[playerid][pProfissao] != 3) { UsouCMD[playerid] = false; g_DesossarTmr[playerid] = -1; return 1; }
                if(PlayerInfo[playerid][pCongelado]) { UsouCMD[playerid] = false; g_DesossarTmr[playerid] = -1; return 1; }
                // FIX AUDIT CARNICERO CA-A2-01: validar que el timer estaba activo y Desossando==0.
                if(g_DesossarTmr[playerid] == -1) return 1; // timer no activo
                if(Desossando[playerid] != 0) { g_DesossarTmr[playerid] = -1; return 1; } // ya esta en proceso
                // FIX AUDIT CARNICERO C-A1-03: marcar timer como completado.
                g_DesossarTmr[playerid] = -1;
                ApplyAnimation(playerid, "BSKTBALL", "BBALL_pickup", 4.0, 0, 1, 1, 0, 0, 1);
                // FIX AUDIT ANIM ANIM-A4-19 (MEDIO): check pCongelado antes de CARRY.
                if(!PlayerInfo[playerid][pCongelado])
                        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
                SetPlayerAttachedObject(playerid, 1, 2804, 5, 0.044377, 0.029049, 0.161334, 265.922912, 9.904896, 21.765972, 0.500000, 0.500000, 0.500000);
                Desossando[playerid] = 1;
                UsouCMD[playerid] = false;
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                InfoMsg(playerid, "Terminaste de deshuesar la carne, haz el procesamiento.");
        return 1;
}
CallBack::Minerar(playerid, progress)
{
                // FIX AUDIT10 A2-X6 + AUDIT MINERO M-A1-02: prevenir slot-reuse contamination.
                // Antes: solo IsPlayerConnected. Ahora: tambien pLogado y pProfissao==2.
                if(!IsPlayerConnected(playerid)) return 1;
                if(!pLogado[playerid]) return 1;
                // FIX AUDIT MINERO M-A1-02: validar que sigue siendo Minero.
                if(PlayerInfo[playerid][pProfissao] != 2) { UsouCMD[playerid] = false; return 1; }
                // FIX AUDIT MINERO M-A1-01: marcar timer como completado (se ejecuto).
                g_MinerarTmr[playerid] = -1;
                // FIX SPRINT3 M-22: convertir 5 if separados a switch con case.
                // Antes: 5 if separados sin else if. Si mineiro estaba corrupto
                // (randomEx retornaba valor fuera de 0..4, imposible pero defensive),
                // multiples ramas podian ejecutar. Ahora: switch exclusivo.
                new mineiro = randomEx(0,4);
                new checkfinal = randomEx(1,2);
                new s[50];
                switch(mineiro)
                {
                        case 0:
                        {
                                // FIX M-A1-06: InfoMsg en vez de ErrorMsg (no es error, es suerte).
                                InfoMsg(playerid, "No encontraste ningun mineral. Intenta de nuevo.");
                        }
                        case 1:
                        {
                                GanharItem(playerid, 19181, checkfinal);
                                format(s,sizeof(s),"Encontraste %i mineral de oro.",checkfinal);
                                SuccesMsg(playerid, s);
                        }
                        case 2:
                        {
                                GanharItem(playerid, 19180, checkfinal);
                                format(s,sizeof(s),"Encontraste %i mineral de cobre.",checkfinal);
                                SuccesMsg(playerid, s);
                        }
                        case 3:
                        {
                                GanharItem(playerid, 19177, checkfinal);
                                format(s,sizeof(s),"Encontraste %i mineral de cuarzo.",checkfinal);
                                SuccesMsg(playerid, s);
                        }
                        case 4:
                        {
                                GanharItem(playerid, 19179, checkfinal);
                                format(s,sizeof(s),"Encontraste %i mineral de rubi.",checkfinal);
                                SuccesMsg(playerid, s);
                        }
                }
                UsouCMD[playerid] = false;
                ClearAnimations(playerid);
                // FIX AUDIT CEL MEJORA-2 (ALTO): respetar ownership del slot 9.
                // No remover slot 9 si fue el radio quien lo attacho (no la pala del Minero).
                if(!g_RadioSlot9Attached[playerid])
                        RemovePlayerAttachedObject(playerid, 9);
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
        return 1;
}

CallBack::Minando(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 2) return 1;
        if(EtapasMinerador[playerid] != 1) return 1;
        g_MinandoTmr[playerid] = -1;

        // FIX: Sistema de acumulacion. Incrementar rocas acumuladas.
        g_RocasAcumuladas[playerid]++;
        g_RocaCounter[playerid]++;
        g_FatigaMinero[playerid]++;
        Minero_KillSonido(playerid);
        // FIX AUDIT CEL MEJORA-2 (ALTO): respetar ownership del slot 9.
        // No remover slot 9 si fue el radio quien lo attacho (no la pala del Minero).
        if(!g_RadioSlot9Attached[playerid])
                RemovePlayerAttachedObject(playerid, 9);
        // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
        SafeUnfreeze(playerid);
        // Si llego a 15 rocas, mandar a vender automaticamente.
        if(g_RocasAcumuladas[playerid] >= MINERO_MAX_ROCAS)
        {
            SetPlayerCheckpoint(playerid, 820.981384, 858.453857, 12.046875, 2.0);
            EtapasMinerador[playerid] = 2;
            new msg[128];
            format(msg, sizeof(msg), "Recogiste %d rocas. Maximum alcanzado! Llevalas al punto de venta.", g_RocasAcumuladas[playerid]);
            SuccesMsg(playerid, msg);
        }
        else
        {
            // Si no llego a 15, crear checkpoint en otra mina para seguir recogiendo.
            new Float:posMinas[4][3] = {
                {638.114257, 831.205871, -42.960937},
                {638.953063, 851.907104, -42.960937},
                {602.181091, 867.931518, -42.960937},
                {602.180358, 867.173095, -42.960937}
            };
            new minaIdx = random(sizeof(posMinas));
            SetPlayerCheckpoint(playerid, posMinas[minaIdx][0], posMinas[minaIdx][1], posMinas[minaIdx][2], 4.0);
            EtapasMinerador[playerid] = 1;
            new msg[128];
            format(msg, sizeof(msg), "Recogiste 1 roca. Total: %d/%d. Ve a la siguiente mina o usa /venderrocas en el punto de venta.", g_RocasAcumuladas[playerid], MINERO_MAX_ROCAS);
            SuccesMsg(playerid, msg);
        }
        return 1;
}

// FIX: Conteo regresivo para Minero. Muestra segundos restantes a los 5s finales.
forward MineroConteo(playerid, segundos);
public MineroConteo(playerid, segundos)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 2) return 1;
        if(EtapasMinerador[playerid] != 1 && !UsouCMD[playerid]) return 1;
        new msg[64];
        format(msg, sizeof(msg), "Quedan %d segundos...", segundos);
        InfoMsg(playerid, msg);
        return 1;
}

// FIX: Sonido de picar para Minero. Suena cada 2s durante el minado.
forward MineroSonido(playerid);
public MineroSonido(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pProfissao] != 2) return 1;
        if(EtapasMinerador[playerid] != 1 && !UsouCMD[playerid]) return 1;
        // Sonido de golpe de pico (3201 = golpe metalico).
        PlayerPlaySound(playerid, 3201, 0.0, 0.0, 0.0);
        // Reprogramar el sonido cada 2s.
        g_SonidoMineroTmr[playerid] = SetTimerEx("MineroSonido", MINERO_SONIDO_INTERVAL, false, "i", playerid);
        return 1;
}

// FIX: Matar el timer de sonido del minero.
stock Minero_KillSonido(playerid)
{
        if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
        if(g_SonidoMineroTmr[playerid] != -1) { KillTimer(g_SonidoMineroTmr[playerid]); g_SonidoMineroTmr[playerid] = -1; }
        return 1;
}

CallBack::Pesca(playerid, progress)
{
                // FIX AUDIT10 A2-X7 + AUDIT PESCADOR P-A2-02: prevenir slot-reuse contamination.
                // Antes: solo IsPlayerConnected. Ahora: tambien pLogado y pProfissao==1.
                if(!IsPlayerConnected(playerid)) return 1;
                if(!pLogado[playerid]) return 1;
                // FIX AUDIT PESCADOR P-A1-03: validar que sigue siendo Pescador.
                // Si el jugador cambio de trabajo en los 10s del timer, NO recibir peces.
                if(PlayerInfo[playerid][pProfissao] != 1) { UsouCMD[playerid] = false; return 1; }
                // FIX AUDIT PESCADOR P-A2-01: marcar timer como completado (se ejecuto).
                g_PescaTmr[playerid] = -1;
                // FIX: siempre 1 pez por pesca (antes randomEx(1,3) daba 1-3 peces).
                new peixes = 1;
                new peixe = randomEx(0,4);
                // FIX SPRINT3 B-06: reducir s[255] a s[128] (los mensajes son <50 chars).
                new s[128];
                // FIX AUDIT PESCADOR P-A1-01: validar rango contra PosPesca, no coordenada fantasma.
                // Antes: el range check usaba (383.2907,-2088.7842,7.8359) que NO coincide con
                // NINGUNA entrada de PosPesca[]. El trabajo Pescador estaba 100% roto: tras 10s
                // de espera, el jugador siempre recivia "No estas en el area de pesca" y case 1-4
                // (entrega de peces 902/1603/1608/19630) nunca se ejecutaba.
                // Ahora: validar contra cualquier PosPesca[i] dentro de rango 15m.
                new bool:enZonaPesca = false;
                for(new i; i < 13; i++)
                {
                        if(IsPlayerInRangeOfPoint(playerid, 15.0, PosPesca[i][0], PosPesca[i][1], PosPesca[i][2]))
                        {
                                enZonaPesca = true;
                                break;
                        }
                }
                if(!enZonaPesca)
                {
                        ErrorMsg(playerid, "No estas en el area de pesca.");
                }
                else
                {
                        switch(peixe)
                        {
                                case 0:
                                {
                                        // FIX AUDIT PESCADOR P-A1-10: InfoMsg en vez de ErrorMsg para "No pescaste nada".
                                        InfoMsg(playerid, "No pescaste nada. Intenta de nuevo.");
                                }
                                case 1:
                                {
                                        GanharItem(playerid,902, peixes);
                                        format(s,sizeof(s),"Pescaste %i estrella(s) de mar.",peixes);
                                        SuccesMsg(playerid, s);
                                        // MEJORA 2: Log de pesca para auditorÃ¯Â¿Â½a econÃ¯Â¿Â½mica.
                                        Pesca_Log(playerid, 902, peixes);
                                }
                                case 2:
                                {
                                        GanharItem(playerid,1603, peixes);
                                        format(s,sizeof(s),"Pescaste %i agua(s) viva(s).",peixes);
                                        SuccesMsg(playerid, s);
                                        Pesca_Log(playerid, 1603, peixes);
                                }
                                case 3:
                                {
                                        GanharItem(playerid,1608, peixes);
                                        format(s,sizeof(s),"Pescaste %i tiburon(es).",peixes);
                                        SuccesMsg(playerid, s);
                                        Pesca_Log(playerid, 1608, peixes);
                                }
                                case 4:
                                {
                                        GanharItem(playerid,19630, peixes);
                                        format(s,sizeof(s),"Pescaste %i tilapia(s).",peixes);
                                        SuccesMsg(playerid, s);
                                        Pesca_Log(playerid, 19630, peixes);
                                }
                                // FIX AUDIT PESCADOR P-A1-07: default para resiliencia.
                                default:
                                {
                                        InfoMsg(playerid, "Resultado de pesca indeterminado. Intenta de nuevo.");
                                }
                        }
                }
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                UsouCMD[playerid] = false;
                ClearAnimations(playerid);
                // SIMPLE: quitar la vara de pescar al terminar la pesca.
                RemovePlayerAttachedObject(playerid, 8);
        return 1;
}

CallBack::criandorg(playerid){
        // FIX AUDIT RG RG-A1-01/RG-A3-04/RG-A3-05 (CRITICO): guards de estado + persistencia.
        // ANTES: sin guards. Si el jugador se desconectaba en los 7s del timer, el callback
        // disparaba sobre slot reusado y otro jugador recibia pRG=1 gratis. Ademas no validaba
        // que pNome/pPai/pMae/pNascimento estuvieran populados (jugador podia pasar wizard con
        // Enter en los 4 dialogs y recibir RG con campos vacios). Tampoco persistia pRG=1
        // (crash server = RG perdido). Ahora: 4 guards + persistencia inmediata.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        // FIX AUDIT RG RG-A3-04 (CRITICO): validar campos non-empty antes de setear pRG=1.
        if(isnull(PlayerInfo[playerid][pNome]) || strlen(PlayerInfo[playerid][pNome]) < 3) return 1;
        if(isnull(PlayerInfo[playerid][pPai]) || strlen(PlayerInfo[playerid][pPai]) < 3) return 1;
        if(isnull(PlayerInfo[playerid][pMae]) || strlen(PlayerInfo[playerid][pMae]) < 3) return 1;
        if(isnull(PlayerInfo[playerid][pNascimento]) || strlen(PlayerInfo[playerid][pNascimento]) < 8) return 1;
        // FIX AUDIT RG RG-A3-05 (CRITICO): validar que el wizard estaba en progreso.
        // Si g_WizardRGStage[playerid] != 4, el callback es stale (slot reuse o cheat spoof).
        if(g_WizardRGStage[playerid] != 4) return 1;
        g_WizardRGStage[playerid] = 0;  // reset stage
        g_CriandoRGTmr[playerid] = 0;   // reset timer ID
        SuccesMsg(playerid, "Acabas de recibir tus documentos.");
        PlayerInfo[playerid][pRG] = 1;
        // FIX AUDIT RG RG-A1-16 (MEDIO): persistir pRG=1 inmediatamente tras criandorg.
        // ANTES: no se llamaba SalvarDados. Crash server en los 7s = RG perdido.
        SalvarDados(playerid);
        ShowPlayerDialog(playerid, DIALOG_RG5, DIALOG_STYLE_MSGBOX, "RG", "{00FF00}ENHORABUENA!\n{FFFFFF}Su RG fue permitido correctamente.\nUse /rg para ver su rg.", "Ok", "");
        return 1;
}

CallBack::AntiSpam(playerid)
{
        RecentlyShot[playerid] = 0;
        return 1;
}

CallBack::AvisarDeudaLogin(playerid)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        new msg[256];
        GetPVarString(playerid, "DeudaMsgLogin", msg, sizeof(msg));
        if(strlen(msg) > 0)
        {
                ErrorMsg(playerid, msg);
                DeletePVar(playerid, "DeudaMsgLogin");
        }
        return 1;
}
CallBack::ExpireAntComannd(playerid){
        if(Podecmd[playerid] == false){
                Podecmd[playerid] = true;
        }
        return 1;
}

