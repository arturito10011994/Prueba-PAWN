                else if(PlayerToPoint(3.0, playerid, -5477.241699, -4540.109863, 4046.774902))
                {
                        if(PlayerInfo[playerid][Org] == 0) return ErrorMsg(playerid, "No estas en ninguna organizacion.");
                        membrosorg(playerid, PlayerInfo[playerid][Org]);
                }
                // P0-BEN-ICON: Menu de uniforme Bennys (tecla H) en 1972.76
                else if(PlayerToPoint(3.0, playerid, 1972.763183, -1784.189086, 13.543199))
                {
                        if(PlayerInfo[playerid][Org] != 9)             return ErrorMsg(playerid, "No tienes permisos.");
                        new menuUniforme[256];
                        if(mecanico[playerid] == false)
                                strcat(menuUniforme, "{FFD700}- {FFFFFF}Vestir Uniforme de Mecanico\n");
                        else
                                strcat(menuUniforme, "{FFD700}- {FFFFFF}Quitar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_UNI_BEN, DIALOG_STYLE_LIST, "Uniforme Bennys", menuUniforme, "Seleccionar", "X");
                }
                // P0-BEN-ICON2: Menu de vehiculos Bennys (tecla H) en 2010.81
                else if(PlayerToPoint(5.0, playerid, 2010.806762, -1771.444702, 13.543199))
                {
                        if(PlayerInfo[playerid][Org] != 9)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(mecanico[playerid] == false)                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
                        new menuVeh7[400];
                        new cargoBEN_menu = PlayerInfo[playerid][Cargo];
                        format(menuVeh7, sizeof(menuVeh7), "{FFD700}- {FFFFFF}Towtruck (Grua)\t{FFD700}525\n");
                        if(cargoBEN_menu >= 2)
                                strcat(menuVeh7, "{FFD700}- {FFFFFF}Bobcat (Camioneta)\t{FFD700}422\n");
                        if(cargoBEN_menu >= 3)
                                strcat(menuVeh7, "{FFD700}- {FFFFFF}Rumpo (Jefe)\t{FFD700}440\n");
                        new debugMsg[64];
                        format(debugMsg, sizeof(debugMsg), "\n{AAAAAA}[Debug: tu cargo es %d]", cargoBEN_menu);
                        strcat(menuVeh7, debugMsg);
                        ShowPlayerDialog(playerid, DIALOG_VEHCORP7, DIALOG_STYLE_LIST, "Vehiculos Bennys", menuVeh7, "Seleccionar", "X");
                }
        }
        if(newkeys == KEY_YES)
        {
                if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                {
                        new vehicleid = GetPlayerVehicleID(playerid);
                        if(IsBicycle(vehicleid)) return ErrorMsg(playerid, "No estas en un vehiculo!");
                        new id = GetVehicleID(vehicleid);
                        if(GetPlayerVehicleAccess(playerid, id) < 1)
                                return ErrorMsg(playerid, "No tienes la llave del vehiculo!");
                        SetPVarInt(playerid, "DialogValue1", id);
                        ShowDialog(playerid, DIALOG_VEHICLE);
                }
                //MINERADOR ENTRADA
                else if(IsPlayerInRangeOfPoint(playerid, 2.0, 445.8343,-850.0626,29.8050))
                {
                        // FIX AUDIT AC-H12: ACTPImmune antes de SetPlayerPos para evitar kick anti-TP.
                        SetPVarInt(playerid, "ACTPImmune", gettime());
                        SetPlayerPos(playerid, 439.9709,-856.7955,2.7160);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //MINERADOR SAIDA
                else if(IsPlayerInRangeOfPoint(playerid,2.0,439.9709,-856.7955,2.7160))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, 445.8343,-850.0626,29.8050);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //SAN NEWS ENTRADA
                else if(IsPlayerInRangeOfPoint(playerid, 2.0, 649.302062, -1357.399658, 13.567605))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, -5465.766113, -4536.025878, 4051.079589);
                        SetPlayerInterior(playerid, 1);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //SAN NEWS SAIDA
                else if(IsPlayerInRangeOfPoint(playerid,2.0,-5465.766113, -4536.025878, 4051.079589))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, 649.302062, -1357.399658, 13.567605);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //PREFEITURA ENTRADA
                else if(IsPlayerInRangeOfPoint(playerid,2.0, 1481.094482, -1772.313720, 18.795755))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid,  -501.1714,286.6785,2001.0950);
                        SetPlayerInterior(playerid, 1);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //PREFEITURA SAIDA
                else if(IsPlayerInRangeOfPoint(playerid,2.0,-501.1714,286.6785,2001.0950))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, 1481.094482, -1772.313720, 18.795755);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //MERCADO NEGRO ENTRADA
                else if(IsPlayerInRangeOfPoint(playerid,2.0, 2333.359130, -1883.562255, 15.000000))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid,  504.942962, -2317.662597, 512.790771);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //MERCADO NEGRO SAIDA
                else if(IsPlayerInRangeOfPoint(playerid,2.0,504.942962, -2317.662597, 512.790771))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, 2333.359130, -1883.562255, 15.000000);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //A?OUGUE  ENTRADA
                if(IsPlayerInRangeOfPoint(playerid,2.0, 2501.888916, -1494.696533, 24.000000))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid,  963.418762,2108.292480,1011.030273      );
                        SetPlayerInterior(playerid, 1);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                //A?OUGUE  SAIDA
                // FIX UX CARNICERO v2: trigger reubicado a posicion visible (965.17, 2107.85)
                // y radio ampliado a 2.5m para cubrir tambien el punto de aterrizaje (963.42, 2108.29)
                // que esta a 1.8m de distancia. Antes: radio 2.0 en (963.42, 2108.29) = punto ciego.
                else if(IsPlayerInRangeOfPoint(playerid,2.5,965.170654, 2107.851318, 1011.030273))
                {
                        SetPVarInt(playerid, "ACTPImmune", gettime()); // FIX AUDIT AC-H12
                        SetPlayerPos(playerid, 2501.888916, -1494.696533, 24.000000);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        TogglePlayerControllable(playerid, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                }
                // CAMBIO 2026-07-12: teleports de hospitales movidos a ChamadaUmSegundo.
                // Antes: entrada con tecla H (KEY_CTRL_BACK).
                // Ahora: entrada automatica al caminar dentro de 3 metros (sin tecla).
                // El bloque completo (Hospital 0 + 7 hospitales nuevos) esta en
                // ChamadaUmSegundo() para checkeo cada 1 segundo.
                for(new c; c < MAX_CASAS; c++)
                {
                        new gstring[255];
                        if(IsPlayerInRangeOfPoint(playerid, 2.0, CasaInfo[c][CasaX], CasaInfo[c][CasaY], CasaInfo[c][CasaZ]))
                        {
                                if(!strcmp(CasaInfo[c][CasaDono], "ninguno", true))
                                {
                                        new stg[1100];
                                        format(gstring, sizeof(gstring), "{8B008B}Casa N:{FFFFFF} %d\n\n", CasaInfo[c][CasaId]);
                                        strcat(stg, gstring);
                                        format(gstring, sizeof(gstring), "{8B008B}Dueno:{FFFFFF} %s\n", CasaInfo[c][CasaDono]);
                                        strcat(stg, gstring);
                                        format(gstring, sizeof(gstring), "{8B008B}Valor:{00FF00} $%s\n\n", ConvertMoney(CasaInfo[c][CasaValor]));
                                        strcat(stg, gstring);
                                        strcat(stg, "{8B008B}01. {FFFFFF}Entrar a la Casa\n");
                                        strcat(stg, "{8B008B}02. {FFFFFF}Comprar Casa\n");
                                        ShowPlayerDialog(playerid, DIALOG_CASAS, DIALOG_STYLE_INPUT, "Elegir una Opcion", stg, "Seleccionar", "X");
                                        return 1;
                                }
                                else
                                {
                                        new stg[1100];
                                        format(gstring, sizeof(gstring), "{8B008B}Casa N:{FFFFFF} %d\n\n", CasaInfo[c][CasaId]);
                                        strcat(stg, gstring);
                                        format(gstring, sizeof(gstring), "{8B008B}Dueno:{FFFFFF} %s\n", CasaInfo[c][CasaDono]);
                                        strcat(stg, gstring);
                                        format(gstring, sizeof(gstring), "{8B008B}Status:{00FF00} Aberta\n\n");
                                        strcat(stg, gstring);
                                        strcat(stg, "{8B008B}01. {FFFFFF}Entrar a la Casa\n");
                                        strcat(stg, "{8B008B}02. {FFFFFF}Comprar Casa\n");
                                        ShowPlayerDialog(playerid, DIALOG_CASAS, DIALOG_STYLE_INPUT, "Elegir una Opcion", stg, "Seleccionar", "X");
                                        return 1;
                                }
                        }
                        if(IsPlayerInRangeOfPoint(playerid, 2.0, CasaInfo[c][CasaInteriorX], CasaInfo[c][CasaInteriorY], CasaInfo[c][CasaInteriorZ]))
                        {
                                SetPlayerInterior(playerid, 0);
                                SetPlayerVirtualWorld(playerid, 0);
                                SetPlayerPos(playerid, CasaInfo[PlayerInfo[playerid][Entrada]][CasaX], CasaInfo[PlayerInfo[playerid][Entrada]][CasaY], CasaInfo[PlayerInfo[playerid][Entrada]][CasaZ]);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                return 1;
                        }
                }
        }
        // SISTEMA EMPAQUETADOR NIVEL 1 - Teclas Delete/End para bajar/subir pesunas
        if(newkeys == 8224 || newkeys == 16384) // KEY_ANALOG_DOWN (Delete) o KEY_ANALOG_UP (End)
        {
                if(PlayerInfo[playerid][pProfissao] == 7 && g_EmpNivelActual[playerid] == 1 && g_EmpRutaActiva[playerid])
                {
                        if(newkeys == 8224) // Delete = bajar pesunas
                        {
                                g_EmpForksDown[playerid] = 1;
                                InfoMsg(playerid, "Pesunas bajadas. Acerca el montacargas a la caja para recogerla.");
                        }
                        else // End = subir pesunas
                        {
                                g_EmpForksDown[playerid] = 0;
                                InfoMsg(playerid, "Pesunas subidas.");
                        }
                        return 1;
                }
        }
        if(newkeys == KEY_NO)
        {
                // FIX AUDIT 5P [M2]: si el mecanico esta conduciendo Bobcat/Towtruck con baliza,
                // la tecla N toggla la baliza, no debe abrir inventario (conflicto UX)
                if(PlayerInfo[playerid][Org] == 9 && IsPlayerInAnyVehicle(playerid))
                {
                        new vehN = GetPlayerVehicleID(playerid);
                        new modelN = GetVehicleModel(vehN);
                        if(modelN == 543 || modelN == 552) // Bobcat o Towtruck
                                return 1; // no abrir inventario, deja que el toggle baliza se ejecute
                }
                cmd_inventario(playerid);
        }
        if(newkeys == KEY_SECONDARY_ATTACK)
        {
                // =====================================================================
                // SISTEMA EMPAQUETADOR NIVEL 1 - Pickup automatico (no F, no conflicto con subir vehiculo)
                // El pickup se hace automaticamente al llegar al CP de la caja (OnPlayerEnterCheckpoint)
                // Delete = bajar pesunas, End = subir pesunas (feedback visual solo)
                // =====================================================================
                // =====================================================================
                // SISTEMA RECOLECTOR NIVEL 2 - Recoger basura ahora es automatico (3s en CP).
                // El bloque de recoger con F se elimino. Ver OnPlayerEnterCheckpoint + RecNivel2RecogerBasura.
                // =====================================================================
                // =====================================================================
                // SISTEMA SEPULTURERO - Recoger cadaver (F cerca del pickup de cadaver)
                // =====================================================================
                if(PlayerInfo[playerid][pProfissao] == 10 && g_SepultureroTieneCadaver[playerid] == 0 && g_SepultureroEnHospital[playerid] == 0)
                {
                        for(new c = 0; c < MAX_CADAVERES; c++)
                        {
                                if(g_CadaveresActivo[c] == 1)
                                {
                                        if(IsPlayerInRangeOfPoint(playerid, 3.0, g_CadaveresPos[c][0], g_CadaveresPos[c][1], g_CadaveresPos[c][2]))
                                        {
                                                // Cooldown anti-spam
                                                new now = gettime();
                                                new cooldownSep = (PlayerInfo[playerid][pSegundosJogados] < SEPULTURERO_NOVATO_HORAS) ? SEPULTURERO_COOLDOWN_NOVATO : SEPULTURERO_COOLDOWN_EXPERTO;
                                                if(now - g_SepultureroLastRecoger[playerid] < cooldownSep)
                                                {
                                                        ErrorMsg(playerid, "Espera unos segundos antes de recoger otro cadaver.");
                                                        return 1;
                                                }
                                                g_SepultureroLastRecoger[playerid] = now;
                                                // Recoger cadaver
                                                g_SepultureroTieneCadaver[playerid] = c + 1; // 1-based
                                                Sepulturero_EliminarCadaver(c);
                                                // Determinar hospital mas cercano
                                                new hospId = Sepulturero_HospitalCercano(g_CadaveresPos[c][0], g_CadaveresPos[c][1], g_CadaveresPos[c][2]);
                                                g_SepultureroHospitalOrigen[playerid] = hospId;
                                                g_SepultureroPagoPendiente[playerid] = SepultureroPagoBase[hospId - 1];
                                                // Setear CP al hospital
                                                SetPlayerCheckpoint(playerid, SepultureroHospitales[hospId - 1][0], SepultureroHospitales[hospId - 1][1], SepultureroHospitales[hospId - 1][2], 5.0);
                                                new hospNombre[24];
                                                switch(hospId)
                                                {
                                                        case 1: hospNombre = "Los Santos";
                                                        case 2: hospNombre = "Las Venturas";
                                                        case 3: hospNombre = "San Fierro";
                                                }
                                                new msg[128];
                                                format(msg, sizeof(msg), "Cadaver recogido. Lleva el cuerpo al hospital de %s (CP marcado). Pago base: $%d", hospNombre, g_SepultureroPagoPendiente[playerid]);
                                                SuccesMsg(playerid, msg);
                                                GameTextForPlayer(playerid, "~g~Cadaver recogido!~n~~w~Lleva el cuerpo al hospital", 4000, 5);
                                                return 1;
                                        }
                                }
                        }
                }
                // FIX: eliminado el disparo automatico de cmd_minar al presionar F en las minas.
                // Antes: presionar F en la zona de minado disparaba cmd_minar que pide pala.
                // El jugador se confundia porque /iniciarminero no necesita pala.
                // Ahora: el Minero funciona solo con /iniciarminero (checkpoints).
                // Si quiere conseguir minerales (items), usa /minar manualmente con pala.
                if(MostrandoMenu[playerid] == true)
                {
                        TextDrawHideForPlayer(playerid, TDCadastro[2]);
                        TextDrawHideForPlayer(playerid, TDCadastro[3]);
                        for(new i=0;i<7;i++){
                                PlayerTextDrawHide(playerid, TDCadastro_p[playerid][i]);
                                if(i == 7)break;
                        }
                        MostrandoMenu[playerid] = false;
                        SalvarDadosSkin(playerid);
                        CancelSelectTextDraw(playerid);
                }
                cmd_recogeritem(playerid);
                if(IsPlayerInRangeOfPoint(playerid, 2.0, -1143.184814, 2227.874511, 97.219261))
                {
                        if(!CheckInventario2(playerid, 1576))   return ErrorMsg(playerid, "No tienes marihuana en tu inventario..");
                        cmd_iniciarrotamaconha(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 2.0, -248.257873, 1506.404418, 75.562500))
                {
                        if(!CheckInventario2(playerid, 1575))   return ErrorMsg(playerid, "No tienes Cucina en tu inventario..");
                        cmd_iniciarrotacucina(playerid);
                }
                // FIX AUDIT PESCADOR P-A5-06 + P-A1-06: for-loop con break post-match
                // y eliminado dead code "if(i == 13)break;" (i nunca llega a 13 dentro del loop i<13).
                // Antes: for sin break podia disparar cmd_pescar multiples veces (multi-timer dup).
                for(new i; i < 13; i++)
                {
                        if(IsPlayerInRangeOfPoint(playerid, 2.0, PosPesca[i][0], PosPesca[i][1], PosPesca[i][2]))
                        {
                                cmd_pescar(playerid);
                                break; // FIX: cortar tras primer match para evitar multi-disparo
                        }
                }
                // FIX AUDIT P-A5-06: mismo patron para PosDesossa (Carnicero)
                for(new i; i < 8; i++)
                {
                        if(IsPlayerInRangeOfPoint(playerid, 1, PosDesossa[i][0], PosDesossa[i][1], PosDesossa[i][2]))
                        {
                                cmd_desossar(playerid);
                                break;
                        }
                }
                if(PlayerToPoint(3.0, playerid, -520.421813, -504.999450, 24.635631) || PlayerToPoint(3.0, playerid, -529.748168, -504.937561, 24.640802) || PlayerToPoint(3.0, playerid, -557.552368, -505.473480, 24.596021))
                {
                        cmd_cargar(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 942.577758, 2117.902099, 1011.030273)){
                        cmd_dejarcarne(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 1682.130737, -2326.373291, 13.546875)){
                        MEGAString[0] = EOS;
                        format(stringZCMD, sizeof(stringZCMD), "1* Empezaste ahora y estas perdido y no sabes que hacer?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n2* Como hago para encontrar lugares?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n3* Como hago para conseguir un trabajo?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n4* Como hago para subir de nivel?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n5* Como hago para obtener mis licencias?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n6* Como hago para ingresar a una organizacion?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n7* Entre a un trabajo, no se que hacer!");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n8* Se me traba con frecuencia, que puede ser?");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n9* Me estan matando sin motivo y no se que hacer!");
                        strcat(MEGAString,stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "\n10* Hice una donacion y estoy perdido, que hago?");
                        strcat(MEGAString,stringZCMD);
                        ShowPlayerDialog(playerid,DIALOG_FAQ,DIALOG_STYLE_LIST, "FAQ", MEGAString, "Confirmar", "X");
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 938.006469, 2144.264892, 1011.023437)){
                        cmd_tomarCaja(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 942.416259, 2137.294921, 1011.023437)){
                        cmd_empaquetarcarne(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 942.421325, 2153.745849, 1011.023437)){
                        cmd_dejarCaja(playerid);
                }
                if(IsPlayerInRangeOfPoint(playerid, 1, 942.288391, 2173.139404, 1011.023437)){
                        cmd_tomarCaja2(playerid);
                }
                if(PlayerToPoint(3.0, playerid, 934.1115,-1103.3857,24.3118)){
                        cmd_ltumba(playerid);
                }
                // P0-REP-FIX: camara de reportero removida de aqui (tecla F).
                // Ahora se obtiene desde el menu de equipamiento (tecla Y) en DIALOG_EQUIP_REP.
                if(PlayerToPoint(3.0, playerid, 1982.807739, -1783.678100, 13.543199) || PlayerToPoint(3.0, playerid, 1991.699951, -1783.279541, 13.543199) || PlayerToPoint(3.0, playerid, 2001.068359, -1783.499389, 13.543199) || PlayerToPoint(3.0, playerid, 2010.380981, -1783.100097, 13.543199) || PlayerToPoint(3.0, playerid, 2018.434692, -1783.255126, 13.543199))
                {
                        if(PlayerInfo[playerid][Org] != 9)              return ErrorMsg(playerid, "No tienes permisos.");
                        ShowPlayerDialog(playerid, DIALOG_ARMARIOMEC, DIALOG_STYLE_LIST,"Menu Bennys", "{FFFF00}- {FFFFFF}Caja de herramientas\t{32CD32}$1200\n{FFFF00}- {FFFFFF}Kit de Tuning\t{32CD32}$15000", "Seleccionar","X");
                }
                if(PlayerToPoint(3.0, playerid, -501.146118, 294.354156, 2001.094970))
                {
                        // FIX 2026-07-20: usar GetPlayerTime (hora in-game) en vez de gettime (hora real servidor)
                        // Antes: gettime() devolvia la hora real del SO, ignorando /hora del admin
                        // Ahora: respetamos la hora que el jugador ve en el reloj in-game
                        new horaAyu, minAyu;
                        GetPlayerTime(playerid, horaAyu, minAyu);
                        #pragma unused minAyu
                        if(horaAyu < 7 || horaAyu >= 19) return ErrorMsg(playerid, "El Ayuntamiento esta cerrado. Horario de atencion: 07:00 - 19:00.");
                        ShowPlayerDialog(playerid, DIALOG_PREFEITURA, DIALOG_STYLE_LIST,"Ayuntamiento de Estado", "{FFFF00}- {FFFFFF}Sacar Documentos\n{FFFF00}- {FFFFFF}Sacar Cart. Trabajo\n{FFFF00}- {FFFFFF}Pago de Impuestos\n{FFFF00}- {FFFFFF}Solicitud de Licencias\n{FFFF00}- {FFFFFF}Pagar Deuda Fiscal\n{FFFF00}- {FFFFFF}Pagar Multas", "Seleccionar","X");
                }
                if(PlayerToPoint(3.0, playerid, 514.767089, -2334.465820, 508.693756))
                {
