CMD:rg(playerid)
{
        if(PlayerInfo[playerid][pRG] == 1)
        {
                if(MostrandoRG[playerid] == false)
                {
                        new str[128];
                        PlayerTextDrawSetPreviewModel(playerid, RG_p[playerid][1], PlayerInfo[playerid][pSkin]);
                        format(str,sizeof(str),"%s",PlayerInfo[playerid][pNome]);
                        PlayerTextDrawSetString(playerid,RG_p[playerid][0],str);
                        format(str,sizeof(str),"%s",PlayerInfo[playerid][pPai]);
                        PlayerTextDrawSetString(playerid,RG_p[playerid][2],str);
                        format(str,sizeof(str),"%s",PlayerInfo[playerid][pMae]);
                        PlayerTextDrawSetString(playerid,RG_p[playerid][3],str);
                        format(str,sizeof(str),"%s",PlayerInfo[playerid][pNascimento]);
                        PlayerTextDrawSetString(playerid,RG_p[playerid][4],str);
                        format(str,sizeof(str),"%s",PlayerInfo[playerid][pNome]);
                        PlayerTextDrawSetString(playerid,RG_p[playerid][5],str);
                        // FIX AUDIT RG RG-A1-06 (ALTO): eliminar dead code `if(t == 24)break` y `if(t == 6)break`.
                        // ANTES: los loops `for(new t=0;t<24;t++)` nunca llegan a t==24 (0..23), asi que
                        // el `if(t == 24)break` es dead code. Y `if(t == 6)break` en loop `t<6` tambien.
                        for(new t=0;t<24;t++)
                        {
                                TextDrawShowForPlayer(playerid, TD_RG[t]);
                        }
                        for(new t=0;t<6;t++)
                        {
                                PlayerTextDrawShow(playerid, RG_p[playerid][t]);
                        }
                        MostrandoRG[playerid] = true;
                        SelectTextDraw(playerid, 0xFF0000FF);
                }else{
                        ErrorMsg(playerid,"Ya tienes tu RG abierto. Haz click en cualquier lugar para cerrarlo.");
                }
        }
        else
        {
                ErrorMsg(playerid, "Usted no posee un RG");
        }
        return 1;
}
CMD:mostrarrg(playerid,params[])
{
        new id,str[128];
        if(sscanf(params,"d",id)) return ErrorMsg(playerid, "Debe colocar el id del usuario");
        if(PlayerInfo[playerid][pRG] == 1)
        {
                if(MostrandoRG[playerid] == false)
                {
                        // FIX AUDIT RG RG-A1-02/RG-A1-04/RG-A1-06 (CRITICO): reescribir /mostrarrg.
                        // ANTES: 4 bugs criticos:
                        // 1) IsPlayerInRangeOfPoint INVERTIDO (L43600): si estas cerca, dice "no estas cerca"
                        // 2) Self-check `PlayerInfo[i][IDF] == playerid` compara IDF con playerid (siempre false)
                        // 3) foreach sin break: dispara N-1 mensajes de "Jugador no conectado"
                        // 4) `PlayerTextDrawShow(i, RG_p[playerid][t])` IMPOSIBLE en SA-MP: PTDs son per-player
                        //    El target solo ve el frame global, no los datos del RG.
                        // AHORA: lookup directo O(1), IsPerto check correcto, self-check correcto,
                        // y usar ShowPlayerDialog al target con los datos del RG en texto (funcional).
                        if(id < 0 || id >= MAX_PLAYERS) return ErrorMsg(playerid, "ID invalido.");
                        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
                        if(id == playerid) return ErrorMsg(playerid, "No puedes mostrar el RG a ti mismo, usa /rg");
                        if(!IsPerto(playerid, id)) return ErrorMsg(playerid, "No estas cerca del jugador.");
                        if(MostrandoRG[id]) return ErrorMsg(playerid, "El jugador ya esta viendo un RG");
                        // Mostrar RG del playerid al target `id` via dialogo (funcional cross-player).
                        new rgStr[512];
                        format(rgStr, sizeof(rgStr), "{FFFFFF}Nombre: {FFFF00}%s\n", PlayerInfo[playerid][pNome]);
                        format(str, sizeof(str), "{FFFFFF}Fecha de nacimiento: {FFFF00}%s\n", PlayerInfo[playerid][pNascimento]);
                        strcat(rgStr, str);
                        format(str, sizeof(str), "{FFFFFF}Nombre del padre: {FFFF00}%s\n", PlayerInfo[playerid][pPai]);
                        strcat(rgStr, str);
                        format(str, sizeof(str), "{FFFFFF}Nombre de la madre: {FFFF00}%s\n", PlayerInfo[playerid][pMae]);
                        strcat(rgStr, str);
                        ShowPlayerDialog(id, DIALOG_FAQ, DIALOG_STYLE_MSGBOX, "RG - Documento de Identidad", rgStr, "Cerrar", "");
                        format(str,sizeof(str),"Mostraste tu RG a %s",Name(id));
                        SuccesMsg(playerid,str);
                        format(str,sizeof(str),"%s te mostro su RG",Name(playerid));
                        SuccesMsg(id,str);
                }else{
                        ErrorMsg(playerid, "No puedes mostrar tu RG mientras lo ves");
                }
        }
        else
        {
                ErrorMsg(playerid, "No tienes un RG");
        }
        return 1;
}

CMD:licencia(playerid, params[])
{
        new id;
        // Sin parametros = ver las propias
        if(sscanf(params, "d", id))
        {
                // Mostrar licencias propias
                new str[512];
                format(str, sizeof(str), "{FFFFFF}Titular: {FFFF00}%s {FFFFFF}(ID: {FFFF00}%04d{FFFFFF})\n\n", Name(playerid), GetPlayerIdfixo(playerid));
                strcat(str, "{FFFFFF}Licencias de conduccion:\n");
                if(CheckInventario2(playerid, 1853))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. A  - Moto\n");
                else                                    strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. A  - Moto\n");
                if(CheckInventario2(playerid, 1854))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. B  - Automovil\n");
                else                                    strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. B  - Automovil\n");
                if(CheckInventario2(playerid, 1855))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. C  - Camion\n");
                else                                    strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. C  - Camion\n");
                if(CheckInventario2(playerid, 19857))   strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. E  - Trailero\n");
                else                                    strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. E  - Trailero\n");
                if(CheckInventario2(playerid, 1856))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Aerea   - Piloto\n");
                else                                    strcat(str, "  {FF4444}[[x]] {AAAAAA}Aerea   - Piloto\n");
                ShowPlayerDialog(playerid, DIALOG_FAQ, DIALOG_STYLE_MSGBOX, "Mis Licencias de Conduccion", str, "Cerrar", "");
                return 1;
        }
        // Con ID = mostrar las del otro jugador (a el mismo, no puede quitarselas)
        new bool:encontrado = false;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == id)
                {
                        encontrado = true;
                        new str[512], nombreTarget[MAX_PLAYER_NAME];
                        GetPlayerName(i, nombreTarget, sizeof(nombreTarget));
                        format(str, sizeof(str), "{FFFFFF}Titular: {FFFF00}%s {FFFFFF}(ID: {FFFF00}%04d{FFFFFF})\n\n", nombreTarget, id);
                        strcat(str, "{FFFFFF}Licencias de conduccion:\n");
                        if(CheckInventario2(i, 1853))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. A  - Moto\n");
                        else                             strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. A  - Moto\n");
                        if(CheckInventario2(i, 1854))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. B  - Automovil\n");
                        else                             strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. B  - Automovil\n");
                        if(CheckInventario2(i, 1855))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. C  - Camion\n");
                        else                             strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. C  - Camion\n");
                        if(CheckInventario2(i, 19857))   strcat(str, "  {00FF00}[[v]] {FFFFFF}Cat. E  - Trailero\n");
                        else                             strcat(str, "  {FF4444}[[x]] {AAAAAA}Cat. E  - Trailero\n");
                        if(CheckInventario2(i, 1856))    strcat(str, "  {00FF00}[[v]] {FFFFFF}Aerea   - Piloto\n");
                        else                             strcat(str, "  {FF4444}[[x]] {AAAAAA}Aerea   - Piloto\n");
                        // Solo muestra - no da acceso ni permite editar
                        new notif[64];
                        format(notif, sizeof(notif), "Licencias de %s (%04d)", nombreTarget, id);
                        ShowPlayerDialog(playerid, DIALOG_FAQ, DIALOG_STYLE_MSGBOX, notif, str, "Cerrar", "");
                        new msg[64];
                        format(msg, sizeof(msg), "{FFFF00}%s te solicito ver tu licencia.", Name(playerid));
                        SendClientMessage(i, 0xFFFF00FF, msg);
                        break;
                }
        }
        if(!encontrado) return ErrorMsg(playerid, "Jugador no encontrado o no conectado.");
        return 1;
}

CMD:uniforme(playerid){
        // FIX P2-10: no permitir /uniforme dentro de vehiculo (causa glitch visual).
        if(IsPlayerInAnyVehicle(playerid))
                return ErrorMsg(playerid, "Bajate del vehiculo antes de cambiarte de uniforme.");
        if(PlayerInfo[playerid][pProfissao] == 8){ //Correios
                if(PlayerToPoint(3.0, playerid, 956.8282,1754.7942,8.6484)){
                        if(EmServico[playerid] == false){
                                EmServico[playerid] = true;
                                SetPlayerSkin(playerid, 71);
                                SuccesMsg(playerid, "Vestiste tu uniforme e iniciaste servicio.");
                        }else{
                                EmServico[playerid] = false;
                                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                                SuccesMsg(playerid, "Te quitaste el uniforme y cerraste servicio.");
                                // FIX P0-3: al cerrar servicio, limpiar cualquier estado residual de Correos.
                                // Evita vans/actores/objetos huerfanos si el jugador cerrÃ¯Â¿Â½ servicio a mitad de ruta.
                                Correos_FlushPlayer(playerid);
                        }
                }else{
                        ErrorMsg(playerid, "No estas en el lugar correcto para ponerte el uniforme.");
                }
        }else{
                ErrorMsg(playerid, "No perteneces a ninguna empresa/organizacion/corporacion.");
        }
        return 1;
}

CMD:mvoip(playerid)
{
        ShowPlayerDialog(playerid, D_VOIP, DIALOG_STYLE_LIST, "Config VOIP", "{FFFF00}VOIP{FFFFFF} Falando\n{FFFF00}VOIP{FFFFFF} Susurrando\n\
        {FFFF00}VOIP{FFFFFF} Gritando\n", "Seleccionar", "X");
        return 1;
}

CMD:cinturon(playerid)
{
        if(!IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "No estas en un vehiculo.!");
        if(IsABike(GetPlayerVehicleID(playerid)) || IsABoat(GetPlayerVehicleID(playerid))) return ErrorMsg(playerid, "No estas en un vehiculo que tenga cinturon de seguridad!");
        if(TemCinto[playerid] == false)
        {
                TemCinto[playerid] = true;
                SuccesMsg(playerid, "Cinturon de seguridad abrochado");
                for(new x=0;x<5;x++)
                {
                        TextDrawHideForPlayer(playerid, Tdcinto[x]);
                        if(x == 5)break;
                }
                PlayAudioStreamForPlayer(playerid, "https://j.top4top.io/m_2911pmwja0.mp3");
        }
        else
        {
                TemCinto[playerid] = false;
                SuccesMsg(playerid, "Se quito el cinturon de seguridad");
                for(new x=0;x<5;x++)
                {
                        TextDrawShowForPlayer(playerid, Tdcinto[x]);
                        if(x == 5)break;
                }
                PlayAudioStreamForPlayer(playerid, "https://j.top4top.io/m_2911pmwja0.mp3");
        }
        return true;
}

CMD:gps(playerid)
{
        ShowPlayerDialog(playerid, DIALOG_GPS, DIALOG_STYLE_LIST, "Donde desea ir?", "{FFFF00}GPS {FFFFFF}Localizar lugares Importantes\n{FFFF00}GPS {FFFFFF}Localizar trabajos\n{FFFF00}GPS {FFFFFF}Localizar Organizaciones\n{FFFF00}GPS {FFFFFF}Localizar Casas", "Seleccionar", "X");


        return 1;
}

CMD:recogeritem(playerid)
{
        new Float:x, Float:y, Float:z, str[128];
        for(new i = 0; i < sizeof(DropItemSlot); i++)
        {
                GetDynamicObjectPos(DropItemSlot[i][DropItem], x,y,z);
                if(DropItemSlot[i][DropItem] != 0)
                {
                        if(IsPlayerInRangeOfPoint(playerid, 1.5, x,y,z+1) && GetPlayerVirtualWorld(playerid) == DropItemSlot[i][Virtual] && GetPlayerInterior(playerid) == DropItemSlot[i][Interior])
                        {
                                if(!CheckInventario(playerid, DropItemSlot[i][DropItemID])) return ErrorMsg(playerid, "Tu inventario esta lleno.");
                                GanharItem(playerid, DropItemSlot[i][DropItemID], DropItemSlot[i][DropItemUni]);
                                format(str, sizeof(str), "usted recogio %s desde el suelo %s con unidades.", ItemNomeInv(DropItemSlot[i][DropItemID]), ConvertMoney(DropItemSlot[i][DropItemUni]));
                                DestroyDynamicObject(DropItemSlot[i][DropItem]);
                                DestroyDynamic3DTextLabel(DropItemSlot[i][LabelItem]);
                                DropItemSlot[i][DropItem] = 0;
                                DropItemSlot[i][DropItemID] = -1;
                                DropItemSlot[i][DropItemUni] = 0;
                                DropItemSlot[i][Interior] = 0;
                                DropItemSlot[i][Virtual] = 0;
                                SuccesMsg(playerid, str);
                                ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0, 1);
                                return 1;
                        }
                }
        }
        return 1;
}

CMD:daritem(playerid, const params[])
{
        new id, item, quantia;
        if(PlayerInfo[playerid][pAdmin] < 5)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params, "iii", id, item, quantia)) return ErrorMsg(playerid, "Use: /daritem [ID] [ITEM ID] [UNIDADES].");
        if(quantia < 1) return ErrorMsg(playerid, "Coloque una cantidad.");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(i == id)
                        {
                                if(!IsValidItemInv(item)) return ErrorMsg(playerid, "Item indefinido.");
                                // FIX AUDIT-AUDIT6-S-ALTO-013 (ALTO): bloquear items de licencia via /daritem.
                                // ANTES: admin nivel 5+ podia otorgar licencias de conducir (items 1853/1854/1855/1856/19857)
                                // sin examen, sin costo, sin requisitos. Bypass total del sistema de autoescuela ($73k de valor).
                                // Ahora: licencias deben obtenerse exclusivamente via examen en Centro de Licencias.
                                if(item == 1853 || item == 1854 || item == 1855 || item == 1856 || item == 19857)
                                        return ErrorMsg(playerid, "Las licencias de conducir no se pueden dar via /daritem. Deben obtenerse en autoescuela (Centro de Licencias).");
                                if(!CheckInventario(i, item)) return ErrorMsg(playerid, "El inventario del jugador esta lleno.");
                                GanharItem(i, item, quantia);
                                SuccesMsg(playerid, "Conjunto de objetos para el jugador.");
                                new logitem[256];
                                format(logitem, sizeof(logitem), "[DARITEM] Admin: %s (ID%04d) -> Jugador: %s (ID%04d) | Item: %d | Cantidad: %d",
                                        Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], item, quantia);
                                Log("Logs/AdminAcciones.ini", logitem);
                        }
                }
        }

        return 1;
}

// ==========================================================================
// MEJORA XP-CMD-1: /payday - Forzar PayDay inmediato (admin nivel 2+)
// Invoca directamente el callback PayDay del jugador que ejecuta el comando.
// No requiere esperar los 30 minutos del timer normal.
// ==========================================================================
CMD:payday(playerid, params[])
{
        #pragma unused params
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff.");
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        // FIX ERR-XP-001: llamar PayDay directamente (no usar CallBack:: prefix - es solo para definicion).
        // CallBack:: es un macro que expande a forward+public, no es un namespace de llamada.
        PayDay(playerid);
        SuccesMsg(playerid, "PayDay forzado. Recibiste tu salario y XP inmediatamente.");
        new _logPD[128];
        format(_logPD, sizeof(_logPD), "[PAYDAY FORZADO] Admin: %s (ID:%d) forzo su propio PayDay.", Name(playerid), PlayerInfo[playerid][IDF]);
        Log("Logs/AdminAcciones.ini", _logPD);
        return 1;
}

// ==========================================================================
// MEJORA XP-CMD-2: /dardineroall - Dar dinero a todos los jugadores conectados
// Admin nivel 4+ puede dar dinero a TODOS los jugadores conectados con un comando.
// Uso: /dardineroall [cantidad]
// ==========================================================================
CMD:dardineroall(playerid, params[])
{
        new cantidad;
        if(PlayerInfo[playerid][pAdmin] < 4) return ErrorMsg(playerid, "No tienes permisos. Necesitas admin nivel 4+.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff.");
        if(sscanf(params, "i", cantidad)) return ErrorMsg(playerid, "USE: /dardineroall [cantidad]. Ejemplo: /dardineroall 5000");
        if(cantidad <= 0) return ErrorMsg(playerid, "La cantidad debe ser mayor a 0.");
        if(cantidad > 1000000) return ErrorMsg(playerid, "La cantidad maxima es $1.000.000 por comando.");

        new totalJugadores = 0;
        new totalDinero = 0;
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        // Usar AC_AddPlayerMoney para respetar anti-cheat (clamp a max)
                        AC_AddPlayerMoney(i, cantidad);
                        SalvarDados(i);
                        new _msgDin[128];
                        format(_msgDin, sizeof(_msgDin), "Un administrador te dio $%d a ti y a todos los jugadores conectados.", cantidad);
                        SuccesMsg(i, _msgDin);
                        totalJugadores++;
                        totalDinero += cantidad;
                }
        }

        // Notificar al admin
        new _msgAdmin[128];
        format(_msgAdmin, sizeof(_msgAdmin), "Diste $%d a %d jugadores conectados. Total distribuido: $%d.", cantidad, totalJugadores, totalDinero);
        SuccesMsg(playerid, _msgAdmin);

        // Log de la accion
        new _logDin[256];
        format(_logDin, sizeof(_logDin), "[DARDINEROALL] Admin: %s (ID:%d) dio $%d a %d jugadores. Total: $%d", Name(playerid), PlayerInfo[playerid][IDF], cantidad, totalJugadores, totalDinero);
        Log("Logs/AdminAcciones.ini", _logDin);
        return 1;
}

CMD:inventario(playerid)
{
        new str[64];
        if(InventarioAberto[playerid])
        {
                for(new i = 0; i < 40; ++i)
                {
                        PlayerTextDrawHide(playerid, DrawInv[playerid][i]);
                        if(i == 40)break;
                }
                InventarioAberto[playerid] = 0;
                CancelSelectTextDraw(playerid);
                return 1;
        }
        else
        {
                format(str, sizeof(str), "%s", Name(playerid));
                PlayerTextDrawSetString(playerid, DrawInv[playerid][34], str);
                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], "");
                for(new i = 1; i < 33; ++i)
                {
                        PlayerTextDrawSetPreviewModel(playerid, DrawInv[playerid][i], PlayerInventario[playerid][i][Slot]);
                        if(PlayerInventario[playerid][i][Slot] == -1)
                        {
                                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][i], 0.000000, 0.000000, 0.000000, 999);
                        }
                        else
                        {
                                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][i], 0.000000, 0.000000, 0.000000, 1);
                        }
                        if(i == 32)break; // FIX AUDIT INV I0-6: era 31, slot 32 inalcanzable
                }
                for(new i = 0; i < 40; ++i)
                {
                        PlayerTextDrawShow(playerid, DrawInv[playerid][i]);
                        if(i == 40)break;
                }
                SelectTextDraw(playerid, 0xC4C4C4AA);
                InventarioAberto[playerid] = 1;
        }
        return 1;
}

CMD:report(playerid, params[])
{
        // FIX AUDIT2 AGENT4 S-15: cooldown 30s via PVar CD_report. Sin esto, un
        // jugador podia spamear /report y floodar el chat de admins (5 cmds/seg
        // x 10s = 50 reports antes del kick por SP-01 rate-limit global).
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_report") < 30)
                return ErrorMsg(playerid, "Espera 30s para otro reporte.");
        if(sscanf(params, "is[56]", ID, Motivo))                                        return ErrorMsg(playerid, "USE: /report [ID] [RAZON]");
        SetPVarInt(playerid, "CD_report", now); // FIX AUDIT7 UX-1: mover SetPVarInt despues de sscanf
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                SuccesMsg(playerid, "Se ha notificado a los administradores. Buen juego. !");
                                format(Str, sizeof(Str), "{FFFFFF}%04d{FFFFFF} report {FFFFFF}%04d{FFFFFF} Motivo: {FFFF00}%s", PlayerInfo[playerid][IDF], PlayerInfo[i][IDF], Motivo);
                                SendAdminMessage(-1, Str);
                        }
                }
        }

        return 1;
}

CMD:duda(playerid, params[])
{
        if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global

        if(sscanf(params, "s[56]", Motivo))
                return ErrorMsg(playerid, "USE: /duda [TEXTO]");

        // FIX AUDIT AGENT3 SP-02: 3 bugs corregidos:
        // 1) El format NO tenia %s ni %d. Texto enviado era literal:
        //    "{FF33CC}[/duda]{FFFFFF} {FFFF00}GetPlayerName(playerid, nombre, sizeof(nombre));{FFFFFF} pregunta:"
        //    Ni el nombre del autor ni el texto de la duda aparecian. COMANDO ROTO.
        // 2) Sin cooldown + SendClientMessageToAll: un jugador podia ejecutar
        //    /duda hola 1000 veces/seg y enviar 1000 msgs rotos a TODOS los 500 jugadores.
        //    Vector de flood de chat global + DoS.
        // 3) Cambiar SendClientMessageToAll por SendAdminMessage para que la duda
        //    llegue SOLO a admins (era broadcast innecesario).
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_duda") < 30)
                return ErrorMsg(playerid, "Espera 30s para enviar otra duda.");
        SetPVarInt(playerid, "CD_duda", now);

        new nombre[24];
        GetPlayerName(playerid, nombre, sizeof(nombre));
        format(Str, sizeof(Str),
            "{FF33CC}[/duda]{FFFFFF} {FFFF00}%s (ID %04d){FFFFFF} pregunta: {FFFF00}%s",
            nombre, GetPlayerIdfixo(playerid), Motivo);
        SendAdminMessage(0xFF33CCFF, Str);
        SuccesMsg(playerid, "Tu duda fue enviada a los administradores.");
        return 1;
}


CMD:presos(playerid)
{
        new str[1500], line[128], count = 0;
        strcat(str, "{FFFF00}=== Prisioneros Online ===\n\n");
        foreach(new i: Player)
        {
                if(PlayerInfo[i][pjail] > 0)
                {
                        format(line, sizeof(line), "{FFFF00}%04d{FFFFFF} - Preso por {FFFF00}%d {FFFFFF}segundos [{FFFF00}%d {FFFFFF}minutos]\n", GetPlayerIdfixo(i), PlayerInfo[i][pjail], PlayerInfo[i][pjail] / 60);
                        strcat(str, line);
                        count++;
                }
        }
        if(count == 0)
                strcat(str, "{AAAAAA}No hay presos online.\n");
        else
        {
            new foot[64];
            format(foot, sizeof(foot), "\n{AAAAAA}Total: %d preso(s) online.", count);
            strcat(str, foot);
        }
        ShowPlayerDialog(playerid, DIALOG_PRESOS, DIALOG_STYLE_MSGBOX, "{FF0F0F}Prisioneros", str, "Cerrar", "");
        return 1;
}

// FIX AUDIT LOGIN F1-1: /seradmin DESHABILITADO.
// Este comando permitia auto-ascenderse a admin 7 con solo tener RCON login.
// Si la contrasena RCON se filtraba, un atacante podia obtener admin 7 sin
// ser el dueno legitimo del servidor (takeover total).
// Como el GM ya tiene el mecanismo DUENO_SV (#define en linea 36, aplicado
// case-sensitive en F0-1) que asigna admin 7 automaticamente al dueno al
// conectar con el nick exacto, /seradmin es REDUNDANTE y un vector de
// ataque innecesario.
//
// COMO SE HACE EL PRIMER ADMIN (mecanismo DUENO_SV):
//   1. Editar #define DUENO_SV "Nikon_Gavrilovich" en linea 36 con el nick
//      EXACTO del dueno (case-sensitive: importa mayusculas/minusculas).
//   2. El dueno conecta con ese nick -> OnPlayerConnect L22119 detecta el
//      nick, asigna pAdmin=7. TxdLogin L5849 re-confirma pAdmin=7.
//   3. El dueno se registra (DIALOG_REGISTRO) -> crea Contas/<nick>.ini y
//      Admins/<nick>.ini con AdminLevel=7.
//   4. A partir de aqui, el dueno puede usar /setadmin para ascender a
//      otros jugadores (con jerarquia F0-3: nadie puede modificar a un
//      admin de nivel igual o superior, excepto el DUENO_SV que tiene
//      maximo permiso absoluto).
//
// COMO VOLVER A HABILITAR /seradmin (si en el futuro se necesita):
//   Quitar el /* de la linea siguiente y el */ antes de CMD:pos. Esto
//   rehabilita el comando TAL CUAL estaba antes de F1-1. Sin embargo, NO
//   se recomienda: el mecanismo DUENO_SV + /setadmin con jerarquia cubre
//   todos los casos legitimos sin exponer el vector de RCON leak.
/*
CMD:seradmin(playerid)
{
        if(!IsPlayerAdmin(playerid))
                return ErrorMsg(playerid, "No tienes permisos de RCON. Usa /rcon login [contrasena] primero.");

        PlayerInfo[playerid][pAdmin] = 7;
        SuccesMsg(playerid, "Conectado como Desarollador.");
        pJogando[playerid] = false;

        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[SERADMIN] %s (ID%04d) se autoasigno pAdmin 7 via RCON.", PlayerName(playerid), PlayerInfo[playerid][IDF]);
        Log("Logs/Seradmin.ini", logmsg);
        return 1;
}
*/

CMD:pos(playerid, params[])
{
        new msg[500];
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params, "s[56]", msg))return ErrorMsg(playerid,"Use /pos [nomedolocal].");

        static
                Float: x,
                Float: y,
                Float: z,
                Float: a
        ;
        GetPlayerPos(playerid, x,y,z);
        GetPlayerFacingAngle(playerid, a);
        static
                string[200]
        ;
        string[0] = '\0';
        format(string, 200, "{%f, %f, %f, %f},//%s\n", x,y,z,a,msg);
        {
                static
                        File: Account
                ;
                Account = fopen("pos.txt", io_append);
                fwrite(Account, string);
                fclose(Account);
        }
        format(string, 200, "%f,%f,%f,%f //%s", x,y,z,a,msg);
        SendClientMessage(playerid, -1, string);
        return true;
}

CMD:ca(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        if(sscanf(params, "s[56]", Motivo))                                                     return ErrorMsg(playerid, "USE: /ca [TEXTO]");
        //
        format(Str, sizeof(Str), "{FFFFFF}[{FFFF00}%s{FFFFFF}] {FFFF00}%s{FFFFFF}({FFFF00}%04d{FFFFFF}) dice {FFFF00}%s", AdminCargo(playerid), Name(playerid),PlayerInfo[playerid][IDF], Motivo);
        SendAdminMessage(0xDDA0DDFF, Str);
        return 1;
}
// Alias backward-compat: /a sigue funcionando como /ca (chat admin) para no romper scripts externos.
CMD:a(playerid, params[]) return cmd_ca(playerid, params);

// Comando /aa: anuncio admin (antes era /av).
// FIX: antes solo usaba ShowNotify (notificacion flotante) que mostraba el texto
// por 4 segundos y desaparecia sin que el jugador pudiera leerlo completo.
// Ahora envia el mensaje por CHAT (visible permanentemente en el historial)
// ademas de la notificacion visual, para que se pueda leer correctamente.
CMD:aa(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        // FIX AUDIT2 AGENT4 S-17: cooldown 10s via PVar CD_aa. Sin esto, un admin
        // deshonesto podia spamear /aa y floodar el chat de TODOS los jugadores
        // (broadcast global via foreach + SendClientMessage + AvMsg).
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_aa") < 10)
                return ErrorMsg(playerid, "Espera 10s para otro anuncio.");
        if(sscanf(params, "s[128]", Motivo))                                            return ErrorMsg(playerid, "USE: /aa [TEXTO]");
        SetPVarInt(playerid, "CD_aa", now); // FIX AUDIT7 UX-1: mover SetPVarInt despues de sscanf
        new annMsg[180];
        format(annMsg, sizeof(annMsg), "{FF0000}[ANUNCIO ADMIN]{FFFF00} %s {FFFFFF}({FFFF00}%s{FFFFFF})", Motivo, Name(playerid));
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && pLogado[i])
                {
                        SendClientMessage(i, 0xFFAA00FF, annMsg);
                        // Notificacion visual adicional (opcional, ahora solo para alertar)
                        AvMsg(i, Motivo);
                }
        }
        new logAA[180];
        format(logAA, sizeof(logAA), "[AA] Admin %s (IDF %d): %s", Name(playerid), PlayerInfo[playerid][IDF], Motivo);
        Log("Logs/AdminAcciones.ini", logAA);
        SuccesMsg(playerid, "Anuncio enviado.");
        return 1;
}
// Alias backward-compat: /av sigue funcionando como /aa para no romper scripts externos.
CMD:av(playerid, params[]) return cmd_aa(playerid, params);

CMD:setskin(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "di", ID, Numero))                                            return ErrorMsg(playerid, "USE: /setskin [ID] [SKIN ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes cambiar la skin a un admin de igual o mayor nivel."); // FIX AUDIT
                                PlayerInfo[i][pSkin] = Numero;
                                SetPlayerSkin(i, Numero);
                                SalvarDadosSkin(i);
                                SuccesMsg(playerid, "Le cambiaste la skin a un jugador.");
                                InfoMsg(i, "un administrador te dio una skin.");
                        }
                }
        }

        return 1;
}

CMD:setvida(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "dd", ID, Numero))                                            return ErrorMsg(playerid,"USE: /setvida [ID] [VIDA]");
        if(Numero < 0) Numero = 0; // Fix: clamp minimo, evita valores negativos
        if(Numero > 100) Numero = 100; // Fix: clamp maximo, evita valores fuera de rango de vida
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes cambiar la vida a un admin de igual o mayor nivel."); // FIX AUDIT
                                SetPlayerHealth(i, Numero);
                                SuccesMsg(playerid, "Le diste vida a un jugador.");
                                InfoMsg(i, "un administrador te dio vida.");
                        }
                }
        }

        return 1;
}

CMD:setchaleco(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "dd", ID, Numero))                                            return ErrorMsg(playerid,"USE: /setchaleco [ID] [CHALECO]");
        // FIX AUDIT AC-H6: clamp Numero para evitar valores absurdos.
        // Antes: SetPlayerArmour(i, Numero) aceptaba cualquier valor. Si Numero > 100,
        // el AC anti-armour hack lo detectaba como hack y kickeaba al destinatario
        // (griefing). Si Numero < 0, SetPlayerArmour hacia cosas raras.
        // Ahora: clamp [0, 100] para que sea consistente con el maximo del juego.
        if(Numero < 0) Numero = 0;
        if(Numero > 100) Numero = 100;
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes cambiar el chaleco a un admin de igual o mayor nivel."); // FIX AUDIT
                                // FIX AUDIT AC-H6: setear g_ChalecoPermitido=true antes de SetPlayerArmour.
                                // Antes: SetPlayerArmour sin g_ChalecoPermitido=true causaba que el
                                // AC anti-armour hack strikeara al destinatario (armour > 0 sin
                                // permiso = strike + reset armour a 0). El admin daba chaleco pero
                                // el AC lo quitaba en 33ms = griefing al destinatario.
                                // Ahora: setear g_ChalecoPermitido=true para eximir el check AC.
                                if(Numero > 0) g_ChalecoPermitido[i] = true;
                                SetPlayerArmour(i, Numero);
                                SuccesMsg(playerid, "Estableciste el chaleco del jugador.");
                                InfoMsg(i, "Un Administrador te dio chaleco.");
                        }
                }
        }

        return 1;
}

CMD:cv(playerid, params[])
{
        //
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)             return ErrorMsg(playerid, "No puedes crear 2 vehiculos.");
        if(sscanf(params, "i", Numero))                         return ErrorMsg(playerid, "USE: /cv [ID]");
        if(Numero < 400 || Numero > 611)                                                        return ErrorMsg(playerid, "ID no valido.");
        GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
        if(VehAlugado[playerid] == 0)
        {
                VehAlugado[playerid] = 1;
                VeiculoCivil[playerid] = CreateVehicle(Numero, Pos[0], Pos[1], Pos[2], 90, 5, 5, false);
                PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                InfoMsg(playerid, "Para devolver su vehiculo use /dvehiculo.");
        }
        else
        {
                InfoMsg(playerid, "ya tienes un vehiculo use /dvehiculo.");
        }
        return 1;
}

CMD:delvehiculo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7)                                    return ErrorMsg(playerid, "No tienes permisos.");
        new vid, targetid = INVALID_PLAYER_ID;
        // Si el admin esta dentro de un vehiculo, destruye ese vehiculo
        if(IsPlayerInAnyVehicle(playerid))
        {
                vid = GetPlayerVehicleID(playerid);
                RemovePlayerFromVehicle(playerid);
                // Sacar a todos los pasajeros del vehiculo antes de destruirlo
                foreach(new i : Player)
                {
                        if(GetPlayerVehicleID(i) == vid)
                                RemovePlayerFromVehicle(i);
                }
                DestroyVehicle(vid);
                SuccesMsg(playerid, "Vehiculo eliminado correctamente.");
        }
        // Si se pasa un ID de jugador por parametro, elimina el vehiculo de ese jugador
        else if(!sscanf(params, "d", targetid))
        {
                foreach(new i : Player)
                {
                        if(pLogado[i] == true && PlayerInfo[i][IDF] == targetid)
                        {
                                if(VeiculoCivil[i] != INVALID_VEHICLE_ID && IsValidVehicle(VeiculoCivil[i]))
                                {
                                        vid = VeiculoCivil[i];
                                        if(IsPlayerInAnyVehicle(i)) RemovePlayerFromVehicle(i);
                                        DestroyVehicle(vid);
                                        VeiculoCivil[i] = INVALID_VEHICLE_ID;
                                        VehAlugado[i] = 0;
                                        InfoMsg(i, "Un administrador elimino tu vehiculo.");
                                        SuccesMsg(playerid, "Vehiculo del jugador eliminado.");
                                }
                                else
                                {
                                        ErrorMsg(playerid, "Ese jugador no tiene un vehiculo activo.");
                                }
                        }
                }
        }
        else
        {
                ErrorMsg(playerid, "USE: /delvehiculo  -  Estando dentro del vehiculo, o /delvehiculo [ID] para el vehiculo de otro jugador.");
        }
        return 1;
}

CMD:kick(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff"); // FIX AUDIT4 ADM3-05/06
        if(sscanf(params, "ds[56]", ID, Motivo))                                        return ErrorMsg(playerid,"USE: /kick [ID] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes expulsar a un admin de igual o mayor nivel."); // FIX AUDIT: jerarquia admin
                                SuccesMsg(playerid, "Expulsaste a un jugador.");
                                InfoMsg(i, "Un administrador te expulso.");
                                format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} El jugador {FFFF00}%04d {FFFFFF}fue expulsado por un administrador {FFFF00}%s{FFFFFF}. Motivo: {FFFF00}%s", GetPlayerIdfixo(i), Name(playerid), Motivo);
                                SendClientMessageToAll(-1, Str);
                                new logKick[256]; // FIX AUDIT4 ADM3-05/06
                                format(logKick, sizeof(logKick), "[KICK] Admin: %s (IDF %04d) -> Jugador: %s (IDF %04d) | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Motivo);
                                Log("Logs/AdminAcciones.ini", logKick);
                                Kick(i);
                        }
                }
        }

        return 1;
}

CMD:jail(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "iis[56]", ID, Numero, Motivo))                       return ErrorMsg(playerid,"USE: /jail [ID] [TIEMPO EN MINUTOS] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes encarcelar a un admin de igual o mayor nivel."); // FIX AUDIT
                                if(Numero != 0)
                                {
                                        PlayerInfo[i][pjail] = Numero * 60;
                                        // FIX AUDIT-AUDIT6-S-ALTO-001 (ALTO): cleanup autoescuela antes de jail (state leak si jailed mid-exam).
                                        // ANTES: si el admin encarcela a un jugador que esta en medio de un examen de autoescuela,
                                        // el vehiculo de examen quedaba zombie 40min, el timer 1s corria infinitamente, y el flag
                                        // IniciouTesteHabilitacaoX quedaba en 1 (soft-lock al reconnectar). Ahora: cleanup completo.
                                        AutoEscola_FlushPlayer(i);
                                        // P0-PN-3: asignar celda libre en vez de coordenada fija
                                        new adminCell = AssignJailCell(i);
                                        if(adminCell >= 0)
                                        {
                                                SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-08: inmunidad anti-teleport al encarcelar
                                                SetPlayerPos(i, g_JailCells[adminCell][0], g_JailCells[adminCell][1], g_JailCells[adminCell][2]);
                                        }
                                        else
                                        {
                                                SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-08: inmunidad anti-teleport (fallback)
                                                SetPlayerPos(i, g_JailCells[0][0], g_JailCells[0][1], g_JailCells[0][2]); // fallback si todas ocupadas
                                        }
                                        SetPlayerInterior(i, 5);
                                        SetPlayerVirtualWorld(i, 0);
                                        TogglePlayerControllable(i, false);
                                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                                }
                                else
                                {
                                        PlayerInfo[i][pjail] = 1;
                                }
                                SuccesMsg(playerid, "Sancionaste a un jugador.");
                                InfoMsg(i, "Un administrador te sanciono.");
                                format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} EL Administrador {FFFF00}%s {FFFFFF}sanciono a {FFFF00}%04d {FFFFFF}por {FFFF00}%i {FFFFFF}minutos. Motivo: {FFFF00}%s", Name(playerid), GetPlayerIdfixo(i), Numero, Motivo);
                                SendClientMessageToAll(-1, Str);
                        }
                }
        }

        return 1;
}

// FIX AUDIT ASSIGNJAILCELL: /unjail para liberar preso manualmente
CMD:unjail(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "i", ID)) return ErrorMsg(playerid, "USE: /unjail [ID del jugador]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true && PlayerInfo[i][IDF] == ID)
                {
                        if(PlayerInfo[i][pjail] <= 0) return ErrorMsg(playerid, "Ese jugador no esta en jail.");
                        PlayerInfo[i][pjail] = 0;
                        FreeJailCell(i);
                        SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-08: inmunidad anti-teleport al liberar de jail
                        SetPlayerPos(i, 1685.698608, -2334.948730, 13.546875);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        SetPlayerHealth(i, 100);
                        TogglePlayerControllable(i, true);
                        PlayerInfo[i][pCongelado] = false;
                        RemovePlayerAttachedObject(i, 5);
                        SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
                        SalvarDados(i);
                        InfoMsg(i, "Un administrador te libero de jail.");
                        new msgAdmin[128];
                        format(msgAdmin, sizeof(msgAdmin), "Liberaste a %04d de jail.", ID);
                        SuccesMsg(playerid, msgAdmin);
                        printf("[P0-UNJAIL] Admin %d libero a jugador %d (IDF %d) de jail", playerid, i, ID);
                        return 1;
                }
        }
        ErrorMsg(playerid, "Jugador no encontrado.");
        return 1;
}

CMD:ir(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "d", ID))                                                                     return ErrorMsg(playerid,"USE: /ir [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel."); // FIX AUDIT4 ADM3-04
                                GetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                                if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                                {
                                        SetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
                                        TogglePlayerControllable(playerid, false);
                                        SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                }
                                else
                                {
                                        SetVehiclePos(GetPlayerVehicleID(playerid), Pos[0], Pos[1], Pos[2]);
                                }
                                SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(i));
                                SetPlayerInterior(playerid, GetPlayerInterior(i));
                                // ANTI-CHEAT: inmunidad temporal de TP
                                SetPVarInt(i, "ACTPImmune", gettime());
                                SetPVarInt(playerid, "ACTPImmune", gettime());
                                SuccesMsg(playerid, "Fuiste donde un jugador.");
                                InfoMsg(i, "un administrador fue a tu ubicacion.");
                        }
                }
        }
        return 1;
}

CMD:irpos(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new Float:X, Float:Y, Float:Z;
        if(sscanf(params, "fff", X, Y, Z)) return ErrorMsg(playerid, "USE: /irpos [X] [Y] [Z]");
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
                SetVehiclePos(GetPlayerVehicleID(playerid), X, Y, Z);
        }
        else
        {
                SetPlayerPos(playerid, X, Y, Z);
                SetPlayerInterior(playerid, 0);
                SetPlayerVirtualWorld(playerid, 0);
                TogglePlayerControllable(playerid, false);
                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
        }
        // ANTI-CHEAT: inmunidad temporal de TP
        SetPVarInt(playerid, "ACTPImmune", gettime());
        new msgPos[128];
        format(msgPos, sizeof(msgPos), "Teletransportado a: X:%.2f Y:%.2f Z:%.2f", X, Y, Z);
        SuccesMsg(playerid, msgPos);
        return 1;
}

CMD:spawnar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "d", ID))                                                                     return ErrorMsg(playerid,"USE: /spawnar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel."); // FIX AUDIT4 ADM3-04
                                FreeJailCell(i); // FIX AUDIT ASSIGNJAILCELL: liberar celda antes de teleport
                                SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-01: inmunidad anti-teleport para evitar kick del objetivo
                                SetPlayerPos(i, 1568.130615, -1891.800415, 13.559370);
                                SetPlayerInterior(i, 0); // FIX: resetear interior
                                SetPlayerVirtualWorld(i, 0); // FIX: resetear VW
                                TogglePlayerControllable(i, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", i);
                                SuccesMsg(playerid, "Mandaste a un jugador al spawn.");
                                InfoMsg(i, "un administrador te mando al spawn.");
                        }
                }
        }
        return 1;
}

CMD:traer(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "d", ID))                                                                     return ErrorMsg(playerid,"USE: /traer [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel."); // FIX AUDIT4 ADM3-04
                                GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
                                if(GetPlayerState(i) != PLAYER_STATE_DRIVER)
                                {
                                        FreeJailCell(i); // FIX AUDIT ASSIGNJAILCELL: liberar celda antes de teleport
                                        SetPlayerPos(i, Pos[0], Pos[1], Pos[2]);
                                        TogglePlayerControllable(i, false);
                                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                                }
                                else
                                {
                                        SetVehiclePos(GetPlayerVehicleID(i), Pos[0], Pos[1], Pos[2]);
                                }
                                // ANTI-CHEAT: inmunidad temporal de TP
                                SetPVarInt(i, "ACTPImmune", gettime());
                                SuccesMsg(playerid, "Trajiste a un jugador.");
                                InfoMsg(i, "un Administrador te llevo a la ubicacion de el.");
                        }
                }
        }

        return 1;
}

CMD:conteo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "i", ID))                                                             return ErrorMsg(playerid,"ERRO: Use /Conteo [VALOR INICIAL]");
        if(ID < 1 || ID > 20)                                                                           return ErrorMsg(playerid, "20s e o maximo.");
        if(ConteoIniciada == true)
        {
                ErrorMsg(playerid, "{FFFF00}AVISO{FFFFFF} Conteo");
        }
        else
        {
                format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} O Administrador: {FFFF00}%s {FFFFFF}comenzo un Conteo {FFFF00}%i {FFFFFF}segundos.", Name(playerid), ID);
                SendClientMessageToAll(-1, Str);
                SetTimerEx("DiminuirTempo", 1000, false, "i", ID);
                ConteoIniciada = true;
                //
                Log("Logs/Conteo.ini", Str);
        }
        return 1;
}

CMD:spect(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(IsAssistindo[playerid] == false)
        {
                // FIX AUDIT-AUDIT6-S-ALTO-011 (ALTO): cleanup autoescuela antes de spectate.
                // ANTES: admin que hacia /spec mid-examen dejaba estado zombie (timer 1s activo,
                // vehiculo flotando 40min, flag IniciouTesteHabilitacaoX=1). Al cancelar spec,
                // el jugador podia retomar el examen evadiendo el tiempo de spectate.
                AutoEscola_FlushPlayer(playerid);
                if(sscanf(params, "i", ID))                                                             return ErrorMsg(playerid,"USE: /spec [ID]");
                foreach(new i : Player)
                {
                        if(pLogado[i] == true)
                        {
                                if(PlayerInfo[i][IDF] == ID)
                                {
                                        if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel."); // FIX AUDIT4 ADM3-04
                                        if(!IsPlayerInAnyVehicle(i))
                                        {
                                                TogglePlayerSpectating(playerid, 1);
                                                PlayerSpectatePlayer(playerid, i);
                                        }
                                        else
                                        {
                                                TogglePlayerSpectating(playerid, 1);
                                                PlayerSpectateVehicle(playerid, GetPlayerVehicleID(i));

                                        }
                                        SetPlayerInterior(playerid, GetPlayerInterior(i));
                                        SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(i));
                                        Assistindo[playerid] = i;
                                        IsAssistindo[playerid] = true;
                                }
                        }
                }

        }
        else
        {
                TogglePlayerSpectating(playerid, 0);
                IsAssistindo[playerid] = false;
                Assistindo[playerid] = -1;
        }
        return 1;
}

// FIX FEATURE-INVESTIGACION-COMBATE: alias /spec para que las alertas
// "[ALERTA DISPARO] ... | /spec IDF" y "[KILL ALERT] ... | /spec IDF"
// funcionen correctamente. Antes el comando real era /spect (CMD:spect)
// pero los mensajes de alerta y la ayuda /ajuda usaban /spec, causando
// "Unknown command" cuando un admin hacia /spec <IDF>. Ahora ambos
// funcionan como alias del mismo handler.
CMD:spec(playerid, params[])
{
        return cmd_spect(playerid, params);
}

CMD:setarma(playerid, params[])
{
        new Municao, Arma;
        if(PlayerInfo[playerid][pAdmin] < 6)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "iii", ID, Arma, Municao))                            return ErrorMsg(playerid,"USE: /setarma [ID] [ARMA] [MUNICION]");
        if(Arma<1 || Arma==19 || Arma==20||Arma==21||Arma>46)           return ErrorMsg(playerid, "ID no valido.");
        // FIX AUDIT AGENT1 WC-09: validar arma contra blocklist antes de dar.
        // La validacion real se hace dentro del foreach una vez encontrado el
        // slot del target (AC_IsWeaponAllowed requiere el slot del jugador, no IDF).
        // Sin esto, un admin podia dar minigun (38) o rocket (35/36) a un civil.
        // El AC de OnPlayerUpdate lo kickeaba al instante.
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes dar armas a un admin de igual o mayor nivel."); // FIX AUDIT
                                if(!AC_IsWeaponAllowed(i, Arma))
                                        return ErrorMsg(playerid, "Esa arma esta prohibida para el jugador objetivo.");
                                GivePlayerWeapon(i, Arma, Municao);
                                SuccesMsg(playerid, "Le diste una arma a un jugador.");
                                InfoMsg(i, "Un admistrador te dio una arma.");
                        }
                }
        }
        return 1;
}

CMD:desarmar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "d", ID))                                                                     return ErrorMsg(playerid,"USE: /desarmar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes desarmar a un admin de igual o mayor nivel."); // FIX AUDIT
                                ResetPlayerWeapons(i);
                                // FIX AUDIT4 PERS-CRIT-05: persistir el reseteo de armas
                                // inmediatamente. Sin esto, si el servidor crashea antes
                                // del proximo SalvarArmas (disconnect), el jugador recupera
                                // las armas confiscadas desde PASTA_SAVEARMAS = DUPE.
                                SalvarArmas(i);
                        SuccesMsg(playerid, "Removiste las armas de un jugador.");
                                InfoMsg(i, "Un administrador te quito tus armas.");
                        }
                }
        }

        return 1;
}

CMD:ban(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "is[56]", ID, Motivo))                                        return ErrorMsg(playerid,"ERRO: Use /ban [ID] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes banear a un admin de igual o mayor nivel."); // FIX AUDIT
                                SuccesMsg(playerid, "Baneaste a un jugador.");
                                InfoMsg(i, "Un administrador te baneo.");
                                new logBan[256]; // FIX AUDIT4 ADM3-05/06
                                format(logBan, sizeof(logBan), "[BAN] Admin: %s (IDF %04d) -> Jugador: %s (IDF %04d) | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Motivo);
                                Log("Logs/AdminAcciones.ini", logBan);

                                BanirPlayer(i, playerid, Motivo);
                                BanirIP(i, playerid, Motivo);
                        }
                }
        }

        return 1;
}

CMD:tempban(playerid,params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new Dias;
        if(sscanf(params, "iis[56]", ID, Dias, Motivo))                         return ErrorMsg(playerid,"ERRO: Use /tempban [ID] [TEMPO] [MOTIVO]");
        if(Dias == 0)                                               return ErrorMsg(playerid, "No puedes banear a alguien durante 0 dias. USA: /ban para banear permanente.");
        if(Dias >= 360)                                             return ErrorMsg(playerid, "Maximo de baneo es de 360 dias.");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes banear a un admin de igual o mayor nivel."); // FIX AUDIT
                                new Data[24], Dia, Mes, Ano, Hora, Minuto;
                                gettime(Hora, Minuto);
                                getdate(Ano, Mes, Dia);
                                format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
                                format(File, sizeof(File), PASTA_BANIDOS, Name(i));
                                DOF2_CreateFile(File);
                                DOF2_SetString(File, "Administrador", Name(playerid));
                                DOF2_SetString(File, "Motivo", Motivo);
                                DOF2_SetString(File, "Data", Data);
                                Dia += Dias;
                                if(Mes == 1 || Mes == 3 || Mes == 5 || Mes == 7 || Mes == 8 || Mes == 10 || Mes == 12)
                                {
                                        if(Dia > 31)
                                        {
                                                Dia -= 31;
                                                Mes++;
                                                if(Mes > 12) Mes = 1;
                                        }
                                }
                                if(Mes == 4 || Mes == 6 || Mes == 9 || Mes == 11)
                                {
                                        if(Dia > 30)
                                        {
                                                Dia -= 30;
                                                Mes++;
                                        }
                                }
                                if(Mes == 2)
                                {
                                        if(Dia > 28)
                                        {
                                                Dia-=28;
                                                Mes++;
                                        }
                                }
                                format(Data, 24, "%02d/%02d/%d - %02d:%02d", Dia, Mes, Ano, Hora, Minuto);
                                DOF2_SetString(File, "Desban", Data);
                                DOF2_SetInt(File, "DDesban", gettime() + 60 * 60 * 24 * Dias);
                                DOF2_SaveFile();
                                format(Str, sizeof(Str), "{FFFF00}ADMIN{FFFFFF} El jugador {FFFF00}%04d {FFFFFF}fue baneado por {FFFF00}%i {FFFFFF}dias por el administrador {FFFF00}%s{FFFFFF}. Motivo: {FFFF00}%s", GetPlayerIdfixo(i), Dias, Name(playerid), Motivo);
                                SendClientMessageToAll(-1, Str);
                                new logTempban[256]; // FIX AUDIT4 ADM3-05/06
                                format(logTempban, sizeof(logTempban), "[TEMPBAN] Admin: %s (IDF %04d) -> Jugador: %s (IDF %04d) | Dias: %d | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Dias, Motivo);
                                Log("Logs/AdminAcciones.ini", logTempban);
                                BanirIP(i, playerid, Motivo);
                                Kick(i);
                        }
                }
        }

        return 1;
}

CMD:antiafk(playerid, params[])
{
        // FIX AUDIT AGENT4 AFK-12: AntiAFK_Ativado es ahora per-jugador. /antiafk sin
        // params afecta solo al admin. /antiafk [ID] afecta al jugador objetivo.
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        new targetID = playerid; // por defecto, se aplica a si mismo
        if(!isnull(params))
        {
                if(sscanf(params, "i", targetID)) return ErrorMsg(playerid, "USE: /antiafk [ID opcional]");
                if(!IsPlayerConnected(targetID) || !pLogado[targetID]) return ErrorMsg(playerid, "Jugador no conectado.");
        }
        // FIX AUDIT AFK H10: log de auditoria para /antiafk.
        // Antes: un admin lvl 6+ podia desactivar AFK para si mismo o cualquier jugador
        // sin dejar rastro. Esto permitia farmear PayDay indefinidamente sin deteccion.
        // Ahora: cada uso de /antiafk se loguea en Logs/AntiAFKAdmin.log con timestamp,
        // admin (nombre, IDF, playerid), target (nombre, IDF, playerid), y accion.
        new action[16];
        new logLine[256];
        new File:f = fopen("Logs/AntiAFKAdmin.log", io_append);
        if(f)
        {
                if(AntiAFK_Ativado[targetID])
                        format(action, sizeof(action), "DESACTIVADO");
                else
                        format(action, sizeof(action), "ACTIVADO");
                format(logLine, sizeof(logLine), "[%d] Admin %s (IDF %04d, ID %d) %s AntiAFK para %s (IDF %04d, ID %d)\r\n",
                        gettime(),
                        PlayerName(playerid), PlayerInfo[playerid][IDF], playerid,
                        action,
                        PlayerName(targetID), PlayerInfo[targetID][IDF], targetID);
                fwrite(f, logLine);
                fclose(f);
        }
        if(AntiAFK_Ativado[targetID])
        {
                AntiAFK_Ativado[targetID] = false;
                new msg[128];
                format(msg, sizeof(msg), "Anti-AFK desactivado para %s (ID %d).", PlayerName(targetID), targetID);
                SuccesMsg(playerid, msg);
        }
        else
        {
                AntiAFK_Ativado[targetID] = true;
                new msg[128];
                format(msg, sizeof(msg), "Anti-AFK activado para %s (ID %d).", PlayerName(targetID), targetID);
                SuccesMsg(playerid, msg);
        }
        return 1;
}

CMD:agendaban(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new Nome[24], tempo;
        if(sscanf(params, "s[56]is[56]", Nome, tempo, Motivo))          return ErrorMsg(playerid,"ERRO: Use /agendarban [CUENTA] [TIEMPO EN DIAS (999 = FOREVER)] [MOTIVO]");
        // FIX AUDIT4 ADM3-02: sanitizar path traversal. Nome se usa como
        // componente de path en PASTA_CONTAS; sin esto un admin podria
        // escribir fuera del directorio de cuentas ("../X" o "/etc/X").
        if(strfind(Nome, "..", true) != -1 || strfind(Nome, "/", true) != -1 || strfind(Nome, "\\", true) != -1)
            return ErrorMsg(playerid, "Nombre invalido.");
        format(File, sizeof(File), PASTA_CONTAS, Nome);
        if(!DOF2_FileExists(File))                                                      return ErrorMsg(playerid, "Cuenta no existente.");
        format(Str, sizeof(Str), "Agendado - %s", Motivo);
        AgendarBan(Nome, playerid, Str, tempo);
        format(Str, sizeof(Str), "{FFFF00}ADMIN{FFFFFF}O Administrador {FFFF00}%s {FFFFFF}programou a {FFFF00}%s {FFFFFF} um ban. Motivo: {FFFF00}%s", Name(playerid), Nome, Motivo);
        SendClientMessageToAll(-1, Str);
        new logAgendaBan[256]; // FIX AUDIT4 ADM3-05/06
        format(logAgendaBan, sizeof(logAgendaBan), "[AGENDABAN] Admin: %s (IDF %04d) -> Cuenta: %s | Dias: %d | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Nome, tempo, Motivo);
        Log("Logs/AdminAcciones.ini", logAgendaBan);

        SuccesMsg(playerid, "Para cancelar um ban, pede a alguem..");
        return 1;
}

CMD:agendajail(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permiso.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new Nome[24];
        if(sscanf(params, "s[56]is[56]", Nome, ID,  Motivo))            return ErrorMsg(playerid,"ERRO: Use /agendarjail [CUENTA] [TIEMPO EN MINUTOS] [MOTIVO]");
        // FIX AUDIT4 ADM3-02: sanitizar path traversal. Nome se usa como
        // componente de path en PASTA_CONTAS; sin esto un admin podria
        // escribir fuera del directorio de cuentas ("../X" o "/etc/X").
        if(strfind(Nome, "..", true) != -1 || strfind(Nome, "/", true) != -1 || strfind(Nome, "\\", true) != -1)
            return ErrorMsg(playerid, "Nombre invalido.");
        new ID1 = GetPlayerID(Nome);
        if(IsPlayerConnected(ID1))                                  return ErrorMsg(playerid, "Jugador esta online use /jail.");
        format(File, sizeof(File), PASTA_CONTAS, Nome);
        if(!DOF2_FileExists(File))                                                      return ErrorMsg(playerid, "Cuenta no existente.");
        format(Str, sizeof(Str), "AdmCmd: {FFFFFF}EL Administrador {FFFF00}%s{FFFFFF} sanciono a {FFFF00}%s {FFFFFF}para cumprir {FFFF00}%i {FFFFFF}minutos de jail. Motivo: {FFFF00}%s", Name(playerid), Nome, ID, Motivo);
        SendClientMessageToAll(-1, Str);
        new logAgendaJail[256]; // FIX AUDIT4 ADM3-05/06
        format(logAgendaJail, sizeof(logAgendaJail), "[AGENDAJAIL] Admin: %s (IDF %04d) -> Cuenta: %s | Minutos: %d | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Nome, ID, Motivo);
        Log("Logs/AdminAcciones.ini", logAgendaJail);

        Agendarjail(Nome, ID, playerid, Motivo);
        if(ID > 0) ErrorMsg(playerid, "DICA: Para cancelar um agendamento de jail use valores negativos no Tempo.");
        return 1;
}

CMD:mute(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff.");
        if(sscanf(params, "is[64]", ID, Motivo))                                        return ErrorMsg(playerid, "USE: /mute [ID] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin])       return ErrorMsg(playerid, "No puedes mutear a un admin de igual o mayor nivel.");
                                if(PlayerInfo[i][pCalado] == true)                                                      return ErrorMsg(playerid, "Este jugador ya esta muteado. Usa /unmute para quitarle el mute.");
                                PlayerInfo[i][pCalado] = true;
                                SalvarDados(i);
                                format(Str, sizeof(Str), "{FFFF00}ADMIN{FFFFFF} El administrador {FFFF00}%s{FFFFFF} muteo al jugador {FFFF00}%04d{FFFFFF}. Motivo: {FFFF00}%s", Name(playerid), PlayerInfo[i][IDF], Motivo);
                                SendClientMessageToAll(-1, Str);
                                InfoMsg(i, "Has sido muteado. No puedes hablar en el chat.");
                                new logmute[256];
                                format(logmute, sizeof(logmute), "[MUTE] Admin: %s (ID%04d) -> Jugador: %s (ID%04d) | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Motivo);
                                Log("Logs/AdminAcciones.ini", logmute);
                        }
                }
        }
        return 1;
}

CMD:qmute(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff.");
        if(sscanf(params, "i", ID))                                                                     return ErrorMsg(playerid, "USE: /qmute [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pCalado] == false)                                             return ErrorMsg(playerid, "Este jugador no esta muteado.");
                                PlayerInfo[i][pCalado] = false;
                                SalvarDados(i);
                                format(Str, sizeof(Str), "{FFFF00}ADMIN{FFFFFF} El administrador {FFFF00}%s{FFFFFF} desmuteo al jugador {FFFF00}%04d{FFFFFF}.", Name(playerid), PlayerInfo[i][IDF]);
                                SendClientMessageToAll(-1, Str);
                                SuccesMsg(i, "Has sido desmuteado. Ya puedes hablar en el chat.");
                                new logunmute[256];
                                format(logunmute, sizeof(logunmute), "[UNMUTE] Admin: %s (ID%04d) -> Jugador: %s (ID%04d)", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF]);
                                Log("Logs/AdminAcciones.ini", logunmute);
                        }
                }
        }
        return 1;
}

CMD:adv(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff"); // FIX AUDIT: staff service check
        if(sscanf(params, "is[56]", ID, Motivo))                                        return ErrorMsg(playerid,"ERRO: Use /adv [ID] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes advertir a un admin de igual o mayor nivel."); // FIX AUDIT: jerarquia admin
                                PlayerInfo[i][pAvisos]++;
                                InfoMsg(i, "Un Administrador Te dio una Advertencia.");
                                SuccesMsg(playerid, "Usted advirtio a un jugador.");
                                if(PlayerInfo[i][pAvisos] == 3)
                                {
                                        format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} el jugador {FFFF00}%04d {FFFFFF} recibio una advertencia de un Administrador {FFFF00}%s {FFFFFF}y fue baneado. {FFFFFF}Motivo: {FFFF00}%s", GetPlayerIdfixo(i), Name(playerid), Motivo);
                                        SendClientMessageToAll(-1, Str);
                                        BanirPlayer(i, playerid, "Supero el limite de advertencias");
                                }
                        }
                }
        }

        return 1;
}

CMD:banip(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 4)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "is[56]", ID, Motivo))                                        return ErrorMsg(playerid,"ERRO: Use /banirip [ID] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                SuccesMsg(playerid, "Usted baneo de ip a un jugador.");
                                InfoMsg(i, "Un administrador baneo tu ip.");
                                new logBanIP[256]; // FIX AUDIT4 ADM3-05/06
                                format(logBanIP, sizeof(logBanIP), "[BANIP] Admin: %s (IDF %04d) -> Jugador: %s (IDF %04d) | Motivo: %s", Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Motivo);
                                Log("Logs/AdminAcciones.ini", logBanIP);
                                BanirIP(i, playerid, Motivo);
                        }
                }
        }

        return 1;
}

CMD:admins(playerid, params[])
{
    if(pLogado[playerid] == false)                                              return ErrorMsg(playerid, "Primero debes iniciar sesion.");
    SendClientMessage(playerid, 0x4682B4FF, "Administradores Online:");
    //
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
                    if(PlayerInfo[i][pAdmin] > 0 && pJogando[i] == false)
                    {
                                format(Str, 256, "%s [%s]", Name(i), AdminCargo(i));
                            SendClientMessage(playerid, -1, Str);
                        }
        }
        return 1;
}

// /tra eliminado: era alias redundante de /duty. /traer es el comando de TP de jugador.
CMD:duty(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 2)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == false)
        {
                pJogando[playerid] = true;
                SetPlayerColor(playerid, -1);
                SetPlayerHealth(playerid, 100);
                SetPlayerArmour(playerid, 0);
                SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                SendClientMessageToAll(-1,"");
                SendClientMessageToAll(-1,"");
                format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} el administrador {FFFF00}%s{FFFFFF} El ya no esta trabajando.", Name(playerid));
                SendClientMessageToAll(-1, Str);
                SendClientMessageToAll(-1,"");
                SendClientMessageToAll(-1,"");
        }
        else
        {
                pJogando[playerid] = false;
                SetPlayerColor(playerid, 0xff00ccff);
                SetPlayerHealth(playerid, 9999);
                SetPlayerArmour(playerid, 9999);
                FomePlayer[playerid] = 100;
                SedePlayer[playerid] = 100;
                SetPlayerSkin(playerid, 217);
                SendClientMessageToAll(-1,"");
                SendClientMessageToAll(-1,"");
                format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} el administrador {FFFF00}%s{FFFFFF} esta trabajando.", Name(playerid));
                SendClientMessageToAll(-1, Str);
                SendClientMessageToAll(-1,"");
                SendClientMessageToAll(-1,"");
        }
        return 1;
}

CMD:limpiarchat(playerid)
{
        // FIX AUDIT AGENT3 SP-05: antes sin pAdmin check. Cualquier jugador podia
        // ejecutar /limpiarchat y hacer 50 SendClientMessage a su propio cliente
        // sin cooldown. Auto-DoS visual + ancho de banda consumido.
        // Fix: requerir admin nivel 1+ + cooldown 5s via PVar CD_limpiarchat.
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_limpiarchat") < 5)
                return ErrorMsg(playerid, "Espera 5s para limpiar el chat de nuevo.");
        SetPVarInt(playerid, "CD_limpiarchat", now);
        for(new i = 0; i < 50; i++)
        {
                SendClientMessage(playerid,-1, "   ");
        }
        return 1;
}

CMD:congelar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USE: /congelar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes congelar a un admin de igual o mayor nivel."); // FIX AUDIT
                                TogglePlayerControllable(i, false);
                                PlayerInfo[i][pCongelado] = true;
                        SuccesMsg(playerid, "Congelaste a un jugador.");
                                InfoMsg(i, "Un administrador te congelo.");
                        }
                }
        }

        return 1;
}

CMD:descongelar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USE: /descongelar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                TogglePlayerControllable(i, true);
                                PlayerInfo[i][pCongelado] = false;
                        SuccesMsg(playerid, "Descongelaste a un jugador.");
                                InfoMsg(i, "Un administrador te descongelo.");
                        }
                }
        }

        return 1;
}

CMD:chat(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(ChatLigado == true)
        {
                SuccesMsg(playerid, "Usted desabilito el chat.");
                ChatLigado = false;
        }
        else
        {
                SuccesMsg(playerid, "Habilitaste el chat.");
                ChatLigado = true;
        }
        return 1;
}

CMD:desban(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 4)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "s[56]", Motivo))             return ErrorMsg(playerid,"ERRO: Use /desban [Cuenta - Nombre_Apellido (COMPLETO)]");
        // FIX AUDIT4 ADM3-02: sanitizar path traversal. Motivo se usa como
        // componente de path en PASTA_CONTAS/PASTA_BANIDOS; sin esto un admin
        // podria leer/escribir fuera del directorio de bans ("../X" o "/etc/X").
        if(strfind(Motivo, "..", true) != -1 || strfind(Motivo, "/", true) != -1 || strfind(Motivo, "\\", true) != -1)
            return ErrorMsg(playerid, "Nombre invalido.");
        format(File, sizeof(File), PASTA_CONTAS, Motivo);
        if(!DOF2_FileExists(File))                  return ErrorMsg(playerid, "Esta cuenta no esta baneada.");
        format(File, sizeof(File), PASTA_BANIDOS, Motivo);
        if(!DOF2_FileExists(File))                  return ErrorMsg(playerid, "Esta cuenta no esta baneada");
        new File1[48];
        format(File1, 48, PASTA_BACKUPBAN, Motivo);
        DOF2_CopyFile(File, File1);
        DOF2_RemoveFile(File);
        new logDesban[256]; // FIX AUDIT4 ADM3-05/06
        format(logDesban, sizeof(logDesban), "[DESBAN] Admin: %s (IDF %04d) -> Cuenta: %s", Name(playerid), PlayerInfo[playerid][IDF], Motivo);
        Log("Logs/AdminAcciones.ini", logDesban);
        return 1;
}

CMD:desbanip(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 4)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "s[56]", Motivo))             return ErrorMsg(playerid,"ERRO: Use /desbanip [IP]");
        // FIX AUDIT4 ADM3-02: sanitizar path traversal. Motivo se usa como
        // componente de path en PASTA_BANIDOSIP; sin esto un admin podria
        // leer/escribir fuera del directorio de bans de IP ("../X" o "/etc/X").
        if(strfind(Motivo, "..", true) != -1 || strfind(Motivo, "/", true) != -1 || strfind(Motivo, "\\", true) != -1)
            return ErrorMsg(playerid, "Nombre invalido.");
        format(File, sizeof(File), PASTA_BANIDOSIP, Motivo);
        if(!DOF2_FileExists(File))                  return ErrorMsg(playerid, "ESTA IP NO ESTA BAN.");
        new File1[48];
        format(File1, 48, PASTA_BACKUPBANIP, Motivo);
        DOF2_CopyFile(File, File1);
        DOF2_RemoveFile(File);
        //
        new logDesbanIP[256]; // FIX AUDIT4 ADM3-05/06
        format(logDesbanIP, sizeof(logDesbanIP), "[DESBANIP] Admin: %s (IDF %04d) -> IP: %s", Name(playerid), PlayerInfo[playerid][IDF], Motivo);
        Log("Logs/AdminAcciones.ini", logDesbanIP);
        SuccesMsg(playerid, "IP DESBANEADA CORRECTAMENTE.");
        return 1;
}

CMD:dardinero(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "dd", ID, Numero))            return ErrorMsg(playerid,"USE: /dardinero [ID] [CANTIDAD]");
        if(Numero <= 0) return ErrorMsg(playerid, "La cantidad debe ser mayor a 0."); // FIX AUDIT: exploit cantidad negativa
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                // (admin da dinero a un jugador).
                                AC_AddPlayerMoney(i, Numero);
                                // FIX AUDIT2 AGENT2 M-07: SalvarDados inmediato para
                                // persistir el regalo del admin. Sin esto, si crash antes
                                // del SaveTimer, el regalo se pierde (loss asimetrico).
                                SalvarDados(i);
                        SuccesMsg(playerid, "Usted dio dinero a un jugador.");
                                InfoMsg(i, "un administrador te dio dinero.");
                                new logdd[256];
                                format(logdd, sizeof(logdd), "[DARDINERO] Admin: %s (ID%04d) -> Jugador: %s (ID%04d) | Cantidad: $%d",
                                        Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Numero);
                                Log("Logs/AdminAcciones.ini", logdd);
                        }
                }
        }

        return 1;
}

CMD:quitardinero(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "dd", ID, Numero))            return ErrorMsg(playerid, "USE: /quitardinero [ID] [CANTIDAD]");
        if(Numero <= 0)                                                         return ErrorMsg(playerid, "La cantidad debe ser mayor a 0.");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(PlayerInfo[i][pDinheiro] < Numero)
                                        return ErrorMsg(playerid, "El jugador no tiene suficiente dinero.");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                // (admin quita dinero a un jugador).
                                AC_AddPlayerMoney(i, -Numero);
                                // FIX AUDIT2 AGENT2 M-08: SalvarDados inmediato para
                                // persistir la penalizacion del admin. Sin esto, si
                                // crash antes del SaveTimer, la penalizacion se revierte
                                // (jugador recupera el dinero en disco).
                                SalvarDados(i);
                                SuccesMsg(playerid, "Usted quito dinero a un jugador.");
                                InfoMsg(i, "Un administrador te quito dinero.");
                                new logqd[256];
                                format(logqd, sizeof(logqd), "[QUITARDINERO] Admin: %s (ID%04d) -> Jugador: %s (ID%04d) | Cantidad: $%d",
                                        Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], Numero);
                                Log("Logs/AdminAcciones.ini", logqd);
                        }
                }
        }
        return 1;
}

CMD:setadmin(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 7)            return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        if(sscanf(params, "ii", ID, Numero))            return ErrorMsg(playerid,"USE: /setadmin [ID] [LEVEL]");
        if(Numero < 0 || Numero > 7)                          return ErrorMsg(playerid, "El nivel debe ser entre 0 y 7."); // FIX AUDIT: validar rango [0,7]
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                // FIX AUDIT LOGIN F0-3: Jerarquia de /setadmin.
                                // Antes: cualquier admin 7 podia democionar a OTRO admin 7
                                // (incl. al dueno legitimo), permitiendo takeover total
                                // del servidor si un atacante obtenia admin 7 por cualquier
                                // otro bug. Ahora:
                                //  - Nadie puede modificar a un admin de nivel IGUAL o SUPERIOR.
                                //  - EXCEPCION: el DUENO_SV (Nikon_Gavrilovich por defecto) tiene
                                //    maximo permiso absoluto y puede modificar a cualquier admin.
                                //  - Para cambiar el dueno, edita #define DUENO_SV al inicio
                                //    del GM (linea ~36).
                                // Si en el futuro quieres darle este privilegio a otra persona,
                                // simplemente cambia el #define DUENO_SV a su nick exacto.
                                new duenoName[MAX_PLAYER_NAME];
                                GetPlayerName(playerid, duenoName, sizeof(duenoName));
                                new esDueno = !strcmp(duenoName, DUENO_SV);
                                if(!esDueno && PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin])
                                        return ErrorMsg(playerid, "No puedes modificar a un admin de nivel igual o superior al tuyo.");
                                new nivelAnterior = PlayerInfo[i][pAdmin];
                                PlayerInfo[i][pAdmin] = Numero;
                                // FIX AUDIT4 PERS-CRIT-03: persistir promocion/democion de
                                // admin inmediatamente. Sin esto, si el servidor crashea
                                // antes del SaveTimer, el cambio de pAdmin se pierde.
                                SalvarEvaluacion(i);
                                SuccesMsg(playerid, "Usted le dio administrador a un jugador.");
                                InfoMsg(i, "Ahora eres administrador.");
                                new logsa[256];
                                format(logsa, sizeof(logsa), "[SETADMIN] Admin: %s (ID%04d) -> Jugador: %s (ID%04d) | Nivel: %d -> %d",
                                        Name(playerid), PlayerInfo[playerid][IDF], Name(i), PlayerInfo[i][IDF], nivelAnterior, Numero);
                                Log("Logs/AdminAcciones.ini", logsa);
                                SendAdminMessage(0xFFFF00FF, logsa);
                        }
                }
        }

        return 1;
}

CMD:gmx(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        format(Str, sizeof(Str), "{FFFF00}ANUNCIO{FFFFFF} Se realizara un reinicio al servidor.");
        SendClientMessageToAll(-1, Str);
        // FUEL-ARCHITECTURE: HIGH-3 fix - guardar combustible antes de cerrar
        for(new v = 1; v < MAX_DVEHICLES; v++)
        {
                if(VehicleCreated[v] == VEHICLE_PLAYER) SaveVehicle(v);
        }
        GuardarVehOrg(5);
        GuardarVehOrg(6);
        GuardarVehOrg(7);
        GuardarVehOrg(8);
        GuardarVehOrg(12);
        GuardarVehOrg(13);

        foreach(new i: Player)
        {
                // FIX VERIFY-MONEYAC-2 CRIT-1: antes se llamaba SalvarInventario(playerid),
                // SalvarEvaluacion(playerid), SalvarVIP(playerid) que guardaban el inventario
                // DEL ADMIN que ejecuto /gmx en vez del jugador iterado (i). Esto permitia
                // dup exploit: jugador usa lootbox (item decrementado en memoria pero NO
                // guardado a disco), admin ejecuta /gmx antes del SaveTimer (60s), el
                // inventario del jugador en disco conserva el item original. Al reconectar,
                // el jugador tiene el reward (ya guardado en pDinheiro) Y el item de vuelta.
                if(pLogado[i] == true) SalvarDados(i), SalvarInventario(i), SalvarEvaluacion(i), SalvarVIP(i), SalvarArmas(i), Kick(i);

        }
        SendRconCommand("exit");
        return 1;
}

CMD:vips(playerid)
{
        new string[85];
        new count;
        SendClientMessage(playerid, 0x33AAFFFF, "** Todos los jugadores VIP:");
        foreach(new i: Player)
        {
                if(PlayerInfo[i][ExpiraVIP] > 0)
                {
                        if(IsPlayerConnected(i))
                           {
                                format(string, sizeof(string), "%04d [%s]", GetPlayerIdfixo(i), convertNumber(PlayerInfo[i][ExpiraVIP]-gettime()));
                                SendClientMessage(playerid, 0xE3E3E3FF, string);
                                count++;
                           }
                }
        }
        if(count == 0)
                return ErrorMsg(playerid,  "No hay jugadores vip online!");

        return true;
}

// FIX ALTO-VIP-008 (ALTO): CMD:setvip eliminado (dead code con 3 bugs latentes).
// ANTES: comando comentado con /* ... */ contenia 3 bugs:
//   1. L46144: PlayerInfo[playerid][pVIP] = nivel (deberia ser PlayerInfo[id][pVIP])
//   2. L46145: format args cruzados (days, Name(id)) - parametros en orden incorrecto
//   3. L46152: NO escribe "Level" en VIPS/.ini - solo escribe VipExpira
// Si se descomentaba, causaba bugs graves. /darvip (L2036) ya hace lo mismo correctamente.
// Comando eliminado permanentemente. Si se necesita en el futuro, copiar de /darvip.

CMD:tiendavip(playerid)
{
        new StrCash[550],StrCashh[550], String[500];
        format(StrCashh, sizeof(StrCashh), "{FFFF00}TIENDA {FFFFFF}VIP's\n");
        strcat(StrCash,StrCashh);
        format(StrCashh, sizeof(StrCashh), "{FFFF00}TIENDA {FFFFFF}Vehiculos vip\n");
        strcat(StrCash,StrCashh);
        format(StrCashh, sizeof(StrCashh), "{FFFF00}TIENDA {FFFFFF}Items de Utilidad\n");
        strcat(StrCash,StrCashh);
        format(StrCashh, sizeof(StrCashh), "{FFFF00}TIENDA {FFFFFF}Verifique sus Beneficios\n");
        strcat(StrCash,StrCashh);
        format(StrCashh, sizeof(StrCashh), "{FFFF00}TIENDA {FFFFFF}Coins\n");
        strcat(StrCash,StrCashh);
        format(String, sizeof(String), "Tienes{FFFF00}%i {FFFFFF}coins", PlayerInfo[playerid][pCoins]);
        ShowPlayerDialog(playerid, DIALOG_CATCOINS, DIALOG_STYLE_LIST, String , StrCash, "Seleccionar", "X");
        return 1;
}

CMD:dvehiculo(playerid)
{
        if(VehAlugado[playerid] == 1)
        {
                // P0-BEN-VEH: soltar trailer si esta enganchado
                if(IsTrailerAttachedToVehicle(VeiculoCivil[playerid]))
                        DetachTrailerFromVehicle(VeiculoCivil[playerid]);
                // FUEL-ARCHITECTURE: guardar combustible antes de destruir.
                // Si es vehiculo de org, persistir a disco (GuardarVehOrg).
                // Fuel_DestroyVehicle limpia g_VehFuel para que nativeID reusado no herede datos stale.
                if(VeiculoCivil[playerid] >= 1 && VeiculoCivil[playerid] < MAX_VEHICLES
                   && g_VehFuel[VeiculoCivil[playerid]][vf_initialized])
                {
                        // AUD4-004 (BANDAVEH-ALTO): validar que el vehiculo pertenece a
                        // la org ACTUAL del jugador, no a una org anterior. Si un lider fue
                        // degradado y movido a otra banda mientras tenia un vehiculo de su
                        // antigua org spawned, /dvehiculo destruiria ese vehiculo y guardaria
                        // fuel al .ini de la org correcta (vf_orgIdx) Ã¢Â€Â” comportamiento
                        // esperado. Pero dejamos constancia en log para que el admin pueda
                        // auditar este edge case (jugador con vehiculo de org ajena spawned).
                        new _vehOrgSlot = g_VehFuel[VeiculoCivil[playerid]][vf_orgSlot];
                        new _vehOrgIdx = g_VehFuel[VeiculoCivil[playerid]][vf_orgIdx];
                        if(_vehOrgSlot > 0 && _vehOrgIdx >= 0 && _vehOrgIdx < 6)
                        {
                                // Mapear idx a orgid (inverso de OrgGangIndex) para comparar
                                new _vehOrgid = 0;
                                switch(_vehOrgIdx)
                                {
                                        case 0: _vehOrgid = 5;
                                        case 1: _vehOrgid = 6;
                                        case 2: _vehOrgid = 7;
                                        case 3: _vehOrgid = 8;
                                        case 4: _vehOrgid = 12;
                                        case 5: _vehOrgid = 13;
                                }
                                if(_vehOrgid > 0 && PlayerInfo[playerid][Org] != _vehOrgid)
                                {
                                        printf("[BANDAVEH-AUD4-004] Jugador %d (org actual %d) devolvio vehiculo de org %d (idx %d, slot %d). La org del vehiculo no coincide con la org actual del jugador (fue movido/degradado mid-session).",
                                                playerid, PlayerInfo[playerid][Org], _vehOrgid, _vehOrgIdx, _vehOrgSlot);
                                }
                        }
                        Fuel_SavePersistent(VeiculoCivil[playerid]);
                        // Si es vehiculo de org, guardar a disco
                        if(g_VehFuel[VeiculoCivil[playerid]][vf_orgSlot] > 0)
                        {
                                new oidx = g_VehFuel[VeiculoCivil[playerid]][vf_orgIdx];
                                if(oidx >= 0 && oidx < 6)
                                {
                                        // Mapear idx a orgid (inverso de OrgGangIndex)
                                        new orgid = 0;
                                        switch(oidx)
                                        {
                                                case 0: orgid = 5;
                                                case 1: orgid = 6;
                                                case 2: orgid = 7;
                                                case 3: orgid = 8;
                                                case 4: orgid = 12;
                                                case 5: orgid = 13;
                                        }
                                        if(orgid > 0) GuardarVehOrg(orgid);
                                }
                        }
                        Fuel_DestroyVehicle(VeiculoCivil[playerid]);
                        // MEJORA 3 (BANDAVEH): liberar lock del slot de banda al destruir.
                        // Sin esto, el slot quedaria locked para siempre y nadie podria
                        // volver a spawnearlo hasta reinicio del server.
                        if(_vehOrgSlot > 0 && _vehOrgIdx >= 0 && _vehOrgIdx < 6)
                                g_VehOrgSlotLocked[_vehOrgIdx][_vehOrgSlot] = false;
                }
                VehAlugado[playerid] = 0;
                // Destruir objeto de luces del Infernus si existe
                if(IsValidDynamicObject(LucesInfernus[playerid][0]))
                {
                        DestroyDynamicObject(LucesInfernus[playerid][0]);
                        LucesInfernus[playerid][0] = -1;
                }
                // P0-BEN-LUZ: destruir luz estroboscopica del Towtruck si existe
                BenDestruirBalizasTow(playerid);
                // FIX ALTOS-VERIFY-A2 (stale state): limpiar g_CorreosVehicleOwner
                // antes de DestroyVehicle directo en /dvehiculo. Esto previene que el
                // vehicleid reusado por SA-MP para otro vehiculo quede marcado como
                // van de Correos, lo que bloquearia falsamente al nuevo dueÃ¯Â¿Â½o.
                if(VeiculoCivil[playerid] >= 1 && VeiculoCivil[playerid] < MAX_VEHICLES)
                        g_CorreosVehicleOwner[VeiculoCivil[playerid]] = INVALID_PLAYER_ID;
                // FIX AUDIT CORREOS A2-06: destruir objetos attachados ANTES de DestroyVehicle.
                // ANTES: DestroyVehicle se llamaba primero y DestroyCorreosVanObjects despues.
                // Eso causaba un glitch visual de 1 frame donde la van desaparecia pero los
                // objetos flotaban en el aire antes de destruirse.
                // AHORA: destruir objetos primero, luego la van. Mismo patron que Correos_FlushPlayer.
                DestroyCorreosVanObjects(playerid);
                DestroyVehicle(VeiculoCivil[playerid]);
                SuccesMsg(playerid, "Vehiculo destruido.");
                // FIX SPRINT2 A-01: flush completo del estado del trabajo activo.
                // Antes: /dvehiculo solo destrucia VeiculoCivil y VehAlugado pero NO reseteaba
                // g_CorreosRutaActiva, EmServico, CajasSdxObj, PegouVehProf, EmpaquetadorActivo,
                // CamionVehId, etc. Si un cartero hacia /dvehiculo mid-ruta, el flag de ruta
                // activa quedaba en true y no podia iniciar nueva ruta hasta /uniforme off+on o /q.
                // Idem para Empaquetador y Camionero.
                FlushPlayerJobs(playerid);
        }
        return 1;
}

// =====================================================================
// P0-BEN-VEH: Sistema de remolque para Towtruck de Bennys.
// Usa AttachTrailerToVehicle (nativo de SA-MP) - mucho mas fluido que timer.
// =====================================================================
CMD:enganchar(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden remolcar vehiculos.");
        if(mecanico[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
        if(GetPlayerVehicleSeat(playerid) != 0)
                return ErrorMsg(playerid, "Debes ser el conductor del vehiculo.");

        new veh = GetPlayerVehicleID(playerid);
        if(GetVehicleModel(veh) != 525)
                return ErrorMsg(playerid, "Debes estar conduciendo un Towtruck (grua) para remolcar.");

        // Buscar el vehiculo mas cercano dentro de 10m
        new Float:bx, Float:by, Float:bz;
        new Float:tx_remo, Float:ty_remo, Float:tz_remo;
        GetVehiclePos(veh, tx_remo, ty_remo, tz_remo);
        new closestVeh = -1;
        new Float:closestDist = 9999.0;
        for(new v = 1; v < MAX_VEHICLES; v++)
        {
                if(v == veh) continue;
                if(!IsValidVehicle(v)) continue;
                GetVehiclePos(v, bx, by, bz);
                // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
                new Float:dist = floatsqroot((bx - tx_remo)*(bx - tx_remo) + (by - ty_remo)*(by - ty_remo) + (bz - tz_remo)*(bz - tz_remo));
                if(dist < closestDist && dist < 10.0)
                {
                        closestDist = dist;
                        closestVeh = v;
                }
        }

        if(closestVeh == -1)
                return ErrorMsg(playerid, "No hay vehiculos cerca para remolcar (max 10m).");

        // No remolcar vehiculos con jugadores dentro, EXCEPTO si fue congelado por /llamargrua
        // (en ese caso el jugador deberia haber sido sacado del vehiculo, pero por si acaso)
        if(!g_VehGruaLlamada[closestVeh])
        {
                for(new p = 0; p < MAX_PLAYERS; p++)
                {
                        if(IsPlayerInVehicle(p, closestVeh))
                                return ErrorMsg(playerid, "No puedes remolcar un vehiculo con jugadores dentro.");
                }
        }

        // Enganchar usando el sistema NATIVO de SA-MP (mucho mas fluido, sin tirones)
        AttachTrailerToVehicle(closestVeh, veh);
        // P0-BEN-GRUA-FIX3: desactivar el checkpoint que se activo al aceptar la grua.
        // El mecanico ya llego al vehiculo y lo engancho, el checkpoint ya no es necesario.
        DisablePlayerCheckpoint(playerid);
        SuccesMsg(playerid, "Vehiculo enganchado. Conduce con cuidado hasta el taller.");
        printf("[P0-BEN-VEH] Mecanico ID %d engancho vehiculo %d con Towtruck %d", playerid, closestVeh, veh);
        return 1;
}

CMD:soltar(playerid)
{
        if(PlayerInfo[playerid][Org] != 9)
                return ErrorMsg(playerid, "Solo los mecanicos de Bennys pueden soltar vehiculos.");
        if(GetPlayerVehicleSeat(playerid) != 0)
                return ErrorMsg(playerid, "Debes ser el conductor del vehiculo.");

        new veh = GetPlayerVehicleID(playerid);
        if(!IsTrailerAttachedToVehicle(veh))
                return ErrorMsg(playerid, "No estas remolcando ningun vehiculo.");

        // P0-BEN-GRUA: obtener el vehiculo remolcado (trailer)
        new remolcado = GetVehicleTrailer(veh);

        // Verificar que estamos en la zona segura de Bennys (soltar en el taller)
        if(GetPVarInt(playerid, "P0_BEN_ZS_InHQ") != 1)
        {
                // Permitir soltar igual pero avisar que no es en el taller
                DetachTrailerFromVehicle(veh);
                SuccesMsg(playerid, "Vehiculo soltado (fuera del taller de Bennys).");
                printf("[P0-BEN-VEH] Mecanico ID %d solto el vehiculo del Towtruck %d (fuera de Bennys)", playerid, veh);
                return 1;
        }

        // Soltar el trailer
        DetachTrailerFromVehicle(veh);

        // P0-BEN-GRUA: si el vehiculo remolcado fue llamado por grua, cobrar al dueno
        if(remolcado > 0 && remolcado < MAX_VEHICLES && g_VehGruaLlamada[remolcado])
        {
                // Encontrar la llamada activa para este vehiculo
                new slotFound = -1;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                        if(g_GruaCalls[i][gc_active] && g_GruaCalls[i][gc_vehID] == remolcado)
                        {
                                slotFound = i;
                                break;
                        }
                }
                if(slotFound != -1)
                {
                        new precio = g_GruaCalls[slotFound][gc_precio];
                        new callerID = g_GruaCalls[slotFound][gc_callerID];
                        new callerName[24];
                        strcpy(callerName, g_GruaCalls[slotFound][gc_callerName], 24);

                        // Cancelar timers de la llamada
                        if(g_GruaCalls[slotFound][gc_callTimer] != -1)
                                KillTimer(g_GruaCalls[slotFound][gc_callTimer]);
                        if(g_GruaCalls[slotFound][gc_unfreezeTimer] != -1)
                                KillTimer(g_GruaCalls[slotFound][gc_unfreezeTimer]);
                        g_GruaCalls[slotFound][gc_active] = false;
                        g_GruaCalls[slotFound][gc_callerID] = INVALID_PLAYER_ID;
                        g_GruaCalls[slotFound][gc_vehID] = INVALID_VEHICLE_ID;
                        g_GruaCalls[slotFound][gc_callTimer] = -1;
                        g_GruaCalls[slotFound][gc_unfreezeTimer] = -1;
                        g_GruaCalls[slotFound][gc_acceptedByMech] = -1;

                        // Marcar vehiculo como remolcado (con deuda)
                        g_VehGruaTowed[remolcado] = true;
                        g_VehGruaLlamada[remolcado] = false; // ya no es "llamada", ahora es "deuda"
                        g_VehGruaPrecioOriginal[remolcado] = precio;
                        g_VehGruaMecanicoIDF[remolcado] = PlayerInfo[playerid][IDF];
                        GetPlayerName(playerid, g_VehGruaMecanicoName[remolcado], 24);

                        // Mantener vehiculo apagado (sigue confiscado hasta pago)
                        new engine, lights, alarm, doors, bonnet, boot, objective;
                        GetVehicleParamsEx(remolcado, engine, lights, alarm, doors, bonnet, boot, objective);
                        SetVehicleParamsEx(remolcado, 0, lights, alarm, doors, bonnet, boot, objective);

                        // Intentar cobrar al dueno si esta online
                        if(callerID != INVALID_PLAYER_ID && IsPlayerConnected(callerID) && pLogado[callerID])
                        {
                                if(PlayerInfo[callerID][pDinheiro] >= precio)
                                {
                                        // Tiene dinero: cobrar y pagar al mecanico
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        // (transaccion critica callerID->mecanico).
                                        AC_AddPlayerMoney(callerID, -precio);
                                        AC_AddPlayerMoney(playerid, precio);
                                        g_VehGruaDeuda[remolcado] = 0;
                                        g_VehGruaTowed[remolcado] = false;
                                        g_VehGruaLlamada[remolcado] = false;
                                        // Reactivar motor del vehiculo
                                        GetVehicleParamsEx(remolcado, engine, lights, alarm, doors, bonnet, boot, objective);
                                        SetVehicleParamsEx(remolcado, 1, lights, alarm, doors, bonnet, boot, objective);

                                        new msgCli[160];
                                        format(msgCli, sizeof(msgCli), "Tu vehiculo fue remolcado al taller de Bennys. Se cobraron $%d del traslado. Ya puedes repararlo.", precio);
                                        SuccesMsg(callerID, msgCli);
                                        new msgMec[160];
                                        format(msgMec, sizeof(msgMec), "Vehiculo soltado en el taller. Cobraste $%d del traslado a %s.", precio, callerName);
                                        SuccesMsg(playerid, msgMec);
                                }
                                else
                                {
                                        // No tiene dinero: queda como deuda
                                        g_VehGruaDeuda[remolcado] = precio;
                                        new msgCli[180];
                                        format(msgCli, sizeof(msgCli), "Tu vehiculo fue remolcado al taller de Bennys. Costo del traslado: $%d. No tienes dinero suficiente. El vehiculo queda confiscado hasta que pagues con /pagargrua.", precio);
                                        ErrorMsg(callerID, msgCli);
                                        new msgMec[160];
                                        format(msgMec, sizeof(msgMec), "Vehiculo soltado. El dueno %s no tiene dinero para pagar $%d. Queda como deuda pendiente. Cuando pague, recibiras el dinero.", callerName, precio);
                                        InfoMsg(playerid, msgMec);
                                }
                        }
                        else
                        {
                                // Dueno offline: queda como deuda
                                g_VehGruaDeuda[remolcado] = precio;
                                new msgMec[160];
                                format(msgMec, sizeof(msgMec), "Vehiculo soltado. El dueno %s esta offline. Deuda de $%d guardada. Cuando pague, recibiras el dinero.", callerName, precio);
                                InfoMsg(playerid, msgMec);
                        }

                        printf("[P0-BEN-GRUA] Mecanico %d solto veh %d en Bennys. Precio $%d, dueno %s, deuda $%d",
                                playerid, remolcado, precio, callerName, g_VehGruaDeuda[remolcado]);
                }
                else
                {
                        SuccesMsg(playerid, "Vehiculo soltado en el taller de Bennys.");
                }
        }
        else
        {
                SuccesMsg(playerid, "Vehiculo soltado en el taller de Bennys.");
        }
        printf("[P0-BEN-VEH] Mecanico ID %d solto el vehiculo del Towtruck %d", playerid, veh);
        return 1;
}

CMD:iniciarba(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 6)       return ErrorMsg(playerid, "No tienes permisos.");
        if(Covaconcerto[playerid] == true || PegouLixo[playerid] == true) return ErrorMsg(playerid, "Termine esta ruta para iniciar otra.");
        if(Podecmd[playerid] == false) return ErrorMsg(playerid, "Podras iniciar otra coleccion nuevamente en 5s.");
        cova[playerid] = random(sizeof(Covas));
        new index = cova[playerid];
        SetPlayerCheckpoint(playerid, Covas[index][0], Covas[index][1], Covas[index][2], 2.0);
        SuccesMsg(playerid, "Recoge el artÃ¯Â¿Â½culo en el punto designado..");
        Covaconcerto[playerid] = true;
        Podecmd[playerid] = false;
        return 1;
}

CMD:iniciaremp(playerid)
{
        // SISTEMA EMPAQUETADOR REDISEÃ¯Â¿Â½ADO: /iniciaremp legacy deshabilitado.
        // El nuevo sistema se inicia desde el menu del NPC (presiona F en el NPC).
        // FIX EMP-REDESIGN-VERIFY PROB-02: el viejo /iniciaremp hacia bypass del nuevo sistema.
        ErrorMsg(playerid, "Usa el NPC del Empaquetador (presiona F) para seleccionar nivel y iniciar ruta.");
        return 1;
}

CMD:cancelaremp(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 7) return ErrorMsg(playerid, "No eres Empaquetador.");
        if(!g_EmpRutaActiva[playerid] && !EmpaquetadorActivo[playerid]) return ErrorMsg(playerid, "No tienes una ruta activa.");
        // SISTEMA EMPAQUETADOR REDISEÃ¯Â¿Â½ADO: cleanup completo del nuevo sistema.
        if(g_EmpDescargaTmr[playerid] != -1) { KillTimer(g_EmpDescargaTmr[playerid]); g_EmpDescargaTmr[playerid] = -1; }
        if(g_EmpRecogerTmr[playerid] != -1) { KillTimer(g_EmpRecogerTmr[playerid]); g_EmpRecogerTmr[playerid] = -1; }
        if(g_EmpFreezeTmr[playerid] != -1) { KillTimer(g_EmpFreezeTmr[playerid]); g_EmpFreezeTmr[playerid] = -1; }
        g_EmpVehiculoCongelado[playerid] = 0;
        if(g_EmpCajaObj[playerid] != -1) { DestroyDynamicObject(g_EmpCajaObj[playerid]); g_EmpCajaObj[playerid] = -1; }
        if(g_EmpVehiculoAsignado[playerid] != INVALID_VEHICLE_ID && IsValidVehicle(g_EmpVehiculoAsignado[playerid]))
        {
                DestroyVehicle(g_EmpVehiculoAsignado[playerid]);
                g_EmpVehiculoAsignado[playerid] = INVALID_VEHICLE_ID;
        }
        VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
        VehAlugado[playerid] = 0;
        g_EmpRutaActiva[playerid] = 0;
        g_EmpNivelActual[playerid] = 0;
        g_EmpEntregasHechas[playerid] = 0;
        g_EmpEntregasTotales[playerid] = 0;
        g_EmpEsperandoDescarga[playerid] = 0;
        g_EmpTieneCaja[playerid] = 0;
        g_EmpCajaActivaIdx[playerid] = -1;
        g_EmpFaseEntrega[playerid] = 0;
        if(g_EmpCajaAttachedObj[playerid] != -1) { DestroyDynamicObject(g_EmpCajaAttachedObj[playerid]); g_EmpCajaAttachedObj[playerid] = -1; }
        g_EmpTiendasUsadas[playerid] = 0;
        g_EmpCajasUsadas[playerid] = 0;
        DisablePlayerCheckpoint(playerid);
        SafeUnfreeze(playerid);  // M-04 alineado
        Empaquetador_FlushPlayer(playerid);
        SuccesMsg(playerid, "Ruta cancelada. Puedes iniciar una nueva en el NPC.");
        return 1;
}

// FIX SPRINT1 C-02: crear CMD:cancelarcorreos que faltaba en la GM.
// El mensaje de error de /cargar para Correos dice "cancela con /cancelarcorreos"
// pero el comando NO existia. Soft-lock hasta /uniforme o /q.
CMD:cancelarcorreos(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 8)
                return ErrorMsg(playerid, "No eres cartero.");
        if(!g_CorreosRutaActiva[playerid])
                return ErrorMsg(playerid, "No tienes una ruta en curso.");
        Correos_FlushPlayer(playerid);
        SuccesMsg(playerid, "Ruta de Correos cancelada. Perdiste las cajas pendientes.");
        return 1;
}

// FIX UX CONSTRUCTOR #11: comando para cancelar la recogida de material.
// Si el jugador recogio material por error o quiere cancelar, puede usar este comando.
CMD:cancelarmaterial(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 5)
                return ErrorMsg(playerid, "No eres Constructor.");
        if(!PegouMaterial[playerid])
                return ErrorMsg(playerid, "No tienes ningun material en mano.");
        PegouMaterial[playerid] = false;
        RemovePlayerAttachedObject(playerid, 6);
        DisablePlayerCheckpoint(playerid);
        ClearAnimations(playerid);
        SuccesMsg(playerid, "Material cancelado. Puedes recoger uno nuevo cuando quieras.");
        return 1;
}

// FIX SEPULTURERO: comando para cancelar la recogida de cadaver.
CMD:cancelarcadaver(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 10)
                return ErrorMsg(playerid, "No eres Sepulturero.");
        if(g_SepultureroTieneCadaver[playerid] == 0)
                return ErrorMsg(playerid, "No tienes ningun cadaver en proceso.");
        // Si estaba esperando en hospital, cancelar timer
        if(g_SepultureroHospitalTmr[playerid] != -1)
        {
                KillTimer(g_SepultureroHospitalTmr[playerid]);
                g_SepultureroHospitalTmr[playerid] = -1;
        }
        // Liberar el cadaver que llevaba (eliminar del mapa - se pierde)
        if(g_SepultureroTieneCadaver[playerid] > 0)
        {
                Sepulturero_EliminarCadaver(g_SepultureroTieneCadaver[playerid] - 1);
        }
        g_SepultureroTieneCadaver[playerid] = 0;
        g_SepultureroEnHospital[playerid] = 0;
        g_SepultureroPagoPendiente[playerid] = 0;
        g_SepultureroHospitalOrigen[playerid] = 0;
        DisablePlayerCheckpoint(playerid);
        SafeUnfreeze(playerid);  // M-04 alineado
        SuccesMsg(playerid, "Recogida de cadaver cancelada. Puedes recoger uno nuevo cuando quieras.");
        return 1;
}


// FIX AUDIT RECOLECTOR REC-A1-07: comando para cancelar la ruta de basura.
// Antes: el Recolector era el unico trabajo de ruta sin comando cancelar.
// Si el jugador se equivocaba o queria cancelar, tenia que esperar que el timer disparara o /salirtrabajo.
CMD:cancelarbasura(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 6)
                return ErrorMsg(playerid, "No eres Recolector de Basura.");
        if(!PegouLixo[playerid] && !Covaconcerto[playerid])
                return ErrorMsg(playerid, "No tienes ninguna ruta de basura en curso.");
        // Matar timers pendientes
        if(g_CovaTmr[playerid] != -1) { KillTimer(g_CovaTmr[playerid]); g_CovaTmr[playerid] = -1; }
        if(g_BotouBauTmr[playerid] != -1) { KillTimer(g_BotouBauTmr[playerid]); g_BotouBauTmr[playerid] = -1; }
        // Reset estado
        PegouLixo[playerid] = false;
        Covaconcerto[playerid] = false;
        Podecmd[playerid] = true;
        RemovePlayerAttachedObject(playerid, 7);
        DisablePlayerCheckpoint(playerid);
        ClearAnimations(playerid);
        SafeUnfreeze(playerid);  // M-04 alineado
        SuccesMsg(playerid, "Ruta de basura cancelada. Puedes iniciar una nueva con /iniciarba.");
        return 1;
}

// =====================================================================
// SISTEMA RECOLECTOR NIVEL 2 - Comandos /iniciaruta y /cancelarruta
// =====================================================================
CMD:iniciaruta(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 6)
                return ErrorMsg(playerid, "No eres Recolector de Basura.");
        if(PlayerInfo[playerid][pSegundosJogados] < RECOLECTOR_NIVEL2_HORAS)
                return ErrorMsg(playerid, "Necesitas 6h de juego para Nivel 2.");
        if(g_RecNivel2Activo[playerid])
                return ErrorMsg(playerid, "Ya tienes una ruta en curso. Cancela con /cancelarruta.");
        if(g_RecNivel2Vehiculo[playerid] == -1 || !IsValidVehicle(g_RecNivel2Vehiculo[playerid]))
                return ErrorMsg(playerid, "No tienes un Trashmaster. Presiona F en el NPC y elige Nivel 2.");
        if(!IsPlayerInVehicle(playerid, g_RecNivel2Vehiculo[playerid]))
                return ErrorMsg(playerid, "Debes estar conduciendo tu Trashmaster.");
        if(Covaconcerto[playerid] || PegouLixo[playerid])
                return ErrorMsg(playerid, "Tienes una ruta de Nivel 1 en curso. Cancela con /cancelarbasura.");
        // Iniciar ruta
        g_RecNivel2Activo[playerid] = 1;
        g_RecNivel2Punto[playerid] = 0;
        g_RecNivel2Recogidos[playerid] = 0;
        // Crear CP al punto 0 + crear laton
        SetPlayerCheckpoint(playerid, RecolectorRutaPuntos[0][0], RecolectorRutaPuntos[0][1], RecolectorRutaPuntos[0][2], RECOLECTOR_NIVEL2_RADIO_CP);
        g_RecNivel2LatonObj[playerid] = CreateDynamicObject(RecNivel2_ModeloLaton(), RecolectorRutaPuntos[0][0], RecolectorRutaPuntos[0][1], RecolectorRutaPuntos[0][2] - 1.0, 0.0, 0.0, RecolectorRutaPuntos[0][3], -1, -1, -1, 100.0, 100.0);
        g_RecNivel2LatonPunto[playerid] = 0;
        SuccesMsg(playerid, "Ruta iniciada. Conduce al punto 1/11 marcado en tu mapa. Recoge la basura con F.");
        GameTextForPlayer(playerid, "~g~Ruta iniciada!~n~~w~Punto 1/11", 4000, 5);
        return 1;
}

CMD:cancelarruta(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 6)
                return ErrorMsg(playerid, "No eres Recolector de Basura.");
        if(!g_RecNivel2Activo[playerid])
                return ErrorMsg(playerid, "No tienes una ruta de Nivel 2 en curso.");
        // Limpiar laton
        if(g_RecNivel2LatonObj[playerid] != -1) { DestroyDynamicObject(g_RecNivel2LatonObj[playerid]); g_RecNivel2LatonObj[playerid] = -1; }
        g_RecNivel2LatonPunto[playerid] = -1;
        // Matar timer de descarga
        if(g_RecNivel2DescargaTmr[playerid] != -1) { KillTimer(g_RecNivel2DescargaTmr[playerid]); g_RecNivel2DescargaTmr[playerid] = -1; }
        // Reset estado
        g_RecNivel2Activo[playerid] = 0;
        g_RecNivel2Punto[playerid] = 0;
        g_RecNivel2Recogidos[playerid] = 0;
        g_RecNivel2EsperandoDescarga[playerid] = 0;
        DisablePlayerCheckpoint(playerid);
        SafeUnfreeze(playerid);  // M-04 alineado
        SuccesMsg(playerid, "Ruta de Nivel 2 cancelada. Puedes iniciar una nueva con /iniciaruta.");
        return 1;
}


// =====================================================================
// CMD /darniveltrabajo - Dar nivel de trabajo a un jugador
// Verifica el trabajo que tiene y cual es el minimo y maximo nivel de ese trabajo.
// =====================================================================
CMD:darniveltrabajo(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff");
        new targetID, nivel;
        if(sscanf(params, "ii", targetID, nivel)) return ErrorMsg(playerid, "USE: /darniveltrabajo [IDF] [nivel]");
        new id = -1;
        foreach(new i : Player) { if(pLogado[i] && PlayerInfo[i][IDF] == targetID) { id = i; break; } }
        if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
        new prof = PlayerInfo[id][pProfissao];
        if(prof == 0) return ErrorMsg(playerid, "Ese jugador no tiene trabajo.");
        // FIX AUDIT MEDICO A1-06: bloquear explicitamente pProfissao 9 (Medico deshabilitado).
        // ANTES: el switch no tenia case 9, cayendo a default "Desconocido".
        // El admin recibia "Le diste nivel 1 de Desconocido" - mensaje engaÃ¯Â¿Â½oso.
        // AHORA: error claro avisando que el sistema Medico esta deshabilitado.
        if(prof == 9) return ErrorMsg(playerid, "El sistema Medico (pProfissao 9) esta deshabilitado. Los medicos ahora son Org 10 Paramedicos.");
        new minNivel = 1, maxNivel = 1;
        new nombreTrabajo[32];
        switch(prof)
        {
                case 1: { nombreTrabajo = "Pescador"; maxNivel = 1; }
                case 2: { nombreTrabajo = "Minero"; maxNivel = 1; }
                case 3: { nombreTrabajo = "Carnicero"; maxNivel = 1; }
                case 4: { nombreTrabajo = "Camionero"; maxNivel = 1; }
                case 5: { nombreTrabajo = "Constructor"; maxNivel = 1; }
                case 6:
                {
                        nombreTrabajo = "Recolector de Basura";
                        maxNivel = 2;
                        if(nivel >= 2)
                        {
                                PlayerInfo[id][pSegundosJogados] = RECOLECTOR_NIVEL2_HORAS + 1;
                                SalvarDados(id);
                        }
                }
                case 7:
                {
                        nombreTrabajo = "Empaquetador";
                        maxNivel = 4;
                        if(nivel == 2) { g_EmpCajasCompletadas[id] = 5; SetPVarInt(id, "EmpCajasCompletadas", 5); }
                        else if(nivel == 3) { g_EmpCajasCompletadas[id] = 5; g_EmpRecorridosCompletados[id] = 100; SetPVarInt(id, "EmpCajasCompletadas", 5); SetPVarInt(id, "EmpRecorridosCompletados", 100); }
                        else if(nivel == 4) { g_EmpCajasCompletadas[id] = 5; g_EmpRecorridosCompletados[id] = 200; SetPVarInt(id, "EmpCajasCompletadas", 5); SetPVarInt(id, "EmpRecorridosCompletados", 200); }
                        SalvarDados(id);
                }
                case 8: { nombreTrabajo = "Correos"; maxNivel = 1; }
                case 10: { nombreTrabajo = "Sepulturero"; maxNivel = 1; }
                default: { nombreTrabajo = "Desconocido"; maxNivel = 1; }
        }
        if(nivel < minNivel || nivel > maxNivel)
        {
                new errmsg[128];
                format(errmsg, sizeof(errmsg), "Nivel invalido para %s. Rango: %d-%d.", nombreTrabajo, minNivel, maxNivel);
                return ErrorMsg(playerid, errmsg);
        }
        new msg[128];
        format(msg, sizeof(msg), "Le diste nivel %d de %s a %s.", nivel, nombreTrabajo, PlayerName(id));
        SuccesMsg(playerid, msg);
        new logmsg[160];
        format(logmsg, sizeof(logmsg), "[DARNIVELTRABAJO] %s (IDF %d) dio nivel %d de %s a %s (IDF %d)", PlayerName(playerid), PlayerInfo[playerid][IDF], nivel, nombreTrabajo, PlayerName(id), targetID);
        Log("Logs/AdminAcciones.ini", logmsg);
        new msg2[128];
        format(msg2, sizeof(msg2), "Un admin te dio nivel %d de %s.", nivel, nombreTrabajo);
        SuccesMsg(id, msg2);
        return 1;
}


CMD:salirtrabajo(playerid)
{
        // FIX SPRINT1 C-01 + SPRINT2 A-02 refactor: usar helper unificado.
        // Antes: 90 lineas inline de flush de cada trabajo duplicadas en /salirtrabajo,
        // OnPlayerDeath, OnVehicleDeath. Si se anyadia una variable nueva habia que
        // tocar 3-4 sitios. Ahora: una sola llamada a FlushPlayerJobs.
        // Los helpers individuales (Empaquetador_FlushPlayer, Camionero_FlushPlayer,
        // Correos_FlushPlayer) garantizan cleanup completo y consistente.
        FlushPlayerJobs(playerid);
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        PlayerInfo[playerid][pProfissao] = 0;
        SuccesMsg(playerid, "Usted dejo su trabajo. Estado reiniciado.");
        return 1;
}

CMD:salirorg(playerid)
{
        // FIX AUDIT: usar IsOrgLeader en vez de Cargo == 3 hardcoded (PN=5, FBI=5, Ejercito=6, Paramedicos=4)
        if(IsOrgLeader(playerid))    return ErrorMsg(playerid, "Pidale a un administrador que elimine su organizacion, ya que usted es su lider.");
        // FIX AUDIT PRENSA: al salir de la org, retirar TODO lo relacionado
        if(Patrulha[playerid] == true)
        {
                Patrulha[playerid] = false;
                if(policiaon > 0) policiaon--;
        }
        FlushPlayerOrgFlags(playerid);
        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
        ClearChalecoState(playerid);
        SetPlayerColor(playerid, 0xFFFFFFFF);
        PlayerInfo[playerid][Org] = 0;
        PlayerInfo[playerid][Cargo] = 0;
        SuccesMsg(playerid, "Dejaste tu organizacion. Se te retiraron el uniforme, chaleco y permisos.");
        return 1;
}

CMD:cargar(playerid)
{
        if(PlayerInfo[playerid][pProfissao] == 4){
                if(!PlayerToPoint(3.0, playerid, -520.421813, -504.999450, 24.635631) && !PlayerToPoint(3.0, playerid, -529.748168, -504.937561, 24.640802) && !PlayerToPoint(3.0, playerid, -557.552368, -505.473480, 24.596021))
                        return ErrorMsg(playerid, "Debe estar en un punto de carga para cargar el camion.");
                if(Cargase[playerid] == true)   return ErrorMsg(playerid, "Su camion ya esta cargado.");
                if(Carregou[playerid] == 1)     return ErrorMsg(playerid, "Ya tiene carga.");
                // FIX SPRINT2 A-08: ownership check - validar que el vehiculo es SU truck.
                // Antes: solo se validaba modelo 456, no ownership. Otro Camionero B podia
                // usar el truck de A, completar ruta, y el cobro destruiria el truck de A.
                new veh = GetPlayerVehicleID(playerid);
                if(GetVehicleModel(veh) != 456)        return ErrorMsg(playerid, "No en el vehiculo de trabajo.");
                // FIX AUDIT CAMIONERO CAM-A1-01 v4 (tolerant): si CamionVehId == -1 (truck de trabajo
                // sacado antes del fix, o reseteado por OnVehicleSpawn), Y el jugador tiene VehAlugado=1,
                // asumir que es SU truck y setear CamionVehId en este momento. Esto cubre:
                // 1. Trucks sacados antes del fix (estado VehAlugado=1 persistente sin CamionVehId)
                // 2. Trucks que respawnean (OnVehicleSpawn L22073 resetea CamionVehId=-1)
                // 3. Cualquier edge case donde CamionVehId se pierde
                if(CamionVehId[playerid] == -1 && VehAlugado[playerid] == 1)
                {
                        // Verificar que VeiculoCivil coincide con el veh actual (el truck de trabajo)
                        if(VeiculoCivil[playerid] == veh || VeiculoCivil[playerid] == INVALID_VEHICLE_ID)
                        {
                                CamionVehId[playerid] = veh;
                                VeiculoCivil[playerid] = veh;
                        }
                }
                if(veh != CamionVehId[playerid])
                        return ErrorMsg(playerid, "Este no es tu truck de trabajo. Saca uno propio en el pickup.");
                // FIX SPRINT2 A-13: cooldown anti-spam (mismo patron que Correos).
                new now = gettime();
                if(now - g_CamionLastCargar[playerid] < CAMION_COOLDOWN_CARGAR)
                        return ErrorMsg(playerid, "Espera unos segundos antes de volver a cargar.");
                g_CamionLastCargar[playerid] = now;

                MEGAString[0] = EOS;
                // FIX SPRINT3 H-A1-02: sincronizar precios del diÃ¯Â¿Â½logo con CamionPago real.
                // Antes: el diÃ¯Â¿Â½logo mostraba $360-$5000 (remanentes de la funciÃ¯Â¿Â½n MUERTA
                // DescarregarCarga L4905) pero CamionPago real es $150-$1900 (62% menos).
                // Los jugadores eran engaÃ¯Â¿Â½ados sistematicamente. Ahora: precios reales.
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Regiones de Vehiculos\t{32CD32}$150\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos Agricolas\t{32CD32}$380\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos Industriales\t{32CD32}$480\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Maderas y Lenas\t{32CD32}$700\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Ropa y Complementos\t{32CD32}$950\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos de Limpieza\t{32CD32}$1200\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos de Pesca\t{32CD32}$1450\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos Quimicos\t{32CD32}$1700\n");
                strcat(MEGAString, "{FFFF00}- {FFFFFF}Productos Tecnologicos\t{32CD32}$1900\n");
                ShowPlayerDialog(playerid, DIALOG_CARGA, DIALOG_STYLE_LIST, "Bienes\tValor", MEGAString, "Confirmar", "X");
        }else if(PlayerInfo[playerid][pProfissao] == 8){ //Correios
                if(EmServico[playerid] == false) return ErrorMsg(playerid, "No has iniciado turno.");
                if(PegouVehProf[playerid] == false) return ErrorMsg(playerid, "No cogiste una furgoneta del servicio postal.");
                // FIX P0-6: validar que no haya ruta en curso. Antes se podia spammear /cargar
                // y se recreaban CajasSdxObj[] sin destruir los previos (leak de PlayerObjects).
                if(g_CorreosRutaActiva[playerid])
                        return ErrorMsg(playerid, "Ya tienes una ruta en curso. Termininala o cancela con /cancelarcorreos.");
                // FIX P2-12: cooldown anti-spam de 5 segundos.
                new now = gettime();
                if(now - g_CorreosLastCargar[playerid] < CORREOS_COOLDOWN_CARGAR)
                        return ErrorMsg(playerid, "Espera unos segundos antes de volver a cargar.");
                g_CorreosLastCargar[playerid] = now;

                // Limpieza preventiva de objetos previos (defensa en profundidad)
                for(new i = 1; i <= 10; i++)
                {
                        if(IsValidPlayerObject(playerid, CajasSdxObj[playerid][i]))
                                DestroyPlayerObject(playerid, CajasSdxObj[playerid][i]);
                        CajasSdxObj[playerid][i] = INVALID_OBJECT_ID;
                }

                // Generar entre 5 y 6 cajas de forma aleatoria
                new numcajas = randomEx(5, CORREOS_MAX_CAJAS);
                EntregasTotales[playerid] = numcajas;
                EntregaDistTotal[playerid] = 0.0;
                GetPlayerPos(playerid, EntregaPosUltX[playerid], EntregaPosUltY[playerid], Pos[2]);
                CajasSdx[playerid] = 0;
                g_CorreosRutaActiva[playerid] = true;
                // Posiciones fijas de las cajas en el almacen (usar solo las primeras numcajas)
                new Float:cajasPos[10][3] = {
                        {954.870483, 1706.978149, 8.968443},
                        {954.870483, 1706.978149, 8.078433},
                        {955.930419, 1706.978149, 8.968428},
                        {955.930419, 1706.978149, 8.078433},
                        {956.920593, 1706.978149, 8.988447},
                        {956.920593, 1706.978149, 8.078433},
                        {958.100891, 1707.363525, 8.988439},
                        {958.100891, 1707.363525, 8.078433},
                        {959.064208, 1708.000976, 8.978438},
                        {959.064208, 1708.000976, 8.078433}
                };
                for(new cj = 1; cj <= numcajas; cj++)
                        CajasSdxObj[playerid][cj] = CreatePlayerObject(playerid, CORREOS_OBJ_CAJA_ALMACEN, cajasPos[cj-1][0], cajasPos[cj-1][1], cajasPos[cj-1][2], 0.0, 0.0, 0.0, 300.0);
                // Primer checkpoint: primera caja
                SetPlayerCheckpoint(playerid, 954.7924,1707.8540,8.6484,1);
                new msgstart[128];
                format(msgstart, sizeof(msgstart), "Recorrido iniciado. Tienes {FFFF00}%d cajas{FFFFFF} para repartir. Recoge la primera.", numcajas);
                SuccesMsg(playerid, msgstart);
                EntregaSdx[playerid] = true;
        }
        return 1;
}

// FIX P0-4: comandos DEBUG eliminados de produccion.
// Antes CUALQUIER jugador podia hacer /setvar 9999 y corromper CajasSdxObj[playerid][N]
// (acceso fuera de rango => stack smash / crash del servidor).
// Se mantienen SOLO para admins nivel 6+, con bound check estricto.
CMD:var(playerid){
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "Comando restringido.");
        new st[40];
        format(st,sizeof(st),"CajasSdx=%i EntregasTotales=%i RutaActiva=%i", CajasSdx[playerid], EntregasTotales[playerid], _:g_CorreosRutaActiva[playerid]);
        SendClientMessage(playerid, -1, st);
        return true;
}

CMD:setvar(playerid,params[]){
        if(PlayerInfo[playerid][pAdmin] < 6) return ErrorMsg(playerid, "Comando restringido.");
        // FIX SPRINT3 M-31: validar pProfissao==8 para modificar CajasSdx.
        // Antes: un admin podia modificar CajasSdx sin ser Correos, dejando el estado
        // de Correos en una posicion invalida que podria causar bugs en ColocandoCaja.
        if(PlayerInfo[playerid][pProfissao] != 8) return ErrorMsg(playerid, "Solo carteros pueden modificar CajasSdx.");
        new vvar;
        if(sscanf(params,"d",vvar)) return SendClientMessage(playerid, -1, "Use /setvar [0-6]");
        // FIX P0-4b: bound check estricto para evitar acceso fuera de rango en CajasSdxObj[][].
        if(vvar < 0 || vvar > CORREOS_MAX_CAJAS) return ErrorMsg(playerid, "Valor fuera de rango (0-6).");
        CajasSdx[playerid] = vvar;
        return 1;
}

// FIX SPRINT3 B-03: CMD:descargar eliminado (era un no-op que solo mostraba un mensaje).
// Antes: el comando no hacia nada util - solo decia "Dirijase al checkpoint de entrega
// para descargar automaticamente" que es exactamente lo que ya hace el sistema de Camionero
// al llegar al CP (bloque CamionEnRuta en OnPlayerEnterCheckpoint). Era misleading y
// generaba confusiÃ¯Â¿Â½n. Eliminado para limpiar deuda tecnica.

CMD:rorgoff(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        ShowPlayerDialog(playerid,DIALOG_LTAGS,DIALOG_STYLE_INPUT,"Remover un Lider","Escribe el nombre del miembro!\n\nSOLO EL RESPONSABLE DE LA ORGANIZACION PUEDE!.","Confirmar","X");
        return 1;
}

CMD:infoorg(playerid)
{
        if(PlayerInfo[playerid][Org]==0)return ErrorMsg(playerid, "No estas en ninguna organizacion.");
        membrosorg(playerid, PlayerInfo[playerid][Org]);
        return 1;
}

CMD:invitar(playerid,params[])
{
        new id, String[500];
        if(pLogado[playerid] == false)                  return ErrorMsg(playerid, "No has iniciado sesion.");
        if(PlayerInfo[playerid][Org] == 0)              return ErrorMsg(playerid, "No eres de ninguna organizacion.");
        // P0-AUD-3: solo el lider puede invitar (decision del usuario: opcion C)
        if(!IsOrgLeader(playerid))                      return ErrorMsg(playerid, "Solo el lider de la organizacion puede invitar miembros.");
        if(sscanf(params,"i",id))                       return ErrorMsg(playerid,"Uso: /invitar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(i == id)
                        {
                                if(!IsPerto(playerid,i))return ErrorMsg(playerid, "Este jugador no esta cerca.");
                                if(PlayerInfo[i][Org] != 0)return ErrorMsg(playerid, "Este jugador ya pertenece a una organizacion.");
                                // FIX SPRINT4 9.2: usar helper TieneCarnetTrabajo sobre variable loop i.
                                if(!TieneCarnetTrabajo(i)) return ErrorMsg(playerid, "Ese jugador no tiene Carnet de Trabajo. Debe obtenerlo en el Ayuntamiento primero.");
                                PlayerInfo[i][convite] = PlayerInfo[playerid][Org];
                                // FIX SPRINT3 H-A5-07: guardar playerid del inviter para DIALOG_CONVITE.
                                // Antes: PlayerInfo[i][convite] = PlayerInfo[playerid][Org] guardaba el ORGID (1-14)
                                // pero en DIALOG_CONVITE se usaba como playerid en InfoMsg(PlayerInfo[playerid][convite], ...)
                                // Eso enviaba el mensaje a un jugador aleatorio con ID 1-14 en vez del inviter real.
                                SetPVarInt(i, "InviterPlayerID", playerid);
                                format(String,sizeof(String),"Estas siendo invitado por {FFFF00}%04d{FFFFFF}. (%s)",PlayerInfo[playerid][IDF],NomeOrg(playerid));
                                // P1-AUD-3: corregido typo "invitaciom" -> "Invitacion"
                                ShowPlayerDialog(i,DIALOG_CONVITE,DIALOG_STYLE_MSGBOX,"Invitacion",String,"Aceptar","X");
                        }
                }
        }

        return 1;
}

CMD:limpiarvacantes(playerid,params[])
{
        new String[500];
        if(pLogado[playerid] == false)                                          return ErrorMsg(playerid, "No inicio sesion");
        if(PlayerInfo[playerid][Org] == 0)return ErrorMsg(playerid, "No formas parte de una organizacion.");
        if(!IsOrgLeader(playerid))return ErrorMsg(playerid, "Solo el lider de la organizacion puede limpiar vacantes."); // FIX AUDIT: privilege escalation
        new xPlayer;
        if(sscanf(params,"i",xPlayer))
                return ErrorMsg(playerid ,  "/limparvagas [id]");
        format(String, sizeof(String),"Todos los vacantes han sido removidos.");
        SuccesMsg(playerid, String);
        format(String, sizeof(String), PASTA_ORGS, PlayerInfo[playerid][Org]);
        DOF2_SetString(String, VagasORG[xPlayer], "ninguno");
        DOF2_SaveFile();
        return 1;
}

CMD:despedir(playerid,params[])
{
        new String[500];
        if(pLogado[playerid] == false)                                          return ErrorMsg(playerid, "No inicio sesion");
        if(PlayerInfo[playerid][Org] == 0)return ErrorMsg(playerid, "No formas parte de una organizacion.");
        if(!IsOrgLeader(playerid))return ErrorMsg(playerid, "Solo el lider de la organizacion puede despedir miembros."); // FIX AUDIT: privilege escalation
        new xPlayer;
        if(sscanf(params,"i",xPlayer))
                return ErrorMsg(playerid , "/demitir [playerid]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == xPlayer)
                        {
                                if(PlayerInfo[i][Org] != PlayerInfo[playerid][Org])return ErrorMsg(playerid, "Este jugador no es de su organizacion.");
                                format(String, sizeof(String),"Expulsaste %04d de su organizacion!",PlayerInfo[i][IDF]);
                                SuccesMsg(playerid, String);
                                format(String, sizeof(String),"Fue expulsado de su organizacion por %04d",PlayerInfo[playerid][IDF]);
                                InfoMsg(i, String);
                                expulsarmembro(i, PlayerInfo[i][Org]);
                                // Quitar skin y armamento de la org al ser despedido
                                if(Patrulha[i] == true) { Patrulha[i] = false; if(policiaon > 0) policiaon--; } // FIX P0-1: prevenir underflow
                                ResetPlayerWeapons(i);
                                CarregarArmas(i);
                                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                                SetPlayerArmour(i, 0);
                                SetPlayerColor(i, 0xFFFFFFFF);
                                PlayerInfo[i][Org] = 0;
                                PlayerInfo[i][Cargo] = 0;
                        }
                }
        }

        return 1;
}
CMD:promover(playerid,params[])
{
        new id,cargo,String[500];
        if(pLogado[playerid] == false)                  return ErrorMsg(playerid, "No has iniciado sesion.");
        if(PlayerInfo[playerid][Org] == 0)              return ErrorMsg(playerid, "No eres de ninguna organizacion.");
        // P0-AUD-2: solo el lider puede promover (decision del usuario: opcion A)
        if(!IsOrgLeader(playerid))                      return ErrorMsg(playerid, "Solo el lider de la organizacion puede promover miembros.");
        if(sscanf(params,"ii",id,cargo))                return ErrorMsg(playerid,"Uso: /promover [ID] [CARGO]");

        // P0-AUD-1: el cargo maximo que se puede dar es cargoMax - 1 (no puede promover a su mismo rango)
        new cargoMaxOrg = GetOrgCargoMax(PlayerInfo[playerid][Org]);
        if(cargo < 1)                                   return ErrorMsg(playerid, "El cargo debe ser mayor o igual a 1.");
        // P1-AUD-FIX: ErrorMsg no soporta formato, pre-formatear el mensaje
        if(cargo >= cargoMaxOrg)
        {
                new errPromover[128];
                format(errPromover, sizeof(errPromover), "No puedes dar un cargo igual o superior al tuyo (max: %d).", cargoMaxOrg - 1);
                return ErrorMsg(playerid, errPromover);
        }

        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(i == id)
                        {
                                if(PlayerInfo[i][Org] != PlayerInfo[playerid][Org])return ErrorMsg(playerid, "Este jugador no es de tu organizacion.");
                                if(PlayerInfo[i][Cargo] >= cargoMaxOrg)            return ErrorMsg(playerid, "No puedes promover a otro lider.");
                                PlayerInfo[i][Cargo] = cargo;
                                // P1-AUD-3: mensajes traducidos al espaÃ¯Â¿Â½ol
                                format(String,sizeof(String),"Promoviste a %04d al cargo de %s.",PlayerInfo[i][IDF],NomeCargo(i));
                                SuccesMsg(playerid, String);
                                format(String,sizeof(String),"%04d te promovio al cargo de %s.",PlayerInfo[playerid][IDF],NomeCargo(i));
                                InfoMsg(i, String);
                        }
                }
        }

        return 1;
}

