// Estado de un territorio
enum E_Territorio {
    bool:t_activa,                   // el territorio existe
    t_nombre[32],                    // nombre de la zona
    Float:t_minX,                    // esquina inferior X del rectangulo
    Float:t_minY,                    // esquina inferior Y
    Float:t_maxX,                    // esquina superior X
    Float:t_maxY,                    // esquina superior Y
    Float:t_pickupX,                 // posicion central del pickup
    Float:t_pickupY,
    Float:t_pickupZ,
    t_duenoOrg,                      // ID de la org dueÃ¯Â¿Â½a (0 = neutral)
    t_gangZone,                      // ID de la GangZone
    t_pickupID,                      // ID del pickup de recursos
    // Sistema de conquista pacifica
    bool:t_conquistaEnCurso,         // hay conquista en curso
    t_conquistaOrg,                  // org que esta conquistando
    t_conquistaTimer,                // timer de countdown (-1 = inactivo)
    t_conquistaSegundos,             // segundos restantes
    // Sistema de guerra
    bool:t_guerraEnCurso,            // hay guerra en curso
    t_guerraAtacante,                // org que reta
    t_guerraDefensor,                // org que defiende
    t_guerraTimer,                   // timer de la guerra
    t_guerraSegundos,                // segundos restantes
    t_bajasAtacante,                 // bajas que hizo el atacante
    t_bajasDefensor,                 // bajas que hizo el defensor
    // Sistema de decomiso policial
    t_capturasPolicia,               // cuantos miembros capturados en 1h
    t_decomisoTimer,                 // timer de reset de capturas
    // Cooldown de reto
    t_cooldownReto                   // timestamp hasta el que no se puede retar
};
