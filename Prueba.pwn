                                                        AddVehicleComponent(wVeiculo,1079);
                                                        OnVehicleMod(playerid, wVeiculo, 1079);
                                                        AddVehicleComponent(wVeiculo,1086);
                                                        OnVehicleMod(playerid, wVeiculo, 1086);
                                                }
                                                case 401:
                                                {
                                                        AddVehicleComponent(wVeiculo,1086);
