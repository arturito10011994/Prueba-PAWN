                                // P0-ROBO-FASE4: herramientas criminales para robo de negocios
                                if(listitem == 4) // Ganzua - $4,000
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 4000)                      return ErrorMsg(playerid, "Dinero insuficiente.");
                                        SuccesMsg(playerid, "Compraste una Ganzua. Durabilidad: 2-3 usos.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
