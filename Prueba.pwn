                                        GanharItem(playerid, ITEM_GANZUA, 1);
                                        CofreNiobio += 4000;
                                        SetPVarInt(playerid, "GanzuaUsos", randomEx(2, 3)); // durabilidad 2-3 usos
                                        SalvarInventario(playerid);
                                        // FIX AUDIT2 AGENT2 M-22: SalvarDados junto con SalvarInventario.
                                        SalvarDados(playerid);
                                        SalvarDinRoubos();
                                }
                                if(listitem == 5) // Taladro - $10,000
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 10000)                     return ErrorMsg(playerid, "Dinero insuficiente.");
                                        SuccesMsg(playerid, "Compraste un Taladro. Durabilidad: 4-5 usos.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -10000);
                                        GanharItem(playerid, ITEM_TALADRO, 1);
                                        CofreNiobio += 10000;
                                        SetPVarInt(playerid, "TaladroUsos", randomEx(4, 5)); // durabilidad 4-5 usos
                                        SalvarInventario(playerid);
                                        // FIX AUDIT2 AGENT2 M-22: SalvarDados junto con SalvarInventario.
