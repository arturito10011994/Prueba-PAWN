                // CAMBIO 2026-07-12: Spawn de ambulancias en hospitales pequeÃ¯Â¿Â½os.
                else if(PlayerToPoint(3.0, playerid, 1176.410400, -1308.664306, 13.963733) && GetPlayerVirtualWorld(playerid) == 0) // Hospital LS
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        
                        // CAMBIO 2026-07-12 - Fase 3: mostrar Helicoptero solo al elegido.
                        new vehStr[256];
                        format(vehStr, sizeof(vehStr), "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416\n{FF0000}- {FFFFFF}Wayfarer\t{FF0000}586");
                        if(GetParamedicoElegido() == playerid)
                        {
                            strcat(vehStr, "\n{00FF00}- {FFFFFF}Helicoptero Rescate\t{00FF00}563");
                        }
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", vehStr, "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -330.646453, 1063.284423, 19.739168) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 3 FC
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -1506.858398, 2525.747558, 55.687500) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 4 TR
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -2203.034423, -2315.037109, 30.625000) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 6 BC
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, 1220.988403, 302.590362, 19.554687) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 7 RC
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
