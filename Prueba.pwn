// =====================================================================
// P0-CAMION-BLINDADO: Sistema de Camion Blindado (evento administrativo)
// El admin define botin total, se divide en 3 bolsas.
// El camion aparece al lado del admin, el conductor designado lo lleva
// al punto de inicio y luego al destino. Ilegales pueden interceptarlo,
// explotar la puerta trasera con Explosivo, sacar las 3 bolsas y
// venderlas en la Tienda Ilegal.
// =====================================================================
#define MAX_CAMION_PUNTOS    7    // 7 ubicaciones fijas
#define MAX_CAMION_RUTAS     10   // 10 rutas predefinidas
#define CAMION_MODEL         428  // Securicar (camion blindado de SA-MP)
#define CAMION_BOLSA_MODEL   1212 // maletin de dinero (mismo modelo que dinero sucio)
#define CAMION_BOLSAS_MAX    3    // siempre 3 bolsas
#define CAMION_COOLDOWN_SEG  7200 // 2 horas de cooldown entre eventos
#define CAMION_POLICIAS_MIN  6    // 6 policias en servicio minimo
#define CAMION_BOLSA_SLOT    7    // slot de attached object (1,2,5,6,9 usados; 7 libre)
#define CAMION_DENUNCIA_EST  6    // +6 estrellas al explotar
#define CAMION_RADIO_CAMION  6.0  // radio para interactuar con el camion
#define CAMION_RADIO_BOLSA   3.0  // radio para recoger una bolsa del suelo

enum E_CamionPunto {
    Float:cp_x,
    Float:cp_y,
    Float:cp_z,
    Float:cp_angle
};
new g_CamionPuntos[MAX_CAMION_PUNTOS][E_CamionPunto] = {
    {990.768005,   -1524.630737, 13.558140, 173.140747},  // 0 - LS 1
    {1361.148315,  -1649.678100, 13.382812, 269.648315},  // 1 - LS 2
    {-1978.967895,  431.562103,  25.412349, 179.336761},  // 2 - SF 1
    {-2107.391845, -2402.038818, 31.383916,  56.957965},  // 3 - Whetstone
    {2235.319335,   1284.378906, 10.820312, 357.942535},  // 4 - LV 1
    {2164.523925,   1677.027832, 10.820312, 355.435760},  // 5 - LV 2
    {2029.229614,   1007.835327, 10.820312, 177.170898}   // 6 - LV 3
};
new g_CamionPuntosNombres[MAX_CAMION_PUNTOS][12] = {
    "LS 1", "LS 2", "SF 1", "Whetstone", "LV 1", "LV 2", "LV 3"
};
// 10 rutas: {origen, destino} - indices a g_CamionPuntos
new g_CamionRutas[MAX_CAMION_RUTAS][2] = {
    {0, 4},  // 1: LS 1 -> LV 1
    {1, 5},  // 2: LS 2 -> LV 2
    {6, 0},  // 3: LV 3 -> LS 1
    {5, 1},  // 4: LV 2 -> LS 2
    {0, 2},  // 5: LS 1 -> SF 1
    {2, 1},  // 6: SF 1 -> LS 2
    {4, 3},  // 7: LV 1 -> Whetstone
    {3, 1},  // 8: Whetstone -> LS 2
    {4, 2},  // 9: LV 1 -> SF 1
    {2, 4}   // 10: SF 1 -> LV 1
};

// Estado del evento Camion Blindado
enum E_CamionEvento {
    bool:ce_activo,           // true si hay evento en curso
    ce_conductorIDF,          // IDF del jugador conductor designado (en db)
    ce_conductorPlayerid,     // playerid actual del conductor (-1 si no conectado)
    ce_rutaIdx,               // 0-9 (ruta elegida, indice a g_CamionRutas)
    ce_vehiculoID,            // ID del vehiculo camion (-1 si no creado)
    ce_botinTotal,            // botin total definido por admin
    ce_bolsaValor,            // botinTotal / 3 (valor de cada bolsa)
    bool:ce_origenAlcanzado,  // true si el conductor ya llego al punto de inicio
    bool:ce_destinoAlcanzado, // true si el conductor ya llego al destino (camion entregado)
    bool:ce_camionAbierto,    // true si la puerta fue explosionada (Explosivo consumido)
    bool:ce_bolsasCaidas,     // true si las 3 bolsas ya cayeron al piso
    ce_bolsasVendidas,        // contador de bolsas vendidas (0-3)
    ce_bolsasRecuperadas,     // contador de bolsas recuperadas por policia (0-3)
    ce_cooldownTs             // timestamp hasta el que no se puede iniciar otro evento
};
new g_CamionEvento[E_CamionEvento];

// Bolsas del camion blindado (3 max)
enum E_CamionBolsa {
    bool:cb_activa,           // true si esta bolsa esta en juego (no resuelta)
    bool:cb_enSuelo,          // true si esta como pickup en el piso
    bool:cb_enMano,           // true si un jugador la lleva
    cb_portadorID,            // playerid del portador (-1 si ninguno)
    Float:cb_x,               // posicion actual (suelo)
    Float:cb_y,
    Float:cb_z,
    cb_pickupID               // ID del pickup si esta en suelo (-1 si no)
};
new g_CamionBolsas[CAMION_BOLSAS_MAX][E_CamionBolsa];
// Fin P0-CAMION-BLINDADO - variables

// =====================================================================
// FASE 5: CONTRABANDO DE ARMAS
// Las bandas ilegales pueden ofrecer armas del inventario a otros jugadores
// por un precio. El comprador paga en efectivo, el vendedor recibe el dinero.
// Las ofertas son visibles globalmente via /ofertasarma.
// Solo los bandidos pueden crear ofertas (IsBandido).
// Cualquiera puede comprar (NO se valida IsBandido en el comprador).
// =====================================================================
#define MAX_OFERTAS_ARMA     20   // maximo de ofertas simultaneas
#define OFERTA_ARMA_EXPIRE   300  // 5 minutos de expiracion automatica
enum E_OfertaArma {
    bool:oa_activa,           // true si la oferta esta activa
    oa_vendedorIDF,           // IDF del vendedor (persistente ante reconnect)
    oa_vendedorPlayerid,      // playerid actual del vendedor (-1 si no conectado)
    oa_vendedorOrg,           // organizacion del vendedor (para color en /ofertasarma)
    oa_itemID,                // ID del item en inventario (331-371 para armas)
    oa_armaID,                // ID nativo del arma (1-46) para GivePlayerWeapon
    oa_precio,                // precio en efectivo
    oa_cantidad,              // cantidad de municion/unidades
    oa_timestamp,              // cuando se creo la oferta (para expiracion)
    oa_nombreArma[32]         // nombre legible del arma (cacheado)
};
new g_OfertasArma[MAX_OFERTAS_ARMA][E_OfertaArma];
// Fin FASE 5 - variables

// =====================================================================
// FASE 6: RANKING Y RESPETO DE BANDAS
// El respeto de una banda se calcula dinamicamente con formula ponderada:
//   +100 por cada territorio conquistado
//   +50 por cada guerra de bandas ganada
//   +10 por cada miembro online
//   -50 por cada guerra de bandas perdida
//   -30 por cada captura policial reciente en su territorio
// Las victorias/derrotas de guerras se persisten en EstadisticasBandas.ini
// =====================================================================
#define MAX_STATS_GUERRAS 15  // 15 orgs posibles (1-14)
enum E_StatsBanda {
    sb_guerrasGanadas,
    sb_guerrasPerdidas,
    sb_guerrasEmpatadas,
    sb_robosExitosos,         // robos a negocios completados por miembros
    sb_desmantelamientos       // vehiculos desmantelados
};
new g_StatsBanda[MAX_STATS_GUERRAS][E_StatsBanda];
// Fin FASE 6 - variables

