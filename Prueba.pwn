        strcat(StringsG1, StringsG);

        ShowPlayerDialog(playerid,DIALOG_ORGS,DIALOG_STYLE_MSGBOX,"Organizaciones del Servidor",StringsG1,"X",#);
        return 1;
}

CMD:darlider(playerid,params[])
{
        new id,org,String[500];
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params,"ii",id,org))                  return ErrorMsg(playerid,"Uso: /darlider [ID] [IDORG]");
        // P1-AUD-4: validar rango de org (1..MAX_ORGS-1). Antes: org=0 era aceptado.
        // P1-AUD-FIX: ErrorMsg no soporta formato, pre-formatear el mensaje
        if(org < 1 || org >= MAX_ORGS)
        {
                new errDarLider[128];
                format(errDarLider, sizeof(errDarLider), "ID de organizacion invalido (1-%d).", MAX_ORGS - 1);
                return ErrorMsg(playerid, errDarLider);
        }
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(i == id)
                        {
                                // FIX AUDIT PRENSA: resetear flags de org civil antes de asignar nueva org
                                FlushPlayerOrgFlags(i);
                                PlayerInfo[i][Org] = org;
                                // Cargo maximo segun org (FIX P0-3: agregado org 10 = Paramedicos = 4)
                                // Transito(2)=3 | Policia(1)=5 | FBI(3)=6 | SWAT(4)=3 | Ejercito(14)=6 | Paramedicos(10)=4 | resto=3
                                new cargoMax;
                                if(org == 1)       cargoMax = 5; // Policia Nacional -> Comisario
                                else if(org == 3)  cargoMax = 5; // FBI -> Director (5 rangos)
                                else if(org == 10) cargoMax = 4; // Paramedicos -> Director Medico
                                else if(org == 14) cargoMax = 6; // Ejercito -> General
                                else               cargoMax = 3; // Transito, SWAT y resto -> rango 3
                                PlayerInfo[i][Cargo] = cargoMax;
                                format(String,sizeof(String),"El jugador %s te dio lider de Organizacion %s",Name(playerid),NomeOrg(i));
                                InfoMsg(i, String);
                                format(String,sizeof(String),"El jugador %s recibio lider de Organizacion %s",Name(i),NomeOrg(i));
                                SuccesMsg(playerid, String);
                                addlider(i, org);
                        }
                }
        }

        return 1;
}

CMD:limpiarlider(playerid,params[])
{
        new id, String[500];
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params,"i",id))return ErrorMsg(playerid," /limpiarlider [ID DE LA ORG]");
        format(String, sizeof(String), PASTA_ORGS, id);
        if(!DOF2_FileExists(String)) return ErrorMsg(playerid, "Esa organizacion no existe.");
        if(!strcmp(DOF2_GetString(String,VagasORG[0]),"ninguno",true)) return ErrorMsg(playerid, "No hay lider en esa Organizacion.");
        for(new i = 0; i < sizeof VagasORG; i++)
        {
                DOF2_SetString(String, VagasORG[i], "ninguno");
        }
        DOF2_SaveFile();
        // Quitar lider en linea si esta conectado
        foreach(new i : Player)
        {
                if(pLogado[i] == true && PlayerInfo[i][Org] == id && IsOrgLeader(i)) // FIX AUDIT: usar IsOrgLeader en vez de Cargo >= 3
                {
                        PlayerInfo[i][Org] = 0;
                        if(Patrulha[i] == true) { Patrulha[i] = false; if(policiaon > 0) policiaon--; } // FIX P0-1: prevenir underflow
                        // P1-LimpiarLider: remover SOLO las armas de organizacion (no las personales)
                        // Antes: ResetPlayerWeapons + CarregarArmas. Problema: si el archivo Armas/%s.ini
                        // tenia armas de org guardadas (por desconexion en servicio), se recargaban.
                        // Ahora: RemoverArmasOrg elimina solo las armas que las orgs entregan.
                        RemoverArmasOrg(i);
                        SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                        SetPlayerArmour(i, 0);
                        SetPlayerColor(i, 0xFFFFFFFF);
                        PlayerInfo[i][Cargo] = 0;
                        ErrorMsg(i, "Tu lider de organizacion fue removido por un administrador.");
                        // Guardar el estado actual para que las armas personales persistan
                        SalvarArmas(i);
                }
        }
        SuccesMsg(playerid,"Org resetada correctamente!");
        return 1;
}

CMD:limpiarlideres(playerid,params[])
{
        new String[500];
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        for(new vagads = 1; vagads < MAX_ORGS; vagads++)
        {
                format(String, sizeof(String), PASTA_ORGS, vagads);
                if(!DOF2_FileExists(String)) continue;
                for(new i = 0; i < sizeof VagasORG; i++)
                {
                        DOF2_SetString(String, VagasORG[i], "ninguno");
                }
                DOF2_SaveFile();
        }
        // Quitar cargo de lider a jugadores conectados
        foreach(new i : Player)
        {
                if(pLogado[i] == true && IsOrgLeader(i)) // FIX AUDIT: usar IsOrgLeader en vez de Cargo >= 3
                {
                        PlayerInfo[i][Org] = 0;
                        if(Patrulha[i] == true) { Patrulha[i] = false; if(policiaon > 0) policiaon--; } // FIX P0-1: prevenir underflow
                        // P1-LimpiarLider: remover SOLO las armas de organizacion (no las personales)
                        RemoverArmasOrg(i);
                        SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                        SetPlayerArmour(i, 0);
                        SetPlayerColor(i, 0xFFFFFFFF);
                        PlayerInfo[i][Cargo] = 0;
                        ErrorMsg(i, "Tu liderazgo fue removido por un administrador.");
                        // Guardar el estado actual para que las armas personales persistan
                        SalvarArmas(i);
                }
        }
        SuccesMsg(playerid, "Todos los lideres han sido eliminados correctamente.");
        return 1;
}

CMD:pagar(playerid, params[])
{
        new id, quantia, string[800];
        if(sscanf(params,"ii",id,quantia)) return ErrorMsg(playerid,  "/pagar [ID] [CANTIDAD]");
        if(quantia <= 0) return ErrorMsg(playerid, "La cantidad debe ser mayor a 0."); // FIX AUDIT: exploit cantidad negativa
        if(PlayerInfo[playerid][pDinheiro] < quantia) return ErrorMsg(playerid, "Dinero insuficiente");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(i == id)
                        {
                                if(!ProxDetectorS(8.0, playerid, i))return ErrorMsg(playerid, "No esta proximo de jugador.");
                                // FIX AUDIT AGENT5 XS-07: antes escribia pDinheiro directamente
                                // sin AC_AddPlayerMoney (sin sync cliente ni grace window) ni
                                // SalvarDados. Resultado: (1) si quantia > $10k el sender recibia
                                // strike falso del AC de dinero; (2) si server crashea antes del
                                // SaveTimer (60s), ambos jugadores pierden el dinero transferido.
                                AC_AddPlayerMoney(playerid, -quantia);
                                AC_AddPlayerMoney(i, quantia);
                                SalvarDados(playerid);
                                SalvarDados(i);
                                format(string, sizeof(string), "Pagaste $%d para %04d", quantia, PlayerInfo[i][IDF]);
                                SuccesMsg(playerid, string);
                                format(string, sizeof(string), "Recibiste $%d de %04d.", quantia, PlayerInfo[playerid][IDF]);
                                InfoMsg(i, string);
                        }
                }
        }
        return 1;
}

CMD:ag(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
        if(pLogado[playerid] == false)                                          return ErrorMsg(playerid, "Necesita iniciar login.");
        new catList[768];
        strcat(catList, "{FFFF00}1.{FFFFFF} Comandos Generales\n");
        strcat(catList, "{FFFF00}2.{FFFFFF} Castigos\n");
        strcat(catList, "{FFFF00}3.{FFFFFF} Teletransporte / Espectador\n");
        strcat(catList, "{FFFF00}4.{FFFFFF} Jugadores\n");
        strcat(catList, "{FFFF00}5.{FFFFFF} Vehiculos / Concesionarias\n");
        strcat(catList, "{FFFF00}6.{FFFFFF} Combustible / Estaciones\n");
        strcat(catList, "{FFFF00}7.{FFFFFF} Radares / Carreteras\n");
        strcat(catList, "{FFFF00}8.{FFFFFF} Organizaciones / Casas\n");
        strcat(catList, "{FFFF00}9.{FFFFFF} Eventos\n");
        strcat(catList, "{FFFF00}10.{FFFFFF} Economia / VIP / Coins\n");
        strcat(catList, "{FFFF00}11.{FFFFFF} Mapeo\n");
        strcat(catList, "{FFFF00}12.{FFFFFF} Sistema / Servidor\n");
        strcat(catList, "{FFFF00}13.{FFFFFF} Investigacion / IP\n");
        strcat(catList, "{FFFF00}14.{FFFFFF} Logs / Auditoria\n");
        if(PlayerInfo[playerid][pAdmin] >= 7)
                strcat(catList, "{FF0000}15.{FFFFFF} Desarrollo\n");
        strcat(catList, "{FFFF00}16.{FFFFFF} Otros Comandos Admin\n");
        ShowPlayerDialog(playerid, DIALOG_AG_MENU, DIALOG_STYLE_LIST, "Ayuda Admin - Categorias", catList, "Ver", "X");
        return 1;
}

CMD:d(playerid, params[])
{
        // P1-MED-4: paramedicos ahora tienen acceso a /d (radio departamental)
        if(!IsPolicial(playerid) && PlayerInfo[playerid][Org] != 10)
                return ErrorMsg(playerid, "No tienes permisos.");
        // Policias requieren Patrulha, paramedicos requieren uniforme vestido
        if(IsPolicial(playerid) && Patrulha[playerid] == false)
                return ErrorMsg(playerid, "No estas en patrulla.");
        if(PlayerInfo[playerid][Org] == 10 && paramedico[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        if(sscanf(params, "s[128]", Str))                       return ErrorMsg(playerid,"Uso: /d [TEXTO] (max 128 caracteres)");

        // P1-1: Radio departamental compartida entre TODAS las fuerzas del orden + Paramedicos.
        // Formato: [DEP] [TAG] %04d %s: texto
        new depTag[8];
        if(PlayerInfo[playerid][Org] == 10)
                format(depTag, sizeof(depTag), "MED");
        else
                GetOrgPolicialTag(PlayerInfo[playerid][Org], depTag, sizeof(depTag));
        format(Str, sizeof(Str), "{FFFFFF}[{FF6347}DEP{FFFFFF}] [{FF6347}%s{FFFFFF}] {FFFF00}%04d{FFFFFF} %s: {DDA0DD}%s",
               depTag, PlayerInfo[playerid][IDF], NomeCargo(playerid), Str);
        SendRadioMessage(0xDDA0DDFF, Str);

        return 1;
}

// =====================================================================
// P1-1: Radio INTERNA de organizacion policial.
// Solo reciben miembros de la MISMA org que esten en servicio (Patrulha==true).
// Cada org tiene su color unico para identificacion visual inmediata.
// Formato: [Radio <Org>] %04d %s: texto
// =====================================================================
CMD:noticia(playerid, params[])
{
        // P0-REP-1: comando exclusivo de Reporteros para publicar noticias
        if(PlayerInfo[playerid][Org] != 11)
                return ErrorMsg(playerid, "Solo los Reporteros pueden publicar noticias.");
        if(pLogado[playerid] == false) return ErrorMsg(playerid, "No has iniciado sesion.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        // P0-REP-FIX: requiere estar en servicio (uniforme vestido)
        if(reportero[playerid] == false)
                return ErrorMsg(playerid, "Debes vestir el uniforme de reportero primero. Ve a la HQ y presiona H.");
        if(sscanf(params, "s[128]", Str))
                return ErrorMsg(playerid, "Uso: /noticia [TEXTO] (max 128 caracteres)");

        // P0-REP-1: cooldown de 30 segundos anti-spam
        new lastNoticia = GetPVarInt(playerid, "NoticiaCooldown");
        new now = gettime();
        if(now - lastNoticia < 30)
        {
                new cdMsg[100];
                format(cdMsg, sizeof(cdMsg), "Debes esperar %d segundos para publicar otra noticia.", 30 - (now - lastNoticia));
                return ErrorMsg(playerid, cdMsg);
        }
        SetPVarInt(playerid, "NoticiaCooldown", now);

        // Enviar noticia global con prefijo [NOTICIA BREAKING]
        new noticiaStr[256];
        format(noticiaStr, sizeof(noticiaStr), "{FFFF00}[NOTICIA BREAKING]{FFFFFF} %s {FF6347}%04d{FFFFFF}: %s",
               NomeOrg(playerid), PlayerInfo[playerid][IDF], Str);
        SendClientMessageToAll(0xFFA500FF, noticiaStr);

        // FIX AUDIT PRENSA: notificacion push (sonido + GameText)
        PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
        foreach(new p : Player)
        {
            if(pLogado[p] && p != playerid)
                PlayerPlaySound(p, 1052, 0.0, 0.0, 0.0);
        }
        GameTextForAll("~n~~n~~n~~y~NOTICIA BREAKING~n~~w~Revisa el chat!", 3000, 5);

        // FIX AUDIT PRENSA: persistir noticia a archivo INI diario
        new logFile[64], logKey[32], horaN, minN, segN, diaN, mesN, anoN;
        gettime(horaN, minN, segN);
        getdate(anoN, mesN, diaN);
        format(logFile, sizeof(logFile), "Noticias/%02d-%02d-%04d.ini", diaN, mesN, anoN);
        if(!DOF2_FileExists(logFile)) DOF2_CreateFile(logFile);
        new totalNoticias = DOF2_GetInt(logFile, "Total");
        totalNoticias++;
        format(logKey, sizeof(logKey), "Noticia_%d", totalNoticias);
        new logMsg[256];
        format(logMsg, sizeof(logMsg), "[%02d:%02d:%02d] %s (IDF:%04d): %s", horaN, minN, segN, Name(playerid), PlayerInfo[playerid][IDF], Str);
        DOF2_SetString(logFile, logKey, logMsg);
        DOF2_SetInt(logFile, "Total", totalNoticias);
        DOF2_SaveFile();

        SuccesMsg(playerid, "Noticia publicada a todos los jugadores.");
        printf("[P0-REP-1] Reportero ID %d (%s) publico noticia: %s", playerid, Name(playerid), Str);
        return 1;
}

// FIX AUDIT PRENSA: /entrevista - grabar entrevista con un jugador
CMD:entrevista(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 11) return ErrorMsg(playerid, "Solo los Reporteros pueden hacer entrevistas.");
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        if(reportero[playerid] == false) return ErrorMsg(playerid, "Debes vestir el uniforme de reportero primero.");
        new targetid;
        if(sscanf(params, "u", targetid)) return ErrorMsg(playerid, "Uso: /entrevista [ID del jugador] (luego escribe /eresponder para cada respuesta)");
        if(!IsPlayerConnected(targetid)) return ErrorMsg(playerid, "Jugador no conectado.");
        if(targetid == playerid) return ErrorMsg(playerid, "No puedes entrevistarte a ti mismo.");
        // Cooldown 60s
        if(GetPVarInt(playerid, "EntrevistaCooldown") > 0)
        {
                new msg[80];
                format(msg, sizeof(msg), "Debes esperar %d segundos para otra entrevista.", GetPVarInt(playerid, "EntrevistaCooldown"));
                return ErrorMsg(playerid, msg);
        }
        SetPVarInt(playerid, "EntrevistaCooldown", 60);
        SetPVarInt(playerid, "EntrevistandoA", targetid);
        SetPVarInt(targetid, "SiendoEntrevistado", playerid);
        // Notificar a ambos
        new msgStart[128];
        format(msgStart, sizeof(msgStart), "Comenzaste una entrevista con %s. Usa /epregunta [texto] para preguntar.", Name(targetid));
        SuccesMsg(playerid, msgStart);
        format(msgStart, sizeof(msgStart), "%s te esta entrevistando. Usa /eresponder [texto] para responder.", Name(playerid));
        InfoMsg(targetid, msgStart);
        // Log inicio
        new logFile[64], logKey[32], horaN, minN, segN, diaN, mesN, anoN;
        gettime(horaN, minN, segN);
        getdate(anoN, mesN, diaN);
        format(logFile, sizeof(logFile), "Entrevistas/%02d-%02d-%04d.ini", diaN, mesN, anoN);
        if(!DOF2_FileExists(logFile)) DOF2_CreateFile(logFile);
        new totalEnt = DOF2_GetInt(logFile, "Total");
        totalEnt++;
        format(logKey, sizeof(logKey), "Entrevista_%d_Inicio", totalEnt);
        new logMsg[256];
        format(logMsg, sizeof(logMsg), "[%02d:%02d:%02d] Reportero: %s | Entrevistado: %s", horaN, minN, segN, Name(playerid), Name(targetid));
        DOF2_SetString(logFile, logKey, logMsg);
        DOF2_SetInt(logFile, "Total", totalEnt);
        DOF2_SetInt(logFile, "UltimaEntrevista", totalEnt);
        DOF2_SaveFile();
        SetPVarInt(playerid, "EntrevistaID", totalEnt);
        return 1;
}

// /epregunta - el reportero hace una pregunta durante la entrevista
CMD:epregunta(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 11) return ErrorMsg(playerid, "Solo los Reporteros pueden usar esto.");
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        if(reportero[playerid] == false) return ErrorMsg(playerid, "Debes vestir el uniforme.");
        new targetid = GetPVarInt(playerid, "EntrevistandoA");
        if(targetid <= 0 || !IsPlayerConnected(targetid)) return ErrorMsg(playerid, "No estas entrevistando a nadie. Usa /entrevista [ID].");
        if(isnull(params)) return ErrorMsg(playerid, "Uso: /epregunta [texto]");
        // Enviar pregunta al entrevistado
        new msg[256];
        format(msg, sizeof(msg), "{FFFF00}[ENTREVISTA] Pregunta de %s:{FFFFFF} %s", Name(playerid), params);
        SendClientMessage(targetid, 0xFFA500FF, msg);
        format(msg, sizeof(msg), "{FFFF00}[ENTREVISTA] Le preguntaste a %s:{FFFFFF} %s", Name(targetid), params);
        SendClientMessage(playerid, 0xFFA500FF, msg);
        // Persistir
        new logFile[64], logKey[32], diaN, mesN, anoN;
        getdate(anoN, mesN, diaN);
        format(logFile, sizeof(logFile), "Entrevistas/%02d-%02d-%04d.ini", diaN, mesN, anoN);
        new entId = GetPVarInt(playerid, "EntrevistaID");
        format(logKey, sizeof(logKey), "Entrevista_%d_Q_%d", entId, gettime());
        DOF2_SetString(logFile, logKey, params);
        DOF2_SaveFile();
        return 1;
}

// /eresponder - el entrevistado responde
CMD:eresponder(playerid, params[])
{
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        new reporterId = GetPVarInt(playerid, "SiendoEntrevistado");
        if(reporterId <= 0 || !IsPlayerConnected(reporterId)) return ErrorMsg(playerid, "No estas siendo entrevistado.");
        if(isnull(params)) return ErrorMsg(playerid, "Uso: /eresponder [texto]");
        // Enviar respuesta al reportero
        new msg[256];
        format(msg, sizeof(msg), "{00FF00}[ENTREVISTA] Respuesta de %s:{FFFFFF} %s", Name(playerid), params);
        SendClientMessage(reporterId, 0x00FF00FF, msg);
        format(msg, sizeof(msg), "{00FF00}[ENTREVISTA] Tu respuesta:{FFFFFF} %s", params);
        SendClientMessage(playerid, 0x00FF00FF, msg);
        // Persistir
        new logFile[64], logKey[32], diaN, mesN, anoN;
        getdate(anoN, mesN, diaN);
        format(logFile, sizeof(logFile), "Entrevistas/%02d-%02d-%04d.ini", diaN, mesN, anoN);
        new entId = GetPVarInt(reporterId, "EntrevistaID");
        format(logKey, sizeof(logKey), "Entrevista_%d_R_%d", entId, gettime());
        DOF2_SetString(logFile, logKey, params);
        DOF2_SaveFile();
        return 1;
}

// /terminarentrevista - finaliza la entrevista
CMD:terminarentrevista(playerid)
{
        if(PlayerInfo[playerid][Org] != 11) return ErrorMsg(playerid, "Solo los Reporteros pueden usar esto.");
        new targetid = GetPVarInt(playerid, "EntrevistandoA");
        if(targetid <= 0) return ErrorMsg(playerid, "No estas entrevistando a nadie.");
        DeletePVar(playerid, "EntrevistandoA");
        DeletePVar(playerid, "EntrevistaID");
        DeletePVar(targetid, "SiendoEntrevistado");
        SuccesMsg(playerid, "Entrevista finalizada. El registro se guardo en el archivo de entrevistas.");
        if(IsPlayerConnected(targetid))
                InfoMsg(targetid, "La entrevista ha finalizado.");
        return 1;
}

// /transmision - broadcast global especial de prensa
CMD:transmision(playerid, params[])
{
        if(PlayerInfo[playerid][Org] != 11) return ErrorMsg(playerid, "Solo los Reporteros pueden transmitir.");
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        if(reportero[playerid] == false) return ErrorMsg(playerid, "Debes vestir el uniforme de reportero primero.");
        // Solo Director (cargo 3) puede transmitir
        if(PlayerInfo[playerid][Cargo] < 3) return ErrorMsg(playerid, "Solo el Director puede usar /transmision.");
        if(isnull(params)) return ErrorMsg(playerid, "Uso: /transmision [TEXTO] (max 128 caracteres)");
        if(strlen(params) > 128) return ErrorMsg(playerid, "El texto no puede exceder 128 caracteres.");
        // Cooldown 120s (mas largo que /noticia porque es del Director)
        if(GetPVarInt(playerid, "TransmisionCooldown") > 0)
        {
                new msg[80];
                format(msg, sizeof(msg), "Debes esperar %d segundos para otra transmision.", GetPVarInt(playerid, "TransmisionCooldown"));
                return ErrorMsg(playerid, msg);
        }
        SetPVarInt(playerid, "TransmisionCooldown", 120);
        // Broadcast con formato especial y sonido de emergencia
        new transStr[256];
        format(transStr, sizeof(transStr), "{FF0000}[TRANSMISION EN VIVO]{FFFFFF} Director %s {FF6347}%04d{FFFFFF}: %s",
               Name(playerid), PlayerInfo[playerid][IDF], params);
        SendClientMessageToAll(0xFF0000FF, transStr);
        // Notificacion push: sonido + GameText grande
        foreach(new p : Player)
        {
            if(pLogado[p])
                PlayerPlaySound(p, 1058, 0.0, 0.0, 0.0);
        }
        GameTextForAll("~n~~n~~r~TRANSMISION EN VIVO~n~~w~Revisa el chat!", 5000, 5);
        // Persistir
        new logFile[64], logKey[32], horaN, minN, segN, diaN, mesN, anoN;
        gettime(horaN, minN, segN);
        getdate(anoN, mesN, diaN);
        format(logFile, sizeof(logFile), "Noticias/%02d-%02d-%04d.ini", diaN, mesN, anoN);
        if(!DOF2_FileExists(logFile)) DOF2_CreateFile(logFile);
        new totalN = DOF2_GetInt(logFile, "Total");
        totalN++;
        format(logKey, sizeof(logKey), "Noticia_%d", totalN);
        new logMsg[256];
        format(logMsg, sizeof(logMsg), "[%02d:%02d:%02d] [TRANSMISION] %s (IDF:%04d): %s", horaN, minN, segN, Name(playerid), PlayerInfo[playerid][IDF], params);
        DOF2_SetString(logFile, logKey, logMsg);
        DOF2_SetInt(logFile, "Total", totalN);
        DOF2_SaveFile();
        SuccesMsg(playerid, "Transmision enviada a todos los jugadores.");
        printf("[PRENSA] Director ID %d (%s) transmitio: %s", playerid, Name(playerid), params);
        return 1;
}

CMD:r(playerid, params[])
{
        if(!IsPolicial(playerid))                                               return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en patrulla.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
        if(sscanf(params, "s[56]", Str))                                return ErrorMsg(playerid,"USE: /r [TEXTO]");

        new org = PlayerInfo[playerid][Org];
        new color = GetOrgPolicialColor(org);
        new orgName[35];
        strcpy(orgName, NomeOrg(playerid));

        format(Str, sizeof(Str), "{FFFFFF}[{FFFF00}Radio %s{FFFFFF}] {FFFF00}%04d{FFFFFF} %s: %s",
               orgName, PlayerInfo[playerid][IDF], NomeCargo(playerid), Str);
        SendOrgPolicialMessage(color, Str, org);

        return 1;
}

CMD:ga(playerid, params[])
{
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        if(!IsBandido(playerid)) return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params, "s[56]", Str)) return ErrorMsg(playerid, "USE: /ga [TEXTO]");

        new org = PlayerInfo[playerid][Org];
        new color;
        switch(org)
        {
                case 5:  color = 0xFF4444FF; // Banda Roja - rojo
                case 6:  color = 0xAAAAAAFF; // Banda Sobras de Plomo - gris
                case 7:  color = 0xFFFF00FF; // Banda Amarilla - amarillo
                case 8:  color = 0x00CC00FF; // Banda Verde - verde
                case 12: color = 0xAA00FFFF; // Banda Delincuentes Anonimos - morado
                case 13: color = 0x4B0082FF; // Moto Club - indigo
                default: color = 0xDDA0DDFF;
        }
        // FASE 7.2: rol visual segun el cargo del jugador
        // Lider (cargo mas alto) = [Lider] en rojo brillante
        // Sublider (segundo cargo) = [Sub] en amarillo
        // Miembro = sin tag extra
        new cargoGa = PlayerInfo[playerid][Cargo];
        new maxCargoGa = GetOrgCargoMax(org);
        new rolTag[32];
        if(cargoGa == maxCargoGa)
                format(rolTag, sizeof(rolTag), "{FF0000}[Lider]{FFFFFF} ");
        else if(cargoGa == maxCargoGa - 1)
                format(rolTag, sizeof(rolTag), "{FFFF00}[Sub]{FFFFFF} ");
        else
                rolTag = "";
        format(Str, sizeof(Str), "{FFFFFF}[Radio - %s] {FFFF00}%04d{FFFFFF} %s%s{FFFFFF}: %s", GangOrgNombre[OrgGangIndex(org)], PlayerInfo[playerid][IDF], rolTag, NomeCargo(playerid), Str);
        SendGangMessage(color, Str, org);

        return 1;
}

CMD:algemar(playerid, params[])
{
        // P2-PN-1: solo arrestantes pueden esposar (no Transito)
        if(!IsPoliciaArrestante(playerid))        return ErrorMsg(playerid, "No tienes permisos. Solo PN/FBI/SWAT/Ejercito.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USO: /algemar [ID] o /esposar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                // P0-PN-2: validar distancia antes de esposar.
                                // Antes se podia esposar a un jugador en otra ciudad con solo saber su IDF.
                                // Radio de 7m (IsPertoArresto) consistente con /prender.
                                if(!IsPertoArresto(playerid, i))
                                        return ErrorMsg(playerid, "No estas cerca del sospechoso (max 7m).");
                                // P1-PN-1: validar que el sospechoso este a pie (no en vehiculo).
                                // Antes se podia esposar a un sospechoso conduciendo a 150 km/h.
                                if(IsPlayerInAnyVehicle(i))
                                        return ErrorMsg(playerid, "El sospechoso debe estar a pie para ser esposado.");
                                // P3-1: animacion de arresto policial (POLICE/CopTaze_Cop)
                                ApplyAnimation(playerid, "POLICE", "CopTaze_Cop", 4.1, 0, 1, 1, 0, 0, 1);
                                TogglePlayerControllable(i, false);
                                PlayerInfo[i][pCongelado] = true;
                                // FIX AUDIT AFK H9: timestamp de algemado para auto-release tras 10 min.
                                // Antes: si el cop se desconecta sin /desalgemar, el jugador queda
                                // algemado indefinidamente (solo se libera si el cop reconecta y
                                // desalgema, o si un admin interviene). Un cop malicioso podia
                                // algemar a un amigo para eximirlo de AFK (bypass H9).
                                // Ahora: se setea AlgemadoTs = gettime(). AntiAway checkea si han
                                // pasado > ALGEMADO_TIMEOUT_SEC (600 = 10 min) y libera automaticamente.
                                SetPVarInt(i, "AlgemadoTs", gettime());
                                // FIX AUDIT 5P [A3]: tracking de que oficial esposo al sospechoso
                                // (para liberarlo si el oficial se desconecta, evitando algemado permanente)
                                SetPVarInt(i, "AlgemadoPor", PlayerInfo[playerid][IDF]);
                                SetPVarInt(i, "AlgemadoCop", playerid); // playerid actual del cop
                                SuccesMsg(playerid, "Esposaste al individuo.");
                                InfoMsg(i, "Has sido esposado.");
                                SetPlayerAttachedObject(i, 5, 19418, 6, -0.031999, 0.024000, -0.024000, -7.900000, -32.000011, -72.299987, 1.115998, 1.322000, 1.406000);
                                SetPlayerSpecialAction(i, SPECIAL_ACTION_CUFFED);
                        }
                }
        }

        return 1;
}

// =====================================================================
// ALIAS: /esposar es un alias de /algemar. Llama a la misma logica.
// ZCMD compila cada CMD:nombre como cmd_nombre(playerid, params[]),
// por lo que podemos reusar la funcion directamente.
// =====================================================================
CMD:esposar(playerid, params[]) return cmd_algemar(playerid, params);

CMD:desalgemar(playerid, params[])
{
        // P2-PN-1: solo arrestantes pueden desesposar (no Transito)
        if(!IsPoliciaArrestante(playerid))        return ErrorMsg(playerid, "No tienes permisos. Solo PN/FBI/SWAT/Ejercito.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USO: /desalgemar [ID] o /qesposas [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                TogglePlayerControllable(i, true);
                                PlayerInfo[i][pCongelado] = false;
                                // FIX AUDIT 5P [A3]: limpiar PVars de tracking al desesposar
                                DeletePVar(i, "AlgemadoPor");
                                DeletePVar(i, "AlgemadoCop");
                                // FIX AUDIT AFK H9: limpiar timestamp de algemado al desesposar.
                                DeletePVar(i, "AlgemadoTs");
                                SuccesMsg(playerid, "Desesposaste al individuo.");
                                InfoMsg(i, "Has sido desesposado.");
                                ClearAnimations(i);
                                RemovePlayerAttachedObject(i,5);
                                SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
                        }
                }
        }

        return 1;
}

// =====================================================================
// ALIAS: /qesposas es un alias de /desalgemar. Llama a la misma logica.
// =====================================================================
CMD:qesposas(playerid, params[]) return cmd_desalgemar(playerid, params);

CMD:pveiculo(playerid, params[])
{
        if(IsPolicial(playerid) || IsBandido(playerid))
        {
                if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USE: /pveiculo [ID]");
                foreach(new i : Player)
                {
                        if(pLogado[i] == true)
                        {
                                if(PlayerInfo[i][IDF] == ID)
                                {
                                        new carid = GetPlayerVehicleID(playerid);
                                        if(!IsPlayerInAnyVehicle(playerid))                     return ErrorMsg(playerid, "No estas en un vehiculo.");
                                        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)             return ErrorMsg(playerid, "No estas conduciendo.");
                                        if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca del jugador.");
                                        TogglePlayerControllable(i, 0);
                                        PutPlayerInVehicle(i, carid, 4);
                                }
                        }
                }

        }
        return 1;
}

CMD:rveiculo(playerid, params[])
{
        if(IsPolicial(playerid) || IsBandido(playerid))
        {
                if(sscanf(params, "i", ID))                                     return ErrorMsg(playerid,"USE: /rveiculo [ID]");
                foreach(new i : Player)
                {
                        if(pLogado[i] == true)
                        {
                                if(PlayerInfo[i][IDF] == ID)
                                {
                                        if(!IsPlayerInAnyVehicle(playerid))                     return ErrorMsg(playerid, "No estas en un vehiculo.");
                                        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)             return ErrorMsg(playerid, "No eres el conductor.");
                                        if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca del jugador.");
                                        TogglePlayerControllable(i, true);
                                        RemovePlayerFromVehicle(i);
                                }
                        }
                }

        }
        return 1;
}

// =====================================================================
// ALIAS: /arrestar es un alias de /prender. Llama a la misma logica.
// =====================================================================
CMD:arrestar(playerid, params[]) return cmd_prender(playerid, params);

CMD:prender(playerid, params[])
{
        // P2-PN-1: solo PN/FBI/SWAT/Ejercito pueden arrestar (no Transito).
        // Antes: IsPolicial() aceptaba Transito, permitiendo que agen de transito arresten.
        if(!IsPoliciaArrestante(playerid))         return ErrorMsg(playerid, "No tienes permisos. Solo PN/FBI/SWAT/Ejercito pueden arrestar.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "iis[56]", ID, Numero, Motivo))                       return ErrorMsg(playerid,"USE: /prender [ID] [MINUTOS] [MOTIVO] o /arrestar [ID] [MINUTOS] [MOTIVO]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                // P0-PN-1: validar que este en un vehiculo policial (no cualquier vehiculo)
                                if(!IsPlayerInAnyVehicle(playerid))                     return ErrorMsg(playerid, "No estas en un vehiculo policial.");
                                new arrestVeh = GetPlayerVehicleID(playerid);
                                if(!IsVehiclePolicial(arrestVeh))                      return ErrorMsg(playerid, "Debes estar en un vehiculo policial (patrulla/FBI/SWAT/Ejercito) para arrestar.");
                                // FIX P0-3: validar distancia estricta (7m) y que el sospechoso este algemado.
                                // Antes se usaba IsPerto con radio de 30m, lo que permitia arrestos a distancia absurda.
                                if(!IsPertoArresto(playerid,i))return ErrorMsg(playerid, "No estas cerca del sospechoso (max 7m).");
                                if(PlayerInfo[i][pCongelado] == false)                  return ErrorMsg(playerid, "El sospechoso debe estar algemado primero (/algemar).");
                                // FIX AUDIT ARRESTO 6P [C1]: validar Numero > 0 antes de continuar
                                if(Numero <= 0) return ErrorMsg(playerid, "Los minutos deben ser mayores a 0.");
                                // FIX AUDIT ARRESTO 6P [C2]: guardar posicion del preso ANTES de teleport
                                // (para que el decomiso policial funcione correctamente)
                                new arrestedTerrID = Terr_ZonaDelJugador(i);
                                if(PlayerToPoint(3.0, playerid, 658.691955, -1465.217651, 15.439466))
                                {

                                        if(Numero != 0)
                                        {
                                                // FIX AUDIT-AUDIT6-S-ALTO-002 (ALTO): cleanup autoescuela antes de arrestar.
                                                // ANTES: RemovePlayerFromVehicle(i) NO dispara OnPlayerExitVehicle (SA-MP behavior).
                                                // El examen quedaba en estado zombie: timer 1s activo, flag IniciouTesteHabilitacaoX=1,
                                                // vehiculo flotando 40min. Ahora: cleanup completo via helper.
                                                AutoEscola_FlushPlayer(i);
                                                // P3-1: animacion de lectura de derechos (POLICE/CopTaze_Cop para el oficial, HANDS_UP para el preso)
                                                ApplyAnimation(playerid, "POLICE", "CopTaze_Cop", 4.1, 0, 1, 1, 0, 0, 1);
                                                ApplyAnimation(i, "PED", "HANDSUP", 4.1, 0, 1, 1, 0, 0, 1);
                                                // P1-6b: bonus por arresto reducido de $500-1200 a $200-500.
                                                // Antes un oficial podia farmear $5,000-12,000 extra en 2h solo de arrestos.
                                                // Ahora el bonus es simbolico: cubre gastos operativos (municion, gasolina),
                                                // no es una fuente de enriquecimiento.
                                                new randval = randomEx(200,500),str[128];
                                                PlayerInfo[playerid][pBanco] += randval;
                                                format(str,sizeof(str),"Recibiste una bonificacion de $%i por la detencion del individuo.",randval);
                                                SendClientMessage(playerid, -1, str); // FIX AUDIT ARRESTO 6P [C4]: enviar mensaje de bonus (antes era dead code)
                                                SalvarDados(playerid); // FIX AUDIT ARRESTO 6P: persistir bonus al banco
                                                PlayerInfo[i][pjail] = Numero * 60;
                                                // FIX AUDIT ARRESTO 6P [C5]: liberar celda anterior si el preso ya tenia una (cell leak en re-arresto)
                                                if(g_PlayerCell[i] >= 0 && g_JailCellOccupied[g_PlayerCell[i]])
                                                        FreeJailCell(i);
                                                // P0-PN-3: asignar celda libre en vez de coordenada fija
                                                new arrestCell = AssignJailCell(i);
                                                if(arrestCell >= 0)
                                                {
                                                        SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-08: inmunidad anti-teleport al arrestar
                                                        SetPlayerPos(i, g_JailCells[arrestCell][0], g_JailCells[arrestCell][1], g_JailCells[arrestCell][2]);
                                                }
                                                else
                                                {
                                                        SetPVarInt(i, "ACTPImmune", gettime()); // FIX AUDIT AGENT2 TP-08: inmunidad anti-teleport (fallback)
                                                        SetPlayerPos(i, g_JailCells[0][0], g_JailCells[0][1], g_JailCells[0][2]); // fallback si todas ocupadas
                                                }
                                                SetPlayerInterior(i, 5);
                                                SetPlayerVirtualWorld(i, 0);
                                                InfoMsg(i, "Preso por cometer delitos.");
                                                // FIX AUDIT 5P [A3]: limpiar PVars de tracking al arrestar
                                                DeletePVar(i, "AlgemadoPor");
                                                DeletePVar(i, "AlgemadoCop");
                                                // FIX AUDIT ARRESTO 6P [C6]: resetear pCongelado al arrestar (antes quedaba true = permanente)
                                                PlayerInfo[i][pCongelado] = false;
                                                // FIX AUDIT ARRESTO 6P [C7]: quitar esposas visuales al arrestar
                                                RemovePlayerAttachedObject(i, 5);
                                                SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
                                                SetPlayerWantedLevelSync(i, 0); // FIX AUDIT WANTED: sync pProcurado = 0 al arrestar
                                                TogglePlayerControllable(i, true);
                                                RemovePlayerFromVehicle(i);
                                                ResetPlayerWeapons(i);
                                                RetirarItem(i, 1212);
                                                RetirarItem(i, 854);
                                                RetirarItem(i, 1279);
                                                RetirarItem(i, 902);
                                                RetirarItem(i, 19630);
                                                RetirarItem(i, 1599);
                                                RetirarItem(i, 1600);
                                                RetirarItem(i, 1603);
                                                RetirarItem(i, 1604);
                                                RetirarItem(i, 1608);
                                                RetirarItem(i, 1576);
                                                RetirarItem(i, 1654);
                                                RetirarItem(i, 2218);
                                                RetirarItem(i, 2355);
                                                RetirarItem(i, 2219);
                                                RetirarItem(i, 2220);
                                                RetirarItem(i, 1484);
                                                RetirarItem(i, 1644);
                                                RetirarItem(i, 1546);
                                                RetirarItem(i, 2601);
                                                RetirarItem(i, 3520);
                                                RetirarItem(i, 11746);
                                                RetirarItem(i, 19921);
                                                RetirarItem(i, 1010);
                                                RetirarItem(i, 18870);
                                                RetirarItem(i, 11736);
                                                RetirarItem(i, 18632);
                                                RetirarItem(i, 18645);
                                                RetirarItem(i, 18644);
                                                // P0-CAMION-BLINDADO: confiscar bolsa del camion si la llevaba
                                                if(g_CamionEvento[ce_activo]) Camion_ConfiscarBolsa(i);
                                                TogglePlayerControllable(i, false);
                                                SalvarDados(i); // FIX AUDIT ASSIGNJAILCELL: persistir pjail del preso
                                                SalvarInventario(i); // persistir inventario confiscado
                                                SetTimerEx("carregarobj", 5000, 0, "i", i);
                                                // FIX AUDIT CORREOS A4-04: flush de trabajos al arrestar.
                                                // Antes: un cartero preso conservaba van viva, g_CorreosRutaActiva=true,
                                                // PegouVehProf=true, VehAlugado=1, 5 timers de progreso, VanDestroyTimer,
                                                // CajasSdxObj PlayerObjects leaked, actor + label 3D leaked.
                                                // Al salir de carcel: soft-lockado (/cargar bloqueado por ruta activa,
                                                // rental bloqueado por VehAlugado=1).
                                                // Ahora: FlushPlayerJobs limpia todo estado de trabajos activos.
                                                // Beneficia: Correos + Camionero + Empaquetador + Recolector + Constructor + Sepulturero.
                                                FlushPlayerJobs(i);
                                                // FIX AUDIT CORREOS A4-09: remover attached objects de trabajos tras flush.
                                                // FlushPlayerJobs no remueve objetos visuales attachados (slot 1 caja Correos,
                                                // slot 5 algemas, slot 6 material Constructor, slot 7 basura, slot 9 pickaxe).
                                                // El preso spawneaba con caja/basura/material/pickaxe visualmente attachados.
                                                for(new _slot = 0; _slot < 10; _slot++)
                                                        RemovePlayerAttachedObject(i, _slot);
                                                // FIX AUDIT MEDICO A4-REHAB-MED-03: resetear flags de uniforme de org civil.
                                                // ANTES: paramedico[] y reportero[] no se reseteaban al arrestar.
                                                // El preso spawneaba en jail con uniforme de Paramedico/Reportero visualmente
                                                // y podia seguir usando /chaleco (que requiere g_ChalecoPermitido, que si se
                                                // resetea al desvestir, pero paramedico[] quedaba en true = inconsistencia).
                                                // AHORA: resetear ambos flags al arrestar.
                                                paramedico[i] = false;
                                                reportero[i] = false;
                                                mecanico[i] = false;
                                                g_ChalecoPermitido[i] = false;
                                                g_ChalecoActivo[i] = false;

                                        }
                                        else
                                        {
                                                PlayerInfo[i][pjail] = 1;
                                        }
                                        //
                                        format(Str, sizeof(Str), "{FFFF00}AVISO{FFFFFF} El jugador {FFFF00}%04d{FFFFFF} fue arrestado por {FFFF00}%s {FFFFFF}por {FFFF00}%i {FFFFFF}minutos. Motivo: {FFFF00}%s", PlayerInfo[i][IDF], NomeOrg(playerid), Numero, Motivo);
                                        SendClientMessageToAll(-1, Str);
                                        // P0-TERRITORIO: decomiso policial - si arrestaron a un miembro de banda en su territorio
                                        new arrestedOrg = PlayerInfo[i][Org];
                                        if(arrestedOrg >= 5 && arrestedOrg <= 13 && arrestedOrg != 9)
                                        {
                                                // FIX AUDIT ARRESTO 6P [C8]: usar arrestedTerrID guardado ANTES del teleport
                                                // (antes llamaba Terr_ZonaDelJugador(i) despues de SetPlayerPos a la celda = siempre -1)
                                                if(arrestedTerrID != -1 && g_Terr[arrestedTerrID][t_duenoOrg] == arrestedOrg)
                                                {
                                                        g_Terr[arrestedTerrID][t_capturasPolicia]++;
                                                        new msg[160];
                                                        format(msg, sizeof(msg), "[DECOMISO] Captura %d/%d de %s en su territorio %s.", g_Terr[arrestedTerrID][t_capturasPolicia], TERR_DECOMISO_CAPTURAS, g_HQNombres[arrestedOrg], g_Terr[arrestedTerrID][t_nombre]);
                                                        SendClientMessageToAll(0x00AAFFFF, msg);
                                                        // Si llego a 3 capturas, decomisar territorio
                                                        if(g_Terr[arrestedTerrID][t_capturasPolicia] >= TERR_DECOMISO_CAPTURAS)
                                                        {
                                                                new oldDueno = g_Terr[arrestedTerrID][t_duenoOrg];
                                                                // FIX AUDIT 5P: matar timers de conquista/guerra en curso
                                                                // antes de neutralizar, para que no sobrescriban el neutral
                                                                if(g_Terr[arrestedTerrID][t_conquistaTimer] != -1)
                                                                {
                                                                        KillTimer(g_Terr[arrestedTerrID][t_conquistaTimer]);
                                                                        g_Terr[arrestedTerrID][t_conquistaTimer] = -1;
                                                                }
                                                                if(g_Terr[arrestedTerrID][t_guerraTimer] != -1)
                                                                {
                                                                        KillTimer(g_Terr[arrestedTerrID][t_guerraTimer]);
                                                                        g_Terr[arrestedTerrID][t_guerraTimer] = -1;
                                                                }
                                                                g_Terr[arrestedTerrID][t_conquistaEnCurso] = false;
                                                                g_Terr[arrestedTerrID][t_conquistaOrg] = 0;
                                                                g_Terr[arrestedTerrID][t_conquistaSegundos] = 0;
                                                                g_Terr[arrestedTerrID][t_guerraEnCurso] = false;
                                                                g_Terr[arrestedTerrID][t_guerraAtacante] = 0;
                                                                g_Terr[arrestedTerrID][t_guerraDefensor] = 0;
                                                                g_Terr[arrestedTerrID][t_guerraSegundos] = 0;
                                                                g_Terr[arrestedTerrID][t_bajasAtacante] = 0;
                                                                g_Terr[arrestedTerrID][t_bajasDefensor] = 0;
                                                                g_Terr[arrestedTerrID][t_duenoOrg] = 0; // neutral
                                                                g_Terr[arrestedTerrID][t_capturasPolicia] = 0;
                                                                g_Terr[arrestedTerrID][t_cooldownReto] = gettime() + (TERR_NEUTRAL_HORAS * 3600); // 24h neutral
                                                                Terr_ActualizarColorZona(arrestedTerrID);
                                                                Terr_Guardar(); // FIX AUDIT 5P: ahora SI persiste el cooldownReto (antes se guardaba sin este campo)
                                                                new msgAll[200];
                                                                format(msgAll, sizeof(msgAll), "[DECOMISO] La policia decomiso el territorio %s de %s por exceso de capturas. Neutral por 24h.", g_Terr[arrestedTerrID][t_nombre], g_HQNombres[oldDueno]);
                                                                SendClientMessageToAll(0x00AAFFFF, msgAll);
                                                        }
                                                }
                                        }
                                }
                                else
                                {
                                        // FIX AUDIT ARRESTO 6P [C3]: mensaje de error claro si el oficial no esta en garaje LSPD
                                        return ErrorMsg(playerid, "Debes estar en el garaje del LSPD (marcador en mapa) para arrestar al sospechoso.");
                                }
                        }
                }
        }

        return 1;
}

CMD:ab(playerid)
{
        if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2
        // FIX AUDIT2 AGENT4 S-16: cooldown 5s via PVar CD_ab. Sin esto, un policial
        // o banda podia spamear /ab y floodar ProxDetector (30m radio).
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_ab") < 5)
                return ErrorMsg(playerid, "Espera 5s para usar /ab de nuevo.");
        new String[5000];
        if(IsPolicial(playerid))
        {
                format(String,sizeof(String),"{6959CD}*** %s, DETENERSE O DISPARAREMOS!!!! ***", NomeOrg(playerid));
        }
        if(IsBandido(playerid))
        {
                format(String,sizeof(String),"{6959CD}*** %s, DETENERSE O DISPARAREMOS!!!! ***", NomeOrg(playerid));
        }
        SetPVarInt(playerid, "CD_ab", now); // FIX AUDIT7 UX-1: mover SetPVarInt despues de checks IsPolicial/IsBandido
        ProxDetector(30.0, playerid, String, -1,-1,-1,-1,-1);
        return 1;
}

CMD:su(playerid, params[])
{
        // FIX AUDIT WANTED: todos los policiales pueden usar /su (control interno)
        if(!IsPolicial(playerid))               return ErrorMsg(playerid, "No tienes permisos. Solo policias pueden usar /su.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "di", ID, Numero))                                            return ErrorMsg(playerid,"USE: /su [ID] [LEVEL]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca del jugador.");
                                // FIX AUDIT WANTED: validar rango [0,6] antes de setear
                                if(Numero < 0 || Numero > 6) return ErrorMsg(playerid, "El nivel de buscado debe estar entre 0 y 6.");
                                // FIX AUDIT WANTED: mensaje dinÃ¯Â¿Â½mico segÃ¯Â¿Â½n la org del oficial
                                new orgName[32];
                                new org = PlayerInfo[playerid][Org];
                                if(org == 1) strcpy(orgName, "Policia Nacional", 32);
                                else if(org == 2) strcpy(orgName, "Transito", 32);
                                else if(org == 3) strcpy(orgName, "FBI", 32);
                                else if(org == 4) strcpy(orgName, "SWAT", 32);
                                else if(org == 14) strcpy(orgName, "Ejercito", 32);
                                else strcpy(orgName, "Policial", 32);
                                format(Str, sizeof(Str), "El oficial de %s %04d te puso %i de buscado.", orgName, PlayerInfo[playerid][IDF], Numero);
                                InfoMsg(i, Str);

                                new msgOk[128];
                                format(msgOk, sizeof(msgOk), "Pusiste al jugador %04d como buscado nivel %i.", ID, Numero);
                                SuccesMsg(playerid, msgOk);
                                //
                                SetPlayerWantedLevelSync(i, Numero); // FIX AUDIT WANTED: sync pProcurado
                                SalvarDados(i); // FIX: persistir wanted level
                        }
                }
        }

        return 1;
}

// =====================================================================
// ALIAS: /revisar es un alias de /revistar. Llama a la misma logica.
// =====================================================================
CMD:revisar(playerid, params[]) return cmd_revistar(playerid, params);

// P0-BANDA-ALIAS: /iniciarrutapiezas es alias de /iniciarrotapecas (mejor nombre en espaÃ¯Â¿Â½ol)
CMD:iniciarrutapiezas(playerid) return cmd_iniciarrotapecas(playerid);

// =====================================================================
// P1-FBI-2: Sistema de Agente Encubierto del FBI.
// Comando /encubrir: toggle que activa/desactiva el modo encubierto.
// Disponible para TODOS los miembros del FBI (org 3), cualquier rango.
//
// Mecanica:
//   - Al activarse: guarda skin actual, asigna skin civil aleatorio,
//     cambia color a blanco (civil), marca flag g_FBIEncubierto=true.
//   - Al desactivarse: restaura skin original, color vuelve a azul FBI,
//     flag g_FBIEncubierto=false.
//   - Auto-reset: al entrar en servicio (HudCop[0]) o desconectarse,
//     vuelve a modo oficial automaticamente.
//   - Bloqueo: en modo encubierto no puede usar /algemar, /prender,
//     /multar, /revistar, /verdocumentos, /r, /d (romperia cobertura).
//
// Efecto en otros sistemas:
//   - NomeOrg(): devuelve "Civil" si esta encubierto
//   - /verdocumentos: muestra "Civil" en el campo Org
//   - /r y /d: muestran tag "Civil" en vez de "FBI"
// =====================================================================
CMD:encubrir(playerid)
{
        // Solo FBI puede usarlo
        if(!IsPoliciaInvestigador(playerid))
                return ErrorMsg(playerid, "Comando exclusivo del FBI.");

        // No se puede usar en servicio (romperia la logica de Patrulha)
        if(Patrulha[playerid] == true)
                return ErrorMsg(playerid, "No puedes encubrirte estando en servicio. Sal del servicio primero.");

        // Toggle
        if(g_FBIEncubierto[playerid] == false)
        {
                // Activar modo encubierto
                g_FBIEncubierto[playerid] = true;
                PlayerInfo[playerid][pEncubierto] = true;  // P1-FBI-2: persistir
                g_FBISkinOriginal[playerid] = GetPlayerSkin(playerid);

                // Skin civil aleatorio
                new idx = random(sizeof(g_FBISkinsCiviles));
                SetPlayerSkin(playerid, g_FBISkinsCiviles[idx]);

                // Color civil (blanco)
                SetPlayerColor(playerid, 0xFFFFFFFF);

                // Reset armas (un agente encubierto no anda armado visiblemente)
                ResetPlayerWeapons(playerid);

                SuccesMsg(playerid, "Modo encubierto ACTIVADO. Tu identidad FBI esta oculta.");
                InfoMsg(playerid, "Apareces como Civil. No puedes usar comandos policiales.");
                printf("[P1-FBI-2] FBI ID %d (%s) entro en modo encubierto.", playerid, Name(playerid));
        }
        else
        {
                // Desactivar modo encubierto
                g_FBIEncubierto[playerid] = false;
                PlayerInfo[playerid][pEncubierto] = false;  // P1-FBI-2: persistir

                // Restaurar skin original
                if(g_FBISkinOriginal[playerid] > 0)
                        SetPlayerSkin(playerid, g_FBISkinOriginal[playerid]);

                // Color vuelve a azul FBI
                SetPlayerColor(playerid, 0x0012FFFF);

                SuccesMsg(playerid, "Modo encubierto DESACTIVADO. Tu identidad FBI es visible.");
                printf("[P1-FBI-2] FBI ID %d (%s) salio del modo encubierto.", playerid, Name(playerid));
        }
        return 1;
}

// Alias: /desencubrir fuerza la salida del modo encubierto
CMD:desencubrir(playerid)
{
        if(!IsPoliciaInvestigador(playerid))
                return ErrorMsg(playerid, "Comando exclusivo del FBI.");

        if(g_FBIEncubierto[playerid] == false)
                return ErrorMsg(playerid, "No estas en modo encubierto.");

        // Forzar desactivacion (misma logica que /encubrir toggle off)
        g_FBIEncubierto[playerid] = false;
        PlayerInfo[playerid][pEncubierto] = false;  // P1-FBI-2: persistir

        // Restaurar skin original
        if(g_FBISkinOriginal[playerid] > 0)
                SetPlayerSkin(playerid, g_FBISkinOriginal[playerid]);

        // Color vuelve a azul FBI
        SetPlayerColor(playerid, 0x0012FFFF);

        SuccesMsg(playerid, "Modo encubierto DESACTIVADO. Tu identidad FBI es visible.");
        printf("[P1-FBI-2] FBI ID %d (%s) salio del modo encubierto (via /desencubrir).", playerid, Name(playerid));
        return 1;
}

// =====================================================================
// P1-FBI-3: Comando exclusivo FBI - /antecedentes [ID]
// Muestra el historial delictivo del jugador: multas acumuladas, jail time
// cumplido, jail time pendiente, veces que ha sido arrestado.
// Solo IsPoliciaInvestigador (FBI) puede usarlo.
// =====================================================================
CMD:antecedentes(playerid, params[])
{
        if(!IsPoliciaInvestigador(playerid))
                return ErrorMsg(playerid, "Comando exclusivo del FBI.");

        if(Patrulha[playerid] == false && g_FBIEncubierto[playerid] == false)
                return ErrorMsg(playerid, "Debes estar en servicio o en modo encubierto.");

        new targetID;
        if(sscanf(params, "i", targetID))
                return ErrorMsg(playerid, "USE: /antecedentes [ID del jugador]");

        new id = -1;
        foreach(new i : Player)
        {
                if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
                {
                        id = i;
                        break;
                }
        }
        if(id == -1)
                return ErrorMsg(playerid, "Jugador no encontrado.");

        if(!IsPerto(playerid, id))
                return ErrorMsg(playerid, "No estas cerca del jugador.");

        new str[512], line[128];
        format(str, sizeof(str), "{FFFF00}=== ANTECEDENTES PENALES ===\n\n");
        format(line, sizeof(line), "{FFFFFF}Nombre: {FFFF00}%s {FFFFFF}(ID: %04d)\n", Name(id), PlayerInfo[id][IDF]);
        strcat(str, line);
        format(line, sizeof(line), "{FFFFFF}Organizacion: {FFFF00}%s\n\n", NomeOrg(id));
        strcat(str, line);

        format(line, sizeof(line), "{FF6347}[ Multas ]\n{FFFFFF}Multa acumulada: {FFFF00}$%d\n\n", PlayerInfo[id][pMultas]);
        strcat(str, line);

        format(line, sizeof(line), "{FF6347}[ Prison ]\n{FFFFFF}Tiempo pendiente: {FFFF00}%d segundos (%d min)\n", PlayerInfo[id][pjail], PlayerInfo[id][pjail] / 60);
        strcat(str, line);
        if(PlayerInfo[id][pjail] > 0)
        {
                strcat(str, "{FF0000}Estado actual: ENCARCELADO\n\n");
        }
        else
        {
                strcat(str, "{00FF00}Estado actual: LIBRE\n\n");
        }

        format(line, sizeof(line), "{FF6347}[ Otros ]\n{FFFFFF}Avisos: {FFFF00}%d\n", PlayerInfo[id][pAvisos]);
        strcat(str, line);
        format(line, sizeof(line), "{FFFFFF}Veces que ha muerto: {FFFF00}%d\n", VezesMorreu[id]);
        strcat(str, line);

        ShowPlayerDialog(playerid, 9995, DIALOG_STYLE_MSGBOX, "Antecedentes - FBI", str, "Cerrar", #);
        return 1;
}

CMD:revistar(playerid, params[])
{
        new str[64];
        if(IsPolicial(playerid) || IsBandido(playerid))
        {
                if(sscanf(params, "d", ID))                        return ErrorMsg(playerid,"USE: /verinv [ID]");
                foreach(new i : Player)
                {
                        if(pLogado[i] == true)
                        {
                                if(PlayerInfo[i][IDF] == ID)
                                {
                                        if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca del jugador.");
                                        if(InventarioAberto[playerid])
                                        {
                                                for(new in = 0; in < 40; ++in)
                                                {
                                                        PlayerTextDrawHide(playerid, DrawInv[playerid][in]);
                                                        if(i == 40)break;
                                                }
                                                InventarioAberto[playerid] = 0;
                                                CancelSelectTextDraw(playerid);
                                                return 1;
                                        }
                                        else
                                        {
                                                format(str, sizeof(str), "%s", Name(i));
                                                PlayerTextDrawSetString(playerid, DrawInv[playerid][34], str);
                                                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], "");
                                                for(new in = 1; in < 33; ++in)
                                                {
                                                        PlayerTextDrawSetPreviewModel(playerid, DrawInv[playerid][in], PlayerInventario[i][in][Slot]);
                                                        if(PlayerInventario[i][in][Slot] == -1)
                                                        {
                                                                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][in], 0.000000, 0.000000, 0.000000, 999);
                                                        }
                                                        else
                                                        {
                                                                PlayerTextDrawSetPreviewRot(playerid, DrawInv[playerid][in], 0.000000, 0.000000, 0.000000, 1);
                                                        }
                                                        if(i == 32)break; // FIX AUDIT INV I0-6: era 31, slot 32 inalcanzable
                                                }
                                                for(new in = 0; in < 40; ++in)
                                                {
                                                        PlayerTextDrawShow(playerid, DrawInv[playerid][in]);
                                                        if(i == 40)break;
                                                }
                                                SelectTextDraw(playerid, 0xC4C4C4AA);
                                                InventarioAberto[playerid] = 1;
                                        }
                                }
                        }
                }

        }
        return 1;
}

CMD:rarmas(playerid, params[])
{
        if(!IsPolicial(playerid))               return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "d", ID))                                                                     return ErrorMsg(playerid,"USE: /rarmas [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No esta cerca del jugador.");
                                ResetPlayerWeapons(i);
                                // FIX AUDIT4 PERS-CRIT-05: persistir el reseteo de armas
                                // inmediatamente. Sin esto, si el servidor crashea antes
                                // del proximo SalvarArmas (disconnect), el jugador recupera
                                // las armas confiscadas desde PASTA_SAVEARMAS = DUPE.
                                SalvarArmas(i);
                                //
                                format(Str, sizeof(Str), "Desarmou: %04d", PlayerInfo[i][IDF]);
                                SuccesMsg(playerid, Str);
                                //
                                format(Str, 106, "Fue desarmado por %04d", PlayerInfo[playerid][IDF]);
                                InfoMsg(i, Str);
                        }
                }
        }

        return 1;
}

CMD:criminal(playerid)
{
        new str[1500], line[100], count = 0;
        if(!IsPolicial(playerid))               return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        strcat(str, "{FFFF00}=== Criminales Buscados ===\n\n");
        foreach(new i : Player)
        {
                if(GetPlayerWantedLevel(i) && IsPlayerConnected(i))
                {
                        format(line, sizeof(line), "{FFFF00}%04d{FFFFFF} - Nivel: {FF0000}%d{FFFFFF}\n", PlayerInfo[i][IDF], GetPlayerWantedLevel(i));
                        strcat(str, line);
                        count++;
                }
        }
        if(count == 0)
                strcat(str, "{AAAAAA}No hay criminales buscados online.\n");
        else
        {
            new foot[64];
            format(foot, sizeof(foot), "\n{AAAAAA}Total: %d criminal(es) online.", count);
            strcat(str, foot);
        }
        ShowPlayerDialog(playerid, DIALOG_PROCURADOS, DIALOG_STYLE_LIST, "Lista de criminales", str, "Cerrar", "");
        return 1;
}

CMD:multar(playerid, params[])
{
        if(!IsPolicial(playerid))               return ErrorMsg(playerid, "No tienes permisos.");
        if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No estas en servicio");
        if(sscanf(params, "dd", ID, Numero))            return ErrorMsg(playerid,"USO: /multar [ID] [CANTIDAD]");
        // P1-PN-2: validacion de monto de multa (1 - 50,000).
        // Antes no habia tope, permitiendo multas de 999,999,999.
        if(Numero < 1)            return ErrorMsg(playerid, "El monto de la multa debe ser mayor a 0.");
        if(Numero > 50000)        return ErrorMsg(playerid, "El monto maximo de multa es $50,000.");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca de el jugador.");
                                //
                                PlayerInfo[i][pMultas] += Numero;
                                // P1-PN-3: persistir multa inmediatamente en disco.
                                // Antes solo se guardaba al payday o disconnect, perdiendose si el jugador
                                // se desconectaba antes. Ahora se guarda tras cada multa.
                                SalvarDados(i);
                                // P3-1: animacion de escritura de multa (POLICE/CopTaze_Cop + ON_LOOKERS/walk_loop)
                                ApplyAnimation(playerid, "POLICE", "CopTaze_Cop", 4.1, 0, 1, 1, 0, 0, 1);
                                format(Str, sizeof(Str), "Diste a %04d, %d de multa.", PlayerInfo[i][IDF], Numero);
                                SuccesMsg(playerid, Str);
                                //
                                format(Str, sizeof(Str), "El Policial %04d te puso %d de multa.", PlayerInfo[playerid][IDF], Numero);
                                InfoMsg(i, Str);
                        }
                }
        }

        return 1;
}

CMD:verdocumentos(playerid, params[])
{
        if(IsPolicial(playerid) || IsBandido(playerid))
        {
                if(Patrulha[playerid] == false)                                 return ErrorMsg(playerid, "No esta en servicio");
                if(sscanf(params, "i", ID))             return ErrorMsg(playerid,"USE: /verdocumentos [ID] ");
                foreach(new i : Player)
                {
                        if(pLogado[i] == true)
                        {
                                if(PlayerInfo[i][IDF] == ID)
                                {
                                        if(!IsPerto(playerid,i))return ErrorMsg(playerid, "No estas cerca del jugador.");
                                        //
                                        new megastrings[500], String2[500];
                                        format(String2,sizeof(String2), "{FFFFFF}Su Vip: {FFFF00}%s\n{FFFFFF}Nombre: {FFFF00}%s{FFFFFF}({FFFF00}%04d{FFFFFF})\n{FFFFFF}Email: {FFFF00}%s\n{FFFFFF}Dispositivo: {FFFF00}%s\n", VIP(i),Name(i), GetPlayerIdfixo(i), PlayerInfo[i][pEmail],Dispositivo(i));
                                        strcat(megastrings, String2);
                                        format(String2,sizeof(String2), "{FFFFFF}T.Acumulado:{FFFF00} %s\n{FFFFFF}Coins:{FFFF00} %s\n{FFFFFF}Dinero:{FFFF00} %s\n", convertNumber(PlayerInfo[i][pSegundosJogados]), ConvertMoney(PlayerInfo[i][pCoins]), ConvertMoney(PlayerInfo[i][pDinheiro]));
                                        strcat(megastrings, String2);
                                        format(String2,sizeof(String2), "{FFFFFF}Banco:{FFFF00} %s\n{FFFFFF}Avisos:{FFFF00} %s\n{FFFFFF}Trabajo:{FFFF00} %s\n{FFFFFF}Org:{FFFF00} %s\n", ConvertMoney(PlayerInfo[i][pBanco]), ConvertMoney(PlayerInfo[i][pAvisos]),Profs(i),NomeOrg(i));
                                        strcat(megastrings, String2);
                                        format(String2,sizeof(String2), "{FFFFFF}Multas:{FFFF00} %s\n{FFFFFF}Casa ID:{FFFF00} %d\n{FFFFFF}CNH: {FFFF00}%s", ConvertMoney(PlayerInfo[i][pMultas]), PlayerInfo[i][Casa], temlicenca(i));
                                        strcat(megastrings, String2);
                                        ShowPlayerDialog(playerid, DIALOG_CMDRG,DIALOG_STYLE_MSGBOX,"Su Documento",megastrings,"X",#);
                                }
                        }
                }

        }
        return 1;
}

CMD:qplantacao(playerid)
{
        if(!IsPolicial(playerid))               return ErrorMsg(playerid, "No tienes permisos.");{
                new perto = 0;
                for(new mac = 0; mac < MAX_MACONHA; mac++)
                {
                        if(MaconhaInfo[mac][PodeUsar] == false && IsPlayerInRangeOfPoint(playerid, 2, MaconhaInfo[mac][mX],MaconhaInfo[mac][mY],MaconhaInfo[mac][mZ]))
                        {
                                perto = 1;
                                ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",2.0,1,0,0,0,60000,1);
                                SetTimerEx("AnimatioN", 100, false, "i", playerid);
                                SetTimerEx("MaconhaQueimar", 17000, false, "id", playerid, mac);
                                PlantandoMaconha[playerid] = true;
                                SuccesMsg(playerid, "Esperar....");
                                return true;
                        }
                }
                if(perto == 0)return ErrorMsg(playerid, "No estas cerca de ninguna plantacion de marihuana.");
        }
        return true;
}

CMD:cmaconha(playerid)
{
        if(PlantandoMaconha[playerid] == true)
                return ErrorMsg(playerid, "Ya tienes una semilla que estas plantando o cosechando.");

        new perto = 0;

        for(new mac = 0; mac < MAX_MACONHA; mac++)
        {
                if(MaconhaInfo[mac][PodeUsar] == false && IsPlayerInRangeOfPoint(playerid, 2, MaconhaInfo[mac][mX],MaconhaInfo[mac][mY],MaconhaInfo[mac][mZ]))
                {
                        perto = 1;
                        if(strcmp(MaconhaInfo[mac][Dono], Name(playerid), true) == 0)
                        {
                                ApplyAnimation(playerid,"BOMBER","BOM_Plant_Loop",2.0,1,0,0,0,1);
                                SetTimerEx("AnimatioN", 100, false, "i", playerid);
                                SetTimerEx("MaconhaColher", 17000, false, "id", playerid, mac);
                                PlantandoMaconha[playerid] = true;
                                SuccesMsg(playerid, "Estas cosechando esta plantacion de marihuana, espera...");
                                return true;
                        }
                        else return ErrorMsg(playerid, "[!] Ups, parece que no eres dueno de esta plantacion");
                }
        }
        if(perto == 0)return ErrorMsg(playerid, "No estas cerca de ninguna plantacion.");
        return true;
}

CMD:maconhas(playerid)
{
        if(CountPlantacao(playerid) < 1)
                return ErrorMsg(playerid, "No has plantado ninguna marihuana.");

        new localmac = 0;
        new MegaString[500];
        new string[500];
        for(new maconhaid=0;maconhaid < MAX_MACONHA; maconhaid++)
        {
                if(MaconhaInfo[maconhaid][PodeUsar] == false && strcmp(MaconhaInfo[maconhaid][Dono], Name(playerid), true)==0)
                {
                        localmac++;
                        LocalizeMaconha[localmac][playerid] = maconhaid;

                        if(MaconhaInfo[maconhaid][Crescida] >= Max_Crescida)
                        {
                                format(string, sizeof string, "Plantacion %d: {00BC00}(Lista) Gramos: [%d]\n",maconhaid+1,MaconhaInfo[maconhaid][GramasProntas]);
                                strcat(MegaString,string);
                        }
                        else
                        {
                                format(string, sizeof string, "Plantacion %d: {00BC00}Creciendo:[%d/%d] Gramos:[%d]\n",maconhaid+1, MaconhaInfo[maconhaid][Crescida], Max_Crescida, MaconhaInfo[maconhaid][GramasProntas]);
                                strcat(MegaString,string);
                        }
                }
        }

        ShowPlayerDialog(playerid, DIALOG_LMARIHUANA, DIALOG_STYLE_LIST, "Menu Marihuana", MegaString, "Localizar", "X");
        return true;
}

// COMANDO /reanimar ELIMINADO - era comando admin con dialog vacio (bug critico).
// Reemplazado por:
//   - /revivirstaff [IDF] (admin revive oficial, ver arriba)
//   - /reanimar [id] (nuevo comando de paramedicos a pie, ver mas abajo)

// =====================================================================
// FIX AUDIT MEDICO A4-REHAB-CRIT-01: Comando /192 para pedir ambulancia.
// ANTES: el dialog D_CHAMARMEDICO (L30752) estaba declarado y tenia handler,
// PERO NINGUN comando lo invocaba. 6 mensajes en la GM decian "llama al /192"
// pero el comando no existia. Jugadores heridos quedaban soft-locked sin forma
// activa de pedir ayuda (solo esperar 5 min de auto-revive).
// AHORA: comando /192 abre el dialog D_CHAMARMEDICO para que el jugador
// escriba su mensaje de emergencia y se notifique a todos los Paramedicos
// (Org 10) conectados.
// =====================================================================
CMD:192(playerid, params[])
{
        #pragma unused params
        // Cooldown 120s anti-spam (variable ChamouPolicia ya existe en L312).
        // El handler D_CHAMARMEDICO valida ChamouPolicia[playerid] <= 0 antes de procesar.
        if(ChamouPolicia[playerid] > 0)
        {
                new msg[100];
                format(msg, sizeof(msg), "Debes esperar %d segundos para volver a llamar a una ambulancia.", ChamouPolicia[playerid]);
                return ErrorMsg(playerid, msg);
        }
        ShowPlayerDialog(playerid, D_CHAMARMEDICO, DIALOG_STYLE_INPUT,
                "{6C28BE}Llamar Ambulancia (192)",
                "{FFFFFF}Describe tu emergencia para los paramedicos disponibles:\n{AAAAAA}(Minimo 2, maximo 60 caracteres)",
                "Enviar", "Cancelar");
        return 1;
}

// ========== COMANDOS ADMIN/DUEÃ¯Â¿Â½O: CURAR, CHALECO, REVIVIR A SI MISMO Y STAFF ==========

CMD:curarme(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        // FIX AUDIT AGENT3 SP-08: sin cooldown, un admin deshonesto podia usar
        // /curarme en bucle durante un combate = invulnerabilidad. Cooldown 60s.
        new now = gettime();
        // FIX AUDIT2 AGENT4 S-07: cooldown unificado CD_selfheal compartido con
        // /chalecome y /revivirme. Antes cada comando tenia su propio PVar, lo que
        // permitia a un admin deshonesto rotar: /curarme -> /chalecome -> /revivirme
        // = invulnerabilidad efectiva cada ~20s en vez de 60s.
        if(now - GetPVarInt(playerid, "CD_selfheal") < 60)
                return ErrorMsg(playerid, "Espera 60s para usar comandos de auto-cura de nuevo.");
        SetPVarInt(playerid, "CD_selfheal", now);
        SetPlayerHealth(playerid, 100.0);
        SuccesMsg(playerid, "Te diste vida completa.");
        return 1;
}

CMD:chalecome(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        // FIX AUDIT AGENT3 SP-08: cooldown 60s para evitar abuso en combate.
        new now = gettime();
        // FIX AUDIT2 AGENT4 S-07: cooldown unificado CD_selfheal (compartido con
        // /curarme y /revivirme).
        if(now - GetPVarInt(playerid, "CD_selfheal") < 60)
                return ErrorMsg(playerid, "Espera 60s para usar comandos de auto-cura de nuevo.");
        SetPVarInt(playerid, "CD_selfheal", now);
        // FIX VERIFY-DANODMG-3 CRIT-DMG-2: setear g_ChalecoPermitido/Activo antes de
        // SetPlayerArmour, para que el Anti-Cheat no detecte "armour sin permiso" y
        // kickee al admin tras 3 usos.
        SetChalecoState(playerid, CHALECO_FULL, true);
        SuccesMsg(playerid, "Te pusiste chaleco completo.");
        return 1;
}

CMD:revivirme(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        // FIX AUDIT AGENT3 SP-08: cooldown 60s para evitar abuso (revivirme spawnea
        // 2 timers SetTimerEx + cura + chaleco + teleport, spamearlo satura el pool).
        new now = gettime();
        // FIX AUDIT2 AGENT4 S-07: cooldown unificado CD_selfheal (compartido con
        // /curarme y /chalecome).
        if(now - GetPVarInt(playerid, "CD_selfheal") < 60)
                return ErrorMsg(playerid, "Espera 60s para usar comandos de auto-cura de nuevo.");
        SetPVarInt(playerid, "CD_selfheal", now);
        // P0-REVIVIRME-FIX: guardar posicion actual antes de respawnear.
        // Antes: SpawnPlayer usaba SetSpawnInfo de OnPlayerDeath que guardaba
        // la posicion de muerte o del login, teletransportando al jugador.
        // Ahora: guardamos la posicion actual y la usamos en SetSpawnInfo.
        new Float:curX, Float:curY, Float:curZ, Float:curA;
        GetPlayerPos(playerid, curX, curY, curZ);
        GetPlayerFacingAngle(playerid, curA);
        new curInt = GetPlayerInterior(playerid);
        new curVW = GetPlayerVirtualWorld(playerid);
        MinutosMorte[playerid] = 0;
        SegundosMorte[playerid] = 0;
        XMorte[playerid] = -1; YMorte[playerid] = -1; ZMorte[playerid] = -1;
        if(SangueObjeto[playerid] > -1)
        {
            DestroyObject(SangueObjeto[playerid]);
            SangueObjeto[playerid] = -1;
        }
        for(new t = 0; t < 7; t++)
            PlayerTextDrawHide(playerid, TelaMorteCDA[playerid][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[playerid] = false;        // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (/revivirme admin).
        for(new _t = 0; _t < 5; _t++)
            TextDrawHideForPlayer(playerid, LogoBZ[_t]);
        SetPlayerHealth(playerid, 100.0);
        // FIX VERIFY-DANODMG-3 CRIT-DMG-2: setear flags de chaleco antes de SetPlayerArmour
        SetChalecoState(playerid, CHALECO_FULL, true);
        TogglePlayerControllable(playerid, 1);
        // SetSpawnInfo con la posicion actual para que SpawnPlayer lo deje en el mismo lugar
        // FIX AUDIT SPAWN S3-7: usar -1 en weapons/slots para que SpawnPlayer no asigne
        // armas por defecto. Antes: 0, 0, 0, 0, 0, 0 seteaba weapon=0 (puÃ¯Â¿Â½os) en cada
        // slot, lo cual era redundante y podia causar glitches visuales de armas.
        // -1 (INVALID_WEAPON_ID) es el valor correcto para "no asignar nada".
        SetSpawnInfo(playerid, -1, GetPlayerSkin(playerid), curX, curY, curZ, curA, -1, -1, -1, -1, -1, -1);
        SetTimerEx("SpawnP", 500, false, "i", playerid);
        // Restaurar interior y virtual world despues del spawn
        SetTimerEx("RestaurarPosRevivir", 600, false, "iii", playerid, curInt, curVW);
        SuccesMsg(playerid, "Te reanimaste en tu posicion actual.");
        return 1;
}

// Callback: restaura el interior y virtual world despues de revivir
forward RestaurarPosRevivir(playerid, interior, vw);
public RestaurarPosRevivir(playerid, interior, vw)
{
        SetPlayerInterior(playerid, interior);
        SetPlayerVirtualWorld(playerid, vw);
        TogglePlayerControllable(playerid, 1);
        return 1;
}

// =====================================================================
// SISTEMA ADMIN - /curarstaff [ID] (Slot ID, el que se ve en TAB)
// =====================================================================
CMD:curarstaff(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff"); // FIX AUDIT4 ADM3-05
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /curarstaff [ID]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(PlayerInfo[id][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel.");
        // FIX AUDIT CHAL CHAL-A2-02 (CRITICO): agregar cooldown 60s + log a /curarstaff.
        // ANTES: /curarstaff no tenia cooldown ni log. Admin podia curar+chaleco
        // infinito a amigos sin rastro. Ahora: mismo cooldown CD_selfheal 60s + log.
        new nowCS = gettime();
        if(nowCS - GetPVarInt(playerid, "CD_selfheal") < 60)
        {
                new faltaCS = 60 - (nowCS - GetPVarInt(playerid, "CD_selfheal"));
                new cdMsgCS[100];
                format(cdMsgCS, sizeof(cdMsgCS), "Espera %d segundos para usar comandos staff de nuevo.", faltaCS);
                return ErrorMsg(playerid, cdMsgCS);
        }
        SetPVarInt(playerid, "CD_selfheal", nowCS);

        SetPlayerHealth(id, 100.0);
        new msg[64]; format(msg, sizeof(msg), "El admin %s te dio vida completa.", PlayerName(playerid));
        SuccesMsg(id, msg);
        SuccesMsg(playerid, "Vida dada al jugador.");
        // FIX AUDIT CHAL: log obligatorio.
        new logCurarStaff[256];
        format(logCurarStaff, sizeof(logCurarStaff), "[CURARSTAFF] Admin: %s (IDF %04d) -> Target: %s (ID %d) | HP: 100", Name(playerid), PlayerInfo[playerid][IDF], Name(id), id);
        Log("Logs/AdminAcciones.ini", logCurarStaff);
        return 1;
}

// =====================================================================
// SISTEMA ADMIN - /chalecostaff [ID] (Slot ID, el que se ve en TAB)
// =====================================================================
CMD:chalecostaff(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 7) return ErrorMsg(playerid, "No has iniciado el servicio staff"); // FIX AUDIT4 ADM3-05
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /chalecostaff [ID]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");
        if(PlayerInfo[id][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg(playerid, "No puedes usar este comando en un admin de igual o mayor nivel.");
        // FIX AUDIT CHAL CHAL-A2-02 (CRITICO): agregar cooldown 60s + log.
        // ANTES: /chalecostaff no tenia cooldown ni log. Admin podia dar chaleco
        // infinito a amigos sin rastro. Ahora: mismo cooldown CD_selfheal 60s + log.
        new now = gettime();
        if(now - GetPVarInt(playerid, "CD_selfheal") < 60)
        {
                new falta = 60 - (now - GetPVarInt(playerid, "CD_selfheal"));
                new cdMsg[100];
                format(cdMsg, sizeof(cdMsg), "Espera %d segundos para usar comandos staff de nuevo.", falta);
                return ErrorMsg(playerid, cdMsg);
        }
        SetPVarInt(playerid, "CD_selfheal", now);
        // FIX VERIFY-DANODMG-3 CRIT-DMG-2: setear g_ChalecoPermitido/Activo en el
        // target antes de SetPlayerArmour, para que el AC no lo kickee.
        SetChalecoState(id, CHALECO_FULL, true);
        new msg[64]; format(msg, sizeof(msg), "El admin %s te dio chaleco completo.", PlayerName(playerid));
        SuccesMsg(id, msg);
        SuccesMsg(playerid, "Chaleco dado al jugador.");
        // FIX AUDIT CHAL: log obligatorio.
        new logChalecoStaff[256];
        format(logChalecoStaff, sizeof(logChalecoStaff), "[CHALECOSTAFF] Admin: %s (IDF %04d) -> Target: %s (ID %d) | Chaleco: 100", Name(playerid), PlayerInfo[playerid][IDF], Name(id), id);
        Log("Logs/AdminAcciones.ini", logChalecoStaff);
        return 1;
}

// =====================================================================
// SISTEMA ADMIN - /revivirstaff [ID] (Slot ID, el que se ve en TAB)
// Comando unico de revive admin (reemplaza a /reanimar y /reviver anteriores).
// Jerarquia:
//   pAdmin >= 2 (Administrador): revive con HP 100, sin chaleco.
//   pAdmin >= 3 (Administrador Geral o superior): revive con HP 100 + chaleco 100.
// Reglas:
//   - Solo revive jugadores que esten efectivamente heridos
//     (MinutosMorte > 0 || SegundosMorte > 0).
//   - Funciona a cualquier distancia (es comando admin).
//   - Log obligatorio en Logs/AdminAcciones.ini.
// =====================================================================
CMD:revivirstaff(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 2) return ErrorMsg(playerid, "No tienes permisos. Necesitas Administrador o superior.");
        new id;
        if(sscanf(params, "d", id)) return ErrorMsg(playerid, "Uso: /revivirstaff [ID]");
        if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Jugador no conectado.");

        // Validar que el target este efectivamente herido
        if(MinutosMorte[id] <= 0 && SegundosMorte[id] <= 0)
            return ErrorMsg(playerid, "Ese jugador no esta herido. No es necesario revivirlo.");

        // Cleanup completo del estado de muerte
        MinutosMorte[id] = 0;
        SegundosMorte[id] = 0;
        // FIX BUG #1: resetear XMorte/YMorte/ZMorte a -1 antes de SpawnPlayer.
        // Sin esto, OnPlayerSpawn detecta al jugador cerca de XMorte (porque quedo
        // congelado en su sitio de muerte) y lo vuelve a marcar como herido.
        XMorte[id] = -1; YMorte[id] = -1; ZMorte[id] = -1;
        TriagePrio[id] = 0; // CAMBIO 2026-07-20: reset triaje
        TriageMedico[id] = -1;
        if(SangueObjeto[id] > -1)
        {
            DestroyObject(SangueObjeto[id]);
            SangueObjeto[id] = -1;
        }
        for(new t = 0; t < 7; t++)
            PlayerTextDrawHide(id, TelaMorteCDA[id][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[id] = false;        // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (/revivirstaff admin).
        for(new _t = 0; _t < 5; _t++)
            TextDrawHideForPlayer(id, LogoBZ[_t]);

        // Restaurar HP siempre
        SetPlayerHealth(id, 100.0);

        // Chaleco solo a partir de Administrador Geral (pAdmin >= 3)
        if(PlayerInfo[playerid][pAdmin] >= 3)
        {
            // FIX VERIFY-DANODMG-3 CRIT-DMG-2: setear flags de chaleco en target
            SetChalecoState(id, CHALECO_FULL, true);
        }

        // Descongelar y re-spawn limpio
        // FIX AUDIT ANIM ANIM-A2-06 (CRITICO): no descongelar algemado.
        if(!PlayerInfo[id][pCongelado])
            TogglePlayerControllable(id, 1);
        SetTimerEx("SpawnP", 500, false, "i", id);

        // Notificar al target y al admin
        new msg[128];
        if(PlayerInfo[playerid][pAdmin] >= 3)
        {
            format(msg, sizeof(msg), "El admin %s te reanimÃ¯Â¿Â½ con vida y chaleco completos.", PlayerName(playerid));
            SuccesMsg(id, msg);
            SuccesMsg(playerid, "Jugador reanimado (HP + Chaleco).");
        }
        else
        {
            format(msg, sizeof(msg), "El admin %s te reanimÃ¯Â¿Â½ con vida completa.", PlayerName(playerid));
            SuccesMsg(id, msg);
            SuccesMsg(playerid, "Jugador reanimado (solo HP).");
        }

        // Log de uso admin
        new logMsg[200];
        format(logMsg, sizeof(logMsg), "[REVIVE] Admin %s (IDF %d, nivel %d) revivio a %s (IDF %d). Chaleco: %s.",
            PlayerName(playerid), PlayerInfo[playerid][IDF], PlayerInfo[playerid][pAdmin],
            PlayerName(id), PlayerInfo[id][IDF],
            (PlayerInfo[playerid][pAdmin] >= 3) ? ("Si") : ("No"));
        Log("Logs/AdminAcciones.ini", logMsg);

        return 1;
}

CMD:crearkey(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 7)            return ErrorMsg(playerid, "No tienes permisos.");
        // FIX ALTO-COINS-007: validar pLogado antes de operar.
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        // FIX CRIT-COINS-001 (CRITICO): usar variable local en vez de array global vl[MAX_PLAYERS].
        // ANTES: sscanf(params, "d", vl) donde vl es array. sscanf escribe en vl[0], pero el codigo
        // leia vl[playerid] que era 0 para cualquier admin != slot 0. Sistema de cupones roto.
        // FIX ALTO-COINS-001: validar rango de valor [1, COINS_MAX_KEY_VALUE] (no negativos, no overflow).
        new valor;
        if(sscanf(params, "d", valor)) return ErrorMsg(playerid, "Use: /crearkey [Valor] (1-100000)");
        if(valor < 1 || valor > COINS_MAX_KEY_VALUE) return ErrorMsg(playerid, "Valor invalido (1-100000).");
        // FIX ALTO-COINS-002: log de creacion de key (antes no habia auditoria).
        new Cod = randomEx(0, COINS_MAX_KEY_CODE);
        format(File, sizeof(File), PASTA_KEYS, Cod);
        // FIX: verificar si el codigo ya existe (colision randomEx)
        if(DOF2_FileExists(File)) return ErrorMsg(playerid, "Colision de codigo. Intenta de nuevo.");
        DOF2_CreateFile(File);
        DOF2_SetInt(File, "Valor", valor);
        DOF2_SaveFile();
        new str[180];
        format(str, sizeof(str), "El cupon %d fue creado con %i de coins.", Cod, valor);
        SuccesMsg(playerid, str);
        new _logKey[160];
        format(_logKey, sizeof(_logKey), "[CREARKEY] Admin: %s (ID:%d) creo cupon %d con %d coins", Name(playerid), PlayerInfo[playerid][IDF], Cod, valor);
        Log("Logs/AdminAcciones.ini", _logKey);
        return 1;
}

CMD:activarkey(playerid, params[])
{
        new File[255];
        new Cod;
        // FIX ALTO-COINS-007: validar pLogado.
        if(!pLogado[playerid]) return ErrorMsg(playerid, "No estas logado.");
        if(sscanf(params, "d", Cod)) return ErrorMsg(playerid,  "Use: /activarkey [Codigo]");
        // FIX: validar codigo positivo
        if(Cod < 0) return ErrorMsg(playerid, "Codigo invalido.");
        // FIX ALTO-COINS-002: cooldown anti-spam de 3s entre activaciones.
        if(gettime() - GetPVarInt(playerid, "CD_ActivarKey") < COINS_COOLDOWN_ACTIVARKEY_SEC)
                return ErrorMsg(playerid, "Espera unos segundos antes de activar otro codigo.");
        SetPVarInt(playerid, "CD_ActivarKey", gettime());
        {
                format(File, sizeof(File), PASTA_KEYS, Cod);
                if(DOF2_FileExists(File))
                {
                        // FIX ALTO-COINS-003: clamp Valor del archivo [0, COINS_MAX_KEY_VALUE] (anti-tampering).
                        new _keyValor = DOF2_GetInt(File, "Valor");
                        if(_keyValor < 0) _keyValor = 0;
                        if(_keyValor > COINS_MAX_KEY_VALUE)
                        {
                                printf("[COINS TAMPER] Jugador %d (%s) activo key %d con Valor=%d, clampeado a %d", playerid, Name(playerid), Cod, _keyValor, COINS_MAX_KEY_VALUE);
                                _keyValor = COINS_MAX_KEY_VALUE;
                        }
                        PlayerInfo[playerid][pCoins] += _keyValor;
                        // FIX CRIT-COINS-003 (CRITICO): persistir pCoins inmediatamente tras activar key.
                        // ANTES: no llamaba SalvarDados. Si servidor crashea antes del SaveTimer (~7 min),
                        // el jugador perdia las coins PERO el cupon ya fue eliminado. Doble perdida.
                        SalvarDados(playerid);
                        SuccesMsg(playerid, "Codigo utilizado!");
                        DOF2_RemoveFile(File);
                        // FIX ALTO-COINS-002: log de activacion de key.
                        new _logAct[160];
                        format(_logAct, sizeof(_logAct), "[ACTIVARKEY] %s (ID:%d) activo key %d por %d coins", Name(playerid), PlayerInfo[playerid][IDF], Cod, _keyValor);
                        Log("Logs/AdminAcciones.ini", _logAct);
                }
                else
                {
                        ErrorMsg(playerid, "Codigo no existe!");
                }
        }
        return 1;
}

CMD:ltumba(playerid)
{
        // FIX AUDIT CONSTRUCTOR CON-A1-02/A2-03/A3-01/A4-04/A5-01 (ALTO): faltaban llaves en el if(PlayerToPoint).
        // Antes: el if(PlayerToPoint) sin llaves solo controlaba el siguiente check (pProfissao).
        // Los demas checks (Cargase, modelo 442) y ShowPlayerDialog se ejecutaban SIEMPRE, sin importar
        // si el jugador estaba en el pickup. Esto permitia invocar /ltumba desde cualquier ubicacion.
        // Ahora: todas las validaciones estan dentro del bloque if(PlayerToPoint).
        // FIX AUDIT CONSTRUCTOR CON-A3-02/A5-07 (ALTO): anadir validaciones pLogado/pCongelado/pjail.
        if(!pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "Estas algemado.");
        if(PlayerInfo[playerid][pjail] > 0) return ErrorMsg(playerid, "Estas en la carcel.");
        if(PlayerToPoint(3.0, playerid, 934.1115,-1103.3857,24.3118))
        {
                if(PlayerInfo[playerid][pProfissao] != 5)       return ErrorMsg(playerid, "No tienes permisos.");
                if(Cargase[playerid] == true)   return ErrorMsg(playerid, "Has localizado un hospital para recuperar la tumba.");
                if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 442)        return ErrorMsg(playerid, "No esta en vehiculo de trabajo.");
                ShowPlayerDialog(playerid, DIALOG_LTUMBA, DIALOG_STYLE_LIST, "Hospital.", "{FFFF00}- {FFFFFF}Los Santos\t{32CD32}$600\n{FFFF00}- {FFFFFF}Las Venturas\t{32CD32}$1200\n{FFFF00}- {FFFFFF}San Fierro\t{32CD32}$2000\n", "Localizar", "");
        }
        else
        {
                ErrorMsg(playerid, "No estas en el punto de localizacion de tumbas.");
        }
        return 1;
}

CMD:crearcasa(playerid, params[])
{
        new File[255];
        if(PlayerInfo[playerid][pAdmin] < 6)            return ErrorMsg(playerid, "No tienes permisos.");
        {
                new valor, interior;
                if(sscanf(params, "ii", valor, interior))
                {
                        return ErrorMsg(playerid,  "Use: /crearcasa [valor] [interior 1 - 10].");
                }
                else if(interior < 0 || interior > 10)
                {
                        return ErrorMsg(playerid, "Introdusca un interior correcto.");
                }
                else if(interior == 1) // Casa Level 1
                {
                        for(new i; i < MAX_CASAS; i++)
                        {
                                format(File, sizeof(File), PASTA_CASAS, i);
                                if(!DOF2_FileExists(File))
                                {
                                        new Float:X, Float:Y, Float:Z;
                                        GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
                                        DOF2_CreateFile(File);
                                        DOF2_SetString(File, "CasaDono", "ninguno");
                                        DOF2_SetString(File, "Casa Texto", "ninguno");
                                        DOF2_SetInt(File, "CasaId", i);
                                        DOF2_SetInt(File, "CasaAVenda", 1);
                                        DOF2_SetInt(File, "CasaPickup", 1273);
                                        DOF2_SetInt(File, "CasaMapIcon", 31);
                                        DOF2_SetInt(File, "CasaValor", valor);
                                        DOF2_SetInt(File, "CasaInterior", 1);

                                        DOF2_SetFloat(File, "CasaX", X);
                                        DOF2_SetFloat(File, "CasaY", Y);
                                        DOF2_SetFloat(File, "CasaZ", Z);

                                        DOF2_SetFloat(File, "CasaInteriorX", 224.288);
                                        DOF2_SetFloat(File, "CasaInteriorY", 1289.1907);
                                        DOF2_SetFloat(File, "CasaInteriorZ", 1082.1406);
                                        DOF2_SaveFile();

                                        CasaInfo[i][CasaId] = DOF2_GetInt(File, "CasaId");
                                        CasaInfo[i][CasaAVenda] = DOF2_GetInt(File, "CasaAVenda");
                                        CasaInfo[i][CasaPickup] = DOF2_GetInt(File, "CasaPickup");
                                        CasaInfo[i][CasaMapIcon] = DOF2_GetInt(File, "CasaMapIcon");
                                        CasaInfo[i][CasaValor] = DOF2_GetInt(File, "CasaValor");
                                        CasaInfo[i][CasaInterior] = DOF2_GetInt(File, "CasaInterior");

                                        CasaInfo[i][CasaX] = DOF2_GetFloat(File, "CasaX");
                                        CasaInfo[i][CasaY] = DOF2_GetFloat(File, "CasaY");
                                        CasaInfo[i][CasaZ] = DOF2_GetFloat(File, "CasaZ");

                                        CasaInfo[i][CasaInteriorX] = DOF2_GetFloat(File, "CasaInteriorX");
                                        CasaInfo[i][CasaInteriorY] = DOF2_GetFloat(File, "CasaInteriorY");
                                        CasaInfo[i][CasaInteriorZ] = DOF2_GetFloat(File, "CasaInteriorZ");

                                        format(CasaInfo[i][CasaDono], 30, "%s", DOF2_GetString(File, "CasaDono")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                                        format(CasaInfo[i][CasaTexto], 64, "%s", DOF2_GetString(File, "CasaTexto")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco

                                        PickupCasa[i] = CreateDynamicPickup(CasaInfo[i][CasaPickup], 23, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ]);
                                        MapIconCasa[i] = CreateDynamicMapIcon(CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], CasaInfo[i][CasaMapIcon], 0, -1, -1, -1, 100.0, MAPICON_LOCAL);
                                        new string[1500]; // FIX AUDIT3 MS-05: reducido de 5000 a 1500
                                        format(string, sizeof(string), "{FFFFFF}Propietario: {FFFF00}%s\n{FFFFFF}Numero: {FFFF00}%d\nValor: {FFFF00}%s\n{FFFFFF}Presiona '{FFFF00}Y{FFFFFF}' para entrar.", CasaInfo[i][CasaDono], CasaInfo[i][CasaId], ConvertMoney(CasaInfo[i][CasaValor]));
                                        TextoCasa[i] = CreateDynamic3DTextLabel(string, -1, CasaInfo[i][CasaX], CasaInfo[i][CasaY], CasaInfo[i][CasaZ], 15.0);
                                        return 1;
                                }
                        }
                }
                else if(interior == 2) // Casa Level 2
                {
                        for(new i; i < MAX_CASAS; i++)
                        {
                                format(File, sizeof(File), PASTA_CASAS, i);
                                if(!DOF2_FileExists(File))
                                {
                                        new Float:X, Float:Y, Float:Z;
                                        GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
                                        DOF2_CreateFile(File);
                                        DOF2_SetString(File, "CasaDono", "ninguno");
                                        DOF2_SetString(File, "Casa Texto", "ninguno");
                                        DOF2_SetInt(File, "CasaId", i);
                                        DOF2_SetInt(File, "CasaAVenda", 1);
                                        DOF2_SetInt(File, "CasaPickup", 1273);
                                        DOF2_SetInt(File, "CasaMapIcon", 31);
                                        DOF2_SetInt(File, "CasaValor", valor);
                                        DOF2_SetInt(File, "CasaInterior", 2);

                                        DOF2_SetFloat(File, "CasaX", X);
                                        DOF2_SetFloat(File, "CasaY", Y);
                                        DOF2_SetFloat(File, "CasaZ", Z);

                                        DOF2_SetFloat(File, "CasaInteriorX", 225.5707);
                                        DOF2_SetFloat(File, "CasaInteriorY", 1240.0643);
                                        DOF2_SetFloat(File, "CasaInteriorZ", 1082.1406);
                                        DOF2_SaveFile();

                                        CasaInfo[i][CasaId] = DOF2_GetInt(File, "CasaId");
                                        CasaInfo[i][CasaAVenda] = DOF2_GetInt(File, "CasaAVenda");
                                        CasaInfo[i][CasaPickup] = DOF2_GetInt(File, "CasaPickup");
                                        CasaInfo[i][CasaMapIcon] = DOF2_GetInt(File, "CasaMapIcon");
                                        CasaInfo[i][CasaValor] = DOF2_GetInt(File, "CasaValor");
                                        CasaInfo[i][CasaInterior] = DOF2_GetInt(File, "CasaInterior");

                                        CasaInfo[i][CasaX] = DOF2_GetFloat(File, "CasaX");
                                        CasaInfo[i][CasaY] = DOF2_GetFloat(File, "CasaY");
                                        CasaInfo[i][CasaZ] = DOF2_GetFloat(File, "CasaZ");

                                        CasaInfo[i][CasaInteriorX] = DOF2_GetFloat(File, "CasaInteriorX");
                                        CasaInfo[i][CasaInteriorY] = DOF2_GetFloat(File, "CasaInteriorY");
                                        CasaInfo[i][CasaInteriorZ] = DOF2_GetFloat(File, "CasaInteriorZ");

