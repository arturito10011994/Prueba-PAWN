                                                // Ya mitigado por helper en DIALOG_CONFIRMA_ESCOLA1 (CON-CRIT-002), pero defense-in-depth.
                                                if(CheckInventario2(playerid, 1853))
                                                {
                                                    ErrorMsg(playerid, "Ya tenias esa licencia. El examen no otorga duplicados.");
                                                    AC_AddPlayerMoney(playerid, 4000);
