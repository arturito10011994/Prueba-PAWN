forward AutoDesbugar();
public AutoDesbugar()
{
        // Desbug automatico cada 5 minutos para todos los jugadores conectados
        foreach(new p: Player)
        {
                if(pLogado[p] == true)
                {
                        // Solo desbloquear si el jugador esta congelado sin razon de trabajo activo
                        if(Casavehcorreios[p] == false && Casavehcorreios2[p] == false && checkcasa[p] == false && EntregaSdx[p] == false
                                && CajaMao[p] == false && PegandoCajas[p] == false && g_CorreosRutaActiva[p] == false
                                && EmpaquetadorActivo[p] == false)
                        {
                                if(UsouCMD[p] == false && !IsPlayerInAnyVehicle(p))
                                {
                                        TogglePlayerControllable(p, 1);
                                }
                        }
                }
        }
        return 1;
}

CMD:fixme(playerid, params[])
{
        // FIX SPRINT4 9.1: usar FlushPlayerJobs para cleanup consistente en TODOS los trabajos.
        // Antes: /fixme solo flusheaba Correos condicionalmente. Si el jugador estaba
        // atascado por estado de Empaquetador/Camionero/Minero/etc, /fixme no ayudaba.
        // RIESGO: FlushPlayerJobs destruye el camion/truck/van del jugador. Es destructivo.
        // SOLUCION: solo invocar FlushPlayerJobs si el jugador confirma con /fixme full.
        // El /fixme normal (sin "full") sigue siendo suave: solo descongela + Limpia anims.
        //
        // Nota: si el jugador esta algemado, NO permitir /fixme (exploit para escapar arresto).
        if(PlayerInfo[playerid][pCongelado] == true) return ErrorMsg(playerid, "Estas algemado, no puedes usar /fixme. Pide ayuda a un administrador.");

        // CASO 1: /fixme full - flush completo de TODOS los trabajos (destructivo pero definitivo)
        // Solo si el jugador pasa "full" como argumento. Ej: /fixme full
        // FIX SPRINT4 9.1 v2: uso strcmp directo sobre params[] para evitar dependencia
        // del especificador S[] de sscanf2 que varia entre versiones.
        if(!isnull(params) && !strcmp(params, "full", true))
        {
                FlushPlayerJobs(playerid);
                // FIX AUDIT LIC MEJORA-1 (ALTO): cleanup completo de autoescuela en /fixme full.
                // Si el jugador estaba stuck por examen de autoescuela, /fixme full ahora lo limpia.
                // FIX RV5-001: usar FlushPlayerEx (destructivo) en /fixme full para reset VW/Int/Checkpoints si estaba en examen.
                AutoEscola_FlushPlayerEx(playerid);
                TogglePlayerControllable(playerid, 1);
                ClearAnimations(playerid);
                SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                new Float:fx2, Float:fy2, Float:fz2;
                GetPlayerPos(playerid, fx2, fy2, fz2);
                SetPlayerPos(playerid, fx2, fy2, fz2 + 0.5);
                SuccesMsg(playerid, "Desbug FULL aplicado. Todo el estado de trabajos fue reiniciado. Perdiste cualquier ruta en curso (sin cobro).");
                return 1;
        }

        // CASO 2: /fixme (sin "full") - suave. Solo descongela + limpia anims + flush Correos
        // si esta atascado por estado de Correos.
        if(PlayerInfo[playerid][pProfissao] == 8 && (
                g_CorreosRutaActiva[playerid] || Casavehcorreios[playerid] || Casavehcorreios2[playerid] ||
                checkcasa[playerid] || CajaMao[playerid] || EntregaSdx[playerid] || PegandoCajas[playerid] ||
                GetPVarInt(playerid, "EntregaFinalCP") == 1 || GetPVarInt(playerid, "EntregaPagoPendiente") > 0))
        {
                Correos_FlushPlayer(playerid);
                SuccesMsg(playerid, "Estado de Correos reiniciado. Tu ruta fue cancelada (sin cobro). Vuelve a /cargar para iniciar otra.");
                return 1;
        }

        // Comando de desbug generico (para otros trabajos y situaciones)
        TogglePlayerControllable(playerid, 1);
        ClearAnimations(playerid);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
        // FIX AUDIT PESCADOR P-A2-04: matar timers Pesca pendientes en /fixme suave.
        // Antes: si un Pescador estaba atascado y hacia /fixme, el timer Pesca seguia
        // activo y disparaba 10s despues interrumpiendo al jugador.
        Pesca_KillTimers(playerid);
        // FIX AUDIT-AUDIT6-S-ALTO-004 (ALTO): cleanup autoescuela en /fixme suave.
        // ANTES: /fixme (sin full) NO llamaba AutoEscola_FlushPlayer. Solo /fixme full lo hacia.
        // Si el jugador estaba stuck por examen de autoescuela (timer zombie, flag en 1),
        // /fixme suave no lo solucionaba y el jugador tenia que pedir admin o esperar 40min.
        // Ahora: cleanup autoescuela en TODOS los paths de /fixme.
        // FIX RV5-001: /fixme suave usa FlushPlayer (sin Ex) para NO resetear VW/Int si el jugador
        // esta en interior custom (casa, hospital, etc). El guard _wasInExam no es necesario aqui
        // porque FlushPlayer NO resetea VW/Int.
        AutoEscola_FlushPlayer(playerid);
        // Limpiar estados de trabajo si no esta en ninguno activo
        if(Casavehcorreios[playerid] == false && Casavehcorreios2[playerid] == false)
        {
                if(CajaMao[playerid] == true) { RemovePlayerAttachedObject(playerid, 1); CajaMao[playerid] = false; }
        }
        if(UsouCMD[playerid] == true && Casavehcorreios[playerid] == false && checkcasa[playerid] == false)
        {
                UsouCMD[playerid] = false;
        }
        // Posicionar al jugador 0.5 unidades arriba para evitar quedarse dentro del suelo
        new Float:fx, Float:fy, Float:fz;
        GetPlayerPos(playerid, fx, fy, fz);
        SetPlayerPos(playerid, fx, fy, fz + 0.5);
        // FIX SPRINT4 9.1: si despues del desbug suave sigue atascado, sugerir /fixme full
        if(EmpaquetadorActivo[playerid] || Cargase[playerid] || CamionEnRuta[playerid]
           || EtapasMinerador[playerid] > 0 || Desossando[playerid] > 0
           || PegouLixo[playerid] || PegouMaterial[playerid] || Covaconcerto[playerid])
        {
                InfoMsg(playerid, "Si sigues atascado, usa /fixme full para reiniciar TODO tu estado de trabajo (perderas la ruta en curso).");
        }
        SuccesMsg(playerid, "Desbug aplicado. Si el problema persiste, usa /fixme full o /fixme nuevamente.");
        return 1;
}

CMD:jetpack(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos de staff.");
        // FIX VERIFY-DANODMG-5 CRIT-4: el Anti-Cheat en OnPlayerUpdate kickea a
        // cualquier jugador con SPECIAL_ACTION_USEJETPACK (salvo admins nivel 6+
        // que son inmunes al AC). Para que admins nivel 1-5 puedan usar /jetpack
        // sin ser kickeados, exigimos que esten en servicio staff (pJogando==false).
        // Un admin nivel 1-5 que NO este en servicio staff no puede usar /jetpack.
        if(pJogando[playerid] == true && PlayerInfo[playerid][pAdmin] < 6)
                return ErrorMsg(playerid, "Necesitas iniciar servicio staff con /duty para usar jetpack.");
        // FIX AUDIT AC-H20: setear PVar de exencion anti-airbreak para /jetpack.
        // Antes: un admin en duty con jetpack podia volar a Z>100 y el AC anti-airbreak
        // lo strikeaba (el check de admin duty exime el airbreak, pero solo si
        // pJogando=false, que ya es garantizado por el check de arriba). Sin embargo,
        // para defense-in-depth, seteamos PVar ACTPImmune para que el anti-teleport
        // tambien exima al admin con jetpack (volar rapidamente puede superar maxDist).
        SetPVarInt(playerid, "ACTPImmune", gettime());
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
        SuccesMsg(playerid, "Jetpack activado. Para quitarlo usa /fixme o baja al suelo.");
        return 1;
}

CMD:repararvip(playerid)
{
        if(PlayerInfo[playerid][pVIP] < 2)                                              return ErrorMsg(playerid, "No tienes permisos.");
        if(!IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "No estas en un vehiculo.");

    RepairVehicle(GetPlayerVehicleID(playerid));
        SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
        SuccesMsg(playerid, "Reparaste este vehiculo.");
        return 1;
}

CMD:pediravaliar(playerid, params[])
{
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        if(sscanf(params, "d", ID)) return ErrorMsg(playerid,"USE: /pediravaliar [ID]");
        foreach(new i : Player)
        {
                if(pLogado[i] == true)
                {
                        if(PlayerInfo[i][IDF] == ID)
                        {
                                ShowPlayerDialog(i, DIALOG_AVALIAR, DIALOG_STYLE_MSGBOX, "Avaliando o administrador", "Un staff pidio tu evaluacion por la atencion ofrecida.\nAhora la eleccion es tuya si deseas que sea recompensado en futuro\n\nDeseja dar um ponto de avaliacao para o staff?", "SI", "NO");

                        }
                }
        }

        return 1;
}

CMD:verpuntos(playerid)
{
        new string[255];
        if(PlayerInfo[playerid][pAdmin] < 1) return ErrorMsg(playerid, "No tienes permisos.");
        format(string, sizeof(string), "Tienes %d puntos", PlayerInfo[playerid][pEvaluacion]);
        SuccesMsg(playerid, string);
        return 1;
}
// Alias backward-compat: /verpontos sigue funcionando como /verpuntos.
CMD:verpontos(playerid) return cmd_verpuntos(playerid);

CMD:atendimento(playerid, params[])
{
        new assunto[255];
        if(sscanf(params, "s", assunto))        return ErrorMsg(playerid, "USE: /atendimento [Assunto]");
    new Dialog[300];
        format(stringZCMD, sizeof(stringZCMD), "{FFFFFF}Estas a punto de solicitar una atencion administrativa\n\nTu Nombre: {0099ff}%s\n{FFFFFF}Asunto de la Atencion: {0099ff}%s\n\n",Name(playerid), assunto);
        strcat(Dialog,stringZCMD);
        format(stringZCMD, sizeof(stringZCMD), "{FF6347}NOTA:{BFC0C2} Solicita atencion solo para asuntos serios, para dudas usa /report,\nde lo contrario seras debidamente sancionado por la administracion del servidor.");
        strcat(Dialog,stringZCMD);
        strmid(ArmazenarString[playerid], assunto, 0, strlen(params), sizeof(ArmazenarString[]));
        ShowPlayerDialog(playerid, 8726, DIALOG_STYLE_MSGBOX, "{0099ff}Solicitar Atencion", Dialog, "Continuar", "Cancelar");
        return 1;
}

CMD:fila(playerid, params[])
{
        if (PlayerInfo[playerid][pAdmin] < 1)
        {
                ErrorMsg(playerid,  "No tienes autorizacion para usar ese comando.");
                return true;
        }
        new lol = 0;
        MEGAString[0]=EOS;
        new prioridade[20];
        format(stringZCMD, sizeof(stringZCMD), "Jugador\tAsunto\tPrioridad\n");
        strcat(MEGAString, stringZCMD);
        while (lol < MAX_PLAYERS)
        {
                new arquivo[64];
                format(arquivo, sizeof(arquivo), Pasta_Relatorios,lol);
                if(DOF2_FileExists(arquivo))
                {
                        new NomeFila[MAX_PLAYER_NAME];
                        new AssuntoFila[64];
                        // FIX AUDIT6-FIX-PERF: cache DOF2_GetString (antes 3 llamadas por field + 2 dead calls)
                        new tmpName[MAX_PLAYER_NAME];
                        new tmpAssunto[64];
                        strcpy(tmpName, DOF2_GetString(arquivo, "Jogador"), sizeof(tmpName));
                        strcpy(tmpAssunto, DOF2_GetString(arquivo, "Assunto"), sizeof(tmpAssunto));
                        strmid(NomeFila, tmpName, 0, strlen(tmpName), sizeof(NomeFila));
                        strmid(AssuntoFila, tmpAssunto, 0, strlen(tmpAssunto), sizeof(AssuntoFila));
                        DOF2_CreateFile(arquivo);
                        if(DOF2_GetInt(arquivo, "Prioridade") == 2)
                        {
                                prioridade = "{FF0000}ALTA";
                        }
                        else if(DOF2_GetInt(arquivo, "Prioridade") == 1)
                        {
                                prioridade = "{FFFF00}BAIXA";
                        }
                        format(stringZCMD, sizeof(stringZCMD), "%s[%d]\t%s\t%s\n", NomeFila,lol, AssuntoFila, prioridade);
                        strcat(MEGAString, stringZCMD);
                }
                lol++;
        }
        ShowPlayerDialog(playerid, 5409, DIALOG_STYLE_TABLIST_HEADERS, "{FFFF00}Doble clic para atender", MEGAString, "Atender","Cancelar");
        return true;
}

CMD:desossar(playerid)
{
        if(PlayerInfo[playerid][pProfissao] != 3)       return ErrorMsg(playerid, "No tienes permisos.");
        if(!CheckInventario2(playerid, 18644)) return ErrorMsg(playerid, "No tienes una chaira.");
        if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "Estas algemado, no puedes deshuesar.");
        if(PlayerInfo[playerid][pjail] > 0) return ErrorMsg(playerid, "Estas en la carcel.");
        if(UsouCMD[playerid] == true)   return ErrorMsg(playerid, "Aun no terminaste el deshuesado actual.");
        if(Desossando[playerid] == 1 || Desossando[playerid] == 2 || Desossando[playerid] == 3)         return ErrorMsg(playerid, "Ya estas haciendo las etapas.");
        // FIX AUDIT10 A1-X1: ampliar check a estados 4-6 para evitar bypass (re-entrar orphanaba ObjetoAcougue[1]).
        if(Desossando[playerid] >= 4 && Desossando[playerid] <= 6) return ErrorMsg(playerid, "Ya estas haciendo las etapas.");
        new bool:enZonaDesossa = false;
        for(new i; i < 8; i++)
        {
                if(IsPlayerInRangeOfPoint(playerid, 1, PosDesossa[i][0], PosDesossa[i][1], PosDesossa[i][2]))
                {
                        TogglePlayerControllable(playerid, 0);
                        InfoMsg(playerid, "Desossando...");
                        g_DesossarTmr[playerid] = SetTimerEx("Desossar", 10000, false, "i", playerid);
                        ApplyAnimation(playerid, "BASEBALL", "Bat_M", 4.1, 1, 0, 0, 0, 0, 1);
                        RemovePlayerAttachedObject(playerid, 1);
                        UsouCMD[playerid] = true;
                        enZonaDesossa = true;
                        break;
                }
        }
        if(!enZonaDesossa) return ErrorMsg(playerid, "No estas en una zona de deshuesado. Ve al almacen de carnes.");
        return 1;
}

CMD:dejarcarne(playerid)
{
        // FIX AUDIT CARNICERO C-A1-02: validar pProfissao==3 (defense-in-depth).
        if(PlayerInfo[playerid][pProfissao] != 3) return ErrorMsg(playerid, "No tienes permisos.");
        if(Desossando[playerid] == 1)
        {
                if(IsPlayerInRangeOfPoint(playerid, 1, 942.577758, 2117.902099, 1011.030273))
                {
                        RemovePlayerAttachedObject(playerid, 1);
                        DisablePlayerCheckpoint(playerid);
                        ClearAnimations(playerid);
                        ObjetoAcougue[playerid][0] = CreateDynamicObject(2804, 942.313171, 2118.938232, 1011.229980, 0.0, 0.0, 1000.000);
                        MoveDynamicObject(ObjetoAcougue[playerid][0], 942.313171, 2136.355224, 1011.229980,2.0);
                        SetPlayerCheckpoint(playerid,938.006469, 2144.264892, 1011.023437, 1.0);
                        Desossando[playerid] = 2;
                        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
                        SuccesMsg(playerid, "Su carne esta siendo procesada, por favor tome un paquete.");
                }
        }
        return 1;
}

