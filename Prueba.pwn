                }
                else if(PlayerToPoint(3.0, playerid, 1579.1146, 1769.1814, 10.8203) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 3 LV
                {
                        if(PlayerInfo[playerid][Org] != 10)             return ErrorMsg(playerid, "No tienes permisos.");
                        if(paramedico[playerid] == false)               return InfoMsg(playerid, "No estas en servicio con uniforme.");
                        ShowPlayerDialog(playerid, DIALOG_VEHHP, DIALOG_STYLE_LIST, "Seleccionar un vehiculo.", "{FF0000}- {FFFFFF}Ambulance\t{FF0000}416", "Seleccionar", "X");
                }
                else if(PlayerToPoint(3.0, playerid, -2654.3928, 633.1524, 14.4531) && GetPlayerVirtualWorld(playerid) == 0) // Hospital 5 SF
                {
