                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 818.8176,-1106.7904,25.7940, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 3)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 376.6558,-2056.4216,8.0156, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 4)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 937.6857,-1085.2791,24.2891, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 5)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 1282.408813, -1296.472167, 13.368761, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 6)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, EMP_NPC_X, EMP_NPC_Y, EMP_NPC_Z, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 7) //correios
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 1004.1582,1755.0336,10.7734, 3.0);
                                        SuccesMsg(playerid, "Estaba marcado en su mapa.");
                                }
                        }
                }
                case DIALOG_RG1:{
                        // FIX AUDIT RG RG-A3-01/RG-A2-01 (CRITICO): validar wizard stage + input.
                        // ANTES: sin validacion. Cheat spoof OnDialogResponse(DIALOG_RG4, response=1)
