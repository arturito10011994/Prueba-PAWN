                                        // P0-BEN-TUNE: volver al menu principal
                                        ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                                }
                        }
                        else
                        {
                                GanharItem(playerid, 1010, 1);
                        }
                }
                case DIALOG_TUNING_END:
                {
                        if(response)
                        {
                                // Aceptar: finalizar tuneo
                                SuccesMsg(playerid, "Tuning finalizado. Los cambios se guardaron en el vehiculo.");
                                OcultarTuningHUD(playerid);
                        }
                        else
                        {
                                // Cancelar: volver al menu de tuneo
                                ShowPlayerDialog(playerid, DIALOG_MECANICA, DIALOG_STYLE_LIST, "Central de Bennys", "{FFFF00}Mecanica {FFFFFF}Ruedas\n{FFFF00}Mecanica {FFFFFF}Colores\n{FFFF00}Mecanica {FFFFFF}Paintjobs\n{FFFF00}Mecanica {FFFFFF}Nitro\n{FFFF00}Mecanica {FFFFFF}Suspension\n{FFFF00}Mecanica {FFFFFF}Auto Tuning\n", "Confirmar", "Terminar");
                        }
                }
                // P0-BEN-GRUA: handler del dialog de aceptar llamada de grua
                case DIALOG_ACEPTARGRUA:
                {
                        if(!response) return 1;
                        // Reconstruir la lista de slots activos para mapear listitem -> slot
                        new slots[MAX_PLAYERS];
                        new count = 0;
                        for(new i = 0; i < MAX_PLAYERS; i++)
                        {
                                if(g_GruaCalls[i][gc_active] && g_GruaCalls[i][gc_acceptedByMech] == -1)
                                {
                                        slots[count++] = i;
                                        if(count >= MAX_PLAYERS) break;
                                }
                        }
                        if(listitem < 0 || listitem >= count)
                                return ErrorMsg(playerid, "Seleccion invalida.");
                        new slot = slots[listitem];
                        if(!g_GruaCalls[slot][gc_active])
                                return ErrorMsg(playerid, "Esa llamada ya no esta disponible.");
                        if(g_GruaCalls[slot][gc_acceptedByMech] != -1)
                                return ErrorMsg(playerid, "Esa llamada ya fue aceptada por otro mecanico.");

                        // Marcar como aceptada por este mecanico
                        g_GruaCalls[slot][gc_acceptedByMech] = playerid;

                        // Dar checkpoint al mecanico hacia la posicion del vehiculo
                        SetPlayerCheckpoint(playerid, g_GruaCalls[slot][gc_vehX], g_GruaCalls[slot][gc_vehY], g_GruaCalls[slot][gc_vehZ], 5.0);

                        new zonaNom[32];
                        strcpy(zonaNom, GetZonaNombreGrua(g_GruaCalls[slot][gc_zoneID]), sizeof(zonaNom));
                        new msgMec[200];
                        format(msgMec, sizeof(msgMec), "Aceptaste la llamada de %s. Vehiculo en %s. Precio del traslado: $%d. Ve al checkpoint, engancha el vehiculo con /enganchar y llevalo al taller de Bennys.",
                                g_GruaCalls[slot][gc_callerName], zonaNom, g_GruaCalls[slot][gc_precio]);
                        SuccesMsg(playerid, msgMec);

                        // Notificar al caller que vienen en camino
                        new callerID = g_GruaCalls[slot][gc_callerID];
                        if(callerID != INVALID_PLAYER_ID && IsPlayerConnected(callerID))
                        {
                                new msgCaller[24];
                                GetPlayerName(playerid, msgCaller, sizeof(msgCaller));
                                new fullMsg[200];
                                format(fullMsg, sizeof(fullMsg), "El mecanico %s acepto tu llamada de grua. Viene a buscar tu vehiculo. Tu vehiculo seguira inmovilizado hasta llegar al taller.", msgCaller);
                                SuccesMsg(callerID, fullMsg);
                        }
                        printf("[P0-BEN-GRUA] Mecanico ID %d acepto llamada slot %d (caller %s)", playerid, slot, g_GruaCalls[slot][gc_callerName]);
                        return 1;
                }
                case DIALOG_MECANICARuedas:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        AddVehicleComponent(wVeiculo,1073), OnVehicleMod(playerid, wVeiculo, 1073);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Shadow");
                                }
                                if(listitem == 1)
                                {
                                        AddVehicleComponent(wVeiculo, 1074), OnVehicleMod(playerid, wVeiculo, 1074);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Mega");
                                }
                                if(listitem == 2)
                                {
                                        AddVehicleComponent(wVeiculo,1075), OnVehicleMod(playerid, wVeiculo, 1075);
                                        SuccesMsg(playerid, "Rueda Alterada");
                                        ActualizarTuningRueda(playerid, "Rimshine");
                                }
                                if(listitem == 3)
                                {
