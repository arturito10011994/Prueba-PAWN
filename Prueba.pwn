        label[4] = Create3DTextLabel("{FFFF00}Empresa: {FFFFFF}CalvinStick\n{00FF00}Dice:{FFFFFF} Carnicero\n{FFFFFF}Use '{FFFF00}F{FFFFFF}' para conseguir el trabajo.", 0x008080FF, 960.607055, 2097.604003, 1011.023010, 15.0, 0);
        Attach3DTextLabelToPlayer(label[4], Actor[4], 0.0, 0.0, 0.7);
        // FIX UX CARNICERO v3: 3DTextLabel de SALIDA reubicado + funcion corregida.
        // Bug v2: use Create3DTextLabel (nativa SA-MP) con ultimo param=1, lo que se interpreto
        // como virtualworld=1. Pero el jugador entra con virtualworld=0 (SetPlayerVirtualWorld(0)).
