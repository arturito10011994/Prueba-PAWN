                                        // Activar/desactivar con tecla N o /baliza.
                                        BenCrearBalizaSoloLuces(playerid, VeiculoCivil[playerid]);
                                        InfoMsg(playerid, "Towtruck desplegado. Usa /enganchar y /soltar. Presiona N para baliza.");
                                        return 1;
                                }
                                if(listitem == 1) // Bobcat (422) - rango 2+
                                {
                                        if(cargoBEN_veh < 2) return ErrorMsg(playerid, "No tienes rango para este vehiculo.");
                                        if(VehAlugado[playerid] == 1 && IsValidVehicle(VeiculoCivil[playerid]))
                                        {
                                                BenDestruirBalizasTow(playerid);
                                                DestroyVehicle(VeiculoCivil[playerid]);
                                        }
                                        VehAlugado[playerid] = 1;
                                        VeiculoCivil[playerid] = CreateVehicle(422, X, Y, Z, ROT, 6, 6, false);
                                        PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                                        // P0-BEN-BALIZA: agregar baliza 19294 (parpadea sola) + caja 2358 al Bobcat
                                        BenCrearBalizasTow(playerid, VeiculoCivil[playerid]);
                                        InfoMsg(playerid, "Bobcat desplegado. /dvehiculo para devolverlo.");
                                        return 1;
                                }
                                if(listitem == 2) // Rumpo (440) - rango 3
                                {
                                        if(cargoBEN_veh < 3) return ErrorMsg(playerid, "No tienes rango para este vehiculo.");
                                        if(VehAlugado[playerid] == 1 && IsValidVehicle(VeiculoCivil[playerid]))
                                        {
                                                BenDestruirBalizasTow(playerid);
                                                DestroyVehicle(VeiculoCivil[playerid]);
                                        }
                                        VehAlugado[playerid] = 1;
                                        VeiculoCivil[playerid] = CreateVehicle(440, X, Y, Z, ROT, 6, 6, false);
                                        PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                                        InfoMsg(playerid, "Rumpo del Jefe desplegado. /dvehiculo para devolverlo.");
                                        return 1;
                                }
                        }
                }
                // P0-BANDA-VEH: handlers dinamicos para todas las bandas.
                // Todos llaman a la misma funcion helper que lee del sistema de vehiculos.
                case DIALOG_VEHGANG5:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                case DIALOG_VEHGANG6:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                case DIALOG_VEHGANG7:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                case DIALOG_VEHGANG8:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                case DIALOG_VEHGANG12:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                case DIALOG_VEHGANG13:
                {
                        if(response) SpawnVehOrg(playerid, listitem);
                }
                // P0-BANDA-VEH: handler del dialog para comprar vehiculo de faccion
                case DIALOG_COMPRARVEHORG:
                {
                        if(!response) return 1;

                        // CRIT-7 (BANDAVEH-AUD4-001): re-validar idx de la org al confirmar.
                        // Si el admin movio al jugador a otra banda mid-dialog, el idx
                        // recalculado no coincidira con el cacheado al abrir el dialog.
                        // Esto evita escritura cross-banda (pisar vehiculo de la nueva banda).
                        new cachedIdx = GetPVarInt(playerid, "ComprarVehOrgIdx");
                        DeletePVar(playerid, "ComprarVehOrgIdx");
                        new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
                        if(idx != cachedIdx || idx < 0 || idx >= 6)
                                return ErrorMsg(playerid, "Tu banda cambio desde que abriste el menu. Vuelve a usar /comprarvehorg.");

                        // CRIT-4 (BANDAVEH-AUD1-004): re-validar permisos ANTES de cobrar.
                        // TOCTOU: entre ShowPlayerDialog y este handler pueden pasar minutos;
                        // el jugador pudo ser demovido/expulsado/movido de org en ese lapso.
                        if(!IsBandido(playerid))
                                return ErrorMsg(playerid, "Ya no eres miembro de una banda.");
                        if(!IsOrgLeader(playerid))
                                return ErrorMsg(playerid, "Ya no eres lider.");
                        if(!IsPlayerEnConcesionario(playerid))
                                return ErrorMsg(playerid, "Ya no estas en un concesionario.");

                        // CRIT-3 (BANDAVEH-AUD1-003): validar slot en rango [1, MAX_VEH_ORG-1].
                        // Sin esto, un PVar ausente (GetPVarInt=0) sobreescribiria el slot 0
                        // (vehiculo inicial gratuito de la banda).
                        new slot = GetPVarInt(playerid, "ComprarVehOrgSlot");
                        DeletePVar(playerid, "ComprarVehOrgSlot");
                        if(slot < 1 || slot >= MAX_VEH_ORG)
                                return ErrorMsg(playerid, "Slot invalido.");

                        // CRIT-2 (BANDAVEH-AUD1-002): re-validar slot libre ANTES de asignar.
                        // Evita race condition entre dos lideres que abren el dialog
                        // simultaneamente y pisan la compra del otro.
                        if(g_VehOrgModelo[idx][slot] != 0)
                                return ErrorMsg(playerid, "Ese slot ya tiene un vehiculo. Vuelve a intentar.");

                        // Lista de modelos del menu (debe coincidir con ConstruirMenuComprarVehOrg)
                        new modelos[] = {
                                492, 547, 588, 405, 560, 411, 541, 451,
                                562, 581, 522, 461, 439, 480, 550, 466, 467, 475
                        };
                        new precios[] = {
                                25000, 30000, 25000, 60000, 80000, 200000, 150000, 120000,
                                90000, 40000, 90000, 35000, 45000, 100000, 30000, 35000,
                                35000, 45000
                        };
                        if(listitem < 0 || listitem >= sizeof(modelos))
                                return ErrorMsg(playerid, "Seleccion invalida.");
                        new modelo = modelos[listitem];
                        new precio = precios[listitem];
                        if(PlayerInfo[playerid][pDinheiro] < precio)
                        {
                                new msgFalta[120], nombreVeh[32];
                                GetVehicleNombre(modelo, nombreVeh, sizeof(nombreVeh));
                                format(msgFalta, sizeof(msgFalta), "No tienes $%d para comprar el %s.", precio, nombreVeh);
                                return ErrorMsg(playerid, msgFalta);
                        }
                        // Cobrar y guardar vehiculo en el slot libre
                        // FIX AUDIT AGENT5 XS-02+XS-05: AC_AddPlayerMoney + SalvarDados para
                        // evitar dupe por crash y falsos strikes del AC de dinero.
                        AC_AddPlayerMoney(playerid, -precio);
                        SalvarDados(playerid);
                        g_VehOrgModelo[idx][slot] = modelo;
                        // Color = color oficial de la banda
                        g_VehOrgColor1[idx][slot] = g_BandaColorPrimario[idx];
                        g_VehOrgColor2[idx][slot] = g_BandaColorSecundario[idx];
                        g_VehOrgPrecio[idx][slot] = precio;
                        // AUD4-006 (BANDAVEH-ALTO): verificar retorno de GuardarVehOrg.
                        // Si falla (disco lleno, permisos, etc.), el slot en memoria
                        // quedaria seteado pero NO persistido a disco. Al reiniciar
                        // el server, el slot desapareceria (perdida de datos silenciosa).
                        // Ahora: loguear fallo para que el admin pueda investigar.
                        if(!GuardarVehOrg(PlayerInfo[playerid][Org]))
                        {
                                printf("[BANDAVEH-AUD4-006] ERROR: GuardarVehOrg fallo al comprar vehiculo. Jugador %d, org %d, slot %d, modelo %d, precio %d. El slot quedo en memoria pero NO persistido.",
                                        playerid, PlayerInfo[playerid][Org], slot, modelo, precio);
                        }
                        // MEJORA 6 (BANDAVEH): log de transaccion de compra.
                        // Registra jugador, org, slot, modelo y precio para auditoria
                        // economica (reembolsos, rollback, investigacion de dupe).
                        new _logCompraV[256];
                        format(_logCompraV, sizeof(_logCompraV),
                                "COMPRA jugador=%s (ID %d) org=%d slot=%d modelo=%d precio=%d",
                                PlayerName(playerid), playerid, PlayerInfo[playerid][Org], slot, modelo, precio);
                        Log("Logs/BandaVeh.log", _logCompraV);
                        new msgOk[160], nombreVeh[32];
                        GetVehicleNombre(modelo, nombreVeh, sizeof(nombreVeh));
                        format(msgOk, sizeof(msgOk), "Compraste un %s para tu banda (slot %d) por $%d. Ya esta disponible en /ovehiculo.", nombreVeh, slot, precio);
                        SuccesMsg(playerid, msgOk);
                        printf("[P0-BANDA-VEH] Lider %d compro %s (slot %d) para org %d por $%d",
                                playerid, nombreVeh, slot, PlayerInfo[playerid][Org], precio);
                        return 1;
                }
                case DIALOG_RENOMBRARCARGO:
                {
                        if(!IsOrgLeader(playerid)) return 1; // FIX AUDIT3 DS-09
                        if(response)
                        {
                                if(!strlen(inputtext) || strlen(inputtext) > 30) return ErrorMsg(playerid, "Nombre invalido (max 30 caracteres).");
                                new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
                                strcpy(GangRangoC1[idx], inputtext);
                                SetPVarInt(playerid, "RenombroPaso", 2);
                                ShowPlayerDialog(playerid, DIALOG_RENOMBRARC2, DIALOG_STYLE_INPUT, "Renombrar Rangos - Paso 2/3", "Ingresa el nuevo nombre para el rango de SubLider:", "Confirmar", "X");
                        }
                }
                case DIALOG_RENOMBRARC2:
                {
                        if(!IsOrgLeader(playerid)) return 1; // FIX AUDIT3 DS-09
                        if(response)
                        {
                                if(!strlen(inputtext) || strlen(inputtext) > 30) return ErrorMsg(playerid, "Nombre invalido (max 30 caracteres).");
                                new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
                                strcpy(GangRangoC2[idx], inputtext);
                                ShowPlayerDialog(playerid, DIALOG_RENOMBRARC3, DIALOG_STYLE_INPUT, "Renombrar Rangos - Paso 3/3", "Ingresa el nuevo nombre para el rango de Lider:", "Confirmar", "X");
                        }
                }
                case DIALOG_RENOMBRARC3:
                {
                        if(!IsOrgLeader(playerid)) return 1; // FIX AUDIT3 DS-09
                        if(response)
                        {
                                if(!strlen(inputtext) || strlen(inputtext) > 30) return ErrorMsg(playerid, "Nombre invalido (max 30 caracteres).");
                                new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
                                strcpy(GangRangoC3[idx], inputtext);
                                GuardarDatosGang(PlayerInfo[playerid][Org]);
                                new str[128];
                                format(str, sizeof(str), "Rangos actualizados: %s / %s / %s", GangRangoC1[idx], GangRangoC2[idx], GangRangoC3[idx]);
                                SuccesMsg(playerid, str);
                        }
                }
                case DIALOG_RENOMBRARORG:
                {
                        if(!IsOrgLeader(playerid)) return 1; // FIX AUDIT3 DS-09
                        if(response)
                        {
                                if(!strlen(inputtext) || strlen(inputtext) > 60) return ErrorMsg(playerid, "Nombre invalido (max 60 caracteres).");
                                new idx = OrgGangIndex(PlayerInfo[playerid][Org]);
                                if(PlayerInfo[playerid][pDinheiro] < 30000) return ErrorMsg(playerid, "Necesitas $30,000 para cambiar el nombre de la organizacion.");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -30000);
                                // FIX AUDIT2 AGENT2 M-17: SalvarDados antes de GuardarDatosGang.
                                // El nombre de la org se persiste via GuardarDatosGang. Sin
                                // SalvarDados, si crash antes del SaveTimer, el rename es gratis
                                // (dinero en disco = original). Tambien se elimina SetPlayerMoney
                                // redundante: AC_AddPlayerMoney ya sincroniza el cliente via
                                // ResetPlayerMoney + GivePlayerMoney + grace window.
                                SalvarDados(playerid);
                                strcpy(GangOrgNombre[idx], inputtext);
                                GuardarDatosGang(PlayerInfo[playerid][Org]);
                                new str[128];
                                format(str, sizeof(str), "Organizacion renombrada a: %s. Se descontaron $30,000.", inputtext);
                                SuccesMsg(playerid, str);
                        }
                }
                case DIALOG_ANUNCIOOLX:
                {
                        if(response)
                        {
                                cmd_anuncio(playerid, inputtext);

                        }
                }
                case DIALOG_VALORTRANSACAO:
                {
                        if(response)
                        {
                                new BankV[255];
                                // FIX AUDIT CEL CEL-A4-02 (CRITICO): validar inputtext para evitar integer overflow.
                                // ANTES: IsNumeric(inputtext) aceptaba strings de hasta 10+ digitos.
                                // strval de "3000000000" causaba wrap a negativo en Pawn (int32).
                                // SetPVarInt guardaba valor negativo. En retiro: pBanco -= -1.3B = +1.3B.
                                // Bypass del clamp de AC_AddPlayerMoney. Ahora validar strlen y valor > 0.
                                if(!IsNumeric(inputtext)) return ErrorMsg(playerid, "Solo numeros");
                                if(strlen(inputtext) == 0) return ErrorMsg(playerid, "Ingresa un valor.");
                                if(strlen(inputtext) > 9) return ErrorMsg(playerid, "Valor invalido (max 9 digitos).");
                                new valorTrans = strval(inputtext);
                                if(valorTrans <= 0) return ErrorMsg(playerid, "El valor debe ser mayor que 0.");
                                SetPVarInt(playerid, "QtdTransacao", valorTrans);
                                format(BankV, sizeof(BankV), "%i", GetPVarInt(playerid, "QtdTransacao"));
                                PlayerTextDrawSetString(playerid, BancoTD[playerid][28], BankV);
                        }
                }
                case DIALOG_QTDINV:
                {
                        if(response)
                        {
                                new BankV[255];
                                if(!IsNumeric(inputtext)) return ErrorMsg(playerid, "Solo numeros");
                                // FIX AUDIT INV I2-1: rechazar cantidad <= 0 o > 9999 en DIALOG_QTDINV.
                                // Antes: solo validaba IsNumeric (filtra no-digitos pero no negativos
                                // escritos como "-100" porque IsNumeric acepta "-" como primer char).
                                // strval("-100") = -100. qtdinv = -100. DroparItem/FuncaoItens
                                // con quantia=-100 => Unidades -= (-100) = +100 = DUPE INFINITO.
                                // Adicionalmente, rechazar > 9999 (cap max de Unidades en SaveTimer).
                                new valQtd = strval(inputtext);
                                if(valQtd < 1) return ErrorMsg(playerid, "La cantidad debe ser mayor que 0.");
                                if(valQtd > 9999) return ErrorMsg(playerid, "La cantidad no puede ser mayor que 9999.");
                                qtdinv[playerid] = valQtd;
                                format(BankV, sizeof(BankV), "%s", ConvertMoney(qtdinv[playerid]));
                                PlayerTextDrawSetString(playerid, DrawInv[playerid][36], BankV);
                        }
                }
                // FIX AUDIT COFRE [C1]: handler de DIALOG_ARMAS2 (cofre de banda - estaba 100% roto)
                case DIALOG_ARMAS2:
                {
                        // FIX AUDIT4 HIGH-DBG-2: debug SendClientMessage eliminado (msg al cliente en cada respuesta de dialogo)
                        // new dbgMsg[128];
                        // format(dbgMsg, sizeof(dbgMsg), "[DEBUG COFRE] response=%d listitem=%d dialogid=%d", response, listitem, dialogid);
                        // SendClientMessage(playerid, 0xFFFF00FF, dbgMsg);
                        // Limpiar PVar anti-spam (el dialogo se cerro, ya sea por response o por cancelar)
                        DeletePVar(playerid, "CofreDialogoAbierto");
                        if(!response) return 1; // cerro el dialogo
                        new orgCofre = PlayerInfo[playerid][Org];
                        new savedOrg = GetPVarInt(playerid, "CofreOrgAbierto");
                        // FIX AUDIT4 HIGH-DBG-2: debug SendClientMessage eliminado
                        // format(dbgMsg, sizeof(dbgMsg), "[DEBUG COFRE] orgCofre=%d savedOrg=%d", orgCofre, savedOrg);
                        // SendClientMessage(playerid, 0xFFFF00FF, dbgMsg);
                        if(orgCofre < 5 || orgCofre > 13 || orgCofre == 9)
                        {
                                // SendClientMessage(playerid, 0xFF0000FF, "[DEBUG COFRE] Bloqueado: no eres banda (org fuera de rango 5-13).");
                                return 1; // solo bandas
                        }
                        // FIX AUDIT COFRE [M1]: re-validar que la org del jugador no cambio desde que abrio el cofre
                        // (anti-race condition: jugador abre cofre de banda A, admin lo cambia a banda B,
                        //  jugador responde el dialogo y saca arma de banda A siendo ya de banda B)
                        if(savedOrg != orgCofre)
                        {
                                ErrorMsg(playerid, "Tu organizacion cambio. No puedes acceder a este cofre.");
                                DeletePVar(playerid, "CofreOrgAbierto");
                                return 1;
                        }
                        // FIX AUDIT COFRE [M5]: validar estado del jugador (no debe estar muerto)
                        if(!IsPlayerConnected(playerid) || GetPlayerState(playerid) == PLAYER_STATE_WASTED)
                        {
                                DeletePVar(playerid, "CofreOrgAbierto");
                                return 1;
                        }
                        if(listitem == 0)
                        {
                                // "Guardar Arma" - depositar arma actual del jugador en el cofre
                                // FIX AUDIT4 HIGH-DBG-2: debug SendClientMessage eliminado
                                // new dbgArma[64];
                                // format(dbgArma, sizeof(dbgArma), "[DEBUG COFRE] Guardando arma en mano: %d (ammo %d)", GetPlayerWeapon(playerid), GetPlayerAmmo(playerid));
                                // SendClientMessage(playerid, 0xFFFF00FF, dbgArma);
                                GuardarItem2(playerid);
                        }
                        else if(listitem >= 1 && listitem <= 50)
                        {
                                // Selecciono un arma del cofre - slot real = listitem - 1
                                new slot = listitem - 1;
                                if(CofreArma[slot][orgCofre] > 0)
                                {
                                        ItemOpcoes2(playerid, slot);
                                }
                                else
                                {
                                        ErrorMsg(playerid, "Ese slot del cofre esta vacio.");
                                }
                        }
                        return 1;
                }
                case DIALOG_ARMAS12:
                {
                        // Limpiar PVars del cofre al cerrar este submenu
                        DeletePVar(playerid, "CofreDialogoAbierto");
                        new orgid = GetPlayerOrg(playerid);
                        if(!response) return 1;
                        // FIX AUDIT COFRE [M1]: re-validar org con PVar (anti-race condition)
                        new savedOrg = GetPVarInt(playerid, "CofreOrgAbierto");
                        if(savedOrg != orgid)
                        {
                                ErrorMsg(playerid, "Tu organizacion cambio. No puedes acceder a este cofre.");
                                DeletePVar(playerid, "CofreOrgAbierto");
                                return 1;
                        }
                        if(response)
                        {
                                switch(listitem)
                                {
                                        case 0:
                                        {
                                                if(PlayerInfo[playerid][Org] == orgid)
                                                {
                                                        SuccesMsg(playerid, "Tomaste el arma del cofre.");
                                                        GivePlayerWeapon(playerid, CofreArma[ItemOpcion[playerid]][orgid], CofreAmmo[ItemOpcion[playerid]][orgid]);
                                                        CofreArma[ItemOpcion[playerid]][orgid]=0;
                                                        CofreAmmo[ItemOpcion[playerid]][orgid]=0;
                                                        SalvarCofre(orgid);
                                                }
                                                else
                                                {
                                                        ErrorMsg(playerid, "Sin permiso. No eres de esta organizacion.");
                                                }
                                        }
                                        case 1:
                                        {
                                                if(PlayerInfo[playerid][Org] == orgid)
                                                {
                                                        GivePlayerWeapon(playerid, CofreArma[ItemOpcion[playerid]][orgid], CofreAmmo[ItemOpcion[playerid]][orgid]);
                                                        // FIX AUDIT COFRE [C4]: era CofreAmmo=0 duplicado (copy-paste bug)
                                                        // CofreArma nunca se limpiaba -> arma fantasma en cofre -> dupe infinito
                                                        CofreArma[ItemOpcion[playerid]][orgid]=0;
                                                        CofreAmmo[ItemOpcion[playerid]][orgid]=0;
                                                        // FIX AUDIT COFRE [C3]: eliminado SetTimerEx("TirarArma222") - callback inexistente
                                                        SuccesMsg(playerid, "Retiraste el arma del cofre.");
                                                        SalvarCofre(orgid);
                                                }
                                                else
                                                {
                                                        ErrorMsg(playerid, "Sin permiso. No eres de esta organizacion.");
                                                }
                                        }
                                }
                                return 1;
                        }
                }
                // =====================================================================
                // SISTEMA ALMACEN ORG - HANDLERS
                // =====================================================================
                case DIALOG_ALMACEN_ORG:
                {
                        DeletePVar(playerid, "CofreDialogoAbierto");
                        if(!response) return 1;
                        new orgid = PlayerInfo[playerid][Org];
                        new savedOrg = GetPVarInt(playerid, "CofreOrgAbierto");
                        if(savedOrg != orgid) return 1;
                        switch(listitem)
                        {
                                case 0: AlmMostrarArmas(playerid, orgid);
                                case 1: AlmMostrarDrogas(playerid, orgid);
                                case 2: AlmMostrarFondo(playerid, orgid);
                                case 3: AlmMostrarHerramientas(playerid, orgid);
                                case 4:
                                {
                                        // Ver movimientos - leer las ultimas 20 entradas del archivo INI
                                        new logFile[64], msg[2048];
                                        format(logFile, sizeof(logFile), "Logs/OrgMovimientos%d.ini", orgid);
                                        if(!DOF2_FileExists(logFile))
                                        {
                                                strcat(msg, "{FF0000}No hay movimientos registrados.");
                                        }
                                        else
                                        {
                                                // DOF2 no expone enumeracion de keys, asi que leemos timestamps
                                                // de los ultimos 7 dias buscando entradas
                                                new ano, count = 0;
                                                getdate(ano, _, _);
                                                new line[256], key[32], val[200];
                                                // Iterar dias hacia atras (ultimos 30 dias)
                                                for(new dd = 31; dd >= 1 && count < 20; dd--)
                                                {
                                                        for(new mm = 12; mm >= 1 && count < 20; mm--)
                                                        {
                                                                for(new h = 23; h >= 0 && count < 20; h--)
                                                                {
                                                                        for(new m = 59; m >= 0 && count < 20; m--)
                                                                        {
                                                                                for(new s = 59; s >= 0 && count < 20; s--)
                                                                                {
                                                                                        format(key, sizeof(key), "%02d/%02d/%d %02d:%02d:%02d", dd, mm, ano, h, m, s);
                                                                                        if(DOF2_IsSet(logFile, key))
                                                                                        {
                                                                                                format(val, sizeof(val), "%s", DOF2_GetString(logFile, key));
                                                                                                format(line, sizeof(line), "{FFDC33}[%s] {FFFFFF}%s\n", key, val);
                                                                                                strcat(msg, line);
                                                                                                count++;
                                                                                        }
                                                                                }
                                                                        }
                                                                }
                                                        }
                                                }
                                                if(count == 0) strcat(msg, "{FF0000}No hay movimientos registrados.");
                                        }
                                        ShowPlayerDialog(playerid, DIALOG_ALMACEN_MOVIMIENTOS, DIALOG_STYLE_MSGBOX, "Movimientos de Organizacion", msg, "Cerrar", "");
                                }
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_ARMAS:
                {
                        if(!response) { AlmMostrarMenuPrincipal(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        if(listitem == 0)
                        {
                                // Guardar arma en mano (sistema original)
                                GuardarItem2(playerid);
                                AlmMostrarArmas(playerid, orgid);
                        }
                        else if(listitem == 1)
                        {
                                // Ver municion separada
                                AlmMostrarMunicion(playerid, orgid);
                        }
                        else
                        {
                                // Slots de armas (listitem 2 a 51 = slot 0 a 49)
                                new slot = listitem - 2;
                                if(slot >= 0 && slot < 50 && CofreArma[slot][orgid] > 0)
                                {
                                        ItemOpcion[playerid] = slot;
                                        ShowPlayerDialog(playerid, DIALOG_ALMACEN_ARMAS_OP, DIALOG_STYLE_LIST, "Opciones del Arma", "Tomar Arma\nRetirar del Cofre", "OK", "Volver");
                                }
                                else
                                {
                                        ErrorMsg(playerid, "Ese slot del cofre esta vacio.");
                                        AlmMostrarArmas(playerid, orgid);
                                }
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_ARMAS_OP:
                {
                        if(!response) { AlmMostrarArmas(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        new slot = ItemOpcion[playerid];
                        if(slot < 0 || slot >= 50) return 1;
                        if(listitem == 0 || listitem == 1)
                        {
                                // Tomar o Retirar (mismo comportamiento: dar arma + municion al jugador)
                                if(!AlmPuedeRetirar(playerid, orgid))
                                {
                                        ErrorMsg(playerid, "No tienes permiso para retirar armas. Solo el lider (o subjefe si no hay lider) puede.");
                                        return 1;
                                }
                                new armaId = CofreArma[slot][orgid];
                                new ammoId = CofreAmmo[slot][orgid];
                                if(armaId == 0) { ErrorMsg(playerid, "Ese slot esta vacio."); return 1; }
                                GivePlayerWeapon(playerid, armaId, ammoId);
                                CofreArma[slot][orgid] = 0;
                                CofreAmmo[slot][orgid] = 0;
                                SalvarCofre(orgid);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                new wname[32];
                                GetWeaponName(armaId, wname, sizeof(wname));
                                format(logMsg, sizeof(logMsg), "%s retiro %s del cofre de armamento", pName, wname);
                                AlmReg_Movimiento(orgid, logMsg);
                                SuccesMsg(playerid, "Retiraste el arma del cofre.");
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_MUNICION:
                {
                        if(!response) { AlmMostrarArmas(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        if(listitem == 0)
                        {
                                // Depositar municion del arma en mano
                                new armaMano = GetPlayerWeapon(playerid);
                                new ammoMano = GetPlayerAmmo(playerid);
                                if(armaMano == 0) { ErrorMsg(playerid, "No tienes arma en mano."); return 1; }
                                if(ammoMano <= 0) { ErrorMsg(playerid, "No tienes municion en el arma."); return 1; }
                                // Buscar slot existente del mismo tipo
                                new slotEncontrado = -1;
                                for(new i = 0; i < MAX_MUNICION_SLOTS; i++)
                                {
                                        if(CofreMunicionTipo[i][orgid] == armaMano) { slotEncontrado = i; break; }
                                }
                                if(slotEncontrado == -1)
                                {
                                        // Buscar slot vacio
                                        for(new i = 0; i < MAX_MUNICION_SLOTS; i++)
                                        {
                                                if(CofreMunicionTipo[i][orgid] == 0) { slotEncontrado = i; break; }
                                        }
                                }
                                if(slotEncontrado == -1) { ErrorMsg(playerid, "No hay slots de municion disponibles."); return 1; }
                                CofreMunicionTipo[slotEncontrado][orgid] = armaMano;
                                CofreMunicionCant[slotEncontrado][orgid] += ammoMano;
                                // Quitar municion al jugador (setear ammo del arma a 0)
                                SetPlayerAmmo(playerid, armaMano, 0);
                                SalvarCofre(orgid);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                new wname[32];
                                GetWeaponName(armaMano, wname, sizeof(wname));
                                format(logMsg, sizeof(logMsg), "%s deposito %d balas de %s", pName, ammoMano, wname);
                                AlmReg_Movimiento(orgid, logMsg);
                                SuccesMsg(playerid, "Municion depositada en el cofre.");
                                AlmMostrarMunicion(playerid, orgid);
                        }
                        else
                        {
                                // Retirar municion de un slot
                                new slot = listitem - 1;
                                if(slot < 0 || slot >= MAX_MUNICION_SLOTS) return 1;
                                if(CofreMunicionTipo[slot][orgid] == 0 || CofreMunicionCant[slot][orgid] <= 0)
                                {
                                        ErrorMsg(playerid, "Ese slot de municion esta vacio.");
                                        return 1;
                                }
                                if(!AlmPuedeRetirar(playerid, orgid))
                                {
                                        ErrorMsg(playerid, "No tienes permiso para retirar municion.");
                                        return 1;
                                }
                                new armaTipo = CofreMunicionTipo[slot][orgid];
                                new cantidad = CofreMunicionCant[slot][orgid];
                                GivePlayerWeapon(playerid, armaTipo, cantidad);
                                CofreMunicionTipo[slot][orgid] = 0;
                                CofreMunicionCant[slot][orgid] = 0;
                                SalvarCofre(orgid);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                new wname[32];
                                GetWeaponName(armaTipo, wname, sizeof(wname));
                                format(logMsg, sizeof(logMsg), "%s retiro %d balas de %s", pName, cantidad, wname);
                                AlmReg_Movimiento(orgid, logMsg);
                                SuccesMsg(playerid, "Municion retirada del cofre.");
                                AlmMostrarMunicion(playerid, orgid);
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_DROGAS:
                {
                        if(!response) { AlmMostrarMenuPrincipal(playerid, PlayerInfo[playerid][Org]); return 1; }
                        SetPVarInt(playerid, "AlmDrogaSel", listitem);
                        new nombres[4][16] = {"Marihuana", "Cocaina", "Crack", "Pasta Base"};
                        new msg[128];
                        format(msg, sizeof(msg), "Que quieres hacer con %s?", nombres[listitem]);
                        ShowPlayerDialog(playerid, DIALOG_ALMACEN_DROGAS_OP, DIALOG_STYLE_LIST, msg, "Depositar\nRetirar", "OK", "Volver");
                        return 1;
                }
                case DIALOG_ALMACEN_DROGAS_OP:
                {
                        if(!response) { AlmMostrarDrogas(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        new drogaId = GetPVarInt(playerid, "AlmDrogaSel");
                        new itemIds[4] = {1576, 1575, 3930, 854};
                        new maximos[4] = {MAX_DROGA_MACONHA, MAX_DROGA_COCAINA, MAX_DROGA_CRACK, MAX_DROGA_PASTABASE};
                        new nombres[4][16] = {"Marihuana", "Cocaina", "Crack", "Pasta Base"};
                        if(drogaId < 0 || drogaId > 3) return 1;
                        if(listitem == 0)
                        {
                                // Depositar: buscar en inventario del jugador
                                new itemId = itemIds[drogaId];
                                new cantidadInv = 0;
                                for(new s = 0; s < 33; s++)
                                {
                                        if(PlayerInventario[playerid][s][Slot] == itemId)
                                        {
                                                cantidadInv = PlayerInventario[playerid][s][Unidades];
                                                break;
                                        }
                                }
                                if(cantidadInv <= 0)
                                {
                                        new msg[64];
                                        format(msg, sizeof(msg), "No tienes %s en tu inventario.", nombres[drogaId]);
                                        ErrorMsg(playerid, msg);
                                        return 1;
                                }
                                new espacio = maximos[drogaId] - g_AlmacenDrogas[orgid][drogaId];
                                if(espacio <= 0) { ErrorMsg(playerid, "El almacen de esta droga esta lleno."); return 1; }
                                new aDepositar = (cantidadInv > espacio) ? espacio : cantidadInv;
                                // FIX AUDIT INV I1-1: orden anti-dupe. Inventario PRIMERO, cofre DESPUES.
                                // Antes: cofre += PRIMERO, inventario -= DESPUES. Si crash entre ambos,
                                // el cofre tenia las drogas Y el inventario tambien = DUPE.
                                // Ahora: inventario -= PRIMERO, SalvarInventario, cofre += DESPUES.
                                for(new s = 0; s < 33; s++)
                                {
                                        if(PlayerInventario[playerid][s][Slot] == itemId)
                                        {
                                                PlayerInventario[playerid][s][Unidades] -= aDepositar;
                                                if(PlayerInventario[playerid][s][Unidades] <= 0)
                                                {
                                                        PlayerInventario[playerid][s][Slot] = -1;
                                                        PlayerInventario[playerid][s][Unidades] = 0;
                                                }
                                                break;
                                        }
                                }
                                SalvarInventario(playerid);
                                g_AlmacenDrogas[orgid][drogaId] += aDepositar;
                                // FIX VERIF FASE 1: persistir cofre tras depÃ¯Â¿Â½sito de drogas.
                                // El fix I1-1 reordenÃ¯Â¿Â½ las operaciones correctamente (inventario
                                // PRIMERO + SalvarInventario, cofre DESPUES) pero eliminÃ¯Â¿Â½ la
                                // llamada SalvarCofre que existÃ¯Â¿Â½a en el cÃ¯Â¿Â½digo pre-fix (L37121
                                // en Farandula (5).pwn). Sin esto, si el servidor crashea entre
                                // el depÃ¯Â¿Â½sito y el siguiente SalvarCofre (server shutdown
                                // L22925), el cofre pierde el depÃ¯Â¿Â½sito en disco = LOSS.
                                // Nota: NO es DUPE (los items no se duplican, se pierden).
                                // Patron consistente con DROGAS WITHDRAW (L37430) y HERR DEP
                                // (L37611) que SI preservan SalvarCofre.
                                SalvarCofre(orgid);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                format(logMsg, sizeof(logMsg), "%s deposito %d de %s", pName, aDepositar, nombres[drogaId]);
                                AlmReg_Movimiento(orgid, logMsg);
                                new msg2[128];
                                format(msg2, sizeof(msg2), "Depositaste %d de %s en el almacen.", aDepositar, nombres[drogaId]);
                                SuccesMsg(playerid, msg2);
                                AlmMostrarDrogas(playerid, orgid);
                        }
                        else
                        {
                                // Retirar
                                if(!AlmPuedeRetirar(playerid, orgid))
                                {
                                        ErrorMsg(playerid, "No tienes permiso para retirar drogas.");
                                        return 1;
                                }
                                if(g_AlmacenDrogas[orgid][drogaId] <= 0)
                                {
                                        ErrorMsg(playerid, "No hay drogas de este tipo en el almacen.");
                                        return 1;
                                }
                                new cantidad = g_AlmacenDrogas[orgid][drogaId];
                                // FIX AUDIT INV I1-1: orden anti-dupe en retiro. Cofre PRIMERO, inventario DESPUES.
                                // Antes: GanharItem (inventario) PRIMERO, cofre=0 DESPUES. Si crash entre ambos,
                                // el jugador tenia las drogas Y el cofre tambien = DUPE.
                                // Ahora: cofre=0 PRIMERO, SalvarCofre, GanharItem DESPUES.
                                g_AlmacenDrogas[orgid][drogaId] = 0;
                                SalvarCofre(orgid);
                                GanharItem(playerid, itemIds[drogaId], cantidad);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                format(logMsg, sizeof(logMsg), "%s retiro %d de %s", pName, cantidad, nombres[drogaId]);
                                AlmReg_Movimiento(orgid, logMsg);
                                new msg2[128];
                                format(msg2, sizeof(msg2), "Retiraste %d de %s del almacen.", cantidad, nombres[drogaId]);
                                SuccesMsg(playerid, msg2);
                                AlmMostrarDrogas(playerid, orgid);
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_FONDO:
                {
                        if(!response) { AlmMostrarMenuPrincipal(playerid, PlayerInfo[playerid][Org]); return 1; }
                        if(listitem == 0)
                        {
                                ShowPlayerDialog(playerid, DIALOG_ALMACEN_FONDO_DEP, DIALOG_STYLE_INPUT, "Depositar Dinero", "Escribe la cantidad a depositar:", "Depositar", "Cancelar");
                        }
                        else
                        {
                                new orgid = PlayerInfo[playerid][Org];
                                if(!AlmPuedeRetirar(playerid, orgid))
                                {
                                        ErrorMsg(playerid, "No tienes permiso para retirar dinero del fondo.");
                                        return 1;
                                }
                                ShowPlayerDialog(playerid, DIALOG_ALMACEN_FONDO_RET, DIALOG_STYLE_INPUT, "Retirar Dinero", "Escribe la cantidad a retirar:", "Retirar", "Cancelar");
                        }
                        return 1;
                }
                case DIALOG_ALMACEN_FONDO_DEP:
                {
                        if(!response) { AlmMostrarFondo(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        new cantidad = strval(inputtext);
                        if(cantidad <= 0) { ErrorMsg(playerid, "Cantidad invalida."); AlmMostrarFondo(playerid, orgid); return 1; }
                        if(PlayerInfo[playerid][pDinheiro] < cantidad) { ErrorMsg(playerid, "No tienes ese dinero en efectivo."); AlmMostrarFondo(playerid, orgid); return 1; }
                        if(g_FondoOrg[orgid] + cantidad > MAX_FONDO_ORG)
                        {
                                new maxDep = MAX_FONDO_ORG - g_FondoOrg[orgid];
                                new msg[128];
                                format(msg, sizeof(msg), "El fondo alcanzaria el maximo de $%d. Solo puedes depositar $%d.", MAX_FONDO_ORG, maxDep);
                                ErrorMsg(playerid, msg);
                                AlmMostrarFondo(playerid, orgid);
                                return 1;
                        }
                        // FIX AUDIT AGENT5 XS-02+XS-05: AC_AddPlayerMoney + SalvarDados para
                        // evitar dupe por crash (fondo org persistido por SalvarCofre pero
                        // pDinheiro del jugador no, ventana de 60s para dupe por crash).
                        AC_AddPlayerMoney(playerid, -cantidad);
                        SalvarDados(playerid);
                        g_FondoOrg[orgid] += cantidad;
                        SalvarCofre(orgid);
                        new logMsg[128], pName[24];
                        GetPlayerName(playerid, pName, sizeof(pName));
                        format(logMsg, sizeof(logMsg), "%s deposito $%d en el fondo", pName, cantidad);
                        AlmReg_Movimiento(orgid, logMsg);
                        new msg2[128];
                        format(msg2, sizeof(msg2), "Depositaste $%d en el fondo. Saldo: $%d / $%d", cantidad, g_FondoOrg[orgid], MAX_FONDO_ORG);
                        SuccesMsg(playerid, msg2);
                        AlmMostrarFondo(playerid, orgid);
                        return 1;
                }
                case DIALOG_ALMACEN_FONDO_RET:
                {
                        if(!response) { AlmMostrarFondo(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        new cantidad = strval(inputtext);
                        if(cantidad <= 0) { ErrorMsg(playerid, "Cantidad invalida."); AlmMostrarFondo(playerid, orgid); return 1; }
                        if(cantidad > g_FondoOrg[orgid]) { ErrorMsg(playerid, "El fondo no tiene esa cantidad."); AlmMostrarFondo(playerid, orgid); return 1; }
                        g_FondoOrg[orgid] -= cantidad;
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, cantidad);
                        // FIX AUDIT2 AGENT2 M-16: SalvarDados antes de SalvarCofre.
                        // El fondo org se persiste via SalvarCofre. Sin SalvarDados
                        // (que el DEPOSITO si tiene), si crash antes del SaveTimer el
                        // jugador obtiene el retiro gratis (dinero en disco = original).
                        // Inconsistencia con DEPOSIT corregida.
                        SalvarDados(playerid);
                        SalvarCofre(orgid);
                        new logMsg[128], pName[24];
                        GetPlayerName(playerid, pName, sizeof(pName));
                        format(logMsg, sizeof(logMsg), "%s retiro $%d del fondo", pName, cantidad);
                        AlmReg_Movimiento(orgid, logMsg);
                        new msg2[128];
                        format(msg2, sizeof(msg2), "Retiraste $%d del fondo. Saldo: $%d / $%d", cantidad, g_FondoOrg[orgid], MAX_FONDO_ORG);
                        SuccesMsg(playerid, msg2);
                        AlmMostrarFondo(playerid, orgid);
                        return 1;
                }
                case DIALOG_ALMACEN_HERRAMIENTAS:
                {
                        if(!response) { AlmMostrarMenuPrincipal(playerid, PlayerInfo[playerid][Org]); return 1; }
                        SetPVarInt(playerid, "AlmHerrSel", listitem);
                        new nombres[4][24] = {"Ganzuas", "Taladros", "Explosivos", "Piezas para armas"};
                        new msg[128];
                        format(msg, sizeof(msg), "Que quieres hacer con %s?", nombres[listitem]);
                        ShowPlayerDialog(playerid, DIALOG_ALMACEN_HERR_OP, DIALOG_STYLE_LIST, msg, "Depositar 1\nDepositar todo\nRetirar 1\nRetirar todo", "OK", "Volver");
                        return 1;
                }
                case DIALOG_ALMACEN_HERR_OP:
                {
                        if(!response) { AlmMostrarHerramientas(playerid, PlayerInfo[playerid][Org]); return 1; }
                        new orgid = PlayerInfo[playerid][Org];
                        new herrSel = GetPVarInt(playerid, "AlmHerrSel");
                        new nombres[4][24] = {"Ganzuas", "Taladros", "Explosivos", "Piezas para armas"};
                        new itemIds[3] = {ITEM_GANZUA, ITEM_TALADRO, ITEM_EXPLOSIVO};
                        if(herrSel < 0 || herrSel > 3) return 1;
                        new cantidadActual = (herrSel < 3) ? g_CofreHerramientas[orgid][herrSel] : g_CofrePiezas[orgid];
                        if(listitem == 0 || listitem == 1)
                        {
                                // Depositar
                                new aDepositar = 0; // FIX AUDIT: declarar al inicio para que sea visible en el log
                                if(herrSel < 3)
                                {
                                        // Herramientas (buscar en inventario)
                                        new itemId = itemIds[herrSel];
                                        new cantidadInv = 0;
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == itemId)
                                                {
                                                        cantidadInv = PlayerInventario[playerid][s][Unidades];
                                                        break;
                                                }
                                        }
                                        if(cantidadInv <= 0) { ErrorMsg(playerid, "No tienes esa herramienta en tu inventario."); return 1; }
                                        aDepositar = (listitem == 1) ? cantidadInv : 1;
                                        if(aDepositar > cantidadInv) aDepositar = cantidadInv;
                                        // FIX AUDIT INV I1-1: orden anti-dupe. Inventario PRIMERO, cofre DESPUES.
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == itemId)
                                                {
                                                        PlayerInventario[playerid][s][Unidades] -= aDepositar;
                                                        if(PlayerInventario[playerid][s][Unidades] <= 0)
                                                        {
                                                                PlayerInventario[playerid][s][Slot] = -1;
                                                                PlayerInventario[playerid][s][Unidades] = 0;
                                                        }
                                                        break;
                                                }
                                        }
                                        SalvarInventario(playerid);
                                        g_CofreHerramientas[orgid][herrSel] += aDepositar;
                                }
                                else
                                {
                                        // Piezas para armas (item 19921 - Caja de herramientas, simulamos)
                                        // Por ahora no hay item especifico de piezas, usamos item 19921
                                        new cantidadInv = 0;
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == 19921)
                                                {
                                                        cantidadInv = PlayerInventario[playerid][s][Unidades];
                                                        break;
                                                }
                                        }
                                        if(cantidadInv <= 0) { ErrorMsg(playerid, "No tienes piezas para armas."); return 1; }
                                        aDepositar = (listitem == 1) ? cantidadInv : 1;
                                        if(aDepositar > cantidadInv) aDepositar = cantidadInv;
                                        // FIX AUDIT INV I1-1: orden anti-dupe. Inventario PRIMERO, cofre DESPUES.
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == 19921)
                                                {
                                                        PlayerInventario[playerid][s][Unidades] -= aDepositar;
                                                        if(PlayerInventario[playerid][s][Unidades] <= 0)
                                                        {
                                                                PlayerInventario[playerid][s][Slot] = -1;
                                                                PlayerInventario[playerid][s][Unidades] = 0;
                                                        }
                                                        break;
                                                }
                                        }
                                        SalvarInventario(playerid);
                                        g_CofrePiezas[orgid] += aDepositar;
                                }
                                SalvarCofre(orgid);
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                format(logMsg, sizeof(logMsg), "%s deposito %d %s", pName, aDepositar, nombres[herrSel]);
                                AlmReg_Movimiento(orgid, logMsg);
                                SuccesMsg(playerid, "Deposito realizado.");
                        }
                        else
                        {
                                // Retirar
                                if(!AlmPuedeRetirar(playerid, orgid))
                                {
                                        ErrorMsg(playerid, "No tienes permiso para retirar herramientas.");
                                        return 1;
                                }
                                if(cantidadActual <= 0) { ErrorMsg(playerid, "No hay existencias de ese item."); return 1; }
                                new aRetirar = (listitem == 3) ? cantidadActual : 1;
                                if(aRetirar > cantidadActual) aRetirar = cantidadActual;
                                if(herrSel < 3)
                                {
                                        // FIX AUDIT INV I1-1: orden anti-dupe en retiro. Cofre PRIMERO, inventario DESPUES.
                                        g_CofreHerramientas[orgid][herrSel] -= aRetirar;
                                        SalvarCofre(orgid);
                                        GanharItem(playerid, itemIds[herrSel], aRetirar);
                                }
                                else
                                {
                                        // FIX AUDIT INV I1-1: orden anti-dupe en retiro. Cofre PRIMERO, inventario DESPUES.
                                        g_CofrePiezas[orgid] -= aRetirar;
                                        SalvarCofre(orgid);
                                        GanharItem(playerid, 19921, aRetirar);
                                }
                                new logMsg[128], pName[24];
                                GetPlayerName(playerid, pName, sizeof(pName));
                                format(logMsg, sizeof(logMsg), "%s retiro %d %s", pName, aRetirar, nombres[herrSel]);
                                AlmReg_Movimiento(orgid, logMsg);
                                SuccesMsg(playerid, "Retiro realizado.");
                        }
                        AlmMostrarHerramientas(playerid, orgid);
                        return 1;
                }
                case DIALOG_ALMACEN_MOVIMIENTOS:
                {
                        if(!response) AlmMostrarMenuPrincipal(playerid, PlayerInfo[playerid][Org]);
                        return 1;
                }
                case DIALOG_JOALHERIA:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 15000)                     return ErrorMsg(playerid, "Dinero insuficiente.");
                                        SuccesMsg(playerid, "Item comprado.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -15000);
                                        GanharItem(playerid, 2710, 1);
                                        CofreJoalheria += 15000;
                                        SalvarInventario(playerid);
                                        // FIX AUDIT2 AGENT2 M-22: SalvarDados junto con SalvarInventario.
                                        SalvarDados(playerid);
                                        SalvarDinRoubos();
                                        SalvarInventario(playerid);
                                }
                                if(listitem == 1)
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 30000)                     return ErrorMsg(playerid, "Dinero insuficiente.");
                                        SuccesMsg(playerid, "Item comprado.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -30000);
                                        GanharItem(playerid, 1316, 1);
                                        CofreJoalheria += 30000;
                                        SalvarInventario(playerid);
                                        // FIX AUDIT2 AGENT2 M-22: SalvarDados junto con SalvarInventario.
                                        SalvarDados(playerid);
                                        SalvarDinRoubos();
                                        SalvarInventario(playerid);
                                }
                        }
                }
                case DIALOG_AMMU:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 2500)                      return ErrorMsg(playerid, "Dinero insuficiente.");
                                        SuccesMsg(playerid, "Item comprado.");
                                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                        AC_AddPlayerMoney(playerid, -2500);
                                        GanharItem(playerid, 18632, 1);
                                        CofreAmmu += 2500;
                                        SalvarInventario(playerid);
                                        // FIX AUDIT2 AGENT2 M-22: SalvarDados junto con SalvarInventario.
                                        SalvarDados(playerid);
                                        SalvarDinRoubos();
                                        SalvarInventario(playerid);
                                }
                                if(listitem == 1)
                                {
                                        if(PlayerInfo[playerid][pDinheiro] < 4200)                      return ErrorMsg(playerid, "Dinero insuficiente.");
