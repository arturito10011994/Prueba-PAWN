                                }
                                if(listitem == 1) // Carnet de Trabajo
                                {
                                        if(PlayerInfo[playerid][pCarteiraT] == 1) return ErrorMsg(playerid, "Ya tienes carnet de trabajo");
                                        // FIX AUDIT LIC LIC-A2-05 (CRITICO): validar pRG e ImpuestoPendiente en Carnet de Trabajo.
                                        // ANTES: Carnet de Trabajo no validaba pRG (Documento de Identidad).
                                        // Documento oficial emitido sin documento de identidad = inconsistencia RP.
                                        // Tampoco validaba ImpuestoPendiente, bypass del bloqueo de cuenta bancaria.
                                        if(PlayerInfo[playerid][pRG] == 0) return ErrorMsg(playerid, "Necesitas tu Documento de Identidad (RG) para obtener el Carnet de Trabajo.");
                                        if(PlayerInfo[playerid][ImpuestoPendiente] > 0) return ErrorMsg(playerid, "No puedes obtener el Carnet de Trabajo con deuda fiscal pendiente. Paga primero.");
                                        PlayerInfo[playerid][pCarteiraT] = 1;
                                        SuccesMsg(playerid, "Has obtenido tu Carnet de Trabajo. Ahora puedes trabajar en empleos, ingresar a organizaciones, sacar licencias y recibir salario en el PayDay.");
                                        SalvarDados(playerid);
                                }
                                if(listitem == 2) // Pago de Impuestos
                                {
                                        // Calcular impuestos reales segun propiedades del jugador
                                        new impStr[1500], impLinea[256];
                                        new totalImp = 0;
                                        strcat(impStr, "{FFFF00}Concepto\t{FFFF00}Monto\n");
                                        // Auto (VeiculoCivil activo)
                                        if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID)
                                        {
                                                format(impLinea, sizeof(impLinea), "{FFFFFF}Impuesto de Auto\t{00FF00}$500\n");
                                                strcat(impStr, impLinea);
                                                totalImp += 500;
                                        }
                                        else
                                        {
                                                strcat(impStr, "{888888}Sin vehiculo registrado\t{888888}$0\n");
                                        }
                                        // Casa
                                        if(PlayerInfo[playerid][Casa] > 0)
                                        {
                                                format(impLinea, sizeof(impLinea), "{FFFFFF}Impuesto de Casa\t{00FF00}$1000\n");
                                                strcat(impStr, impLinea);
                                                totalImp += 1000;
                                        }
                                        else
                                        {
                                                strcat(impStr, "{888888}Sin casa registrada\t{888888}$0\n");
                                        }
                                        if(totalImp == 0)
                                        {
                                                return SuccesMsg(playerid, "No tienes propiedades registradas. No hay impuestos a pagar en este momento.");
                                        }
                                        format(impLinea, sizeof(impLinea), "{FFFF00}TOTAL A PAGAR\t{FF4444}$%d", totalImp);
                                        strcat(impStr, impLinea);
                                        SetPVarInt(playerid, "MontoImpuesto", totalImp);
                                        ShowPlayerDialog(playerid, DIALOG_AYU_IMPUESTOS, DIALOG_STYLE_TABLIST_HEADERS,
                                                "Ayuntamiento - Pago de Impuestos",
                                                impStr,
                                                "Pagar Todo", "Cancelar");
                                }
