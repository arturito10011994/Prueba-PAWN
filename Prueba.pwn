                                                        PlayerInfo[playerid][pMultas]);
                                                ShowPlayerDialog(playerid, DIALOG_AYU_PAGARMULTAS, DIALOG_STYLE_MSGBOX, "Ayuntamiento - Pago de Multas", multaStr, "PAGAR", "Cancelar");
