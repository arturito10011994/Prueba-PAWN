                                                format(deudaStr, sizeof(deudaStr),
                                                        "El Ayuntamiento de Estado le notifica:\n\nDeuda fiscal pendiente: {FF0000}$%d{FFFFFF}\nPayDays sin pagar: {FF0000}%d{FFFFFF}\n\nAl pagar se eliminara cualquier cargo policial activo\ny se desbloqueara su cuenta bancaria si estaba bloqueada.\n\n{FFFF00}Presione PAGAR para saldar su deuda.",
                                                        PlayerInfo[playerid][ImpuestoPendiente], PlayerInfo[playerid][ImpuestoPayDaysSinPagar]);
                                                ShowPlayerDialog(playerid, DIALOG_AYU_PAGARDEUDA, DIALOG_STYLE_MSGBOX, "Ayuntamiento - Deuda Fiscal", deudaStr, "PAGAR", "Cancelar");
                                        }
