                                if(!IsPlayerInVehicle(playerid, AutoEscolaMoto[playerid])) return 1;
                                new playerState = GetPlayerState(playerid);
                                if(playerState == PLAYER_STATE_DRIVER)
                                {
                                        new Float:Vida2;
                                        GetVehicleHealth(AutoEscolaMoto[playerid], Float:Vida2);
                                        if(Vida2 < 995) // Reprovado
                                        {
                                                RemovePlayerFromVehicle(playerid);
                                                new _examVehMoto = AutoEscolaMoto[playerid]; AutoEscolaMoto[playerid] = 0; if(IsValidVehicle(_examVehMoto)) DestroyVehicle(_examVehMoto); // FIX REVERT-AUDIT6-007-defensive

