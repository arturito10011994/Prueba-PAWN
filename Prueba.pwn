                                        // FIX AUDIT LIC LIC-MEJORAS-VERIFY FAIL-1: cleanup estado antes de return.
                                        AutoEscola_FlushPlayerEx(playerid);
                                        CofreGoverno -= costoAereoR;
                                        AC_AddPlayerMoney(playerid, costoAereoR);  // reembolsar
