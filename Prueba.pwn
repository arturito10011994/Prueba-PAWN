        {
                PlayerTextDrawHide(playerid, TDBienvenida[playerid][i]);
                PlayerTextDrawDestroy(playerid, TDBienvenida[playerid][i]);
        }
        TimerBienvenida[playerid] = 0;
}
CallBack::carregarobj(playerid)
{
        // FIX AUDIT ASSIGNJAILCELL: validar conexion antes de descongelar
        // (el carregarobj se usa en jail, spawn, teleport admin, hospitales, etc.)
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        TogglePlayerControllable(playerid, true);
        return 1;
}

// =====================================================================
// CAMBIO 2026-07-12 - Fase 4: Destruir helicoptero pendiente tras 2 min.
// Si el jugador no reconecto en 2 minutos, se destruye el vehiculo.
// =====================================================================
forward DestruirHeliPendiente(vehid);
public DestruirHeliPendiente(vehid)
{
    if(IsValidVehicle(vehid))
    {
        DestroyVehicle(vehid);
    }
    HeliPendienteVeh = INVALID_VEHICLE_ID;
    HeliPendienteNome[0] = EOS;
    return 1;
}

// =====================================================================
// CAMBIO 2026-07-12 - Fase 3: Timer para destruir helicoptero si no se usa.
// Se llama 2 minutos despues de spawnear el heli. Si el jugador no se subio
// (o ya se desconecto), se destruye el vehiculo y se libera el slot.
// =====================================================================
// FIX AUDIT MEDICO MED-A5-01: validar modelo antes de destruir.
// ANTES: si el paramedico se desconectaba con el heli spawneado, VeiculoCivil[N]
// se reseteaba a INVALID_VEHICLE_ID en disconnect, pero el timer seguia programado.
// SA-MP reusaba el slot N para otro jugador Q con su propio vehiculo W. A los 2 min
// el timer dispara sobre slot N (ahora INVALID), IsValidVehicle da false, NO destruye
// - PERO si por alguna razon VeiculoCivil[N] apunta a un vehiculo AJENO (race teorica
// o si disconnect no resetea correctamente), DestroyVehicle destruiria el vehiculo
// equivocado del nuevo jugador Q.
// AHORA: solo destruir si el modelo coincide con heli medico (563). Ademas limpiar
// la PVar HeliDestroyTimer.
forward DestruirHeliSiNoUso(playerid);
public DestruirHeliSiNoUso(playerid)
{
    // Limpiar PVar del timer (siempre, no solo si conectado)
    SetPVarInt(playerid, "HeliDestroyTimer", -1);
    // Si el jugador sigue conectado y NO esta en el helicoptero, destruirlo.
    if(IsPlayerConnected(playerid))
    {
        if(GetPlayerVehicleID(playerid) != VeiculoCivil[playerid])
        {
            // FIX MED-A5-01 + MEDICO-VERIFY-A2: validar modelo antes de DestroyVehicle.
            // Solo destruir si el vehiculo es efectivamente un helicoptero de org
            // (medico 563, police 497, FBI 487, military 425).
            // Si VeiculoCivil apunta a otro modelo (e.g., reuso de slot por otro sistema,
            // o una ambulancia 416), NO destruir - el vehiculo no es nuestro.
            if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID
               && IsValidVehicle(VeiculoCivil[playerid]))
            {
                new hm = GetVehicleModel(VeiculoCivil[playerid]);
                if(hm == 563 || hm == 487 || hm == 497 || hm == 425)
                {
                    DestroyVehicle(VeiculoCivil[playerid]);
                    VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
                    VehAlugado[playerid] = 0;
                    ErrorMsg(playerid, "El helicoptero de rescate fue destruido por falta de uso (2 minutos).");
                }
            }
        }
    }
    return 1;
}
stock bool:Radar_VehiculoExento(modelid)
{
        // Aviones
        if(modelid == 460 || modelid == 476 || modelid == 488 || modelid == 497 || modelid == 511 ||
           modelid == 512 || modelid == 513 || modelid == 519 || modelid == 520 || modelid == 553 ||
           modelid == 577 || modelid == 592 || modelid == 593)
                return true;

        // Helicopteros
        if(modelid == 417 || modelid == 425 || modelid == 447 || modelid == 469 || modelid == 487 ||
           modelid == 497 || modelid == 548 || modelid == 563)
                return true;

        // Barcos / lanchas
        if(modelid == 430 || modelid == 446 || modelid == 452 || modelid == 453 || modelid == 454 ||
           modelid == 472 || modelid == 473 || modelid == 493 || modelid == 595)
                return true;

        // Motos y bicicletas (no tiene sentido multarlas igual que un auto)
        if(modelid == 448 || modelid == 461 || modelid == 462 || modelid == 463 || modelid == 468 ||
           modelid == 471 || modelid == 481 || modelid == 509 || modelid == 510 || modelid == 521 ||
           modelid == 522 || modelid == 523 || modelid == 581 || modelid == 586)
                return true;

        return false;
}

CallBack::LiberarRadar(playerid)
{
        PassouRadar[playerid] = 0;
        return 1;
}

stock SendClientMessageToAdmins(color, const message[])
{
        // FIX AUDIT5 HIGH-05: for(MAX_PLAYERS) -> foreach (solo iterar slots conectados)
        foreach(new i : Player)
        {
                if(IsPlayerConnected(i) && PlayerInfo[i][pAdmin] >= 1)
                {
                        SendClientMessage(i, color, message);
                }
        }
        return 1;
}

stock Radar_TakePhoto(playerid, radarid, speed)
{
        new rname[MAX_PLAYER_NAME], rmsg[144];
        GetPlayerName(playerid, rname, sizeof(rname));
        format(rmsg, sizeof(rmsg), "[RADAR] FOTO CAPTURADA: %s | Radar %d | Velocidad: %d km/h", rname, radarid, speed);
        SendClientMessageToAdmins(0xFF0000FF, rmsg); // Solo a admins, no a todos los jugadores
        return 1;
}

stock Radar_AddLog(playerid, radarid, speed, multa)
{
        RadarLogs[LogIndex][LogPlayer] = playerid;
        RadarLogs[LogIndex][LogRadarID] = radarid;
        RadarLogs[LogIndex][LogSpeed] = speed;
        RadarLogs[LogIndex][LogMulta] = multa;
        RadarLogs[LogIndex][LogTime] = gettime();

        LogIndex++;
        if(LogIndex >= MAX_RADAR_LOGS) LogIndex = 0;
        return 1;
}

stock Radar_ShowAdminMap(playerid)
{
        if(PlayerInfo[playerid][pAdmin] < 1) return 0;
        if(RadarMapVisible[playerid]) return 1; // ya estan visibles

        new Account[255];
        for(new i; i < MAX_RADAR; i++)
        {
                format(Account, sizeof(Account), PASTA_RADAR, i);
                if(DOF2_FileExists(Account))
                {
                        RadarMapIcon[playerid][i] = CreateDynamicMapIcon(RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ], 52, 0, -1, -1, playerid, 300.0, MAPICON_LOCAL);
                }
        }
        RadarMapVisible[playerid] = true;
        return 1;
}

stock Radar_HideAdminMap(playerid)
{
        for(new i; i < MAX_RADAR; i++)
        {
                if(_:RadarMapIcon[playerid][i] != -1)
                {
                        DestroyDynamicMapIcon(RadarMapIcon[playerid][i]);
                        RadarMapIcon[playerid][i] = STREAMER_TAG_MAP_ICON:-1;
                }
        }
        RadarMapVisible[playerid] = false;
        return 1;
}

CallBack::AttVeh(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        if(IsPlayerInAnyVehicle(playerid))
        {
                new veiculoidb;
                veiculoidb = GetPlayerVehicleID(playerid);
                new Float:vhealth;
                GetVehicleHealth(veiculoidb, vhealth);
                if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                {
                        new vehicle = GetPlayerVehicleID(playerid);
                        new Float:vida;
                        GetVehicleHealth(vehicle, vida);
                        new vehicleid = GetPlayerVehicleID(playerid);
                        new engine, lights, alarm, doors, bonnet, boot, objective;
                        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
                        if(vida < 300.0)
                        {
                                GetVehicleParamsEx(vehicle,engine,lights,alarm,doors,bonnet,boot,objective);
                                SetVehicleParamsEx(vehicle,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
                                RepairCar[playerid] = GetPlayerVehicleID(playerid);
                                SetVehicleHealth(RepairCar[playerid], 299.0);
                                ShowErrorDialog(playerid, "Vehiculo averiado\nllama a un mecanico");
                                RemovePlayerFromVehicle(playerid);
                                return 1;
                        }
                }
        }
        return 1;
}

CallBack::CheckRadares(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
                return 1;

        new carid = GetVehicleModel(GetPlayerVehicleID(playerid));
        if(Radar_VehiculoExento(carid))
                return 1;

        for(new i; i < MAX_RADAR; i++)
        {
                if(IsPlayerInRangeOfPoint(playerid, 20.0, RadarInfo[i][RadarPosX], RadarInfo[i][RadarPosY], RadarInfo[i][RadarPosZ]))
                {
                        new Velocidad = VelocidadDoVeiculo(GetPlayerVehicleID(playerid));
                        if(Velocidad <= RadarInfo[i][RadarVelocidad])
                        {
                                if(PassouRadar[playerid] == 0)
                                {
                                        PassouRadar[playerid] = 1;
                                        SetTimerEx("LiberarRadar", segundos(2), false, "d", playerid);
                                }
                                continue; // revisa el siguiente radar en vez de cortar toda la funcion
                        }
                        else
                        {
                                if(PassouRadar[playerid] == 0)
                                {
                                        if(Patrulha[playerid] == true)
                                        {
                                                PassouRadar[playerid] = 1;
                                                SetTimerEx("LiberarRadar", segundos(2), false, "d", playerid);
                                        }
                                        else
                                        {
                                                new multaradar = randomEx(RadarInfo[i][RadarMultaMin], RadarInfo[i][RadarMultaMax]);
                                                new radarmsg[200];
                                                PassouRadar[playerid] = 1;
                                                GameTextForPlayer(playerid, "~n~ ~r~RADAR", 2000, 1);
                                                SetTimerEx("LiberarRadar", segundos(2), false, "d", playerid);
                                                PlayerPlaySound(playerid,1132,0.0,0.0,0.0);
                                                PlayerInfo[playerid][pMultas] += multaradar;
                                                // T2-1: Acumular puntos de licencia por multa de radar.
                                                // 1 punto por cada $500 de multa (min 1, max 4 para radares -
                                                // menor que multartransito porque el radar es automatico).
                                                // A los 12 puntos, licencia suspendida 24h.
                                                new puntosRadar = multaradar / 500;
                                                if(puntosRadar < 1) puntosRadar = 1;
                                                if(puntosRadar > 4) puntosRadar = 4;
                                                new puntosActuales = GetPVarInt(playerid, "T2_1_PuntosLicencia") + puntosRadar;
                                                SetPVarInt(playerid, "T2_1_PuntosLicencia", puntosActuales);
                                                format(radarmsg, sizeof(radarmsg), "[RADAR] Fuiste multado por exceso de velocidad: $%d (Iban a %d km/h, limite %d km/h). Puntos licencia: +%d (total %d/12)", multaradar, Velocidad, RadarInfo[i][RadarVelocidad], puntosRadar, puntosActuales);
                                                SendClientMessage(playerid, 0xFF0000FF, radarmsg);
                                                // Si llega a 12 puntos, CANCELAR licencia (debe sacar nueva en Escuela de Conduccion)
                                                if(puntosActuales >= 12)
                                                {
                                                        CancelarLicenciaConducir(playerid);
                                                        SendClientMessage(playerid, 0xFF0000FF, "| TRANSITO | Tu licencia de conducir fue CANCELADA por acumular 12 puntos (radares).");
                                                        SendClientMessage(playerid, 0xFF8C00FF, "| TRANSITO | Debes ir a la Escuela de Conduccion a sacar una nueva licencia haciendo el examen.");
                                                }
                                                Radar_TakePhoto(playerid, i, Velocidad);
                                                Radar_AddLog(playerid, i, Velocidad, multaradar);
                                        }
                                        // FIX LICENCIA-PERSONAL: detectar conducir sin licencia en radar.
                                        if(GetPVarInt(playerid, "DrivingNoLicense") == 1)
                                        {
                                                new offenses = GetPVarInt(playerid, "NoLicOffenses") + 1;
                                                SetPVarInt(playerid, "NoLicOffenses", offenses);
                                                new licMulta;
                                                new licMsg[256];
                                                if(offenses == 1) licMulta = 500;
                                                else if(offenses == 2) licMulta = 1500;
                                                else if(offenses == 3) licMulta = 3000;
                                                else licMulta = 5000;
                                                PlayerInfo[playerid][pMultas] += licMulta;
                                                format(licMsg, sizeof(licMsg), "| TRANSITO | Multa por conducir SIN LICENCIA: $%d (ofensa #%d). Saca tu licencia en la Escuela de Conduccion.", licMulta, offenses);
                                                SendClientMessage(playerid, 0xFF0000FF, licMsg);
                                        }
                                        return 1;
                                }
                        }
                }
        }
        return 1;
}

CallBack::SalvarPlantacao()
{
        new string[128];

        for(new m = 0; m < MAX_MACONHA; m++)
        {
                format(string, sizeof string, PASTA_PLANTACAO, m);
                if(DOF2_FileExists(string))DOF2_RemoveFile(string);
        }

        for(new m = 0; m < MAX_MACONHA; m++)
        {
                format(string, sizeof string, PASTA_PLANTACAO, m);
                if(!MaconhaInfo[m][PodeUsar])
                {
                        // FIX AUDIT7 BUG4: braces explicitas + no borrar label 3D al guardar
                        if(!DOF2_FileExists(string)) { DOF2_CreateFile(string); }
                        DOF2_SetString(string, "Dono", MaconhaInfo[m][Dono]);
                        DOF2_SetInt(string, "Crescida", MaconhaInfo[m][Crescida]);
                        DOF2_SetInt(string, "GramasProntas", MaconhaInfo[m][GramasProntas]);
                        DOF2_SetFloat(string, "MacX", MaconhaInfo[m][mX]);
                        DOF2_SetFloat(string, "MacY", MaconhaInfo[m][mY]);
                        DOF2_SetFloat(string, "MacZ", MaconhaInfo[m][mZ]);
                }
        }
        DOF2_SaveFile();
}
CallBack::CarregarPlantacao()
{
        new string[128];

        for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid++)
        {
                format(string, sizeof string, PASTA_PLANTACAO, maconhaid);
                if(DOF2_FileExists(string))
                {
                        format(MaconhaInfo[maconhaid][Dono], 24, "%s", DOF2_GetString(string, "Dono")); // FIX AUDIT3 FSI: defense-in-depth, evitar format string injection desde disco
                        MaconhaInfo[maconhaid][Crescida] = DOF2_GetInt(string, "Crescida");
                        MaconhaInfo[maconhaid][GramasProntas] = DOF2_GetInt(string, "GramasProntas");
                        MaconhaInfo[maconhaid][mX] = DOF2_GetFloat(string, "MacX");
                        MaconhaInfo[maconhaid][mY] = DOF2_GetFloat(string, "MacY");
                        MaconhaInfo[maconhaid][mZ] = DOF2_GetFloat(string, "MacZ");
                        MaconhaInfo[maconhaid][Object] = CreateDynamicObject(3409, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ]-0.6,0.0, 0.0, 0.0);
                        format(string, sizeof string, "Marihuana\nDueno: %s\nPlantacion ID: %d\nCreciendo: %d/%d\nGramos: %dg",
                        MaconhaInfo[maconhaid][Dono], maconhaid,MaconhaInfo[maconhaid][Crescida],Max_Crescida, MaconhaInfo[maconhaid][GramasProntas]);
                        MaconhaInfo[maconhaid][TT] = Create3DTextLabel(string, 0x1FF61F99, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ], 10.0, 0);
                        MaconhaInfo[maconhaid][PodeUsar]=false;
                }
        }
        printf("=> Planta??es                   : Carregadas");
}

CallBack::MaconhaColher(playerid, mac)
{
