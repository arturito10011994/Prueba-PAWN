        // porque /editarcofre usa EditDynamicObject (streamer), no EditObject (nativo).
        return 1;
}

public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
        if(pLogado[clickedplayerid] == true)
        {
                if(PlayerInfo[playerid][pAdmin] < 1)                                            return ErrorMsg(playerid, "No tienes permisos.");
                new megastrings[500], String2[500];
                format(String2,sizeof(String2), "{FFFFFF}Su vip: {FFFF00}%s\n{FFFFFF}Nombre: {FFFF00}%s{FFFFFF}({FFFF00}%04d{FFFFFF})\n{FFFFFF}Email: {FFFF00}%s\n{FFFFFF}Dispositivo: {FFFF00}%s\n", VIP(clickedplayerid),Name(clickedplayerid), GetPlayerIdfixo(clickedplayerid), PlayerInfo[clickedplayerid][pEmail],Dispositivo(clickedplayerid));
                strcat(megastrings, String2);
                format(String2,sizeof(String2), "{FFFFFF}T.Acumulado:{FFFF00} %s\n{FFFFFF}Coins:{FFFF00} %s\n{FFFFFF}Dinero:{FFFF00} %s\n", convertNumber(PlayerInfo[clickedplayerid][pSegundosJogados]), ConvertMoney(PlayerInfo[clickedplayerid][pCoins]), ConvertMoney(PlayerInfo[clickedplayerid][pDinheiro]));
                strcat(megastrings, String2);
                format(String2,sizeof(String2), "{FFFFFF}Banco:{FFFF00} %s\n{FFFFFF}Avisos:{FFFF00} %s\n{FFFFFF}Trabajo:{FFFF00} %s\n{FFFFFF}Org:{FFFF00} %s\n", ConvertMoney(PlayerInfo[clickedplayerid][pBanco]), ConvertMoney(PlayerInfo[clickedplayerid][pAvisos]),Profs(clickedplayerid),NomeOrg(clickedplayerid));
                strcat(megastrings, String2);
                format(String2,sizeof(String2), "{FFFFFF}Multas:{FFFF00} %s\n{FFFFFF}Casa ID:{FFFF00} %d\n{FFFFFF}CNH: {FFFF00}%s", ConvertMoney(PlayerInfo[clickedplayerid][pMultas]), PlayerInfo[clickedplayerid][Casa], temlicenca(clickedplayerid));
                strcat(megastrings, String2);
                ShowPlayerDialog(playerid, DIALOG_CMDRG,DIALOG_STYLE_MSGBOX,"Informacion de cuenta",megastrings,"X",#);
        }
        return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
        if(PlayerInfo[playerid][pAdmin] >= 4)
        {
            SetPVarFloat(playerid, "FindX", fX);
            SetPVarFloat(playerid, "FindY", fY);
            SetPVarFloat(playerid, "FindZ", fZ);
                ShowPlayerDialog(playerid, DIALOG_TELEPORTARMAP, DIALOG_STYLE_MSGBOX, "Teleporte Mapa", "Deseas ir al lugar que marcaste en el mapa?", #Sim, #Nao);
        }
        return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
        if(clickedid == TD_RG[23]){
                for(new r=0;r<24;r++){
                        TextDrawHideForPlayer(playerid, TD_RG[r]);
                        if(r == 24)break;
                }
                for(new r=0;r<6;r++){
                        PlayerTextDrawHide(playerid, RG_p[playerid][r]);
                        if(r == 6)break;
                }
                MostrandoRG[playerid] = false;
                CancelSelectTextDraw(playerid);
        }
        if(clickedid == TDCadastro[2]){
                new str[10];
                MostrandoMenu[playerid] = true;
                if(Page[playerid] < 46){
                        Page[playerid]++;
                }
                format(str,sizeof(str),"%d/46",Page[playerid]);
                PlayerTextDrawSetString(playerid, TDCadastro_p[playerid][6], str);
                TimerCad[playerid] = SetTimerEx("AttCad",100,false,"i",playerid);
                for(new i=0;i<7;i++){
                        PlayerTextDrawShow(playerid, TDCadastro_p[playerid][i]);
                        if(i == 7)break;
                }
        }
        if(clickedid == TDCadastro[3]){
                new str[10];
                MostrandoMenu[playerid] = true;
                if(Page[playerid] > 1){
                        Page[playerid]--;
                }
                format(str,sizeof(str),"%d/46",Page[playerid]);
                PlayerTextDrawSetString(playerid, TDCadastro_p[playerid][6], str);
                TimerCad[playerid] = SetTimerEx("AttCad",100,false,"i",playerid);
                for(new i=0;i<7;i++){
                        PlayerTextDrawShow(playerid, TDCadastro_p[playerid][i]);
                        if(i == 7)break;
                }
        }
        if(clickedid == TDCadastro[11]){
                PlayerInfo[playerid][pSexo] = 1;
                InfoMsg(playerid, "Usted escogio el Genero Masculino.");
        }
        if(clickedid == TDCadastro[12]){
                PlayerInfo[playerid][pSexo] = 2;
                InfoMsg(playerid, "Usted escogio el Genero Fememenino.");
        }
        if(clickedid == TDCadastro[14]){
                if(PlayerInfo[playerid][pSexo] == 0) return ErrorMsg(playerid, "Usted necesita escoger un sexo.");
                if(PlayerInfo[playerid][pSkin] == 0) return ErrorMsg(playerid, "Usted necesita escoger una aparencia.");
                for(new i=0;i<18;i++){
                        TextDrawHideForPlayer(playerid, TDCadastro[i]);
                        if(i == 18)break;
                }
                for(new i=0;i<7;i++){
                        // FIX AUDIT SPAWN S0-6: usar PlayerTextDrawHide en vez de PlayerTextDrawDestroy.
                        // Antes: SELECCIONAR hacia PlayerTextDrawDestroy en los 7 TDCadastro_p.
                        // Estos PTDs solo se crean en todastextdraw (OnPlayerConnect). Si se
                        // destruyen aqui, /mudarskin y /mudarskin2 (que reusan TDCadastro_p)
                        // quedan ROTOS: las llamadas PlayerTextDrawShow/SetString/SetPreviewModel
                        // sobre handles destruidos son silenciosamente no-op. /mudarskin funcionaba
                        // para jugadores con cuenta existente (no pasaron por SELECCIONAR) pero NO
                        // para jugadores recien registrados.
                        // Ahora: usar PlayerTextDrawHide (ocultar). Los PTDs siguen existiendo
                        // y /mudarskin puede mostrarlos otra vez cuando los necesite.
                        PlayerTextDrawHide(playerid, TDCadastro_p[playerid][i]);
                        if(i == 7)break;
                }
                DestroyActor(actorcad[playerid]);
                MostrandoMenu[playerid] = false;
                // FIX AUDIT SPAWN S2-10: resetear Page al completar seleccion.
                // Antes: Page[playerid] no se reseteaba entre SELECCIONAR y /mudarskin.
                // Si el jugador estaba en pagina 3 de 46, /mudarskin arrancaba en pagina 3.
                // Ahora: resetear a 0 (primera pagina) para que /mudarskin empiece limpio.
                Page[playerid] = 0;
                SalvarDadosSkin(playerid);
                SuccesMsg(playerid, "Ya su cuenta esta registrada felicidades.");
                format(Str, sizeof(Str), "te deseo la mejor bienvenida, %s.\nPara Entrar al servidor coloque su contraseca abajo.", Name(playerid));
                ShowPlayerDialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_PASSWORD, "Sea Bienvenido al servidor...", Str, "Login", "Cancelar"); // FIX AUDIT4 HIGH-DBG-6: password masked
        }
        if(clickedid == Text:INVALID_TEXT_DRAW)
        {
                for(new i = 0; i < 40; ++i)
                {
                        PlayerTextDrawHide(playerid, DrawInv[playerid][i]);
                        if(i == 40)break;
                }
                InventarioAberto[playerid] = 0;
                // FIX AUDIT SPAWN S1-6: cleanup de seleccion de personaje si ESC.
                // Antes: si el jugador presionaba ESC durante la seleccion de personaje,
                // el handler solo limpiaba DrawInv (inventario). NO limpiaba los 18
                // TDCadastro globales, los 7 TDCadastro_p personales, actorcad,
                // MostrandoMenu, ni la camara. El jugador quedaba en soft-lock:
                // no podia progresar, solo desconectarse.
                // Ahora: si MostrandoMenu es true, limpiar TODO el estado de seleccion.
                if(MostrandoMenu[playerid])
                {
                        for(new i = 0; i < 18; i++) TextDrawHideForPlayer(playerid, TDCadastro[i]);
                        for(new i = 0; i < 7; i++) PlayerTextDrawHide(playerid, TDCadastro_p[playerid][i]);
                        if(actorcad[playerid] > 0) { DestroyActor(actorcad[playerid]); actorcad[playerid] = 0; }
                        MostrandoMenu[playerid] = false;
                        SetCameraBehindPlayer(playerid);
                        CancelSelectTextDraw(playerid);
                        InfoMsg(playerid, "Seleccion cancelada. Debes elegir un personaje para continuar.");
                }
                // FIX AUDIT RG RG-A1-05/RG-A3-03 (CRITICO): cleanup RG al presionar ESC.
                // ANTES: si el jugador presionaba ESC durante /rg (SelectTextDraw activo),
                // SA-MP auto-cancela SelectTextDraw y dispara este handler. Pero NO limpiaba
                // MostrandoRG ni ocultaba TD_RG. El jugador quedaba en soft-lock: TDs visibles,
                // MostrandoRG=true bloqueaba /rg de nuevo. Ahora: cleanup completo.
                if(MostrandoRG[playerid])
                {
                        for(new r=0;r<24;r++) TextDrawHideForPlayer(playerid, TD_RG[r]);
                        for(new r=0;r<6;r++) PlayerTextDrawHide(playerid, RG_p[playerid][r]);
                        MostrandoRG[playerid] = false;
                        CancelSelectTextDraw(playerid);
                }
                return 1;
        }
        return 0;
}

public ClickDynamicPlayerTextdraw(playerid, PlayerText:playertextid)
{
        new str[64], File[255];

        // Boton ACEPTAR de la pantalla de aviso inicial
        if(playertextid == Alertalogin[playerid][11])
        {
                CancelSelectTextDraw(playerid);
                for(new t=0;t<12;t++){
                        PlayerTextDrawHide(playerid, Alertalogin[playerid][t]);
                }
                // FIX AUDIT LOGIN F1-8: trackear ID del timer loginp.
                g_loginpTimer[playerid] = SetTimerEx("loginp", 100, false, "i", playerid);
                return 1;
        }

        if(playertextid == RadioVOIP[playerid][29])
        {
                format(Str, sizeof(Str),"Ingresa la frecuencia que deseas usar");
                ShowPlayerDialog(playerid,DIALOG_RADIOFREQ,1,"Inserindo frequencia", Str, "Seleccionar","X");
        }
        if(playertextid == BancoTD[playerid][8])
        {
                format(Str, sizeof(Str),"Ingresa el IDF para transferir el dinero");
                ShowPlayerDialog(playerid,DIALOG_BANCO4,1,"Transferir", Str, "Seleccionar","X");
        }
        if(playertextid == BancoTD[playerid][25])
        {
                for(new i; i < 34; i++)
                {
                        PlayerTextDrawHide(playerid, BancoTD[playerid][i]);
                        if(i == 34)break;
                }
                CancelSelectTextDraw(playerid);
                new BankV[255];
                SetPVarInt(playerid, "QtdTransacao", 0);
                ModoTransacao[playerid] = 0;
                format(BankV, sizeof(BankV), "Coloque la cantidad");
                PlayerTextDrawSetString(playerid, BancoTD[playerid][28], BankV);
        }
        if(playertextid == BancoTD[playerid][6])
        {
                ModoTransacao[playerid] = 1;
                InfoMsg(playerid, "Usted selecciono la opcion de retiro.");
        }
        if(playertextid == BancoTD[playerid][7])
        {
                ModoTransacao[playerid] = 2;
                InfoMsg(playerid, "Usted selecciono la opcion de deposito.");
        }
        if(playertextid == BancoTD[playerid][21])
        {
                if(PlayerInfo[playerid][BancoBloqueado] == 1) return ErrorMsg(playerid, "AYUNTAMIENTO: Tu cuenta bancaria esta BLOQUEADA por deuda fiscal. Ve al Ayuntamiento a pagar tu deuda para desbloquearla.");
                if(ModoTransacao[playerid] == 0)                        return ErrorMsg(playerid, "Debes seleccionar la operacion.");
                if(ModoTransacao[playerid] == 1)
                {
                        if(CofreBanco < GetPVarInt(playerid, "QtdTransacao"))                   return ErrorMsg(playerid, "El banco no tiene el valor requerido.");
                        if(PlayerInfo[playerid][pBanco] < GetPVarInt(playerid, "QtdTransacao"))                         return ErrorMsg(playerid, "Dinero insuficiente.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, GetPVarInt(playerid, "QtdTransacao"));
                        PlayerInfo[playerid][pBanco] -= GetPVarInt(playerid, "QtdTransacao");
                        CofreBanco -= GetPVarInt(playerid, "QtdTransacao");
                        // FIX AUDIT2 AGENT2 M-18 (1/5): SalvarDados inmediato tras
                        // retiro. El pBanco del jugador se persiste via SalvarDados.
                        // Sin esto, si crash antes del SaveTimer, el retiro se
                        // revierte (jugador recupera el saldo bancario en disco).
                        SalvarDados(playerid);
                        SuccesMsg(playerid, "Transaccion realizada.");
                        SalvarDinRoubos();
                }
                if(ModoTransacao[playerid] == 2)
                {
                        if(PlayerInfo[playerid][pDinheiro] < GetPVarInt(playerid, "QtdTransacao"))                      return ErrorMsg(playerid, "Dinero insuficiente.");
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -GetPVarInt(playerid, "QtdTransacao"));
                        PlayerInfo[playerid][pBanco] += GetPVarInt(playerid, "QtdTransacao");
                        CofreBanco += GetPVarInt(playerid, "QtdTransacao");
                        // FIX AUDIT2 AGENT2 M-18 (2/5): SalvarDados inmediato tras
                        // deposito. El pBanco del jugador se persiste via SalvarDados.
                        // Sin esto, si crash antes del SaveTimer, el deposito se
                        // revierte (jugador pierde el saldo bancario acreditado).
                        SalvarDados(playerid);
                        SuccesMsg(playerid, "Transaccion realizada.");
                        SalvarDinRoubos();
                }
        }
        if(playertextid == BancoTD[playerid][31])
        {
                if(PlayerInfo[playerid][BancoBloqueado] == 1) return ErrorMsg(playerid, "AYUNTAMIENTO: Tu cuenta bancaria esta BLOQUEADA por deuda fiscal. Ve al Ayuntamiento a pagar.");
                if(CofreBanco < 50000)                  return ErrorMsg(playerid, "El banco no consigue retirar la cantidad requerida.");
                if(PlayerInfo[playerid][pBanco] < 50000)                        return ErrorMsg(playerid, "Dinero insuficiente.");
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                AC_AddPlayerMoney(playerid, 50000);
                PlayerInfo[playerid][pBanco] -= 50000;
                CofreBanco -= 50000;
                // FIX AUDIT2 AGENT2 M-18 (3/5): SalvarDados tras retiro $50.000.
                // Sin esto, si crash antes del SaveTimer, el retiro se revierte
                // (jugador recupera el saldo bancario en disco).
                SalvarDados(playerid);
                SuccesMsg(playerid, "Retiro realizado.");
                SalvarDinRoubos();
        }
        if(playertextid == BancoTD[playerid][32])
        {
                if(PlayerInfo[playerid][BancoBloqueado] == 1) return ErrorMsg(playerid, "AYUNTAMIENTO: Tu cuenta bancaria esta BLOQUEADA por deuda fiscal. Ve al Ayuntamiento a pagar.");
                if(CofreBanco < 100000)                         return ErrorMsg(playerid, "El banco no consigue retirar la cantidad requerida.");
                if(PlayerInfo[playerid][pBanco] < 100000)                       return ErrorMsg(playerid, "Dinero insuficiente.");
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                AC_AddPlayerMoney(playerid, 100000);
                PlayerInfo[playerid][pBanco] -= 100000;
                CofreBanco -= 100000;
                // FIX AUDIT2 AGENT2 M-18 (4/5): SalvarDados tras retiro $100.000.
                // Sin esto, si crash antes del SaveTimer, el retiro se revierte
                // (jugador recupera el saldo bancario en disco).
                SalvarDados(playerid);
                SuccesMsg(playerid, "Retiro realizado.");
                SalvarDinRoubos();
        }
        if(playertextid == BancoTD[playerid][33])
        {
                if(PlayerInfo[playerid][BancoBloqueado] == 1) return ErrorMsg(playerid, "AYUNTAMIENTO: Tu cuenta bancaria esta BLOQUEADA por deuda fiscal. Ve al Ayuntamiento a pagar.");
                if(CofreBanco < 5000)                   return ErrorMsg(playerid, "El banco no consigue retirar la cantidad requerida.");
                if(PlayerInfo[playerid][pBanco] < 5000)                         return ErrorMsg(playerid, "Dinero insuficiente.");
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                AC_AddPlayerMoney(playerid, 5000);
                PlayerInfo[playerid][pBanco] -= 5000;
                CofreBanco -= 5000;
                // FIX AUDIT2 AGENT2 M-18 (5/5): SalvarDados tras retiro $5.000.
                // Sin esto, si crash antes del SaveTimer, el retiro se revierte
                // (jugador recupera el saldo bancario en disco).
                SalvarDados(playerid);
                SuccesMsg(playerid, "Retiro realizado.");
                SalvarDinRoubos();
        }
        if(playertextid == BancoTD[playerid][28])
        {
                if(ModoTransacao[playerid] == 0)                        return ErrorMsg(playerid, "Debes seleccionar la operacion.");
                ShowPlayerDialog(playerid, DIALOG_VALORTRANSACAO, DIALOG_STYLE_INPUT, "Coloque la cantidad", "Coloque la cantidad para hacer una operacion seleccionada.", "Confirmar", "X");
        }
        if(playertextid == BancoTD[playerid][22])
        {
                new BankV[255];
                SetPVarInt(playerid, "QtdTransacao", 0);
                ModoTransacao[playerid] = 0;
                format(BankV, sizeof(BankV), "COLOQUE LA CANTIDAD");
                PlayerTextDrawSetString(playerid, BancoTD[playerid][28], BankV);
        }
        if(playertextid == TDCadastro_p[playerid][0]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][0];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][0]);
                InfoMsg(playerid,  str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][0], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TDCadastro_p[playerid][1]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][1];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][1]);
                InfoMsg(playerid, str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][1], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TDCadastro_p[playerid][2]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][2];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][2]);
                InfoMsg(playerid, str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][2], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TDCadastro_p[playerid][3]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][3];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][3]);
                InfoMsg(playerid, str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][3], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TDCadastro_p[playerid][4]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][4];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][4]);
                InfoMsg(playerid, str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][4], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TDCadastro_p[playerid][5]){
                PlayerInfo[playerid][pSkin] = Preview[playerid][5];
                SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
                format(str,sizeof(str),"Usted escogio la aparencia de id %d.",Preview[playerid][5]);
                InfoMsg(playerid, str);
                DestroyActor(actorcad[playerid]);
                actorcad[playerid] = CreateActor(Preview[playerid][5], 1984.0140,1194.2424,26.8835,135.6409);
                SetActorInvulnerable(actorcad[playerid], true);
        }
        if(playertextid == TxtLoginCDA[playerid][21])
        {
                // FIX AUDIT LOGIN F0-5: re-validar ban al hacer click en ACEPTAR.
                // Antes: loginp() validaba ban al mostrar la pantalla inicial,
                // pero si el ban se emitia entre la validacion de loginp y el
                // click en ACEPTAR, el jugador podia loguear igual. Ahora
                // re-validamos ban por cuenta y ban por IP aqui tambien
                // (defense in depth).
                format(File, sizeof(File), PASTA_BANIDOS, Name(playerid));
                if(DOF2_FileExists(File) && gettime() <= DOF2_GetInt(File, "DDesban"))
                {
                        // Ban por cuenta vigente: mostrar dialog de baneado y kick.
                        new StrM[450];
                        strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANEADO{FFFFFF} -x-x-x-x-x-\n\nEsta cuenta esta baneada de este servidor !\n\n{FFA500}Cuenta:{E64022} ");
                        strcat(StrM, Name(playerid));
                        strcat(StrM, "\n{FFFF00}Administrador:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Administrador"));
                        strcat(StrM, "\n{FFFF00}Motivo:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Motivo"));
                        strcat(StrM, "\n\n{FFFFFF}Si lo considera un error, entre a nuestro discord\n{FFFF00}\t\t*******{FFFFFF}");
                        strcat(StrM, SERVERFORUM);
                        strcat(StrM, "{FFFF00}*******");
                        ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                        Kick(playerid);
                        return 0;
                }
                format(File, sizeof(File), PASTA_BANIDOSIP, GetPlayerIpEx(playerid));
                if(DOF2_FileExists(File))
                {
                        // Ban por IP vigente: mostrar dialog de baneado y kick.
                        new StrM[450];
                        strcat(StrM, "\t\t{FFFFFF}-x-x-x-x-x- {FFFF00}BANIDO{FFFFFF} -x-x-x-x-x-\n\nEste IP esta banido no servidor. !\n\n{FFFF00}IP:{FFFFFF} ");
                        strcat(StrM, GetPlayerIpEx(playerid));
                        strcat(StrM, "\n{FFFF00}Administrador:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Administrador"));
                        strcat(StrM, "\n{FFFF00}Motivo:{FFFFFF} ");
                        strcat(StrM, DOF2_GetString(File, "Motivo"));
                        strcat(StrM, "\n\nSe considera um erro, entre em nosso discord\n{FFFF00}\t\t*******{FFFFFF}");
                        strcat(StrM, SERVERFORUM);
                        strcat(StrM, "{FFFF00}*******");
                        ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "BANIDO:", StrM, "X", "");
                        Kick(playerid);
                        return 0;
                }
                // No baneado: proceder con login/registro normal.
                format(File, sizeof(File), PASTA_CONTAS, Name(playerid));
                if(DOF2_FileExists(File))
                {
                        FirstLogin[playerid] = false;
                        format(Str, sizeof(Str), "Hola bienvenido nuevamente, %s.\nPara Entrar al servidor coloque su contraseÃ¯Â¿Â½a abajo.", Name(playerid));
                        ShowPlayerDialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_PASSWORD, "Bienvenido de nuevo", Str, "Ingresar", "X"); // FIX AUDIT4 HIGH-DBG-6: password masked
                        return 0;
                }
                else
                {
                        FirstLogin[playerid] = true;
                        format(Str, sizeof(Str), "Sea bienvenido a nuestro servidor servidor, %s!\nPara crear su cuenta coloque su contraseÃ¯Â¿Â½a abajo.\n*Su contra debe contener entre 4 a 20 caracteres.", Name(playerid));
                        ShowPlayerDialog(playerid, DIALOG_REGISTRO, DIALOG_STYLE_PASSWORD, "Bienvenido", Str, "Crear", "X"); // FIX AUDIT4 HIGH-DBG-6: password masked
                        return 0;
                }
        }
        if(playertextid == TxtLoginCDA[playerid][22])
        {
                
        }
        for(new i = 1; i < 33; ++i)
        {
                if(playertextid == DrawInv[playerid][i])
                {
                        if(PlayerInventario[playerid][i][Slot] == -1)
                        {
                                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], "");
                        }
                        else
                        {
                                format(str, sizeof(str), "%s - %s unidades", ItemNomeInv(PlayerInventario[playerid][i][Slot]), ConvertMoney(PlayerInventario[playerid][i][Unidades]));
                                PlayerTextDrawSetString(playerid, DrawInv[playerid][38], str);
                        }
                        PlayerTextDrawShow(playerid, DrawInv[playerid][38]);
                        SetPVarInt(playerid, #VarSlotInv, i);
                        return 1;
                }
                if(i == 32)break; // FIX AUDIT INV I0-6: era 31, slot 32 inalcanzable
        }
        if(playertextid == DrawInv[playerid][36]) return ShowPlayerDialog(playerid, DIALOG_QTDINV, DIALOG_STYLE_INPUT, "Coloque la cantidad", "Coloque la cantidad para utilizar/soltar el item del inventario.", "Confirmar", "X");
        if(playertextid == DrawInv[playerid][35]) return cmd_inventario(playerid);
        if(playertextid == DrawInv[playerid][37]) return FuncaoItens(playerid, GetPVarInt(playerid, #VarSlotInv),qtdinv[playerid]);
        if(playertextid == DrawInv[playerid][39]) return DroparItem(playerid, GetPVarInt(playerid, #VarSlotInv),qtdinv[playerid]);
        if(playertextid == HudCop[playerid][3])
        {
                PlayerTextDrawHide(playerid, CopGuns[playerid][0]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][1]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][2]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][3]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][4]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][5]);
                PlayerTextDrawHide(playerid, HudCop[playerid][0]);
                PlayerTextDrawHide(playerid, HudCop[playerid][1]);
                PlayerTextDrawHide(playerid, HudCop[playerid][2]);
                PlayerTextDrawHide(playerid, HudCop[playerid][3]);
                CancelSelectTextDraw(playerid);
        }
        if(playertextid == CopGuns[playerid][5])
        {
                PlayerTextDrawHide(playerid, CopGuns[playerid][0]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][1]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][2]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][3]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][4]);
                PlayerTextDrawHide(playerid, CopGuns[playerid][5]);
                PlayerTextDrawHide(playerid, HudCop[playerid][0]);
                PlayerTextDrawHide(playerid, HudCop[playerid][1]);
                PlayerTextDrawHide(playerid, HudCop[playerid][2]);
                PlayerTextDrawHide(playerid, HudCop[playerid][3]);
                CancelSelectTextDraw(playerid);
        }
        if(playertextid == HudCop[playerid][0])
        {
                if(Patrulha[playerid] == false)
                {
                        Patrulha[playerid] = true;
                        SuccesMsg(playerid, "Usted comenzo el servicio");
                        SalvarArmas(playerid);
                        ResetPlayerWeapons(playerid);
                        policiaon ++;
                        SetPlayerColor(playerid, 0x0012FFFF);
                        SetPlayerHealth(playerid, 100);
                        // P1-PN-4: iniciar timer anti-AFK al entrar en servicio
                        StartPatrulhaAFKTimer(playerid);
                        // P1-FBI-2: auto-reset modo encubierto al entrar en servicio
                        if(g_FBIEncubierto[playerid] == true)
                        {
                                g_FBIEncubierto[playerid] = false;
                                PlayerInfo[playerid][pEncubierto] = false;
                                printf("[P1-FBI-2] FBI ID %d (%s) auto-reset encubierto al entrar en servicio.", playerid, Name(playerid));
                        }
                        // P1-PN-5: Equipamiento de Policia Nacional por rango.
                        // Antes: TODOS los rangos recibian las mismas armas (Pistola+Escopeta+MP5).
                        // Ahora: equipamiento escalado por rango para incentivar ascenso y diferenciar jerarquia.
                        //
                        //   Rango 1 (Oficial):   Pistola 9mm + Nightstick + Esposas
                        //   Rango 2 (Sargento):  Pistola 9mm + Nightstick + Esposas + Escopeta
                        //   Rango 3 (Teniente):  Pistola 9mm + Nightstick + Esposas + Escopeta + MP5
                        //   Rango 4 (Capitan):   Desert Eagle + Nightstick + Esposas + Escopeta + MP5
                        //   Rango 5 (Comisario): Desert Eagle + Nightstick + Esposas + Escopeta + MP5 + Sniper
                        //
                        // Skins femeninos por rango en PN (antes era aleatorio entre 148/192 sin distinguir cargo).
                        // Skins femeninos formales elegidos para transmitir autoridad:
                        //   PN: 93=Oficial, 192=Sargento, 211=Teniente, 150=Capitan, 233=Comisario
                        // Otras orgs mantienen skinsfem[] aleatorio (148, 192) por compatibilidad.
                        if(PlayerInfo[playerid][pSexo] == 2)
                        {
                                new org2fem = PlayerInfo[playerid][Org];
                                new cargo2fem = PlayerInfo[playerid][Cargo];
                                if(org2fem == 1) // Policia Nacional - skins femeninos por rango
                                {
                                        if(cargo2fem == 1)      SetPlayerSkin(playerid, 93);
                                        else if(cargo2fem == 2) SetPlayerSkin(playerid, 192);
                                        else if(cargo2fem == 3) SetPlayerSkin(playerid, 211);
                                        else if(cargo2fem == 4) SetPlayerSkin(playerid, 150);
                                        else if(cargo2fem == 5) SetPlayerSkin(playerid, 233);
                                        else                    SetPlayerSkin(playerid, 93); // fallback
                                }
                                else if(org2fem == 3) // FBI - skins femeninos por rango
                                {
                                        if(cargo2fem == 1)      SetPlayerSkin(playerid, 211);  // Agente Encubierto
                                        else if(cargo2fem == 2) SetPlayerSkin(playerid, 150);  // Agente Especial
                                        else if(cargo2fem == 3) SetPlayerSkin(playerid, 233);  // Supervisor
                                        else if(cargo2fem == 4) SetPlayerSkin(playerid, 93);    // Jefe Division
                                        else if(cargo2fem == 5) SetPlayerSkin(playerid, 192);  // Director
                                        else                    SetPlayerSkin(playerid, 211); // fallback
                                }
                                else if(org2fem == 4) // SWAT - skins femeninos por rango
                                {
                                        if(cargo2fem == 1)      SetPlayerSkin(playerid, 93);    // Operador
                                        else if(cargo2fem == 2) SetPlayerSkin(playerid, 211);   // Tirador Selecto
                                        else if(cargo2fem == 3) SetPlayerSkin(playerid, 233);   // Comandante Tactico
                                        else                    SetPlayerSkin(playerid, 93);    // fallback
                                }
                                else if(org2fem == 14) // Ejercito - skins femeninos por rango
                                {
                                        if(cargo2fem == 1)      SetPlayerSkin(playerid, 192);  // Soldado
                                        else if(cargo2fem == 2) SetPlayerSkin(playerid, 211);  // Sargento
                                        else if(cargo2fem == 3) SetPlayerSkin(playerid, 93);    // Teniente
                                        else if(cargo2fem == 4) SetPlayerSkin(playerid, 150);  // Capitan
                                        else if(cargo2fem == 5) SetPlayerSkin(playerid, 233);  // Coronel
                                        else if(cargo2fem == 6) SetPlayerSkin(playerid, 211);  // General
                                        else                    SetPlayerSkin(playerid, 192);  // fallback
                                }
                                else
                                {
                                        new skinsfem[] = {148, 192};
                                        SetPlayerSkin(playerid, skinsfem[random(2)]);
                                }
                        }
                        else
                        {
                                new org2 = PlayerInfo[playerid][Org];
                                new cargo2 = PlayerInfo[playerid][Cargo];
                                // Transito
                                if(org2 == 2)
                                {
                                        if(cargo2 == 1) SetPlayerSkin(playerid, 71);
                                        else if(cargo2 == 2) SetPlayerSkin(playerid, 265);
                                        else if(cargo2 == 3) SetPlayerSkin(playerid, 284);
                                }
                                // Policia Nacional
                                else if(org2 == 1)
                                {
                                        if(cargo2 == 1) SetPlayerSkin(playerid, 266);
                                        else if(cargo2 == 2) SetPlayerSkin(playerid, 267);
                                        else if(cargo2 == 3) SetPlayerSkin(playerid, 280);
                                        else if(cargo2 == 4) SetPlayerSkin(playerid, 281);
                                        else if(cargo2 == 5) SetPlayerSkin(playerid, 283);
                                }
                                // FBI (5 rangos) - skins masculinos por rango
                                else if(org2 == 3)
                                {
                                        if(cargo2 == 1)      SetPlayerSkin(playerid, 208);  // Agente Encubierto
                                        else if(cargo2 == 2) SetPlayerSkin(playerid, 165);  // Agente Especial
                                        else if(cargo2 == 3) SetPlayerSkin(playerid, 163);  // Supervisor
                                        else if(cargo2 == 4) SetPlayerSkin(playerid, 164);  // Jefe Division
                                        else if(cargo2 == 5) SetPlayerSkin(playerid, 286);  // Director
                                }
                                // SWAT - skins tacticos militares
                                else if(org2 == 4)
                                {
                                        if(cargo2 == 1)      SetPlayerSkin(playerid, 285); // Operador: Military Police (tactico negro)
                                        else if(cargo2 == 2) SetPlayerSkin(playerid, 282); // Tirador Selecto: Sarge (operativo avanzado)
                                        else if(cargo2 == 3) SetPlayerSkin(playerid, 288); // Comandante Tactico: General (lider)
                                }
                                // Ejercito
                                else if(org2 == 14)
                                {
                                        if(cargo2 >= 1 && cargo2 <= 4) SetPlayerSkin(playerid, 287);
                                        else if(cargo2 == 5) SetPlayerSkin(playerid, 282);
                                        else if(cargo2 == 6) SetPlayerSkin(playerid, 288);
                                }
                        }
                        // Armar segun org
                        ResetPlayerWeapons(playerid);
                        SetPlayerArmour(playerid, 100);
                        new orgA = PlayerInfo[playerid][Org];
                        new cargoA = PlayerInfo[playerid][Cargo];
                        // Transito: pistola + nightstick + esposas
                        if(orgA == 2) { GivePlayerWeapon(playerid, 22, 150); GivePlayerWeapon(playerid, 3, 1); GivePlayerWeapon(playerid, 1, 1); }
                        // P1-PN-5: Policia Nacional - equipamiento escalado por rango
                        else if(orgA == 1)
                        {
                                new cargoPN_a = cargoA;
                                // Todos los rangos: Nightstick + Esposas (herramientas basicas)
                                GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                                GivePlayerWeapon(playerid, 1, 1);   // Esposas
                                if(cargoPN_a == 1) // Oficial: solo pistola 9mm
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                }
                                else if(cargoPN_a == 2) // Sargento: pistola + escopeta
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                        GivePlayerWeapon(playerid, 25, 70);
                                }
                                else if(cargoPN_a == 3) // Teniente: pistola + escopeta + MP5
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                        GivePlayerWeapon(playerid, 25, 70);
                                        GivePlayerWeapon(playerid, 29, 200);
                                }
                                else if(cargoPN_a == 4) // Capitan: Desert Eagle + escopeta + MP5
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 25, 70);
                                        GivePlayerWeapon(playerid, 29, 200);
                                }
                                else // Comisario (5+): Desert Eagle + escopeta + MP5 + Sniper
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 25, 70);
                                        GivePlayerWeapon(playerid, 29, 200);
                                        GivePlayerWeapon(playerid, 34, 20);
                                }
                        }
                        // P1-FBI-1: FBI - equipamiento escalado por rango (5 rangos)
                        // Filosofia: arma silenciada como distintivo FBI, escalado progresivo
                        //   Rango 1 (Agente Encubierto): Silenced + MP5 + Nightstick + Esposas
                        //   Rango 2 (Agente Especial):   Silenced + MP5 + Rifle + Nightstick + Esposas
                        //   Rango 3 (Supervisor):        Silenced + MP5 + Rifle + Escopeta + Nightstick + Esposas
                        //   Rango 4 (Jefe Division):     Combat Pistol + MP5 + Rifle + Sniper + Nightstick + Esposas
                        //   Rango 5 (Director):          Desert Eagle + MP5 + Rifle + Sniper + Nightstick + Esposas
                        else if(orgA == 3)
                        {
                                new cargoFBI_a = cargoA;
                                GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                                GivePlayerWeapon(playerid, 1, 1);   // Esposas
                                if(cargoFBI_a == 1) // Agente Encubierto
                                {
                                        GivePlayerWeapon(playerid, 23, 50);
                                        GivePlayerWeapon(playerid, 29, 150);
                                }
                                else if(cargoFBI_a == 2) // Agente Especial
                                {
                                        GivePlayerWeapon(playerid, 23, 50);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 33, 40);
                                }
                                else if(cargoFBI_a == 3) // Supervisor
                                {
                                        GivePlayerWeapon(playerid, 23, 50);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 33, 40);
                                        GivePlayerWeapon(playerid, 25, 40);
                                }
                                else if(cargoFBI_a == 4) // Jefe Division
                                {
                                        GivePlayerWeapon(playerid, 24, 50);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 33, 40);
                                        GivePlayerWeapon(playerid, 34, 20);
                                }
                                else // Director (5+)
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 33, 40);
                                        GivePlayerWeapon(playerid, 34, 20);
                                }
                        }
                        // SWAT: base + sniper solo Director
                        // P1-SWAT-1: equipamiento escalado por rango (3 rangos)
                        // Filosofia: unidad tactica de elite, armamento pesado desde el inicio
                        //   Rango 1 (Operador):         Combat Pistol + MP5 + M4 + Nightstick + Esposas
                        //   Rango 2 (Tirador Selecto): Combat Pistol + MP5 + M4 + Escopeta + Nightstick + Esposas
                        //   Rango 3 (Comandante):      Desert Eagle + MP5 + M4 + Sniper + Nightstick + Esposas
                        else if(orgA == 4)
                        {
                                new cargoSWAT_a = cargoA;
                                GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                                GivePlayerWeapon(playerid, 1, 1);   // Esposas
                                if(cargoSWAT_a == 1) // Operador
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 31, 150);
                                }
                                else if(cargoSWAT_a == 2) // Tirador Selecto
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 31, 150);
                                        GivePlayerWeapon(playerid, 25, 70);
                                }
                                else // Comandante Tactico (3+)
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 31, 150);
                                        GivePlayerWeapon(playerid, 34, 20);
                                }
                        }
                        // P1-EJ-2: Ejercito - equipamiento escalado por rango (6 rangos)
                        // Filosofia: fuerza militar, armamento pesado y progresivo
                        //   Rango 1 (Soldado):    Pistola 9mm + M4 + Nightstick + Esposas
                        //   Rango 2 (Sargento):   Pistola 9mm + Escopeta + M4 + Nightstick + Esposas
                        //   Rango 3 (Teniente):   Pistola 9mm + Escopeta + M4 + MP5 + Nightstick + Esposas
                        //   Rango 4 (Capitan):    Combat Pistol + Escopeta + M4 + MP5 + Nightstick + Esposas
                        //   Rango 5 (Coronel):    Desert Eagle + Escopeta + M4 + MP5 + Sniper + Nightstick + Esposas
                        //   Rango 6 (General):    Desert Eagle + Escopeta + M4 + MP5 + Sniper + Nightstick + Esposas
                        else if(orgA == 14)
                        {
                                new cargoEJ_a = cargoA;
                                GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                                GivePlayerWeapon(playerid, 1, 1);   // Esposas
                                if(cargoEJ_a == 1) // Soldado
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                        GivePlayerWeapon(playerid, 31, 150);
                                }
                                else if(cargoEJ_a == 2) // Sargento
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                        GivePlayerWeapon(playerid, 25, 50);
                                        GivePlayerWeapon(playerid, 31, 150);
                                }
                                else if(cargoEJ_a == 3) // Teniente
                                {
                                        GivePlayerWeapon(playerid, 22, 50);
                                        GivePlayerWeapon(playerid, 25, 50);
                                        GivePlayerWeapon(playerid, 31, 150);
                                        GivePlayerWeapon(playerid, 29, 150);
                                }
                                else if(cargoEJ_a == 4) // Capitan
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 25, 50);
                                        GivePlayerWeapon(playerid, 31, 150);
                                        GivePlayerWeapon(playerid, 29, 150);
                                }
                                else // Coronel (5) y General (6)
                                {
                                        GivePlayerWeapon(playerid, 24, 70);
                                        GivePlayerWeapon(playerid, 25, 50);
                                        GivePlayerWeapon(playerid, 31, 150);
                                        GivePlayerWeapon(playerid, 29, 150);
                                        GivePlayerWeapon(playerid, 34, 15);
                                }
                        }
                }
                else
                {
                        Patrulha[playerid] = false;
                        if(policiaon > 0) policiaon --; // FIX P0-1: prevenir underflow
                        // P1-PN-4: detener timer anti-AFK al salir de servicio
                        StopPatrulhaAFKTimer(playerid);
                        SetPlayerHealth(playerid, 100);
                        SetPlayerArmour(playerid, 0);
                        ResetPlayerWeapons(playerid);
                        CarregarArmas(playerid);
                        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                        SuccesMsg(playerid, "Usted dejo el servicio como policia");
                        SetPlayerColor(playerid, 0xFFFFFFFF);
                        SetPlayerHealth(playerid, 100);
                }
                return 1;
        }
        if(playertextid == HudCop[playerid][1])
        {
                if(Patrulha[playerid] == false) return InfoMsg(playerid, "No estas en servicio");
                new orgE = PlayerInfo[playerid][Org];
                ResetPlayerWeapons(playerid);
                SetPlayerArmour(playerid, 100);
                // Transito: pistola + nightstick + esposas
                if(orgE == 2) { GivePlayerWeapon(playerid, 22, 150); GivePlayerWeapon(playerid, 3, 1); GivePlayerWeapon(playerid, 1, 1); InfoMsg(playerid, "Equipamiento Transito: Pistola + Nightstick + Esposas"); }
                // P1-PN-5: Policia Nacional - equipamiento escalado por rango (boton Re-Equipar)
                else if(orgE == 1)
                {
                        new cargoPN_e = PlayerInfo[playerid][Cargo];
                        GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                        GivePlayerWeapon(playerid, 1, 1);   // Esposas
                        if(cargoPN_e == 1)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                InfoMsg(playerid, "Equipamiento Oficial: Pistola 9mm + Nightstick + Esposas");
                        }
                        else if(cargoPN_e == 2)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                GivePlayerWeapon(playerid, 25, 70);
                                InfoMsg(playerid, "Equipamiento Sargento: Pistola + Escopeta + Nightstick + Esposas");
                        }
                        else if(cargoPN_e == 3)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                GivePlayerWeapon(playerid, 25, 70);
                                GivePlayerWeapon(playerid, 29, 200);
                                InfoMsg(playerid, "Equipamiento Teniente: Pistola + Escopeta + MP5 + Nightstick + Esposas");
                        }
                        else if(cargoPN_e == 4)
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 25, 70);
                                GivePlayerWeapon(playerid, 29, 200);
                                InfoMsg(playerid, "Equipamiento Capitan: Desert Eagle + Escopeta + MP5 + Nightstick + Esposas");
                        }
                        else
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 25, 70);
                                GivePlayerWeapon(playerid, 29, 200);
                                GivePlayerWeapon(playerid, 34, 20);
                                InfoMsg(playerid, "Equipamiento Comisario: Desert Eagle + Escopeta + MP5 + Sniper + Nightstick + Esposas");
                        }
                }
                // P1-FBI-1: FBI - equipamiento escalado por rango (boton Re-Equipar)
                else if(orgE == 3)
                {
                        new cargoE = PlayerInfo[playerid][Cargo];
                        GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                        GivePlayerWeapon(playerid, 1, 1);   // Esposas
                        if(cargoE == 1)
                        {
                                GivePlayerWeapon(playerid, 23, 50);
                                GivePlayerWeapon(playerid, 29, 150);
                                InfoMsg(playerid, "Equipamiento Agente Encubierto: Silenced + MP5 + Nightstick + Esposas");
                        }
                        else if(cargoE == 2)
                        {
                                GivePlayerWeapon(playerid, 23, 50);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 33, 40);
                                InfoMsg(playerid, "Equipamiento Agente Especial: Silenced + MP5 + Rifle + Nightstick + Esposas");
                        }
                        else if(cargoE == 3)
                        {
                                GivePlayerWeapon(playerid, 23, 50);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 33, 40);
                                GivePlayerWeapon(playerid, 25, 40);
                                InfoMsg(playerid, "Equipamiento Supervisor: Silenced + MP5 + Rifle + Escopeta + Nightstick + Esposas");
                        }
                        else if(cargoE == 4)
                        {
                                GivePlayerWeapon(playerid, 24, 50);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 33, 40);
                                GivePlayerWeapon(playerid, 34, 20);
                                InfoMsg(playerid, "Equipamiento Jefe Division: Combat Pistol + MP5 + Rifle + Sniper + Nightstick + Esposas");
                        }
                        else
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 33, 40);
                                GivePlayerWeapon(playerid, 34, 20);
                                InfoMsg(playerid, "Equipamiento Director: Desert Eagle + MP5 + Rifle + Sniper + Nightstick + Esposas");
                        }
                }
                // SWAT: base + sniper solo Director
                // P1-SWAT-1: equipamiento escalado por rango (boton Re-Equipar)
                else if(orgE == 4)
                {
                        new cargoE2 = PlayerInfo[playerid][Cargo];
                        GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                        GivePlayerWeapon(playerid, 1, 1);   // Esposas
                        if(cargoE2 == 1)
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 31, 150);
                                InfoMsg(playerid, "Equipamiento Operador: Combat Pistol + MP5 + M4 + Nightstick + Esposas");
                        }
                        else if(cargoE2 == 2)
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 31, 150);
                                GivePlayerWeapon(playerid, 25, 70);
                                InfoMsg(playerid, "Equipamiento Tirador Selecto: Combat Pistol + MP5 + M4 + Escopeta + Nightstick + Esposas");
                        }
                        else
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 31, 150);
                                GivePlayerWeapon(playerid, 34, 20);
                                InfoMsg(playerid, "Equipamiento Comandante Tactico: Combat Pistol + MP5 + M4 + Sniper + Nightstick + Esposas");
                        }
                }
                // P1-EJ-2: Ejercito - equipamiento escalado por rango (boton Re-Equipar)
                else if(orgE == 14)
                {
                        new cargoE3 = PlayerInfo[playerid][Cargo];
                        GivePlayerWeapon(playerid, 3, 1);   // Nightstick
                        GivePlayerWeapon(playerid, 1, 1);   // Esposas
                        if(cargoE3 == 1)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                GivePlayerWeapon(playerid, 31, 150);
                                InfoMsg(playerid, "Equipamiento Soldado: Pistola 9mm + M4 + Nightstick + Esposas");
                        }
                        else if(cargoE3 == 2)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                GivePlayerWeapon(playerid, 25, 50);
                                GivePlayerWeapon(playerid, 31, 150);
                                InfoMsg(playerid, "Equipamiento Sargento: Pistola + Escopeta + M4 + Nightstick + Esposas");
                        }
                        else if(cargoE3 == 3)
                        {
                                GivePlayerWeapon(playerid, 22, 50);
                                GivePlayerWeapon(playerid, 25, 50);
                                GivePlayerWeapon(playerid, 31, 150);
                                GivePlayerWeapon(playerid, 29, 150);
                                InfoMsg(playerid, "Equipamiento Teniente: Pistola + Escopeta + M4 + MP5 + Nightstick + Esposas");
                        }
                        else if(cargoE3 == 4)
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 25, 50);
                                GivePlayerWeapon(playerid, 31, 150);
                                GivePlayerWeapon(playerid, 29, 150);
                                InfoMsg(playerid, "Equipamiento Capitan: Desert Eagle + Escopeta + M4 + MP5 + Nightstick + Esposas");
                        }
                        else
                        {
                                GivePlayerWeapon(playerid, 24, 70);
                                GivePlayerWeapon(playerid, 25, 50);
                                GivePlayerWeapon(playerid, 31, 150);
                                GivePlayerWeapon(playerid, 29, 150);
                                GivePlayerWeapon(playerid, 34, 15);
                                InfoMsg(playerid, "Equipamiento Coronel/General: Desert Eagle + Escopeta + M4 + MP5 + Sniper + Nightstick + Esposas");
                        }
                }
        }
        if(playertextid == CopGuns[playerid][0])
        {
                SetPlayerArmour(playerid, 100);
                RemovePlayerWeapon(playerid, 24);
                RemovePlayerWeapon(playerid, 34);
                GivePlayerWeapon(playerid, 24, 32);
        }
        if(playertextid == CopGuns[playerid][1])
        {
                SetPlayerArmour(playerid, 100);
                RemovePlayerWeapon(playerid, 34);
                RemovePlayerWeapon(playerid, 25);
                RemovePlayerWeapon(playerid, 29);
                RemovePlayerWeapon(playerid, 31);
                GivePlayerWeapon(playerid, 31, 150);
        }
        if(playertextid == CopGuns[playerid][2])
        {
                SetPlayerArmour(playerid, 100);
                RemovePlayerWeapon(playerid, 34);
                RemovePlayerWeapon(playerid, 29);
                RemovePlayerWeapon(playerid, 31);
                RemovePlayerWeapon(playerid, 25);
                GivePlayerWeapon(playerid, 25, 10);
        }
        if(playertextid == CopGuns[playerid][3])
        {
                SetPlayerArmour(playerid, 100);
                RemovePlayerWeapon(playerid, 34);
                RemovePlayerWeapon(playerid, 25);
                RemovePlayerWeapon(playerid, 31);
                RemovePlayerWeapon(playerid, 29);
                GivePlayerWeapon(playerid, 29, 100);
        }
        if(playertextid == CopGuns[playerid][4])
        {
                // FIX P0-4: restringir Sniper (arma 34) por rango segun organizacion.
                // Antes cualquier cargo de cualquier org policial podia sacar sniper del menu rapido,
                // rompiendo la progresion de armamento. Tabla de rangos minimos:
                //   Policia Nacional (1): cargo >= 3 (Teniente)
                //   Transito (2):        no tiene acceso (es transito, no combate)
                //   FBI (3):              cargo >= 5 (Jefe Division)
                //   SWAT (4):             cargo >= 3 (Director)
                //   Ejercito (14):        cargo >= 5 (Coronel)
                new snOrg = PlayerInfo[playerid][Org];
                new snCargo = PlayerInfo[playerid][Cargo];
                new snMinCargo = 999; // por defecto: bloqueado
                switch(snOrg)
                {
                        case 1:  snMinCargo = 3; // Policia Nacional
                        case 2:  snMinCargo = 999; // Transito: sin sniper
                        case 3:  snMinCargo = 5; // FBI
                        case 4:  snMinCargo = 3; // SWAT
                        case 14: snMinCargo = 5; // Ejercito
                }
                if(snCargo < snMinCargo)
                {
                        new snMsg[96];
                        format(snMsg, sizeof(snMsg), "Sniper restringido. Requiere cargo %d o superior en tu organizacion.", snMinCargo);
                        return ErrorMsg(playerid, snMsg);
                }
                SetPlayerArmour(playerid, 100);
                RemovePlayerWeapon(playerid, 29);
                RemovePlayerWeapon(playerid, 25);
                RemovePlayerWeapon(playerid, 31);
                RemovePlayerWeapon(playerid, 34);
                GivePlayerWeapon(playerid, 34, 10);
        }
        if(playertextid == HudCop[playerid][2])
        {
                new Ropa[800];
                if(Patrulha[playerid] == false) return InfoMsg(playerid, "No estas en servicio");
                new orgR = PlayerInfo[playerid][Org];
                new cargoR = PlayerInfo[playerid][Cargo];
                // P1-3: Femenino PN tiene su propio menu por rango (igual que el masculino).
                // Otras orgs mantienen menu generico de 2 skins.
                if(PlayerInfo[playerid][pSexo] == 2 && orgR == 1)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FF69B4}[F]{FFFFFF} {FFFF00}[Oficial] {FFFFFF}Uniforme (Skin 93)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FF69B4}[F]{FFFFFF} {FFFF00}[Sargento] {FFFFFF}Uniforme (Skin 192)\n");
                        if(cargoR >= 3) strcat(Ropa, "{FF69B4}[F]{FFFFFF} {FFFF00}[Teniente] {FFFFFF}Uniforme (Skin 211)\n");
                        if(cargoR >= 4) strcat(Ropa, "{FF69B4}[F]{FFFFFF} {FF6347}[Capitan] {FFFFFF}Uniforme (Skin 150)\n");
                        if(cargoR >= 5) strcat(Ropa, "{FF69B4}[F]{FFFFFF} {FF0000}[Comisario] {FFFFFF}Uniforme (Skin 233)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - PN Femenino", Ropa, "Seleccionar", "X");
                }
                // Femenino otras orgs: solo 2 skins (comportamiento original)
                else if(PlayerInfo[playerid][pSexo] == 2)
                {
                        strcat(Ropa, "{FF69B4}[F] {FFFFFF}Uniforme Femenino 1 (Skin 148)\n");
                        strcat(Ropa, "{FF69B4}[F] {FFFFFF}Uniforme Femenino 2 (Skin 192)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes", Ropa, "Seleccionar", "X");
                }
                // Transito
                else if(orgR == 2)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FFFF00}[Cadete] {FFFFFF}Uniforme Transito (Skin 71)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FFFF00}[Oficial] {FFFFFF}Uniforme Oficial (Skin 265)\n");
                        if(cargoR >= 3) strcat(Ropa, "{FF6347}[Jefe de Transito] {FFFFFF}Uniforme Jefe (Skin 284)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - Transito", Ropa, "Seleccionar", "X");
                }
                // Policia Nacional
                else if(orgR == 1)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FFFF00}[Oficial] {FFFFFF}Uniforme Oficial (Skin 266)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FFFF00}[Sargento] {FFFFFF}Uniforme Sargento (Skin 267)\n");
                        if(cargoR >= 3) strcat(Ropa, "{FFFF00}[Teniente] {FFFFFF}Uniforme Teniente (Skin 280)\n");
                        if(cargoR >= 4) strcat(Ropa, "{FF6347}[Capitan] {FFFFFF}Uniforme Capitan (Skin 281)\n");
                        if(cargoR >= 5) strcat(Ropa, "{FF0000}[Comisario] {FFFFFF}Uniforme Comisario (Skin 283)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - Policia Nacional", Ropa, "Seleccionar", "X");
                }
                // FBI
                else if(orgR == 3)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FFFF00}[Agente] {FFFFFF}Uniforme Agente (Skin 208)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FFFF00}[Ag. Encubierto] {FFFFFF}Skin aleatorio civil\n");
                        if(cargoR >= 3) strcat(Ropa, "{FFFF00}[Ag. Especial] {FFFFFF}Uniforme Especial (Skin 165)\n");
                        if(cargoR >= 4) strcat(Ropa, "{FF6347}[Supervisor] {FFFFFF}Uniforme Supervisor (Skin 165)\n");
                        if(cargoR >= 5) strcat(Ropa, "{FF6347}[Jefe Division] {FFFFFF}Uniforme Jefe (Skin 164)\n");
                        if(cargoR >= 6) strcat(Ropa, "{FF0000}[Director] {FFFFFF}Uniforme Director (Skin 286)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - FBI", Ropa, "Seleccionar", "X");
                }
                // SWAT - nuevos rangos tacticos
                else if(orgR == 4)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FFFF00}[Operador] {FFFFFF}Uniforme Tactico (Skin 285)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FF6347}[Tirador Selecto] {FFFFFF}Uniforme Avanzado (Skin 282)\n");
                        if(cargoR >= 3) strcat(Ropa, "{FF0000}[Comandante Tactico] {FFFFFF}Uniforme de Lider (Skin 288)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - SWAT", Ropa, "Seleccionar", "X");
                }
                // Ejercito
                else if(orgR == 14)
                {
                        if(cargoR >= 1) strcat(Ropa, "{FFFF00}[Soldado] {FFFFFF}Uniforme Militar (Skin 287)\n");
                        if(cargoR >= 2) strcat(Ropa, "{FFFF00}[Sargento] {FFFFFF}Uniforme Militar (Skin 287)\n");
                        if(cargoR >= 3) strcat(Ropa, "{FFFF00}[Teniente] {FFFFFF}Uniforme Militar (Skin 287)\n");
                        if(cargoR >= 4) strcat(Ropa, "{FF6347}[Capitan] {FFFFFF}Uniforme Militar (Skin 287)\n");
                        if(cargoR >= 5) strcat(Ropa, "{FF6347}[Coronel] {FFFFFF}Uniforme Coronel (Skin 282)\n");
                        if(cargoR >= 6) strcat(Ropa, "{FF0000}[General] {FFFFFF}Uniforme General (Skin 288)\n");
                        strcat(Ropa, "{FFFFFF}- {FFFF00}Retirar Uniforme\n");
                        ShowPlayerDialog(playerid, DIALOG_ROPACOP, DIALOG_STYLE_LIST, "Uniformes - Ejercito", Ropa, "Seleccionar", "X");
                }
                else
                {
                        return InfoMsg(playerid, "Tu organizacion no tiene uniformes disponibles.");
                }
        }
        return 1;
}

// =====================================================================
// FIX ALTO-VIP-001 (ALTO): callback periodico de expiracion VIP.
// Se ejecuta cada 60s (VIP_CHECK_INTERVAL_MS). Recorre jugadores conectados
// y valida si su VIP expiro. Si expiro, resetea pVIP/ExpiraVIP, elimina
// VIPS/.ini, reset color, y notifica al jugador.
// =====================================================================
forward VIPExpiryCheck();
public VIPExpiryCheck()
{
        foreach(new i : Player)
        {
                if(!IsPlayerConnected(i)) continue;
                if(!pLogado[i]) continue;
                // Si tiene pVIP > 0 pero ExpiraVIP == 0 o ya expiro
                if(PlayerInfo[i][pVIP] > 0)
                {
                        if(PlayerInfo[i][ExpiraVIP] == 0 || gettime() > PlayerInfo[i][ExpiraVIP])
                        {
                                new _vipFile[80];
                                format(_vipFile, sizeof(_vipFile), PASTA_VIPS, Name(i));
                                if(DOF2_FileExists(_vipFile)) DOF2_RemoveFile(_vipFile);
                                PlayerInfo[i][ExpiraVIP] = 0;
                                PlayerInfo[i][pVIP] = 0;
                                ResetVIPVisuals(i);
                                SalvarDados(i);
                                InfoMsg(i, "Tu VIP ha expirado. Puedes renovarlo en la tienda.");
                        }
                }
        }
        return 1;
}

forward ChamadaUmSegundo();
public ChamadaUmSegundo()
{
        // Actualizar reloj global cada segundo
        {
                new horaC, minC, segC;
                gettime(horaC, minC, segC);
                #pragma unused segC
                new hora12C = horaC % 12;
                if(hora12C == 0) hora12C = 12;
                new ampmC[3];
                if(horaC < 12) format(ampmC, sizeof(ampmC), "AM");
                else format(ampmC, sizeof(ampmC), "PM");
                new clockStr[16];
                format(clockStr, sizeof(clockStr), "%d:%02d %s", hora12C, minC, ampmC);
                TextDrawSetString(mda_TD[2], clockStr);
        }
        new String[500];
        // FIX AUDIT5 C-01: lista activa de enfermos para evitar O(n^2) en contagio.
        // Antes: foreach outer (N) x foreach inner (N) = N^2 iteraciones por tick.
        // Ahora: recolectar K enfermos en lista, luego iterar K x N (K << N).
        new sickList[MAX_PLAYERS], sickCount = 0;
        foreach(Player, i)
        {
                // =====================================================================
                // CAMBIO 2026-07-12 - Teleports automaticos de hospitales (radio 3m).
                // Antes: entrada con tecla H en OnPlayerKeyStateChange.
                // Ahora: entrada automatica al caminar dentro de 3 metros.
                // Cada hospital tiene VirtualWorld distinto para no mezclar interiores.
                // =====================================================================

                // FIX AUDIT AC-H3: cooldown de 8s a 15s para evitar bypass anti-TP.
                // Antes: `>= 8` permitia al jugador caminar por hospital cada 8s,
                // manteniendo inmunidad anti-TP 10s continua (bypass indefinido).
                // Ahora: `>= 15` + inmunidad anti-TP reducida a 3s (fix L29695)
                // asegura que no se puede mantener inmunidad continua.
                if(gettime() - GetPVarInt(i, "HospitalTPCooldown") >= 15)
                {
                // HOSPITAL 0 - LS PRINCIPAL (interior 5, VW 0)
                if(IsPlayerInRangeOfPoint(i, 3.0, 1172.669555, -1323.346801, 15.402282) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 5);
                        SetPlayerPos(i, 1174.5527, -1325.9724, -44.2836);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1174.5527, -1325.9724, -44.2836) && GetPlayerVirtualWorld(i) == 0 && GetPlayerInterior(i) == 5)
                {
                        SetPlayerPos(i, 1172.669555, -1323.346801, 15.402282);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 1 - LS GENERAL (interior 5, VW 1)
                else if(IsPlayerInRangeOfPoint(i, 3.0, 2034.102539, -1402.010864, 17.294139) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 5);
                        SetPlayerPos(i, 1174.5527, -1325.9724, -44.2836);
                        SetPlayerVirtualWorld(i, 1);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1174.5527, -1325.9724, -44.2836) && GetPlayerVirtualWorld(i) == 1)
                {
                        SetPlayerPos(i, 2034.102539, -1402.010864, 17.294139);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 2 - LAS VENTURAS (interior 5, VW 2)
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1583.765869, 1768.978149, 10.820312) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 5);
                        SetPlayerPos(i, 1174.5527, -1325.9724, -44.2836);
                        SetPlayerVirtualWorld(i, 2);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1174.5527, -1325.9724, -44.2836) && GetPlayerVirtualWorld(i) == 2)
                {
                        SetPlayerPos(i, 1583.765869, 1768.978149, 10.820312);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 3 - FLINT COUNTY (mapping TONY CONTERAS, VW 3)
                else if(IsPlayerInRangeOfPoint(i, 3.0, -321.661529, 1048.237304, 20.340259) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 318.9639, 1807.9812, 551.0901);
                        SetPlayerFacingAngle(i, 87.7238);
                        SetPlayerVirtualWorld(i, 3);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 318.9639, 1807.9812, 551.0901) && GetPlayerVirtualWorld(i) == 3)
                {
                        SetPlayerPos(i, -321.661529, 1048.237304, 20.340259);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 4 - TIERRA ROBADA (mapping TONY CONTERAS, VW 4)
                else if(IsPlayerInRangeOfPoint(i, 3.0, -1514.885375, 2519.179443, 56.070312) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 318.9639, 1807.9812, 551.0901);
                        SetPlayerFacingAngle(i, 87.7238);
                        SetPlayerVirtualWorld(i, 4);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 318.9639, 1807.9812, 551.0901) && GetPlayerVirtualWorld(i) == 4)
                {
                        SetPlayerPos(i, -1514.885375, 2519.179443, 56.070312);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 5 - SAN FIERRO (interior 5, VW 5)
                else if(IsPlayerInRangeOfPoint(i, 3.0, -2654.985595, 639.843566, 14.454549) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 5);
                        SetPlayerPos(i, 1174.5527, -1325.9724, -44.2836);
                        SetPlayerVirtualWorld(i, 5);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1174.5527, -1325.9724, -44.2836) && GetPlayerVirtualWorld(i) == 5)
                {
                        SetPlayerPos(i, -2654.985595, 639.843566, 14.454549);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 6 - BONE COUNTY (mapping TONY CONTERAS, VW 6)
                else if(IsPlayerInRangeOfPoint(i, 3.0, -2203.959472, -2309.575927, 31.375000) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 318.9639, 1807.9812, 551.0901);
                        SetPlayerFacingAngle(i, 87.7238);
                        SetPlayerVirtualWorld(i, 6);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 318.9639, 1807.9812, 551.0901) && GetPlayerVirtualWorld(i) == 6)
                {
                        SetPlayerPos(i, -2203.959472, -2309.575927, 31.375000);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // HOSPITAL 7 - RED COUNTY (mapping TONY CONTERAS, VW 7)
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1240.560424, 326.459716, 19.755510) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 318.9639, 1807.9812, 551.0901);
                        SetPlayerFacingAngle(i, 87.7238);
                        SetPlayerVirtualWorld(i, 7);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 318.9639, 1807.9812, 551.0901) && GetPlayerVirtualWorld(i) == 7)
                {
                        SetPlayerPos(i, 1240.560424, 326.459716, 19.755510);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // =====================================================================
                // CAMBIO 2026-07-12 - Fase 1: Teleport bidireccional al techo del hospital LS.
                // Subir: desde interior 5 (sotano) al techo (exterior).
                // Bajar: desde el techo (exterior) al interior 5 (sotano).
                // =====================================================================
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1150.014648, -1320.273437, -44.276340) && GetPlayerInterior(i) == 5 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 1161.154785, -1329.614990, 31.496776);
                        SetPlayerFacingAngle(i, 350.013397); // De espaldas a la puerta
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                else if(IsPlayerInRangeOfPoint(i, 3.0, 1161.154785, -1329.614990, 31.496776) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 5);
                        SetPlayerPos(i, 1150.014648, -1320.273437, -44.276340);
                        SetPlayerFacingAngle(i, 94.474479);
                        SetPlayerVirtualWorld(i, 0);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // =====================================================================
                // CAMBIO 2026-07-13 - Teleport Farmacias (SF=VW10, LV=VW11, LS=VW12)
                // =====================================================================
                // Farmacia San Fierro
                else if(IsPlayerInRangeOfPoint(i, 1.0, -2442.626464, 755.267639, 35.171875) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 959.244628, 559.481933, 2985.962402);
                        SetPlayerFacingAngle(i, 277.263946);
                        SetPlayerVirtualWorld(i, 10);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // Farmacia Las Venturas
                else if(IsPlayerInRangeOfPoint(i, 1.0, 2810.991943, 1987.732788, 10.820312) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 959.244628, 559.481933, 2985.962402);
                        SetPlayerFacingAngle(i, 277.263946);
                        SetPlayerVirtualWorld(i, 11);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // Farmacia Los Santos
                else if(IsPlayerInRangeOfPoint(i, 1.0, 1222.944824, -1130.647827, 23.967670) && GetPlayerInterior(i) == 0 && GetPlayerVirtualWorld(i) == 0)
                {
                        SetPlayerInterior(i, 0);
                        SetPlayerPos(i, 959.244628, 559.481933, 2985.962402);
                        SetPlayerFacingAngle(i, 277.263946);
                        SetPlayerVirtualWorld(i, 12);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // Salida (VW 10, 11, 12 -> exterior)
                else if(IsPlayerInRangeOfPoint(i, 1.0, 957.5695, 559.3472, 2985.9624) && (GetPlayerVirtualWorld(i) == 10 || GetPlayerVirtualWorld(i) == 11 || GetPlayerVirtualWorld(i) == 12))
                {
                        new vw = GetPlayerVirtualWorld(i);
                        SetPlayerInterior(i, 0);
                        SetPlayerVirtualWorld(i, 0);
                        if(vw == 10) SetPlayerPos(i, -2442.626464, 755.267639, 35.171875);
                        else if(vw == 11) SetPlayerPos(i, 2810.991943, 1987.732788, 10.820312);
                        else if(vw == 12) SetPlayerPos(i, 1222.944824, -1130.647827, 23.967670);
                        TogglePlayerControllable(i, false);
                        SetTimerEx("carregarobj", 5000, 0, "i", i);
                        SetPVarInt(i, "HospitalTPCooldown", gettime());
                }
                // =====================================================================
                } // fin del cooldown check
                // =====================================================================

                // CAMBIO 2026-07-12 - Fase 2: sumar +1 segundo de Org 10 si es paramedico.
                if(pLogado[i] && PlayerInfo[i][Org] == 10)
                {
                    SegundosOrg10[i] ++;
                }
                // P1-PN-Vehiculos: sumar +1 segundo de Org 1 si es PN.
                if(pLogado[i] && PlayerInfo[i][Org] == 1)
                {
                    SegundosOrg1[i] ++;
                }

                // CAMBIO 2026-07-18: Sistema de sangrado (vendaje)
                // Cada 10 segundos, si el jugador esta sangrando, pierde 1 HP
                if(Sangrando[i])
                {
                    SangradoTick[i] ++;
                    if(SangradoTick[i] >= 10)
                    {
                        SangradoTick[i] = 0;
                        new Float:hp; GetPlayerHealth(i, hp);
                        if(hp > 1.0)
                        {
                            // FIX AUDITORIA 2026-07-20: calcular nuevo HP y mostrar mensaje cada 10 HP perdidos
                            new Float:newHp = hp - 1.0;
                            SetPlayerHealth(i, newHp);
                            // Mensaje cada 10 HP perdidos (10, 20, 30, etc)
                            if(floatround(newHp) % 10 == 0)
                            {
                                SendClientMessage(i, 0xFF4444FF, "| SANGRADO | Estas perdiendo sangre. Ve a un medico o usa /usarkit.");
                            }
                        }
                    }
                    // Si sangra mas de 3 minutos (180s), contrae infeccion
                    // CAMBIO 2026-07-20: Vacuna antitetanica reduce 90% chance
                    // FIX AUDITORIA 2026-07-20: el check de infeccion debe ser independiente del reset de SangradoTick
                    if(Sangrando[i] && Enfermedad[i] == 0)
                    {
                        // Contar tiempo de sangrado (cada segundo)
                        SetPVarInt(i, "SangradoTiempo", GetPVarInt(i, "SangradoTiempo") + 1);
                        if(GetPVarInt(i, "SangradoTiempo") >= 180)
                        {
                            // Verificar vacuna antitetanica activa
                            new tiempoActual3 = gettime();
                            new bool:tieneAntitetanica = (VacunaAntitetanica[i] > tiempoActual3);

                            // Sin vacuna: 100% contagio. Con vacuna: 10% (90% proteccion)
                            if(!tieneAntitetanica || random(100) < 10)
                            {
                                Enfermedad[i] = 2; // Infeccion
                                EnfermedadTick[i] = 0;
                                EnfermedadTiempo[i] = 0;
                                DeletePVar(i, "SangradoTiempo");
                                if(tieneAntitetanica)
                                    SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | {FF0000}Has contraido una INFECCION{FFFFFF} (la vacuna fallo) por sangrar demasiado tiempo!");
                                else
                                    SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | {FF0000}Has contraido una INFECCION{FFFFFF} por sangrar demasiado tiempo!");
                                SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | Ve al hospital para obtener un diagnostico.");
                            }
                            else
                            {
                                // Vacuna efectiva
                                DeletePVar(i, "SangradoTiempo");
                                SendClientMessage(i, 0x228B22FF, "| VACUNA | Tu vacuna antitetanica te protegio de la infeccion.");
                            }
                        }
                    }
                }

                // =====================================================================
                // CAMBIO 2026-07-18: Sistema de Enfermedades (contagio + daÃ¯Â¿Â½o)
                // =====================================================================

                // Contagio de Gripe: estar bajo lluvia o nadando por 5 min (300s)
                // CAMBIO 2026-07-20: Si tiene vacuna antigripal activa, reduce 90% chance
                if(Enfermedad[i] == 0 && pLogado[i])
                {
                    // SA-MP no tiene GetWeather/GetPlayerWeather nativo, usamos ClimaActual
                    // IDs de clima con lluvia en SA-MP: 8, 16, 17, 18
                    if(ClimaActual == 8 || ClimaActual == 16 || ClimaActual == 17 || ClimaActual == 18)
                    {
                        LluviaTick[i] ++;
                        if(LluviaTick[i] >= 300)
                        {
                            // Verificar vacuna antigripal activa
                            new tiempoActual = gettime();
                            if(VacunaAntigripal[i] > tiempoActual)
                            {
                                // Vacuna activa: 90% de proteccion -> 10% chance de contagio
                                if(random(100) < 10)
                                {
                                    Enfermedad[i] = 1; // Gripe
                                    EnfermedadTick[i] = 0;
                                    EnfermedadTiempo[i] = 0;
                                    LluviaTick[i] = 0;
                                    SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | {FFA500}Has contraido GRIPE{FFFFFF} (la vacuna fallo, 10% chance)!");
                                    SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | Ve al hospital para obtener un diagnostico.");
                                }
                                else
                                {
                                    // Vacuna efectiva
                                    LluviaTick[i] = 0;
                                    SendClientMessage(i, 0x228B22FF, "| VACUNA | Tu vacuna antigripal te protegio de la gripe.");
                                }
                            }
                            else
                            {
                                // Sin vacuna: contagio normal
                                Enfermedad[i] = 1; // Gripe
                                EnfermedadTick[i] = 0;
                                EnfermedadTiempo[i] = 0;
                                LluviaTick[i] = 0;
                                SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | {FFA500}Has contraido GRIPE{FFFFFF} por estar bajo la lluvia!");
                                SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | Ve al hospital para obtener un diagnostico.");
                            }
                        }
                    }
                    else
                    {
                        LluviaTick[i] = 0;
                    }
                }

                // =====================================================================
                // CAMBIO 2026-07-20: Contagio de Gripe entre jugadores cercanos
                // Si un jugador tiene gripe (Enfermedad==1), hay 0.5% de chance por segundo
                // de contagiar a jugadores sanos en radio de 5 metros.
                // =====================================================================
                // FIX AUDIT5 C-01: solo recolectar al enfermo en sickList.
                // El contagio (inner loop) se hace DESPUES del foreach outer,
                // iterando solo K enfermos en vez de N jugadores.
                if(Enfermedad[i] == 1 && pLogado[i])
                {
                    sickList[sickCount] = i;
                    sickCount++;
                }

                // =====================================================================
                // CAMBIO 2026-07-20: Efectos visuales y sonidos por enfermedad
                // Tos: cada 20-30s si tiene gripe/neumonia/fiebre
                // Screen shake: cada 15s si tiene infeccion/intoxicacion
                // =====================================================================
                if(Enfermedad[i] > 0 && pLogado[i])
                {
                    EfectoTick[i] ++;
                    TosUltimaVez[i] ++;

                    // Tos para gripe, neumonia, fiebre
                    // FIX CRASH 2026-07-20: solo animar si esta onfoot y no en vehiculo
                    if((Enfermedad[i] == 1 || Enfermedad[i] == 4 || Enfermedad[i] == 5) && TosUltimaVez[i] >= 25)
                    {
                        TosUltimaVez[i] = 0;
                        // Sonido de tos: usa el sonido de estornudo del juego (1184 = sound ID comun)
                        PlayerPlaySound(i, 1184, 0.0, 0.0, 0.0);
                        // Animacion ligera de tos (solo si esta onfoot y no en vehiculo)
                        new tosState = GetPlayerState(i);
                        if(tosState == 1 && !IsPlayerInAnyVehicle(i))
                            ApplyAnimation(i, "PED", "IDLE_tired", 4.1, 0, 0, 0, 0, 0, 1);
                    }

                    // Screen shake para infeccion/intoxicacion/neumonia (mareos)
                    if((Enfermedad[i] == 2 || Enfermedad[i] == 3 || Enfermedad[i] == 4 || Enfermedad[i] == 6) && EfectoTick[i] >= 15)
                    {
                        // DaÃ¯Â¿Â½o minimo para simular el mareo (1 HP simbolico sin matar)
                        new Float:hp; GetPlayerHealth(i, hp);
                        if(hp > 2.0) SetPlayerHealth(i, hp - 1.0);
                    }
                }
                else
                {
                    EfectoTick[i] = 0;
                    TosUltimaVez[i] = 0;
                }

                // =====================================================================
                // DaÃ¯Â¿Â½o por enfermedad y progresion
                // =====================================================================
                if(Enfermedad[i] > 0 && pLogado[i])
                {
                    EnfermedadTick[i] ++;
                    EnfermedadTiempo[i] ++;

                    // Gripe: -5 HP cada 60s, progresa a neumonia a los 600s (10 min)
                    if(Enfermedad[i] == 1)
                    {
                        if(EnfermedadTiempo[i] >= 600)
                        {
                            Enfermedad[i] = 4; // Neumonia
                            EnfermedadTick[i] = 0;
                            SendClientMessage(i, 0xFF4444FF, "| ENFERMEDAD | {FF0000}Tu gripe empeoro a NEUMONIA!{FFFFFF} Necesitas tratamiento medico urgente!");
                        }
                        else if(EnfermedadTick[i] >= 60)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 5.0) SetPlayerHealth(i, hp - 5.0);
                            SendClientMessage(i, 0xFFA500FF, "| GRIPE | Tienes tos y fiebre. Ve al hospital.");
                        }
                    }
                    // Infeccion: -10 HP cada 45s
                    else if(Enfermedad[i] == 2)
                    {
                        if(EnfermedadTick[i] >= 45)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 10.0) SetPlayerHealth(i, hp - 10.0);
                            SendClientMessage(i, 0xFF4444FF, "| INFECCION | La infeccion avanza. Ve al hospital por una receta.");
                        }
                    }
                    // Intoxicacion: -15 HP cada 30s
                    else if(Enfermedad[i] == 3)
                    {
                        if(EnfermedadTick[i] >= 30)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 15.0) SetPlayerHealth(i, hp - 15.0);
                            SendClientMessage(i, 0xFF4444FF, "| INTOXICACION | Sientes mareos y vomitos. Ve al hospital por una receta.");
                        }
                    }
                    // Neumonia: -20 HP cada 30s
                    else if(Enfermedad[i] == 4)
                    {
                        if(EnfermedadTick[i] >= 30)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 20.0) SetPlayerHealth(i, hp - 20.0);
                            SendClientMessage(i, 0xFF0000FF, "| NEUMONIA | No puedes respirar bien. Necesitas un medico urgentemente!");
                        }
                    }
                    // CAMBIO 2026-07-20: Fiebre - 8 HP cada 50s (enfermedad nueva)
                    // Se cura con Antibiotico (compartido con infeccion)
                    else if(Enfermedad[i] == 5)
                    {
                        if(EnfermedadTick[i] >= 50)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 8.0) SetPlayerHealth(i, hp - 8.0);
                            SendClientMessage(i, 0xFF6600FF, "| FIEBRE | Tu temperatura corporal esta alta. Ve al hospital por una receta.");
                        }
                    }
                    // CAMBIO 2026-07-20: Alergia - 3 HP cada 35s (enfermedad nueva)
                    // Se cura con Antigripal (compartido con gripe)
                    else if(Enfermedad[i] == 6)
                    {
                        if(EnfermedadTick[i] >= 35)
                        {
                            EnfermedadTick[i] = 0;
                            new Float:hp; GetPlayerHealth(i, hp);
                            if(hp > 3.0) SetPlayerHealth(i, hp - 3.0);
                            SendClientMessage(i, 0x9933CCFF, "| ALERGIA | Tienes estornudos y picazon. Ve al hospital por una receta.");
                        }
                    }
                }

                // =====================================================================
                // CAMBIO 2026-07-20: Sistema de Fracturas
                // - Deteccion de caida de altura (>10m de diferencia Z)
                // - Auto-cura a los 600s (10 min) si no es tratada
                // - Efectos: pierna reduce velocidad, brazo bloquea armas 2 manos
                //
                // FIX CRASH 2026-07-20 v2: validaciones defensivas mas estrictas
                // - Skip si jugador esta en interior (las caidas reales son en exterior)
                // - Skip si la diferencia Z es irreal (>500m = teletransporte, no caida)
                // - Skip si TogglePlayerControllable es false (congelado = teletransporte)
                // - Skip si esta en vehiculo (las caidas en vehiculo se manejan aparte)
                // =====================================================================
                if(pLogado[i] && Fractura[i] == 0 && !IsPlayerInAnyVehicle(i))
                {
                    new Float:curX, Float:curY, Float:curZ;
                    GetPlayerPos(i, curX, curY, curZ);

                    // FIX CRASH: skip deteccion si esta congelado (TogglePlayerControllable=false)
                    // No hay forma directa de leer TogglePlayerControllable, pero si el jugador
                    // esta siendo teletransportado su estado es PLAYER_STATE_SPECTATING o esta en interior
                    new curInterior = GetPlayerInterior(i);
                    new curState = GetPlayerState(i);

                    // Solo detectar caida si:
                    // 1. Esta en exterior (interior 0) - las caidas reales son afuera
                    // 2. Esta en estado OnFoot (PLAYER_STATE_ONFOOT = 1)
                    // 3. Tiene altura registrada previa
                    // 4. La diferencia Z es realista (entre 10m y 100m - mas de 100m es teletransporte)
                    // FIX BUG #2: 5. La diferencia X e Y es menor a 5m (caida real es vertical, teleport mueve horizontal)
                    if(curInterior == 0 && curState == 1 && CaidaAltura[i] > 0.0)
                    {
                        new Float:diff = CaidaAltura[i] - curZ;
                        // FIX BUG #2: calcular tambien desplazamiento horizontal.
                        // Una caida real tiene delta X/Y < 5m (solo cae verticalmente).
                        // Un teleport mueve al jugador en X/Y tambien, incluso aunque
                        // la diferencia Z sea grande (ej: rooftop -> suelo en otra ciudad).
                        new Float:diffX = CaidaX[i] - curX;
                        new Float:diffY = CaidaY[i] - curY;
                        if(diffX < 0.0) diffX = -diffX; // valor absoluto
                        if(diffY < 0.0) diffY = -diffY;
                        // Deteccion realista: cayo entre 10 y 100 metros (mas de 100 es falso positivo)
                        // Y no se movio mas de 5m horizontalmente (si se movio, fue teleport).
                        if(diff > 10.0 && diff < 100.0 && diffX < 5.0 && diffY < 5.0 && GetPlayerSpecialAction(i) == 0)
                        {
                            // Validar que el interior anterior tambien era 0 (no venia de teletransporte)
                            if(InteriorAnterior[i] == 0)
                            {
                                // 60% de chance de fractura por caida
                                if(random(100) < 60)
                                {
                                    // 50% pierna, 30% brazo, 20% costillas
                                    new rndFractura = random(10);
                                    if(rndFractura < 5) Fractura[i] = 2; // Pierna
                                    else if(rndFractura < 8) Fractura[i] = 1; // Brazo
                                    else Fractura[i] = 3; // Costillas
                                    FracturaTick[i] = 0;
                                    new fracName[16];
                                    if(Fractura[i] == 1) fracName = "brazo";
                                    else if(Fractura[i] == 2) fracName = "pierna";
                                    else fracName = "costillas";
                                    new msgFrac[128];
                                    format(msgFrac, sizeof(msgFrac), "| FRACTURA | {FF0000}Te fracturaste el/la %s{FFFFFF} por la caida! Ve a un hospital.", fracName);
                                    SendClientMessage(i, 0xFF4444FF, msgFrac);
                                    // Animacion de dolor
                                    ApplyAnimation(i, "PED", "KO_SKID_FRONT", 4.1, 0, 1, 1, 1, 0, 1);
                                }
                            }
                        }
                    }
                    // Actualizar altura, X, Y e interior para el siguiente tick
                    CaidaAltura[i] = curZ;
                    CaidaX[i] = curX;
                    CaidaY[i] = curY;
                    InteriorAnterior[i] = curInterior;
                }

                // =====================================================================
                // CAMBIO 2026-07-20: Trackear velocidad del vehiculo que ocupa el jugador
                // Se usa en OnPlayerExitVehicle para aplicar daÃ¯Â¿Â½o al tirarse de vehiculo en movimiento
                // =====================================================================
                if(pLogado[i] && IsPlayerInAnyVehicle(i))
                {
                    new vehAtual = GetPlayerVehicleID(i);
                    if(vehAtual > 0 && IsValidVehicle(vehAtual))
                    {
                        new Float:vx, Float:vy, Float:vz;
                        GetVehicleVelocity(vehAtual, vx, vy, vz);
                        // Convertir velocidad del juego a km/h aproximados
                        // La formula estandar en SA-MP: sqrt(vx^2+vy^2+vz^2) * 100 = km/h aprox
                        VelocidadeVeh[i] = floatsqroot(vx*vx + vy*vy + vz*vz) * 100.0;
                    }
                }
                else
                {
                    VelocidadeVeh[i] = 0.0;
                }

                // Decrementar flag anti-spam de salida de vehiculo (1s cooldown)
                if(SaliendoVehMovil[i] > 0) SaliendoVehMovil[i] --;

                // FIX AUDIT MEDICO MED-A5-02: decrementar ChamouPolicia cada segundo.
                // ANTES: ChamouPolicia se seteaba a 120 al usar /192 (L30763), pero NUNCA
                // se decrementaba. El cooldown quedaba en 120 forever, cappeando /192
                // a 1 uso por sesion. Jugadores que usaban /192 una vez no podian volver
                // a llamar ambulancia hasta reconectar.
                // AHORA: se decrementa cada segundo en ChamadaUmSegundo. Despues de 120s,
                // ChamouPolicia llega a 0 y el jugador puede volver a usar /192.
                if(ChamouPolicia[i] > 0) ChamouPolicia[i] --;

                // Auto-cura de fractura (10 min = 600s)
                if(Fractura[i] > 0 && pLogado[i])
                {
                    FracturaTick[i] ++;
                    if(FracturaTick[i] >= 600)
                    {
                        new fracName[16];
                        if(Fractura[i] == 1) fracName = "brazo";
                        else if(Fractura[i] == 2) fracName = "pierna";
                        else fracName = "costillas";
                        new msgAuto[128];
                        format(msgAuto, sizeof(msgAuto), "| FRACTURA | Tu fractura de %s ha sanado naturalmente tras 10 minutos.", fracName);
                        SendClientMessage(i, 0x228B22FF, msgAuto);
                        Fractura[i] = 0;
                        FracturaTick[i] = 0;
                    }
                }

                // =====================================================================
                // CAMBIO 2026-07-20: Sistema de Quemaduras - daÃ¯Â¿Â½o periÃ¯Â¿Â½dico + sol extremo
                // =====================================================================
                // Sol extremo: si el clima es soleado y el jugador esta afuera (interior 0),
                // despues de 30 min (1800s) bajo el sol -> quemadura grado 1
                if(Quemadura[i] == 0 && pLogado[i] && GetPlayerInterior(i) == 0
                    && (ClimaActual == 1 || ClimaActual == 2 || ClimaActual == 11 || ClimaActual == 12))
                {
                    SolTick[i] ++;
                    if(SolTick[i] >= 1800) // 30 min bajo el sol
                    {
                        Quemadura[i] = 1; // Grado 1
                        QuemaduraTick[i] = 0;
                        SolTick[i] = 0;
                        SendClientMessage(i, 0xFF6600FF, "| QUEMADURA | {FFA500}Sufriste quemadura por exposicion prolongada al sol.{FFFFFF} Compra pomada en farmacia.");
                    }
                }
                else
                {
                    SolTick[i] = 0;
                }

                // DaÃ¯Â¿Â½o periÃ¯Â¿Â½dico por quemadura
                // FIX CRASH 2026-07-20: skip animaciones si el jugador esta en estado no-onfoot
                // (teletransporte, espectando, en vehiculo, etc.)
                if(Quemadura[i] > 0 && pLogado[i])
                {
                    QuemaduraTick[i] ++;
                    new Float:hp; GetPlayerHealth(i, hp);
                    // FIX CRASH: solo aplicar daÃ¯Â¿Â½o si esta onfoot y en exterior o interior normal
                    new queState = GetPlayerState(i);
                    new bool:puedeAnimar = (queState == 1 && !IsPlayerInAnyVehicle(i));

                    // Grado 1: -1 HP cada 30s (leve)
                    if(Quemadura[i] == 1 && QuemaduraTick[i] >= 30)
                    {
                        QuemaduraTick[i] = 0;
                        if(hp > 1.0) SetPlayerHealth(i, hp - 1.0);
                        if(random(100) < 20) // 20% chance cada 30s de mensaje
                            SendClientMessage(i, 0xFFAA00FF, "| QUEMADURA | Tu piel arde levemente. Aplicate pomada.");
                    }
                    // Grado 2: -3 HP cada 20s (medio)
                    else if(Quemadura[i] == 2 && QuemaduraTick[i] >= 20)
                    {
                        QuemaduraTick[i] = 0;
                        if(hp > 3.0) SetPlayerHealth(i, hp - 3.0);
                        SendClientMessage(i, 0xFF6600FF, "| QUEMADURA | Tienes ampollas dolorosas. Ve a la farmacia o usa pomada.");
                        // Efecto: animacion de dolor cada 60s (solo si puede animar)
                        if(puedeAnimar && random(3) == 0) ApplyAnimation(i, "PED", "IDLE_tired", 4.1, 0, 0, 0, 0, 0, 1);
                    }
                    // Grado 3: -5 HP cada 15s (grave - solo cura paramedico)
                    else if(Quemadura[i] == 3 && QuemaduraTick[i] >= 15)
                    {
                        QuemaduraTick[i] = 0;
                        if(hp > 5.0) SetPlayerHealth(i, hp - 5.0);
                        SendClientMessage(i, 0xFF0000FF, "| QUEMADURA GRAVE | Necesitas atencion medica urgente! Un paramedico debe curarte.");
                        if(puedeAnimar) ApplyAnimation(i, "PED", "KO_SKID_FRONT", 4.1, 0, 1, 1, 1, 0, 1);
                        // Sonido de dolor
                        PlayerPlaySound(i, 1184, 0.0, 0.0, 0.0);
                    }
                }
                // =====================================================================

                if(SegundosAviso[i] > 0)
            {
                SegundosAviso[i] --;
                if(SegundosAviso[i] <= 0)
                {
                    PlayerTextDrawHide(i, MsgText[i]);
                }
            }
                    // FIX P0-MED-2: bloque de muerte reescrito.
                // Antes: guard SegundosMorte[i] > 0 con init en (5,0) -> bloque muerto,
                // nunca decrementaba y el auto-revive era inalcanzable.
                // Ahora: guard (MinutosMorte > 0 || SegundosMorte > 0), decremento limpio,
                // auto-revive hace cleanup completo (sangre + TDs + unfreeze timer).
                if(MinutosMorte[i] > 0 || SegundosMorte[i] > 0)
                {
                    // Decrementar el timer (1 segundo)
                    if(SegundosMorte[i] > 0) SegundosMorte[i] --;
                    else { MinutosMorte[i] --; SegundosMorte[i] = 59; }

                    // FIX AUDIT MEDICO MED-A5-07: reaplicar animacion herido cada 5 segundos.
                    // ANTES: ApplyAnimation se ejecutaba cada segundo (cada tick) = 60 RPC/minuto
                    // por cada herido. A 50 heridos = 3000 RPC/min de trafico innecesario.
                    // AHORA: solo reaplicar cada 5 ticks (12 RPC/min por herido) - 80% menos trafico.
                    // La animacion CRCKIDLE4 con delta=4.1s se mantiene visible entre reaplicaciones.
                    g_HeridoAnimTick[i] ++;
                    if(g_HeridoAnimTick[i] >= 5)
                    {
                        ApplyAnimation(i, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
                        g_HeridoAnimTick[i] = 0;
                    }

                    // Actualizar display de tiempo y mostrar textdraws de muerte
                    new StrM[30];
                    format(StrM, sizeof(StrM), "~b~Muerto: ~w~%02d:%02d", MinutosMorte[i], SegundosMorte[i]);
                    PlayerTextDrawSetString(i, TelaMorteCDA[i][3], StrM);
                    // FIX AUDIT6 HIGH-1: solo mostrar los TDs la primera vez (no cada tick)
                    if(!MostrandoTelaMorte[i])
                    {
                        for(new t = 0; t < 7; t++)
                            PlayerTextDrawShow(i, TelaMorteCDA[i][t]);
                        MostrandoTelaMorte[i] = true;
                    }

                    // Auto-revive al llegar a 0:00
                    if(MinutosMorte[i] <= 0 && SegundosMorte[i] <= 0)
                    {
                        SendClientMessage(i, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                        SendClientMessage(i, 0x3CB371FF, "{FFFFFF}~> Usted sucumbio a sus heridas y fue trasladado al hospital mas cercano.");
                        if(PlanoSaude[i] <= 0)
                        {
                            // FIX P0-MED-3: mensaje consistente con el cobro real ($1000 flat).
                            // Antes mostraba GetPlayerScore(i) * 50 pero cobraba 1000.
                            format(String, sizeof(String), "{FFFFFF}~> Tus gastos tuvieron un costo de {088A08}$1000{FFFFFF}, El importe fue debitado de la cuenta bancaria.");
                            SendClientMessage(i, 0x3CB371FF, String);
                            SendClientMessage(i, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                            // FIX AUDIT AGENT5 XS-03: antes era GivePlayerMoney sin ResetPlayerMoney
                            // previo, lo que causaba que el cliente mostrara 2*pDinheiro-1000 y
                            // OnPlayerUpdate computaba diff = pDinheiro, disparando kick falso si
                            // el jugador tenia >$10k (strike) o >$100k (kick directo).
                            // Fix: usar AC_AddPlayerMoney que internamente hace ResetPlayerMoney
                            // + GivePlayerMoney + setea grace window AC_MoneyChangeTime de 2s.
                            AC_AddPlayerMoney(i, -1000);
                            // FIX AUDIT2 AGENT2 M-09: SalvarDados inmediato para persistir
                            // el cobro del auto-revive. Sin esto, si crash antes del SaveTimer,
                            // el revive es gratis (dinero en disco = original).
                            SalvarDados(i);
                        }
                        else
                        {
                            PlanoSaude[i] --;
                            // FIX AUDIT MEDICO A3-HIGH-01 (auto-revive): persistir PlanoSaude inmediatamente.
                            // ANTES: PlanoSaude[i]-- se decrementaba en memoria pero NO se persistia.
                            // Si el servidor crasheaba antes del SaveTimer (2.2s), el plan se restauraba
                            // al reconectar, permitiendo uso gratuito del plan (dupe de uso).
                            // AHORA: persistir inmediatamente para que el uso consumido no se revierta.
                            SalvarDados(i);
                            format(String, sizeof(String), "{FFFFFF}~> Su seguro de salud pago todos sus gastos. Tu contrato esta en vigor %d / 10", PlanoSaude[i]);
                            SendClientMessage(i, 0x3CB371FF, String);
                            SendClientMessage(i, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                        }

                        // FIX P0-MED-4: cleanup completo antes de teleport.
                        // Antes: SangueObjeto y TelaMorteCDA quedaban leakados tras auto-revive.
                        if(SangueObjeto[i] > -1)
                        {
                            DestroyObject(SangueObjeto[i]);
                            SangueObjeto[i] = -1;
                        }
                        for(new t = 0; t < 7; t++)
                            PlayerTextDrawHide(i, TelaMorteCDA[i][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[i] = false;                        // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (auto-revive).
                        // ANTES: LogoBZ[0..4] se mostraba al quedar herido (OnPlayerSpawn L22742-22746)
                        // PERO nunca se ocultaba al revivir. El jugador veia los 5 TextDraws overlay
                        // para siempre tras revivir.
                        // AHORA: ocultar al revivir.
                        for(new t = 0; t < 5; t++)
                            TextDrawHideForPlayer(i, LogoBZ[t]);
                        // FIX AUDIT6 HIGH-1: resetear flag para proxima muerte
                        MostrandoTelaMorte[i] = false;

                        // FIX P0-MED-5: programar unfreeze via CarregarInterior.
                        // Antes: TogglePlayerControllable(0) sin timer posterior dejaba al
                        // jugador congelado forever tras auto-revive.
                        TogglePlayerControllable(i, 0);
                        XMorte[i] = -1; YMorte[i] = -1; ZMorte[i] = -1;
                        // FIX AUDIT SPAWN S3-2: usar GetPlayerHospital + HospitalSpawn para
                        // elegir hospital mas cercano (o cama de hospital pequeÃ¯Â¿Â½o si VW 3,4,6,7).
                        // Antes: hardcodeaba RandomHosp (interior 2, LS) o RandomHospPequeno
                        // (cama TONY). Si el jugador moria cerca de SF, revivia en LS (a 3km).
                        // Ahora: GetPlayerHospital devuelve el indice mas cercano (0-3 para
                        // hospitales grandes, 4-7 para camas del hospital pequeÃ¯Â¿Â½o segun VW).
                        new hospIdx = GetPlayerHospital(i);
                        if(hospIdx >= 0 && hospIdx < 8)
                        {
                            SetPlayerPos(i, HospitalSpawn[hospIdx][0], HospitalSpawn[hospIdx][1], HospitalSpawn[hospIdx][2]);
                            SetPlayerFacingAngle(i, HospitalSpawn[hospIdx][3]);
                            SetPlayerInterior(i, floatround(HospitalSpawn[hospIdx][4]));
                            SetPlayerVirtualWorld(i, floatround(HospitalSpawn[hospIdx][5]));
                        }
                        else
                        {
                            // Fallback defensivo: si GetPlayerHospital falla, ir a LS P.
                            SetPlayerPos(i, HospitalSpawn[0][0], HospitalSpawn[0][1], HospitalSpawn[0][2]);
                            SetPlayerFacingAngle(i, HospitalSpawn[0][3]);
                            SetPlayerInterior(i, 0);
                            SetPlayerVirtualWorld(i, 0);
                        }
                        SetCameraBehindPlayer(i);
                        SetPlayerHealth(i, 100.0);
                        // FIX AUDIT2 AGENT1 W-01: restaurar armas personales tras auto-revive.
                        // Antes: el auto-revive NO llamaba ResetPlayerWeapons + CarregarArmas.
                        // El tracking (resetado en OnPlayerDeath) quedaba vacio, pero el
                        // jugador tampoco recibia armas nuevas. Resultado: jugador revivia
                        // sin armas hasta reconectar. Fix: si no esta en Patrulha (policial
                        // en servicio), restaurar armas personales desde Armas/%s.ini.
                        // Patrulha obtiene armas org via el path de duty al re-equipar.
                        if(!Patrulha[i] && PlayerInfo[i][pjail] == 0)
                        {
                                ResetPlayerWeapons(i);
                                CarregarArmas(i);
                        }
                        FomePlayer[i] = 50;
                        SedePlayer[i] = 50;
                        GameTextForPlayer(i, "~r~Carregando...", 6000, 3);
                        SetTimerEx("CarregarInterior", 7000, false, "i", i);
                    }
                }
        }

        // =====================================================================
        // FIX AUDIT5 C-01: contagio post-foreach con lista activa (K enfermos
        // en vez de N jugadores). Misma logica, mejor performance.
        // FIX AUDIT5 M-01: cachear GetPlayerInterior(i)/GetPlayerVirtualWorld(i)
        // FUERA del inner loop (antes se llamaban 2*N veces por enfermo).
        // =====================================================================
        for(new k = 0; k < sickCount; k++)
        {
            new i = sickList[k];
            new Float:sx, Float:sy, Float:sz;
            GetPlayerPos(i, sx, sy, sz);
            new tiempoActual2 = gettime();
            new iInterior = GetPlayerInterior(i);
            new iVW = GetPlayerVirtualWorld(i);
            foreach(new j: Player)
            {
                if(j == i) continue;
                if(!pLogado[j]) continue;
                if(Enfermedad[j] != 0) continue; // ya esta enfermo
                if(GetPlayerInterior(j) != iInterior) continue;
                if(GetPlayerVirtualWorld(j) != iVW) continue;
                if(IsPlayerInRangeOfPoint(j, 5.0, sx, sy, sz))
                {
                    // CAMBIO 2026-07-20: Si tiene vacuna antigripal, 90% proteccion
                    new bool:tieneVacuna = (VacunaAntigripal[j] > tiempoActual2);
                    new chanceContagio = tieneVacuna ? 2000 : 200; // 0.05% con vacuna vs 0.5% sin vacuna

                    if(random(chanceContagio) == 0)
                    {
                        Enfermedad[j] = 1; // Gripe
                        EnfermedadTick[j] = 0;
                        EnfermedadTiempo[j] = 0;
                        if(tieneVacuna)
                            SendClientMessage(j, 0xFF4444FF, "| ENFERMEDAD | {FFA500}Has contraido GRIPE{FFFFFF} (la vacuna fallo) por estar cerca de alguien enfermo!");
                        else
                            SendClientMessage(j, 0xFF4444FF, "| ENFERMEDAD | {FFA500}Has contraido GRIPE{FFFFFF} por estar cerca de alguien enfermo!");
                        SendClientMessage(j, 0xFF4444FF, "| ENFERMEDAD | Ve al hospital para obtener un diagnostico.");
                    }
                }
            }
        }
        return 1;
}
forward CarregarInterior(playerid);
public CarregarInterior(playerid)
{
    // FIX AUDIT MEDICO MED-A5-05: validar IsPlayerConnected antes de descongelar.
    // ANTES: si el jugador se desconectaba durante los 7s del SetTimerEx y otro
    // jugador reusaba el slot, TogglePlayerControllable(slot_id, 1) descongelaba
    // al nuevo jugador sin que el lo pidiera.
    // AHORA: solo descongelar si el jugador sigue conectado y logueado.
    if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
    // FIX AUDIT ANIM ANIM-A2-06 (CRITICO): no descongelar algemado/herido.
    // M-01 alineado a SafeUnfreeze (helper centralizado).
    SafeUnfreeze(playerid);
    return 1;
}
stock MsgAviso(playerid, segundos, const msg[])
{
        PlayerTextDrawSetString(playerid, MsgText[playerid], msg);
        PlayerTextDrawShow(playerid, MsgText[playerid]);
        SegundosAviso[playerid] = segundos;
}
stock IsPointInRangeOfPoint(Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2, Float:range)
{
    x2 -= x;
    y2 -= y;
    z2 -= z;
    return ((x2 * x2) + (y2 * y2) + (z2 * z2)) < (range * range);
}
stock GetXYInFrontOfPlayer(playerid, &Float:x, &Float:y, Float:distance)
{
    new Float:a;
    GetPlayerPos(playerid, x, y, a);
    GetPlayerFacingAngle(playerid, a);
    if (GetPlayerVehicleID(playerid)) {
        GetVehicleZAngle(GetPlayerVehicleID(playerid), a);
    }
    x += (distance * floatsin(-a, degrees));
    y += (distance * floatcos(-a, degrees));
}
stock GetPlayerDistanceToPoint(playerid, Float:x, Float:y)
{
    new Float:tmpdis;
    new Float:x1, Float:y1, Float:z1;
    GetPlayerPos(playerid, x1, y1, z1);
    // FIX AUDIT5 MED-01: floatpower(x,2) -> (x*x) (10x mas rapido)
    tmpdis = floatsqroot((floatabs(floatsub(x,x1))*floatabs(floatsub(x,x1)))+(floatabs(floatsub(y,y1))*floatabs(floatsub(y,y1))));
    return floatround(tmpdis);
}
forward Socorrer(playerid);
public Socorrer(playerid)
{
    new target = Localizando[playerid];

    // FIX VERIFY-DANODMG-3 CRIT-DMG-3: validaciones defensivas antes de tocar target.
    // Si el paramedico se desconecto, Localizando[playerid] pudo ser reseteado a -1
    // por ZerarDados, causando acceso a MinutosMorte[-1] = memory corruption.
    // Si el target se desconecto o ya no esta herido, abortar limpiamente.
    if(target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target))
    {
        // Limpiar estado del paramedico si aun esta conectado
        if(IsPlayerConnected(playerid))
        {
            if(CheckMEDICO[playerid] > -1)
            {
                DestroyDynamicCP(CheckMEDICO[playerid]);
                CheckMEDICO[playerid] = -1;
            }
            Localizando[playerid] = -1;
            SendClientMessage(playerid, 0xFF4444FF, "| PARAMEDICO | El paciente se desconecto. Rescate cancelado.");
        }
        DeletePVar(playerid, "SocorrerTimerID");
        return 1;
    }
    if(MinutosMorte[target] <= 0 && SegundosMorte[target] <= 0)
    {
        // El target ya no esta herido (fue socorrido por otro o murio)
        if(IsPlayerConnected(playerid))
        {
            if(CheckMEDICO[playerid] > -1)
            {
                DestroyDynamicCP(CheckMEDICO[playerid]);
                CheckMEDICO[playerid] = -1;
            }
            Localizando[playerid] = -1;
            SendClientMessage(playerid, 0xFFAA00FF, "| PARAMEDICO | El paciente ya no necesita rescate.");
        }
        DeletePVar(playerid, "SocorrerTimerID");
        return 1;
    }

    // Cleanup del CP de rescate
    if(CheckMEDICO[playerid] > -1)
    {
        DestroyDynamicCP(CheckMEDICO[playerid]);
        CheckMEDICO[playerid] = -1;
    }
    // Limpiar PVar del timer (ya disparo)
    DeletePVar(playerid, "SocorrerTimerID");

    // =====================================================================
    // CAMBIO 2026-07-09 - Bug #14.A: pago inverso + tope $2500 + paciente paga
    // ANTES: a mas tiempo herido, mas pago (incentivaba demora). Tope $4000.
    //        Dinero imprimido de la nada (inflacion).
    // AHORA: max $2500 si rescata al instante, decreciendo hasta $0.
    //        Paciente paga $500 (del bolsillo o banco), $2000 imprimido.
    //        Si tiene Plano de Salud: lo asume el plan (consume 1 uso).
    //        Si no tiene dinero: imprimido asume todo.
    // =====================================================================

    // Calcular tiempo restante (el timer arranca en 5:00 = 300s)
    new tempoTotal = 300; // 5 minutos maximo
    new tempoRestante = (MinutosMorte[target] * 60) + SegundosMorte[target];
    if(tempoRestante > tempoTotal) tempoRestante = tempoTotal;
    if(tempoRestante < 0) tempoRestante = 0;

    // Pago inverso: max $2500 al instante, $0 al llegar a 5 min
    new valortotal = floatround(2500.0 * (float(tempoRestante) / float(tempoTotal)));

    // Anti-farm: si el paramedico mato al paciente o este fue socorrido hace <10min, $0
    if(MatouPlayer[playerid] == target || (gettime() - FoiSocorrido[target]) <= 600)
    {
        valortotal = 0;
    }

    // CAMBIO 2026-07-20: Bonificacion por triaje (solo si valortotal > 0)
    // P1 critico: +50%, P2 urgente: +25%, P3 leve: sin bonus
    new bonusTriage = 0;
    if(valortotal > 0 && TriagePrio[target] > 0)
    {
        if(TriagePrio[target] == 1) bonusTriage = floatround(valortotal * 0.5); // +50%
        else if(TriagePrio[target] == 2) bonusTriage = floatround(valortotal * 0.25); // +25%
        valortotal += bonusTriage;
    }

    new String[300];
    new pagoImpreso = 0;      // cuanto se imprimio (sin origen)

    if(valortotal > 0)
    {
        if(PlanoSaude[target] > 0)
        {
            // CASO 1: paciente tiene Plano de Salud
            // El plan asume el pago. Consume 1 uso. El paramedico recibe el total (imprimido, justificado como pago del seguro).
            PlanoSaude[target]--;
            pagoImpreso = valortotal;
            AC_AddPlayerMoney(playerid, valortotal);
            // FIX AUDIT2 AGENT2 M-12 (caso 1): SalvarDados del paramedico.
            // Sin esto, si crash antes del SaveTimer, el paramedico pierde
            // el pago (loss asimetrico).
            SalvarDados(playerid);
            // FIX AUDIT MEDICO A3-HIGH-01 (caso 1): SalvarDados del target tambien.
            // ANTES: PlanoSaude[target]-- se decrementaba en memoria pero NO se persistia.
            // Si el servidor crasheaba antes del SaveTimer (2.2s), el plan se restauraba
            // al reconectar, permitiendo uso gratuito del plan (dupe de uso).
            // AHORA: persistir el target inmediatamente para que el uso consumido no se revierta.
            SalvarDados(target);

            format(String, sizeof(String), "| PARAMEDICO | Socorriste a %s[%d]. Recibiste {228B22}$%d{FFFFFF} (cubiertos por el Plan de Salud del paciente). Plan restante: %d/10", PlayerName(target), target, valortotal, PlanoSaude[target]);
            SendClientMessage(playerid, COR_PARAMEDICO, String);

            format(String, sizeof(String), "| PARAMEDICO | El Paramedico %s[%d] te socorrio. Tu Plan de Salud cubrio el costo. Plan restante: %d/10", PlayerName(playerid), playerid, PlanoSaude[target]);
            SendClientMessage(target, COR_PARAMEDICO, String);
        }
        else if(PlayerInfo[target][pDinheiro] >= 500)
        {
            // CASO 2: sin plan, pero tiene $500+ en mano
            pagoImpreso = valortotal - 500;
            // FIX VERIFY-MONEYAC-FIX: migrado a AC_AddPlayerMoney para sync correcta
            AC_AddPlayerMoney(target, -500);
            AC_AddPlayerMoney(playerid, valortotal);
            // FIX AUDIT2 AGENT2 M-12 (caso 2): SalvarDados de ambos.
            // Sin esto, si crash antes del SaveTimer, el paciente no paga
            // y/o el paramedico no recibe el pago (loss/dupe segun rama).
            SalvarDados(target);
            SalvarDados(playerid);

            format(String, sizeof(String), "| PARAMEDICO | Socorriste a %s[%d]. Recibiste {228B22}$%d{FFFFFF} ($500 del paciente + $%d del seguro).", PlayerName(target), target, valortotal, pagoImpreso);
            SendClientMessage(playerid, COR_PARAMEDICO, String);

            format(String, sizeof(String), "| PARAMEDICO | El Paramedico %s[%d] te socorrio. Pagaste {FF4444}$500{FFFFFF} de tu dinero en mano.", PlayerName(playerid), playerid);
            SendClientMessage(target, COR_PARAMEDICO, String);
        }
        else if(PlayerInfo[target][pBanco] >= 500 && PlayerInfo[target][BancoBloqueado] == 0)
        {
            // CASO 3: sin plan, sin dinero en mano, pero tiene $500+ en banco
            pagoImpreso = valortotal - 500;
            PlayerInfo[target][pBanco] -= 500;
            AC_AddPlayerMoney(playerid, valortotal);
            // FIX AUDIT2 AGENT2 M-12 (caso 3): SalvarDados de ambos. El target
            // tiene pBanco decrementado (persistido por SalvarDados) y el
            // paramedico recibe el pago (tambien persistido).
            SalvarDados(target);
            SalvarDados(playerid);

            format(String, sizeof(String), "| PARAMEDICO | Socorriste a %s[%d]. Recibiste {228B22}$%d{FFFFFF} ($500 del paciente (banco) + $%d del seguro).", PlayerName(target), target, valortotal, pagoImpreso);
            SendClientMessage(playerid, COR_PARAMEDICO, String);

            format(String, sizeof(String), "| PARAMEDICO | El Paramedico %s[%d] te socorrio. Pagaste {FF4444}$500{FFFFFF} de tu cuenta bancaria.", PlayerName(playerid), playerid);
            SendClientMessage(target, COR_PARAMEDICO, String);
        }
        else
        {
            // CASO 4: sin plan, sin dinero en mano ni banco
            // El imprimido asume todo. El paramedico igual cobra (no se penaliza al paramedico por la pobreza del paciente)
            pagoImpreso = valortotal;
            AC_AddPlayerMoney(playerid, valortotal);
            // FIX AUDIT2 AGENT2 M-12 (caso 4): SalvarDados del paramedico.
            // Sin esto, si crash antes del SaveTimer, el paramedico pierde
            // el pago (loss asimetrico).
            SalvarDados(playerid);

            format(String, sizeof(String), "| PARAMEDICO | Socorriste a %s[%d]. Recibiste {228B22}$%d{FFFFFF} (cubiertos por el seguro - paciente sin fondos).", PlayerName(target), target, valortotal);
            SendClientMessage(playerid, COR_PARAMEDICO, String);

            format(String, sizeof(String), "| PARAMEDICO | El Paramedico %s[%d] te socorrio. No tenias fondos - el seguro cubrio el costo. Considera contratar un Plan de Salud.", PlayerName(playerid), playerid);
            SendClientMessage(target, COR_PARAMEDICO, String);
        }
    }
    else
    {
        // valortotal == 0 (anti-farm o rescate tardio)
        format(String, sizeof(String), "| PARAMEDICO | Socorriste a %s[%d]. No recibiste pago (rescate tardio o anti-farm).", PlayerName(target), target);
        SendClientMessage(playerid, COR_PARAMEDICO, String);

        format(String, sizeof(String), "| PARAMEDICO | El Paramedico %s[%d] te socorrio a tiempo!", PlayerName(playerid), playerid);
        SendClientMessage(target, COR_PARAMEDICO, String);
    }

    // Cleanup del estado de muerte del paciente
    SegundosMorte[target] = 0;
    MinutosMorte[target] = 0;
    // CAMBIO 2026-07-20: reset triaje al ser socorrido
    TriagePrio[target] = 0;
    TriageMedico[target] = -1;
    if(SangueObjeto[target] > -1)
    {
        DestroyObject(SangueObjeto[target]);
        SangueObjeto[target] = -1;
    }
    ApplyAnimation(target, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
    SetPlayerHealth(target, 10.0);
    FomePlayer[target] = 50;
    SedePlayer[target] = 50;
    for(new i = 0; i < 7; i++)
    {
        PlayerTextDrawHide(target, TelaMorteCDA[target][i]);
    }
    // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al ser socorrido.
    for(new t = 0; t < 5; t++)
        TextDrawHideForPlayer(target, LogoBZ[t]);
    // FIX MEDIOS-VERIFY-A2: reset MostrandoTelaMorte al ser socorrido.
    // ANTES: este path ocultaba TelaMorteCDA y LogoBZ pero NO reseteaba MostrandoTelaMorte.
    // En la proxima muerte, el guard !MostrandoTelaMorte en ChamadaUmSegundo daba true,
    // asi que igual mostraba los TDs. Pero por consistencia con los otros 8 paths, resetear.
    MostrandoTelaMorte[target] = false;
    FoiSocorrido[target] = gettime();
    Localizando[playerid] = -1;
    return 1;
}
forward Localizador(playerid);
public Localizador(playerid)
{
//              new String[100];
        if(pLogado[playerid] == true)
        {
                if(PlayerInfo[playerid][Org] == 10) // Migrado a Org 10
                {
                    if(Localizando[playerid] != -1 && IsPlayerConnected(Localizando[playerid]) && (SegundosMorte[Localizando[playerid]] > 0 || MinutosMorte[Localizando[playerid]] > 0))
                    {
                            new MsgLocalize[128], Float:X, Float:Y, Float:Z; GetPlayerPos(Localizando[playerid], X, Y, Z);
                        new Float:fDistance = GetPlayerDistanceFromPoint(playerid, X, Y, Z);
                                format(MsgLocalize, sizeof(MsgLocalize), "~w~O Jugador: ~b~~h~%s~w~ esta muriendo, ~r~CORRER~w~!~n~~g~~h~Herido: ~w~%02d:%02d ~g~~h~Distancia: ~w~%0.1fm", PlayerName(Localizando[playerid]), MinutosMorte[Localizando[playerid]], SegundosMorte[Localizando[playerid]], fDistance);
                                if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
                                // Fase 3: optimizacion - solo recrear el CP si el paciente se movio >2 metros
                    // desde la ultima posicion conocida. Evita crear/destroy 1 CP cada 2s por jugador.
                    new Float:lastX = GetPVarFloat(playerid, "MedLastCPX");
                    new Float:lastY = GetPVarFloat(playerid, "MedLastCPY");
                    new Float:lastZ = GetPVarFloat(playerid, "MedLastCPZ");
                    new Float:dx = X - lastX, Float:dy = Y - lastY, Float:dz = Z - lastZ;
                    if(CheckMEDICO[playerid] > -1 && (dx*dx + dy*dy + dz*dz) < 4.0)
                    {
                        // Paciente apenas se movio, no recrear el CP
                    }
                    else
                    {
                        if(CheckMEDICO[playerid] > -1) DestroyDynamicCP(CheckMEDICO[playerid]);
                        CheckMEDICO[playerid] = CreateDynamicCP(X, Y, Z, 1.2, -1, -1, playerid, 10000.0);
                        SetPVarFloat(playerid, "MedLastCPX", X);
                        SetPVarFloat(playerid, "MedLastCPY", Y);
                        SetPVarFloat(playerid, "MedLastCPZ", Z);
                    }
                    HandleLocalizador[playerid] = SetTimerEx("Localizador", 2000, false, "i", playerid); // Fix Bug#2: guardar handle al reprogramar
                        }
                        else
                        {
                            if(CheckMEDICO[playerid] > -1)
                                {
                                    DestroyDynamicCP(CheckMEDICO[playerid]);
                                    CheckMEDICO[playerid] = -1;
                                }
                                if(SangueObjeto[Localizando[playerid]] > -1)
                                {
                                        DestroyObject(SangueObjeto[Localizando[playerid]]);
                                        SangueObjeto[Localizando[playerid]] = -1;
                                }
                Localizando[playerid] = -1;
                HandleLocalizador[playerid] = -1; // Fix Bug#2: cadena de timers termino, limpiar handle
                                SendClientMessage(playerid, GetPlayerColor(playerid), "| PARAMEDICO | O(A) El jugador localizado ya no necesita asistencia.");
                        }
                }
        }
        else
        {
            SendClientMessage(playerid, 0x228B22FF, "| GPS | El jugador ubicado ha abandonado el servidor.");
                Localizando[playerid] = -1;
                HandleLocalizador[playerid] = -1; // Fix Bug#2: cadena de timers termino, limpiar handle
                DisablePlayerCheckpoint(playerid);
                if(CheckMEDICO[playerid] > -1)
                {
                        DestroyDynamicCP(CheckMEDICO[playerid]);
                        CheckMEDICO[playerid] = -1;
                }
        }
        return 1;
}

forward CarregarHospital(playerid);
public CarregarHospital(playerid)
{
    TogglePlayerControllable(playerid, 1);
        MsgAviso(playerid, 5, "~w~Hospital");
        return 1;
}

forward GetPlayerHospital(playerid);
public GetPlayerHospital(playerid)
{
    if(!IsPlayerConnected(playerid))
    {
                return -1;
    }
    // FIX AUDIT SPAWN S3-2: si el jugador esta en VW 3,4,6,7 (hospital pequeÃ¯Â¿Â½o),
    // devolver el indice de HospitalSpawn correspondiente (4-7) en vez de buscar
    // el hospital grande mas cercano. Esto mantiene al jugador en el hospital pequeÃ¯Â¿Â½o
    // donde esta, en vez de teleportarlo a LS.
    new currentVW = GetPlayerVirtualWorld(playerid);
    if(currentVW == 3) return 4;
    if(currentVW == 4) return 5;
    if(currentVW == 6) return 6;
    if(currentVW == 7) return 7;
    // Sino, buscar el hospital grande mas cercano usando HospitalSpawn[0..3].
    new Float:distancia = 100000.000, Float:dist, prevhosp = 0;
        for(new hospid = 0; hospid < 4; hospid++)
        {
            dist = GetPlayerDistanceToPoint(playerid, HospitalSpawn[hospid][0], HospitalSpawn[hospid][1]);
        if((dist < distancia))
                {
            distancia = dist;
                    prevhosp = hospid;
                }
        }
        return prevhosp;
}
CMD:fb(playerid, params[])
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
    if(!CanChat(playerid)) return 1; // FIX AUDIT SPAM-H1+H2: validar mute y chat global
    // FIX AUDIT AGENT3 SP-04: antes cualquier jugador (incluso recien registrado)
    // podia usar /fb sin cooldown. SendClientMessageToAll a 500 jugadores = 1 llamada
    // = 500 paquetes salientes. 100 llamadas/seg = 50.000 paquetes/seg = DoS.
    // Fix: requerir VIP nivel 1+ + cooldown 60s via PVar CD_fb.
    if(PlayerInfo[playerid][pVIP] < 1) return ErrorMsg(playerid, "Comando exclusivo VIP. Adquiere VIP en la tienda.");
    new now = gettime();
    if(now - GetPVarInt(playerid, "CD_fb") < 60)
        return ErrorMsg(playerid, "Espera 60s para publicar otro mensaje en Facebook.");

    new nombre[MAX_PLAYER_NAME];
    new string[200];

    // Evitar mensajes vacÃ¯Â¿Â½os
    if (isnull(params))
        return SendClientMessage(playerid, 0x3B5998FF, "Uso correcto: /fb [mensaje]");

    SetPVarInt(playerid, "CD_fb", now); // FIX AUDIT7 UX-1: mover SetPVarInt despues del isnull check

    // Obtener nombre del jugador
    GetPlayerName(playerid, nombre, sizeof(nombre));

    // Mensaje estilo Facebook (azul)
    format(string, sizeof(string),
        "{3B5998}[Facebook] {4A90E2}%s {1C3AA9}(%d){FFFFFF}: %s",
        nombre, playerid, params);

    // ENVIAR A TODOS LOS JUGADORES
    SendClientMessageToAll(-1, string);

    return 1;
}


CMD:hospital(playerid)
{
        new String[500];
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
    {
        if(MinutosMorte[playerid] <= 1)
            {
                        // =====================================================================
                        // CAMBIO 2026-07-09 - Bug #14 (nuevo /hospital): penalizacion segun paramedicos.
                        // - 3+ paramedicos conectados: /hospital BLOQUEADO. Esperar al paramedico
                        //   o auto-revive automatico al acabar el timer (por $1000).
                        // - 2 o menos paramedicos: /hospital funciona pero con penalizacion:
                        //   * Paga $5000 (no $1000)
                        //   * Pierde 50% de kits medicos
                        // Esto evita que jugadores usen /hospital para evadir ser apresados
                        // en enfrentamientos legales vs ilegales.
                        // =====================================================================
                        new medicosOnline = 0;
                        foreach(new i : Player)
                        {
                            if(pLogado[i] && PlayerInfo[i][Org] == 10) medicosOnline++;
                        }

                        if(medicosOnline >= 3)
                        {
                            SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                            SendClientMessage(playerid, 0x3CB371FF, "{FFFFFF}~> Hay {FF69B4}paramedicos disponibles{FFFFFF}. /hospital deshabilitado.");
                            SendClientMessage(playerid, 0x3CB371FF, "{FFFFFF}~> Llama al {FF69B4}192 (/192){FFFFFF} para pedir asistencia, o espera el auto-revive.");
                            SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                            return 1;
                        }

                        // 2 o menos paramedicos: /hospital funciona con penalizacion
                        new cobroHospital = 5000;

                        SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                        SendClientMessage(playerid, 0x3CB371FF, "{FFFFFF}~> Decidiste no esperar al MÃ¯Â¿Â½DICO y te llevaron al hospital mas cercano.");
                        SendClientMessage(playerid, 0x3CB371FF, "{FFFFFF}~> {FF4444}PENALIZACION{FFFFFF}: solo hay 2 paramedicos o menos conectados. Cargo aumentado.");

                if(PlanoSaude[playerid] <= 0)
                {
                    // Sin Plano de Salud: paga $5000
                    if(PlayerInfo[playerid][pDinheiro] < cobroHospital)
                    {
                        SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                        return ErrorMsg(playerid, "No tienes $5000 para pagar el hospital (penalizacion por pocos paramedicos). Llama al 192 (/192) o espera el auto-revive.");
                    }
                    format(String, sizeof(String), "{FFFFFF}~> Tus gastos tuvieron un costo de {088A08}$%d{FFFFFF} (penalizacion). Debitado de tu dinero en mano.", cobroHospital);
                    SendClientMessage(playerid, 0x3CB371FF, String);
                                SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                                AC_AddPlayerMoney(playerid, -cobroHospital);
                                // FIX AUDIT2 AGENT2 M-10: SalvarDados inmediato para
                                // persistir el cobro del hospital. Sin esto, si crash
                                // antes del SaveTimer, el hospital es gratis (dinero en
                                // disco = original).
                                SalvarDados(playerid);
                        }
                        else
                        {
                            // Con Plano de Salud: consume 1 uso, no paga dinero
                            PlanoSaude[playerid] --;
                            // FIX AUDIT MEDICO A3-HIGH-01 (/hospital): persistir PlanoSaude inmediatamente.
                            // ANTES: PlanoSaude[playerid]-- se decrementaba en memoria pero NO se persistia.
                            // Si el servidor crasheaba antes del SaveTimer (2.2s), el plan se restauraba
                            // al reconectar, permitiendo uso gratuito del plan (dupe de uso).
                            // AHORA: persistir inmediatamente para que el uso consumido no se revierta.
                            SalvarDados(playerid);
                            format(String, sizeof(String), "{FFFFFF}~> Su seguro de salud pago todos sus {088A08}gastos{FFFFFF} (sin cargo extra por penalizacion). Contrato en %d / 10", PlanoSaude[playerid]);
                        SendClientMessage(playerid, 0x3CB371FF, String);
                                SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
                        }

                        // Penalizacion: pierde 50% de kits medicos (incluso con Plano de Salud)
                        if(KitsMedicos[playerid] > 0)
                        {
                            new nuevosKits = floatround(float(KitsMedicos[playerid]) / 2.0, floatround_ceil);
                            new perdidos = KitsMedicos[playerid] - nuevosKits;
                            KitsMedicos[playerid] = nuevosKits;
                            new msgKit[160];
                            format(msgKit, sizeof(msgKit), "{FFFFFF}~> Perdiste {FF4444}%d kits medicos{FFFFFF} por usar /hospital con pocos paramedicos.", perdidos);
                            SendClientMessage(playerid, 0x3CB371FF, msgKit);
                        }
                        // =====================================================================

                        TogglePlayerControllable(playerid, 0);
                XMorte[playerid] = -1; YMorte[playerid] = -1; ZMorte[playerid] = -1;
                MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
                TriagePrio[playerid] = 0; TriageMedico[playerid] = -1; // CAMBIO 2026-07-20
                PlayerTextDrawHide(playerid, MsgText[playerid]);
                // FIX AUDIT AC-H12: setear ACTPImmune antes de SetPlayerPos para evitar
                // que el anti-teleport kickee al jugador que acaba de ser teletransportado
                // al hospital. Sin esto, el OnPlayerUpdate siguiente detecta un movimiento
                // grande (desde la posicion de muerte hasta el hospital) y kickea.
                SetPVarInt(playerid, "ACTPImmune", gettime());
                //
                // FIX AUDIT SPAWN S3-2: usar GetPlayerHospital + HospitalSpawn para
                // elegir hospital mas cercano (o cama de hospital pequeÃ¯Â¿Â½o si VW 3,4,6,7).
                new hospIdx = GetPlayerHospital(playerid);
                if(hospIdx >= 0 && hospIdx < 8)
                {
                    SetPlayerPos(playerid, HospitalSpawn[hospIdx][0], HospitalSpawn[hospIdx][1], HospitalSpawn[hospIdx][2]);
                    SetPlayerFacingAngle(playerid, HospitalSpawn[hospIdx][3]);
                    SetPlayerInterior(playerid, floatround(HospitalSpawn[hospIdx][4]));
                    SetPlayerVirtualWorld(playerid, floatround(HospitalSpawn[hospIdx][5]));
                }
                else
                {
                    // Fallback defensivo: si GetPlayerHospital falla, ir a LS P.
                    SetPlayerPos(playerid, HospitalSpawn[0][0], HospitalSpawn[0][1], HospitalSpawn[0][2]);
                    SetPlayerFacingAngle(playerid, HospitalSpawn[0][3]);
                    SetPlayerInterior(playerid, 0);
                    SetPlayerVirtualWorld(playerid, 0);
                }
                        SetCameraBehindPlayer(playerid);
                        SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
                        TogglePlayerControllable(playerid, 0);
                        GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
                        FomePlayer[playerid] = 50;
                        SedePlayer[playerid] = 50;
                        for(new i = 0; i < 7; i++)
                 {
                   PlayerTextDrawHide(playerid, TelaMorteCDA[playerid][i]);
                   }
                   // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al revivir (/reanimar).
                   for(new _t = 0; _t < 5; _t++)
                       TextDrawHideForPlayer(playerid, LogoBZ[_t]);
                }
                else
                {
                        SendClientMessage(playerid, -1, "| ERROR | Debe esperar hasta que falten 2 minutos o menos para ir al hospital."); // Fase 2: texto corregido (check real es MinutosMorte <= 1)
                    ApplyAnimation(playerid, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
                }
        }
        else
        {
                 return SendClientMessage(playerid, -1, "| ERROR | Usted no esta herido");
        }
        return 1;
}

// MEJORA HAMBRE #1: /dormir - restaura SuenoPlayer y EstaminaPlayer.
// Requiere casa o vehiculo propio. Animacion BED_Loop por 20s, despues restaura.
CMD:dormir(playerid)
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMsg(playerid, "No puedes dormir ahora.");
    // FIX AUDIT ANIM ANIM-A2-03/A3-09/A4-26/A4-28 (CRITICO): bloquear bypass de arresto y de herido.
    // ANTES: /dormir no validaba pCongelado ni MinutosMorte. Un algemado podia
    // ejecutar /dormir, 20s despues DormirRestaurar llamaba ClearAnimations +
    // TogglePlayerControllable(1) = BYPASS DE ARRESTO. Un herido (1M HP, CRCKIDLE4)
    // podia dormir y sobrescribir CRCKIDLE4 con BED_Loop, despues DormirRestaurar
    // ClearAnimations lo liberaba y caminaba invulnerable. Ahora bloqueamos.
    if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "No puedes dormir estando algemado.");
    if(MinutosMorte[playerid] > 0) return ErrorMsg(playerid, "Estas herido. No puedes dormir.");
    if(g_DormindoODescansando[playerid]) return ErrorMsg(playerid, "Ya estas durmiendo o descansando.");
    // MEJORA HAMBRE #1: requiere casa o vehiculo (civil/aluguel).
    // Si el jugador no tiene casa Y no esta en un vehiculo propio, no puede dormir.
    new bool:tieneCasa = (PlayerInfo[playerid][Casa] >= 0 && PlayerInfo[playerid][Casa] < MAX_CASAS);
    new enVehiculo = IsPlayerInAnyVehicle(playerid); // FIX: IsPlayerInAnyVehicle returns int, not bool
    new vehId = GetPlayerVehicleID(playerid);
    new bool:enVehiculoPropio = (enVehiculo && VeiculoCivil[playerid] == vehId);
    if(!tieneCasa && !enVehiculoPropio)
        return ErrorMsg(playerid, "Necesitas estar en tu casa o en tu vehiculo para dormir.");
    if(SuenoPlayer[playerid] >= 100)
        return ErrorMsg(playerid, "Ya tienes suficiente sueno. No necesitas dormir.");
    // Congelar y animar dormido.
    TogglePlayerControllable(playerid, 0);
    // FIX AUDIT AFK H6: setear g_DormindoODescansando para eximir de AntiAway.
    // Antes: solo hacia TogglePlayerControllable(0) (que NO setea pCongelado).
    // AntiAway solo exime pCongelado, asi que el jugador en animacion BED_Loop
    // era kickeado por AFK a los 5 min (aunque estuviera durmiendo legitimo).
    // Ahora: usamos g_DormindoODescansando (flag separado de pCongelado para no
    // interferir con la logica de algemado/spawn en OnPlayerSpawn L23861).
    g_DormindoODescansando[playerid] = true;
    ApplyAnimation(playerid, "INT_HOUSE", "BED_Loop", 4.1, 1, 0, 0, 1, 0, 1);
    GameTextForPlayer(playerid, "~b~Durmiendo... 20s", 20000, 3);
    // MEJORA HAMBRE #1: restaurar despues de 20s. Estamina tambien se restaura
    // (efecto colateral: dormir restaura toda la fatiga).
    SetTimerEx("DormirRestaurar", 20000, false, "i", playerid);
    return 1;
}

forward DormirRestaurar(playerid);
public DormirRestaurar(playerid)
{
    // FIX AUDIT ANIM ANIM-A1-01/A3-07/A4-01/A4-08/A4-17 (ALTO/CRITICO): guards de estado.
    if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
    g_DormindoODescansando[playerid] = false;
    SetPlayerDrunkLevel(playerid, 0);
    if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
    {
        SuenoPlayer[playerid] = 100;
        EstaminaPlayer[playerid] = 100;
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        GameTextForPlayer(playerid, "~g~Sueno y estamina restaurados", 3000, 3);
        SalvarDados(playerid);
    }
    return 1;
}

// MEJORA HAMBRE #2: /descansar - restaura EstaminaPlayer.
// Sin requisitos (cualquiera puede descansar en cualquier lugar).
// Animacion ParkSit_M_loop por 15s, despues restaura.
CMD:descansar(playerid)
{
    if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMsg(playerid, "No puedes descansar ahora.");
    // FIX AUDIT ANIM ANIM-A2-04/A3-09/A4-27/A4-29 (CRITICO): bloquear bypass de arresto y herido.
    // ANTES: /descansar no validaba pCongelado ni MinutosMorte. A diferencia de
    // /dormir, /descansar NO requiere casa ni vehiculo (cualquiera puede). Por
    // eso el bypass era mas facil: algemado ejecuta /descansar, 15s despues
    // DescansarRestaurar ClearAnimations + TogglePlayerControllable(1) = BYPASS
    // DE ARRESTO sin requisitos. Ahora bloqueamos antes de TogglePlayerControllable.
    if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "No puedes descansar estando algemado.");
    if(MinutosMorte[playerid] > 0) return ErrorMsg(playerid, "Estas herido. No puedes descansar.");
    if(IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "Sal del vehiculo para descansar.");
    if(g_DormindoODescansando[playerid]) return ErrorMsg(playerid, "Ya estas durmiendo o descansando.");
    if(EstaminaPlayer[playerid] >= 100)
        return ErrorMsg(playerid, "Ya tienes suficiente estamina.");
    TogglePlayerControllable(playerid, 0);
    // FIX AUDIT AFK H6: setear g_DormindoODescansando para eximir de AntiAway (igual que /dormir).
    g_DormindoODescansando[playerid] = true;
    ApplyAnimation(playerid, "BEACH", "ParkSit_M_loop", 4.1, 1, 0, 0, 1, 0, 1);
    GameTextForPlayer(playerid, "~g~Descansando... 15s", 15000, 3);
    SetTimerEx("DescansarRestaurar", 15000, false, "i", playerid);
    return 1;
}

forward DescansarRestaurar(playerid);
public DescansarRestaurar(playerid)
{
    // FIX AUDIT ANIM ANIM-A1-01/A3-07/A4-02/A4-08/A4-17 (ALTO/CRITICO): guards de estado.
    if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
    g_DormindoODescansando[playerid] = false;
    if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
    {
        EstaminaPlayer[playerid] = 100;
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        GameTextForPlayer(playerid, "~g~Estamina restaurada", 3000, 3);
        SalvarDados(playerid);
    }
    return 1;
}

// CMD /reviver ELIMINADO - comando admin redundante con /revivirstaff.
// Tenia ademas el bug #9 de no descongelar al jugador revivido.
// Toda revivificacion admin ahora pasa por /revivirstaff [IDF].
CMD:revivir(playerid, const params[])
{
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Usted no tiene permisos. Solo Paramedicos.");

    // FIX Bug #3: validar ownership de la ambulancia (VeiculoCivil[playerid])
    // ANTES: solo chequeaba GetVehicleModel == 416, permitiendo que cualquier
    // civil con una ambulancia robada/admin-spawneada/de concesionario pudiera
    // ejecutar /Heridos y /revivir. Ahora exige que sea la ambulancia propia.
    new veh = GetPlayerVehicleID(playerid);
    if(veh != VeiculoCivil[playerid] || GetVehicleModel(veh) != 416)
        return ErrorMsg(playerid, "No estas conduciendo tu ambulancia oficial. Spawnea una en tu base.");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return ErrorMsg(playerid, "Debes ser el conductor de la ambulancia.");

    // M0-1: Fix para usar IDF con foreach (igual que /ir, /kick, /licencia)
    new targetID;
    if(sscanf(params, "i", targetID))
        return ErrorMsg(playerid, "Uso: /revivir [ID]");
    new id = -1;
    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
        {
            id = i;
            break;
        }
    }

    // FIX Bug 3.1: validar auto-revive antes que cualquier otra cosa
    if(id == playerid)
        return ErrorMsg(playerid, "No puedes rescatarte a ti mismo.");
    if(id == -1)
        return ErrorMsg(playerid, "Jugador no conectado.");

    if(MinutosMorte[id] <= 0 && SegundosMorte[id] <= 0)
        return ErrorMsg(playerid, "Ese jugador no esta herido. Si necesita curacion usa /curar [id] en el hospital.");

    // Cleanup de CP/timer previo si el paramedico tenia un rescate activo
    if(CheckMEDICO[playerid] > -1)
    {
        DestroyDynamicCP(CheckMEDICO[playerid]);
        CheckMEDICO[playerid] = -1;
    }
    if(HandleLocalizador[playerid] != -1)
        KillTimer(HandleLocalizador[playerid]);
    // FIX VERIFY-DANODMG-FIX-5 NEW-1: matar timer de Socorrer pendiente si el
    // paramedico switchea targets mid-rescate. Antes: si el paramedico iniciaba
    // rescate A (timer 6s), y a los 3s iniciaba rescate B, el timer A disparaba
    // sobre el target B (Localizando ya actualizado), permitiendo rescate remoto.
    new _socorrerTimerRev = GetPVarInt(playerid, "SocorrerTimerID");
    if(_socorrerTimerRev > 0)
    {
        KillTimer(_socorrerTimerRev);
        DeletePVar(playerid, "SocorrerTimerID");
    }

    // Iniciar el rescate: setear target y arrancar el Localizador
    Localizando[playerid] = id;
    HandleLocalizador[playerid] = SetTimerEx("Localizador", 300, false, "i", playerid);

    new String[144];
    format(String, sizeof(String), "| PARAMEDICO | Ve hacia el/la jugador/a %s (ID %d) lo mas rapido posible para socorrerlo/a", PlayerName(id), PlayerInfo[id][IDF]);
    SendClientMessage(playerid, COR_PARAMEDICO, String);
    format(String, sizeof(String), "| PARAMEDICO | El/La Socorrista %s (ID %d) esta viniendo a socorrerte, aguenta firme!", PlayerName(playerid), PlayerInfo[playerid][IDF]);
    SendClientMessage(id, COR_PARAMEDICO, String);

    return 1;
}

CMD:Heridos(playerid)
{
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Usted no tiene permisos. Solo Paramedicos.");

    // FIX Bug #3: validar ownership de la ambulancia (VeiculoCivil[playerid])
    // ANTES: solo chequeaba GetVehicleModel == 416, permitiendo que cualquier
    // civil con una ambulancia robada/admin-spawneada/de concesionario pudiera
    // ver la ubicacion de todos los heridos del server. Informacion privilegiada.
    new veh = GetPlayerVehicleID(playerid);
    if(veh != VeiculoCivil[playerid] || GetVehicleModel(veh) != 416)
        return ErrorMsg(playerid, "No estas conduciendo tu ambulancia oficial. Spawnea una en tu base.");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return ErrorMsg(playerid, "Debes ser el conductor de la ambulancia.");

    // CAMBIO 2026-07-20: mostrar triaje en la lista de heridos.
    // Orden: prioridad 1 (critico) primero, luego 2 (urgente), luego 3 (leve), luego 0 (sin clasificar).
    new stg[2000], str[120], zone[MAX_ZONE_NAME], players, Float:P[3], Float:Dist;
    format(str, sizeof(str), "{FFFFFF}Jugador(a)\t{6C28BE}Herido\t{FF0000}Triage\t{FFFFFF}Localizacion\tDistancia\n");
    strcat(stg, str);
    // FIX AUDIT6-FIX-PERF: cache strlen(stg) para evitar recomputarlo en cada iteracion
    new curLen = strlen(stg);

    // Pasada 1: prioridad 1 (critico - rojo)
    foreach(new i : Player)
    {
        if(IsPlayerConnected(i) && pLogado[i] && (MinutosMorte[i] > 0 || SegundosMorte[i] > 0) && TriagePrio[i] == 1)
        {
            GetPlayer2DZone2(i, zone, MAX_ZONE_NAME);
            GetPlayerPos(i, P[0], P[1], P[2]);
            Dist = GetPlayerDistanceFromPoint(playerid, P[0], P[1], P[2]);
            format(str, sizeof(str), "{FFFFFF}%s[%d]\t{6C28BE}%02d:%02d\t{FF0000}CRITICO\t{FFFFFF}%s\t%0.2fM\n",
                PlayerName(i), i, MinutosMorte[i], SegundosMorte[i], zone, Dist);
            {
                new strLen = strlen(str);
                if(curLen + strLen < sizeof(stg) - 1) { strcat(stg, str); curLen += strLen; }
                players++;
            }
        }
    }
    // Pasada 2: prioridad 2 (urgente - amarillo)
    foreach(new i : Player)
    {
        if(IsPlayerConnected(i) && pLogado[i] && (MinutosMorte[i] > 0 || SegundosMorte[i] > 0) && TriagePrio[i] == 2)
        {
            GetPlayer2DZone2(i, zone, MAX_ZONE_NAME);
            GetPlayerPos(i, P[0], P[1], P[2]);
            Dist = GetPlayerDistanceFromPoint(playerid, P[0], P[1], P[2]);
            format(str, sizeof(str), "{FFFFFF}%s[%d]\t{6C28BE}%02d:%02d\t{FFFF00}URGENTE\t{FFFFFF}%s\t%0.2fM\n",
                PlayerName(i), i, MinutosMorte[i], SegundosMorte[i], zone, Dist);
            {
                new strLen = strlen(str);
                if(curLen + strLen < sizeof(stg) - 1) { strcat(stg, str); curLen += strLen; }
                players++;
            }
        }
    }
    // Pasada 3: prioridad 3 (leve - verde)
    foreach(new i : Player)
    {
        if(IsPlayerConnected(i) && pLogado[i] && (MinutosMorte[i] > 0 || SegundosMorte[i] > 0) && TriagePrio[i] == 3)
        {
            GetPlayer2DZone2(i, zone, MAX_ZONE_NAME);
            GetPlayerPos(i, P[0], P[1], P[2]);
            Dist = GetPlayerDistanceFromPoint(playerid, P[0], P[1], P[2]);
            format(str, sizeof(str), "{FFFFFF}%s[%d]\t{6C28BE}%02d:%02d\t{00FF00}LEVE\t{FFFFFF}%s\t%0.2fM\n",
                PlayerName(i), i, MinutosMorte[i], SegundosMorte[i], zone, Dist);
            {
                new strLen = strlen(str);
                if(curLen + strLen < sizeof(stg) - 1) { strcat(stg, str); curLen += strLen; }
                players++;
            }
        }
    }
    // Pasada 4: sin clasificar
    foreach(new i : Player)
    {
        if(IsPlayerConnected(i) && pLogado[i] && (MinutosMorte[i] > 0 || SegundosMorte[i] > 0) && TriagePrio[i] == 0)
        {
            GetPlayer2DZone2(i, zone, MAX_ZONE_NAME);
            GetPlayerPos(i, P[0], P[1], P[2]);
            Dist = GetPlayerDistanceFromPoint(playerid, P[0], P[1], P[2]);
            format(str, sizeof(str), "{FFFFFF}%s[%d]\t{6C28BE}%02d:%02d\t{AAAAAA}--\t{FFFFFF}%s\t%0.2fM\n",
                PlayerName(i), i, MinutosMorte[i], SegundosMorte[i], zone, Dist);
            {
                new strLen = strlen(str);
                if(curLen + strLen < sizeof(stg) - 1) { strcat(stg, str); curLen += strLen; }
                players++;
            }
        }
    }

    if(players > 0)
    {
        new TituloD[55];
        format(TituloD, sizeof(TituloD), "{FFFFFF}Heridos [ {1E90FF}%d {FFFFFF}]", players);
        ShowPlayerDialog(playerid, 555, DIALOG_STYLE_TABLIST_HEADERS, TituloD, stg, "Salir", "");
    }
    else
    {
        ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{FFFFFF}Heridos",
            "\n{FF0000}Ningun jugador herido en este momento", "Salir", "");
    }
    return 1;
}

// =====================================================================
// CAMBIO 2026-07-20 - Sistema de Triaje Hospitalario
// Comando: /triage [id] [1-3] - Asignar prioridad de atencion a un herido
// Requisitos: Org == 10, uniforme vestido, paciente herido, paciente cerca (5m)
// Prioridades:
//   1 = CRITICO (rojo) - muerte inminente, atender primero
//   2 = URGENTE (amarillo) - herido grave, atender segundo
//   3 = LEVE (verde) - herido estable, atender al final
// Bonificacion de pago al revivir jugadores con triaje:
//   P1: +50% pago, P2: +25% pago, P3: pago normal
// =====================================================================
CMD:triage(playerid, params[])
{
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Solo los Paramedicos pueden hacer triaje.");
    if(!paramedico[playerid])
        return ErrorMsg(playerid, "Debes vestir el uniforme primero. Ve a un punto de equipamiento (F).");
    // P1-MED-2: requiere rango 2+ (Paramedico), con fallback si no hay rangos 2+ conectados
    if(PlayerInfo[playerid][Cargo] < 2)
    {
        if(HayParamedicoRangoMinOnline(2))
            return ErrorMsg(playerid, "El triaje requiere rango Paramedico (2+). Hay un Paramedico de mayor rango conectado, espera su atencion.");
        // Fallback: no hay ningun paramedico rango 2+ conectado, se permite al Enfermero
    }
    // M0-1: Fix para usar IDF con foreach
    new targetID, prio;
    if(sscanf(params, "ii", targetID, prio))
        return ErrorMsg(playerid, "Uso: /triage [ID] [1-3] (1=critico, 2=urgente, 3=leve)");
    new id = -1;
    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
        {
            id = i;
            break;
        }
    }
    if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
    if(playerid == id)
        return ErrorMsg(playerid, "No puedes hacerte triaje a ti mismo.");
    if(prio < 1 || prio > 3)
        return ErrorMsg(playerid, "Prioridad invalida. Usa: 1=critico, 2=urgente, 3=leve.");

    // Validar que el target este herido
    if(MinutosMorte[id] <= 0 && SegundosMorte[id] <= 0)
        return ErrorMsg(playerid, "Ese jugador no esta herido. Solo se hace triaje a heridos.");

    // Validar proximidad (5 metros - mas largo que /curar porque es solo clasificacion)
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(id, px, py, pz);
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, px, py, pz))
        return ErrorMsg(playerid, "Debes estar a maximo 5 metros del herido para hacer triaje.");

    // Aplicar triaje
    TriagePrio[id] = prio;
    TriageMedico[id] = playerid;

    new prioName[16], prioColor[16], prioTag[32];
    if(prio == 1) { prioName = "CRITICO"; prioColor = "{FF0000}"; prioTag = "{FF0000}[P1]"; }
    else if(prio == 2) { prioName = "URGENTE"; prioColor = "{FFFF00}"; prioTag = "{FFFF00}[P2]"; }
    else { prioName = "LEVE"; prioColor = "{00FF00}"; prioTag = "{00FF00}[P3]"; }

    new msg[160];
    format(msg, sizeof(msg), "| TRIAGE | Has clasificado a %s (ID %d) como %s%s{FFFFFF}.", PlayerName(id), PlayerInfo[id][IDF], prioColor, prioName);
    SendClientMessage(playerid, 0x6C28BEFF, msg);

    format(msg, sizeof(msg), "| TRIAGE | El paramedico %s (ID %d) te clasifico como %s%s{FFFFFF}. Atender prioridad: %s.",
        PlayerName(playerid), PlayerInfo[playerid][IDF], prioColor, prioName, prioName);
    SendClientMessage(id, 0x6C28BEFF, msg);

    // Efecto visual en el herido
    GameTextForPlayer(id, prioTag, 3000, 4);
    return 1;
}

// =====================================================================
// CAMBIO 2026-07-20 - Comando /yeso [id]
// Permite a los paramedicos enyesar fracturas de los jugadores.
// Requisitos: Org == 10, uniforme vestido, paciente cerca (3m), paciente con fractura
// Debe estar en hospital (interior o cerca de hospital)
// No cobra: el yeso es un procedimiento medico basico gratuito
// =====================================================================
CMD:yeso(playerid, params[])
{
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Solo los Paramedicos pueden enyesar fracturas.");
    if(!paramedico[playerid])
        return ErrorMsg(playerid, "Debes vestir el uniforme primero. Ve a un punto de equipamiento (F).");
    // P1-MED-3: requiere rango 2+ (Paramedico), con fallback si no hay rangos 2+ conectados
    if(PlayerInfo[playerid][Cargo] < 2)
    {
        if(HayParamedicoRangoMinOnline(2))
            return ErrorMsg(playerid, "Enyesar requiere rango Paramedico (2+). Hay un Paramedico de mayor rango conectado, espera su atencion.");
        // Fallback: no hay ningun paramedico rango 2+ conectado, se permite al Enfermero
    }
    // FIX AUDITORIA 2026-07-20: agregar validacion de hospital como /curar
    if(!IsPlayerInDynamicArea(playerid, AreaHospital) && !IsPlayerInDynamicArea(playerid, AreaHospitalPequeno))
        return ErrorMsg(playerid, "Solo puedes usar /yeso en el Area de Atencion Medica del Hospital.");
    // M0-1: Fix para usar IDF con foreach
    new targetID;
    if(sscanf(params, "i", targetID))
        return ErrorMsg(playerid, "Uso: /yeso [ID]");
    new id = -1;
    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
        {
            id = i;
            break;
        }
    }
    if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
    if(playerid == id)
        return ErrorMsg(playerid, "No puedes enyesarte a ti mismo.");
    if(IsPlayerInAnyVehicle(playerid))
        return ErrorMsg(playerid, "Sal del vehiculo para enyesar.");

    // Validar que el target tenga fractura
    if(Fractura[id] == 0)
        return ErrorMsg(playerid, "Ese jugador no tiene fractura. Solo se enyesa fracturas confirmadas.");

    // Validar proximidad (3 metros)
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(id, px, py, pz);
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, px, py, pz))
        return ErrorMsg(playerid, "Debes estar a maximo 3 metros del paciente.");

    // Aplicar yeso
    new fracName[16];
    if(Fractura[id] == 1) fracName = "el brazo";
    else if(Fractura[id] == 2) fracName = "la pierna";
    else fracName = "las costillas";

    Fractura[id] = 0;
    FracturaTick[id] = 0;

    new msg[160];
    format(msg, sizeof(msg), "| PARAMEDICO | Has enyesado a %s (ID %d) en %s. Fractura curada.", PlayerName(id), PlayerInfo[id][IDF], fracName);
    SendClientMessage(playerid, 0x6C28BEFF, msg);

    format(msg, sizeof(msg), "| PARAMEDICO | El paramedico %s (ID %d) te enyeso %s. Tu fractura ha sido curada!",
        PlayerName(playerid), PlayerInfo[playerid][IDF], fracName);
    SendClientMessage(id, 0x228B22FF, msg);

    // Animacion de procedimiento medico
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
    GameTextForPlayer(id, "~g~Fractura curada!", 3000, 3);
    return 1;
}

// =====================================================================
// SISTEMA MEDICO - ORG 10 (PARAMEDICOS)
// Comando: /curar [id] - Cura a un jugador cercano (vida + hambre + sed)
// Requisitos: Org == 10, no en vehiculo, paciente cerca (3m), paciente vivo
//
// CAMBIO 2026-07-20: Cobro escalonado automatico segun gravedad.
// El paramedico NO puede modificar el precio (evita corrupcion medica).
// Flujo:
//   1. Paramedico usa /curar [id]
//   2. Sistema calcula costo segun condicion del paciente
//   3. Se muestra dialog al PACIENTE (no al paramedico) con detalle y precio
//   4. Paciente acepta/rechaza el pago
//   5. Si acepta y tiene dinero: se cobra y se cura
//   6. Si rechaza o no tiene dinero: no se cura
//
// Tabla de precios (acumulativa):
//   HP/Hambre/Sed (base)              $200
//   + Fractura                        $300
//   + Enfermedad (cualquiera)         $300
//   + Quemadura grado 1               $700  (mas cara que pomada $800... pero cura TODO)
//   + Quemadura grado 2               $900
//   + Quemadura grado 3               $1500 (solo paramedico puede curar)
// =====================================================================
CMD:curar(playerid, params[])
{
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Solo los Paramedicos pueden curar.");
    if(!paramedico[playerid])
        return ErrorMsg(playerid, "Debes vestir el uniforme primero. Ve a un punto de equipamiento (F) en tu base u hospital.");
    if(!IsPlayerInDynamicArea(playerid, AreaHospital) && !IsPlayerInDynamicArea(playerid, AreaHospitalPequeno))
        return ErrorMsg(playerid, "Solo puedes usar /curar en el Area de Atencion Medica del Hospital (interior 5, mira el texto rosado).");
    // M0-1: Fix para usar IDF con foreach (igual que /ir, /kick, /licencia)
    new targetID;
    if(sscanf(params, "i", targetID))
        return ErrorMsg(playerid, "Uso: /curar [ID]");
    new id = -1;
    foreach(new i : Player)
    {
        if(pLogado[i] && PlayerInfo[i][IDF] == targetID)
        {
            id = i;
            break;
        }
    }
    if(id == -1) return ErrorMsg(playerid, "Jugador no conectado.");
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(id, px, py, pz);
    if(GetPlayerDistanceFromPoint(playerid, px, py, pz) > 3.0)
        return ErrorMsg(playerid, "El jugador no esta cerca tuyo (max 3m).");
    if(playerid == id)
        return ErrorMsg(playerid, "No puedes curarte a ti mismo. Usa /usarkit.");
    if(MinutosMorte[id] > 0 || SegundosMorte[id] > 0)
        return ErrorMsg(playerid, "El jugador esta herido. Usa /revivir para rescatarlo.");

    new Float:hp; GetPlayerHealth(id, hp);
    if(hp >= 100.0 && FomePlayer[id] >= 100 && SedePlayer[id] >= 100
        && Sangrando[id] == false && Enfermedad[id] == 0 && Fractura[id] == 0 && Quemadura[id] == 0)
        return ErrorMsg(playerid, "El jugador ya esta completamente curado. No necesita atencion medica.");

    // =====================================================================
    // CAMBIO 2026-07-20: Calcular costo escalonado segun gravedad
    // =====================================================================
    new costoTotal = 200; // base: HP + hambre + sed + sangrado
    new detalleStr[256];
    format(detalleStr, sizeof(detalleStr), "{FFFFFF}Servicio basico (HP + hambre + sed + sangrado)\t{228B22}$200\n");

    // Fractura: +$300
    if(Fractura[id] > 0)
    {
        costoTotal += 300;
        new fracName[16];
        if(Fractura[id] == 1) fracName = "brazo";
        else if(Fractura[id] == 2) fracName = "pierna";
        else fracName = "costillas";
        new line[80];
        format(line, sizeof(line), "{FFFFFF}Enyesado de fractura (%s)\t{228B22}$300\n", fracName);
        strcat(detalleStr, line);
    }

    // Enfermedad: +$300 (cualquier tipo)
    if(Enfermedad[id] > 0)
    {
        costoTotal += 300;
        new enfName[24];
        if(Enfermedad[id] == 1) enfName = "gripe";
        else if(Enfermedad[id] == 2) enfName = "infeccion";
        else if(Enfermedad[id] == 3) enfName = "intoxicacion";
        else if(Enfermedad[id] == 4) enfName = "neumonia";
        else if(Enfermedad[id] == 5) enfName = "fiebre";
        else enfName = "alergia";
        new line[80];
        format(line, sizeof(line), "{FFFFFF}Tratamiento de %s\t{228B22}$300\n", enfName);
        strcat(detalleStr, line);
    }

    // Quemaduras: costo variable segun grado
    if(Quemadura[id] > 0)
    {
        new costoQue = 0;
        new queName[32];
        if(Quemadura[id] == 1) { costoQue = 700; queName = "quemadura grado 1 (leve)"; }
        else if(Quemadura[id] == 2) { costoQue = 900; queName = "quemadura grado 2 (media)"; }
        else { costoQue = 1500; queName = "quemadura grado 3 (grave)"; }
        costoTotal += costoQue;
        new line[100];
        format(line, sizeof(line), "{FFFFFF}Tratamiento de %s\t{228B22}$%d\n", queName, costoQue);
        strcat(detalleStr, line);
    }

    // Guardar info del cobro para usar en el dialog
    CurarTarget[id] = playerid;
    CurarCosto[id] = costoTotal;
    CurarDetalle[id] = detalleStr;

    // Construir mensaje del dialog
    new dialogStr[512];
    format(dialogStr, sizeof(dialogStr),
        "{FFFFFF}El paramedico {FF69B4}%s[%d]{FFFFFF} desea curarte.\n\n{FFFF00}Servicios a aplicar:\n%s\n{FFFF00}Costo total: {228B22}$%d\n\n{FFFFFF}Deseas aceptar el tratamiento?",
        PlayerName(playerid), playerid, detalleStr, costoTotal);

    new titleStr[128];
    format(titleStr, sizeof(titleStr), "{FFFFFF}Atencion Medica - Total: {228B22}$%d", costoTotal);

    // Mostrar dialog al PACIENTE (no al paramedico)
    ShowPlayerDialog(id, DIALOG_CURAR_PAGO, DIALOG_STYLE_MSGBOX, titleStr, dialogStr, "Aceptar", "Rechazar");

    // Avisar al paramedico que espera confirmacion
    new msgMed[160];
    format(msgMed, sizeof(msgMed), "| PARAMEDICO | Solicitaste curar a %s[%d]. Costo: $%d. Esperando confirmacion del paciente...", PlayerName(id), id, costoTotal);
    SendClientMessage(playerid, COR_PARAMEDICO, msgMed);
    return 1;
}

// COMANDO /curarid ELIMINADO - Bug #2: no tenia restriccion geografica.
// Cualquier paramedico podia curar a cualquier jugador desde cualquier punto
// del mapa, rompiendo RP y permitiendo farming de curaciones.
// Toda curacion presencial de paramedico ahora pasa por /curar (en hospital, 3m).
// Si en el futuro se necesita cura en la base medica, se implementara con un
// area propia y validaciones correctas (no como hack sobre /curarid).

// =====================================================================
// SISTEMA MEDICO - ORG 10 (PARAMEDICOS)
// Comando: /reanimar [id] - Reanimacion directa a pie (sin ambulancia)
// Requisitos: Org == 10, uniforme vestido, paciente cerca (3m), paciente herido
// Caso de uso: el paramedico ya esta junto al herido (llego a pie, o esta
// en el hospital cuando entra un herido). No requiere CP ni rescate.
// No da pago: el pago oficial del rescate es via /revivir (ambulancia).
// Este comando es para emergencias donde la vida del herido corre riesgo
// inmediato y no hay tiempo de esperar el CP.
// =====================================================================
CMD:reanimar(playerid, params[])
{
    new id;
    if(PlayerInfo[playerid][Org] != 10)
        return ErrorMsg(playerid, "Solo los Paramedicos pueden reanimar.");
    if(!paramedico[playerid])
        return ErrorMsg(playerid, "Debes vestir el uniforme primero. Ve a un punto de equipamiento (F) en tu base u hospital.");
    if(sscanf(params, "i", id))
        return ErrorMsg(playerid, "Uso: /reanimar [ID]");
    if(!IsPlayerConnected(id))
        return ErrorMsg(playerid, "Jugador no conectado.");
    if(playerid == id)
        return ErrorMsg(playerid, "No puedes reanimarte a ti mismo.");

    // Validar que el target este herido
    if(MinutosMorte[id] <= 0 && SegundosMorte[id] <= 0)
        return ErrorMsg(playerid, "Ese jugador no esta herido. Si necesita curacion usa /curar [id].");

    // No desde vehiculo (a pie). Si esta en ambulancia debe usar /revivir [id].
    if(IsPlayerInAnyVehicle(playerid))
        return ErrorMsg(playerid, "Sal del vehiculo para reanimar. Si estas en ambulancia usa /revivir [id].");

    // Validar proximidad (3 metros)
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(id, px, py, pz);
    if(GetPlayerDistanceFromPoint(playerid, px, py, pz) > 3.0)
        return ErrorMsg(playerid, "El jugador no esta cerca tuyo (max 3m).");

    // Cleanup de estado de rescate previo si el paramedico tenia uno activo
    // (evita leak de CP/timer fantasma)
    if(Localizando[playerid] != -1)
    {
        if(CheckMEDICO[playerid] > -1)
        {
            DestroyDynamicCP(CheckMEDICO[playerid]);
            CheckMEDICO[playerid] = -1;
        }
        Localizando[playerid] = -1;
    }
    if(HandleLocalizador[playerid] != -1)
    {
        KillTimer(HandleLocalizador[playerid]);
        HandleLocalizador[playerid] = -1;
    }

    // Cleanup completo del estado de muerte del target
    MinutosMorte[id] = 0;
    SegundosMorte[id] = 0;
    // FIX BUG #1: resetear XMorte/YMorte/ZMorte a -1 antes de SpawnPlayer.
    // Sin esto, OnPlayerSpawn detecta al jugador cerca de XMorte (porque quedo
    // congelado en su sitio de muerte) y lo vuelve a marcar como herido.
    XMorte[id] = -1; YMorte[id] = -1; ZMorte[id] = -1;
    TriagePrio[id] = 0; // CAMBIO 2026-07-20: reset triaje al reanimar
    TriageMedico[id] = -1;
    if(SangueObjeto[id] > -1)
    {
        DestroyObject(SangueObjeto[id]);
        SangueObjeto[id] = -1;
    }
    for(new t = 0; t < 7; t++)
        PlayerTextDrawHide(id, TelaMorteCDA[id][t]);

                    // FIX AUDIT MEDICO MED-A5-10: reset MostrandoTelaMorte al revivir.
                    MostrandoTelaMorte[id] = false;    // FIX AUDIT MEDICO MED-A5-04: ocultar LogoBZ al reanimar (/reanimar target).
    for(new _t = 0; _t < 5; _t++)
        TextDrawHideForPlayer(id, LogoBZ[_t]);

    // Restaurar estado del target
    SetPlayerHealth(id, 100.0);
    FomePlayer[id] = 50;
    SedePlayer[id] = 50;
    // FIX AUDIT ANIM ANIM-A2-06/A3-13 (CRITICO): no descongelar algemado.
    if(!PlayerInfo[id][pCongelado])
        TogglePlayerControllable(id, 1);
    SetTimerEx("SpawnP", 500, false, "i", id);
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);

    // Notificaciones
    new msg[128];
    format(msg, sizeof(msg), "| PARAMEDICO | Reanimaste a %s. Vida restaurada.", PlayerName(id));
    SendClientMessage(playerid, COR_PARAMEDICO, msg);
    format(msg, sizeof(msg), "| PARAMEDICO | El Paramedico %s te reanimo.", PlayerName(playerid));
    SendClientMessage(id, COR_PARAMEDICO, msg);
    GameTextForPlayer(id, "~g~Reanimado", 2000, 3);

    return 1;
}

// Fase 1: Comando para usar un Kit Medico del inventario del jugador.
// Cura +50 HP (topado a 100). No usable estando herido (debe llamar al 192).
CMD:usarkit(playerid)
{
        if(KitsMedicos[playerid] <= 0)
            return ErrorMsg(playerid, "No tienes Kits Medicos. Compra uno en el Hospital.");

        // CAMBIO 2026-07-09 - Bug #14.B: cooldown anti-combat de 15 segundos.
        // Antes: spameable en combate para curarse 50HP instantaneo (inmortalidad).
        // Ahora: 1 kit por cada 15s, no se puede spamear en skirmish.
        new lastKit = GetPVarInt(playerid, "KitCooldown");
        new now = gettime();
        if(now - lastKit < 15)
        {
            new cdMsg[100];
            format(cdMsg, sizeof(cdMsg), "Debes esperar %d segundos para usar otro kit.", 15 - (now - lastKit));
            return ErrorMsg(playerid, cdMsg);
        }

        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
            return ErrorMsg(playerid, "Estas herido, no puedes usar un kit. Llama al 192 o usa /hospital.");

        new Float:hp; GetPlayerHealth(playerid, hp);
        if(hp >= 100.0)
            return ErrorMsg(playerid, "Tu vida ya esta llena.");

        new Float:newhp = hp + 50.0;
        if(newhp > 100.0) newhp = 100.0;

        KitsMedicos[playerid] -= 1;
        SetPlayerHealth(playerid, newhp);
        SetPVarInt(playerid, "KitCooldown", now);
        
        // CAMBIO 2026-07-18: Kit medico detiene el sangrado
        if(Sangrando[playerid])
        {
            Sangrando[playerid] = false;
            SangradoTick[playerid] = 0;
            SendClientMessage(playerid, -1, "| HOSPITAL | El kit medico detuvo el sangrado.");
        }

        new msg[128];
        format(msg, sizeof(msg), "| HOSPITAL | Usaste un Kit Medico. Vida: %.0f%%. Kits restantes: %d/%d", newhp, KitsMedicos[playerid], MAX_KITS_MEDICOS);
        SendClientMessage(playerid, -1, msg);
        GameTextForPlayer(playerid, "~g~+50 HP", 2000, 3);
        ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
        return 1;
}

// FASE 7.3: Kit de Reparacion - cura 30 HP (mas debil que kit medico de 50 HP)
// Es un item del inventario (model 19634). Se consume al usarlo.
// No detiene sangrado (solo cura HP). Cooldown anti-combat de 10 segundos.
CMD:usarkitrep(playerid)
{
        if(!pLogado[playerid]) return ErrorMsg(playerid, "Debes estar logueado.");
        // Buscar el Kit de Reparacion en el inventario
        new tieneKit = false;
        new slotKit = -1;
        for(new s = 0; s < 33; s++)
        {
                if(PlayerInventario[playerid][s][Slot] == ITEM_KITREP && PlayerInventario[playerid][s][Unidades] > 0)
                {
                        tieneKit = true;
                        slotKit = s;
                        break;
                }
        }
        if(!tieneKit)
                return ErrorMsg(playerid, "No tienes Kit de Reparacion. Compra uno en la Tienda 24/7 o Tienda Ilegal.");
        // Cooldown anti-combat de 10 segundos (mas corto que kit medico por ser mas debil)
        new now = gettime();
        new lastKitRep = GetPVarInt(playerid, "KitRepCooldown");
        if(now - lastKitRep < 10)
        {
                new cdMsg[100];
                format(cdMsg, sizeof(cdMsg), "Debes esperar %d segundos para usar otro Kit de Reparacion.", 10 - (now - lastKitRep));
                return ErrorMsg(playerid, cdMsg);
        }
        // No se puede usar si esta herido (en proceso de muerte)
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
                return ErrorMsg(playerid, "Estas herido, no puedes usar un kit. Llama al 192 o usa /hospital.");
        // Verificar HP actual
        new Float:hp; GetPlayerHealth(playerid, hp);
        if(hp >= 100.0)
                return ErrorMsg(playerid, "Tu vida ya esta llena.");
        // Curar 30 HP (maximo 100)
        new Float:newhp = hp + 30.0;
        if(newhp > 100.0) newhp = 100.0;
        // Consumir el kit del inventario
        PlayerInventario[playerid][slotKit][Unidades]--;
        if(PlayerInventario[playerid][slotKit][Unidades] <= 0)
                PlayerInventario[playerid][slotKit][Slot] = -1; // limpiar slot si quedo vacio
        AtualizarInventario(playerid, slotKit);
        SalvarInventario(playerid);
        // Aplicar cura
        SetPlayerHealth(playerid, newhp);
        SetPVarInt(playerid, "KitRepCooldown", now);
        new msg[160];
        format(msg, sizeof(msg), "| REPARACION | Usaste un Kit de Reparacion. Vida: %.0f%%.", newhp);
        SendClientMessage(playerid, -1, msg);
        GameTextForPlayer(playerid, "~g~+30 HP", 2000, 3);
        ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
        printf("[P0-FASE7-3] Jugador %d uso Kit de Reparacion. HP: %.0f -> %.0f", playerid, hp, newhp);
        return 1;
}

// =====================================================================
// CAMBIO 2026-07-18 - /usarvendaje: cura +30 HP pero inicia sangrado
// El sangrado baja 1 HP cada 10s hasta que un medico cure o use kit
// =====================================================================
CMD:usarvendaje(playerid)
{
        if(Vendajes[playerid] <= 0)
            return ErrorMsg(playerid, "No tienes vendajes. Compra uno en la Farmacia u Hospital.");

        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
            return ErrorMsg(playerid, "Estas herido, no puedes usar un vendaje. Llama al 192.");

        new Float:hp; GetPlayerHealth(playerid, hp);
        if(hp >= 100.0)
            return ErrorMsg(playerid, "Tu vida ya esta llena.");

        new Float:newhp = hp + 30.0;
        if(newhp > 100.0) newhp = 100.0;

        Vendajes[playerid] -= 1;
        SetPlayerHealth(playerid, newhp);
        
        // Iniciar sangrado: las vendas solo tapan la herida temporalmente
        Sangrando[playerid] = true;
        SangradoTick[playerid] = 0;

        new msg[128];
        format(msg, sizeof(msg), "| VENDAJE | Usaste un vendaje. Vida: %.0f%%. Vendajes restantes: %d/%d", newhp, Vendajes[playerid], MAX_VENDAJES);
        SendClientMessage(playerid, -1, msg);
        SendClientMessage(playerid, 0xFF4444FF, "| VENDAJE | {FF0000}ATENCION: Estas sangrando! Ve a un medico o usa un kit medico para detenerlo.");
        GameTextForPlayer(playerid, "~g~+30 HP ~r~Sangrando!", 3000, 3);
        ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
        return 1;
}

// =====================================================================
// CAMBIO 2026-07-20 - Items de cura para enfermedades
// El jugador compra estos items en farmacia SOLO si tiene receta medica.
// Cada item cura una enfermedad especifica. Se usan cuando el jugador quiera.
// Comparten cura entre enfermedades similares:
//   - Antigripal: cura Gripe (1) y Alergia (6)
//   - Antibiotico: cura Infeccion (2) y Fiebre (5)
//   - Suero: cura Intoxicacion (3)
// Neumonia (4) NO se cura con items, requiere paramedico con /curar
// =====================================================================
CMD:usarantigripal(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Necesitas estar logueado.");
    if(ItemAntigripal[playerid] <= 0)
        return ErrorMsg(playerid, "No tienes antigripal. Compralo en la farmacia con receta medica.");

    // Solo cura si tiene gripe o alergia
    if(Enfermedad[playerid] != 1 && Enfermedad[playerid] != 6)
        return ErrorMsg(playerid, "No tienes gripe ni alergia. No necesitas antigripal.");

    new enfName[16];
    if(Enfermedad[playerid] == 1) enfName = "gripe";
    else enfName = "alergia";

    ItemAntigripal[playerid] --;
    Enfermedad[playerid] = 0;
    EnfermedadTick[playerid] = 0;
    EnfermedadTiempo[playerid] = 0;
    TieneReceta[playerid] = 0;

    new msg[128];
    format(msg, sizeof(msg), "| MEDICINA | Usaste un antigripal. Tu %s ha sido curada!", enfName);
    SendClientMessage(playerid, 0x228B22FF, msg);
    GameTextForPlayer(playerid, "~g~Curado!", 2000, 3);
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
    return 1;
}

CMD:usarantibiotico(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Necesitas estar logueado.");
    if(ItemAntibiotico[playerid] <= 0)
        return ErrorMsg(playerid, "No tienes antibiotico. Compralo en la farmacia con receta medica.");

    // Solo cura si tiene infeccion o fiebre
    if(Enfermedad[playerid] != 2 && Enfermedad[playerid] != 5)
        return ErrorMsg(playerid, "No tienes infeccion ni fiebre. No necesitas antibiotico.");

    new enfName[16];
    if(Enfermedad[playerid] == 2) enfName = "infeccion";
    else enfName = "fiebre";

    ItemAntibiotico[playerid] --;
    Enfermedad[playerid] = 0;
    EnfermedadTick[playerid] = 0;
    EnfermedadTiempo[playerid] = 0;
    TieneReceta[playerid] = 0;

    new msg[128];
    format(msg, sizeof(msg), "| MEDICINA | Usaste un antibiotico. Tu %s ha sido curada!", enfName);
    SendClientMessage(playerid, 0x228B22FF, msg);
    GameTextForPlayer(playerid, "~g~Curado!", 2000, 3);
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
    return 1;
}

CMD:usarsuero(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Necesitas estar logueado.");
    if(ItemSuero[playerid] <= 0)
        return ErrorMsg(playerid, "No tienes suero. Compralo en la farmacia con receta medica.");

    // Solo cura si tiene intoxicacion
    if(Enfermedad[playerid] != 3)
        return ErrorMsg(playerid, "No tienes intoxicacion. No necesitas suero.");

    ItemSuero[playerid] --;
    Enfermedad[playerid] = 0;
    EnfermedadTick[playerid] = 0;
    EnfermedadTiempo[playerid] = 0;
    TieneReceta[playerid] = 0;

    SendClientMessage(playerid, 0x228B22FF, "| MEDICINA | Usaste un suero. Tu intoxicacion ha sido curada!");
    GameTextForPlayer(playerid, "~g~Curado!", 2000, 3);
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
    return 1;
}

// =====================================================================
// CAMBIO 2026-07-20 - /usarpomada
// Cura quemaduras grado 1 (leve) y grado 2 (medio).
// NO cura grado 3 (grave - requiere paramedico con /curar).
// =====================================================================
CMD:usarpomada(playerid)
{
    if(!pLogado[playerid]) return ErrorMsg(playerid, "Necesitas estar logueado.");
    if(ItemPomada[playerid] <= 0)
        return ErrorMsg(playerid, "No tienes pomada. Comprala en la farmacia por $800.");

    // Validar que tenga quemadura curable
    if(Quemadura[playerid] == 0)
        return ErrorMsg(playerid, "No tienes quemaduras. No necesitas pomada.");
    if(Quemadura[playerid] == 3)
        return ErrorMsg(playerid, "Tienes quemadura grado 3 (grave). La pomada no es suficiente. Necesitas un paramedico con /curar.");

    ItemPomada[playerid] --;
    new gradoName[16];
    if(Quemadura[playerid] == 1) gradoName = "leve (grado 1)";
    else gradoName = "media (grado 2)";
    Quemadura[playerid] = 0;
    QuemaduraTick[playerid] = 0;

    new msg[160];
    format(msg, sizeof(msg), "| MEDICINA | Usaste pomada. Tu quemadura %s ha sido curada!", gradoName);
    SendClientMessage(playerid, 0x228B22FF, msg);
    GameTextForPlayer(playerid, "~g~Quemadura curada!", 2000, 3);
    ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
    return 1;
}

// COMANDOS /vestiruniforme y /removeruniforme ELIMINADOS - Bug #4.
// Razones:
//   1. No actualizaban el flag paramedico[playerid], rompiendo spawn de
//      ambulancia y /reanimar (que requieren el flag en true).
//   2. Solo ofrecian 2 skins (vs las 4 del menu F DIALOG_ROPAMED).
//   3. Restringian skin por sexo, el menu F no (mas flexible).
//   4. Eran redundantes con el menu F que ya funciona correctamente.
// Todo vestido/retiro de uniforme ahora pasa exclusivamente por el menu F
// en los PosEquipar (interior 5 hospital + exterior SF).
// Los paramÃ¯Â¿Â½dicos deben pararse en un punto F y presionar la tecla F.

CMD:levantar(playerid)
{
        // FIX AUDIT ANIM ANIM-A1-08/A2-02/A3-01/A4-15 (CRITICO): validaciones de estado.
        // ANTES: /levantar no validaba nada. Un herido (1M HP, CRCKIDLE4) podia
        // sobrescribir con getup_front y caminar invulnerable. Un algemado podia
        // sobrescribir CUFFED visualmente.
        if(pLogado[playerid] == false) return ErrorMsg(playerid, "Usted no esta registrado.");
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return ErrorMsg(playerid, "No puedes hacer eso ahora.");
        if(IsPlayerInAnyVehicle(playerid)) return ErrorMsg(playerid, "Sal del vehiculo primero.");
        if(PlayerInfo[playerid][pCongelado]) return ErrorMsg(playerid, "No puedes levantarte estando algemado.");
        if(MinutosMorte[playerid] > 0) return ErrorMsg(playerid, "Estas herido. No puedes levantarte solo, ve al hospital.");
        if(g_DormindoODescansando[playerid]) return ErrorMsg(playerid, "Estas durmiendo o descansando.");
        ApplyAnimation( playerid, "PED", "getup_front", 4.1, 0, 0, 0, 0, 0, 1);
        return 1;
}

//                          COMANDOS

CMD:cuenta(playerid)
{
        // CAMBIO 2026-07-09 - Bug #7 (mejora UX): aumentado megastrings de 500 a 800
        // para que las nuevas lineas de Kits Medicos no trunquen el dialog.
        new megastrings[800], String2[500];

        format(String2,sizeof(String2), "{FFFFFF}Su VIP: {FFFF00}%s\n{FFFFFF}Nombre: {FFFF00}%s{FFFFFF}({FFFF00}%04d{FFFFFF})\n{FFFFFF}Email: {FFFF00}%s\n{FFFFFF}Dispositivo: {FFFF00}%s\n", VIP(playerid),Name(playerid), GetPlayerIdfixo(playerid), PlayerInfo[playerid][pEmail],Dispositivo(playerid));
        strcat(megastrings, String2);
        format(String2,sizeof(String2), "{FFFFFF}Tiempo de juego:{FFFF00} %s\n{FFFFFF}Coins:{FFFF00} %s\n{FFFFFF}Dinero:{FFFF00} %s\n", convertNumber(PlayerInfo[playerid][pSegundosJogados]), ConvertMoney(PlayerInfo[playerid][pCoins]), ConvertMoney(PlayerInfo[playerid][pDinheiro]));
        strcat(megastrings, String2);
        format(String2,sizeof(String2), "{FFFFFF}Banco:{FFFF00} %s\n{FFFFFF}Avisos:{FFFF00} %s\n{FFFFFF}trabajos:{FFFF00} %s\n{FFFFFF}Faccion:{FFFF00} %s\n", ConvertMoney(PlayerInfo[playerid][pBanco]), ConvertMoney(PlayerInfo[playerid][pAvisos]),Profs(playerid),NomeOrg(playerid));
        strcat(megastrings, String2);
        format(String2,sizeof(String2), "{FFFFFF}Multas:{FFFF00} %s\n{FFFFFF}Casa ID:{FFFF00} %d\n{FFFFFF}CNH: {FFFF00}%s", ConvertMoney(PlayerInfo[playerid][pMultas]), PlayerInfo[playerid][Casa], temlicenca(playerid));
        strcat(megastrings, String2);

        // CAMBIO 2026-07-09 - Bug #7 (mejora UX): mostrar kits en /cuenta
        // - Todos los jugadores ven sus kits medicos con tope (X/45)
        // - Solo paramedicos (Org 10) ven ademas el tope de kits gratis por payday (Y/20)
        format(String2, sizeof(String2), "\n{FFFFFF}Kits Medicos: {FF69B4}%d/%d", KitsMedicos[playerid], MAX_KITS_MEDICOS);
        strcat(megastrings, String2);
        format(String2, sizeof(String2), "\n{FFFFFF}Vendajes: {FF69B4}%d/%d", Vendajes[playerid], MAX_VENDAJES);
        strcat(megastrings, String2);
        if(Sangrando[playerid])
        {
            format(String2, sizeof(String2), "\n{FF0000}ESTAS SANGRANDO!{FFFFFF} Ve a un medico.");
            strcat(megastrings, String2);
        }
        if(Enfermedad[playerid] > 0)
        {
            new enfName[32];
            if(Enfermedad[playerid] == 1) enfName = "{FFA500}Gripe";
            else if(Enfermedad[playerid] == 2) enfName = "{FF0000}Infeccion";
            else if(Enfermedad[playerid] == 3) enfName = "{FF0000}Intoxicacion";
            else if(Enfermedad[playerid] == 4) enfName = "{FF0000}Neumonia";
            else if(Enfermedad[playerid] == 5) enfName = "{FF6600}Fiebre";
            else if(Enfermedad[playerid] == 6) enfName = "{9933CC}Alergia";
            format(String2, sizeof(String2), "\n{FFFFFF}Enfermedad: %s", enfName);
            strcat(megastrings, String2);
        }
        // CAMBIO 2026-07-20: mostrar fractura en /cuenta
        if(Fractura[playerid] > 0)
        {
            new fracName[32];
            if(Fractura[playerid] == 1) fracName = "{FF6600}Brazo";
            else if(Fractura[playerid] == 2) fracName = "{FF0000}Pierna";
            else fracName = "{FF6600}Costillas";
            new tiempoRestante = 600 - FracturaTick[playerid];
            new minRest = tiempoRestante / 60;
            format(String2, sizeof(String2), "\n{FFFFFF}Fractura: %s{FFFFFF} (auto-cura en %dm)", fracName, minRest);
            strcat(megastrings, String2);
        }
        // CAMBIO 2026-07-20: mostrar quemadura en /cuenta
        if(Quemadura[playerid] > 0)
        {
            new queName[32];
            if(Quemadura[playerid] == 1) queName = "{FFAA00}Grado 1 (leve)";
            else if(Quemadura[playerid] == 2) queName = "{FF6600}Grado 2 (media)";
            else queName = "{FF0000}Grado 3 (grave)";
            format(String2, sizeof(String2), "\n{FFFFFF}Quemadura: %s", queName);
            strcat(megastrings, String2);
            if(Quemadura[playerid] == 3)
            {
                format(String2, sizeof(String2), "\n{FF0000}Requiere paramedico con /curar");
                strcat(megastrings, String2);
            }
            else if(ItemPomada[playerid] > 0)
            {
                format(String2, sizeof(String2), "\n{228B22}Usa /usarpomada para curarte");
                strcat(megastrings, String2);
            }
        }
        if(TieneReceta[playerid] > 0)
        {
            format(String2, sizeof(String2), "\n{228B22}Tienes una receta medica. Ve a la farmacia.");
            strcat(megastrings, String2);
        }
        // CAMBIO 2026-07-20: mostrar items de cura en /cuenta
        if(ItemAntigripal[playerid] > 0 || ItemAntibiotico[playerid] > 0 || ItemSuero[playerid] > 0 || ItemPomada[playerid] > 0)
        {
            format(String2, sizeof(String2), "\n{FFFFFF}Items de cura: {FF69B4}Antigripal=%d | Antibiotico=%d | Suero=%d | Pomada=%d",
                ItemAntigripal[playerid], ItemAntibiotico[playerid], ItemSuero[playerid], ItemPomada[playerid]);
            strcat(megastrings, String2);
        }
        // CAMBIO 2026-07-20: Carnet de Vacunacion
        {
            new tiempoActualC = gettime();
            new vacunasActivas = 0;
            new carnetStr[256];
            carnetStr[0] = EOS;

            if(VacunaAntigripal[playerid] > tiempoActualC)
            {
                new diasRest = (VacunaAntigripal[playerid] - tiempoActualC) / 86400;
                format(String2, sizeof(String2), "\n{00FF00}Vacuna Antigripal activa (%dd)", diasRest);
                strcat(carnetStr, String2);
                vacunasActivas ++;
            }
            if(VacunaAntitetanica[playerid] > tiempoActualC)
            {
                new diasRest = (VacunaAntitetanica[playerid] - tiempoActualC) / 86400;
                format(String2, sizeof(String2), "\n{00FF00}Vacuna Antitetanica activa (%dd)", diasRest);
                strcat(carnetStr, String2);
                vacunasActivas ++;
            }
            if(VacunaAntirrabica[playerid] > tiempoActualC)
            {
                new diasRest = (VacunaAntirrabica[playerid] - tiempoActualC) / 86400;
                format(String2, sizeof(String2), "\n{00FF00}Vacuna Antirrabica activa (%dd)", diasRest);
                strcat(carnetStr, String2);
                vacunasActivas ++;
            }
            if(VacunaHepatitis[playerid] > tiempoActualC)
            {
                new diasRest = (VacunaHepatitis[playerid] - tiempoActualC) / 86400;
                format(String2, sizeof(String2), "\n{00FF00}Vacuna Hepatitis activa (%dd)", diasRest);
                strcat(carnetStr, String2);
                vacunasActivas ++;
            }

            if(vacunasActivas > 0)
            {
                format(String2, sizeof(String2), "\n{FFFFFF}=== Carnet de Vacunacion (%d/4 activas) ===", vacunasActivas);
                strcat(megastrings, String2);
                strcat(megastrings, carnetStr);
            }
            else
            {
                format(String2, sizeof(String2), "\n{FF0000}Carnet de Vacunacion: Sin vacunas activas");
                strcat(megastrings, String2);
            }
        }
        if(PlayerInfo[playerid][Org] == 10)
        {
            new restantes = MAX_KITS_GRATIS_POR_PAYDAY - KitsMedicosGratuitos[playerid];
            format(String2, sizeof(String2), "\n{FFFFFF}Kits gratis restantes (payday): {FF69B4}%d/%d", restantes, MAX_KITS_GRATIS_POR_PAYDAY);
            strcat(megastrings, String2);
            // CAMBIO 2026-07-12 - Fase 2: mostrar horas en Org 10
            new horas10 = SegundosOrg10[playerid] / 3600;
            new minutos10 = (SegundosOrg10[playerid] % 3600) / 60;
            format(String2, sizeof(String2), "\n{FFFFFF}Tiempo en Paramedicos: {FF69B4}%dh %dm", horas10, minutos10);
            strcat(megastrings, String2);
        }

        ShowPlayerDialog(playerid, DIALOG_CMDRG,DIALOG_STYLE_MSGBOX,"Informacion de cuenta",megastrings,"X",#);
        return 1;
}

