                        if(response)
                        {
                                new montoImpuesto = GetPVarInt(playerid, "MontoImpuesto");
                                if(montoImpuesto <= 0) return ErrorMsg(playerid, "No hay impuestos pendientes calculados. Vuelva a ingresar al menu.");
                                if(PlayerInfo[playerid][pDinheiro] < montoImpuesto) {
                                        new faltaImp[256];
                                        format(faltaImp, sizeof(faltaImp), "Dinero insuficiente. Necesitas $%d en mano. Tienes $%d.", montoImpuesto, PlayerInfo[playerid][pDinheiro]);
                                        return ErrorMsg(playerid, faltaImp);
                                }
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -montoImpuesto);
                                CofreGoverno += montoImpuesto;
                                // Reducir deuda pendiente si aplica
                                if(PlayerInfo[playerid][ImpuestoPendiente] > 0)
                                {
                                        PlayerInfo[playerid][ImpuestoPendiente] -= montoImpuesto;
                                        if(PlayerInfo[playerid][ImpuestoPendiente] < 0) PlayerInfo[playerid][ImpuestoPendiente] = 0;
                                }
                                new pagomsg[256];
                                format(pagomsg, sizeof(pagomsg), "Pago de impuestos confirmado: $%d. Gracias por cumplir con sus obligaciones fiscales.", montoImpuesto);
                                SuccesMsg(playerid, pagomsg);
                                DeletePVar(playerid, "MontoImpuesto");
                                SalvarDados(playerid);
                                SalvarDinRoubos();
                        }
                }
                case DIALOG_AYU_LICENCIAS:
                {
                        if(!response) { ShowPlayerDialog(playerid, DIALOG_PREFEITURA, DIALOG_STYLE_LIST, "Ayuntamiento de Estado", "{FFFF00}- {FFFFFF}Sacar Documentos\n{FFFF00}- {FFFFFF}Sacar Cart. Trabajo\n{FFFF00}- {FFFFFF}Pago de Impuestos\n{FFFF00}- {FFFFFF}Solicitud de Licencias\n{FFFF00}- {FFFFFF}Pagar Deuda Fiscal\n{FFFF00}- {FFFFFF}Pagar Multas", "Seleccionar", "X"); return 1; }
                        if(listitem == 0) // Licencia de Armas
                        {
                                if(!TieneCarnetTrabajo(playerid)) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Necesitas Carnet de Trabajo para solicitar la Licencia de Armas.");
                                if(PlayerInfo[playerid][pRG] == 0) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Necesitas tu Documento de Identidad (RG) para solicitar licencias.");
                                if(PlayerInfo[playerid][LicenciaArmas] == 1) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Ya dispones de Licencia de Armas en regla.");
                                if(PlayerInfo[playerid][pDinheiro] < 10000) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: No tienes los fondos necesarios. La Licencia de Armas cuesta $10.000.");
                                if(PlayerInfo[playerid][ImpuestoPendiente] > 0) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: No puedes solicitar licencias con deuda fiscal pendiente. Paga primero en la opcion Pagar Deuda.");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -10000);
                                PlayerInfo[playerid][LicenciaArmas] = 1;
                                CofreGoverno += 10000;
                                SuccesMsg(playerid, "El Ayuntamiento de Estado certifica la emision de su Licencia de Armas. Porte responsable, ciudadano.");
                                SalvarDados(playerid);
                                SalvarDinRoubos();
                        }
                        if(listitem == 1) // Licencia de Pesca
                        {
                                if(!TieneCarnetTrabajo(playerid)) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Necesitas Carnet de Trabajo para solicitar la Licencia de Pesca.");
                                if(PlayerInfo[playerid][pRG] == 0) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Necesitas tu Documento de Identidad (RG) para solicitar licencias.");
                                if(PlayerInfo[playerid][LicenciaPesca] == 1) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: Ya dispones de Licencia de Pesca en regla.");
                                if(PlayerInfo[playerid][pDinheiro] < 4000) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: No tienes los fondos necesarios. La Licencia de Pesca cuesta $4.000.");
                                if(PlayerInfo[playerid][ImpuestoPendiente] > 0) return ErrorMsg(playerid, "El Ayuntamiento de Estado informa: No puedes solicitar licencias con deuda fiscal pendiente. Paga primero en la opcion Pagar Deuda.");
                                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                                AC_AddPlayerMoney(playerid, -4000);
                                PlayerInfo[playerid][LicenciaPesca] = 1;
                                CofreGoverno += 4000;
                                SuccesMsg(playerid, "El Ayuntamiento de Estado certifica la emision de su Licencia de Pesca. Buena pesca, ciudadano.");
                                SalvarDados(playerid);
                                SalvarDinRoubos();
                        }
                }
                case DIALOG_AYU_PAGARDEUDA:
                {
                        if(!response) return 1;
                        new deuda = PlayerInfo[playerid][ImpuestoPendiente];
                        if(PlayerInfo[playerid][pDinheiro] < deuda)
                        {
                                new faltamsg[256];
                                format(faltamsg, sizeof(faltamsg), "El Ayuntamiento de Estado informa: No tienes suficiente dinero en mano. Deuda: $%d. Tienes en mano: $%d. Tu cuenta esta bloqueada, consigue el dinero y vuelve.", deuda, PlayerInfo[playerid][pDinheiro]);
                                return ErrorMsg(playerid, faltamsg);
                        }
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -deuda);
                        CofreGoverno += deuda;
                        PlayerInfo[playerid][ImpuestoPendiente] = 0;
                        PlayerInfo[playerid][ImpuestoPayDaysSinPagar] = 0;
                        PlayerInfo[playerid][BancoBloqueado] = 0;
                        // Quitar reporte policial si tenia
                        if(PlayerInfo[playerid][DeudaFiscalReportada] == 1)
                        {
                                PlayerInfo[playerid][DeudaFiscalReportada] = 0;
                                if(PlayerInfo[playerid][pProcurado] > 0)
                                {
                                        PlayerInfo[playerid][pProcurado]--;
                                        SetPlayerWantedLevelSync(playerid, PlayerInfo[playerid][pProcurado]); // FIX AUDIT WANTED: sync
                                }
                                new clearMsg[256];
                                format(clearMsg, sizeof(clearMsg), "[AYUNTAMIENTO] El ciudadano %s (ID:%d) ha saldado su deuda fiscal. El cargo por evasion fiscal ha sido eliminado.", Name(playerid), playerid);
                                foreach(new i: Player)
                                {
                                        if(pLogado[i] && IsPolicial(i))
                                        {
                                                SendClientMessage(i, 0x00FF00FF, clearMsg);
                                        }
                                }
                        }
                        SuccesMsg(playerid, "El Ayuntamiento de Estado confirma el pago total de su deuda fiscal. Su cuenta bancaria ha sido desbloqueada. Gracias por regularizar su situacion, ciudadano.");
                        SalvarDados(playerid);
                        SalvarDinRoubos();
                }
                case DIALOG_AYU_PAGARMULTAS:
                {
                        if(!response) return 1;
                        new multas = PlayerInfo[playerid][pMultas];
                        if(multas <= 0) return SuccesMsg(playerid, "No tienes multas pendientes.");
                        if(PlayerInfo[playerid][pDinheiro] < multas)
                        {
                                new faltamulta[256];
                                format(faltamulta, sizeof(faltamulta), "El Ayuntamiento de Estado informa: Dinero insuficiente. Debes $%d en multas. Tienes $%d en mano.", multas, PlayerInfo[playerid][pDinheiro]);
                                return ErrorMsg(playerid, faltamulta);
                        }
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -multas);
                        CofreGoverno += multas;
                        PlayerInfo[playerid][pMultas] = 0;
                        new multalog[256];
                        format(multalog, sizeof(multalog), "[PAGARMULTAS] %s (ID%04d) pago $%d en multas.", Name(playerid), PlayerInfo[playerid][IDF], multas);
                        Log("Logs/AdminAcciones.ini", multalog);
                        SuccesMsg(playerid, "El Ayuntamiento de Estado confirma el pago de sus multas. Recuerde respetar las normas de transito, ciudadano.");
                        SalvarDados(playerid);
                        SalvarDinRoubos();
                }
                case 8726:
                {
                        if(!response)
                        {
                                ErrorMsg(playerid,  "Cancelaste tu reporte!");
                                return 1;
                        }
                        ShowPlayerDialog(playerid, 4547, DIALOG_STYLE_TABLIST_HEADERS, "Solicitar Atencion", "Prioridad\tDescripcion\nPrioridad {FFFF00}BAJA{FFFFFF}\tAsunto de poca importancia\nPrioridad {FF0000}ALTA{FFFFFF}\tAsunto de MUCHA importancia\n{FFFF00}Reporte{FFFFFF}\tEnviar un reporte a los admins", "Solicitar", "Salir");
                }
                case 5409:
                {
                        if(PlayerInfo[playerid][pAdmin] < 1) return 1; // FIX AUDIT3 DS-07
                        if(response)
                        {
                                foreach(new i: Player)
                                {
                                        if(strfind(inputtext,Name(i), true) != -1)
                                        {
                                                Armazenar[playerid] = i;
                                        }
                                }
                                chosenpid = Armazenar[playerid];
                                new arquivo[64];
                                new string[255];
                                format(arquivo, sizeof(arquivo), Pasta_Relatorios,chosenpid);
                                if(DOF2_FileExists(arquivo))
                                {
                                        new NomeFila[MAX_PLAYER_NAME];
                                        new AssuntoFila[64];
                                        strmid(NomeFila, DOF2_GetString(arquivo,"Jogador"), 0, strlen(DOF2_GetString(arquivo,"Jogador")), 255);
                                        strmid(AssuntoFila, DOF2_GetString(arquivo,"Assunto"), 0, strlen(DOF2_GetString(arquivo,"Assunto")), 255);
                                        DOF2_CreateFile(arquivo);
                                        DOF2_GetString(arquivo, "Jogador");
                                        DOF2_GetString(arquivo, "Assunto");
                                        format(string, 128, "%s inicio una atencion al jugador %04d!",Name(playerid), GetPlayerIdfixo(chosenpid));
                                        SendAdminMessage(-1, string);
                                        format(string, sizeof(string), "El Administrador %s te esta atendiendo, asunto: [%s].", Name(playerid),AssuntoFila);
                                        InfoMsg(chosenpid, string);
                                        InfoMsg(chosenpid,  "Escribe algo en el chat. Cuando quieras finalizar la atencion escribe: /terminar.");
                                        ChatAtendimento[chosenpid] = 1;
                                        ChatAtendimento[playerid] = 2;
                                        InviteAtt[chosenpid] = playerid;
                                        InviteAtt[playerid] = chosenpid;
                                        NumeroChatAtendimento[chosenpid] = chosenpid;
                                        NumeroChatAtendimento[playerid] = chosenpid;
                                        DOF2_RemoveFile(arquivo);
                                }
                                else ErrorMsg(playerid,  "ID invalido.");
                        }
                        return 1;
                }
                case 4547:
                {
                        if(!response)
                        {
                                InfoMsg(playerid,  "Cancelaste tu reporte!");
                                return 1;
                        }
                        if(listitem == 1)
                        {
                                if(!response)
                                {
                                        InfoMsg(playerid,  "Cancelaste tu reporte!");
                                        return 1;
                                }
                                if (strlen(ArmazenarString[playerid]) > 30) //Strlen = Tamanho de uma string :)
                                {
                                        ErrorMsg(playerid,  "Escribe maximo 30 Caracteres!");
                                        return 1;
                                }
                                new arquivo[64];
                                new string[255];
                                format(arquivo, sizeof(arquivo), Pasta_Relatorios,playerid);
                                if(!DOF2_FileExists(arquivo))
                                {
                                        DOF2_CreateFile(arquivo);
                                        DOF2_SetString(arquivo, "Jogador", Name(playerid));
                                        DOF2_SetString(arquivo, "Assunto", ArmazenarString[playerid]);
                                        DOF2_SetInt(arquivo, "Prioridade", 2);
                                        DOF2_SaveFile();
                                        format(string, 128, "%04d entro en la fila de atencion, escribe /fila para atenderlo!",GetPlayerIdfixo(playerid), playerid);
                                        SendAdminMessage(-1, string);
                                        SuccesMsg(playerid,  "Envio una solicitud de soporte y ahora esta en la cola. Espere un momento hasta que los administradores le ayuden.");
                                        return 1;
                                }
                                else
                                {
                                        InfoMsg(playerid,  "Ya ha enviado una solicitud de soporte, espere y recibira ayuda en breve.!");
                                        return 1;
                                }
                        }
                        if(listitem == 0)
                        {
                                if(!response)
                                {
                                        InfoMsg(playerid,  "Cancelaste tu informe.!");
                                        return 1;
                                }
                                if (strlen(ArmazenarString[playerid]) > 30) //Strlen = Tamanho de uma string :)
                                {
                                        ErrorMsg(playerid,  "Introduzca un maximo de 30 caracteres.!");
                                        return 1;
                                }
                                new arquivo[64];
                                new string[255];
                                format(arquivo, sizeof(arquivo), Pasta_Relatorios,playerid);
                                if(!DOF2_FileExists(arquivo))
                                {
                                        DOF2_CreateFile(arquivo);
                                        DOF2_SetString(arquivo, "Jogador", Name(playerid));
                                        DOF2_SetString(arquivo, "Assunto", ArmazenarString[playerid]);
                                        DOF2_SetInt(arquivo, "Prioridade", 1);
                                        DOF2_SaveFile();
                                        format(string, 128, "%04d entro en la fila de atencion, escribe /fila para atenderlo!",GetPlayerIdfixo(playerid), playerid);
                                        SendAdminMessage(-1, string);
                                        SuccesMsg(playerid,  "Envio una solicitud de soporte y ahora esta en la cola. Espere un momento hasta que los administradores le ayuden.");
                                        return 1;
                                }
                                else
                                {
                                        InfoMsg(playerid,  "Ya ha enviado una solicitud de soporte, espere y recibira ayuda en breve.!");
                                        return 1;
                                }
                        }
                        if(listitem == 2)
                        {
                                ShowPlayerDialog(playerid, 4550, DIALOG_STYLE_INPUT, "{FFFF00}Particular", "Coloque su Relato", "Enviar", "Cancelar");
                                return 1;
                        }
                }
                case 4550: // FIX AUDIT7 CS-04: handler faltante para reporte particular (input text)
                {
                        if(!response)
                        {
                                InfoMsg(playerid,  "Cancelaste tu reporte!");
                                return 1;
                        }
                        if(strlen(inputtext) > 30)
                        {
                                ErrorMsg(playerid,  "Escribe maximo 30 Caracteres!");
                                return 1;
                        }
                        new arquivo[64];
                        new string[255];
                        format(arquivo, sizeof(arquivo), Pasta_Relatorios,playerid);
                        if(!DOF2_FileExists(arquivo))
                        {
                                DOF2_CreateFile(arquivo);
                                DOF2_SetString(arquivo, "Jogador", Name(playerid));
                                DOF2_SetString(arquivo, "Assunto", inputtext);
                                DOF2_SetInt(arquivo, "Prioridade", 3);
                                DOF2_SaveFile();
                                format(string, 128, "%04d entro en la fila de atencion, escribe /fila para atenderlo!",GetPlayerIdfixo(playerid), playerid);
                                SendAdminMessage(-1, string);
                                SuccesMsg(playerid,  "Envio una solicitud de soporte y ahora esta en la cola. Espere un momento hasta que los administradores le ayuden.");
                                return 1;
                        }
                        else
                        {
                                InfoMsg(playerid,  "Ya ha enviado una solicitud de soporte, espere y recibira ayuda en breve.!");
                                return 1;
                        }
                }
        }
        return 1;
}

public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
        // FIX Fase 1: La estructura anterior era if/else if/else if.
        // Como la primera rama (CheckMEDICO[playerid] > -1) siempre era true al entrar
        // al CP propio, destruÃ¯Â¿Â½a el CP y nunca llegaba a la rama de socorrer.
        // Ahora cada rama es independiente con return 1; y el orden es:
        //   1) Hospital CP (compras)  2) CP de rescate medico.

        // 1) Hospital Central -> menu de compras D_HOSP
        if((checkpointid == CheckHosp && CheckHosp > 0) || (checkpointid == CheckHospPequeno && CheckHospPequeno > 0))
        {
                // CAMBIO 2026-07-18: Si el jugador tiene una enfermedad, mostrar diagnostico primero
                if(Enfermedad[playerid] > 0)
                {
                    new diagStr[512], enfermedadName[32], tratamiento[128], costoReceta[64];
                    if(Enfermedad[playerid] == 1) { enfermedadName = "Gripe"; tratamiento = "Receta medica (cura inmediata)"; costoReceta = "$200"; }
                    else if(Enfermedad[playerid] == 2) { enfermedadName = "Infeccion"; tratamiento = "Antibiotico en farmacia"; costoReceta = "$100"; }
                    else if(Enfermedad[playerid] == 3) { enfermedadName = "Intoxicacion"; tratamiento = "Suero en farmacia"; costoReceta = "$100"; }
                    else if(Enfermedad[playerid] == 4) { enfermedadName = "Neumonia"; tratamiento = "Curacion medica (paramedico)"; costoReceta = "$100"; }
                    // CAMBIO 2026-07-20: Nuevas enfermedades
                    else if(Enfermedad[playerid] == 5) { enfermedadName = "Fiebre"; tratamiento = "Antibiotico en farmacia"; costoReceta = "$100"; }
                    else if(Enfermedad[playerid] == 6) { enfermedadName = "Alergia"; tratamiento = "Antigripal en farmacia"; costoReceta = "$100"; }
                    format(diagStr, sizeof(diagStr), "{FFFFFF}Diagnostico Medico\n\n{FFFF00}Enfermedad: {FF0000}%s\n{FFFF00}Tratamiento: {FFFFFF}%s\n{FFFF00}Costo de receta: {228B22}%s\n\n{FFFFFF}Deseas obtener la receta medica?", enfermedadName, tratamiento, costoReceta);
                    ShowPlayerDialog(playerid, DIALOG_DIAGNOSTICO, DIALOG_STYLE_MSGBOX, "{FFFFFF}Hospital - Diagnostico", diagStr, "Obtener Receta", "Cancelar");
                    return 1;
                }
                ShowPlayerDialog(playerid, D_HOSP, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Hospital", "{FFFFFF}Producto\t{228B22}Valor\n{FFFFFF}Kit Medico\t{228B22}$1500\n{FFFFFF}Plano de Salud\t{228B22}$5000\n{FFFFFF}Kit PARAMEDICO\t{228B22}Gratis (Solo Paramedico)\n{FFFFFF}Vendaje\t{228B22}$750\n{FFFFFF}Botiquin\t{228B22}Solo Paramedico\n{FFFFFF}Vacunas\t{228B22}$800 c/u", "Comprar", "Cancelar");
                return 1;
        }

        // CAMBIO 2026-07-13: CP de Farmacia SF
        if(checkpointid == CheckFarmaciaSF && CheckFarmaciaSF > 0)
        {
                // CAMBIO 2026-07-18: Si el jugador tiene receta medica, mostrar la cura
                if(TieneReceta[playerid] > 0)
                {
                    new recetaStr[256], curaName[64], curaPrecio[32];
                    if(TieneReceta[playerid] == 2) { curaName = "Antibiotico (cura infeccion)"; curaPrecio = "$1200"; }
                    else if(TieneReceta[playerid] == 3) { curaName = "Suero (cura intoxicacion)"; curaPrecio = "$1000"; }
                    else if(TieneReceta[playerid] == 4) { curaName = "Requiere paramedico"; curaPrecio = "N/A"; }
                    // CAMBIO 2026-07-20: Nuevas enfermedades
                    else if(TieneReceta[playerid] == 5) { curaName = "Antibiotico (cura fiebre)"; curaPrecio = "$1200"; }
                    else if(TieneReceta[playerid] == 6) { curaName = "Antigripal (cura alergia)"; curaPrecio = "$500"; }
                    format(recetaStr, sizeof(recetaStr), "{FFFFFF}Tienes una receta medica\n\n{FFFF00}Tratamiento: {FFFFFF}%s\n{FFFF00}Precio: {228B22}%s\n\n{FFFFFF}Deseas comprar el tratamiento?\n\n{AAAAAA}Nota: el item se guardara en tu inventario. Usalo con /usar* cuando quieras.", curaName, curaPrecio);
                    ShowPlayerDialog(playerid, DIALOG_FARMACIA_RECETA, DIALOG_STYLE_MSGBOX, "{FFFFFF}Farmacia - Receta Medica", recetaStr, "Comprar", "Cancelar");
                    return 1;
                }
                ShowPlayerDialog(playerid, DIALOG_FARMACIA, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Farmacia", "{FFFFFF}Producto\t{228B22}Valor\n{FFFFFF}Kit Medico\t{228B22}$1500\n{FFFFFF}Vendaje\t{228B22}$750\n{FFFFFF}Pomada (quemaduras)\t{228B22}$800", "Comprar", "Cancelar");
                return 1;
        }

        // 2) CP de rescate: el medico llego al paciente
        if(checkpointid == CheckMEDICO[playerid] && CheckMEDICO[playerid] > -1)
        {
                // Destruir el CP siempre (ya se cumplio su proposito)
                DestroyDynamicCP(CheckMEDICO[playerid]);
                CheckMEDICO[playerid] = -1;

                // Validar que sigue siendo medico
                if(PlayerInfo[playerid][Org] != 10)
                        return SendClientMessage(playerid, -1, "| ERROR | Usted no pertenece a Paramedico"); // Migrado a Org 10

                // No puede socorrer desde un vehiculo
                if(IsPlayerInAnyVehicle(playerid))
                        return SendClientMessage(playerid, -1, "| ERROR | Salga del vehiculo para brindar asistencia.");

                // Validar que el paciente siga conectado y herido
                if(Localizando[playerid] < 0 || !IsPlayerConnected(Localizando[playerid]))
                        return SendClientMessage(playerid, -1, "| ERROR | El jugador ya no esta conectado.");

                if(MinutosMorte[Localizando[playerid]] <= 0 && SegundosMorte[Localizando[playerid]] <= 0)
                        return SendClientMessage(playerid, -1, "| ERROR | El jugador ya no esta herido.");

                // Disparar el rescate (timer de 6s)
                // FIX VERIFY-DANODMG-3 CRIT-DMG-3: guardar handle del timer en PVar
                // para poder matarlo si el paramedico se desconecta antes de los 6s.
                // Antes: si el paramedico se desconectaba, el timer disparaba con
                // Localizando[playerid] = -1 (reset por ZerarDados), causando acceso
                // a MinutosMorte[-1] / SetPlayerHealth(-1, 10.0) = memory corruption.
                SetPVarInt(playerid, "SocorrerTimerID", SetTimerEx("Socorrer", 6000, false, "i", playerid));
                GameTextForPlayer(playerid, "~r~Socorriendo ~w~Jugador...", 5500, 3);
                ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
                return 1;
        }
        return 1;
}

public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
