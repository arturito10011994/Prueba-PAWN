                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/limpiarlider{FFFFFF} Quitar lider\n");
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/limpiarlideres{FFFFFF} Quitar lideres de org\n");
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/crearcasa{FFFFFF} Crear casa\n");
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/dcasa{FFFFFF} Borrar casa\n");
                        }
                        case 8: // 9. Eventos
                        {
                            catTitle = "9. Eventos";
                            if(aLvl < 5)
                            {
                                strcat(cmdList, "{FF0000}No tienes permisos para ver esta categoria.\n");
                            }
                            else
                            {
                                strcat(cmdList, "{FFFF00}/guerratotal{FFFFFF} Iniciar guerra total\n");
                                strcat(cmdList, "{FFFF00}/terminarguerra{FFFFFF} Terminar guerra total\n");
                                strcat(cmdList, "{FFFF00}/camionblindado{FFFFFF} Iniciar evento camion\n");
                                strcat(cmdList, "{FFFF00}/terminarcamion{FFFFFF} Terminar evento camion\n");
                            }
                        }
                        case 9: // 10. Economia / VIP / Coins
                        {
                            catTitle = "10. Economia / VIP / Coins";
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/dardinero [id] [cantidad]{FFFFFF} Dar dinero\n");
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/darcoins [id] [cantidad]{FFFFFF} Dar coins [NUEVO]\n");
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/darvip [id] [nivel] [dias]{FFFFFF} Dar VIP [NUEVO]\n");
                            if(aLvl >= 7) strcat(cmdList, "{FF0000}/quitardinero [id] [cantidad]{FFFFFF} Quitar dinero\n");
                        }
                        case 10: // 11. Mapeo
                        {
                            catTitle = "11. Mapeo";
                            if(aLvl >= 6) strcat(cmdList, "{FFFF00}/editarmapa{FFFFFF} Editar objetos del mapa\n");
                            else strcat(cmdList, "{FF0000}No tienes permisos para esta categoria.\n");
                        }
                        case 11: // 12. Sistema / Servidor
                        {
                            catTitle = "12. Sistema / Servidor";
                            strcat(cmdList, "{FFFF00}/hora{FFFFFF} Cambiar hora del servidor\n");
                            strcat(cmdList, "{FFFF00}/clima{FFFFFF} Cambiar clima\n");
                            strcat(cmdList, "{FFFF00}/climas{FFFFFF} Lista de climas\n");
                            if(aLvl >= 6)
                            {
                                strcat(cmdList, "{FFFF00}/var{FFFFFF} Ver variables del sistema\n");
                                strcat(cmdList, "{FFFF00}/setvar{FFFFFF} Modificar variables\n");
                                strcat(cmdList, "{FFFF00}/gmx{FFFFFF} Reiniciar servidor\n");
                                strcat(cmdList, "{FFFF00}/saveall{FFFFFF} Guardar todos los jugadores [NUEVO]\n");
                                strcat(cmdList, "{FFFF00}/serverinfo{FFFFFF} Info del servidor [NUEVO]\n");
                            }
                            if(aLvl >= 7)
                            {
                                strcat(cmdList, "{FF0000}/reiniciar{FFFFFF} Reinicio programado (10s)\n");
                                strcat(cmdList, "{FF0000}/cancelarreiniciar{FFFFFF} Cancelar reinicio\n");
                            }
                        }
                        case 12: // 13. Investigacion / IP
                        {
                            catTitle = "13. Investigacion / IP";
                            if(aLvl >= 4) strcat(cmdList, "{FFFF00}/lookupip [ip]{FFFFFF} Buscar cuentas por IP [NUEVO]\n");
                            else strcat(cmdList, "{FF0000}Requiere admin 4+ (Supervisor)\n");
                            if(aLvl >= 5) strcat(cmdList, "{FFFF00}/findalt [id]{FFFFFF} Buscar cuentas alternativas [NUEVO]\n");
                        }
                        case 13: // 14. Logs / Auditoria
                        {
                            catTitle = "14. Logs / Auditoria";
                            strcat(cmdList, "{FFFF00}/radarlogs{FFFFFF} Historial de multas de radar\n");
                            if(aLvl >= 3) strcat(cmdList, "{FFFF00}/adminlogs{FFFFFF} Historial de acciones admin [NUEVO]\n");
                            else if(aLvl < 3) strcat(cmdList, "{FF0000}Requiere admin 3+ para mas logs\n");
                        }
                        case 14: // 15. Desarrollo
                        {
                            catTitle = "15. Desarrollo";
                            if(aLvl < 7)
                            {
                                strcat(cmdList, "{FF0000}Solo Desarrollador (admin 7)\n");
                            }
                            else
                            {
                                strcat(cmdList, "{FF0000}/setadmin [id] [nivel]{FFFFFF} Setear nivel admin\n");
                                strcat(cmdList, "{FF0000}/crearkey{FFFFFF} Crear key VIP/coins\n");
                                strcat(cmdList, "{FF0000}/dararma [id] [arma] [municion]{FFFFFF} Dar arma extra\n");
                                strcat(cmdList, "{FF0000}/darcoche [id] [modelo]{FFFFFF} Spawnear y dar vehiculo\n");
                                strcat(cmdList, "{FF0000}/darvehiculo [id]{FFFFFF} Dar vehiculo permanente\n");
                                strcat(cmdList, "{FF0000}/delvehiculo{FFFFFF} Eliminar vehiculo temporal\n");
                                strcat(cmdList, "{FF0000}/eliminarvehiculo [id]{FFFFFF} Eliminar vehiculo permanente\n");
                                strcat(cmdList, "{FF0000}/curafull{FFFFFF} Curacion TOTAL\n");
                                strcat(cmdList, "{FF0000}/quitardinero [id] [cantidad]{FFFFFF} Quitar dinero\n");
                                strcat(cmdList, "{FF0000}/reiniciar{FFFFFF} Reinicio programado\n");
                                strcat(cmdList, "{FF0000}/cancelarreiniciar{FFFFFF} Cancelar reinicio\n");
                            }
                        }
                        case 15: // 16. Otros
                        {
                            catTitle = "16. Otros Comandos Admin";
                            strcat(cmdList, "{FFFF00}/darhorasjuego [IDF] [horas]{FFFFFF} Dar horas de juego a un jugador\n");
                            strcat(cmdList, "{FFFF00}/darhorastrabajo [IDF] [horas]{FFFFFF} Dar horas de trabajo (requiere tener trabajo)\n");
                            strcat(cmdList, "{FFFF00}/quitarvip [IDF]{FFFFFF} Quitar VIP a un jugador\n");
                            strcat(cmdList, "{FFFF00}/daritem [IDF] [item] [cantidad]{FFFFFF} Dar item a un jugador\n");
                            strcat(cmdList, "{FFFF00}/darlider [IDF] [org]{FFFFFF} Dar liderazgo de organizacion\n");
                            strcat(cmdList, "{FFFF00}/desarmar [IDF]{FFFFFF} Desarmar a un jugador\n");
                            strcat(cmdList, "{FFFF00}/dradar [IDF]{FFFFFF} Eliminar radar de un jugador\n");
                            strcat(cmdList, "{FFFF00}/esposar2 [IDF]{FFFFFF} Esposar a un jugador (alt)\n");
                            strcat(cmdList, "{FFFF00}/jetpack{FFFFFF} Activar/desactivar jetpack\n");
                            strcat(cmdList, "{FFFF00}/limpiarchat{FFFFFF} Limpiar el chat global\n");
                            strcat(cmdList, "{FFFF00}/limpiarinventario [IDF]{FFFFFF} Limpiar inventario de un jugador\n");
                            strcat(cmdList, "{FFFF00}/limpiarlider [IDF]{FFFFFF} Quitar liderazgo a un jugador\n");
                            strcat(cmdList, "{FFFF00}/limpiarlideres{FFFFFF} Quitar liderazgo a todos\n");
                            strcat(cmdList, "{FFFF00}/lookupip [IP]{FFFFFF} Buscar jugadores por IP\n");
                            strcat(cmdList, "{FFFF00}/movedealership{FFFFFF} Mover concesionaria\n");
                            strcat(cmdList, "{FFFF00}/movefuelstation{FFFFFF} Mover estacion de combustible\n");
                            strcat(cmdList, "{FFFF00}/qesposa2 [IDF]{FFFFFF} Quitar esposas (alt)\n");
                            strcat(cmdList, "{FFFF00}/qmute [IDF]{FFFFFF} Quitar mute a un jugador\n");
                        }
                    }
                    ShowPlayerDialog(playerid, DIALOG_AG_CAT, DIALOG_STYLE_MSGBOX, catTitle, cmdList, "Volver", "X");
                    return 1;
                }
                case DIALOG_AG_CAT:
                {
                    if(response)
                    {
                        new catList[768];
                        strcat(catList, "{FFFF00}1.{FFFFFF} Comandos Generales\n");
                        strcat(catList, "{FFFF00}2.{FFFFFF} Castigos\n");
                        strcat(catList, "{FFFF00}3.{FFFFFF} Teletransporte / Espectador\n");
                        strcat(catList, "{FFFF00}4.{FFFFFF} Jugadores\n");
                        strcat(catList, "{FFFF00}5.{FFFFFF} Vehiculos / Concesionarias\n");
                        strcat(catList, "{FFFF00}6.{FFFFFF} Combustible / Estaciones\n");
                        strcat(catList, "{FFFF00}7.{FFFFFF} Radares / Carreteras\n");
                        strcat(catList, "{FFFF00}8.{FFFFFF} Organizaciones / Casas\n");
                        strcat(catList, "{FFFF00}9.{FFFFFF} Eventos\n");
                        strcat(catList, "{FFFF00}10.{FFFFFF} Economia / VIP / Coins\n");
                        strcat(catList, "{FFFF00}11.{FFFFFF} Mapeo\n");
                        strcat(catList, "{FFFF00}12.{FFFFFF} Sistema / Servidor\n");
                        strcat(catList, "{FFFF00}13.{FFFFFF} Investigacion / IP\n");
                        strcat(catList, "{FFFF00}14.{FFFFFF} Logs / Auditoria\n");
                        if(PlayerInfo[playerid][pAdmin] >= 7)
                            strcat(catList, "{FF0000}15.{FFFFFF} Desarrollo\n");
                        strcat(catList, "{FFFF00}16.{FFFFFF} Otros Comandos Admin\n");
                        ShowPlayerDialog(playerid, DIALOG_AG_MENU, DIALOG_STYLE_LIST, "Ayuda Admin - Categorias", catList, "Ver", "X");
                    }
                    return 1;
                }
                // =====================================================================
                // GAS-STATION-BUSINESS: Handler del menu de gestion de gasolineras
                // =====================================================================
                case DIALOG_GAS_GESTION:
                {
                    if(!response) return 1;
                    new count = GetPVarInt(playerid, "GestionGasCount");
                    if(listitem < 0 || listitem >= count) return 1;
                    new pvarName[32];
                    format(pvarName, sizeof(pvarName), "GestionGas_%d", listitem);
                    new stationid = GetPVarInt(playerid, pvarName);
                    if(!IsValidFuelStation(stationid)) return 1;
                    if(FuelStationOwnerIDF[stationid] != PlayerInfo[playerid][IDF]) return ErrorMsg(playerid, "Ya no eres dueno de esta gasolinera.");

                    new gasDisp = FuelStationGasolinaCap[stationid] - FuelStationGasolinaStock[stationid];
                    new petDisp = FuelStationPetroleoCap[stationid] - FuelStationPetroleoStock[stationid];
                    new gasP = GetFuelStationPrecio(stationid, 0);
                    new petP = GetFuelStationPrecio(stationid, 1);
                    new info[512];
                    format(info, sizeof(info),
                        "{FFFF00}%s (ID %d)\n\n\
                        {FFFFFF}Gasolina: {00FF00}%d/%d L (disp: %d)\n\
                        {FFFFFF}Petroleo: {00FF00}%d/%d L (disp: %d)\n\
                        {FFFFFF}Precio Gas: {FFFF00}$%d/L  Pet: {FFFF00}$%d/L\n\
                        {FFFFFF}Estado: %s\n\
                        {FFFFFF}Caja acumulada: {00FF00}$%d\n\n\
                        {FFFF00}Comandos disponibles:\n\
                        {FFFFFF}/gasrestock %d 1 [litros] - Abastecer gasolina\n\
                        {FFFFFF}/gasrestock %d 2 [litros] - Abastecer petroleo\n\
                        {FFFFFF}/setprecoestacion %d [gas] [pet] - Cambiar precios\n\
                        {FFFFFF}/gasnombre %d [nombre] - Cambiar nombre\n\
                        {FFFFFF}/gasabrir %d - Abrir\n\
                        {FFFFFF}/gascerrar %d - Cerrar",
                        FuelStationName[stationid], stationid,
                        FuelStationGasolinaStock[stationid], FuelStationGasolinaCap[stationid], gasDisp,
                        FuelStationPetroleoStock[stationid], FuelStationPetroleoCap[stationid], petDisp,
                        gasP, petP,
                        FuelStationAbierta[stationid] ? "{00FF00}Abierta" : "{FF0000}Cerrada",
                        FuelStationCaja[stationid],
                        stationid, stationid, stationid, stationid, stationid, stationid);
                    ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_MSGBOX, "Gestion Gasolinera", info, "Cerrar", "");
                    return 1;
                }
                // =====================================================================
                // CAMBIO 2026-07-18 - DIALOG_DIAGNOSTICO: Obtener receta medica
                // =====================================================================
                case DIALOG_DIAGNOSTICO:
                {
                    if(response)
                    {
                        // Gripe: $200, se cura al obtener receta
                        if(Enfermedad[playerid] == 1)
                        {
                            if(PlayerInfo[playerid][pDinheiro] < 200)
                                return ErrorMsg(playerid, "No tienes $200 para la receta.");
                            AC_AddPlayerMoney(playerid, -200);
                            // FIX AUDIT2 AGENT2 M-27: SalvarDados para persistir compra de farmacia.
                            SalvarDados(playerid);
                            Enfermedad[playerid] = 0;
                            EnfermedadTick[playerid] = 0;
                            EnfermedadTiempo[playerid] = 0;
                            SuccesMsg(playerid, "Receta obtenida. La gripe ha sido curada!");
                            return 1;
                        }
                        // Otras enfermedades: $100, da receta para ir a farmacia
                        if(PlayerInfo[playerid][pDinheiro] < 100)
                            return ErrorMsg(playerid, "No tienes $100 para la receta.");
                        AC_AddPlayerMoney(playerid, -100);
                        // FIX AUDIT2 AGENT2 M-27: SalvarDados para persistir compra de farmacia.
                        SalvarDados(playerid);
                        TieneReceta[playerid] = Enfermedad[playerid];
                        new msgReceta[160];
                        if(Enfermedad[playerid] == 2) format(msgReceta, sizeof(msgReceta), "Receta obtenida. Ve a la farmacia a comprar el Antibiotico ($1200).");
                        else if(Enfermedad[playerid] == 3) format(msgReceta, sizeof(msgReceta), "Receta obtenida. Ve a la farmacia a comprar el Suero ($1000).");
                        else if(Enfermedad[playerid] == 4) format(msgReceta, sizeof(msgReceta), "Receta obtenida. Necesitas que un paramedico te cure con /curar.");
                        // CAMBIO 2026-07-20: Nuevas enfermedades
                        else if(Enfermedad[playerid] == 5) format(msgReceta, sizeof(msgReceta), "Receta obtenida. Ve a la farmacia a comprar el Antibiotico ($1200).");
                        else if(Enfermedad[playerid] == 6) format(msgReceta, sizeof(msgReceta), "Receta obtenida. Ve a la farmacia a comprar el Antigripal ($500).");
                        SuccesMsg(playerid, msgReceta);
                        return 1;
                    }
                    return 1;
                }
                // =====================================================================
                // CAMBIO 2026-07-18 - DIALOG_FARMACIA_RECETA: Comprar cura con receta
                // CAMBIO 2026-07-20: Ahora entrega ITEM al inventario (no cura directa)
                // El jugador debe usar /usarantigripal /usarantibiotico /usarsuero
                // =====================================================================
                case DIALOG_FARMACIA_RECETA:
                {
                    if(response)
                    {
                        // Neumonia: no se cura en farmacia, necesita paramedico
                        if(TieneReceta[playerid] == 4)
                            return ErrorMsg(playerid, "La neumonia requiere tratamiento de un paramedico. Busca uno y pidele /curar.");

                        // Infeccion y Fiebre: Antibiotico $1200 (entrega item)
                        if(TieneReceta[playerid] == 2 || TieneReceta[playerid] == 5)
                        {
                            if(PlayerInfo[playerid][pDinheiro] < 1200)
                                return ErrorMsg(playerid, "No tienes $1200 para el antibiotico.");
                            AC_AddPlayerMoney(playerid, -1200);
                            // FIX AUDIT2 AGENT2 M-27: SalvarDados para persistir compra de farmacia.
                            SalvarDados(playerid);
                            ItemAntibiotico[playerid] ++;
                            TieneReceta[playerid] = 0;
                            SuccesMsg(playerid, "Antibiotico comprado. Usalo con /usarantibiotico para curarte.");
                            return 1;
                        }
                        // Intoxicacion: Suero $1000 (entrega item)
                        if(TieneReceta[playerid] == 3)
                        {
                            if(PlayerInfo[playerid][pDinheiro] < 1000)
                                return ErrorMsg(playerid, "No tienes $1000 para el suero.");
                            AC_AddPlayerMoney(playerid, -1000);
                            // FIX AUDIT2 AGENT2 M-27: SalvarDados para persistir compra de farmacia.
                            SalvarDados(playerid);
                            ItemSuero[playerid] ++;
                            TieneReceta[playerid] = 0;
                            SuccesMsg(playerid, "Suero comprado. Usalo con /usarsuero para curarte.");
                            return 1;
                        }
                        // Alergia: Antigripal $500 (entrega item)
                        if(TieneReceta[playerid] == 6)
                        {
                            if(PlayerInfo[playerid][pDinheiro] < 500)
                                return ErrorMsg(playerid, "No tienes $500 para el antigripal.");
                            AC_AddPlayerMoney(playerid, -500);
                            // FIX AUDIT2 AGENT2 M-27: SalvarDados para persistir compra de farmacia.
                            SalvarDados(playerid);
                            ItemAntigripal[playerid] ++;
                            TieneReceta[playerid] = 0;
                            SuccesMsg(playerid, "Antigripal comprado. Usalo con /usarantigripal para curarte.");
                            return 1;
                        }
                    }
                    return 1;
                }
                // =====================================================================
                // CAMBIO 2026-07-20 - DIALOG_CURAR_PAGO: confirmacion del paciente
                // El paciente acepta/rechaza el cobro escalonado del paramedico.
                // Si acepta y tiene dinero: se aplica cobro + cura completa.
                // Si rechaza o no tiene dinero: avisa al paramedico, no se cura.
                // =====================================================================
                case DIALOG_CURAR_PAGO:
                {
                    // playerid aqui = PACIENTE (el que recibe el dialog)
                    new medico = CurarTarget[playerid];
                    new costo = CurarCosto[playerid];

                    // FIX AUDITORIA 2026-07-20: validar que medico sea un ID valido (0-1000)
                    if(medico < 0 || medico >= MAX_PLAYERS)
                    {
                        SendClientMessage(playerid, 0xFF4444FF, "| PARAMEDICO | Solicitud de curacion invalida. Ignorada.");
                        CurarTarget[playerid] = -1;
                        return 1;
                    }

                    // Validar que el medico siga conectado y cerca
                    if(!IsPlayerConnected(medico))
                    {
                        SendClientMessage(playerid, 0xFF4444FF, "| PARAMEDICO | El paramedico se desconecto. Curacion cancelada.");
                        CurarTarget[playerid] = -1;
                        return 1;
                    }
                    // FIX VERIFY-DANODMG-3 HIGH-DMG-1: validar que el medico siga
                    // siendo de Org 10 (Paramedicos). Si se desconecto y otro jugador
                    // tomo su slot ID, podria recibir el dinero de la curacion sin
                    // ser paramedico.
                    if(PlayerInfo[medico][Org] != 10)
                    {
                        SendClientMessage(playerid, 0xFF4444FF, "| PARAMEDICO | El paramedico ya no esta en servicio. Curacion cancelada.");
                        CurarTarget[playerid] = -1;
                        return 1;
                    }

                    new Float:mx, Float:my, Float:mz;
                    GetPlayerPos(playerid, mx, my, mz);
                    if(GetPlayerDistanceFromPoint(medico, mx, my, mz) > 5.0)
                    {
                        SendClientMessage(playerid, 0xFF4444FF, "| PARAMEDICO | El paramedico se alejo. Curacion cancelada.");
                        SendClientMessage(medico, 0xFF4444FF, "| PARAMEDICO | Te alejaste del paciente. Curacion cancelada.");
                        CurarTarget[playerid] = -1;
                        return 1;
                    }

                    if(!response)
                    {
                        // Paciente rechazo el pago
                        SendClientMessage(playerid, 0xFFAA00FF, "| PARAMEDICO | Rechazaste el tratamiento medico.");
                        SendClientMessage(medico, 0xFFAA00FF, "| PARAMEDICO | El paciente rechazo el tratamiento. No se realiza la curacion.");
                        CurarTarget[playerid] = -1;
                        return 1;
                    }

                    // Paciente acepto - validar que tenga dinero
                    new pagoRealizado = 0;
                    new strOrigen[32];

                    if(PlayerInfo[playerid][pDinheiro] >= costo)
                    {
                        // CASO 1: paga del dinero en mano
                        // FIX VERIFY-MONEYAC-FIX: migrado a AC_AddPlayerMoney para sync correcta
                        AC_AddPlayerMoney(playerid, -costo);
                        AC_AddPlayerMoney(medico, costo);
                        pagoRealizado = 1;
                        strOrigen = "dinero en mano";
                    }
                    else if(PlayerInfo[playerid][pBanco] >= costo && PlayerInfo[playerid][BancoBloqueado] == 0)
                    {
                        // CASO 2: paga del banco
                        PlayerInfo[playerid][pBanco] -= costo;
                        AC_AddPlayerMoney(medico, costo);
                        pagoRealizado = 1;
                        strOrigen = "cuenta bancaria";
                    }

                    if(!pagoRealizado)
                    {
                        // No tiene dinero suficiente
                        new msgNo[160];
                        format(msgNo, sizeof(msgNo), "| PARAMEDICO | No tienes $%d para pagar el tratamiento (ni en mano ni en banco). Curacion cancelada.", costo);
                        SendClientMessage(playerid, 0xFF4444FF, msgNo);
                        format(msgNo, sizeof(msgNo), "| PARAMEDICO | %s no tiene $%d para pagar. Curacion cancelada.", PlayerName(playerid), costo);
                        SendClientMessage(medico, 0xFF4444FF, msgNo);
                        CurarTarget[playerid] = -1;
                        return 1;
                    }

                    // Pago exitoso - aplicar cura completa
                    SetPlayerHealth(playerid, 100.0);
                    FomePlayer[playerid] = 100;
                    SedePlayer[playerid] = 100;

                    // FIX AUDIT2 AGENT2 M-11: SalvarDados inmediato para ambos
                    // (paciente + medico) para persistir la transaccion de cura.
                    // Sin esto, si crash antes del SaveTimer, el paciente no paga
                    // y/o el medico no recibe el pago (loss/dupe segun rama).
                    SalvarDados(playerid);
                    SalvarDados(medico);

                    // Detener sangrado
                    if(Sangrando[playerid])
                    {
                        Sangrando[playerid] = false;
                        SangradoTick[playerid] = 0;
                        SendClientMessage(playerid, -1, "| PARAMEDICO | El paramedico detuvo tu sangrado.");
                    }
                    // Curar enfermedad
                    if(Enfermedad[playerid] > 0)
                    {
                        new enfermedadName[32];
                        if(Enfermedad[playerid] == 1) enfermedadName = "gripe";
                        else if(Enfermedad[playerid] == 2) enfermedadName = "infeccion";
                        else if(Enfermedad[playerid] == 3) enfermedadName = "intoxicacion";
                        else if(Enfermedad[playerid] == 4) enfermedadName = "neumonia";
                        else if(Enfermedad[playerid] == 5) enfermedadName = "fiebre";
                        else enfermedadName = "alergia";
                        Enfermedad[playerid] = 0;
                        EnfermedadTick[playerid] = 0;
                        EnfermedadTiempo[playerid] = 0;
                        TieneReceta[playerid] = 0;
                        new msgEnf[128];
                        format(msgEnf, sizeof(msgEnf), "| PARAMEDICO | El paramedico curo tu %s.", enfermedadName);
                        SendClientMessage(playerid, -1, msgEnf);
                    }
                    // Curar fractura
                    if(Fractura[playerid] > 0)
                    {
                        new fracName[16];
                        if(Fractura[playerid] == 1) fracName = "brazo";
                        else if(Fractura[playerid] == 2) fracName = "pierna";
                        else fracName = "costillas";
                        Fractura[playerid] = 0;
                        FracturaTick[playerid] = 0;
                        new msgFrac[128];
                        format(msgFrac, sizeof(msgFrac), "| PARAMEDICO | El paramedico enyeso tu fractura de %s.", fracName);
                        SendClientMessage(playerid, -1, msgFrac);
                    }
                    // Curar quemadura
                    if(Quemadura[playerid] > 0)
                    {
                        new gradoName[24];
                        if(Quemadura[playerid] == 1) gradoName = "leve (grado 1)";
                        else if(Quemadura[playerid] == 2) gradoName = "media (grado 2)";
                        else gradoName = "grave (grado 3)";
                        Quemadura[playerid] = 0;
                        QuemaduraTick[playerid] = 0;
                        new msgQue[128];
                        format(msgQue, sizeof(msgQue), "| PARAMEDICO | El paramedico trato tu quemadura %s.", gradoName);
                        SendClientMessage(playerid, -1, msgQue);
                    }

                    // Animaciones y feedback
                    ApplyAnimation(medico, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
                    GameTextForPlayer(playerid, "~g~Curado!", 2000, 3);

                    // Mensajes finales
                    new msgFinal[200];
                    format(msgFinal, sizeof(msgFinal), "| PARAMEDICO | El paramedico %s te curo completamente. Pagaste $%d de tu %s.", PlayerName(medico), costo, strOrigen);
                    SendClientMessage(playerid, 0x228B22FF, msgFinal);
                    format(msgFinal, sizeof(msgFinal), "| PARAMEDICO | Curaste a %s. Recibiste $%d (pago via %s).", PlayerName(playerid), costo, strOrigen);
                    SendClientMessage(medico, COR_PARAMEDICO, msgFinal);

                    // Limpiar estado
                    CurarTarget[playerid] = -1;
                    CurarCosto[playerid] = 0;
                    CurarDetalle[playerid][0] = EOS;
                    return 1;
                }
                // =====================================================================
                // CAMBIO 2026-07-13 - DIALOG_FARMACIA: compras en Farmacia SF
                // =====================================================================
                case DIALOG_FARMACIA:
                {
                    if(response)
                    {
                        switch(listitem)
                        {
                            // case 0: Kit Medico $1500 -> +1 kit en KitsMedicos[] (max 6)
                            case 0:
                            {
                                if(PlayerInfo[playerid][pDinheiro] < 1500)
                                    return SendClientMessage(playerid, -1, "| ERROR | No tienes dinero suficiente");
                                if(KitsMedicos[playerid] >= MAX_KITS_MEDICOS)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes el maximo de kits (6)");
                                AC_AddPlayerMoney(playerid, -1500);
                                KitsMedicos[playerid] += 1;
                                new msg[128];
                                format(msg, sizeof(msg), "| FARMACIA | Compraste un Kit Medico por {228B22}$1500{FFFFFF}. Total: {FF69B4}%d/%d{FFFFFF}. Usa /usarkit para curarte.", KitsMedicos[playerid], MAX_KITS_MEDICOS);
                                SendClientMessage(playerid, -1, msg);
                                return 1;
                            }
                            // case 1: Vendaje $750 -> +1 vendaje en Vendajes[] (max 8)
                            case 1:
                            {
                                if(PlayerInfo[playerid][pDinheiro] < 750)
                                    return SendClientMessage(playerid, -1, "| ERROR | No tienes dinero suficiente");
                                if(Vendajes[playerid] >= MAX_VENDAJES)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes el maximo de vendajes (8)");
                                AC_AddPlayerMoney(playerid, -750);
                                Vendajes[playerid] += 1;
                                new msg[128];
                                format(msg, sizeof(msg), "| FARMACIA | Compraste un vendaje por {228B22}$750{FFFFFF}. Total: {FF69B4}%d/%d{FFFFFF}. Usa /usarvendaje para curarte.", Vendajes[playerid], MAX_VENDAJES);
                                SendClientMessage(playerid, -1, msg);
                                return 1;
                            }
                            // CAMBIO 2026-07-20: case 2: Pomada $800 -> +1 pomada en ItemPomada[]
                            case 2:
                            {
                                if(PlayerInfo[playerid][pDinheiro] < 800)
                                    return SendClientMessage(playerid, -1, "| ERROR | No tienes dinero suficiente");
                                if(ItemPomada[playerid] >= 10)
                                    return SendClientMessage(playerid, -1, "| ERROR | Ya tienes el maximo de pomadas (10)");
                                AC_AddPlayerMoney(playerid, -800);
                                ItemPomada[playerid] += 1;
                                new msg[160];
                                format(msg, sizeof(msg), "| FARMACIA | Compraste una pomada por {228B22}$800{FFFFFF}. Total: {FF69B4}%d/10{FFFFFF}. Usa /usarpomada para curar quemaduras grado 1-2.", ItemPomada[playerid]);
                                SendClientMessage(playerid, -1, msg);
                                return 1;
                            }
                        }
                    }
                    return 1;
                }
                case D_KITMEDICO:
                {
                    if(response)
                    {
                        new qty = strval(inputtext);
                        if(qty <= 0 || qty > MAX_KITS_MEDICOS)
                            return SendClientMessage(playerid, -1, "| ERROR | La cantidad debe estar entre 1 y 6");
                        if(PlayerInfo[playerid][Org] != 10)
                            return SendClientMessage(playerid, -1, "| ERROR | Solo los Paramedicos pueden obtener kits"); // Migrado a Org 10
                        if(KitsMedicos[playerid] + qty > MAX_KITS_MEDICOS)
                            return SendClientMessage(playerid, -1, "| ERROR | No puedes tener mas de 6 kits en total");

                        // CAMBIO 2026-07-09 - Bug #7: tope de kits gratis por payday
                        // Antes: kits gratis infinitos. Ahora: maximo MAX_KITS_GRATIS_POR_PAYDAY (20) por payday.
                        // El contador se resetea en el callback PayDay y persiste en disco (no evadible relogeando).
                        if(KitsMedicosGratuitos[playerid] + qty > MAX_KITS_GRATIS_POR_PAYDAY)
                        {
                            new restantes = MAX_KITS_GRATIS_POR_PAYDAY - KitsMedicosGratuitos[playerid];
                            new errorMsg[128];
                            if(restantes <= 0)
                                format(errorMsg, sizeof(errorMsg), "| ERROR | Ya pediste tus %d kits gratis de este payday. Espera al proximo.", MAX_KITS_GRATIS_POR_PAYDAY);
                            else
                                format(errorMsg, sizeof(errorMsg), "| ERROR | Solo te quedan %d kits gratis este payday (max %d por payday).", restantes, MAX_KITS_GRATIS_POR_PAYDAY);
                            return SendClientMessage(playerid, -1, errorMsg);
                        }

                        KitsMedicos[playerid] += qty;
                        KitsMedicosGratuitos[playerid] += qty;

                        new msg[160];
                        new restantes = MAX_KITS_GRATIS_POR_PAYDAY - KitsMedicosGratuitos[playerid];
                        format(msg, sizeof(msg), "| PARAMEDICO | Recibiste {FF69B4}%d Kits MEDICO{FFFFFF}. Total: %d. Kits gratis restantes este payday: %d", qty, KitsMedicos[playerid], restantes);
                        SendClientMessage(playerid, -1, msg);
                        GameTextForPlayer(playerid, "~w~Compraste Kits!", 3000, 3);
                    }
                    return 1;
                }
                case D_CHAMARMEDICO:
        {
                new String[500];
            if(response)
            {
                if(ChamouPolicia[playerid] <= 0)
                    {
                    if(strlen(inputtext) < 2 || strlen(inputtext) > 60)
                    {
                        return SendClientMessage(playerid, -1, "| ERROR | el texto debe tener entre 2 a 60 caracteres");
                    }
                    ChamouPolicia[playerid] = 120;
                        format(String, sizeof(String), "| 192 | El/La Jugador/a %s[%d] pidio socorro: %s", PlayerName(playerid), playerid, inputtext);
                                new pmon;
                                foreach(Player, i)
                                {
                                    if(IsPlayerConnected(i))
                                    {
                                        if(PlayerInfo[i][Org] == 10) // Migrado a Org 10
                        {
                                                SendClientMessage(i, GetPlayerColor(i), String);
                                                pmon ++;
                                                }
                                    }
                                }
                                if(pmon > 0)
                                {
                                    format(String, sizeof(String), "| 192 | Pediste socorro! Cerca de %d Socorristas del PARAMEDICO fueron notificados!", pmon);
                                        SendClientMessage(playerid, 0x6C28BEFF, String);
                                }
                                else
                                {
                                    ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{6C28BE}PARAMEDICO", "\n{FF0000}ningun PARAMEDICO online en el momento", "Salir", "");
                                }
                        }
                        else
                        {
                        return SendClientMessage(playerid, -1, "| ERROR | Usted ya tuvo una aparicion recientemente, espere algunos segundos");
                }
            }
                }
                case D_PLANOSAUDE:
                {
            if(response && PlanoSaude[playerid] <= 0)
            {
                if(PlayerInfo[playerid][pDinheiro] >= 5000)
                {
                        PlanoSaude[playerid] = 10;
                        // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney
                        AC_AddPlayerMoney(playerid, -5000);
                        SendClientMessage(playerid, -1, "| HOSPITAL | Usted contrato un {00FF00}plan de salud {FFFFFF} correctamente!");
                        }
                        else
                        {
                            return SendClientMessage(playerid, -1, "| ERROR | Usted no tiene dinero suficiente");
                        }
            }
                }
                case DIALOG_ROPAMED:
                {
                    if(response)
                    {
                        // P0-MED-1: skins por rango y sexo (automatico).
                        // 0: Vestir Uniforme (detecta sexo + rango)
                        // 1: Retirar Uniforme
                        switch(listitem)
                        {
                            case 0:
                            {
                                new cargoMED = PlayerInfo[playerid][Cargo];
                                new skinAsignado = 274; // fallback masculino
                                new rangoName[32];
                                // Skins masculinos: 274, 275, 276, 70 (rango 1-4)
                                // Skins femeninos:  308, 221, 233, 150 (rango 1-4)
                                if(PlayerInfo[playerid][pSexo] == 2) // Femenino
                                {
                                        if(cargoMED == 1)      { skinAsignado = 308; rangoName = "Enfermera"; }
                                        else if(cargoMED == 2) { skinAsignado = 221; rangoName = "Paramedica"; }
                                        else if(cargoMED == 3) { skinAsignado = 233; rangoName = "Medica/Cirujana"; }
                                        else if(cargoMED >= 4) { skinAsignado = 150; rangoName = "Directora Medica"; }
                                        else                   { skinAsignado = 308; rangoName = "Enfermera"; }
                                }
                                else // Masculino
                                {
                                        if(cargoMED == 1)      { skinAsignado = 274; rangoName = "Enfermero"; }
                                        else if(cargoMED == 2) { skinAsignado = 275; rangoName = "Paramedico"; }
                                        else if(cargoMED == 3) { skinAsignado = 276; rangoName = "Medico/Cirujano"; }
                                        else if(cargoMED >= 4) { skinAsignado = 70;  rangoName = "Director Medico"; }
                                        else                   { skinAsignado = 274; rangoName = "Enfermero"; }
                                }
                                SetPlayerSkin(playerid, skinAsignado);
                                paramedico[playerid] = true;
                                // P0-MED-CHALECO: otorgar derecho a chaleco (no se activa solo)
                                g_ChalecoPermitido[playerid] = true;
                                g_ChalecoActivo[playerid] = false; // arranca desactivado para ver skin
                                GameTextForPlayer(playerid, "~b~~h~Uniforme Vestido", 2500, 3);
                                new msgMed[180];
                                format(msgMed, sizeof(msgMed), "| PARAMEDICO | Uniforme de %s vestido. Ya puedes usar la ambulancia. Usa /chaleco para equipar proteccion.", rangoName);
                                SendClientMessage(playerid, -1, msgMed);
                            }
                            case 1:
                            {
                                SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                                paramedico[playerid] = false;
                                // P0-MED-CHALECO: quitar derecho y chaleco al retirar uniforme
                                g_ChalecoPermitido[playerid] = false;
                                if(g_ChalecoActivo[playerid])
                                {
                                        SetPlayerArmour(playerid, 0);
                                        g_ChalecoActivo[playerid] = false;
                                }
                                GameTextForPlayer(playerid, "~b~~h~Uniforme Removido", 2500, 3);
                                SendClientMessage(playerid, -1, "| PARAMEDICO | Uniforme removido. Ya no estas en servicio.");
                            }
                        }
                    }
                    return 1;
                }
                // P0-REP-FIX: Handler DIALOG_EQUIP_REP - Menu de equipamiento Reporteros
                case DIALOG_EQUIP_REP:
                {
                    if(response)
                    {
                        new cargoREP_eq = PlayerInfo[playerid][Cargo];
                        new skinRepMasc[3] = {240, 188, 187};  // Periodista, Editor, Director
                        new skinRepFem[3]  = {221, 211, 150};   // Periodista, Editor, Director
                        new rangoRepName[3][16] = {"Periodista", "Editor", "Director"};

                        // listitem 0: Vestir/Quitar Uniforme
                        if(listitem == 0)
                        {
                                if(reportero[playerid] == false)
                                {
                                        // Vestir uniforme
                                        new idx = cargoREP_eq - 1;
                                        if(idx < 0) idx = 0;
                                        if(idx > 2) idx = 2;
                                        if(PlayerInfo[playerid][pSexo] == 2)
                                                SetPlayerSkin(playerid, skinRepFem[idx]);
                                        else
                                                SetPlayerSkin(playerid, skinRepMasc[idx]);
                                        reportero[playerid] = true;
                                        // P0-REP-CHALECO: otorgar derecho a chaleco (no se activa solo)
                                        g_ChalecoPermitido[playerid] = true;
                                        g_ChalecoActivo[playerid] = false; // arranca desactivado para ver skin
                                        GameTextForPlayer(playerid, "~y~~h~Uniforme Vestido", 2500, 3);
                                        new msgRep[180];
                                        format(msgRep, sizeof(msgRep), "| REPORTERO | Uniforme de %s vestido. Ya puedes usar /noticia y la camara. Usa /chaleco para equipar proteccion.", rangoRepName[idx]);
                                        SendClientMessage(playerid, -1, msgRep);
                                }
                                else
                                {
                                        // Quitar uniforme
                                        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                                        reportero[playerid] = false;
                                        // P0-REP-CHALECO: quitar derecho y chaleco al retirar uniforme
                                        g_ChalecoPermitido[playerid] = false;
                                        if(g_ChalecoActivo[playerid])
                                        {
                                                SetPlayerArmour(playerid, 0);
                                                g_ChalecoActivo[playerid] = false;
                                        }
                                        RemovePlayerWeapon(playerid, 43); // quitar camara
                                        GameTextForPlayer(playerid, "~y~~h~Uniforme Removido", 2500, 3);
                                        SendClientMessage(playerid, -1, "| REPORTERO | Uniforme removido. Ya no estas en servicio.");
                                }
                        }
                        // listitem 1: Equipar Camara
                        else if(listitem == 1)
                        {
                                if(reportero[playerid] == false)
                                        return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
                                GivePlayerWeapon(playerid, 43, 20);
                                InfoMsg(playerid, "Camara de reportero equipada. Usa /noticia para publicar.");
                        }
                        // listitem 2: Seleccionar Vehiculo
                        else if(listitem == 2)
                        {
                                if(reportero[playerid] == false)
                                        return ErrorMsg(playerid, "Debes vestir el uniforme primero.");
                                new menuVeh6[400];
                                strcat(menuVeh6, "{FF0000}- {FFFFFF}Newsvan (Furgoneta Prensa)\t{FF0000}582\n");
                                if(cargoREP_eq >= 2)
                                        strcat(menuVeh6, "{FF0000}- {FFFFFF}Sultan (Cobertura Rapida)\t{FF0000}560\n");
                                if(cargoREP_eq >= 3)
                                        strcat(menuVeh6, "{FFD700}- {FFFFFF}Infernus Director [LUCES]\t{FFD700}411\n");
                                ShowPlayerDialog(playerid, DIALOG_VEHCORP6, DIALOG_STYLE_LIST, "Selecionar un vehiculo Reporteros.", menuVeh6, "Seleccionar", "X");
                        }
                    }
                    return 1;
                }
                case DIALOG_BANIDO: Kick(playerid);
                case DIALOG_RADIOFREQ:
                {
                        if(response)
                        {
                                cmd_radio(playerid, inputtext);
                        }
                        else
                        {
                                for(new i; i < 32; i++)
                                {
                                        PlayerTextDrawHide(playerid, RadioVOIP[playerid][i]);
                                        if(i == 32)break;
                                }
                                CancelSelectTextDraw(playerid);
                        }
                }
                case DIALOG_BANCO4:
                {
                        if(response)
                        {
                                /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
                                new id;
                                id = strval(inputtext);
                                /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
                                // FIX AUDIT CEL CEL-A1-02 (CRITICO): self-check usaba IDF en vez de playerid.
                                // ANTES: `if(i == GetPlayerIdfixo(playerid))` comparaba playerid (0..499)
                                // con IDF (numero de cuenta 0001..9999). Siempre distinto, nunca match.
                                // Permitia self-transfer (jugador a si mismo). Ahora: i == playerid.
                                // FIX AUDIT CEL CEL-A2-05/A2-06 (ALTO): input vacio ("") => IsNumeric("")=1 (loop 0 iter),
                                // strval("")=0 => id=0 => match primer player conectado. Ahora: rechazar strlen==0.
                                if(!IsNumeric(inputtext)) return ErrorMsg(playerid, "Solamente numeros");
                                if(strlen(inputtext) == 0) return ErrorMsg(playerid, "Ingresa un IDF valido.");
                                if(strlen(inputtext) > 3) return ErrorMsg(playerid, "Valor invalido.");
                                if(id < 0 || id >= MAX_PLAYERS) return ErrorMsg(playerid, "IDF invalido (fuera de rango).");
                                if(!IsPlayerConnected(id) || !pLogado[id]) return ErrorMsg(playerid, "Ese jugador no esta conectado.");
                                if(id == playerid) return ErrorMsg(playerid, "No puede transferirlo a usted..");
                                // FIX AUDIT CEL CEL-A2-02 (CRITICO): validar BancoBloqueado del sender.
                                if(PlayerInfo[playerid][BancoBloqueado]) return ErrorMsg(playerid, "Tu cuenta bancaria esta bloqueada (deuda fiscal). No puedes transferir.");
                                // FIX AUDIT CEL CEL-A2-02 (CRITICO): validar BancoBloqueado del target (anti lavado).
                                if(PlayerInfo[id][BancoBloqueado]) return ErrorMsg(playerid, "La cuenta del destinatario esta bloqueada. No puedes transferir.");
                                format(Str, sizeof(Str),"Saldo Bancario: {FFFFFF}${32CD32}%i\n\n{FFFFFF}transferir dinero a{00C2EC}%04d\n\n{FFFFFF}Cuanto quieres transferir?",PlayerInfo[playerid][pBanco],GetPlayerIdfixo(id));
                                ShowPlayerDialog(playerid,DIALOG_BANCO5,1,"Transferir", Str, "Seleccionar","Volver");
                                SetPVarInt(playerid, "IdTransferiu", id);
                                SetPVarInt(playerid, "IdTransferiuIDF", PlayerInfo[id][IDF]);
                        }
                }
                case DIALOG_BANCO5:
                {
                        if(!response)
                        {
                                // FIX AUDIT CEL CEL-A3-02 (CRITICO): limpiar PVar en todos los paths de salida.
                                DeletePVar(playerid, "IdTransferiu");
                                DeletePVar(playerid, "IdTransferiuIDF");
                                return 1;
                        }
                        /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
                        // FIX AUDIT CEL CEL-A2-08 (ALTO): rechazar texto vacio.
                        if(strlen(inputtext) == 0) { DeletePVar(playerid, "IdTransferiu"); DeletePVar(playerid, "IdTransferiuIDF"); return ErrorMsg(playerid, "Ingresa un monto."); }
                        if(!IsNumeric(inputtext)) { DeletePVar(playerid, "IdTransferiu"); DeletePVar(playerid, "IdTransferiuIDF"); return ErrorMsg(playerid, "Solamente numeros"); }
                        // FIX AUDIT CEL CEL-VERIFY-V1 WARN (ALTO): ampliar limite de monto.
                        // ANTES: strlen > 3 limitaba PIX a $999 max. Inconsistente con
                        // DIALOG_VALORTRANSACAO (Fix 9 permite hasta 9 digitos).
                        // AHORA: strlen > 9 (max $999,999,999 sin integer overflow).
                        if(strlen(inputtext) > 9) { DeletePVar(playerid, "IdTransferiu"); DeletePVar(playerid, "IdTransferiuIDF"); return ErrorMsg(playerid, "Valor invalido (max 9 digitos)."); }
                        // FIX AUDIT CEL CEL-A2-20 (BAJO): rechazar monto 0 (sin sentido).
                        new montoTransfer = strval(inputtext);
                        if(montoTransfer <= 0) { DeletePVar(playerid, "IdTransferiu"); DeletePVar(playerid, "IdTransferiuIDF"); return ErrorMsg(playerid, "El monto debe ser mayor que 0."); }
                        if(PlayerInfo[playerid][pBanco] < montoTransfer) { DeletePVar(playerid, "IdTransferiu"); DeletePVar(playerid, "IdTransferiuIDF"); return ErrorMsg(playerid, "Dinero insuficiente"); }
                        /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

                        // FIX AUDIT CEL CEL-A1-01/A3-01/A4-01 (CRITICO): validar target ANTES de mutar pBanco.
                        // ANTES: decrementaba pBanco del sender ANTES de validar target. Si target se
                        // desconectaba entre BANCO4 y BANCO5, sender perdia el monto permanentemente
                        // (race condition). Ahora: validar target completamente ANTES de cualquier mutacion.
                        new transferTarget = GetPVarInt(playerid, "IdTransferiu");
                        new expectedIDF = GetPVarInt(playerid, "IdTransferiuIDF");
                        if(transferTarget == INVALID_PLAYER_ID || transferTarget < 0 || transferTarget >= MAX_PLAYERS
                           || !IsPlayerConnected(transferTarget) || !pLogado[transferTarget])
                        {
                                DeletePVar(playerid, "IdTransferiu");
                                DeletePVar(playerid, "IdTransferiuIDF");
                            return ErrorMsg(playerid, "El destinatario se desconecto. Transferencia cancelada.");
                        }
                        // FIX AUDIT CEL CEL-A4-01 (CRITICO): slot reuse contamination.
                        // Si el target se desconecto y el slot fue reusado por OTRO jugador,
                        // PlayerInfo[transferTarget][IDF] != expectedIDF. Validar.
                        if(PlayerInfo[transferTarget][IDF] != expectedIDF)
                        {
                                DeletePVar(playerid, "IdTransferiu");
                                DeletePVar(playerid, "IdTransferiuIDF");
                                return ErrorMsg(playerid, "El destinatario original se desconecto. Transferencia cancelada.");
                        }
                        // FIX AUDIT CEL CEL-A3-10 (MEDIO): validar BancoBloqueado del target (anti lavado).
                        if(PlayerInfo[transferTarget][BancoBloqueado])
                        {
                                DeletePVar(playerid, "IdTransferiu");
                                DeletePVar(playerid, "IdTransferiuIDF");
                                return ErrorMsg(playerid, "La cuenta del destinatario esta bloqueada. Transferencia cancelada.");
                        }
                        // Validar nuevamente que el sender sigue teniendo saldo (pudo cambiar entre BANCO4 y BANCO5).
                        if(PlayerInfo[playerid][pBanco] < montoTransfer)
                        {
                                DeletePVar(playerid, "IdTransferiu");
                                DeletePVar(playerid, "IdTransferiuIDF");
                                return ErrorMsg(playerid, "Dinero insuficiente (saldo cambio).");
                        }
                        // ====== MUTACION ATOMICA ======
                        PlayerInfo[playerid][pBanco] -= montoTransfer;
                        PlayerInfo[transferTarget][pBanco] += montoTransfer;
                        format(Str,sizeof(Str), "recibiste $%i, en su cuenta bancaria %04d",montoTransfer,GetPlayerIdfixo(playerid));
                        InfoMsg(transferTarget, Str);
                        // FIX AUDIT3 XS3-02: persistir pBanco de ambos para evitar dupe por crash
                        SalvarDados(playerid);
                        SalvarDados(transferTarget);
                        DeletePVar(playerid, "IdTransferiu");
                        DeletePVar(playerid, "IdTransferiuIDF");
                        /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
                }
                case DIALOG_SELTRABALHO:
                {
                        if(response)
                        {
                                if(listitem == 0)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, 1174.452636, -1312.022338, -44.283576, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 1)
                                {
                                        GPS[playerid] = true;
                                        DisablePlayerCheckpoint(playerid);
                                        SetPlayerCheckpoint(playerid, -504.495117, -517.457763, 25.523437, 3.0);
                                        SuccesMsg(playerid, "fue marcado en tu mapa.");
                                }
                                if(listitem == 2)
                                {
