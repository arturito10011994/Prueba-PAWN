//   [P7] 10 comandos admin con jerarquia del target: agregado
//        if(PlayerInfo[i][pAdmin] >= PlayerInfo[playerid][pAdmin]) return ErrorMsg
//        en: /kick, /ban, /tempban, /jail, /setskin, /setvida, /setchaleco,
//        /setarma, /desarmar, /congelar. Antes un admin nivel 1 podia banear
