CallBack::PlantarMaconhas(playerid, slt)
{
        new string[200];
        static
                Float:pX, Float:pY, Float:pZ;
        GetPlayerPos(playerid, pX, pY, pZ);
        MaconhaInfo[slt][mX] = pX;
        MaconhaInfo[slt][mY] = pY;
        MaconhaInfo[slt][mZ] = pZ-1;
        MaconhaInfo[slt][GramasProntas] = 0;
        MaconhaInfo[slt][Crescida] = 0;
        strmid(MaconhaInfo[slt][Dono], Name(playerid), 0, strlen(Name(playerid)), 35);
        format(string, sizeof string, "Marihuana\nDueno: %s\nPlantacion ID: %d\nCreciendo: %d/%d\nGramos: %dg",
        MaconhaInfo[slt][Dono], slt,MaconhaInfo[slt][Crescida],Max_Crescida, MaconhaInfo[slt][GramasProntas]);
        MaconhaInfo[slt][TT] = Create3DTextLabel(string, 0x1FF61F99, pX, pY, pZ, 10.0, 0);
        MaconhaInfo[slt][Object] = CreateDynamicObject(3409, pX, pY, pZ-0.6,0.0, 0.0, 0.0);
        ClearAnimations(playerid);
        PlantandoMaconha[playerid] = false;
        SuccesMsg(playerid, "Semilla plantada, usa /maconhas para ver tus plantaciones.");
        SalvarPlantacao();
        return true;
}

CallBack::UpdateDrogas()
{
        new string[128];
        for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid++)
        {
                if(MaconhaInfo[maconhaid][PodeUsar] == false)
                {
                        if(MaconhaInfo[maconhaid][Crescida] < Max_Crescida)
                        {
                                new updrogas = randomEx(0, 50);
                                MaconhaInfo[maconhaid][GramasProntas] += updrogas;
                                MaconhaInfo[maconhaid][Crescida]++;
                        }
                        format(string, sizeof string, "Marihuana\nDueno: %s\nPlantacion ID: %d\nCreciendo: %d/%d\nGramos: %dg",
                        MaconhaInfo[maconhaid][Dono], maconhaid,MaconhaInfo[maconhaid][Crescida],Max_Crescida, MaconhaInfo[maconhaid][GramasProntas]);
                        Update3DTextLabelText(MaconhaInfo[maconhaid][TT], 0x1FF61F99, string);
                        // FIX AUDIT5 PERF-CRIT-01: SalvarPlantacao() fuera del loop.
                        // Antes: llamaba SalvarPlantacao() por cada planta dentro del
                        // loop = O(MAX_MACONHA^2) con DOF2_SaveFile cada vez.
                        // Ahora: se llama UNA sola vez al final del callback.
                }
        }
        // FIX AUDIT5 PERF-CRIT-01: llamar SalvarPlantacao() una sola vez al final.
        SalvarPlantacao();
        for(new i = 0; i < GetPlayerPoolSize(); i++)
        {
                if(pLogado[i] == true){
                        MaconhaPronta(i);
                }
        }
        return true;
}

CallBack::AnimatioN(playerid)
{
        // FIX AUDIT ANIM ANIM-A1-02/A3-17/A5-25 (ALTO): sintaxis ApplyAnimation rota + dead code.
        // ANTES: ApplyAnimation con 9 args (sin forceserver). Ahora: 10 args + guards de estado.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pCongelado]) return 1;
        if(MinutosMorte[playerid] > 0) return 1;
        if(!PlantandoMaconha[playerid]) return 1;
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 2.0, 1, 0, 0, 0, 0, 1);
        return true;
}

// =====================================================================
// P1-LimpiarLider: RemoverArmasOrg(playerid)
// Elimina SOLO las armas de organizacion del jugador, dejando las personales
// intactas. Se llama desde CMD:limpiarlider y CMD:limpiarlideres para evitar
// que un lider removido se quede con las armas de la org.
//
// Lista de armas de organizacion (modelos de arma que las orgs entregan):
//   Pistolas:    22 (Pistola 9mm), 23 (Silenced), 24 (Desert Eagle / Combat)
//   Escopetas:   25 (Escopeta)
//   Subfusiles:  29 (MP5)
//   Rifles:      31 (M4), 33 (Rifle)
//   Sniper:      34 (Sniper)
//   Herramientas: 1 (Esposas), 3 (Nightstick)
// =====================================================================
stock RemoverArmasOrg(playerid)
{
        // Armas de organizacion: las que se entregan en HudCop[0] al entrar en servicio
        // IDs segun SA-MP wiki:
        //   1 = Brass Knuckles (esposas usan este slot)
        //   3 = Nightstick
        //   22 = Pistol (9mm)
        //   23 = Silenced Pistol
        //   24 = Desert Eagle
        //   25 = Shotgun
        //   29 = MP5
        //   31 = M4
        //   33 = Rifle
        //   34 = Sniper
        RemovePlayerWeapon(playerid, 1);   // Esposas
        RemovePlayerWeapon(playerid, 3);   // Nightstick
        RemovePlayerWeapon(playerid, 22);  // Pistola 9mm
        RemovePlayerWeapon(playerid, 23);  // Silenced
        RemovePlayerWeapon(playerid, 24);  // Desert Eagle / Combat
        RemovePlayerWeapon(playerid, 25);  // Escopeta
        RemovePlayerWeapon(playerid, 29);  // MP5
        RemovePlayerWeapon(playerid, 31);  // M4
        RemovePlayerWeapon(playerid, 33);  // Rifle
        RemovePlayerWeapon(playerid, 34);  // Sniper
        return 1;
}

// =====================================================================
// WC-01 FULL: TRACKING SERVER-SIDE DE ARMAS + WRAPPERS AUTORITATIVOS
// =====================================================================
// g_PlayerWeapons trackea que armas tiene el jugador segun el servidor.
// Cualquier GivePlayerWeapon/ResetPlayerWeapons/SetPlayerAmmo legitimo
// se redirige via #define a los wrappers AC_* que actualizan el tracking.
// OnPlayerUpdate compara tracking vs estado real y detecta armas cheat
// spawneadas por el cliente.
//
// Tecnica: #define GivePlayerWeapon AC_GivePlayerWeapon redirige TODAS las
// llamadas a GivePlayerWeapon al wrapper. Dentro del wrapper, #undef
// desactiva la macro para poder llamar al nativo sin recursion infinita,
// luego #define la reactiva para el resto del archivo.
// =====================================================================

// Tracking server-side: [slot][0]=weaponid, [slot][1]=ammo
new g_PlayerWeapons[MAX_PLAYERS][13][2];
// Flag: true despues de que el jugador ha pasado por CarregarArmas o
// cualquier wrapper AC_GivePlayerWeapon. Si false, OnPlayerUpdate no hace
// la comparacion estricta (jugador recien conectado, sin armas cargadas).
// FIX AUDIT AC-MEJORA5: g_PlayerWeaponsSynced es un "zombie state" - el if que
// la condicionaba en OnPlayerUpdate fue eliminado en FIX AUDIT2 AGENT1 R-1
// (el strict check ahora corre SIEMPRE, sin importar el flag). La variable
// sigue seteandose en AC_GivePlayerWeapon/AC_ResetPlayerWeapons/CarregarArmas
// y reseteandose en ZerarDados, pero ya NO se lee en ningun check del AC.
// Se mantiene para no romper posibles referencias futuras y para documentacion.
new bool:g_PlayerWeaponsSynced[MAX_PLAYERS];

// Tabla de slots de armas (GTA:SA weapon slots 0-12).
// Calculada a partir de la documentacion de SA-MP.
// Indexada por weaponid (0-46).
static const g_WeaponSlotTable[47] = {
    0,  // 0 = Unarmed
    0,  // 1 = Brass Knuckles
    0,  // 2 = Golf Club
    0,  // 3 = Nightstick
    0,  // 4 = Knife
    0,  // 5 = Baseball Bat
    0,  // 6 = Shovel
    0,  // 7 = Pool Cue
    0,  // 8 = Katana
    0,  // 9 = Chainsaw
    0,  // 10 = Dildo
    0,  // 11 = Vibrator (white)
    0,  // 12 = Vibrator (purple)
    0,  // 13 = Vibrator (silver)
    0,  // 14 = Flowers
    0,  // 15 = Cane
    8,  // 16 = Grenade
    8,  // 17 = Teargas
    8,  // 18 = Molotov
    -1, // 19 = invalid (unused)
    -1, // 20 = invalid (unused)
    -1, // 21 = invalid (unused)
    1,  // 22 = Pistol
    1,  // 23 = Silenced
    1,  // 24 = Desert Eagle
    2,  // 25 = Shotgun
    2,  // 26 = Sawnoff
    2,  // 27 = Spas
    3,  // 28 = Micro UZI
    3,  // 29 = MP5
    4,  // 30 = AK47
    4,  // 31 = M4
    3,  // 32 = TEC9
    5,  // 33 = Country Rifle
    5,  // 34 = Sniper
    6,  // 35 = Rocket Launcher
    6,  // 36 = HS Rocket
    6,  // 37 = Flamethrower
    6,  // 38 = Minigun
    7,  // 39 = Satchel
    12, // 40 = Detonator
    9,  // 41 = Spraycan
    9,  // 42 = Extinguisher
    12, // 43 = Camera
    10, // 44 = Night Vision
    10, // 45 = Thermal Goggles
    11  // 46 = Parachute
};

// REDIRECCION VIA #define: todas las llamadas a GivePlayerWeapon,
// ResetPlayerWeapons y SetPlayerAmmo se redirigen a los wrappers AC_*.
#define GivePlayerWeapon AC_GivePlayerWeapon
#define ResetPlayerWeapons AC_ResetPlayerWeapons
#define SetPlayerAmmo AC_SetPlayerAmmo

stock AC_GivePlayerWeapon(playerid, weaponid, ammo)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        if(weaponid < 0 || weaponid > 46) return 0;
        new slot = g_WeaponSlotTable[weaponid];
        if(slot < 0 || slot > 12) return 0;
        // Actualizar tracking. GivePlayerWeapon es acumulativo (suma ammo)
        // Si el slot ya tiene el mismo weaponid, sumar ammo. Si tiene otro,
        // sobreescribir (GTA:SA behavior: cambiar de arma en slot reemplaza).
        if(g_PlayerWeapons[playerid][slot][0] == weaponid)
                g_PlayerWeapons[playerid][slot][1] += ammo;
        else
        {
                g_PlayerWeapons[playerid][slot][0] = weaponid;
                g_PlayerWeapons[playerid][slot][1] = ammo;
        }
        g_PlayerWeaponsSynced[playerid] = true;
        // Llamar al nativo via #undef (evita recursion infinita)
        #undef GivePlayerWeapon
        GivePlayerWeapon(playerid, weaponid, ammo);
        #define GivePlayerWeapon AC_GivePlayerWeapon
        return 1;
}

stock AC_ResetPlayerWeapons(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        #undef ResetPlayerWeapons
        ResetPlayerWeapons(playerid);
        #define ResetPlayerWeapons AC_ResetPlayerWeapons
        // Limpiar tracking
        for(new s = 0; s < 13; s++)
        {
                g_PlayerWeapons[playerid][s][0] = 0;
                g_PlayerWeapons[playerid][s][1] = 0;
        }
        g_PlayerWeaponsSynced[playerid] = false;
        return 1;
}

stock AC_SetPlayerAmmo(playerid, weaponid, ammo)
{
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
        if(weaponid < 0 || weaponid > 46) return 0;
        new slot = g_WeaponSlotTable[weaponid];
        if(slot < 0 || slot > 12) return 0;
        // Actualizar tracking
        g_PlayerWeapons[playerid][slot][0] = weaponid;
        g_PlayerWeapons[playerid][slot][1] = ammo;
        g_PlayerWeaponsSynced[playerid] = true;
        #undef SetPlayerAmmo
        SetPlayerAmmo(playerid, weaponid, ammo);
        #define SetPlayerAmmo AC_SetPlayerAmmo
        return 1;
}

stock SalvarArmas(playerid)
{
        // FIX AUDIT4 PERS-HIGH-03: validar conexion antes de persistir.
        if(!IsPlayerConnected(playerid)) return 1;
        new Arq[5000], str[5000], wid, wammo;
        format(Arq, sizeof(Arq), PASTA_SAVEARMAS, PlayerName(playerid));
        if(!DOF2_FileExists(Arq))
        {
            DOF2_CreateFile(Arq);
        }
        for(new i = 0; i < 13; i++)
        {
                // FIX AUDIT AGENT1 WC-01 FULL: usar tracking server-side (g_PlayerWeapons)
                // en vez de GetPlayerWeaponData (que lee el estado del cliente).
                // Esto previene DUPE PERMANENTE: si un hacker spawn M4 via cheat,
                // el tracking no lo tiene (porque el cheat no pasa por AC_GivePlayerWeapon),
                // entonces SalvarArmas persiste 0,0 para ese slot = arma no persistida.
                wid = g_PlayerWeapons[playerid][i][0];
                wammo = g_PlayerWeapons[playerid][i][1];
                // FIX AUDIT AGENT1 WC-02: doble check de blocklist (defensa en profundidad).
                // Si por algun bug el tracking tiene un arma prohibida, no persistirla.
                if(wid > 0 && !AC_IsWeaponAllowed(playerid, wid))
                {
                        printf("[AC-WEAPON] SalvarArmas: jugador %s (ID %d) tenia arma %d (slot %d) no permitida en tracking. NO persistida.",
                                PlayerName(playerid), playerid, wid, i);
                        wid = 0;
                        wammo = 0;
                }
                format(str, sizeof(str), "Arma%d", i);
                DOF2_SetInt(Arq, str, wid);
                format(str, sizeof(str), "Municion%d", i);
                DOF2_SetInt(Arq, str, wammo);
        }
        DOF2_SaveFile();
        return 1;
}
stock CarregarArmas(playerid)
{
        new Arq[5000], str[5000], wid, wammo;
        format(Arq, sizeof(Arq), PASTA_SAVEARMAS, PlayerName(playerid));
        if(DOF2_FileExists(Arq))
        {
                for(new i = 0; i < 13; i++)
                {
                        format(str, sizeof(str), "Arma%d", i);
                        wid = DOF2_GetInt(Arq, str);
                        format(str, sizeof(str), "Municion%d", i);
                        wammo = DOF2_GetInt(Arq, str);
                        GivePlayerWeapon(playerid, wid, wammo);
                }
        }
        return 1;
}

CallBack::IsPolicial(playerid)
{
        if(IsPlayerConnected(playerid))
        {
                new member = PlayerInfo[playerid][Org];
                if(member == 1 || member == 2 || member == 3 || member == 4 || member == 14)
                {
                        return 1;
                }
        }
        return 0;
}

// =====================================================================
// P2-PN-1: Predicados granulares para permisos por org.
// Antes solo existia IsPolicial() que mezclaba 5 orgs distintas (PN, Transito,
// FBI, SWAT, Ejercito). Esto permitia que Transito usara /prender (comando
// policial de arresto), rompiendo el roleplay jerarquico.
// Ahora cada comando valida el tipo especifico de policia requerido:
//   - IsPoliciaArrestante: PN, FBI, SWAT, Ejercito (pueden arrestar)
//   - IsPoliciaInvestigador: FBI (investigaciones, ordenes de registro)
// =====================================================================
stock IsPoliciaArrestante(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        new m = PlayerInfo[playerid][Org];
        return (m == 1 || m == 3 || m == 4 || m == 14);
}

stock IsPoliciaInvestigador(playerid)
{
        if(!IsPlayerConnected(playerid)) return 0;
        return (PlayerInfo[playerid][Org] == 3);
}

// FIX AUDIT10 BUG4: IsPoliciaTactico/Transito/Nacional eliminadas (dead code, 0 callers).
// IsPoliciaArrestante/Investigador conservadas (si se usan en comandos de arresto/investigacion).

CallBack::IsBandido(playerid)
{
        if(IsPlayerConnected(playerid))
        {
                new member = PlayerInfo[playerid][Org];
                if(member == 5 || member == 6 || member == 7 || member == 8 || member == 12 || member == 13)
                {
                        return 1;
                }
        }
        return 0;
}

CallBack::IsNeutra(playerid)
{
        if(IsPlayerConnected(playerid))
        {
                new member = PlayerInfo[playerid][Org];
                if(member == 9 || member == 10 || member == 11)
                {
                        return 1;
                }
        }
        return 0;
}

CallBack::RemovePlayerWeapon(playerid, weaponid)
{
        // FIX AUDIT2 AGENT1 W-03 + AGENT5 X-10: antes el array era [12] y el loop
        // `sslot != 12` iteraba 0-11, excluyendo slot 12 (Detonator/Camera/Parachute).
        // ResetPlayerWeapons borra TODOS los 13 slots, pero el restore solo
        // restauraba 0-11 = slot 12 se perdia silenciosamente. Fix: array [13] y
        // loop `sslot < 13` para cubrir todos los slots.
        new plyWeapons[13];
        new plyAmmo[13];
        for(new sslot = 0; sslot < 13; sslot++)
        {
                new wep, ammo;
                // FIX AUDIT2 AGENT1 W-04: leer de tracking server-side (g_PlayerWeapons)
                // en vez de GetPlayerWeaponData (cliente puede tener armas cheat).
                wep = g_PlayerWeapons[playerid][sslot][0];
                ammo = g_PlayerWeapons[playerid][sslot][1];
                // FIX AUDIT2 AGENT1 W-08: antes `ammo != 0` perdia armas con 0 ammo
                // (ej. pistola vacia tras SetPlayerAmmo=0). Fix: salvar si wep > 0.
                if(wep != weaponid && wep > 0) { plyWeapons[sslot] = wep; plyAmmo[sslot] = ammo; }
        }
        ResetPlayerWeapons(playerid);
        for(new sslot = 0; sslot < 13; sslot++)
        {
                if(plyWeapons[sslot] > 0) GivePlayerWeapon(playerid, plyWeapons[sslot], plyAmmo[sslot]);
        }
        return 1;
}

CallBack::ORGCarrega()
{
        new String[500];
        for(new vagads = 1; vagads < MAX_ORGS; vagads++)
        {
           format(String, sizeof(String), PASTA_ORGS, vagads);
           if(!DOF2_FileExists(String))
           {
                   DOF2_CreateFile(String);
                   for(new i=0; i< sizeof VagasORG; i++)
                   {
                                DOF2_SetString(String,VagasORG[i], "ninguno");
                   }
                   DOF2_SaveFile();
           }
        }
        printf("=> Organiza??es                 : %d Carregadas", MAX_ORGS);
        return true;
}

CallBack::AnimatioN2(playerid)
{
        // FIX AUDIT ANIM ANIM-A1-02/A3-17/A5-25 (ALTO): dead code + sintaxis rota.
        // ANIM-A5-25: AnimatioN2 no tiene NINGUN caller en toda la GM (dead code).
        // Se mantiene por compatibilidad futura, con sintaxis correcta y seguro.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pCongelado]) return 1;
        if(MinutosMorte[playerid] > 0) return 1;
        if(!PlantandoMaconha[playerid]) return 1;
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 2.0, 1, 0, 0, 0, 0, 1);
        return true;
}

CallBack::PegarMoney(playerid, Caja_id)
{
        // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): guards de estado antes de ClearAnimations.
        RoubandoCaja[playerid] = false;
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        ClearAnimationsIfNotCuffed(playerid);
        if(!CajaInfo[Caja_id][Caja_Roubada])return 1;
        if(!IsPlayerInRangeOfPoint(playerid, 5.0, GetPVarFloat(playerid, "RouboX"),GetPVarFloat(playerid, "RouboY"),GetPVarFloat(playerid, "RouboZ")))
        {
                return ErrorMsg(playerid, "No estas en ningun lugar de robo.");
        }
        new str[200];
        new picks = CajaInfo[Caja_id][Caja_Pickups];
        GanharItem(playerid,1212, CajaInfo[Caja_id][Caja_Dinheiro]/picks);

        format(str, sizeof str, "Ganaste $%i de dinero sucio.",CajaInfo[Caja_id][Caja_Dinheiro]/picks);
        InfoMsg(playerid, str);

        CajaInfo[Caja_id][Caja_Dinheiro] -= (CajaInfo[Caja_id][Caja_Dinheiro]/picks);

        format(str, sizeof str, "{FFFFFF}Caja Registradora\n{FFFF00}Caja Destruida\n{FFFFFF}Dinero en Caja: {FFFF00}$%i",CajaInfo[Caja_id][Caja_Dinheiro]);
        Update3DTextLabelText(CajaInfo[Caja_id][Caja_Text], 0x5b6ed9F4, str);

        CajaInfo[Caja_id][Caja_Pickups] --;

        KillTimer(GetPVarInt(playerid, "ROBj"));

        SetPVarInt(playerid, "ROBj", SetTimerEx("RObject", 2*60000, 0, "d", playerid));
        return 0;
}

CallBack::RObject(playerid)
{
        RemovePlayerAttachedObject(playerid, 2);
        SetPVarInt(playerid, "ROBj", -1);
}

CallBack::RoubarCaja(playerid, Caja_id)
{
        new Float:px, Float:py, Float:pz,
        Float:rx, Float:ry, Float:rz;
        if(!GetPlayerCaja(playerid))
        {
                CajaInfo[Caja_id][Caja_Roubada] = false;
                GanharItem(playerid, 1654, 1);
                return ErrorMsg(playerid, "Esta longe de um Caja");
        }

        SetPlayerWantedLevelSync(playerid, GetPlayerWantedLevel(playerid)+2); // FIX AUDIT WANTED: sync pProcurado
        // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
        SafeUnfreeze(playerid);
        TendoRoubo = true;
        SetTimer(#LiberarRoubo, Temporoubo, 0);
        GetDynamicObjectPos(CajaInfo[Caja_id][Caja_Object], px, py, pz);
        GetDynamicObjectRot(CajaInfo[Caja_id][Caja_Object], rx, ry, rz);
        GetXYInFrontOfCaja(CajaInfo[Caja_id][Caja_Object], px, py, 0.3);

        CajaInfo[Caja_id][Caja_ObjectBomba] = CreateDynamicObject(1252, px, py, pz, 0.0, 0.0, rz);
        SetTimerEx("ExplodirCaja", 10000, 0, "d", Caja_id);

        SuccesMsg(playerid, "Coloco una bomba en una Caja, ahora alejate.");
        ClearAnimations(playerid, 1);
        return 0;
}

CallBack::RoubarLoja(playerid, progress)
{
                // FIX AUDIT 5P: validar que el jugador sigue conectado y que el robo sigue en curso
                // (previene slot-reuse exploit donde nuevo jugador recibe botin gratis)
                if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 0;
                if(GetPVarInt(playerid, "RoboEnCurso") != 1) return 0;
                // P0-ROBO-FASE4: sistema mejorado de botin
                new n = GetPVarInt(playerid, "RoboNegocioID");
                DeletePVar(playerid, "RoboNegocioID");
                DeletePVar(playerid, "RoboEnCurso");
                if(n < 0 || n >= 9) return 0;

                // Calcular botin
                new dinero = randomEx(g_Negocios[n][n_dineroMin], g_Negocios[n][n_dineroMax]);
                new piezas = 0;
                if(g_Negocios[n][n_piezasMin] > 0)
                        piezas = randomEx(g_Negocios[n][n_piezasMin], g_Negocios[n][n_piezasMax]);

                // Dar dinero
                // FIX AUDIT AGENT5 XS-05: migrado a AC_AddPlayerMoney para sincronizar
                // cliente + grace window AC_MoneyChangeTime (evita strikes/kicks
                // falsos del AC de dinero si botin > $10k/$100k).
                AC_AddPlayerMoney(playerid, dinero);

                // Dar piezas (como Dinero Sucio item 1212)
                if(piezas > 0)
                        GanharItem(playerid, 1212, piezas);

                // Set cooldown individual del negocio
                g_RoboCooldown[n] = gettime() + g_Negocios[n][n_cooldown];
                // FIX AUDIT10 A2-X1: liberar flag de robo para que otros puedan robar
                g_Negocios[n][n_siendoRobado] = false;

                // Subir nivel de buscado
                new nuevoBuscado = GetPlayerWantedLevel(playerid) + g_Negocios[n][n_buscado];
                if(nuevoBuscado > 6) nuevoBuscado = 6;
                SetPlayerWantedLevelSync(playerid, nuevoBuscado); // FIX AUDIT WANTED: ya sincroniza pProcurado

                // Descongelar al jugador
                ClearAnimations(playerid);
                // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): no unfreezar algemado/herido.
                SafeUnfreeze(playerid);
                // Quitar checkpoints de TODOS los policias
                foreach(new p : Player)
                {
                        if(pLogado[p] && IsPolicial(p))
                                DisablePlayerCheckpoint(p);
                }

                // Texto 3D flotante sobre la cabeza del jugador (5 segundos)
                new Float:px, Float:py, Float:pz;
                GetPlayerPos(playerid, px, py, pz);
                new labelStr[100];
                if(piezas > 0)
                        format(labelStr, sizeof(labelStr), "{00FF00}+$%d{FFFFFF} | {FFFF00}%d Dinero Sucio", dinero, piezas);
                else
                        format(labelStr, sizeof(labelStr), "{00FF00}+$%d", dinero);
                new Text3D:botinLabel = Create3DTextLabel(labelStr, 0x00FF00FF, px, py, pz + 1.5, 10.0, 0, 0);
                SetTimerEx("DestruirLabelRobo", 5000, false, "i", _:botinLabel);

                // Mensaje de exito
                new msgOk[200];
                if(piezas > 0)
                        format(msgOk, sizeof(msgOk), "Robo exitoso en %s! Botin: $%d + %d Dinero Sucio. Subiste %d estrellas.",
                               g_Negocios[n][n_nombre], dinero, piezas, g_Negocios[n][n_buscado]);
                else
                        format(msgOk, sizeof(msgOk), "Robo exitoso en %s! Botin: $%d. Subiste %d estrellas.",
                               g_Negocios[n][n_nombre], dinero, g_Negocios[n][n_buscado]);
                SuccesMsg(playerid, msgOk);

                // Avisar a la policia que el robo termino
                foreach(new p : Player)
                {
                        if(pLogado[p] && IsPolicial(p))
                        {
                                SendClientMessage(p, 0xFFAA00FF, "[ROBO FINALIZADO] El robo ha terminado. El sospechoso huye con el botin.");
                        }
                }

                printf("[P0-ROBO] Jugador %d completo robo en negocio %d (%s). Botin: $%d + %d piezas",
                       playerid, n, g_Negocios[n][n_nombre], dinero, piezas);

                // FASE 6: contar robo exitoso para estadisticas de respeto de la banda
                new robadorOrg = PlayerInfo[playerid][Org];
                if(IsBandido(playerid)) // FIX AUDIT FASE6 B2: usar IsBandido en vez de rango manual
                {
                    g_StatsBanda[robadorOrg][sb_robosExitosos]++;
                    StatsBandas_Guardar();
                }

                // P0-DURABILIDAD: desgastar herramienta despues del robo
                {
                        new herrTipo = g_Negocios[n][n_herramienta];
                        new herrItem = 0;
                        if(herrTipo == 0) herrItem = ITEM_GANZUA;
                        else if(herrTipo == 1) herrItem = ITEM_TALADRO;
                        else if(herrTipo == 2) herrItem = ITEM_EXPLOSIVO;

                        if(herrTipo == 2)
                        {
                                // Explosivo: 1 solo uso, siempre se consume
                                for(new s = 0; s < 33; s++)
                                {
                                        if(PlayerInventario[playerid][s][Slot] == herrItem && PlayerInventario[playerid][s][Unidades] > 0)
                                        {
                                                PlayerInventario[playerid][s][Unidades]--;
                                                AtualizarInventario(playerid, s);
                                                InfoMsg(playerid, "* El Explosivo detono con exito. Solo se usa una vez, ya quedo consumido.");
                                                break;
                                        }
                                }
                        }
                        else if(herrTipo == 0)
                        {
                                // Ganzua: 2-3 usos
                                new usos = GetPVarInt(playerid, "GanzuaUsos");
                                if(usos == 0) usos = randomEx(2, 3); // primera vez
                                usos--;
                                SetPVarInt(playerid, "GanzuaUsos", usos);
                                if(usos <= 0)
                                {
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == herrItem && PlayerInventario[playerid][s][Unidades] > 0)
                                                {
                                                        PlayerInventario[playerid][s][Unidades]--;
                                                        AtualizarInventario(playerid, s);
                                                        ErrorMsg(playerid, "* CRACK! La Ganzua se partio en dos pedazos inutiles. Necesitas comprar otra.");
                                                        break;
                                                }
                                        }
                                        DeletePVar(playerid, "GanzuaUsos");
                                }
                                else
                                {
                                        new msgDur[156];
                                        if(usos == 1)
                                                format(msgDur, sizeof(msgDur), "* La Ganzua cruje entre tus manos... un uso mas y se hace pedazos.");
                                        else
                                                format(msgDur, sizeof(msgDur), "* La Ganzua resiste. Le quedan %d usos antes de quebrarse.", usos);
                                        InfoMsg(playerid, msgDur);
                                }
                        }
                        else if(herrTipo == 1)
                        {
                                // Taladro: 4-5 usos
                                new usos = GetPVarInt(playerid, "TaladroUsos");
                                if(usos == 0) usos = randomEx(4, 5); // primera vez
                                usos--;
                                SetPVarInt(playerid, "TaladroUsos", usos);
                                if(usos <= 0)
                                {
                                        for(new s = 0; s < 33; s++)
                                        {
                                                if(PlayerInventario[playerid][s][Slot] == herrItem && PlayerInventario[playerid][s][Unidades] > 0)
                                                {
                                                        PlayerInventario[playerid][s][Unidades]--;
                                                        AtualizarInventario(playerid, s);
                                                        ErrorMsg(playerid, "* BZZZZT! El motor del Taladro echo chispas y se quemo. Inutilizable.");
                                                        break;
                                                }
                                        }
                                        DeletePVar(playerid, "TaladroUsos");
                                }
                                else
                                {
                                        new msgDur[156];
                                        if(usos == 1)
                                                format(msgDur, sizeof(msgDur), "* El Taladro vibra con fuerza... el motor suena raro. Un uso mas y colapsa.");
                                        else
                                                format(msgDur, sizeof(msgDur), "* El Taladro funciona pero el motor se calienta. Le quedan %d usos.", usos);
                                        InfoMsg(playerid, msgDur);
                                }
                        }
                }
                // FIX AUDIT2 AGENT2 M-26: SalvarDados + SalvarInventario para persistir botin de robo.
                // Colocada al final del callback para asegurar que el payout (dinero + item 1212)
                // y el desgaste de herramienta (modificacion de inventario) queden persistidos.
                SalvarDados(playerid);
                SalvarInventario(playerid);
        return 1;
}

// Callback: destruye el texto 3D del botin despues de 5 segundos
forward DestruirLabelRobo(labelID);
public DestruirLabelRobo(labelID)
{
        Delete3DTextLabel(Text3D:labelID);
        return 1;
}

CallBack::ExplodirCaja(Caja_id)
{
        new Float:px, Float:py, Float:pz,
        Float:rx, Float:ry, Float:rz;

        new str[200];

        new add = random(2000);
        CajaInfo[Caja_id][Caja_Dinheiro] = (MAX_PICKUPS_ROUBO*1600)+add;

        format(str, sizeof str, "{FFFFFF}Caja Registradora\n{FFFF00}Caja Destruida\n{FFFFFF}Dinero en Suelo: {FFFF00}$%i",CajaInfo[Caja_id][Caja_Dinheiro]);
        Update3DTextLabelText(CajaInfo[Caja_id][Caja_Text], 0x5b6ed9F4, str);

        GetDynamicObjectPos(CajaInfo[Caja_id][Caja_Object], px, py, pz);
        GetDynamicObjectRot(CajaInfo[Caja_id][Caja_Object], rx, ry, rz);
        CreateExplosion(px, py, pz, 10, 2.0);
        DestroyDynamicObject(CajaInfo[Caja_id][Caja_ObjectBomba]);
        DestroyDynamicObject(CajaInfo[Caja_id][Caja_Object]);
        CajaInfo[Caja_id][Caja_Object] = CreateDynamicObject(2943, px, py, pz, rx, ry, rz);
        UltimaCajaRoubada[0] = px;
        UltimaCajaRoubada[1] = py;
        UltimaCajaRoubada[2] = pz;

        //--------- Jogar grana no chÃ¯Â¿Â½o --

        GetXYInFrontOfCaja(CajaInfo[Caja_id][Caja_Object], px, py, 3.1);
        for(new i; i < MAX_PICKUPS_ROUBO; i++)
        {
                Pickups_Roubo[Caja_id][i] = CreatePickup(1212, 23, px+(RdonPickups[random(sizeof(RdonPickups))][0]),py-(RdonPickups[random(sizeof(RdonPickups))][0]),pz-0.3);
        }

        CajaInfo[Caja_id][Caja_Pickups] = MAX_PICKUPS_ROUBO;

        SetTimerEx("RestoreCaja", 600000, 0, "d", Caja_id);

        return 1;
}
CallBack::RestoreCaja(Caja_id)
{
        if(CajaInfo[Caja_id][Caja_Roubada])
        {

                new Float:px, Float:py, Float:pz,
                Float:rx, Float:ry, Float:rz;

                CajaInfo[Caja_id][Caja_Roubada] = false;

                Update3DTextLabelText(CajaInfo[Caja_id][Caja_Text], -1, "{FFFFFF}Caja Registradora\nAperte '{FFFF00}F{FFFFFF}' para acessar");

                GetDynamicObjectPos(CajaInfo[Caja_id][Caja_Object], px, py, pz);
                GetDynamicObjectRot(CajaInfo[Caja_id][Caja_Object], rx, ry, rz);

                DestroyDynamicObject(CajaInfo[Caja_id][Caja_Object]);
                CajaInfo[Caja_id][Caja_Object] = CreateDynamicObject(2942, px, py, pz, rx, ry, rz);

                for(new i; i < MAX_PICKUPS_ROUBO; i++)
                {
                        DestroyPickup(Pickups_Roubo[Caja_id][i]);
                }
        }
        return true;
}

CallBack::LocalizarPlayer(playerid, giveplayerid)
{
        new
                Float: X,
                Float: Y,
                Float: Z;
        GetPlayerPos(giveplayerid, X, Y, Z);
        SetPlayerCheckpoint(playerid, X, Y, Z, 0.0);
        return true;
}
CallBack::ProxDetectorS(Float:radi, playerid, targetid)
{
        if(IsPlayerConnected(playerid)&&IsPlayerConnected(targetid))
        {
                new Float:posx, Float:posy, Float:posz;
                new Float:oldposx, Float:oldposy, Float:oldposz;
                new Float:tempposx, Float:tempposy, Float:tempposz;
                GetPlayerPos(playerid, oldposx, oldposy, oldposz);
                GetPlayerPos(targetid, posx, posy, posz);
                tempposx = (oldposx -posx);
                tempposy = (oldposy -posy);
                tempposz = (oldposz -posz);
                if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
                {
                        return 1;
                }
        }
        return 0;
}

CallBack::PayDay(playerid)
{
        if(pLogado[playerid] == true)
        {
                // CAMBIO 2026-07-09 - Bug #7: resetear contador de kits gratis por payday
                KitsMedicosGratuitos[playerid] = 0;

                // P0-BEN-GRUA: recargo del 0.7% sobre deudas de grua pendientes de este jugador
                // Se aplica a todos los vehiculos donde el dueÃ¯Â¿Â½o sea este jugador.
                new myIDF = PlayerInfo[playerid][IDF];
                if(myIDF >= 0)
                {
                        for(new v = 1; v < MAX_VEHICLES; v++)
                        {
                                if(g_VehGruaTowed[v] && g_VehGruaOwnerIDF[v] == myIDF && g_VehGruaDeuda[v] > 0)
                                {
                                        new precioOrig = g_VehGruaPrecioOriginal[v];
                                        new recargo = floatround(float(precioOrig) * 0.007);
                                        if(recargo < 1) recargo = 1;
                                        g_VehGruaDeuda[v] += recargo;
                                        new msgRec[180];
                                        format(msgRec, sizeof(msgRec), "[GRUA] Tu vehiculo (ID %d) tiene deuda de traslado pendiente. Recargo del payday: $%d. Deuda total: $%d. Paga en el taller de Bennys con /pagargrua.", v, recargo, g_VehGruaDeuda[v]);
                                        ErrorMsg(playerid, msgRec);
                                }
                        }
                }

                if(!TieneCarnetTrabajo(playerid))
                {
                        InfoMsg(playerid, "No tienes Carnet de Trabajo. Ve al Ayuntamiento para obtenerlo y recibir tu pago.");
                        TimerPayDay[playerid] = SetTimerEx("PayDay", minutos(30), false, "i", playerid);
                        return true;
                }

                // =============================================
                // COBRO AUTOMATICO SI TIENE IMPUESTO PENDIENTE
                // =============================================
                if(PlayerInfo[playerid][ImpuestoPendiente] > 0)
                {
                        new dias = PlayerInfo[playerid][ImpuestoPayDaysSinPagar];
                        new Float:recargo = 0.0;
                        if(dias == 1) recargo = 0.05;
                        else if(dias == 2) recargo = 0.07;
                        else if(dias == 3) recargo = 0.10;
                        else if(dias == 4) recargo = 0.30;
                        else if(dias >= 5) recargo = 0.60;

                        new deudaActual = PlayerInfo[playerid][ImpuestoPendiente];
                        new recargoCobro = floatround(float(deudaActual) * recargo);
                        new totalCobro = deudaActual + recargoCobro;

                        PlayerInfo[playerid][ImpuestoPayDaysSinPagar]++;

                        // Mensaje de aviso de cobro automatico
                        new smsg[256];
                        if(recargo > 0.0)
                        {
                                format(smsg, sizeof(smsg), "El Ayuntamiento ha cobrado automaticamente su deuda de impuestos: $%d ($%d base + $%d recargo).", totalCobro, deudaActual, recargoCobro);
                                PlayerInfo[playerid][ImpuestoPendiente] = totalCobro; // actualiza deuda con recargo incluido para siguiente ciclo
                        }
                        else
                        {
                                format(smsg, sizeof(smsg), "Tiene impuesto pendiente de $%d. Dirijase al Ayuntamiento a pagarlo antes del proximo PayDay para evitar recargos.", deudaActual);
                        }
                        ErrorMsg(playerid, smsg);

                        // Consecuencias segun nivel de deuda
                        new deudaTotal = PlayerInfo[playerid][ImpuestoPendiente];

                        // Reporte policial al 5to PayDay sin pagar
                        if(PlayerInfo[playerid][ImpuestoPayDaysSinPagar] >= 5 && PlayerInfo[playerid][DeudaFiscalReportada] == 0)
                        {
                                PlayerInfo[playerid][DeudaFiscalReportada] = 1;
                                new reportemsg[256];
                                format(reportemsg, sizeof(reportemsg), "[AYUNTAMIENTO] El ciudadano %s (ID:%d) ha sido reportado por evasion fiscal. Deuda acumulada: $%d. Puede ser arrestado.", Name(playerid), playerid, deudaTotal);
                                foreach(new i: Player)
                                {
                                        if(pLogado[i] && IsPolicial(i) && Patrulha[i])
                                        {
                                                SendClientMessage(i, 0xFF4500FF, reportemsg);
                                        }
                                }
                                // Agregar a procurados/cargos de la policia
                                PlayerInfo[playerid][pProcurado]++;
                                if(PlayerInfo[playerid][pProcurado] > 6) PlayerInfo[playerid][pProcurado] = 6; // FIX AUDIT WANTED: clamp [0,6]
                                SetPlayerWantedLevelSync(playerid, PlayerInfo[playerid][pProcurado]); // FIX AUDIT WANTED: sync
                                ErrorMsg(playerid, "El Ayuntamiento te ha reportado a la Policia por evasion fiscal. Podras ser arrestado.");
                        }

                        // Confiscacion auto/casa al llegar a $10,000
                        if(deudaTotal >= 10000 && deudaTotal < 15000)
                        {
                                // Primera confiscacion - vehiculo personal si tiene
                                if(VeiculoCivil[playerid] != INVALID_VEHICLE_ID)
                                {
                                        // FIX ALTOS-VERIFY-A2 (stale state): limpiar g_CorreosVehicleOwner
                                        // antes de DestroyVehicle directo en confiscacion fiscal.
                                        // Cubre el caso edge: cartero Correos con deuda $10k-$15k y PayDay fire.
                                        if(VeiculoCivil[playerid] >= 1 && VeiculoCivil[playerid] < MAX_VEHICLES)
                                                g_CorreosVehicleOwner[VeiculoCivil[playerid]] = INVALID_PLAYER_ID;
                                        DestroyVehicle(VeiculoCivil[playerid]);
                                        VeiculoCivil[playerid] = INVALID_VEHICLE_ID;
                                        ErrorMsg(playerid, "AYUNTAMIENTO: Su vehiculo ha sido confiscado por deuda fiscal de $10.000 o mas. Tiene 1 semana para recuperarlo pagando su deuda.");
                                }
                                else if(PlayerInfo[playerid][Casa] > 0)
                                {
                                        ErrorMsg(playerid, "AYUNTAMIENTO: Su propiedad esta en proceso de confiscacion por deuda fiscal. Pague en el Ayuntamiento.");
                                }
                        }

                        // Segunda confiscacion al llegar a $15,000
                        if(deudaTotal >= 15000 && deudaTotal < 20000)
                        {
                                if(PlayerInfo[playerid][Casa] > 0)
                                {
                                        ErrorMsg(playerid, "AYUNTAMIENTO: Su casa ha sido marcada para confiscacion por deuda fiscal de $15.000 o mas. Pague urgentemente.");
                                }
                        }

                        // Bloqueo de cuenta bancaria al llegar a $20,000
                        if(deudaTotal >= 20000 && PlayerInfo[playerid][BancoBloqueado] == 0)
                        {
                                PlayerInfo[playerid][BancoBloqueado] = 1;
                                ErrorMsg(playerid, "AYUNTAMIENTO: Su cuenta bancaria ha sido BLOQUEADA por deuda fiscal de $20.000. No podra realizar transacciones. Vaya al Ayuntamiento a pagar.");
                        }
                }

                // =============================================
                // CALCULO DEL NUEVO IMPUESTO DE ESTE PAYDAY
                // =============================================
                new banco = PlayerInfo[playerid][pBanco];
                new Float:tasaImpuesto;
                if(banco < 10000) tasaImpuesto = 0.02;
                else if(banco <= 100000) tasaImpuesto = 0.03;
                else tasaImpuesto = 0.05;

                new nuevoImpuesto = floatround(float(banco) * tasaImpuesto);
                if(banco > 0 && nuevoImpuesto >= 1)
                {
                        PlayerInfo[playerid][ImpuestoPendiente] += nuevoImpuesto;

                        // Aviso de impuesto nuevo generado
                        new avisoImp[256];
                        format(avisoImp, sizeof(avisoImp), "PayDay recibido. Se ha generado un impuesto de $%d. Pagalo en el Ayuntamiento antes del proximo PayDay.", nuevoImpuesto);
                        InfoMsg(playerid, avisoImp);

                        // Aviso si tiene deuda acumulada
                        if(PlayerInfo[playerid][ImpuestoPendiente] > nuevoImpuesto)
                        {
                                new deudamsg[256];
                                format(deudamsg, sizeof(deudamsg), "AVISO: Tienes deuda fiscal acumulada de $%d. Pagala en el Ayuntamiento para evitar mas recargos.", PlayerInfo[playerid][ImpuestoPendiente]);
                                ErrorMsg(playerid, deudamsg);
                        }
                }

                // Gastos varios (mantenimiento, random 0-99, mas si tiene casa)
                new gastos = random(100);
                if(PlayerInfo[playerid][Casa] > 0) gastos += random(200); // casa tiene gastos extra
                if(PlayerInfo[playerid][BancoBloqueado] == 0)
                {
                        PlayerInfo[playerid][pBanco] -= gastos;
                        if(PlayerInfo[playerid][pBanco] < 0) PlayerInfo[playerid][pBanco] = 0;
                }

                // =============================================
                // SALARIO BASE
                // =============================================
                // FIX ALTO-VIP-009 (ALTO): validar VIP activo antes de dar bonus de PayDay.
                // ANTES: solo checkeaba pVIP nivel. Si el VIP ya expiro pero pVIP no se reseteo,
                // el jugador recibia bonus sin tener VIP activo.
                // AHORA: usar GetVIPLevel(playerid) que valida pVIP > 0 Y ExpiraVIP > gettime().
                new g = random(1000);
                new _vipLvl = GetVIPLevel(playerid);
                if(_vipLvl == VIP_LEVEL_CLASSIC)
                {
                        PlayerInfo[playerid][pBanco] += g + 1500;
                }
                else if(_vipLvl == VIP_LEVEL_ADVANCED)
                {
                        PlayerInfo[playerid][pBanco] += g*2 + 3000;
                }
                else if(_vipLvl == VIP_LEVEL_PREMIUM)
                {
                        PlayerInfo[playerid][pBanco] += g*2 + 6000;
                }
                else
                {
                        PlayerInfo[playerid][pBanco] += g; // sin VIP solo salario base aleatorio
                }

                if(IsPolicial(playerid))
                {
                        PlayerInfo[playerid][pBanco] += 3000;
                }

                PlayerPlaySound(playerid,1139,0.0,0.0,0.0);
                // FIX CRIT-XP-REACT (CRITICO): conectar darxp a PayDay - sistema XP reactivado.
                // Cada PayDay otorga 50 XP al jugador. Calcula XP actual, proximo nivel y porcentaje.
                // XP necesaria para subir de nivel = nivel_actual * 100 (formula escalable).
                // Ej: nivel 1 -> 100 XP, nivel 2 -> 200 XP, nivel 10 -> 1000 XP.
                {
                        new _curLevel = GetPlayerScore(playerid);
                        new _curXP = PlayerInfo[playerid][pXP] + 50; // +50 XP por PayDay
                        new _xpNeeded = (_curLevel + 1) * 100; // XP necesaria para siguiente nivel
                        new Float:_xpPorc = (float(_curXP) / float(_xpNeeded)) * 100.0;
                        if(_curXP >= _xpNeeded) { _curXP = 0; _xpPorc = 100.0; } // forzar level up
                        darxp(playerid, _curXP, _xpNeeded, _xpPorc, 50);
                }
                SalvarDados(playerid);
                TimerPayDay[playerid] = SetTimerEx("PayDay", minutos(30), false, "i", playerid);
        }
        return true;
}

CallBack::PagoOrg(playerid)
{
        if(!IsPlayerConnected(playerid) || pLogado[playerid] == false) return 1;
        new org = PlayerInfo[playerid][Org];
        new cargo = PlayerInfo[playerid][Cargo];
        new pago = 0;
        new smsg[80];

        // P1-6: REBALANCE SALARIAL - criterios de equilibrio por responsabilidad/combate.
        // Antes Transito (sin combate) pagaba $2,000 a Cadete vs $900 a Oficial PN (combate diario).
        // Eso desincentivaba el rol de Policia Nacional. Nuevo balance:
        //
        // | Org       | C1     | C2     | C3     | C4     | C5     | C6     | Criterio                       |
        // |-----------|--------|--------|--------|--------|--------|--------|--------------------------------|
        // | Transito  | $1,000 | $1,400 | $2,000 |   -    |   -    |   -    | Bajado: no combate             |
        // | PN        | $1,500 | $1,800 | $2,200 | $2,800 | $3,500 |   -    | Subido: combate diario         |
        // | FBI       | $1,800 | $2,100 | $2,400 | $2,700 | $3,200 | $4,000 | Subido: especializacion        |
        // | SWAT      | $2,000 | $2,500 | $3,500 |   -    |   -    |   -    | Subido: riesgo alto            |
        // | Ejercito  | $2,200 | $2,500 | $2,800 | $3,500 | $4,200 | $5,000 | Subido: jerarquia militar      |
        //
        // SWA y Ejercito > PN > FBI > Transito (en orden de sueldo base por responsabilidad).
        // Transito recibe el sueldo mas bajo por ser rol administrativo sin combate.

        // Transito (rol administrativo, sin combate)
        if(org == 2)
        {
                if(cargo == 1) pago = 1000;
                else if(cargo == 2) pago = 1400;
                else if(cargo == 3) pago = 2000;
        }
        // Policia Nacional (combate diario, base de la policia)
        else if(org == 1)
        {
                if(cargo == 1) pago = 1500;
                else if(cargo == 2) pago = 1800;
                else if(cargo == 3) pago = 2200;
                else if(cargo == 4) pago = 2800;
                else if(cargo == 5) pago = 3500;
        }
        // FBI (especializacion investigativa) - 5 rangos
        else if(org == 3)
        {
                if(cargo == 1) pago = 1800;   // Agente Encubierto
                else if(cargo == 2) pago = 2400;   // Agente Especial
                else if(cargo == 3) pago = 3000;   // Supervisor
                else if(cargo == 4) pago = 3800;   // Jefe Division
                else if(cargo == 5) pago = 4500;   // Director
        }
        // SWAT (elite tactica, riesgo alto)
        else if(org == 4)
        {
                if(cargo == 1) pago = 2000;
                else if(cargo == 2) pago = 2500;
                else if(cargo == 3) pago = 3500;
        }
        // Ejercito (jerarquia militar maxima)
        else if(org == 14)
        {
                if(cargo == 1) pago = 2200;
                else if(cargo == 2) pago = 2500;
                else if(cargo == 3) pago = 2800;
                else if(cargo == 4) pago = 3500;
                else if(cargo == 5) pago = 4200;
                else if(cargo == 6) pago = 5000;
        }
        // P0-REP-1: Reporteros (org 11) - 3 rangos, salario incentivado
        else if(org == 11)
        {
                if(cargo == 1) pago = 1600;   // Periodista
                else if(cargo == 2) pago = 2000;   // Editor
                else if(cargo == 3) pago = 2500;   // Director
        }
        // P0-BEN-SAL: Bennys (org 9) - 3 rangos, salario de mecanico
        else if(org == 9)
        {
                if(cargo == 1) pago = 1300;   // Ayudante/Aprendiz
                else if(cargo == 2) pago = 1700;   // Mecanico
                else if(cargo == 3) pago = 2200;   // Jefe de Taller
        }
        // P0-MED-SAL: Paramedicos (org 10) - 4 rangos, salario medico
        // FASE 8h - FIX BUG #1: Paramedicos no tenian salario, cobraban $0.
        // Tabla propuesta (similar a PN pero ligeramente menor por no tener combate):
        //   1 Enfermero        $1,500
        //   2 Paramedico       $1,900
        //   3 Medico/Cirujano  $2,400
        //   4 Director Medico  $3,000
        else if(org == 10)
        {
                if(cargo == 1) pago = 1500;
                else if(cargo == 2) pago = 1900;
                else if(cargo == 3) pago = 2400;
                else if(cargo == 4) pago = 3000;
        }

        if(pago > 0)
        {
                // =============================================================
                // P1-6b: MECANISMOS ANTI-INFLACION SALARIAL
                // =============================================================

                // --- Mecanismo 1: Tope diario ---
                // Resetear acumulador si pasaron 24h desde el ultimo reset.
                new nowTs = gettime();
                if(PagoOrgDailyReset[playerid] == 0 || (nowTs - PagoOrgDailyReset[playerid]) >= 86400)
                {
                        PagoOrgDailyAcum[playerid] = 0;
                        PagoOrgDailyReset[playerid] = nowTs;
                }
                // Si ya cobro el tope diario, no cobra mas.
                if(PagoOrgDailyAcum[playerid] >= PAGOORG_DAILY_CAP)
                {
                        format(smsg, sizeof(smsg), "Salario organizacion bloqueado: ya cobraste el tope diario de $%d. Vuelve manana.", PAGOORG_DAILY_CAP);
                        InfoMsg(playerid, smsg);
                        TimerPagoOrg[playerid] = SetTimerEx("PagoOrg", 7200000, false, "i", playerid);
                        return 1;
                }
                // Recortar pago si excede el tope diario restante.
                new restante = PAGOORG_DAILY_CAP - PagoOrgDailyAcum[playerid];
                if(pago > restante) pago = restante;

                // --- Mecanismo 2: Puerta de actividad ---
                // Solo cobra si jugo al menos 30 min (1800s) desde el ultimo PagoOrg.
                // Evita farmear logueandose 2h AFK. Usamos pSegundosJogados como proxy:
                // comparamos el valor actual con el valor guardado al ultimo cobro.
                if(GetPVarInt(playerid, "PagoOrgLastPlayed") > 0)
                {
                        new deltaPlayed = PlayerInfo[playerid][pSegundosJogados] - GetPVarInt(playerid, "PagoOrgLastPlayed");
                        if(deltaPlayed < PAGOORG_MIN_PLAYED)
                        {
                                format(smsg, sizeof(smsg), "Salario organizacion retenido: solo jugaste %d min desde el ultimo cobro (min %d min).", deltaPlayed/60, PAGOORG_MIN_PLAYED/60);
                                InfoMsg(playerid, smsg);
                                SetPVarInt(playerid, "PagoOrgLastPlayed", PlayerInfo[playerid][pSegundosJogados]);
                                TimerPagoOrg[playerid] = SetTimerEx("PagoOrg", 7200000, false, "i", playerid);
                                return 1;
                        }
                }
                SetPVarInt(playerid, "PagoOrgLastPlayed", PlayerInfo[playerid][pSegundosJogados]);

                // --- Mecanismo 3: Impuesto progresivo al patrimonio ---
                // Si el jugador ya tiene mucha plata acumulada, el salario se reduce.
                // Esto evita que veteranos millonarios sigan enriqueciendose pasivamente.
                new bancoActual = PlayerInfo[playerid][pBanco];
                new Float:factor = 1.0;
                new nivelImpuesto[24] = "ninguno";
                if(bancoActual >= WEALTH_TAX_TIER2)
                {
                        factor = 0.25;       // -75%
                        nivelImpuesto = "tier 2 (-75%)";
                }
                else if(bancoActual >= WEALTH_TAX_TIER1)
                {
                        factor = 0.50;       // -50%
                        nivelImpuesto = "tier 1 (-50%)";
                }
                new pagoOriginal = pago;
                pago = floatround(float(pago) * factor, floatround_ceil);

                // Aplicar pago final
                PlayerInfo[playerid][pBanco] += pago;
                PagoOrgDailyAcum[playerid] += pago;

                // Mensaje detallado al jugador
                if(factor < 1.0)
                {
                        format(smsg, sizeof(smsg), "Salario organizacion: $%d (orig $%d, impuesto %s). Acumulado hoy: $%d/$%d",
                               pago, pagoOriginal, nivelImpuesto, PagoOrgDailyAcum[playerid], PAGOORG_DAILY_CAP);
                }
                else
                {
                        format(smsg, sizeof(smsg), "Salario organizacion: $%d. Acumulado hoy: $%d/$%d",
                               pago, PagoOrgDailyAcum[playerid], PAGOORG_DAILY_CAP);
                }
                SuccesMsg(playerid, smsg);
                SalvarDados(playerid);
        }

        // P0-TERR-FASE2: ingreso pasivo por territorios controlados
        // Las bandas no cobran salario, pero SI cobran por sus territorios.
        if(IsBandido(playerid))
        {
                new ingresoTerr = Terr_CalcularIngresoPasivo(org);
                if(ingresoTerr > 0)
                {
                        PlayerInfo[playerid][pBanco] += ingresoTerr;
                        new msgTerr[128];
                        format(msgTerr, sizeof(msgTerr), "Ingreso por territorios: $%d (incluye bonus por territorios conectados).", ingresoTerr);
                        SuccesMsg(playerid, msgTerr);
                }
        }

        TimerPagoOrg[playerid] = SetTimerEx("PagoOrg", 7200000, false, "i", playerid); // 2 horas
        return 1;
}

CallBack::AnimyTogle(playerid)
{
        // FIX AUDIT ANIM ANIM-A3-05/A4-38 (ALTO): guards MinutosMorte + pProfissao.
        // ANTES: si un Constructor murio durante BOM_Plant (3s timer), AnimyTogle
        // disparaba sobre el respawned herido: ClearAnimations limpiaba CRCKIDLE4.
        // AnimyTogle solo lo invoca el bloque Constructor (pProfissao==5).
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pCongelado]) return 1;
        if(MinutosMorte[playerid] > 0) return 1;
        if(PlayerInfo[playerid][pProfissao] != 5) return 1;  // Constructor
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        return 1;
}

CallBack::AnimyTogle2(playerid)
{
        // FIX AUDIT ANIM ANIM-A3-05/A3-12/A4-12/A4-38 (ALTO): guards + ClearAnimations.
        // FIX AUDIT ANIM ANIM-VERIFY-3 (CRITICO): pProfissao correcto.
        // AnimyTogle2 lo invoca el bloque Minero (pProfissao==2) al vender rocas.
        // ANTES: AnimyTogle2 no hacia ClearAnimations (inconsistencia con AnimyTogle).
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        if(PlayerInfo[playerid][pCongelado]) return 1;
        if(MinutosMorte[playerid] > 0) return 1;
        if(PlayerInfo[playerid][pProfissao] != 2) return 1;  // Minero (vende rocas)
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        return 1;
}

// =====================================================================
// FIX SPRINT2 A-14: callbacks de abandono de vehiculo de trabajo.
// Si un Camionero/Empaquetador sale de SU truck mid-ruta y no vuelve en 30s,
// cancelamos la ruta para evitar cobro a pie (combinado con A-10).
// =====================================================================
CallBack::CamioneroAbandonoCheck(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        g_CamionAbandonoTmr[playerid] = -1;
        // Si el jugador YA no es Camionero o no tiene ruta activa, no hacer nada
        if(PlayerInfo[playerid][pProfissao] != 4) return 1;
        if(!Cargase[playerid] && !CamionEnRuta[playerid] && !CamionCargando[playerid]
           && !CamionDescargando[playerid]) return 1;
        // FIX AUDIT CAMIONERO CAM-A1-02 (ALTO): si esta descargando (60s freezado en CP), NO cancelar.
        // Antes: el timer de 30s de abandono disparaba DURING los 60s de descarga si el Camionero
        // habia salido del truck en el destino y caminado al CP. flush + descarga simultaneos = soft-lock.
        if(CamionDescargando[playerid]) return 1;
        // Si volvio al truck, no cancelar
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) == CamionVehId[playerid])
                return 1;
        // No volvio: cancelar ruta
        InfoMsg(playerid, "No volviste al truck en 30s. Ruta cancelada.");
        Camionero_FlushPlayer(playerid);
        return 1;
}

CallBack::EmpaquetadorAbandonoCheck(playerid)
{
        if(!IsPlayerConnected(playerid)) return 1;
        if(!pLogado[playerid]) return 1;
        g_EmpAbandonoTmr[playerid] = -1;
        if(PlayerInfo[playerid][pProfissao] != 7) return 1;
        if(!EmpaquetadorActivo[playerid]) return 1;
        // Si volvio al camion, no cancelar
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) == EmpaquetadorVehiculo[playerid])
                return 1;
        InfoMsg(playerid, "No volviste al camion en 30s. Ruta cancelada.");
        Empaquetador_FlushPlayer(playerid);
        return 1;
}

CallBack::VerificarTeste(playerid)
{
        // FIX AUDIT LIC LIC-A3-14/A4-11 (BAJO/MEDIO): guards de conexion.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        // Camionero: si se desconecta con camion activo, timer 3 min para destruirlo
        if(CamionVehId[playerid] != -1)
        {
                if(CamionReconTmr[playerid] != -1) KillTimer(CamionReconTmr[playerid]);
                CamionReconTmr[playerid] = SetTimerEx("CamionTimerCB", 180000, false, "i", playerid);
        }
        if(IniciouTesteHabilitacaoA[playerid] == 1)
        {
                if(IsPlayerInVehicle(playerid, AutoEscolaMoto[playerid]))
                {
                        new Float:Vida2;
                        GetVehicleHealth(AutoEscolaMoto[playerid], Float:Vida2);
                        if(Vida2 < 995) // Reprovado
                        {
                                RemovePlayerFromVehicle(playerid);
                                new _examVehMoto = AutoEscolaMoto[playerid]; AutoEscolaMoto[playerid] = 0; if(IsValidVehicle(_examVehMoto)) DestroyVehicle(_examVehMoto); // FIX REVERT-AUDIT6-007-defensive

                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
                                DisablePlayerRaceCheckpoint(playerid);
                                CheckpointPontosMoto[playerid] = 0;
                                KillTimer(TimerTesteMoto[playerid]);
                                TimerTesteMoto[playerid] = 0; // FIX AUDIT-AUDIT6-MED-004

                                terminouteste(playerid);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                IniciouTesteHabilitacaoA[playerid] = 0;
                                GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);

                                ErrorMsg(playerid, "Fuiste reprobado.");

                        }
                }
        // FIX REVERT-AUDIT6-007a: else if(AutoEscolaMoto[playerid] != 0) REMOVIDO.
        // CAUSA: IsPlayerInVehicle puede retornar false por lag de 1 frame, causando
        // cancelacion falsa del examen. Los paths de cleanup ya cubren eyeccion legitima.
        }
        else if(IniciouTesteHabilitacaoB[playerid] == 1)
        {
                if(IsPlayerInVehicle(playerid, AutoEscolaVeiculo[playerid]))
                {
                        new Float:Vida2;
                        GetVehicleHealth(AutoEscolaVeiculo[playerid], Float:Vida2);
                        if(Vida2 < 995) // Reprovado
                        {
                                RemovePlayerFromVehicle(playerid);
                                new _examVehVeic = AutoEscolaVeiculo[playerid]; AutoEscolaVeiculo[playerid] = 0; if(IsValidVehicle(_examVehVeic)) DestroyVehicle(_examVehVeic); // FIX REVERT-AUDIT6-007-defensive

                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
                                DisablePlayerRaceCheckpoint(playerid);
                                CheckpointPontosVeiculo[playerid] = 0;
                                KillTimer(TimerTesteVeiculo[playerid]);
                                TimerTesteVeiculo[playerid] = 0; // FIX AUDIT-AUDIT6-MED-004

                                terminouteste(playerid);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                IniciouTesteHabilitacaoB[playerid] = 0;
                                GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);

                                ErrorMsg(playerid, "Fuiste reprobado.");

                        }
                }
        // FIX REVERT-AUDIT6-007b: else if(AutoEscolaVeiculo[playerid] != 0) REMOVIDO.
        // CAUSA: IsPlayerInVehicle puede retornar false por lag, causando cancelacion falsa.
        }
        else if(IniciouTesteHabilitacaoC[playerid] == 1)
        {
                if(IsPlayerInVehicle(playerid, AutoEscolaCaminhao[playerid]))
                {
                        new Float:Vida2;
                        GetVehicleHealth(AutoEscolaCaminhao[playerid], Float:Vida2);
                        if(Vida2 < 995) // Reprovado
                        {
                                RemovePlayerFromVehicle(playerid);
                                new _examVehCam = AutoEscolaCaminhao[playerid]; AutoEscolaCaminhao[playerid] = 0; if(IsValidVehicle(_examVehCam)) DestroyVehicle(_examVehCam); // FIX REVERT-AUDIT6-007-defensive

                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
                                DisablePlayerRaceCheckpoint(playerid);
                                CheckpointPontosCaminhao[playerid] = 0;
                                KillTimer(TimerTesteCaminhao[playerid]);
                                TimerTesteCaminhao[playerid] = 0; // FIX AUDIT-AUDIT6-MED-004

                                terminouteste(playerid);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                IniciouTesteHabilitacaoC[playerid] = 0;
                                GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);

                                ErrorMsg(playerid, "Fuiste reprobado.");

                        }
                }
        // FIX REVERT-AUDIT6-007c: else if(AutoEscolaCaminhao[playerid] != 0) REMOVIDO.
        // CAUSA: IsPlayerInVehicle puede retornar false por lag, causando cancelacion falsa.
        }
        else if(IniciouTesteHabilitacaoE[playerid] == 1)
        {
                if(IsPlayerInVehicle(playerid, AutoEscolaTrailero[playerid]))
                {
                        new Float:Vida2;
                        GetVehicleHealth(AutoEscolaTrailero[playerid], Float:Vida2);
                        if(Vida2 < 995)
                        {
                                RemovePlayerFromVehicle(playerid);
                                new _examVehTrail = AutoEscolaTrailero[playerid]; AutoEscolaTrailero[playerid] = 0; if(IsValidVehicle(_examVehTrail)) DestroyVehicle(_examVehTrail); // FIX REVERT-AUDIT6-007-defensive
                                // FIX AUDIT LIC LIC-A1-02 (CRITICO): destruir trailer en VerificarTeste reprovado.
                                if(IsValidVehicle(AutoEscolaTrailer[playerid])) DestroyVehicle(AutoEscolaTrailer[playerid]);
                                AutoEscolaTrailer[playerid] = 0;

                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
                                DisablePlayerRaceCheckpoint(playerid);
                                CheckpointPontosTrailero[playerid] = 0;
                                KillTimer(TimerTesteTrailero[playerid]);
                                TimerTesteTrailero[playerid] = 0; // FIX AUDIT-AUDIT6-MED-004


                                terminouteste(playerid);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                IniciouTesteHabilitacaoE[playerid] = 0;
                                GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);

                                ErrorMsg(playerid, "Fuiste reprobado por daÃ¯Â¿Â½ar el vehiculo.");
                        }
                }

        }
        // FIX AUDIT LIC LIC-A1-03 (CRITICO): bloque para Aerea (D).
        // FIX REVERT-AUDIT6-007d: else if(AutoEscolaTrailero[playerid] != 0) REMOVIDO.
        // CAUSA: IsPlayerInVehicle puede retornar false por lag de 1 frame, causando
        // cancelacion falsa del examen. Los paths de cleanup (OnPlayerExitVehicle,
        // OnPlayerDeath, OnVehicleDeath, CMD:jail, etc.) ya cubren eyeccion legitima.
        // ANTES: VerificarTeste solo manejaba A/B/C/E (moto/auto/camion/trailero).
        // Aerea (D) NO tenia deteccion mid-exam. El timer 1s corria sin detectar
        // dano o abandono. Solo se detectaba al final (case 13 L28248+). Ahora
        // agregamos deteccion mid-exam para Aerea.
        else if(IniciouTesteHabilitacaoD[playerid] == 1)
        {
                if(IsPlayerInVehicle(playerid, AutoEscolaAerea[playerid]))
                {
                        new Float:Vida2;
                        GetVehicleHealth(AutoEscolaAerea[playerid], Float:Vida2);
                        if(Vida2 < 700)  // umbral mas permisivo para aviones (LIC-A1-13)
                        {
                                RemovePlayerFromVehicle(playerid);
                                new _examVehAer = AutoEscolaAerea[playerid]; AutoEscolaAerea[playerid] = 0; if(IsValidVehicle(_examVehAer)) DestroyVehicle(_examVehAer); // FIX REVERT-AUDIT6-007-defensive

                                PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
                                DisablePlayerRaceCheckpoint(playerid);
                                CheckpointPontosAerea[playerid] = 0;
                                KillTimer(TimerTesteAerea[playerid]);
                                TimerTesteAerea[playerid] = 0; // FIX AUDIT-AUDIT6-MED-004


                                terminouteste(playerid);
                                TogglePlayerControllable(playerid, false);
                                SetTimerEx("carregarobj", 5000, 0, "i", playerid);
                                IniciouTesteHabilitacaoD[playerid] = 0;
                                GameTextForPlayer(playerid, "~r~Reprovado!", 5001, 6);

                                ErrorMsg(playerid, "Fuiste reprobado por daÃ¯Â¿Â½ar la aeronave.");
                        }
                }

        }
        // FIX REVERT-AUDIT6-007e: else if(AutoEscolaAerea[playerid] != 0) REMOVIDO.
        // CAUSA: IsPlayerInVehicle puede retornar false por lag de 1 frame, causando
        // cancelacion falsa del examen. Los paths de cleanup ya cubren eyeccion legitima.
        return 1;
}

CarregarAnims(playerid) {
  // FIX AUDIT SPAWN S2-6: usar actorcad[playerid] en vez de actorid=0.
  // Antes: `new actorid;` sin inicializar (default 0). ApplyDynamicActorAnimation(actorid=0, ...)
  // aplicaba al actor ID 0 del servidor, que podria ser el actorcorreios de OTRO
  // jugador. Codigo incorrecto, no explotable pero bug real.
  // Ahora: usar actorcad[playerid] que es el actor del jugador actual.
  new actorid = actorcad[playerid];
  for(new i = 0; i < sizeof(AnimLibs); i++) {
          ApplyAnimation(playerid, AnimLibs[i], "null", 4.0, 0, 0, 0, 0, 0, 1);
          if(actorid > 0) ApplyDynamicActorAnimation(actorid, AnimLibs[i], "null", 4.1, 0, 0, 0, 0, 1);
  }
  return 1;
}

IsNumeric(const string[])
{
        for (new i = 0, j = strlen(string); i < j; i++)
        {
                if (string[i] > '9' || string[i] < '0') return 0;
        }
        return 1;
}

CallBack::PlayerToPoint(Float:radi, playerid, Float:x, Float:y, Float:z)
{
        if(IsPlayerConnected(playerid))
        {
                new Float:oldposx, Float:oldposy, Float:oldposz;
                new Float:tempposx, Float:tempposy, Float:tempposz;
                GetPlayerPos(playerid, oldposx, oldposy, oldposz);
                tempposx = (oldposx -x);
                tempposy = (oldposy -y);
                tempposz = (oldposz -z);
                //printf("DEBUG: X:%f Y:%f Z:%f",posx,posy,posz);
                if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi)))
                {
                        return 1;
                }
        }
        return 0;
}

CallBack::FomeBar(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        // FIX AUDIT HAMBRE H1-3: eximir admins, AFK, heridos, spectating de FomeBar.
        // Antes: si un admin en duty, un jugador AFK, un herido o un espectador
        // tenia este timer corriendo, su hambre se decrementaba igual. Para admins
        // en duty es unfair (no estan jugando). Para AFK no aplica (no juegan).
        // Para heridos ya tienen SetPlayerHealth(1000000) (no sufriran dano), pero
        // su hambre bajaba inutilmente. Para espectadores, no tienen cuerpo.
        // Ahora: 4 exenciones al inicio.
        if(PlayerInfo[playerid][pAdmin] >= 1 && !pJogando[playerid]) return 1; // admin en duty
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) return 1; // herido
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;     // spectating
        // FIX AUDIT AFK H1: bug semantico - AntiAFK_Ativado significa "sistema AFK activado"
        // (default true para todos), NO "el jugador esta AFK". El check anterior
        // `if(AntiAFK_Ativado[playerid]) return 1;` siempre retornaba para todos los
        // jugadores normales, dejando el sistema Hambre 100% MUERTO. La exencion real
        // debe ser para jugadores en countdown AFK (que tienen timer TestAway pendiente)
        // o ya kickeados. Por ahora, eliminamos el check (no hay flag IsPlayerAFK real);
        // el sistema Hambre debe decrementar para todos los jugadores activos.
        // Si en el futuro se quiere eximir jugadores AFK, implementar g_IsPlayerAFK[playerid]
        // seteado en AntiAway al iniciar countdown y reseteado al cancelar/kickear.

        new fome = randomEx(1,3);
        FomePlayer[playerid] -= fome;
        // FIX AUDIT HAMBRE H2-4: cambiar threshold <= 1 a <= 0 (dano solo a 0, no a 1).
        // MEJORA HAMBRE #3: sonido de estomago grunendo si hambre < 40.
        if(FomePlayer[playerid] <= 0)
        {
                new Float:health;
        GetPlayerHealth(playerid,health);
                SetPlayerHealth(playerid, health-fome);
                FomePlayer[playerid] = 0;
                GameTextForPlayer(playerid, "~y~Tienes hambre", 3000, 3);
        }
        // MEJORA HAMBRE #3: efectos visuales de hambre baja.
        // Si hambre < 40 (pero > 0), sonido de estomago grunendo cada tick.
        else if(FomePlayer[playerid] < 40)
        {
                PlayerPlaySound(playerid, 1050, 0.0, 0.0, 0.0);
        }
        return 1;
}

CallBack::SedeBar(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;
        // FIX AUDIT HAMBRE H1-3: eximir admins, AFK, heridos, spectating de SedeBar (igual que FomeBar).
        if(PlayerInfo[playerid][pAdmin] >= 1 && !pJogando[playerid]) return 1; // admin en duty
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) return 1; // herido
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;     // spectating
        // FIX AUDIT AFK H1: bug semantico (ver FomeBar L10668 para explicacion completa).

        new sede = randomEx(1,3);
        SedePlayer[playerid] -= sede;
        // FIX AUDIT HAMBRE H2-4: cambiar threshold <= 1 a <= 0 (dano solo a 0, no a 1).
        if(SedePlayer[playerid] <= 0)
        {
                new Float:health;
        GetPlayerHealth(playerid,health);
                SetPlayerHealth(playerid, health-sede);
                SedePlayer[playerid] = 0;
                GameTextForPlayer(playerid, "~y~Tienes sed", 3000, 3);
        }
        return 1;
}

// MEJORA HAMBRE #1: callback de Sueno. Decrementa SuenoPlayer cada 15 min.
// Si SuenoPlayer <= 5, avisa de cansancio. Si llega a 0, el jugador se desmaya:
// animacion KO_skid_front + SetPlayerDrunkLevel para efecto visual de adormecido.
// NO se congela al jugador (TogglePlayerControllable) - solo efecto visual.
// Despues de 10s, CallBack::Descongelar restaura el estado normal.
forward SuenoTimer(playerid);
forward Descongelar(playerid);
CallBack::SuenoTimer(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        // MEJORA HAMBRE #1: exenciones (igual que FomeBar/SedeBar).
        if(PlayerInfo[playerid][pAdmin] >= 1 && !pJogando[playerid]) return 1; // admin en duty
        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0) return 1; // herido
        if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 1;     // spectating
        // FIX AUDIT AFK H1: bug semantico (ver FomeBar L10668 para explicacion completa).

        new suenoDec = randomEx(1, 3);
        SuenoPlayer[playerid] -= suenoDec;

        // Aviso a <=5 (cansancio severo).
        if(SuenoPlayer[playerid] <= 5 && SuenoPlayer[playerid] > 0)
        {
                GameTextForPlayer(playerid, "~p~Estas muy cansado. Duerme o descansa.", 3000, 3);
        }
        // Desmayo a 0.
        if(SuenoPlayer[playerid] <= 0)
        {
                SuenoPlayer[playerid] = 0;
                GameTextForPlayer(playerid, "~p~Te desmayaste de cansancio...", 5000, 3);
                ApplyAnimation(playerid, "PED", "KO_skid_front", 4.1, 0, 1, 1, 1, 0, 1);
                SetPlayerDrunkLevel(playerid, 5000);
                // Restaurar al jugador despues de 10s (sin free-heal: solo ClearAnimations
                // + TogglePlayerControllable(1) + SetPlayerDrunkLevel(0)).
                SetTimerEx("Descongelar", 10000, false, "i", playerid);
        }
        return 1;
}

// MEJORA HAMBRE #1: CallBack::Descongelar - restaura al jugador tras desmayo de sueno
// (tambien usado por /dormir y /descansar). NO cura HP (evita free-heal exploit).
public Descongelar(playerid)
{
        // FIX AUDIT ANIM ANIM-A2-05/A3-08/A4-23 (CRITICO): guards de estado.
        // ANTES: solo validaba IsPlayerConnected. Si un algemado se desmayaba
        // por sueno durante los 10s del desmayo, ClearAnimations borraba el
        // CUFFED + TogglePlayerControllable(1) descongelaba al algemado =
        // BYPASS DE ARRESTO. Si un herido respawned, ClearAnimations limpiaba
        // CRCKIDLE4 + TogglePlayerControllable(1) lo descongelaba = invulnerable.
        if(!IsPlayerConnected(playerid) || !pLogado[playerid]) return 1;
        SetPlayerDrunkLevel(playerid, 0);
        if(!PlayerInfo[playerid][pCongelado] && MinutosMorte[playerid] == 0)
        {
                ClearAnimations(playerid);
                TogglePlayerControllable(playerid, 1);
        }
        g_DormindoODescansando[playerid] = false;
        return 1;
}

stock GetWeaponModel(weaponid)
{
    switch(weaponid)
    {
        case 1:
            return 331;

        case 2..8:
            return weaponid+331;

        case 9:
            return 341;

        case 10..15:
            return weaponid+311;

        case 16..18:
            return weaponid+326;

        case 22..29:
            return weaponid+324;

        case 30,31:
            return weaponid+325;

        case 32:
            return 372;

        case 33..45:
            return weaponid+324;

        case 46:
            return 371;
    }
    return 0;
}

CallBack::Colete(playerid)
{
        if(!IsPlayerConnected(playerid))
                return true;

        static BankV[258], str[255]; // FIX AUDIT6 HIGH-8: static para alloc en data segment, no stack cada 500ms
        new Hora, Minuto;
        new Float:vida,Float:colete;
        GetPlayerHealth(playerid,vida);
        GetPlayerArmour(playerid,colete);
        gettime(Hora, Minuto);

        // FIX AUDIT5 HIGH-01: solo actualizar TextDraws si el valor cambio (6 TDs a 500ms = coste alto)
        format(BankV, sizeof(BankV), "%i", PlayerInfo[playerid][pBanco]);
        if(strcmp(BankV, Colete_lastBank[playerid]) != 0) {
            strcpy(Colete_lastBank[playerid], BankV);
            PlayerTextDrawSetString(playerid, BancoTD[playerid][17], BankV);
        }

        format(BankV, sizeof(BankV), "%i", PlayerInfo[playerid][pDinheiro]);
        if(strcmp(BankV, Colete_lastMoney[playerid]) != 0) {
            strcpy(Colete_lastMoney[playerid], BankV);
            PlayerTextDrawSetString(playerid, BancoTD[playerid][16], BankV);
        }

        format(str, sizeof(str), "%d", SedePlayer[playerid]);
        if(strcmp(str, Colete_lastSede[playerid]) != 0) {
            strcpy(Colete_lastSede[playerid], str);
            PlayerTextDrawSetString(playerid, hudStyle[playerid][4], str);
        }

        format(str, sizeof(str), "%d", FomePlayer[playerid]);
        if(strcmp(str, Colete_lastFome[playerid]) != 0) {
            strcpy(Colete_lastFome[playerid], str);
            PlayerTextDrawSetString(playerid, hudStyle[playerid][3], str);
        }

        format(str, sizeof(str), "%.0f", vida);
        if(strcmp(str, Colete_lastVida[playerid]) != 0) {
            strcpy(Colete_lastVida[playerid], str);
            PlayerTextDrawSetString(playerid, hudStyle[playerid][1], str);
        }

        format(str, sizeof(str), "%.0f", colete);
        if(strcmp(str, Colete_lastColete[playerid]) != 0) {
            strcpy(Colete_lastColete[playerid], str);
            PlayerTextDrawSetString(playerid, hudStyle[playerid][2], str);
        }



        // FIX AUDIT6 HIGH-7: solo SetPreviewModel si el skin cambio (evita llamada cada 500ms)
        {
            new curSkin = GetPlayerSkin(playerid);
            if(curSkin != lastSkin[playerid]) {
                PlayerTextDrawSetPreviewModel(playerid, DrawInv[playerid][31], curSkin);
                lastSkin[playerid] = curSkin;
            }
        }
        GetPlayerPos(playerid, VarPlayerOldPos[playerid][0], VarPlayerOldPos[playerid][1], VarPlayerOldPos[playerid][2]);
        static armedbody_pTick[MAX_PLAYERS];
    if(GetTickCount() - armedbody_pTick[playerid] > 113)
    {

        new weaponid[13],weaponammo[13],pArmedWeapon;
        pArmedWeapon = GetPlayerWeapon(playerid);
        GetPlayerWeaponData(playerid,1,weaponid[1],weaponammo[1]);
        GetPlayerWeaponData(playerid,2,weaponid[2],weaponammo[2]);
        GetPlayerWeaponData(playerid,4,weaponid[4],weaponammo[4]);
        GetPlayerWeaponData(playerid,5,weaponid[5],weaponammo[5]);
        GetPlayerWeaponData(playerid,7,weaponid[7],weaponammo[7]);
        if(weaponid[1] && weaponammo[1] > 0){
            if(pArmedWeapon != weaponid[1]){
                if(!IsPlayerAttachedObjectSlotUsed(playerid,0)){
                    SetPlayerAttachedObject(playerid,0,GetWeaponModel(weaponid[1]),1, 0.199999, -0.139999, 0.030000, 0.500007, -115.000000, 0.000000, 1.000000, 1.000000, 1.000000);
                }
            }
            else {
                if(IsPlayerAttachedObjectSlotUsed(playerid,0)){
                    RemovePlayerAttachedObject(playerid,0);
                }
            }
        }
        else if(IsPlayerAttachedObjectSlotUsed(playerid,0)){
            RemovePlayerAttachedObject(playerid,0);
        }
        // No tocar slot 1 si el jugador lleva una caja de reparto
        if(!CajaMao[playerid] && GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_CARRY)
        {
            if(weaponid[2] && weaponammo[2] > 0){
                if(pArmedWeapon != weaponid[2]){
                    if(!IsPlayerAttachedObjectSlotUsed(playerid,1)){
                        SetPlayerAttachedObject(playerid,1,GetWeaponModel(weaponid[2]),8, -0.079999, -0.039999, 0.109999, -90.100006, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
                    }
                }
                else {
                    if(IsPlayerAttachedObjectSlotUsed(playerid,1)){
                        RemovePlayerAttachedObject(playerid,1);
                    }
                }
            }
            else if(IsPlayerAttachedObjectSlotUsed(playerid,1)){
                RemovePlayerAttachedObject(playerid,1);
            }
        }
        if(weaponid[4] && weaponammo[4] > 0){
            if(pArmedWeapon != weaponid[4]){
                if(!IsPlayerAttachedObjectSlotUsed(playerid,2)){
                    SetPlayerAttachedObject(playerid,2,GetWeaponModel(weaponid[4]),7, 0.000000, -0.100000, -0.080000, -95.000000, -10.000000, 0.000000, 1.000000, 1.000000, 1.000000);
                }
            }
            else {
                if(IsPlayerAttachedObjectSlotUsed(playerid,2)){
                    RemovePlayerAttachedObject(playerid,2);
                }
            }
        }
        else if(IsPlayerAttachedObjectSlotUsed(playerid,2)){
            RemovePlayerAttachedObject(playerid,2);
        }
        if(weaponid[5] && weaponammo[5] > 0){
            if(pArmedWeapon != weaponid[5]){
                if(!IsPlayerAttachedObjectSlotUsed(playerid,3)){
                    SetPlayerAttachedObject(playerid,3,GetWeaponModel(weaponid[5]),1, 0.200000, -0.119999, -0.059999, 0.000000, 206.000000, 0.000000, 1.000000, 1.000000, 1.000000);
                }
            }
            else {
                if(IsPlayerAttachedObjectSlotUsed(playerid,3)){
                    RemovePlayerAttachedObject(playerid,3);
                }
            }
        }
        else if(IsPlayerAttachedObjectSlotUsed(playerid,3)){
            RemovePlayerAttachedObject(playerid,3);
        }
        armedbody_pTick[playerid] = GetTickCount();
    }
        return 1;
}

split(const strsrc[], const strdest[][], delimiter)
{
        new i, li;
        new aNum;
        new len;
        new srclen = strlen(strsrc);
        while(i <= srclen)
        {
                if(strsrc[i]==delimiter || i==srclen)
                {
                        len = strmid(strdest[aNum], strsrc, li, i, 128);
                        strdest[aNum][len] = 0;
                        li = i+1;
                        aNum++;
                }
                i++;
        }
        return true;
}

GanharItem(playerid, itemid, quantia)
{
        // FIX AUDIT INV I1-5: validar quantia > 0. Antes: no validaba.
        // Un llamador con quantia negativa o 0 podia corromper el inventario.
        if(quantia <= 0) return 0;
        // FIX AUDIT INV I2-4: dos pasadas para evitar bug de elif.
        // Antes: el elif Slot==-1 se evaluaba en cada iteracion. Si un item
        // existia en slot 7 pero slots 1-6 estaban vacios, el loop matcheaba
        // elif Slot==-1 en i=1 y creaba stack nuevo en slot 1. El stack
        // existente en slot 7 no se detectaba. Resultado: item en 2 slots.
        // Pre-condicion: item ya en 2+ slots (por edicion manual o bug previo).
        // Una vez activado, propaga por GanharItem subsiguientes.
        // Fix: primera pasada busca stack existente en todo el array; si no
        // encuentra, segunda pasada busca slot vacio.
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == itemid)
                {
                        PlayerInventario[playerid][i][Slot] = itemid;
                        PlayerInventario[playerid][i][Unidades]+= quantia;
                        ShowItemBox(playerid, ItemNomeInv(itemid), "Recibiste", itemid, 3);
                        SalvarInventario(playerid); // Guardar inmediatamente para no perder el item
                        return 1;
                }
        }
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == -1)
                {
                        PlayerInventario[playerid][i][Slot] = itemid;
                        PlayerInventario[playerid][i][Unidades] = quantia;
                        ShowItemBox(playerid, ItemNomeInv(itemid), "Recibiste", itemid, 3);
                        SalvarInventario(playerid); // Guardar inmediatamente para no perder el item
                        return 1;
                }
        }
        ErrorMsg(playerid, "Inventario lleno.");
        return 0; // retorna 0 para que las tiendas sepan que fallo
}

GanharItem2(playerid, itemid, quantia)
{
        // FIX AUDIT INV I2-4: dos pasadas para evitar bug de elif (mismo fix que GanharItem).
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == itemid)
                {
                        PlayerInventario[playerid][i][Slot] = itemid;
                        PlayerInventario[playerid][i][Unidades]+= quantia;
                        // FIX AUDIT INV I3-2: persistir inmediatamente tras GanharItem2.
                        // Antes: NO llamaba SalvarInventario. El unico caller actual
                        // (CMD:garmas L49919) SI persiste despues (L49927 via FIX I0-4),
                        // pero para defensa en profundidad y simetria con GanharItem (que
                        // SI persiste), agregamos SalvarInventario aqui.
                        // Nota: GanharItem2 NO muestra ShowItemBox ni ErrorMsg (es silencioso,
                        // usado para transferencias internas como /garmas).
                        SalvarInventario(playerid);
                        return 1;
                }
        }
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == -1)
                {
                        PlayerInventario[playerid][i][Slot] = itemid;
                        PlayerInventario[playerid][i][Unidades] = quantia;
                        // FIX AUDIT INV I3-2: persistir inmediatamente tras GanharItem2.
                        SalvarInventario(playerid);
                        return 1;
                }
        }
        ErrorMsg(playerid, "Inventario cheio.");

        return 1;
}


RetirarItem(playerid, modelid)
{
    // FIX AUDIT ARRESTO 6P [C9]: la funcion original usaba `modelid` como indice directo
    // del array PlayerInventario (33 slots, indices 0-32), pero los callers pasan modelids
    // > 32 (1212, 854, 1279, etc.) = array index out of bounds. Los items NO se confiscaban.
    // Ahora busca el item por slot (recorre los 33 slots buscando el modelid correcto).
    // FIX AUDIT CEL MEJORA-5/A2-04 (CRITICO): confisca TODOS los slots con ese modelid.
    // ANTES: hacia return 1 en el PRIMER match, dejando duplicados en otros slots.
    // Si el jugador tenia 2+ celulares (vÃ¯Â¿Â½a /daritem admin o exploit), arresto solo
    // confiscaba 1. El segundo seguia disponible en jail. Ahora: itera los 33 slots
    // completos, confiscando TODOS los matches. ShowItemBox solo se muestra 1 vez
    // para no spamear al jugador.
    if(IsPlayerConnected(playerid))
        {
                new bool:mostrouMsg = false;
                for(new s = 0; s < 33; s++)
                {
                        if(PlayerInventario[playerid][s][Slot] == modelid && PlayerInventario[playerid][s][Unidades] > 0)
                        {
                                if(!mostrouMsg)
                                {
                                        ShowItemBox(playerid, ItemNomeInv(modelid), "Removeu", modelid, 3);
                                        mostrouMsg = true;
                                }
                                for(new i = 0; i < MAX_OBJECTS; i++)
                                {
                                        if(DropItemSlot[i][DropItem] == 0)
                                        {
                                                DropItemSlot[i][DropItemUni] = PlayerInventario[playerid][s][Unidades];
                                                DropItemSlot[i][DropItemID] = modelid;
                                                PlayerInventario[playerid][s][Unidades] = 0;
                                                PlayerInventario[playerid][s][Slot] = -1;
                                                AtualizarInventario(playerid, s);
                                                break;  // siguiente slot
                                        }
                                }
                        }
                }
                // FIX AUDIT INV I3-1: persistir inmediatamente tras retirar item(s).
                // Persistir UNA sola vez al final (no 1 por slot como antes, que era I/O excesivo).
                if(mostrouMsg) SalvarInventario(playerid);
        }
    return 1;
}

// FIX SPRINT3 B-17: RetirarItem2 eliminada (dead code con bug OOB).
// Antes: esta funcion NO era invocada en ningun sitio (verificado con grep) y ademas
// tenia un bug OOB: usaba `modelid` (1-30000) como indice de PlayerInventario[playerid][N]
// donde N es 0-32. Cualquier invocacion hubiera crasheado el servidor.
// Para cualquier retiro de item usar RetirarItem(playerid, modelid, qtd) que es la
// version segura y activamente usada.

CallBack::CriarInventario(playerid)
{
        new file[64], str[128], string[128];
        format(file, sizeof(file), PASTA_INVENTARIO, PlayerName(playerid));

        if(!DOF2_FileExists(file))
        {
                DOF2_CreateFile(file); printf("Criou arquivo!");
                for(new i = 1; i < 33; ++i)
                {
                    PlayerInventario[playerid][i][Slot] = -1;
                    // FIX AUDIT INV I4-3: inicializar Unidades a 0 (no -1).
                    // Antes: inicializaba Unidades a -1. LoadInv L11100 resetea a 0
                    // antes de leer del disco, pero CriarInventario escribia "-1|-1"
                    // al .ini. Si LoadInv leia "-1|-1", strval("-1") = -1, pasaba
                    // por el check `slotVal > 0` (era false, asi que no cargaba),
                    // pero el .ini quedaba con datos inconsistentes. Cualquier
                    // herramienta externa que leyera el .ini veria "-1" como cantidad.
                    // Ahora: 0 es el valor correcto para "slot vacio".
                    PlayerInventario[playerid][i][Unidades] = 0;

                        format(string, sizeof(string), "Item_%d", i);
                        format(str, sizeof(str), "%d|%d", PlayerInventario[playerid][i][Slot], PlayerInventario[playerid][i][Unidades]);
                        DOF2_SetString(file, string, str);
                        // FIX AUDIT INV I4-2: mover DOF2_SaveFile fuera del loop.
                        // Antes: DOF2_SaveFile() estaba DENTRO del for, llamando
                        // 32 flushes fisicos a disco por cada inventario nuevo.
                        // Cada flush es un fsync que bloquea el thread principal.
                        // Con 200 jugadores nuevos conectando a la vez (p.ej. tras
                        // /gmx), eran 200 * 32 = 6400 fsyncs en ~10 segundos.
                        // Ahora: 1 solo DOF2_SaveFile() despues del loop. Mismo
                        // resultado en disco, 32x menos I/O.
                }
                DOF2_SaveFile();
        }
        return 1;
}

CallBack::LoadInv(playerid)
{
        new file[64], key[64], string[2][64], str[64];
        format(file, sizeof(file), PASTA_INVENTARIO, PlayerName(playerid));
        // Si el archivo no existe, crearlo con slots vacios antes de cargar
        if(!DOF2_FileExists(file))
        {
                // Archivo no existe, crear nuevo
                CriarInventario(playerid);
                return 1;
        }
        // Archivo existe, cargar inventario
        SetPVarInt(playerid, #VarSlotInv, 0);
        for(new i = 1; i < 33; ++i)
        {
                PlayerInventario[playerid][i][Slot] = -1;
                PlayerInventario[playerid][i][Unidades] = 0;
                format(key, sizeof(key), "Item_%d", i);
                format(str, sizeof(str), "%s", DOF2_GetString(file, key));
                if(strlen(str) > 2) // solo parsear si el string no esta vacio
                {
                        // cargar item del archivo
                        split(str, string, '|');
                        new slotVal = strval(string[0]);
                        if(slotVal > 0)
                        {
                                // FIX AUDIT INV I1-2: clamp Slot y Unidades al cargar de disco.
                                // Antes: no habia clamp. Valores absurdos (slotVal=99999 o Unidades=-50)
                                // se cargaban tal cual, causando out-of-bounds o estados corruptos.
                                if(slotVal > 65535) slotVal = -1; // item invalido
                                new uniVal = strval(string[1]);
                                // FIX AUDIT INV I1-3: validar item con IsValidItemInv.
                                // Antes: cualquier item cargado de disco se aceptaba sin validacion.
                                if(slotVal != -1 && !IsValidItemInv(slotVal)) slotVal = -1;
                                if(slotVal != -1)
                                {
                                        PlayerInventario[playerid][i][Slot] = slotVal;
                                        // licencia cargada
                                        if(uniVal < 0) uniVal = 0;
                                        if(uniVal > 9999) uniVal = 9999;
                                        PlayerInventario[playerid][i][Unidades] = uniVal;
                                }
                        }
                }
        }
        // FIX CRITICO BUG LICENCIAS: marcar que el inventario YA se cargo del disco.
        // Esto permite que SalvarInventario funcione (antes estaba bloqueado por anti-overwrite).
        g_InventoryLoaded[playerid] = true;
        return 1;
}

CallBack::SalvarInventario(playerid)
{
        // FIX AUDIT4 PERS-HIGH-03: validar conexion antes de persistir.
        if(!IsPlayerConnected(playerid)) return 1;
        // FIX AUDIT INV I3-3: validar pLogado antes de persistir.
        if(!pLogado[playerid]) return 1;
        // FIX CRITICO BUG LICENCIAS: NO guardar si el inventario no se ha cargado del disco todavia.
        // El SaveTimer puede correr entre pLogado=true y LoadInv (2s despues), guardando un
        // inventario vacio (resetado por ZerarDados) y sobreescribiendo las licencias guardadas.
        if(!g_InventoryLoaded[playerid]) return 1;
        // FIX AUDIT INV I4-4: mutex g_Saving contra re-entry.
        if(g_Saving[playerid]) return 1;
        // FIX AUDIT INV I4-4: mutex g_Saving contra re-entry (mismo patron que SalvarDados L19296).
        // Antes: SalvarInventario no tenia mutex. Si dos llamadas concurrentes ocurrÃ¯Â¿Â½an
        // (p.ej. SaveTimer rota mientras un GanharItem llama SalvarInventario), ambas
        // ejecutaban DOF2_SetString + DOF2_SaveFile sobre el mismo archivo, causando
        // race condition. Resultado potencial: claves Item_N inconsistentes en el .ini.
        // Ahora: si g_Saving[playerid] ya es true, salir. Setear true al iniciar,
        // false al terminar. Mutex ya reseteado en ZerarDados L18748 (defense-in-depth).
        if(g_Saving[playerid]) return 1;
        g_Saving[playerid] = true;
        new file[64], str[128], string[128];
        format(file, sizeof(file), PASTA_INVENTARIO, PlayerName(playerid));
        if(!DOF2_FileExists(file)){DOF2_CreateFile(file);}
        for(new i = 1; i < 33; ++i)
        {
                format(string, sizeof(string), "Item_%d", i);
                // FIX AUDIT INV I1-4: clamp Unidades [0, 9999] al guardar.
                new saveSlot = PlayerInventario[playerid][i][Slot];
                new saveUni = PlayerInventario[playerid][i][Unidades];
                if(saveUni < 0) saveUni = 0;
                if(saveUni > 9999) saveUni = 9999;
                format(str, sizeof(str), "%d|%d", saveSlot, saveUni);
                DOF2_SetString(file, string, str);
                // DEBUG: mostrar slots con licencias al guardar
                // licencia guardada
        }
        // FIX AUDIT INV I2-3: backup automatico antes de DOF2_SaveFile.
        // Antes: si el servidor crasheaba durante DOF2_SaveFile() (flush fisico a
        // disco), el archivo Inventarios/<nick>.ini quedaba truncado o corrupto.
        // El jugador perdia TODO su inventario al reconectar. SalvarDados ya tiene
        // este backup (FIX AUDIT LOGIN F1-5 en L19415-19424); SalvarInventario no.
        // Inconsistencia critica dado que el inventario suele tener mas items
        // valiosos que el saldo en efectivo.
        // Patron replicado de SalvarDados: copiar a Inventarios/backup/<nick>.ini.bak
        // antes del flush. Si DOF2_SaveFile corrompe el principal, el .bak sigue
        // existiendo para restauracion manual.
        if(DOF2_FileExists(file))
        {
                new backupPath[256];
                format(backupPath, sizeof(backupPath), "Inventarios/backup/%s.ini.bak", PlayerName(playerid));
                DOF2_CopyFile(file, backupPath);
        }
        // FIX AUDIT INV I4-1: loguear fallo de DOF2_SaveFile.
        // Antes: se llamaba DOF2_SaveFile() sin verificar ni loguear resultado.
        // DOF2_SaveFile en si no retorna nada util (void), pero si falla el flush
        // fisico (disco lleno, permisos, etc.) el .ini queda en estado inconsistente.
        // Como no hay retorno que chequear, al menos loguear en server log para que
        // el admin pueda ver en logs/ que el guardado fallo.
        // Nota: DOF2_SaveFile es void en DOF2, por eso no hay `if(!DOF2_SaveFile())`.
        // El log es informativo: si el .bak se hizo pero el principal fallo, el
        // admin puede restaurar manualmente Inventarios/backup/<nick>.ini.bak.
        DOF2_SaveFile();
        g_Saving[playerid] = false;
        return 1;
}

CheckInventario(playerid, itemid)
{
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == itemid || PlayerInventario[playerid][i][Slot] == -1) return 1;
        }
        return 0;
}

CheckInventario2(playerid, itemid)
{
        for(new i = 1; i < 33; ++i)
        {
                if(PlayerInventario[playerid][i][Slot] == itemid) return 1;
        }
        return 0;
}

